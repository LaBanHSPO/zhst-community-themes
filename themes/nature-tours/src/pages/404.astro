---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<div class="wrap notfound-inner">
			<div class="notfound-copy">
				<p class="eyebrow">Error 404</p>
				<h1 id="nf-title" class="display">This path ends here.</h1>
				<p class="lede">The page you are looking for has moved or never existed. Pick a trail to start from.</p>
				<div class="actions">
					<a class="btn" href="/">Back to home <Arrow /></a>
					<a class="btn btn-ghost" href="/tours">Tours</a>
					<a class="btn btn-ghost" href="/contact">Plan Your Trip</a>
				</div>
			</div>
			<img class="notfound-photo" src="/images/t-trail.webp" alt="" width="570" height="690" />
		</div>
	</section>
</Base>
