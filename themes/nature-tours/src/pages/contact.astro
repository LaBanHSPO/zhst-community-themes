---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { LEVELS, daysLabel, getCompany, getTours, longDate, mapHref, rows, telHref } from "../lib/tours";

const [{ company, cacheHint }, toursResult] = await Promise.all([getCompany(), getTours()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(toursResult.cacheHint);
}
const office = rows(company.office);
const tours = toursResult.tours;
// ?tour=<slug> pre-selects the tour, ?departure=YYYY-MM-DD the date (if that tour runs it), ?level= the fitness level.
const q = Astro.url.searchParams;
const selected = tours.find((t) => (t.entry.data.slug ?? t.entry.data.id) === q.get("tour"));
const wantedDeparture = selected?.departures.find((d) => d.date === q.get("departure"));
const wantedLevel = LEVELS.find((l) => l.slug === q.get("level"))?.slug ?? selected?.entry.data.level;
const departureOptions = tours.flatMap((t) =>
	t.departures.map((d) => ({ tour: t.entry.data.slug ?? t.entry.data.id, title: t.entry.data.title, ...d })),
);
---

<Base title="Plan Your Trip" description="Send an enquiry to NatureTours: the tour, a departure you like, group size and fitness level. Phone and email are listed on this page.">
	<PageHead
		id="contact-title"
		eyebrow="Plan Your Trip"
		title="Tell us which tour and which date."
		intro="Choose a tour and a departure, or ask for something else. We reply within two working days."
	/>
	<section class="contact-section" aria-labelledby="contact-title">
		<div class="wrap contact-grid">
			<form
				class="enquiry-form"
				data-enquiry-form
				data-email={company.email}
				action={company.email ? `mailto:${company.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field full">
						<label for="c-tour">Tour</label>
						<select id="c-tour" name="tour" required>
							<option value="" selected={!selected}>Choose a tour</option>
							{
								tours.map((t) => (
									<option value={t.entry.data.title} data-slug={t.entry.data.slug ?? t.entry.data.id} data-level={t.entry.data.level} selected={selected?.entry.data.id === t.entry.data.id}>
										{t.entry.data.title} · {t.entry.data.country} · {daysLabel(t.entry.data.days)}
									</option>
								))
							}
							<option value="Not sure yet">Not sure yet, I will describe what I want below</option>
						</select>
						<span class="field-error" data-error-for="c-tour"></span>
					</div>
					<div class="field full">
						<label for="c-departure">Preferred departure</label>
						<select id="c-departure" name="departure">
							<option value="Flexible" selected={!wantedDeparture}>Flexible, tell me what suits</option>
							{
								departureOptions.map((d) => (
									<option
										value={`${longDate(d.date)} (${d.title})`}
										data-tour={d.tour}
										hidden={Boolean(selected) && (selected?.entry.data.slug ?? selected?.entry.data.id) !== d.tour}
										selected={wantedDeparture !== undefined && d.date === wantedDeparture.date && d.tour === (selected?.entry.data.slug ?? selected?.entry.data.id)}
									>
										{longDate(d.date)} · {d.title} · {d.status}
									</option>
								))
							}
						</select>
						<span class="field-hint">Only the dates of the tour you chose are shown.</span>
					</div>
					<div class="field">
						<label for="c-people">Group size</label>
						<select id="c-people" name="people" required>
							<option value="1">1 person</option>
							<option value="2" selected>2 people</option>
							<option value="3">3 people</option>
							<option value="4">4 people</option>
							<option value="5 to 8">5 to 8 people</option>
							<option value="9 to 12">9 to 12 people (a private group)</option>
						</select>
					</div>
					<div class="field full">
						<label for="c-level">Fitness level</label>
						<select id="c-level" name="level" required>
							{LEVELS.map((l) => <option value={`${l.label}: ${l.hint}`} selected={wantedLevel === l.slug}>{l.label}: {l.hint}</option>)}
							<option value="Not sure" selected={!wantedLevel}>Not sure, please advise</option>
						</select>
					</div>
					<div class="field full">
						<label for="c-name">Name</label>
						<input id="c-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="c-name"></span>
					</div>
					<div class="field">
						<label for="c-email">Email</label>
						<input id="c-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="c-email"></span>
					</div>
					<div class="field">
						<label for="c-phone">Phone <span class="optional">(optional)</span></label>
						<input id="c-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field full">
						<label for="c-notes">Anything else? <span class="optional">(optional)</span></label>
						<textarea id="c-notes" name="notes" rows="4" placeholder="Walking you have done lately, injuries or medication we should know about, dietary needs, who you are travelling with"></textarea>
					</div>
				</div>
				<button class="btn btn-moss btn-lg btn-block" type="submit">Send enquiry</button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{company.email && <>Write to <a href={`mailto:${company.email}`}>{company.email}</a> with the tour, departure, group size and fitness level.</>}
					</noscript>
				</p>
			</form>

			<aside class="contact-side">
				<h2>Prefer to talk?</h2>
				<p>
					{company.phone && <>Call <a href={telHref(company.phone)}>{company.phone}</a></>}
					{company.phone && company.email && " or email "}
					{!company.phone && company.email && "Email "}
					{company.email && <a href={`mailto:${company.email}`}>{company.email}</a>}.
				</p>
				{
					(company.street || company.locality) && (
						<p>
							<a href={mapHref(company)} target="_blank" rel="noopener noreferrer">{[company.street, company.locality].filter(Boolean).join(", ")}</a>
						</p>
					)
				}
				{
					office.length > 0 && (
						<>
							<h3>Phone hours</h3>
							<dl class="side-hours">
								{office.map((h) => <><dt>{h.left}</dt><dd>{h.right}</dd></>)}
							</dl>
						</>
					)
				}
				{company.enquiry_note && <p class="small">{company.enquiry_note}</p>}
				<img src="/images/t-peaks.webp" alt="Snow-capped peaks above a forested valley and a pale lake in evening light" width="888" height="440" loading="lazy" />
			</aside>
		</div>
	</section>
</Base>

<script>
	// Show only the departures of the chosen tour, set the fitness level from it, validate, then compose an
	// enquiry email. Nothing is sent by the site itself; the company confirms by reply.
	document.querySelectorAll<HTMLFormElement>("[data-enquiry-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		const tourSel = form.querySelector<HTMLSelectElement>("#c-tour");
		const depSel = form.querySelector<HTMLSelectElement>("#c-departure");
		const levelSel = form.querySelector<HTMLSelectElement>("#c-level");
		if (!status || !tourSel || !depSel || !levelSel) return;

		const syncDepartures = (resetLevel: boolean) => {
			const opt = tourSel.selectedOptions[0];
			const slug = opt?.dataset.slug ?? "";
			depSel.querySelectorAll<HTMLOptionElement>("option[data-tour]").forEach((o) => {
				const show = !slug || o.dataset.tour === slug;
				o.hidden = !show;
				o.disabled = !show;
			});
			if (depSel.selectedOptions[0]?.disabled) depSel.selectedIndex = 0;
			if (resetLevel && opt?.dataset.level) {
				const match = [...levelSel.options].find((o) => o.value.toLowerCase().startsWith(opt.dataset.level ?? "?"));
				if (match) levelSel.value = match.value;
			}
		};
		syncDepartures(false);
		tourSel.addEventListener("change", () => syncDepartures(true));

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input[required], select[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online enquiries are not available right now. Please call us.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Tour enquiry: ${get("tour")}`;
			const lines = [
				"Hello,",
				"",
				"I would like to ask about a tour:",
				`Tour: ${get("tour")}`,
				`Preferred departure: ${get("departure")}`,
				`Group size: ${get("people")}`,
				`Fitness level: ${get("level")}`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("notes") ? `Notes: ${get("notes")}` : "",
				"",
				"I understand this is an enquiry and no place is held until I receive a written confirmation.",
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this enquiry ready to send. It is only sent when you send that email, and we reply to it. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
