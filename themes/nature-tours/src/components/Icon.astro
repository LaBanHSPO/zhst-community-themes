---
interface Props {
	name: string;
}
const { name } = Astro.props;
---

{
	name === "leaf" && (
		<svg viewBox="0 0 48 48" width="68" height="68" aria-hidden="true" focusable="false">
			<path d="M10 33C9 18 19 8 38 8c1 17-8 28-23 28l-5 5-2-2 5-5c-1-1-3-2-4-3Z" fill="currentColor" />
			<path d="M14 33c6-8 12-13 19-17" fill="none" stroke="#e6e7e0" stroke-width="1.8" stroke-linecap="round" />
		</svg>
	)
}
{
	name === "group" && (
		<svg viewBox="0 0 48 48" width="52" height="52" aria-hidden="true" focusable="false">
			<circle cx="24" cy="12" r="5.5" fill="currentColor" />
			<circle cx="11.5" cy="19" r="4.5" fill="currentColor" />
			<circle cx="36.5" cy="19" r="4.5" fill="currentColor" />
			<path d="M15 40v-7c0-5 4-8.500 9-8.500s9 3.500 9 8.500v7Z" fill="currentColor" />
			<path d="M3 38v-5c0-4 3.500-6.500 8-6.500 1.500 0 2.800.3 4 .8-1.600 1.800-2.500 4-2.500 6.700V38Z" fill="currentColor" />
			<path d="M45 38v-5c0-4-3.500-6.500-8-6.500-1.500 0-2.800.3-4 .8 1.600 1.800 2.500 4 2.500 6.700V38Z" fill="currentColor" />
		</svg>
	)
}
{
	name === "mountains" && (
		<svg viewBox="0 0 52 40" width="58" height="45" aria-hidden="true" focusable="false">
			<path d="M20 36 33 10l15 26Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
			<path d="M3 36 18 11l16 25Z" fill="currentColor" />
		</svg>
	)
}
