---
import Arrow from "./Arrow.astro";
import { telHref } from "../lib/site";
import type { StudioData } from "../lib/site";

interface Props {
	studio: StudioData;
	/** Pre-selects a project type on the contact page. */
	type?: string | null;
}
const { studio, type } = Astro.props;
const href = type ? `/contact?type=${encodeURIComponent(type)}` : "/contact";
---

<section class="band" aria-labelledby="band-title">
	<div class="wrap band-inner">
		<div>
			<p class="eyebrow eyebrow-light">Project enquiry</p>
			<h2 id="band-title" class="display display-light">Have a plot, or a building that needs rethinking?</h2>
			<p class="band-copy">Tell us where it is, what it is for and when you would like to start. We read every enquiry and reply within three working days.</p>
		</div>
		<div class="band-actions">
			<a class="btn btn-light" href={href}><span>Start an enquiry</span><Arrow /></a>
			<p class="band-contact">
				{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}
				{studio.phone && <a href={telHref(studio.phone)}>{studio.phone}</a>}
			</p>
		</div>
	</div>
</section>
