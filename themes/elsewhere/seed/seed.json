    "data": {
     "title": "Long Tables and Slow Suppers",
     "deck": "Shared plates, regional flavours and the stories behind them.",
     "excerpt": "Shared plates, regional flavours and the stories behind them.",
     "content": [
      {
       "_type": "block",
       "style": "h2",
       "_key": "k155",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Eat what grows nearby",
         "_key": "k156",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k157",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Regional food tells the story of a place faster than any museum. Ask what is in season and start there.",
         "_key": "k158",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k159",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "The table as a meeting point",
         "_key": "k160",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k161",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Long tables bring strangers together. Say yes to the invitation to sit down.",
         "_key": "k162",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
