    "data": {
     "title": "Hidden Coves of the Cyclades",
     "deck": "Olive trees, stone paths and water the colour of glass.",
     "excerpt": "Olive trees, dry-stone paths and swimming coves that stay quiet outside August.",
     "content": [
      {
       "_type": "block",
       "style": "h2",
       "_key": "k73",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Following the goat paths",
         "_key": "k74",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k75",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "The best coves are reached on foot. Wear proper shoes, start early and let the path decide your pace.",
         "_key": "k76",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k77",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Swim, then sit",
         "_key": "k78",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k79",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Cold, clear water and a flat rock are all you need. Bring fruit, a hat and nowhere to be.",
         "_key": "k80",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k81",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "When to go",
         "_key": "k82",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k83",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Late May and late September give you warm water and empty beaches.",
         "_key": "k84",
         "marks": []
        }
       ]
      }
     ],
     "photo": "/images/cyclades-path.webp",
