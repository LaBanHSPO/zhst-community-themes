    },
    "data": {
     "title": "Coastal Paths and Wild Places",
     "deck": "Cliff walks, sea air and the kind of quiet that resets a trip.",
     "excerpt": "Cliff walks, sea air and the kind of quiet that resets a whole trip.",
     "content": [
      {
       "_type": "block",
       "style": "h2",
       "_key": "k143",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Pick a path with a view",
         "_key": "k144",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k145",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Coastal paths work best when they are short enough to finish and long enough to feel earned. Two hours is about right.",
         "_key": "k146",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k147",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Wild places nearby",
         "_key": "k148",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k149",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Nature is usually closer than we think. A headland a few stops from the station can feel a long way from anywhere.",
         "_key": "k150",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k151",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Leave no trace",
         "_key": "k152",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k153",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Carry out what you carry in, stay on the path and leave the shells where they are.",
         "_key": "k154",
         "marks": []
        }
       ]
      }
     ],
