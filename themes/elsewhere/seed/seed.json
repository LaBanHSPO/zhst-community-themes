     "title": "A Morning in Kyoto",
     "deck": "Cherry blossom, quiet temple lanes and a pagoda before the crowds.",
     "excerpt": "Blossom, quiet temple lanes and a pagoda seen before the crowds arrive.",
     "content": [
      {
       "_type": "block",
       "style": "h2",
       "_key": "k61",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Before the crowds",
         "_key": "k62",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k63",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Be at the temple gate when it opens. For an hour the lanes belong to monks, gardeners and a few early walkers.",
         "_key": "k64",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k65",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Tea and a quiet corner",
         "_key": "k66",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k67",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "A small teahouse off the main path turns a rushed sightseeing day into something closer to a ritual.",
         "_key": "k68",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k69",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Walk back the long way",
         "_key": "k70",
         "marks": []
