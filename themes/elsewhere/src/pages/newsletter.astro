---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { getProfile, photoAlt, photoSrc, sortByPosition } from "../lib/elsewhere";

const [profileResult, perksResult, editionsResult] = await Promise.all([
	getProfile(),
	getEmDashCollection("perks", { limit: 6 }),
	getEmDashCollection("editions", { limit: 1 }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(profileResult.cacheHint);
	Astro.cache.set(perksResult.cacheHint);
	Astro.cache.set(editionsResult.cacheHint);
}
const { profile } = profileResult;
const perks = sortByPosition(perksResult.entries.map((e) => ({ id: e.id, data: e.data })));
const edition = editionsResult.entries[0]?.data;
---

<Base title="Newsletter" description="Slow travel stories, beautiful places and everyday inspiration — a thoughtful note, once a month.">
	<section class="hero hero-news" aria-labelledby="news-title">
		<div class="hero-photo">
			<img src="/images/newsletter-hero.webp" alt="A stone terrace with a notebook and a mug above the Amalfi Coast" width="912" height="488" fetchpriority="high" />
		</div>
		<div class="hero-inner">
			<p class="eyebrow">The newsletter</p>
			<h1 id="news-title" class="h-display">A little elsewhere, in your inbox.</h1>
			<p class="lede">Slow travel stories, beautiful places and everyday inspiration — a thoughtful note, once a month.</p>
			<NewsletterForm id="news" email={profile.email ?? ""} button="Subscribe" note="We’ll only send you our monthly newsletter. No spam, ever." />
		</div>
	</section>

	<div class="container news-body">
		<section class="perk-wrap" aria-labelledby="perks-title">
			<p class="eyebrow">What you’ll get</p>
			<h2 id="perks-title">Real places. A slower perspective. Every month.</h2>
			<ul class="perks" role="list">
				{
					perks.map(({ id, data: p }) => (
						<li class="perk">
							<Icon name={p.icon === "camera" ? "camera" : p.icon === "binoculars" ? "binoculars" : "sprig"} size={40} />
							<h3>{p.title}</h3>
							<p>{p.blurb}</p>
						</li>
					))
				}
			</ul>
		</section>
		{
			edition && (
				<section class="edition-wrap" aria-labelledby="edition-title">
					<p id="edition-title" class="eyebrow">A preview from the latest edition</p>
					<article class="edition">
						<p class="edition-top">
							<span>Elsewhere</span>
							<span>Issue No. {edition.issue} · {edition.month}</span>
						</p>
						<div class="edition-grid">
							<div>
								<h3>{edition.title}</h3>
								<p class="blurb">{edition.blurb}</p>
								{edition.post_slug && (
									<a class="text-link" href={`/posts/${edition.post_slug}`}>Read the full newsletter <Icon name="arrow" size={14} /></a>
								)}
							</div>
							<img
								src={photoSrc(edition.image, edition.photo)}
								alt={photoAlt(edition.image, edition.photo_alt, edition.title)}
								width="387"
								height="234"
								loading="lazy"
							/>
						</div>
					</article>
				</section>
			)
		}
	</div>
</Base>
