---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { getProfile, photoAlt, photoSrc, sortByPosition } from "../lib/elsewhere";

const [profileResult, topicsResult] = await Promise.all([getProfile(), getEmDashCollection("topics", { limit: 12 })]);
if (Astro.cache?.enabled) {
	Astro.cache.set(profileResult.cacheHint);
	Astro.cache.set(topicsResult.cacheHint);
}
const { profile } = profileResult;
const topics = sortByPosition(topicsResult.entries.map((e) => ({ id: e.id, data: e.data })));
const firstName = (profile.title ?? "").split(" ")[0] || "there";
const portrait = photoSrc(profile.portrait, profile.portrait_photo) ?? "/images/claire-hero.webp";
---

<Base title="About the author" description={profile.role ?? "A travel writer and believer in a slower way to see the world."}>
	<section class="hero hero-about" aria-labelledby="about-title">
		<div class="hero-photo">
			<img src={portrait} alt={photoAlt(profile.portrait, profile.portrait_alt, `${profile.title ?? "The author"}, portrait`)} width="1032" height="390" fetchpriority="high" />
		</div>
		<div class="hero-inner">
			<p class="eyebrow">About the author</p>
			<h1 id="about-title" class="h-page">Hi, I’m {firstName}.</h1>
			<p class="lede">{profile.role}</p>
			<p class="intro">{profile.intro}</p>
			<a class="btn" href="/destinations">Read the journal <Icon name="arrow" size={16} /></a>
		</div>
	</section>

	<div class="container approach">
		<div class="approach-text">
			<p class="eyebrow">My approach</p>
			<h2>Slower Travel, Richer Stories</h2>
			<p>
				I believe the best travel experiences happen when we slow down — when we take time to connect with a place, its people and everyday life. Here you’ll find stories, guides and reflections to inspire a more mindful way of exploring the world.
			</p>
			<a class="text-link" href="/destinations">More about Elsewhere <Icon name="arrow" size={14} /></a>
		</div>
		<ul class="topic-grid" role="list">
			{
				topics.map(({ id, data: t }) => (
					<li class="topic-card">
						<img src={photoSrc(t.image, t.photo)} alt={photoAlt(t.image, t.photo_alt, t.title)} width="357" height="168" loading="lazy" />
						<p class="eyebrow">{t.kicker}</p>
						<h3><a href={t.tag ? `/tag/${t.tag}` : "/destinations"}>{t.title}</a></h3>
						<p>{t.blurb}</p>
						<a class="arrow-link" href={t.tag ? `/tag/${t.tag}` : "/destinations"} aria-label={`Read stories: ${t.title}`}><Icon name="arrow" size={22} /></a>
					</li>
				))
			}
		</ul>
	</div>

	<section class="stay" aria-labelledby="stay-title">
		<div class="stay-photo"><img src="/images/banner.webp" alt="" width="1672" height="311" loading="lazy" /></div>
		<div class="stay-inner">
			<div>
				<p class="eyebrow eyebrow-muted">Stay in touch</p>
				<h2 id="stay-title">Stories worth travelling for.</h2>
				<p class="sub">Join my newsletter for new articles, travel inspiration and notes from the road.</p>
			</div>
			<NewsletterForm id="about" email={profile.email ?? ""} button="Join the newsletter" showFallback={false} />
		</div>
	</section>
</Base>
