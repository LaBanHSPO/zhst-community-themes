---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import StoryCard from "../components/StoryCard.astro";
import { REGIONS, getPosts, getProfile, isRegion } from "../lib/elsewhere";

const regionParam = Astro.url.searchParams.get("region");
const region = isRegion(regionParam) ? regionParam : null;
const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 80);

const [postsResult, profileResult] = await Promise.all([getPosts(), getProfile()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(postsResult.cacheHint);
	Astro.cache.set(profileResult.cacheHint);
}
const needle = q.toLowerCase();
const posts = postsResult.entries
	.map((e) => e.data)
	.filter((p) => !region || p.region === region)
	.filter(
		(p) =>
			!needle ||
			[p.title, p.excerpt, p.topic, p.region, ...(p.terms?.tag ?? []).map((t) => t.label)]
				.filter(Boolean)
				.join(" ")
				.toLowerCase()
				.includes(needle),
	);
const link = (value: string | null) => {
	const params = new URLSearchParams();
	if (value) params.set("region", value);
	if (q) params.set("q", q);
	const qs = params.toString();
	return qs ? `/destinations?${qs}` : "/destinations";
};
---

<Base title="Destination archive" description="Handpicked destinations, real stories and practical ideas for a slower, more meaningful way to explore the world.">
	<section class="hero hero-archive" aria-labelledby="archive-title">
		<div class="hero-photo">
			<img src="/images/banner.webp" alt="Boats on a calm sea below a hillside village on the Amalfi Coast" width="1672" height="311" />
		</div>
		<div class="hero-inner">
			<p class="eyebrow">Destination archive</p>
			<h1 id="archive-title" class="h-page">Places to linger</h1>
			<p class="lede">Handpicked destinations, real stories and practical ideas for a slower, more meaningful way to explore the world.</p>
		</div>
	</section>

	<div class="container">
		<div class="archive-tools" id="search">
			<nav class="pills" aria-label="Regions">
				<a class="pill" href={link(null)} aria-current={region ? undefined : "true"}>All destinations</a>
				{REGIONS.map((r) => <a class="pill" href={link(r.value)} aria-current={region === r.value ? "true" : undefined}>{r.label}</a>)}
			</nav>
			<form class="search-form" role="search" action="/destinations" method="get">
				<Icon name="search" size={18} />
				<label class="visually-hidden" for="archive-q">Search destinations, countries or themes</label>
				<input id="archive-q" type="search" name="q" value={q} placeholder="Search destinations, countries or themes..." />
				{region && <input type="hidden" name="region" value={region} />}
			</form>
		</div>
		{
			posts.length === 0 ? (
				<p class="empty">
					No stories match{q ? ` “${q}”` : ""}. <a class="text-link" href="/destinations">Clear filters</a>
				</p>
			) : (
				<ul class="card-grid" role="list">
					{posts.map((p) => (
						<li>
							<StoryCard post={p} profile={profileResult.profile} headingLevel={2} />
						</li>
					))}
				</ul>
			)
		}
	</div>
</Base>
