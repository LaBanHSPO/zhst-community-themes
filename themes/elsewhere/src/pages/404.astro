---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<section class="notfound container">
		<p class="eyebrow">404</p>
		<h1>This path leads nowhere.</h1>
		<p>The page you are looking for does not exist or has moved. The scenic route usually starts on the homepage.</p>
		<div class="actions">
			<a class="btn" href="/destinations">Browse the archive</a>
			<a class="btn btn-outline" href="/">Back to the homepage</a>
		</div>
	</section>
</Base>
