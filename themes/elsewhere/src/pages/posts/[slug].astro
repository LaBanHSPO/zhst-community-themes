---
import { getEmDashEntry, getEmDashCollection, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import StoryCard from "../../components/StoryCard.astro";
import { entryKey, formatDate, getProfile, photoAlt, photoSrc, regionLabel, splitSections } from "../../lib/elsewhere";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.redirect("/404");

const [related, settings, profileResult] = await Promise.all([
	getEmDashCollection("posts", { orderBy: { position: "asc" }, limit: 30 }),
	getSiteSettings(),
	getProfile(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(related.cacheHint);
	Astro.cache.set(profileResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const d = post.data;
const { profile } = profileResult;
const tags = d.terms?.tag ?? [];
const src = photoSrc(d.featured_image, d.photo);
const inlineSrc = photoSrc(d.inline_image, d.inline_photo) ?? src;
const inlineAlt = d.inline_image?.alt || d.inline_alt || d.photo_alt || d.title;
const sections = splitSections(d.content as never);
const showToc = sections.length > 1 && sections.every((s) => s.title);
const updated = formatDate(d.updated_on ?? d.updatedAt);
const more = related.entries
	.map((e) => e.data)
	.filter((e) => entryKey(e) !== entryKey(d) && e.region === d.region)
	.slice(0, 4);
const num = (i: number) => String(i + 1).padStart(2, "0");
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.excerpt}
	canonical={seo.canonical}
	image={seo.ogImage ?? src}
	content={{ collection: "posts", id: d.id, slug }}
>
	<article>
		<div class="banner">
			<img src="/images/banner.webp" alt="Boats on a calm sea below a hillside village on the Amalfi Coast" width="1672" height="311" fetchpriority="high" />
		</div>
		<header class="container-narrow article-head">
			<div>
				<p class="eyebrow">{d.topic ?? regionLabel(d.region)}</p>
				<h1 {...post.edit.title}>{d.title}</h1>
				{(d.deck ?? d.excerpt) && <p class="lede" {...post.edit.deck}>{d.deck ?? d.excerpt}</p>}
				<div class="article-by">
					{profile.avatar_photo && <img src={profile.avatar_photo} alt="" width="62" height="62" />}
					<p>
						By {profile.title}
						{updated && <><br /><span class="updated">Updated {updated}</span></>}
					</p>
				</div>
			</div>
			{
				showToc && (
					<nav class="toc" aria-labelledby="toc-title">
						<p id="toc-title" class="eyebrow eyebrow-muted">On this page</p>
						<ol>
							{sections.map((s, i) => (
								<li>
									<a href={`#${s.id}`}>
										<span>{num(i)}</span>
										{s.title}
									</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}
		</header>
		<div class="container-narrow"><hr class="article-rule" /></div>

		<div class="container-narrow sections">
			{
				sections.map((s, i) =>
					i === 0 ? (
						<section class="sec" id={s.id} aria-labelledby={`${s.id}-title`}>
							<div class="sec-media">
								{inlineSrc && <img src={inlineSrc} alt={inlineAlt} width="644" height="257" loading="lazy" />}
							</div>
							<div class="sec-text">
								{s.title && (
									<>
										<p class="sec-num">{num(i)}</p>
										<h2 id={`${s.id}-title`}>{s.title}</h2>
									</>
								)}
								<div class="prose" {...(s.title ? {} : post.edit.content)}>
									<PortableText value={s.blocks as never} />
								</div>
							</div>
						</section>
					) : (
						<section class="sec sec-plain" id={s.id} aria-labelledby={`${s.id}-title`}>
							<div class="sec-head">
								<p class="sec-num">{num(i)}</p>
								<h2 id={`${s.id}-title`}>{s.title}</h2>
							</div>
							<div class="sec-body">
								<div class="prose">
									<PortableText value={s.blocks as never} />
								</div>
							</div>
						</section>
					),
				)
			}
		</div>

		{
			tags.length > 0 && (
				<footer class="container-narrow article-foot">
					<a class="pill" href={`/destinations?region=${d.region}`}>{regionLabel(d.region)}</a>
					{tags.map((t) => <a class="pill" href={`/tag/${t.slug}`}>#{t.label}</a>)}
				</footer>
			)
		}
	</article>

	{
		more.length > 0 && (
			<section class="container more-block" aria-labelledby="more-title">
				<div class="head">
					<h2 id="more-title" class="h-section">More to linger over</h2>
					<a class="text-link" href="/destinations">Destination archive <Icon name="arrow" size={14} /></a>
				</div>
				<ul class="card-grid" role="list">
					{more.map((p) => <li><StoryCard post={p} profile={profile} /></li>)}
				</ul>
			</section>
		)
	}
</Base>
