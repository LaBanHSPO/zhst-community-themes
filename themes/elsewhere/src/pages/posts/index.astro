---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import StoryCard from "../../components/StoryCard.astro";
import { getProfile } from "../../lib/elsewhere";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const [{ entries, cacheHint, nextCursor }, profileResult] = await Promise.all([
	getEmDashCollection("posts", { orderBy: { position: "asc" }, limit: 12, cursor }),
	getProfile(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(profileResult.cacheHint);
}
---

<Base title="All stories" description="Every story in the Elsewhere journal.">
	<div class="container">
		<header class="simple-head">
			<p class="eyebrow">The journal</p>
			<h1 class="h-page">All stories</h1>
			<p class="back"><a class="text-link" href="/destinations">Browse by destination</a></p>
		</header>
		<div class="archive-tools"></div>
		{
			entries.length === 0 ? (
				<p class="empty">No stories yet.</p>
			) : (
				<ul class="card-grid" role="list">
					{entries.map((e) => (
						<li>
							<StoryCard post={e.data} profile={profileResult.profile} headingLevel={2} />
						</li>
					))}
				</ul>
			)
		}
		<nav class="pager" aria-label="Pagination">
			{cursor && <a class="text-link" href="/posts">First page</a>}
			{nextCursor && <a class="btn btn-sm" href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>Next page</a>}
		</nav>
	</div>
</Base>
