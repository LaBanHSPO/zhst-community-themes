---
interface Props {
	name: "search" | "arrow" | "sprig" | "camera" | "binoculars" | "menu";
	size?: number;
	class?: string;
}
const { name, size = 24, class: className } = Astro.props;
---

<svg
	class={`icon ${className ?? ""}`}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{
		name === "search" && (
			<>
				<circle cx="11" cy="11" r="6.5" />
				<path d="m16 16 4.5 4.5" />
			</>
		)
	}
	{
		name === "arrow" && (
			<>
				<path d="M3 12h17" />
				<path d="m15 7 5 5-5 5" />
			</>
		)
	}
	{
		name === "sprig" && (
			<>
				<path d="M4 21C8 17 12 12 18 4" />
				<path d="M9.800 15.200C8 15.400 6.600 14.500 6 12.600c1.900-.200 3.300.600 3.800 2.600Z" />
				<path d="M13.200 10.800c-.100-1.900.9-3.200 2.800-3.800.300 1.900-.600 3.300-2.800 3.800Z" />
				<path d="M11.500 13c1.800-.700 3.400-.400 4.700.900-1.500 1.200-3.300 1.100-4.700-.900Z" />
				<path d="M8.700 17.800c-.900 1.100-2.200 1.400-3.700.900.600-1.500 1.900-2 3.700-.900Z" />
			</>
		)
	}
	{
		name === "camera" && (
			<>
				<rect x="3" y="6.500" width="18" height="13" rx="1.500" />
				<path d="M8.500 6.500 9.700 4h4.600l1.200 2.500" />
				<circle cx="12" cy="13" r="3.500" />
			</>
		)
	}
	{
		name === "binoculars" && (
			<>
				<circle cx="6.500" cy="16" r="3.500" />
				<circle cx="17.500" cy="16" r="3.500" />
				<path d="M10 16h4" />
				<path d="M4.500 13 7 5h2.500v7" />
				<path d="M19.500 13 17 5h-2.500v7" />
			</>
		)
	}
	{
		name === "menu" && <path d="M3 7h18M3 12h18M3 17h18" />
	}
</svg>
