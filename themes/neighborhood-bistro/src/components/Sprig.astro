---
/** Olive sprig mark used in the wordmark and as a section ornament. Decorative. */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
// One slender leaf pointing up from its base at (0,0); placed along the stem with a rotation.
const leaf = "M0 0C1.7-2.8 2.3-6.6 0.4-10.4C-1.9-7.2-1.9-3.2 0 0Z";
const leaves = [
	{ x: 11.5, y: 29.2, r: -24, s: 0.95 },
	{ x: 13.2, y: 27.8, r: 98, s: 0.8 },
	{ x: 17, y: 24.6, r: -14, s: 1.05 },
	{ x: 18.8, y: 23.2, r: 104, s: 0.95 },
	{ x: 22.6, y: 20, r: -6, s: 1.1 },
	{ x: 24.6, y: 18.4, r: 108, s: 1 },
	{ x: 27.8, y: 15.6, r: 6, s: 1 },
	{ x: 29.6, y: 14.2, r: 112, s: 0.85 },
	{ x: 33, y: 11.4, r: 52, s: 1 },
];
---

<svg class:list={["sprig", className]} viewBox="0 0 40 36" aria-hidden="true" focusable="false">
	<path d="M6.5 33.5C15 26.5 24 19 33.5 11" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
	<g fill="currentColor">
		{leaves.map((l) => <path d={leaf} transform={`translate(${l.x} ${l.y}) rotate(${l.r}) scale(${l.s})`} />)}
	</g>
</svg>
