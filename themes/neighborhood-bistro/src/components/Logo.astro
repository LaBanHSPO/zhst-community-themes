---
/** Wordmark: sprig above the first part of the site name in tracked caps, the last word smaller in gold. */
import Sprig from "./Sprig.astro";

interface Props {
	title: string;
	logo?: { url?: string; alt?: string } | null;
	class?: string;
}
const { title, logo, class: className } = Astro.props;
const words = title.trim().split(/\s+/);
const main = words.length > 1 ? words.slice(0, -1).join(" ") : title;
const sub = words.length > 1 ? words[words.length - 1] : "";
---

<a class:list={["wordmark", className]} href="/" aria-label={`${title}, home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt || title} />
		) : (
			<>
				<Sprig class="wordmark-sprig" />
				<span class="wordmark-main">{main}</span>
				{sub && <span class="wordmark-sub">{sub}</span>}
			</>
		)
	}
</a>
