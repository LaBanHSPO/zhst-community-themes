---
import { getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import Sprig from "../components/Sprig.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getDishes, getHours, getVenue, mapLinks, photoSrc } from "../lib/bistro";

const [dishesResult, hoursResult, venueResult, settings] = await Promise.all([
	getDishes(),
	getHours(),
	getVenue(),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(dishesResult.cacheHint);
	Astro.cache.set(hoursResult.cacheHint);
	Astro.cache.set(venueResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const featured = dishesResult.entries.filter((d) => d.data.featured).slice(0, 3);
const hours = hoursResult.entries;
const { venue } = venueResult;
const links = mapLinks(venue);
---

<Base title={siteTitle} description="Seasonal ingredients. Thoughtful dishes. A warmer kind of neighborhood." overlay current="/">
	<section class="hero hero-home" aria-labelledby="hero-title">
		<img
			class="hero-bg"
			src="/images/hero-home.webp"
			alt=""
			width="1448"
			height="668"
			fetchpriority="high"
		/>
		<div class="hero-copy">
			<h1 id="hero-title">Good food.<br />Great company.</h1>
			<p class="hero-lede">Seasonal ingredients. Thoughtful dishes. <br />A warmer kind of neighborhood.</p>
			<a class="btn btn-lg" href="/book">Book a table</a>
		</div>
	</section>

	<section class="kitchen" aria-labelledby="kitchen-title">
		<div class="kitchen-copy">
			<span class="eyebrow">Our kitchen</span>
			<h2 id="kitchen-title">Rooted in the season.<br />Inspired by our neighbors.</h2>
			<p>
				We create approachable, seasonal dishes that bring people together — because great meals feel even better when
				they're shared.
			</p>
			<span class="rule" aria-hidden="true"></span>
		</div>
		<img
			class="kitchen-photo kitchen-photo-a"
			src="/images/kitchen-salad.webp"
			alt="Roasted beet salad with goat cheese, orange and walnuts in a stoneware bowl"
			width="375"
			height="337"
			loading="lazy"
		/>
		<img
			class="kitchen-photo kitchen-photo-b"
			src="/images/kitchen-room.webp"
			alt="The dining room with bentwood chairs, a pendant lamp and a chalkboard by the window"
			width="294"
			height="365"
			loading="lazy"
		/>
	</section>

	{
		featured.length > 0 && (
			<section class="highlights" aria-labelledby="highlights-title">
				<div class="container">
					<div class="section-head">
						<div>
							<span class="eyebrow">On the menu</span>
							<h2 id="highlights-title">A short menu that follows the market.</h2>
						</div>
						<a class="text-link" href="/menu">
							See the full menu
						</a>
					</div>
					<ul class="dish-cards">
						{featured.map((d) => {
							const src = photoSrc(d.data.image, d.data.photo);
							return (
								<li class="dish-card">
									{src && (
										<img src={src} alt={d.data.image?.alt || d.data.title} width="600" height="420" loading="lazy" />
									)}
									<div class="dish-card-body">
										<div class="dish-card-top">
											<h3 {...d.edit.title}>{d.data.title}</h3>
											<span class="price">{d.data.price}</span>
										</div>
										{d.data.description && <p>{d.data.description}</p>}
										{d.data.dietary && <span class="dietary">{d.data.dietary}</span>}
									</div>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	<section class="visit-band" aria-labelledby="band-title">
		<img
			class="visit-band-photo"
			src="/images/dining-room-evening.webp"
			alt="Candlelit tables and a green banquette in the evening dining room"
			width="808"
			height="640"
			loading="lazy"
		/>
		<div class="visit-band-copy">
			<Sprig class="band-sprig" />
			<span class="eyebrow eyebrow-light">Visit us</span>
			<h2 id="band-title">Pull up a chair.</h2>
			<p>
				{venue.street}{venue.locality && <>, {venue.locality}</>}
			</p>
			{
				hours.length > 0 && (
					<dl class="band-hours">
						{hours.map((h) => (
							<div>
								<dt>{h.data.title}</dt>
								<dd>{h.data.hours}</dd>
							</div>
						))}
					</dl>
				)
			}
			<div class="actions">
				<a class="btn" href="/book">Book a table</a>
				<a class="btn btn-ghost" href={links.directions} target="_blank" rel="noopener noreferrer">
					Get directions<span class="sr-only"> (opens Google Maps in a new tab)</span>
				</a>
			</div>
		</div>
	</section>
</Base>
