	"content": {
		"pages": [
			{
				"id": "our-story",
				"slug": "our-story",
				"status": "published",
				"data": {
					"title": "A table for the whole street.",
					"eyebrow": "Our story",
					"intro": "Neighborhood Bistro opened on a quiet corner with twelve tables, a wood-fired stove and a simple idea: cook honest, seasonal food for the people who live around us.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "b0",
							"children": [
								{
									"_type": "span",
									"text": "We started as a Sunday supper club in a borrowed kitchen. Neighbors brought wine, we brought whatever the market had that morning, and the evenings ran long. When the old corner bakery closed, it felt like the right room to keep that table going.",
									"_key": "b0s"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b1",
							"children": [
								{
									"_type": "span",
									"text": "Today our kitchen still works the same way. We buy from a handful of small farms and one fishmonger we trust, write the menu around what arrives, and keep it short so everything on it is cooked with care.",
									"_key": "b1s"
								}
							]
						},
						{
							"_type": "block",
							"style": "h2",
							"_key": "b2",
							"children": [
								{
									"_type": "span",
									"text": "Who cooks for you",
									"_key": "b2s"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b3",
							"children": [
								{
									"_type": "span",
									"text": "Our chef grew up in her grandmother's kitchen and spent ten years in city restaurants before coming home to cook the food she loves to eat. The front of house is run by her brother, who knows most regulars by name and the rest by their usual order.",
									"_key": "b3s"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b4",
							"children": [
								{
									"_type": "span",
									"text": "Whether you come for a glass at the bar, a long dinner with friends or a birthday with the whole family, we hope you leave feeling like a neighbor.",
									"_key": "b4s"
								}
							]
						}
					]
				}
			},
			{
				"id": "private-dining",
				"slug": "private-dining",
				"status": "published",
				"data": {
					"title": "Private dining",
					"eyebrow": "Gatherings",
					"intro": "Our back room seats up to twenty-four for birthdays, rehearsal dinners and long Sunday lunches.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "b0",
							"children": [
								{
									"_type": "span",
									"text": "We build a sharing menu with you around the season: a few snacks to start, two or three starters for the table, a choice of mains and something sweet to finish.",
									"_key": "b0s"
								}
							]
						},
						{
							"_type": "block",
							"style": "h2",
							"_key": "b1",
							"children": [
								{
									"_type": "span",
									"text": "How it works",
									"_key": "b1s"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b2",
							"children": [
								{
									"_type": "span",
									"text": "Send us your date, the number of guests and anything we should know. We reply within two working days with menu ideas and a quote. A deposit holds the room.",
									"_key": "b2s"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b3",
							"children": [
								{
									"_type": "span",
									"text": "The room has its own entrance, a long oak table and a small speaker for music or a few words.",
									"_key": "b3s"
								}
							]
						}
					]
				}
			},
			{
				"id": "allergies",
				"slug": "allergies",
				"status": "published",
				"data": {
					"title": "Allergies & dietary needs",
					"eyebrow": "Good to know",
					"intro": "We cook everything from scratch, so we can usually adapt a dish for you.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "b0",
							"children": [
								{
									"_type": "span",
									"text": "Please tell your server about any allergy before you order. Our menu marks vegetarian (V), vegan (VG) and gluten-free (GF) dishes, but our kitchen handles nuts, gluten, dairy and shellfish, so we cannot guarantee any dish is free of traces.",
									"_key": "b0s"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b1",
							"children": [
								{
									"_type": "span",
									"text": "If you have a severe allergy, mention it when you request a table and the chef will plan ahead.",
									"_key": "b1s"
								}
							]
						}
					]
				}
			}
		],
