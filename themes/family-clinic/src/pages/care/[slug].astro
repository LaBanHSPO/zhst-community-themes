---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import VisitBand from "../../components/VisitBand.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getClinic, getServices, lines, photoAlt, photoSrc } from "../../lib/clinic";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: service, cacheHint } = await getEmDashEntry("services", slug);
if (!service) return Astro.rewrite("/404");

const [allResult, clinicResult, settings] = await Promise.all([getServices(), getClinic(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
	Astro.cache.set(clinicResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(service, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
const d = service.data;
const cover = photoSrc(d.image, d.photo);
const hasBody = Boolean(d.content && d.content.length > 0);
const others = allResult.entries.filter((s) => s.data.id !== d.id);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary}
	canonical={seo.canonical}
	image={seo.ogImage ?? cover}
	content={{ collection: "services", id: d.id, slug }}
	current="/care"
>
	<header class="detail-head">
		<div class="wrap">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/care">Care</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{d.title}</span>
			</nav>
			<div class="detail-grid">
				<div class="detail-copy">
					<p class="eyebrow">Care</p>
					<h1 class="display display-xl" {...service.edit.title}>{d.title}</h1>
					<p class="lede">{d.summary}</p>
					{d.best_for && <p class="detail-for"><strong>Who it is for</strong> {d.best_for}</p>}
					<p class="detail-actions">
						<a class="btn btn-teal" href={`/contact?service=${encodeURIComponent(d.slug ?? d.id)}`}>
							<span>Book an appointment</span><Arrow />
						</a>
					</p>
				</div>
				{cover && <img class="detail-cover" src={cover} alt={photoAlt(d.image, d.photo, d.title)} width="800" height="680" fetchpriority="high" />}
			</div>
		</div>
	</header>

	<section class="detail-body">
		<div class="wrap detail-body-grid">
			<div class="prose">
				{hasBody ? <PortableText value={d.content} /> : <p>{d.summary}</p>}
			</div>
			<aside class="side-stack">
				{
					lines(d.visit).length > 0 && (
						<div class="side-card" aria-labelledby="visit-list-title">
							<h2 id="visit-list-title" class="side-title">What a visit involves</h2>
							<ol class="visit-steps">
								{lines(d.visit).map((i) => <li>{i}</li>)}
							</ol>
						</div>
					)
				}
				{
					d.how_to_book && (
						<div class="side-card side-card-mint">
							<h2 class="side-title">How to book</h2>
							<p>{d.how_to_book}</p>
							<p class="side-action">
								<a class="btn btn-teal" href={`/contact?service=${encodeURIComponent(d.slug ?? d.id)}`}><span>Book an appointment</span><Arrow /></a>
							</p>
						</div>
					)
				}
			</aside>
		</div>
	</section>

	{
		others.length > 0 && (
			<section class="more-band" aria-labelledby="more-title">
				<div class="wrap">
					<div class="section-head section-head-row">
						<div>
							<p class="eyebrow eyebrow-green">More care</p>
							<h2 id="more-title" class="display">Other visits we offer.</h2>
						</div>
						<a class="text-link" href="/care"><span>All care</span><Arrow /></a>
					</div>
					<ul class="care-cards care-cards-3">
						{others.map((s) => <li><ServiceCard service={s} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	<VisitBand clinic={clinicResult.clinic} />
</Base>
