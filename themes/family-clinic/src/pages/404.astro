---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<img class="notfound-photo" src="/images/sign.webp" alt="" width="712" height="702" />
		<div class="notfound-copy">
			<p class="eyebrow">Error 404</p>
			<h1 id="nf-title" class="display display-xl">We could not find that page.</h1>
			<p class="lede">The page may have moved, or the address may have a typo. These links will get you back on track.</p>
			<div class="actions">
				<a class="btn btn-teal" href="/"><span>Back to home</span><Arrow /></a>
				<a class="pill" href="/care">Care</a>
				<a class="pill" href="/contact">Contact</a>
			</div>
		</div>
	</section>
</Base>
