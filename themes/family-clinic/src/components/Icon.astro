---
interface Props {
	name?: string | null;
	size?: number;
}
const { name, size = 32 } = Astro.props;
const attrs = { width: size, height: size, viewBox: "0 0 32 32", fill: "none", stroke: "currentColor", "stroke-width": 1.6, "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true", focusable: "false" } as const;
---

{
	name === "people" ? (
		<svg {...attrs}>
			<circle cx="11" cy="10.500" r="4.200" />
			<path d="M3 26c0-5.200 3.600-8.500 8-8.500s8 3.300 8 8.500" />
			<circle cx="22.500" cy="11" r="3.400" />
			<path d="M21.500 17.800c4.500-.4 7.500 2.300 7.500 7.200" />
		</svg>
	) : name === "heart" ? (
		<svg {...attrs}>
			<path d="M16 27.500C7.500 21.500 3.500 17.400 3.500 12.200 3.500 8.600 6.200 6 9.600 6c2.500 0 4.700 1.400 6.400 4 1.700-2.600 3.900-4 6.400-4 3.400 0 6.100 2.600 6.100 6.200 0 5.200-4 9.300-12.500 15.300Z" />
		</svg>
	) : name === "leaf" ? (
		<svg {...attrs}>
			<path d="M6 26C3.500 17 8 7 26 5c1.200 14.500-6.500 23-20 21Z" />
			<path d="M5.500 28C10 22 15 17.500 22 13.500" />
		</svg>
	) : name === "stethoscope" ? (
		<svg {...attrs}>
			<path d="M9 4.500H7v8.500a6.500 6.500 0 0 0 13 0V4.500h-2" />
			<path d="M13.500 19.500v3a5.500 5.500 0 0 0 11 0v-4.500" />
			<circle cx="24.500" cy="15.500" r="2.800" />
		</svg>
	) : name === "baby" ? (
		<svg {...attrs}>
			<circle cx="16" cy="8.500" r="4.600" />
			<path d="M9.500 25.500c-1.300-5.500.4-10.300 6.500-10.300s7.800 4.800 6.500 10.300c-2 1.300-4 1.800-6.500 1.800s-4.500-.5-6.500-1.800Z" />
			<circle cx="9.800" cy="26.800" r="2" />
			<circle cx="22.200" cy="26.800" r="2" />
		</svg>
	) : name === "family" ? (
		<svg {...attrs}>
			<circle cx="9.500" cy="9" r="3.200" />
			<circle cx="22.500" cy="9" r="3.200" />
			<circle cx="16" cy="16.500" r="2.700" />
			<path d="M3 22.500c0-4 2.600-6.500 6.500-6.500" />
			<path d="M29 22.500c0-4-2.600-6.500-6.500-6.500" />
			<path d="M10.800 27.500c0-3.600 2.300-5.700 5.200-5.700s5.200 2.100 5.200 5.700" />
		</svg>
	) : (
		<svg {...attrs}>
			<circle cx="16" cy="16" r="10" />
			<path d="M16 11v10M11 16h10" />
		</svg>
	)
}
