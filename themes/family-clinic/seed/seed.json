    "data": {
     "tile_text": "Ongoing support\nfor lasting health.",
     "title": "Chronic Care",
     "summary": "Ongoing support for lasting health.",
     "best_for": "People living with a long-term condition, such as asthma, diabetes or high blood pressure",
     "icon": "heart",
     "tint": "lavender",
     "position": 40,
     "photo": "/images/care-chronic.webp",
     "visit": "A regular review visit, usually every three to six months\nA medicine check, including anything prescribed elsewhere\nA look at recent test results with your clinician\nA written plan, and a contact for questions between visits",
     "how_to_book": "Request a review visit on the contact page or call the front desk. If you already have test results from another provider, please bring them or ask them to send them to us.",
     "content": [
      {
       "_type": "block",
       "_key": "k28",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Living with a long-term condition means regular check-ins. Our chronic care visits are set aside for that: unhurried time with the same small group of clinicians who know your history.",
         "_key": "k28s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k29",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "How chronic care visits work",
         "_key": "k29s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k30",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Your clinician sets a review schedule with you",
         "_key": "k30s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k31",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Each visit starts with what has changed since the last one",
         "_key": "k31s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k32",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Medicines and test results are reviewed together",
         "_key": "k32s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k33",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Referrals to specialists are arranged when they are needed",
         "_key": "k33s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k34",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Between visits",
         "_key": "k34s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k35",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Non-urgent questions can be sent to the front desk by phone or email. Please do not send test results or symptoms by email. If you feel unwell in a way that worries you, call the clinic during opening hours or your local emergency number if it is an emergency.",
         "_key": "k35s"
        }
