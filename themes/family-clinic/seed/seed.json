 "content": {
  "pages": [
   {
    "id": "patients",
    "slug": "patients",
    "status": "published",
    "data": {
     "title": "Information for patients",
     "eyebrow": "For patients",
     "intro": "What to do before your first visit, what to bring, and how we handle changes and after-hours questions.",
     "content": [
      {
       "_type": "block",
       "_key": "k36",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "New patients",
         "_key": "k36s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k37",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "We welcome new patients of all ages. Send an appointment request from the contact page or call the front desk, and tell us if you are booking for yourself or for a family member. We will reply with a time and a link to the new-patient form.",
         "_key": "k37s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k38",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Please fill in the form before you come. It covers your contact details, your medical history and the medicines you take, so more of your visit can be spent talking with your clinician.",
         "_key": "k38s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k39",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "What to bring",
         "_key": "k39s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k40",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Photo ID (for children, a parent or carer's ID)",
         "_key": "k40s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k41",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Your insurance card, if you have one",
         "_key": "k41s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k42",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "A list of your medicines, vitamins and supplements",
         "_key": "k42s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k43",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Any recent test results or letters from other providers",
         "_key": "k43s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k44",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "A list of questions, if you like to keep one",
         "_key": "k44s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k45",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Opening hours",
         "_key": "k45s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k46",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Our opening hours are shown on this page and on the contact page. The front desk answers the phone during opening hours.",
         "_key": "k46s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k47",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Cancellations and changes",
         "_key": "k47s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k48",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "If you cannot come, please tell us at least 24 hours ahead by phone or email so another patient can have the time. If you are running late, call the front desk. We will see you if we can, or offer a new time.",
         "_key": "k48s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k49",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "After-hours questions",
         "_key": "k49s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k50",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "When the clinic is closed, leave a message on the clinic line and we will call back the next working day. For urgent care outside opening hours, contact your local urgent care service. In an emergency, call your local emergency number.",
         "_key": "k50s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k51",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Insurance and payment",
         "_key": "k51s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k52",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Tell us which plan you have when you book and we will confirm what is covered before your visit. If you do not have insurance, ask the front desk about self-pay options. This text is a placeholder: replace it with your own policy.",
         "_key": "k52s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k53",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Your privacy",
         "_key": "k53s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k54",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Please do not send medical details through the website form or by email. Share them in person or on the phone, where we can keep them with your record.",
         "_key": "k54s"
        }
       ],
       "markDefs": []
      }
     ]
    }
   },
   {
    "id": "privacy",
    "slug": "privacy",
    "status": "published",
    "data": {
     "title": "How we handle your request",
     "eyebrow": "Good to know",
     "intro": "A short note on what happens when you send an appointment request from this site.",
     "content": [
      {
       "_type": "block",
       "_key": "k55",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "The appointment request form on this site does not send anything by itself. When you press the button, your email app opens with a message already written. The request only reaches the clinic when you send that email.",
         "_key": "k55s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k56",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "The site does not store what you type. Please keep the message short: your name, how to reach you, the kind of visit and the days that suit you. Leave out symptoms, diagnoses and test results.",
         "_key": "k56s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k57",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "If you would rather not use email, call the front desk on the number shown on the contact page.",
         "_key": "k57s"
        }
       ],
       "markDefs": []
      }
     ]
    }
   }
  ],
  "services": [
   {
    "id": "primary-care",
    "slug": "primary-care",
    "status": "published",
    "data": {
     "tile_text": "Everyday care for\na healthier tomorrow.",
     "title": "Primary Care",
     "summary": "Everyday care for a healthier tomorrow.",
     "best_for": "Adults and teens, from check-ups to ongoing concerns",
     "icon": "stethoscope",
     "tint": "mint",
     "position": 10,
     "photo": "/images/care-primary.webp",
     "visit": "Check in at the front desk and wait in the lounge for a few minutes\nTalk with your clinician about your health and anything on your mind\nA physical exam, when your clinician thinks it is needed\nA written plan for tests, prescriptions or follow-up visits",
     "how_to_book": "Send a request from the contact page or call the front desk. Tell us if you are new to the clinic so we can allow extra time.",
     "content": [
      {
       "_type": "block",
       "_key": "k1",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Primary care is the first place to go with a health question. Our clinicians see adults and teens for routine check-ups, short-term illness, injuries that do not need an emergency room, and questions about long-term health.",
         "_key": "k1s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k2",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "What we can help with",
         "_key": "k2s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k3",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Yearly check-ups and health reviews",
         "_key": "k3s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k4",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Colds, infections, rashes and minor injuries",
         "_key": "k4s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k5",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Prescriptions and refills",
         "_key": "k5s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k6",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Referrals to specialists when you need one",
         "_key": "k6s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k7",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Advice on sleep, activity, food and stress",
         "_key": "k7s"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k8",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "What to expect",
         "_key": "k8s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k9",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Most visits take 20 to 30 minutes. A first visit is longer, usually 40 minutes, because we go through your history and your current medicines. Please bring a list of anything you take, including vitamins.",
         "_key": "k9s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k10",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "If your concern could be an emergency, do not wait for an appointment. Call your local emergency number.",
         "_key": "k10s"
        }
       ],
       "markDefs": []
      }
     ],
     "featured": true
    }
   },
   {
    "id": "pediatric-care",
    "slug": "pediatric-care",
    "status": "published",
    "data": {
     "tile_text": "Growing up with\nexpert support.",
     "title": "Pediatric Care",
     "summary": "Growing up with expert support.",
     "best_for": "Babies, children and teens",
     "icon": "baby",
     "tint": "blue",
     "position": 20,
     "photo": "/images/care-pediatric.webp",
     "visit": "A weigh-in and measurements with the nurse\nA check on growth, sleep, eating and development\nTime for the parent or carer to ask questions\nAn up-to-date record of vaccines and what is due next",
     "how_to_book": "Request a visit for your child on the contact page, or call the front desk. For babies under three months, please call so we can find the right slot.",
     "content": [
      {
       "_type": "block",
       "_key": "k11",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Our pediatric visits are paced for children. Rooms are bright, the nurse explains each step before it happens, and parents and carers are in the room throughout.",
         "_key": "k11s"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k12",
       "style": "h2",
       "children": [
        {
         "_type": "span",
