---
import Arrow from "./Arrow.astro";
import { telHref } from "../lib/planner";
import type { StudioData } from "../lib/planner";

interface Props {
	studio: StudioData;
}
const { studio } = Astro.props;
---

<section class="inquiry-band" aria-labelledby="inquiry-band-title">
	<img class="inquiry-band-photo" src="/images/sunset-ceremony.webp" alt="" width="1448" height="1086" loading="lazy" />
	<div class="inquiry-band-inner">
		<p class="eyebrow eyebrow-light"><span class="eyebrow-line">Now planning weddings<span class="eyebrow-rule" aria-hidden="true"></span></span></p>
		<h2 id="inquiry-band-title" class="display display-light">Tell us about your day.</h2>
		<p class="inquiry-band-copy">Share your date, place and the feeling you are after, and we will reply personally, usually within two working days.</p>
		<div class="inquiry-band-actions">
			<a class="btn btn-light" href="/contact"><span>Plan your day</span><Arrow /></a>
			<p class="inquiry-band-contact">
				{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}
				{studio.phone && <a href={telHref(studio.phone)}>{studio.phone}</a>}
			</p>
		</div>
	</div>
</section>
