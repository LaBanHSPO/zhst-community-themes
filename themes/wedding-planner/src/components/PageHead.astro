---
interface Props {
	id?: string;
	eyebrow?: string | null;
	title: string;
	intro?: string | null;
	edit?: Record<string, unknown>;
}
const { id, eyebrow, title, intro, edit = {} } = Astro.props;
---

<header class="page-head">
	<div class="wrap">
		{eyebrow && <p class="eyebrow"><span class="eyebrow-line">{eyebrow}<span class="eyebrow-rule" aria-hidden="true"></span></span></p>}
		<h1 id={id} class="display" {...edit}>{title}</h1>
		{intro && <p class="lede">{intro}</p>}
	</div>
</header>
