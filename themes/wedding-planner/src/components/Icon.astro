---
/** Thin line icons for the approach points (sprig, flower, heart). Drawn as inline SVG, 1.2px strokes. */
interface Props {
	name?: string | null;
	class?: string;
}
const { name, class: className } = Astro.props;
---

{
	name === "flower" ? (
		<svg class:list={["icon", className]} width="30" height="30" viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
			<g>
				<ellipse cx="15" cy="7.600" rx="3.100" ry="4.600" transform="rotate(0 15 15)" />
				<ellipse cx="15" cy="7.600" rx="3.100" ry="4.600" transform="rotate(45 15 15)" />
				<ellipse cx="15" cy="7.600" rx="3.100" ry="4.600" transform="rotate(90 15 15)" />
				<ellipse cx="15" cy="7.600" rx="3.100" ry="4.600" transform="rotate(135 15 15)" />
				<ellipse cx="15" cy="7.600" rx="3.100" ry="4.600" transform="rotate(180 15 15)" />
				<ellipse cx="15" cy="7.600" rx="3.100" ry="4.600" transform="rotate(225 15 15)" />
				<ellipse cx="15" cy="7.600" rx="3.100" ry="4.600" transform="rotate(270 15 15)" />
				<ellipse cx="15" cy="7.600" rx="3.100" ry="4.600" transform="rotate(315 15 15)" />
			</g>
			<circle cx="15" cy="15" r="3.200" />
			<circle cx="15" cy="15" r="1.100" />
		</svg>
	) : name === "heart" ? (
		<svg class:list={["icon", className]} width="30" height="30" viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
			<path d="M15 25.2C9.600 20.900 4.200 16.800 4.200 11.200c0-3.100 2.400-5.400 5.200-5.400 2.200 0 4.200 1.300 5.600 3.400 1.400-2.100 3.400-3.400 5.600-3.400 2.800 0 5.200 2.300 5.200 5.400 0 5.600-5.400 9.700-10.800 14z" />
		</svg>
	) : (
		<svg class:list={["icon", className]} width="30" height="30" viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
			<path d="M4 26Q9 14 24 7" />
			<path d="M7.9 19.2Q10.2 15.3 7.3 11.8Q5.0 15.7 7.9 19.2z" />
			<path d="M7.9 19.2Q12.1 21.1 15.3 17.9Q11.1 16.0 7.9 19.2z" />
			<path d="M12.5 14.3Q15.5 10.9 13.4 6.9Q10.4 10.3 12.5 14.3z" />
			<path d="M12.5 14.3Q16.2 17.0 20.0 14.4Q16.3 11.8 12.5 14.3z" />
			<path d="M18.4 10.0Q21.8 7.6 20.2 3.8Q16.8 6.1 18.4 10.0z" />
			<path d="M23.0 7.3Q26.8 8.4 28.4 4.8Q24.6 3.7 23.0 7.3z" />
		</svg>
	)
}
