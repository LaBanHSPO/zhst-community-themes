---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<div class="notfound-copy">
			<p class="eyebrow"><span class="eyebrow-line">Error 404<span class="eyebrow-rule" aria-hidden="true"></span></span></p>
			<h1 id="nf-title" class="display display-xl">This page has wandered off.</h1>
			<p class="lede">The page you are looking for has moved or never existed. These are good places to start again.</p>
			<div class="actions">
				<a class="btn" href="/"><span>Back to home</span><Arrow /></a>
				<a class="pill pill-outline" href="/work">Our work</a>
				<a class="pill pill-outline" href="/contact">Plan your day</a>
			</div>
		</div>
		<img class="notfound-photo" src="/images/arch-lakeside.webp" alt="" width="588" height="680" />
	</section>
</Base>
