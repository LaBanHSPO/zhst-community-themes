---
import { getEmDashCollection, getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "@fontsource-variable/inter";
import "@fontsource-variable/inter-tight";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/zeyada";
import Logo from "../components/Logo.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getProfile, telHref } from "../lib/site";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Force which primary-menu URL is marked current. */
	current?: string;
	/** Lay the header over the top of the page (the home hero photo runs underneath it). */
	overlay?: boolean;
}

const { title, pageTitle, description, image, canonical, content, current, overlay = false } = Astro.props;
const [settingsResult, menuResult, profileResult, pagesResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getProfile(),
	getEmDashCollection("pages", { limit: 20 }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(profileResult.cacheHint);
	Astro.cache.set(pagesResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName = title === siteTitle || title.endsWith(` | ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} | ${siteTitle}`;
const pageDescription = description ?? `${siteTitle}: ${siteTagline}`;
const navItems = menuResult.data?.items ?? [];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const norm = (url: string) => url.replace(/\/$/, "") || "/";
const { profile } = profileResult;
// CMS pages that are not in the primary menu are linked from the footer.
const menuUrls = new Set(navItems.map((i) => norm(i.url)));
const extraPages = pagesResult.entries
	.map((p) => ({ url: `/${p.data.slug ?? p.data.id}`, label: p.data.eyebrow || p.data.title }))
	.filter((p) => !menuUrls.has(p.url) && p.url !== "/about");

const currentUrl =
	current ??
	navItems.find((i) => norm(i.url) === path)?.url ??
	navItems.find((i) => norm(i.url) !== "/" && path.startsWith(`${norm(i.url)}/`))?.url;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Intl.DateTimeFormat("en-GB", { year: "numeric", timeZone: "Asia/Saigon" }).format(new Date());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="dark" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class:list={["site-head", { "is-overlay": overlay }]}>
			<div class="head-inner">
				<Logo title={siteTitle} logo={siteLogo} class="head-logo" />
				<nav class="nav" aria-label="Primary">
					{
						navItems.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={item.url === currentUrl ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<a class="head-cta" href="/contact">Let's build</a>
				<details class="mobile-nav">
					<summary aria-label="Menu">
						<svg class="burger" width="22" height="14" viewBox="0 0 22 14" aria-hidden="true" focusable="false">
							<path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.5" />
						</svg>
						<svg class="close" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
							<path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.5" />
						</svg>
					</summary>
					<nav class="mobile-panel" aria-label="Primary (mobile)">
						{
							navItems.map((item) => (
								<a href={item.url} aria-current={item.url === currentUrl ? "page" : undefined}>
									{item.label}
								</a>
							))
						}
						<a class="mobile-cta" href="/contact">Let's build</a>
						{profile.email && <a class="mobile-mail" href={`mailto:${profile.email}`}>{profile.email}</a>}
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="foot-inner">
				<div class="foot-brand">
					<Logo title={siteTitle} logo={siteLogo} />
					<p>Full-stack web development for small teams and one-person businesses. Based in Port Alder, working remotely.</p>
				</div>
				<div>
					<h2>Explore</h2>
					<ul class="foot-links">
						{navItems.map((item) => <li><a href={item.url}>{item.label}</a></li>)}
						<li><a href="/writing">Writing</a></li>
						{extraPages.map((p) => <li><a href={p.url}>{p.label}</a></li>)}
					</ul>
				</div>
				<div class="foot-contact">
					<h2>Contact</h2>
					{profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
					{profile.phone && <a href={telHref(profile.phone)}>{profile.phone}</a>}
					{profile.base && <span>{profile.base}</span>}
				</div>
			</div>
			<div class="foot-bottom">
				<span>© {year} {siteTitle}</span>
				<span>Built with EmDash</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
