---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostRow from "../components/PostRow.astro";
import ContactBand from "../components/ContactBand.astro";
import { getPosts, getProfile, getProjects, getSkills, getSteps, lines, photoAlt } from "../lib/site";

const [projectsResult, postsResult, skillsResult, stepsResult, profileResult] = await Promise.all([
	getProjects(),
	getPosts(),
	getSkills(),
	getSteps(),
	getProfile(),
]);
for (const r of [projectsResult, postsResult, skillsResult, stepsResult, profileResult]) {
	if (Astro.cache?.enabled) Astro.cache.set(r.cacheHint);
}
const featured = projectsResult.entries.filter((p) => p.data.featured).slice(0, 3);
const projects = featured.length > 0 ? featured : projectsResult.entries.slice(0, 3);
const posts = postsResult.entries.slice(0, 3);
const skills = skillsResult.entries;
const steps = stepsResult.entries;

const points = [
	{ icon: "bolt", title: "Clean code", sub: "Maintainable" },
	{ icon: "layers", title: "Modern tech", sub: "Future-ready" },
	{ icon: "person", title: "Real impact", sub: "Ideas to reality" },
];
---

<Base
	title="Devfolio, full-stack developer"
	description="Devfolio is the portfolio of Theo Marsh, a full-stack developer who turns ideas into fast, accessible and beautiful web experiences. See selected projects and get in touch."
	overlay
>
	<section class="hero" aria-labelledby="hero-title">
		<img class="hero-bg" src="/images/hero-home.webp" alt={photoAlt(null, "/images/hero-home.webp")} width="1448" height="740" fetchpriority="high" />
		<div class="hero-inner">
			<p class="eyebrow hero-eyebrow">Frontend <span aria-hidden="true">&bull;</span> Backend <span aria-hidden="true">&bull;</span> Creative solutions</p>
			<h1 id="hero-title" class="display hero-title">Ideas built<br />for the <span class="grad">web.</span></h1>
			<p class="hero-sub">I'm a full-stack developer who turns ideas into fast, <br />accessible and beautiful web experiences.</p>
			<div class="hero-actions">
				<a class="btn btn-primary btn-lg" href="/projects"><span>See projects</span><Arrow /></a>
				<a class="text-link" href="/projects"><span>Explore my work</span></a>
			</div>
			<ul class="hero-points">
				{
					points.map((p) => (
						<li>
							<Icon name={p.icon} size={26} />
							<span><strong>{p.title}</strong><span>{p.sub}</span></span>
						</li>
					))
				}
			</ul>
		</div>
		<div class="hero-note" aria-hidden="true">
			<p>Build<br />Create<br />Improve<br />Repeat</p>
			<svg viewBox="0 0 70 30" width="70" height="30" focusable="false"><path d="M2 28 C 25 22, 48 12, 68 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
		</div>
	</section>

	{
		skills.length > 0 && (
			<section class="skills" aria-labelledby="skills-title">
				<div class="wrap skills-grid">
					<div class="skills-head">
						<p class="eyebrow">Skills</p>
						<h2 id="skills-title" class="display display-lg">Tools for<br />bold ideas.</h2>
					</div>
					<ul class="skill-list">
						{skills.map((s) => (
							<li>
								<span class="skill-tile"><Icon name={s.data.icon ?? "html"} size={36} /></span>
								<h3>{s.data.title}</h3>
								<p>{lines(s.data.text).map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<section class="section selected" aria-labelledby="selected-title">
		<div class="wrap">
			<div class="section-head">
				<div>
					<p class="eyebrow">Selected projects</p>
					<h2 id="selected-title" class="display display-lg">Recent <span class="grad">builds.</span></h2>
				</div>
				<a class="text-link" href="/projects"><span>All projects</span><Arrow /></a>
			</div>
			<ul class="project-grid">
				{projects.map((p, i) => <li><ProjectCard project={p} eager={i < 3} /></li>)}
			</ul>
		</div>
	</section>

	{
		steps.length > 0 && (
			<section class="section how" aria-labelledby="how-title">
				<div class="wrap how-grid">
					<div class="how-head">
						<p class="eyebrow">How I work</p>
						<h2 id="how-title" class="display display-lg">A short loop,<br />start to ship.</h2>
						<p class="how-note">Projects run in small steps, so you can see a working version early and change course while it is cheap.</p>
					</div>
					<ol class="steps">
						{steps.map((s, i) => (
							<li>
								<span class="step-num">{String(i + 1).padStart(2, "0")}</span>
								<div>
									<h3>{s.data.title}</h3>
									{s.data.when_label && <p class="step-when">{s.data.when_label}</p>}
									<p>{s.data.text}</p>
									{s.data.output && <p class="step-out"><span>You get</span> {s.data.output}</p>}
								</div>
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	{
		posts.length > 0 && (
			<section class="section writing" aria-labelledby="writing-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">Writing</p>
							<h2 id="writing-title" class="display display-lg">Notes from the keyboard.</h2>
						</div>
						<a class="text-link" href="/writing"><span>All posts</span><Arrow /></a>
					</div>
					<ul class="post-list">
						{posts.map((p) => <li><PostRow post={p} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	<ContactBand profile={profileResult.profile} />
</Base>
