---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<img class="notfound-photo" src="/images/desk-brackets.webp" alt="A bronze pair of angle brackets and a slash, standing on a block of dark stone" width="696" height="820" />
		<div class="notfound-copy">
			<p class="eyebrow">Error 404</p>
			<h1 id="nf-title" class="display display-xl">This page <span class="grad">isn't here.</span></h1>
			<p class="lede">The address may have a typo, or the page has moved. Try one of these instead.</p>
			<div class="actions">
				<a class="btn btn-primary" href="/"><span>Back to home</span><Arrow /></a>
				<a class="pill" href="/projects">Projects</a>
				<a class="pill" href="/writing">Writing</a>
			</div>
		</div>
	</section>
</Base>
