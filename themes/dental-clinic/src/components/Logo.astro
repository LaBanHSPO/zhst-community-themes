---
/** Wordmark: outlined tooth mark, "Pearl" in bold navy and "Dental" in a lighter weight, tiny tracked tagline. */
interface Props {
	title: string;
	tagline?: string;
	logo?: { url?: string; alt?: string } | null;
	class?: string;
}
const { title, tagline, logo, class: className } = Astro.props;
// "PearlDental" splits at the second capital: bold first part, light second part.
const m = title.match(/^(.+?)([A-Z][a-z]+)$/);
const [first, second] = m ? [m[1], m[2]] : [title, ""];
---

<a class:list={["wordmark", className]} href="/" aria-label={`${title}, home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt || title} />
		) : (
			<>
				<svg class="wordmark-mark" width="49" height="50" viewBox="7 5 36 38.500" fill="none" aria-hidden="true" focusable="false">
					<defs>
						<linearGradient id="tooth-grad" x1="8" y1="6" x2="40" y2="46" gradientUnits="userSpaceOnUse">
							<stop offset="0" stop-color="#4f93c4" />
							<stop offset="1" stop-color="#8fcbd9" />
						</linearGradient>
					</defs>
					<path
						d="M25 12.500c-3-3.500-8.700-4.400-12.400-1.200-3.700 3.200-3.400 9-1.600 13.500 1.400 3.500 2.300 6.700 2.700 10.800.4 3.900 1.600 7 3.600 7 2.100 0 2.900-3.900 3.700-7.400.5-2.300 1.400-4 3.600-4s3.100 1.700 3.600 4c.8 3.500 1.600 7.400 3.700 7.400 2 0 3.200-3.100 3.600-7 .4-4.100 1.300-7.300 2.700-10.800 1.800-4.500 2.100-10.300-1.600-13.500C33.700 8.100 28 9 25 12.500Z"
						stroke="url(#tooth-grad)"
						stroke-width="3.400"
						stroke-linejoin="round"
					/>
				</svg>
				<span class="wordmark-text">
					<span class="wordmark-title"><b>{first}</b>{second}</span>
					{tagline && <span class="wordmark-tagline">{tagline}</span>}
				</span>
			</>
		)
	}
</a>
