---
/** Thin line icons, drawn on a 40 px grid and sized by the parent. */
interface Props {
	name?: string | null;
	size?: number;
}
const { name, size = 40 } = Astro.props;
const attrs = {
	width: size,
	height: size,
	viewBox: "0 0 40 40",
	fill: "none",
	stroke: "currentColor",
	"stroke-width": "1.4",
	"stroke-linecap": "round",
	"stroke-linejoin": "round",
	"aria-hidden": "true",
	focusable: "false",
} as const;
const TOOTH = "M20 10.5c-2.2-2.600-6.500-3.400-9.200-1-2.800 2.500-2.600 7-1.200 10.400 1.100 2.700 1.800 5.200 2.100 8.400.3 3 1.200 5.400 2.700 5.400 1.600 0 2.200-3 2.800-5.700.4-1.800 1.100-3.100 2.800-3.100s2.400 1.300 2.800 3.100c.6 2.700 1.200 5.700 2.800 5.700 1.500 0 2.400-2.400 2.700-5.400.3-3.200 1-5.700 2.100-8.400 1.400-3.400 1.600-7.900-1.200-10.400-2.700-2.400-7-1.600-9.200 1Z";
---

{
	name === "leaf" ? (
		<svg {...attrs}>
			<path d="M9 33C5 22 11 9 32 6c1.800 18-8 28-23 27Z" />
			<path d="M8.500 35.500C15 27 21 20 29 14" />
		</svg>
	) : name === "people" ? (
		<svg {...attrs}>
			<circle cx="15" cy="14" r="5.500" />
			<path d="M5 33c0-6 4.500-10 10-10s10 4 10 10" />
			<circle cx="29" cy="11" r="3.500" />
			<path d="M28 20.500c4.500-.5 8 2.500 8 8" />
		</svg>
	) : name === "smile" ? (
		<svg {...attrs}>
			<path d="M8 16c3 7 8.500 11 12 11s9-4 12-11" stroke-width="2.200" />
		</svg>
	) : name === "sparkle" ? (
		<svg {...attrs}>
			<path d="M17 6c1 7 4 10 11 11-7 1-10 4-11 11-1-7-4-10-11-11 7-1 10-4 11-11Z" />
			<path d="M31 25c.5 3.500 2 5 5.500 5.500-3.500.5-5 2-5.500 5.500-.5-3.500-2-5-5.500-5.500 3.500-.5 5-2 5.500-5.500Z" />
		</svg>
	) : name === "bolt" ? (
		<svg {...attrs}>
			<path d="M22.500 5 10 23h9l-2 12 13-19h-9.500L22.500 5Z" />
		</svg>
	) : name === "drop" ? (
		<svg {...attrs}>
			<path d="M20 6c-6 8-10 12.500-10 18a10 10 0 0 0 20 0c0-5.500-4-10-10-18Z" />
			<path d="M15.500 24.500a4.500 4.500 0 0 0 4 4.500" />
		</svg>
	) : name === "filling" ? (
		<svg {...attrs}>
			<path d={TOOTH} />
			<circle cx="20" cy="17" r="2.300" />
		</svg>
	) : name === "clock" ? (
		<svg {...attrs}>
			<circle cx="20" cy="20" r="13" />
			<path d="M20 12v8.500l5.500 3" />
		</svg>
	) : name === "pin" ? (
		<svg {...attrs}>
			<path d="M20 35c-6-7-10-12-10-17a10 10 0 0 1 20 0c0 5-4 10-10 17Z" />
			<circle cx="20" cy="18" r="3.500" />
		</svg>
	) : (
		<svg {...attrs}>
			<path d={TOOTH} />
		</svg>
	)
}
