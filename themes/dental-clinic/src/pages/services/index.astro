---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import BookBand from "../../components/BookBand.astro";
import { entryHref, getClinic, getServices, photoSrc } from "../../lib/clinic";

const [servicesResult, clinicResult] = await Promise.all([getServices(), getClinic()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(servicesResult.cacheHint);
	Astro.cache.set(clinicResult.cacheHint);
}
const services = servicesResult.entries;
---

<Base title="Services" description="Dental services at PearlDental: check-ups and cleaning, fillings, whitening, children's dentistry, hygiene and emergency appointments, with appointment length and starting prices.">
	<header class="page-head">
		<div class="wrap">
			<p class="eyebrow">Services</p>
			<h1 class="display display-xl">Care for the whole family.</h1>
			<span class="rule" aria-hidden="true"></span>
			<p class="lede">Each service below says what happens at the visit, how long it takes and what to do afterwards. Prices are starting points. You get a written estimate before any treatment.</p>
		</div>
	</header>

	<section class="page-body" aria-label="All services">
		<div class="wrap">
			{
				services.length === 0 ? (
					<p class="empty">Services will appear here once they are added in the admin.</p>
				) : (
					<ul class="service-rows">
						{services.map((s) => {
							const src = photoSrc(s.data.image, s.data.photo);
							const href = entryHref("/services", s.data);
							return (
								<li class="service-row" id={s.data.slug ?? s.data.id}>
									{src && <img src={src} alt="" width="640" height="480" loading="lazy" />}
									<div>
										<p class="eyebrow">{s.data.duration}</p>
										<h2 {...s.edit.title}><a href={href}>{s.data.title}</a></h2>
										<p class="lede">{s.data.summary}</p>
										<dl class="facts">
											{s.data.duration && <div><dt>Appointment</dt><dd>{s.data.duration}</dd></div>}
											{s.data.price_label && <div><dt>Price</dt><dd>{s.data.price_label}</dd></div>}
										</dl>
										<p class="row-actions">
											<a class="btn" href={`/contact?service=${encodeURIComponent(s.data.slug ?? s.data.id)}`}>Request this visit <Arrow /></a>
											<a class="text-link" href={href}>What to expect <Arrow /></a>
										</p>
									</div>
								</li>
							);
						})}
					</ul>
				)
			}
		</div>
	</section>

	<BookBand clinic={clinicResult.clinic} />
</Base>
