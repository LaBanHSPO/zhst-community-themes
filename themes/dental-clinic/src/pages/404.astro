---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound">
		<div class="wrap">
			<p class="eyebrow">Error 404</p>
			<h1 class="display">We could not find that page.</h1>
			<span class="rule" aria-hidden="true"></span>
			<p class="lede">The link may be old or mistyped. These pages should help.</p>
			<div class="actions">
				<a class="btn" href="/">Back to home <Arrow /></a>
				<a class="btn btn-outline" href="/services">Services</a>
				<a class="btn btn-outline" href="/contact">Contact</a>
			</div>
		</div>
	</section>
</Base>
