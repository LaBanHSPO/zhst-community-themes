  "content": {
    "pages": [
      {
        "id": "new-patients",
        "slug": "new-patients",
        "status": "published",
        "data": {
          "title": "New patients",
          "eyebrow": "New patients",
          "intro": "Everything you need to know before your first appointment at PearlDental.",
          "content": [
            {
              "_type": "block",
              "_key": "b0",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Before you come",
                  "_key": "b0s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b1",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Book a check-up through the contact page or by phone. Tell us if you would like a longer first appointment or have any worries about visiting the dentist.",
                  "_key": "b1s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b2",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Bring a list of any medicines you take and the name of your previous dentist if you have one. If you have recent X-rays, bring them or ask your old clinic to send them.",
                  "_key": "b2s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b3",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "On the day",
                  "_key": "b3s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b4",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Arrive about ten minutes early to fill in a short health form. Your first visit takes around 45 minutes. We look at your teeth and gums, clean them and talk through a plan.",
                  "_key": "b4s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b5",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Costs",
                  "_key": "b5s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b6",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Prices on this site are starting points. We give you a written estimate before any treatment, and we never start work without your agreement.",
                  "_key": "b6s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b7",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Moving or cancelling",
                  "_key": "b7s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b8",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Please give us 24 hours' notice if you need to change an appointment, so we can offer the time to someone else.",
                  "_key": "b8s"
                }
              ],
              "markDefs": []
            }
          ]
        }
      },
      {
        "id": "privacy",
        "slug": "privacy",
        "status": "published",
        "data": {
          "title": "Privacy",
          "eyebrow": "Privacy",
          "intro": "How this website handles your details.",
          "content": [
            {
              "_type": "block",
              "_key": "b0",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "The appointment request form on this site opens your own email app with a message ready to send. The website does not send or store what you type.",
                  "_key": "b0s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b1",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Please do not put medical details in a request. Tell the dentist in person, where the information goes into your patient record.",
                  "_key": "b1s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b2",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "This sample site does not use analytics or advertising cookies.",
                  "_key": "b2s"
                }
              ],
              "markDefs": []
            }
          ]
        }
      }
    ],
    "services": [
      {
        "id": "check-ups-and-cleaning",
        "slug": "check-ups-and-cleaning",
        "status": "published",
        "data": {
          "title": "Check-ups and cleaning",
          "summary": "A look at your teeth and gums, then a clean, with time to ask questions.",
          "icon": "tooth",
          "featured": true,
          "position": 10,
          "duration": "45 minutes",
          "price_label": "From $95",
          "intro": "A regular check-up is the visit most people need most often. We look at your teeth, gums and mouth, clean away plaque and tartar, and talk through anything you have noticed.",
          "what_happens": "We ask about your health, any changes since last time and anything that worries you.\nThe dentist checks your teeth, gums, tongue and bite. X-rays are taken only when they are needed.\nA hygienist or dentist cleans your teeth and polishes them.\nWe agree when you should come back, usually in six to twelve months.",
          "aftercare": "Teeth can feel sensitive for a day after a deep clean. Use a soft brush and lukewarm water.\nBrush twice a day and clean between your teeth once a day.\nCall us if you notice bleeding gums that do not settle within a week.",
          "content": [
            {
              "_type": "block",
              "_key": "b0",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Bring a list of any medicines you take. If you wear a night guard or retainer, bring that too.",
                  "_key": "b0s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b1",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "How often should I come?",
                  "_key": "b1s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b2",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Most adults come every six to twelve months. Some people need to come more often, for example if they have gum disease. The dentist will tell you what suits you and why.",
                  "_key": "b2s"
                }
              ],
              "markDefs": []
            }
          ],
          "photo": "/images/visit-dentist.webp"
        }
      },
      {
        "id": "fillings",
        "slug": "fillings",
        "status": "published",
        "data": {
          "title": "Fillings",
          "summary": "Repair a cavity or a chipped tooth with a tooth-coloured filling.",
          "icon": "filling",
          "featured": true,
          "position": 20,
          "duration": "45 to 60 minutes",
          "price_label": "From $140",
          "intro": "A filling replaces the part of a tooth lost to decay or damage. We use tooth-coloured material, so the repair blends with the rest of the tooth.",
          "what_happens": "The dentist explains what they found and what the filling involves.\nYour tooth is numbed so you are comfortable during the work.\nDecay is removed and the filling is placed in layers and set with a blue light.\nThe dentist checks your bite and polishes the filling.",
          "aftercare": "Your lip and cheek stay numb for a few hours. Avoid hot drinks and chewing until the feeling returns.\nA little sensitivity to hot and cold is common for a few days.\nCall us if your bite feels high or the tooth still hurts after a week.",
          "content": [
            {
              "_type": "block",
              "_key": "b0",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Tell us if you have ever reacted to a dental material or a local anaesthetic.",
                  "_key": "b0s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b1",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Why not leave a small cavity?",
                  "_key": "b1s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b2",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Decay does not heal by itself. Small cavities are quicker to fix and keep more of the natural tooth.",
                  "_key": "b2s"
                }
              ],
              "markDefs": []
            }
          ],
          "photo": "/images/instruments.webp"
        }
      },
      {
        "id": "teeth-whitening",
        "slug": "teeth-whitening",
        "status": "published",
        "data": {
          "title": "Teeth whitening",
          "summary": "Lift the shade of your teeth with a plan that fits your mouth.",
          "icon": "sparkle",
          "featured": true,
          "position": 30,
          "duration": "60 minutes, plus home trays",
          "price_label": "From $320",
          "intro": "Whitening works on natural teeth and does not change fillings or crowns. We check your teeth and gums first, so we know it is a good fit.",
          "what_happens": "A short check of your teeth and gums, and a chat about the shade you would like.\nWe take moulds for your custom trays, or apply a gel in the chair, depending on your plan.\nYou get clear instructions for using the gel at home and how long to wear the trays.\nWe see you again to check how your teeth and gums are doing.",
          "aftercare": "Some people feel brief sensitivity. A toothpaste for sensitive teeth can help.\nDark drinks such as coffee and red wine can dull the shade again, so cut back for the first days.\nHow much the shade changes differs from person to person.",
          "content": [
            {
              "_type": "block",
              "_key": "b0",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "We do not whiten teeth when there is untreated decay or gum disease. Those come first.",
                  "_key": "b0s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b1",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Is whitening for everyone?",
                  "_key": "b1s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b2",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Not always. We do not recommend it during pregnancy, and it will not change the colour of crowns or fillings. The dentist will talk through your options.",
                  "_key": "b2s"
                }
              ],
              "markDefs": []
            }
          ],
          "photo": "/images/tooth-sign.webp"
        }
      },
      {
        "id": "childrens-dentistry",
        "slug": "childrens-dentistry",
        "status": "published",
        "data": {
          "title": "Children's dentistry",
          "summary": "Short, calm visits for children, starting from their first teeth.",
          "icon": "smile",
          "featured": false,
          "position": 40,
          "duration": "30 minutes",
          "price_label": "From $70",
          "intro": "We keep children's visits short and explain each step in plain words. Parents are welcome in the room the whole time.",
          "what_happens": "We say hello in the waiting room and show your child the chair and the light.\nThe dentist counts and checks their teeth and talks about brushing.\nA gentle clean and, if suitable, a fluoride varnish.\nYour child picks a sticker and we book the next visit.",
          "aftercare": "Help young children brush until they can tie their own shoelaces.\nUse a smear of toothpaste under three years old, and a pea-sized amount after that.\nCall us if your child has a knock to a tooth, even if it looks fine.",
          "content": [
            {
              "_type": "block",
              "_key": "b0",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Bring a favourite toy if it helps. Let us know if your child has had a hard time at a dentist before.",
                  "_key": "b0s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b1",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "When should a child first visit?",
                  "_key": "b1s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b2",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Around their first birthday, or when the first tooth appears. Early visits are mostly about getting used to the room.",
                  "_key": "b2s"
                }
              ],
              "markDefs": []
            }
          ],
          "photo": "/images/patient-smile.webp"
        }
      },
      {
        "id": "emergency-appointments",
        "slug": "emergency-appointments",
        "status": "published",
        "data": {
          "title": "Emergency appointments",
          "summary": "Same-day slots for toothache, a broken tooth or a lost filling.",
          "icon": "bolt",
          "featured": false,
          "position": 50,
          "duration": "30 minutes",
          "price_label": "Ask at reception",
          "intro": "We keep a few slots free each day for urgent problems. Call as early as you can and tell the receptionist what has happened.",
          "what_happens": "Call the clinic. We ask a few questions to see how quickly you need to be seen.\nThe dentist looks at the problem and may take an X-ray.\nWe ease the pain and fix the problem where we can, or make a plan for the next visit.\nWe tell you what to do at home until your next appointment.",
          "aftercare": "Rinse gently with warm salt water. Take pain relief as directed on the packet.\nKeep a knocked-out adult tooth in milk, not water, and call us straight away.\nIf you have swelling that makes breathing or swallowing hard, call emergency services.",
          "content": [
            {
              "_type": "block",
              "_key": "b0",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Emergency slots are for urgent problems. For anything that can wait a few days, a regular appointment is better.",
                  "_key": "b0s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b1",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "What counts as an emergency?",
                  "_key": "b1s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "b2",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Severe pain, a broken or knocked-out tooth, swelling in your face or gum, or bleeding that will not stop. If you are not sure, call and ask.",
                  "_key": "b2s"
                }
              ],
              "markDefs": []
            }
          ],
          "photo": "/images/lamp.webp"
        }
      },
      {
        "id": "dental-hygiene",
        "slug": "dental-hygiene",
        "status": "published",
        "data": {
          "title": "Dental hygiene",
          "summary": "A longer clean with advice on brushing and cleaning between teeth.",
          "icon": "drop",
          "featured": false,
          "position": 60,
          "duration": "40 minutes",
          "price_label": "From $110",
          "intro": "A hygiene visit is a thorough clean of the surfaces a toothbrush cannot reach, plus practical advice you can use at home.",
          "what_happens": "The hygienist checks your gums and measures any gaps around the teeth.\nPlaque and tartar are removed above and below the gum line.\nYour teeth are polished and we show you where you are missing spots.\nWe suggest a brush, floss or interdental brushes that suit your mouth.",
          "aftercare": "Your gums may feel tender and bleed a little for a day or two.\nClean between your teeth once a day. It matters as much as brushing.\nBook your next visit before you leave so it does not slip.",
          "content": [
            {
              "_type": "block",
              "_key": "b0",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "You can book a hygiene visit on its own, without seeing the dentist the same day.",
                  "_key": "b0s"
