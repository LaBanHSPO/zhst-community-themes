---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import TalkBand from "../components/TalkBand.astro";
import WorkCard from "../components/WorkCard.astro";
import { getPosts, getProjects, getServices, getSteps, getStudio, lines, photoAlt, photoSrc, postHref } from "../lib/site";

const [projectsResult, servicesResult, stepsResult, postsResult, studioResult] = await Promise.all([
	getProjects(),
	getServices(),
	getSteps(),
	getPosts(),
	getStudio(),
]);
if (Astro.cache?.enabled) {
	for (const r of [projectsResult, servicesResult, stepsResult, postsResult, studioResult]) Astro.cache.set(r.cacheHint);
}
const allProjects = projectsResult.entries;
const featured = allProjects.filter((p) => p.data.featured);
const selected = (featured.length > 0 ? featured : allProjects).slice(0, 3);
const services = servicesResult.entries;
const steps = stepsResult.entries;
const posts = postsResult.entries.slice(0, 3);
---

<Base
	title="A fresh perspective, made tangible"
	description="NOVA is the studio of Nova Hartley, a creative director and visual storyteller. Brand identity, campaigns and photography for small studios and makers. See selected work and say hello."
>
	<section class="hero" aria-labelledby="hero-title">
		<img
			class="hero-photo"
			src="/images/hero-home.webp"
			alt="Nova, a creative director in a black knit sweater, resting her cheek on one hand against a pale sunlit wall"
			width="1448"
			height="696"
			fetchpriority="high"
		/>
		<div class="hero-copy">
			<p class="hero-eyebrow">Creative director &amp; visual storyteller</p>
			<h1 id="hero-title" class="hero-title">A fresh<br />perspective,<br />made tangible.</h1>
			<p class="hero-sub">I help brands, people and ideas find their <br />truest expression through thoughtful design, <br />visual storytelling and creative direction.</p>
			<a class="pill pill-lg" href="/work"><span>Explore my work</span><Arrow /></a>
			<p class="hero-tags"><span>Design</span><span>Photography</span><span>Creative direction</span></p>
		</div>
		<p class="hand" aria-hidden="true"><span>Better</span><span>Ideas</span><span>Brighter</span><span>Days</span></p>
		<i class="hand-stroke" aria-hidden="true"></i>
		<p class="hero-caption" aria-hidden="true"><span>People</span><span>Ideas</span><span>A brighter</span><span>Tomorrow</span><i></i></p>
	</section>

	<section class="selected" aria-labelledby="selected-title">
		<div class="selected-inner">
			<div class="selected-head">
				<h2 id="selected-title" class="eyebrow eyebrow-strong">Selected work</h2>
				<a class="text-link" href="/work"><span>View all work</span><Arrow /></a>
			</div>
			<ul class="selected-grid">
				{selected.map((p, i) => <li><WorkCard project={p} eager={i < 3} /></li>)}
			</ul>
		</div>
	</section>

	{
		services.length > 0 && (
			<section class="services" aria-labelledby="services-title">
				<div class="wrap services-inner">
					<div class="services-intro">
						<p class="eyebrow">What I do</p>
						<h2 id="services-title" class="display">Four kinds of work, one person to talk to.</h2>
						<p class="services-note">Most projects mix two or more. I scope each one separately and put the price in writing before anything starts.</p>
					</div>
					<ol class="service-list">
						{services.map((s, i) => (
							<li class="service">
								<span class="service-no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
								<div class="service-body">
									<h3 class="service-title" {...s.edit.title}>{s.data.title}</h3>
									<p class="service-summary">{s.data.summary}</p>
									<ul class="service-includes">
										{lines(s.data.includes).map((item) => <li>{item}</li>)}
									</ul>
									<p class="service-foot">
										{s.data.timeline && <span class="service-timeline">{s.data.timeline}</span>}
										<a class="text-link" href={`/work?discipline=${s.data.discipline}`}><span>See related work</span><Arrow /></a>
									</p>
								</div>
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	{
		steps.length > 0 && (
			<section class="process" aria-labelledby="process-title">
				<div class="wrap">
					<div class="process-head">
						<p class="eyebrow">How a project runs</p>
						<h2 id="process-title" class="display">Four steps, all written down.</h2>
					</div>
					<ol class="process-steps">
						{steps.map((s, i) => (
							<li class="process-step">
								<span class="process-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
								<h3 class="process-title" {...s.edit.title}>{s.data.title}</h3>
								<p class="process-text">{s.data.text}</p>
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	{
		posts.length > 0 && (
			<section class="journal-teaser" aria-labelledby="journal-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">Journal</p>
							<h2 id="journal-title" class="display">Notes from the studio.</h2>
						</div>
						<a class="text-link" href="/journal"><span>All notes</span><Arrow /></a>
					</div>
					<ul class="post-cards">
						{posts.map((p) => {
							const src = photoSrc(p.data.image, p.data.photo);
							return (
								<li>
									<a class="post-card" href={postHref(p.data)}>
										{src && <img src={src} alt={photoAlt(p.data.image, p.data.photo, p.data.title)} width="600" height="420" loading="lazy" />}
										<span class="post-card-topic">{[p.data.topic, p.data.date_label].filter(Boolean).join(" · ")}</span>
										<span class="post-card-title">{p.data.title}</span>
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	<TalkBand studio={studioResult.studio} />
</Base>
