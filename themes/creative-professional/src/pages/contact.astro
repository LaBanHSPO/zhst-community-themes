---
import Base from "../layouts/Base.astro";
import { DISCIPLINES, getStudio, telHref } from "../lib/site";

const { studio, cacheHint } = await getStudio();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// ?discipline=<slug> pre-selects the kind of work (links from work pages and the "Let's talk" bands).
const wanted = Astro.url.searchParams.get("discipline");
const selected = DISCIPLINES.find((d) => d.slug === wanted);
---

<Base
	title="Let’s talk"
	description="Send Nova a project enquiry: choose the kind of work, give a rough budget and timeline, and say what you have in mind. Email and phone are always listed."
>
	<div class="contact">
		<section class="contact-panel" aria-labelledby="contact-title">
			<p class="eyebrow">Let’s talk</p>
			<h1 id="contact-title" class="display display-xl">Tell me what you have in mind.</h1>
			<p class="lede">A few lines are enough. I reply myself, usually within two working days, to set up a call or ask a question or two.</p>

			<form
				class="contact-form"
				data-contact-form
				data-email={studio.email}
				action={studio.email ? `mailto:${studio.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field">
						<label for="q-name">Your name</label>
						<input id="q-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="q-name"></span>
					</div>
					<div class="field">
						<label for="q-email">Email</label>
						<input id="q-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="q-email"></span>
					</div>
					<div class="field full">
						<label for="q-discipline">What do you need?</label>
						<select id="q-discipline" name="discipline" required>
							<option value="" selected={!selected}>Choose an option</option>
							{DISCIPLINES.map((d) => <option value={d.label} selected={selected?.slug === d.slug}>{d.label}</option>)}
							<option value="Not sure yet">Not sure yet</option>
						</select>
						<span class="field-error" data-error-for="q-discipline"></span>
					</div>
					<div class="field">
						<label for="q-budget">Budget range <span class="optional">(optional)</span></label>
						<select id="q-budget" name="budget">
							<option value="" selected>Prefer to discuss</option>
							<option>Under $2,000</option>
							<option>$2,000 to $5,000</option>
							<option>$5,000 to $10,000</option>
							<option>$10,000 to $25,000</option>
							<option>Over $25,000</option>
						</select>
					</div>
					<div class="field">
						<label for="q-timeline">When do you need it?</label>
						<select id="q-timeline" name="timeline" required>
							<option value="" selected>Choose an option</option>
							<option>Within a month</option>
							<option>In one to three months</option>
							<option>Later this year</option>
							<option>No fixed date</option>
						</select>
						<span class="field-error" data-error-for="q-timeline"></span>
					</div>
					<div class="field full">
						<label for="q-notes">About the project</label>
						<textarea id="q-notes" name="notes" rows="5" maxlength="800" placeholder="What it is, who it is for, and anything you already have: a name, a deck, a few photos." required></textarea>
						<span class="field-error" data-error-for="q-notes"></span>
					</div>
				</div>
				<button class="pill pill-block" type="submit"><span>Send enquiry</span></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{studio.email && <>Write to <a href={`mailto:${studio.email}`}>{studio.email}</a> with what you need, your budget and your timing.</>}
					</noscript>
				</p>
			</form>
		</section>

		<aside class="contact-aside">
			<img src="/images/portrait-wall.webp" alt="Nova resting her cheek on one hand in front of a wall with pinned black and white photographs" width="1243" height="974" />
			<div class="contact-details">
				<h2>Prefer to write or call?</h2>
				<p>
					{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}
					{studio.phone && <a href={telHref(studio.phone)}>{studio.phone}</a>}
					{studio.base && <span>{studio.base}</span>}
				</p>
				{studio.response && <p class="small">{studio.response}</p>}
				{studio.note && <p class="small">{studio.note}</p>}
			</div>
		</aside>
	</div>
</Base>

<script>
	// Compose an enquiry email; Nova replies to it. Nothing is sent or stored by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input[required], select[required], textarea[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online enquiries are not available right now. Please call instead.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Project enquiry: ${get("discipline")}, from ${get("name")}`;
			const lines = [
				"Hello Nova,",
				"",
				"I would like to talk about a project.",
				"",
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				`What I need: ${get("discipline")}`,
				get("budget") ? `Budget range: ${get("budget")}` : "",
				`Timeline: ${get("timeline")}`,
				"",
				get("notes"),
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this enquiry ready to send. It is only sent when you send that email, and I reply myself. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
