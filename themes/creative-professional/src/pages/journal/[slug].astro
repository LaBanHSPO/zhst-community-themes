---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import TalkBand from "../../components/TalkBand.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getPosts, getStudio, photoAlt, photoSrc, postHref } from "../../lib/site";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.rewrite("/404");

const [allResult, studioResult, settings] = await Promise.all([getPosts(), getStudio(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const d = post.data;
const cover = photoSrc(d.image, d.photo);
const hasBody = Boolean(d.content && d.content.length > 0);
const others = allResult.entries.filter((p) => p.data.id !== d.id).slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary}
	canonical={seo.canonical}
	image={seo.ogImage ?? cover}
	content={{ collection: "posts", id: d.id, slug }}
	current="/journal"
>
	<header class="post-head">
		<div class="wrap">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/journal">Journal</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{d.title}</span>
			</nav>
			<p class="eyebrow">{[d.topic, d.date_label].filter(Boolean).join(" · ")}</p>
			<h1 class="display display-xl" {...post.edit.title}>{d.title}</h1>
			<p class="lede">{d.summary}</p>
		</div>
	</header>

	{
		cover && (
			<div class="wrap">
				<figure class="project-cover post-cover">
					<img src={cover} alt={photoAlt(d.image, d.photo, d.title)} width="1448" height="720" fetchpriority="high" />
				</figure>
			</div>
		)
	}

	{
		hasBody && (
			<section class="project-body">
				<div class="wrap">
					<div class="prose">
						<PortableText value={d.content} />
					</div>
				</div>
			</section>
		)
	}

	{
		others.length > 0 && (
			<section class="section journal-teaser" aria-labelledby="more-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">Keep reading</p>
							<h2 id="more-title" class="display">More notes</h2>
						</div>
						<a class="text-link" href="/journal"><span>All notes</span><Arrow /></a>
					</div>
					<ul class="post-cards">
						{others.map((p) => {
							const src = photoSrc(p.data.image, p.data.photo);
							return (
								<li>
									<a class="post-card" href={postHref(p.data)}>
										{src && <img src={src} alt={photoAlt(p.data.image, p.data.photo, p.data.title)} width="600" height="420" loading="lazy" />}
										<span class="post-card-topic">{[p.data.topic, p.data.date_label].filter(Boolean).join(" · ")}</span>
										<span class="post-card-title">{p.data.title}</span>
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	<TalkBand studio={studioResult.studio} />
</Base>
