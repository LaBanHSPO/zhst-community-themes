---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/theme.css";
import Icon from "../components/Icon.astro";
import { isCurrent, plainText, wordmarkParts } from "../lib/site";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
const settings = settingsResult.data;
const menu = menuResult.data;
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const siteTitle = settings?.title || "Studio";
const separator = settings?.seo?.titleSeparator || " — ";
const fullTitle = !title
	? siteTitle
	: title === siteTitle ||
		  title.endsWith(` — ${siteTitle}`) ||
		  title.endsWith(` | ${siteTitle}`)
		? title
		: `${title}${separator}${siteTitle}`;
const rawTagline = settings?.tagline || "Design & Development";
const siteDescription = plainText(rawTagline);
const [wordmarkLead, wordmarkAccent] = wordmarkParts(siteTitle);
const pathname = Astro.url.pathname;
const menuItems = (menu?.items ?? []).filter((item) => item.label);
const noteWords = siteDescription.split(/\s+/).filter(Boolean);
const siteLogo = settings?.logo?.url ? settings.logo : null;
const canonicalUrl =
	canonical ?? new URL(Astro.url.pathname, Astro.url.origin).href;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteDescription,
	canonical: canonicalUrl,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

const isLoggedIn = Boolean(Astro.locals.user);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-heading" preload />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/rss.xml"
		/>
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var root = document.documentElement;
				root.classList.add("js");
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					root.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="shell">
			<header class="site-header">
				<div class="header-bar">
					<a href="/" class="wordmark" aria-label={`${siteTitle} — home`}>
						{
							siteLogo ? (
								<img
									src={siteLogo.url}
									alt={siteLogo.alt || siteTitle}
									class="site-logo-img"
								/>
							) : (
								<span aria-hidden="true">
									{wordmarkLead}
									<span class="wordmark-accent">{wordmarkAccent}</span>
								</span>
							)
						}
					</a>
					<button
						type="button"
						class="menu-toggle"
						aria-controls="site-nav"
						aria-expanded="false"
						data-menu-toggle
					>
						<span class="menu-icon-open"><Icon name="menu" size={24} /></span>
						<span class="menu-icon-close"><Icon name="close" size={24} /></span>
						<span class="sr-only">Menu</span>
					</button>
				</div>

				<nav id="site-nav" class="site-nav" aria-label="Primary" data-menu>
					<ul>
						{
							menuItems.map((item) => {
								const current = isCurrent(pathname, item.url);
								return (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={
												item.target === "_blank"
													? "noopener noreferrer"
													: undefined
											}
											aria-current={current ? "page" : undefined}
										>
											{item.label}
										</a>
									</li>
								);
							})
						}
						{
							isLoggedIn && (
								<li>
									<a href="/_emdash/admin" class="nav-admin">
										Admin
									</a>
								</li>
							)
						}
					</ul>
					<a href="/contact" class="btn btn-primary nav-cta">
						Get in touch
						<Icon name="arrow-right" size={18} />
					</a>
				</nav>

				{
					noteWords.length > 0 && (
						<p class="side-note caps" aria-hidden="true">
							{noteWords.map((word) => (
								<span>{word}</span>
							))}
							<span class="rule" />
						</p>
					)
				}
			</header>

			<div class="page">
				<div class="page-top">
					<a href="/contact" class="btn btn-primary page-cta">
						Get in touch
						<Icon name="arrow-right" size={18} />
					</a>
				</div>

				<main id="main" tabindex="-1">
					<slot />
				</main>

				<footer class="site-footer">
					<div class="footer-brand">
						<p class="footer-logo">
							{wordmarkLead}<span class="wordmark-accent">{wordmarkAccent}</span>
						</p>
						<p class="footer-tagline">{siteDescription}</p>
					</div>
					<div class="footer-right">
						<div class="theme-switcher" role="group" aria-label="Colour theme">
							<button
								type="button"
								class="theme-btn"
								data-theme="light"
								aria-pressed="false">Light</button
							>
							<button
								type="button"
								class="theme-btn"
								data-theme="dark"
								aria-pressed="false">Dark</button
							>
							<button
								type="button"
								class="theme-btn"
								data-theme="system"
								aria-pressed="false">System</button
							>
						</div>
						<p class="footer-powered">
							Powered by <a href="https://emdashcms.com">EmDash</a>
						</p>
					</div>
				</footer>
			</div>
		</div>
		<EmDashBodyEnd page={pageCtx} />

		<script>
			// Theme switcher
			const THEME_REGEX = /theme=([^;]+)/;
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setTheme(theme: string) {
				if (theme !== "light" && theme !== "dark") theme = "system";
				root.classList.remove("light", "dark");
				if (theme === "system") {
					document.cookie = "theme=; path=/; max-age=0; samesite=lax";
				} else {
					document.cookie = `theme=${theme}; path=/; max-age=31536000; samesite=lax`;
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function getStoredTheme(): string {
				const match = document.cookie.match(THEME_REGEX);
				return match ? match[1] : "system";
			}

			setTheme(getStoredTheme());

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});

			// Mobile menu: a disclosure button. Escape closes it and returns focus.
			const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
			const header = document.querySelector<HTMLElement>(".site-header");
			if (toggle && header) {
				const setOpen = (open: boolean) => {
					toggle.setAttribute("aria-expanded", String(open));
					header.classList.toggle("is-open", open);
				};
				toggle.addEventListener("click", () => {
					setOpen(toggle.getAttribute("aria-expanded") !== "true");
				});
				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape" && header.classList.contains("is-open")) {
						setOpen(false);
						toggle.focus();
					}
				});
				window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
					if (e.matches) setOpen(false);
				});
			}
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					min-height: 100vh;
				}

				a {
					color: currentColor;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4 {
					font-family: var(--font-heading);
					font-weight: var(--font-weight-heading);
					line-height: var(--leading-snug);
					letter-spacing: var(--tracking-tight);
				}

				h1 {
					font-size: var(--font-size-4xl);
				}

				h2 {
					font-size: var(--font-size-2xl);
				}

				h3 {
					font-size: var(--font-size-xl);
				}
			}
		</style>

		<style>
			.skip-link {
				position: absolute;
				top: 0.75rem;
				left: 0.75rem;
				z-index: 50;
				padding: 0.6rem 1rem;
				font-weight: 600;
				color: var(--color-on-brand);
				background: var(--color-brand);
				border-radius: var(--radius-pill);
				transform: translateY(-200%);
			}

			.skip-link:focus {
				transform: none;
			}

			.shell {
				min-height: 100vh;
			}

			/* ---------- Header: top bar below 1024px ---------- */
			.site-header {
				position: sticky;
				top: 0;
				z-index: 20;
				background: color-mix(in srgb, var(--color-bg) 92%, transparent);
				backdrop-filter: blur(10px);
				border-bottom: 1px solid var(--color-border);
			}

			.header-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: var(--spacing-md);
				padding: 0.9rem 1.25rem;
			}

			.wordmark {
				font-size: 1.5rem;
				font-weight: 700;
				letter-spacing: -0.04em;
				line-height: 1;
				color: var(--color-text);
				text-decoration: none;
			}

			.wordmark-accent {
				color: var(--color-brand);
			}

			.site-logo-img {
				height: 40px;
				width: auto;
			}

			.menu-toggle {
				display: inline-grid;
				place-items: center;
				width: 2.75rem;
				height: 2.75rem;
				color: var(--color-text);
				background: transparent;
				border: 0;
				border-radius: var(--radius-pill);
				cursor: pointer;
			}

			.menu-icon-close,
			.site-header.is-open .menu-icon-open {
				display: none;
			}

			.site-header.is-open .menu-icon-close {
				display: inline;
			}

			.site-nav {
				padding: 0 1.25rem 1.25rem;
			}

			:global(html.js) .site-nav {
				display: none;
			}

			:global(html.js) .site-header.is-open .site-nav {
				display: block;
			}

			:global(html:not(.js)) .menu-toggle {
				display: none;
			}

			.site-nav ul {
				list-style: none;
				border-top: 1px solid var(--color-border);
			}

			.site-nav li a {
				position: relative;
				display: block;
				padding: 0.95rem 0 0.95rem 1rem;
				font-size: 1.0625rem;
				color: var(--color-muted);
				text-decoration: none;
				border-bottom: 1px solid var(--color-border);
				transition: color var(--transition-fast);
			}

			.site-nav li a:hover,
			.site-nav li a[aria-current="page"] {
				color: var(--color-text);
			}

			.site-nav li a[aria-current="page"] {
				font-weight: 600;
			}

			.site-nav li a[aria-current="page"]::before {
				content: "";
				position: absolute;
				top: 50%;
				left: 0;
				width: 3px;
				height: 1.5rem;
				background: var(--color-brand);
				transform: translateY(-50%);
			}

			.nav-admin {
				opacity: 0.7;
			}

			.nav-cta {
				width: 100%;
				margin-top: 1.25rem;
			}

			.side-note,
			.page-top {
				display: none;
			}

			.page {
				min-width: 0;
			}

			main {
				min-height: 60vh;
			}

			main:focus {
				outline: none;
			}

			/* ---------- Desktop: fixed left column ---------- */
			@media (min-width: 1024px) {
				.shell {
					display: grid;
					grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
				}

				.site-header {
					position: sticky;
					top: 0;
					display: flex;
					flex-direction: column;
					height: 100vh;
					padding: 3.25rem 1.5rem 2.5rem 3rem;
					background: none;
					backdrop-filter: none;
					border-bottom: 0;
				}

				.header-bar {
					padding: 0;
				}

				.wordmark {
					font-size: 2rem;
				}

				.menu-toggle {
					display: none;
				}

				:global(html.js) .site-nav,
				.site-nav {
					display: block;
					margin-top: 4.5rem;
					padding: 0;
				}

				.site-nav ul {
					border-top: 0;
				}

				.site-nav li a {
					padding: 0.7rem 0 0.7rem 1.6rem;
					font-size: 1.125rem;
					border-bottom: 0;
				}

				.site-nav li a[aria-current="page"] {
					font-weight: 500;
				}

				.site-nav li a[aria-current="page"]::before {
					height: 1.75rem;
				}

				.nav-cta {
					display: none;
				}

				.side-note {
					display: flex;
					flex-direction: column;
					gap: 0.55rem;
					margin-top: auto;
					font-size: 0.6875rem;
					line-height: 1;
					color: var(--color-muted);
				}

				.side-note .rule {
					width: 1.25rem;
					margin-top: 0.6rem;
					background: var(--color-muted);
				}

				.page-top {
					display: flex;
					justify-content: flex-end;
					padding: 2.75rem 3rem 0;
				}

				.page-cta {
					min-height: 3.5rem;
					padding: 0.9rem 1.6rem;
					font-size: 1.1875rem;
					font-weight: 700;
					border-radius: 14px;
				}
			}

			/* ---------- Footer ---------- */
			.site-footer {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-between;
				align-items: flex-start;
				gap: var(--spacing-xl);
				margin: 0 1.25rem;
				padding: var(--spacing-2xl) 0;
				border-top: 1px solid var(--color-border);
			}

			@media (min-width: 1024px) {
				.site-footer {
					margin: 0 3rem;
				}
			}

			.footer-logo {
				font-size: var(--font-size-lg);
				font-weight: 700;
				letter-spacing: -0.03em;
			}

			.footer-tagline {
				margin-top: var(--spacing-xs);
				font-size: var(--font-size-sm);
				color: var(--color-muted);
			}

			.footer-right {
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				gap: var(--spacing-md);
			}

			.theme-switcher {
				display: flex;
				gap: var(--spacing-xs);
				padding: 3px;
				border: 1px solid var(--color-border);
				border-radius: var(--radius-pill);
			}

			.theme-btn {
				min-height: 2.25rem;
				padding: 0 0.9rem;
				font-family: var(--font-body);
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				background: transparent;
				border: 0;
				border-radius: var(--radius-pill);
				cursor: pointer;
				transition:
					background var(--transition-fast),
					color var(--transition-fast);
			}

			.theme-btn:hover {
				color: var(--color-text);
			}

			.theme-btn.active {
				color: var(--color-bg);
				background: var(--color-text);
			}

			.footer-powered {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
			}

			.footer-powered a {
				color: var(--color-text);
			}

			@media (max-width: 640px) {
				.site-footer {
					flex-direction: column;
				}

				.footer-right {
					align-items: flex-start;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}

				*,
				*::before,
				*::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
				}
			}
		</style>
	</body>
</html>
