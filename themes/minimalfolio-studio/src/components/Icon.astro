---
/** Original line icons (24px grid, currentColor). Decorative unless a label is given. */
export type IconName = "arrow-right" | "mail" | "rss" | "chat" | "menu" | "close" | "external";

interface Props {
	name: IconName;
	size?: number;
	label?: string;
	class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
	focusable="false"
>
	{name === "arrow-right" && <path d="M4 12h15M13 6l6 6-6 6" />}
	{
		name === "mail" && (
			<>
				<rect x="3" y="5" width="18" height="14" rx="1.5" />
				<path d="m3.5 6 8.5 7 8.5-7" />
			</>
		)
	}
	{
		name === "rss" && (
			<>
				<path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" />
				<circle cx="6" cy="18" r="1.4" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === "chat" && (
			<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5z" />
		)
	}
	{name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
	{name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
	{name === "external" && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
</svg>
