---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ContactBand from "../components/ContactBand.astro";
import PageHead from "../components/PageHead.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getPractice } from "../lib/practice";

const [{ entry: page, cacheHint }, practiceResult, settings] = await Promise.all([
	getEmDashEntry("pages", "about"),
	getPractice(),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	if (cacheHint) Astro.cache.set(cacheHint);
	Astro.cache.set(practiceResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = page ? getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: "/about" }) : null;
const { practice } = practiceResult;
const hasBody = Boolean(page?.data.content && page.data.content.length > 0);
---

<Base
	title={seo?.title ?? "Meet your therapist"}
	pageTitle={seo?.ogTitle}
	description={seo?.description ?? page?.data.intro ?? "Meet Maren, the therapist behind Willow & Co."}
	canonical={seo?.canonical}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	<PageHead
		id="about-title"
		eyebrow={page?.data.eyebrow ?? "About"}
		title={page?.data.title ?? "Meet your therapist"}
		intro={page?.data.intro}
		edit={page ? { ...page.edit.title } : {}}
	/>

	<section class="about-story">
		<div class="wrap about-grid">
			<figure class="about-photo">
				<img
					src="/images/therapist-portrait.webp"
					alt="Maren in a cream cardigan sitting in a boucle armchair with an open notebook on her knee, smiling gently"
					width="820"
					height="1046"
					loading="lazy"
				/>
				<figcaption>Maren Ellis. A fictional therapist created for this theme.</figcaption>
			</figure>
			<div class="prose">
				{hasBody ? <PortableText value={page!.data.content} /> : <p>Maren's story is coming soon.</p>}
				{
					practice.registration && (
						<div class="registration">
							<h2>Registration and training</h2>
							<p>{practice.registration}</p>
						</div>
					)
				}
				<p class="about-links">
					<a class="btn btn-olive" href="/contact"><span>Get in touch</span><Arrow /></a>
					<a class="text-link" href="/approach"><span>How sessions work</span><Arrow /></a>
				</p>
			</div>
		</div>
	</section>

	<ContactBand practice={practice} />
</Base>
