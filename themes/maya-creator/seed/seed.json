   {
    "id": "simple-sheet-pan-vegetables",
    "slug": "simple-sheet-pan-vegetables",
    "status": "published",
    "data": {
     "title": "Simple Sheet Pan Vegetables for Any Season",
     "excerpt": "One method, endless vegetables: how to roast almost anything until it is sweet, crisp and golden.",
     "content": [
      {
       "_type": "block",
       "style": "normal",
       "_key": "k55",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "I roast vegetables at least three times a week. The trick is not a recipe, it is a rhythm: cut evenly, oil generously, and give everything room.",
         "_key": "k56",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k57",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "The method",
         "_key": "k58",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k59",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Heat the oven to 425°F with the pan inside",
         "_key": "k60",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k61",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Toss 2 pounds of chopped vegetables with olive oil and salt",
         "_key": "k62",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k63",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Spread in one layer and roast 30 to 40 minutes, turning once",
         "_key": "k64",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k65",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Finish with lemon, herbs or a spoonful of yogurt",
         "_key": "k66",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k67",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Hard vegetables like carrots and beets go in first; softer ones such as zucchini join for the last twenty minutes.",
         "_key": "k68",
         "marks": []
        }
       ]
      }
     ],
     "photo": "/images/sheet-pan.webp",
     "photo_alt": "Sheet pan of roasted carrots, Brussels sprouts and red onion",
     "kind": "recipe",
     "format": "video",
