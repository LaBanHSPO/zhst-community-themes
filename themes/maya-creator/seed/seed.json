   {
    "id": "fluffy-almond-pancakes-berries",
    "slug": "fluffy-almond-pancakes-berries",
    "status": "published",
    "data": {
     "title": "Fluffy Almond Pancakes with Berries",
     "excerpt": "Tall, tender pancakes with almond flour and a spoonful of ricotta, piled high with fresh berries.",
     "content": [
      {
       "_type": "block",
       "style": "normal",
       "_key": "k83",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Weekend pancakes should be slow to eat and quick to make. These are both.",
         "_key": "k84",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k85",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "What you need",
         "_key": "k86",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k87",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "1 cup all-purpose flour and 1/2 cup almond flour",
         "_key": "k88",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k89",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "1 tablespoon baking powder, pinch of salt",
         "_key": "k90",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k91",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "1 cup milk, 1/2 cup ricotta, 2 eggs",
         "_key": "k92",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k93",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Butter for the pan; berries and maple syrup to serve",
         "_key": "k94",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k95",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Method",
         "_key": "k96",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k97",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Whisk the dry ingredients, then fold in the wet until just combined; lumps are welcome. Cook on a medium pan, a quarter cup at a time, until the bubbles hold. Stack, scatter the berries and pour over the syrup.",
         "_key": "k98",
         "marks": []
        }
       ]
      }
     ],
     "photo": "/images/almond-pancakes.webp",
