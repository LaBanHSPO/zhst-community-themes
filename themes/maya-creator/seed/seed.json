   {
    "id": "roasted-squash-grain-bowls",
    "slug": "roasted-squash-grain-bowls",
    "status": "published",
    "data": {
     "title": "Roasted Squash Grain Bowls with Tahini Dressing",
     "excerpt": "Caramelized squash over nutty grains, wilted greens and a lemony tahini drizzle. A bowl that keeps well all week.",
     "content": [
      {
       "_type": "block",
       "style": "normal",
       "_key": "k1",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "This is the bowl I make when the first cold evenings arrive: sweet roasted squash, chewy farro and a dressing that tastes brighter than it has any right to.",
         "_key": "k2",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k3",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "What you need",
         "_key": "k4",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k5",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "1 small kabocha or butternut squash, cut into wedges",
         "_key": "k6",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k7",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "1 cup farro or brown rice, cooked",
         "_key": "k8",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k9",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "2 big handfuls of kale or spinach",
         "_key": "k10",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k11",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "3 tablespoons tahini, juice of 1 lemon, 1 small garlic clove, water to thin",
         "_key": "k12",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k13",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Olive oil, flaky salt, a handful of crumbled feta",
         "_key": "k14",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k15",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "How it comes together",
         "_key": "k16",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k17",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Roast the squash at 425°F for 25 minutes until the edges darken. Wilt the greens in the same pan while the grains warm through. Whisk the tahini dressing until pourable, then build the bowls and finish with feta and a pinch of salt.",
         "_key": "k18",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k19",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Leftovers keep for three days. Pack the dressing separately so the greens stay lively.",
         "_key": "k20",
         "marks": []
        }
       ]
      }
     ],
     "photo": "/images/grain-bowls.webp",
     "photo_alt": "A speckled bowl of roasted squash, grains, greens and crumbled cheese",
     "kind": "recipe",
     "format": "video",
     "minutes": 30,
     "position": 10,
     "featured": true,
     "home_position": 1
    },
    "taxonomies": {
     "category": [
      "recipes"
     ],
     "tag": [
      "seasonal",
      "meal-prep"
     ]
    }
   },
   {
    "id": "one-pan-lemon-pasta-crispy-herbs",
    "slug": "one-pan-lemon-pasta-crispy-herbs",
    "status": "published",
    "data": {
     "title": "One-Pan Lemon Pasta with Crispy Herbs",
     "excerpt": "Everything cooks in a single skillet: a silky lemon sauce, golden herbs and almost no washing up.",
     "content": [
      {
       "_type": "block",
       "style": "normal",
       "_key": "k21",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "A weeknight pasta that feels like a treat. The pasta cooks directly in the sauce, so the starch makes it glossy without any cream.",
         "_key": "k22",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k23",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "What you need",
         "_key": "k24",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k25",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "12 oz spaghetti or linguine",
         "_key": "k26",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k27",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "3 cups water or light stock",
         "_key": "k28",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k29",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Zest and juice of 2 lemons",
         "_key": "k30",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k31",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "A handful each of sage and parsley",
         "_key": "k32",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k33",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Parmesan, olive oil, black pepper",
         "_key": "k34",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "k35",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Method",
         "_key": "k36",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k37",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Crisp the herbs in olive oil and set them aside. Add the pasta, liquid and lemon to the skillet, then simmer for ten minutes, stirring often, until the sauce clings. Finish with parmesan, pepper and the crispy herbs.",
         "_key": "k38",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k39",
       "markDefs": [],
       "children": [
        {
