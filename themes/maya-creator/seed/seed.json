   {
    "id": "finding-beauty-in-ordinary-days",
    "slug": "finding-beauty-in-ordinary-days",
    "status": "published",
    "data": {
     "title": "Finding Beauty in Ordinary Days",
     "excerpt": "A Saturday market, a bunch of ranunculus and a reminder to look up while I am running errands.",
     "content": [
      {
       "_type": "block",
       "style": "normal",
       "_key": "k69",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "The farmers market is not on my way to anywhere. I go anyway, because walking between the stalls is the closest thing I have to a reset button.",
         "_key": "k70",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k71",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "This week it was ranunculus, a loaf still warm from the oven and a conversation about plums with a grower who has been selling at the same corner for years. Nothing happened, and that was exactly the point.",
         "_key": "k72",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k73",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Beauty tends to hide in ordinary routines. A few things that help me notice it:",
         "_key": "k74",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k75",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Take the longer route once a week",
         "_key": "k76",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k77",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Buy one thing just because it is lovely",
         "_key": "k78",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "listItem": "bullet",
       "level": 1,
       "_key": "k79",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "Leave the headphones at home",
         "_key": "k80",
         "marks": []
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "k81",
       "markDefs": [],
       "children": [
        {
         "_type": "span",
         "text": "What small thing made your day brighter this week? I would love to hear it.",
         "_key": "k82",
         "marks": []
        }
       ]
      }
     ],
     "photo": "/images/finding-beauty.webp",
     "photo_alt": "A woman with a tote bag browsing flowers at an outdoor market",
     "kind": "story",
     "format": "article",
     "minutes": 7,
     "position": 50,
     "featured": true,
     "home_position": 4
    },
    "taxonomies": {
     "category": [
      "lifestyle"
     ],
     "tag": [
      "markets",
      "slow-living"
     ]
    }
