---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getProfile } from "../lib/maya";
import Icon from "../components/Icon.astro";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } = Astro.props;
const [settingsResult, menuResult, profileResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getProfile(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(profileResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const navItems = menuResult.data?.items ?? [];
const { profile } = profileResult;
const socials = [
	{ name: "Instagram", icon: "instagram", url: profile.instagram },
	{ name: "Pinterest", icon: "pinterest", url: profile.pinterest },
	{ name: "YouTube", icon: "youtube", url: profile.youtube },
	{ name: "TikTok", icon: "tiktok", url: profile.tiktok },
].filter((s) => s.url);

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (url: string) => {
	const target = url.replace(/\/$/, "") || "/";
	if (target === "/") return path === "/";
	return path === target || path.startsWith(`${target}/`);
};
// Detail pages highlight their section: stories/categories/tags sit under the library,
// any recipe collection under the "Recipe collection" link.
const collectionNav = navItems.find((i) => /^\/collection\/.+/.test(i.url));
const libraryNav = navItems.find((i) => i.url === "/library");
const currentUrl =
	navItems.find((i) => isCurrent(i.url))?.url ??
	(path.startsWith("/collection/") ? collectionNav?.url : undefined) ??
	(/^\/(posts|category|tag)(\/|$)/.test(path) ? libraryNav?.url : undefined);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Intl.DateTimeFormat("en-US", { year: "numeric", timeZone: "Asia/Saigon" }).format(new Date());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=DM+Sans:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&display=swap"
			rel="stylesheet"
		/>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-head">
			<div class="head-inner">
				<a class="wordmark" href="/" aria-label={`${siteTitle} — homepage`}>
					{
						siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						) : (
							<>
								<span>{siteTitle}</span>
								<Icon name="sprig" size={52} class="wordmark-sprig" />
							</>
						)
					}
				</a>
				<nav class="nav" aria-label="Primary">
					{
						navItems.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={item.url === currentUrl ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<div class="head-tools">
					<ul class="social" role="list">
						{
							socials.map((s) => (
								<li>
									<a href={s.url} aria-label={s.name} rel="noopener noreferrer" target="_blank">
										<Icon name={s.icon} size={20} />
									</a>
								</li>
							))
						}
					</ul>
					<span class="tools-rule" aria-hidden="true"></span>
					<a class="search-link" href="/library#search" aria-label="Search the content library">
						<Icon name="search" size={22} />
					</a>
				</div>
				<details class="mobile-nav">
					<summary>
						<svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true" focusable="false">
							<path d="M0 1h16M0 6h16M0 11h16" stroke="currentColor" stroke-width="1.5"></path>
						</svg>
						Menu
					</summary>
					<nav class="mobile-panel" aria-label="Primary (mobile)">
						{
							navItems.map((item) => (
								<a href={item.url} aria-current={item.url === currentUrl ? "page" : undefined}>
									{item.label}
								</a>
							))
						}
						<a class="mobile-search" href="/library#search">Search the library</a>
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="container foot-inner">
				<div class="foot-brand">
					<a class="wordmark" href="/">
						<span>{siteTitle}</span>
						<Icon name="sprig" size={40} class="wordmark-sprig" />
					</a>
					<p>{siteTagline}</p>
				</div>
				<div>
					<h2>Explore</h2>
					{navItems.map((item) => <a href={item.url}>{item.label}</a>)}
				</div>
				<div>
					<h2>Say hello</h2>
					{profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
					<ul class="social" role="list">
						{
							socials.map((s) => (
								<li>
									<a href={s.url} aria-label={s.name} rel="noopener noreferrer" target="_blank">
										<Icon name={s.icon} size={20} />
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
			<div class="container foot-bottom">
				<span>© {year} {siteTitle}. All rights reserved.</span>
				<span>Built with EmDash</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<script>
	// Remember saved stories in this browser only; nothing leaves the device.
	const KEY = "maya-saved";
	let saved: string[] = [];
	try {
		saved = JSON.parse(localStorage.getItem(KEY) ?? "[]");
		if (!Array.isArray(saved)) saved = [];
	} catch {
		saved = [];
	}
	document.querySelectorAll<HTMLButtonElement>("[data-save]").forEach((btn) => {
		const id = btn.dataset.save ?? "";
		const paint = () => btn.setAttribute("aria-pressed", String(saved.includes(id)));
		paint();
		btn.addEventListener("click", () => {
			saved = saved.includes(id) ? saved.filter((s) => s !== id) : [...saved, id];
			try {
				localStorage.setItem(KEY, JSON.stringify(saved));
			} catch {
				/* storage unavailable: keep the in-memory state for this page view */
			}
			paint();
		});
	});
</script>
