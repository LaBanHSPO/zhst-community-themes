---
import { getTaxonomyTermsWithCacheHint, getTermsForEntries } from "emdash";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts, inTab, isLibraryTab, LIBRARY_TABS, type LibraryTab } from "../lib/maya";

const params = Astro.url.searchParams;
const rawTab = params.get("tab");
const tab: LibraryTab = isLibraryTab(rawTab) ? rawTab : "recipes";
const q = (params.get("q") ?? "").trim().slice(0, 80);
const cat = params.get("cat") ?? "";
const fmt = params.get("fmt") === "video" || params.get("fmt") === "article" ? params.get("fmt")! : "";

const [postsResult, termsResult] = await Promise.all([
	getPosts(100),
	getTaxonomyTermsWithCacheHint("category", { includeCounts: false }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(postsResult.cacheHint);
	Astro.cache.set(termsResult.cacheHint);
}
const categories = termsResult.data;
const tagsByEntry = await getTermsForEntries(
	"posts",
	postsResult.entries.map((p) => p.data.id),
	"category",
);

const needle = q.toLowerCase();
const results = postsResult.entries.filter(({ data }) => {
	if (!inTab(data, tab)) return false;
	if (fmt && data.format !== fmt) return false;
	if (cat && !(tagsByEntry.get(data.id) ?? []).some((t) => t.slug === cat)) return false;
	if (needle && !`${data.title} ${data.excerpt ?? ""}`.toLowerCase().includes(needle)) return false;
	return true;
});

const tabHref = (value: LibraryTab) => {
	const next = new URLSearchParams();
	if (value !== "recipes") next.set("tab", value);
	if (q) next.set("q", q);
	if (cat) next.set("cat", cat);
	if (fmt) next.set("fmt", fmt);
	const qs = next.toString();
	return qs ? `/library?${qs}` : "/library";
};
---

<Base title="Content library" description="Recipes, stories and videos from Maya's kitchen, with search and filters.">
	<Hero variant="library" image="/images/library-hero.webp" alt="Wooden boards, a speckled pitcher with utensils and a bowl of oranges on a kitchen shelf">
		<p class="eyebrow">Content library</p>
		<h1>Real food. A slower life.</h1>
		<p class="lede">A collection of my favorite recipes, everyday stories and videos — from my kitchen to yours.</p>
	</Hero>

	<section class="section library" aria-label="Browse the library">
		<div class="container">
			<div class="library-bar">
				<nav class="tabs" aria-label="Content type">
					{
						LIBRARY_TABS.map((t) => (
							<a href={tabHref(t.value)} aria-current={t.value === tab ? "page" : undefined}>
								{t.label}
							</a>
						))
					}
				</nav>
				<form class="filters" id="search" method="get" action="/library" role="search" data-filters>
					{tab !== "recipes" && <input type="hidden" name="tab" value={tab} />}
					<label class="search-field">
						<span class="visually-hidden">Search recipes, ingredients or topics</span>
						<Icon name="search" size={18} />
						<input type="search" name="q" value={q} placeholder="Search recipes, ingredients, or topics…" maxlength="80" />
					</label>
					<label class="select-field">
						<span class="visually-hidden">Category</span>
						<select name="cat" data-autosubmit>
							<option value="">All Categories</option>
							{categories.map((c) => <option value={c.slug} selected={c.slug === cat}>{c.label}</option>)}
						</select>
						<Icon name="chevron" size={16} />
					</label>
					<label class="select-field">
						<span class="visually-hidden">Format</span>
						<select name="fmt" data-autosubmit>
							<option value="">All Formats</option>
							<option value="video" selected={fmt === "video"}>Video</option>
							<option value="article" selected={fmt === "article"}>Article</option>
						</select>
						<Icon name="chevron" size={16} />
					</label>
					<noscript><button class="btn btn-sm" type="submit">Search</button></noscript>
				</form>
			</div>

			<p class="result-count" role="status" aria-live="polite">
				{results.length} {results.length === 1 ? "result" : "results"}{q ? ` for “${q}”` : ""}
			</p>
			{
				results.length === 0 ? (
					<p class="empty">
						Nothing matches yet. <a class="text-link" href="/library">Clear filters</a>.
					</p>
				) : (
					<ul class="card-grid" role="list">
						{results.map((e) => (
							<li>
								<PostCard post={e.data} />
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>
</Base>

<script>
	document.querySelectorAll<HTMLSelectElement>("[data-autosubmit]").forEach((select) => {
		select.addEventListener("change", () => select.form?.requestSubmit());
	});
</script>
