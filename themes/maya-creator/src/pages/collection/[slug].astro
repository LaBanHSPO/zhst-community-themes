---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Icon from "../../components/Icon.astro";
import { getProfile, mailtoHref, photoAlt, photoSrc } from "../../lib/maya";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: product, cacheHint } = await getEmDashEntry("products", slug);
if (!product) return Astro.redirect("/404");

const [profileResult, settings] = await Promise.all([getProfile(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(profileResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(product, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const d = product.data;
const { profile } = profileResult;
const price = Number.isInteger(d.price) ? `$${d.price}` : `$${d.price.toFixed(2)}`;
const ctaLabel = d.cta_label || "Get the recipe collection";
const ctaHref = profile.email
	? mailtoHref(
			profile.email,
			`${d.title}: recipe collection request`,
			`Hello Maya,\n\nI would like to get ${d.title} (${price}). Please let me know how to receive it.\n`,
		)
	: undefined;
const noteLines = (d.price_note ?? "").split("·").map((s) => s.trim()).filter(Boolean);
const heroSrc = photoSrc(d.hero_image, d.hero_photo);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "products", id: d.id, slug }}
>
	<Hero variant="product" image={heroSrc} alt={photoAlt(d.hero_image, d.hero_alt, d.title)}>
		<p class="eyebrow" {...product.edit.kicker}>{d.kicker ?? "Recipe collection"}</p>
		<h1 {...product.edit.title}>{d.title}</h1>
		{d.summary && <p class="lede" {...product.edit.summary}>{d.summary}</p>}
		{
			d.highlights && d.highlights.length > 0 && (
				<ul class="highlights" role="list">
					{d.highlights.map((h) => (
						<li>
							<Icon name={h.icon === "bowl" ? "bowl" : h.icon === "fork" ? "fork" : "leaf"} size={38} />
							<div>
								<strong>{h.value}</strong>
								<span>{h.label}</span>
							</div>
						</li>
					))}
				</ul>
			)
		}
		{
			ctaHref && (
				<a class="btn" href={ctaHref}>
					{ctaLabel} <Icon name="arrow" size={16} />
				</a>
			)
		}
	</Hero>

	<section class="section product-body">
		<div class="container product-grid">
			<div class="peek" aria-labelledby="peek-title">
				<p class="eyebrow">A peek inside</p>
				<div class="section-head">
					<h2 id="peek-title" class="h-section">Seasonal food for real life.</h2>
				</div>
				<ul class="spreads" role="list">
					{
						(d.spreads ?? []).map((s) => (
							<li>
								<img src={photoSrc(s.image, s.photo)} alt={photoAlt(s.image, s.alt, `${d.title} preview`)} loading="lazy" />
							</li>
						))
					}
				</ul>
			</div>
			<aside class="included" aria-labelledby="included-title">
				<h2 id="included-title" class="eyebrow">What’s included</h2>
				<ul class="include-list" role="list">
					{
						(d.includes ?? []).map((i) => (
							<li>
								<Icon name="check" size={20} />
								{i.text}
							</li>
						))
					}
				</ul>
				<div class="price-row">
					<p class="price" aria-label={`Price ${price}`}>{price}</p>
					<p class="price-note">{noteLines.map((l) => <span>{l}</span>)}</p>
				</div>
				{
					ctaHref ? (
						<>
							<a class="btn btn-block" href={ctaHref}>
								{ctaLabel} <Icon name="arrow" size={16} />
							</a>
							<p class="helper">
								Opens an email to {profile.email} to request the collection. Online checkout is not part of this theme.
							</p>
						</>
					) : null
				}
			</aside>
		</div>
	</section>
</Base>
