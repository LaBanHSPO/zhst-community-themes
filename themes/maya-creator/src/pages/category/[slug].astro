---
import { getTaxonomyTermsWithCacheHint, getEmDashCollection, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", { includeCounts: false });
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;
if (!term) return Astro.redirect("/404");

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { position: "asc" },
	limit: 12,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={`${term.label} — stories`} description={`Stories filed under ${term.label}`}>
	<section class="section archive">
		<div class="container">
			<p class="eyebrow">Category</p>
			<h1 class="h-page">{term.label}</h1>
			<p class="back"><a class="text-link" href="/posts">All stories</a></p>
			{
				entries.length === 0 ? (
					<p class="empty">Nothing filed under {term.label} yet.</p>
				) : (
					<ul class="card-grid" role="list">
						{entries.map((e) => (
							<li>
								<PostCard post={e.data} headingLevel={2} />
							</li>
						))}
					</ul>
				)
			}
			<nav class="pager" aria-label="Pagination">
				{cursor && <a class="text-link" href="/category/{term.slug}">First page</a>}
				{nextCursor && <a class="btn btn-sm" href={`/category/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}>Next page</a>}
			</nav>
		</div>
	</section>
</Base>
