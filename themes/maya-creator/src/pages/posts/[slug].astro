---
import { getEmDashEntry, getEmDashCollection, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import PostCard from "../../components/PostCard.astro";
import { entryKey, kindLabel, photoAlt, photoSrc } from "../../lib/maya";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.redirect("/404");

const [related, settings] = await Promise.all([
	getEmDashCollection("posts", { orderBy: { position: "asc" }, limit: 12 }),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(related.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const d = post.data;
const tags = d.terms?.tag ?? [];
const categories = d.terms?.category ?? [];
const src = photoSrc(d.featured_image, d.photo);
const more = related.entries.filter((e) => entryKey(e.data) !== entryKey(d) && e.data.kind === d.kind).slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.excerpt}
	canonical={seo.canonical}
	image={seo.ogImage ?? src}
	content={{ collection: "posts", id: d.id, slug }}
>
	<article class="story">
		<header class="story-head container-narrow">
			<p class="eyebrow">{categories[0]?.label ?? kindLabel(d)}</p>
			<h1 {...post.edit.title}>{d.title}</h1>
			{d.excerpt && <p class="lede" {...post.edit.excerpt}>{d.excerpt}</p>}
			<ul class="story-meta" role="list">
				<li>
					<Icon name={d.format === "video" ? "video" : "article"} size={16} />
					{d.format === "video" ? "Video" : "Article"}
				</li>
				{d.minutes && (
					<li>
						<Icon name={d.kind === "recipe" ? "fork" : "clock"} size={16} />
						{d.minutes} min
					</li>
				)}
				{d.publishedAt && (
					<li>
						<time datetime={d.publishedAt.toISOString()}>
							{d.publishedAt.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "Asia/Saigon" })}
						</time>
					</li>
				)}
			</ul>
		</header>
		{
			src && (
				<figure class="story-photo container-narrow">
					<img src={src} alt={photoAlt(d.featured_image, d.photo_alt, d.title)} width="1020" height="486" />
				</figure>
			)
		}
		<div class="story-body container-narrow prose">
			<PortableText value={d.content} />
		</div>
		{
			(tags.length > 0 || categories.length > 0) && (
				<footer class="story-foot container-narrow">
					<ul class="chips" role="list">
						{categories.map((c) => <li><a href={`/category/${c.slug}`}>{c.label}</a></li>)}
						{tags.map((t) => <li><a href={`/tag/${t.slug}`}>#{t.label}</a></li>)}
					</ul>
				</footer>
			)
		}
	</article>

	{
		more.length > 0 && (
			<section class="section related" aria-labelledby="more-title">
				<div class="container">
					<div class="section-head">
						<h2 id="more-title" class="h-section">More from the library</h2>
						<a class="text-link" href="/library">Browse the library <Icon name="arrow" size={14} /></a>
					</div>
					<ul class="card-grid card-grid-3" role="list">
						{more.map((e) => <li><PostCard post={e.data} /></li>)}
					</ul>
				</div>
			</section>
		)
	}
</Base>
