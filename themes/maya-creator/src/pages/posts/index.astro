---
import { getEmDashCollection, getTaxonomyTermsWithCacheHint } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const [{ entries, cacheHint, nextCursor }, termsResult] = await Promise.all([
	getEmDashCollection("posts", { orderBy: { position: "asc" }, limit: 12, cursor }),
	getTaxonomyTermsWithCacheHint("category", { includeCounts: false }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(termsResult.cacheHint);
}
---

<Base title="All stories" description="Every recipe and story from Maya's kitchen.">
	<section class="section archive">
		<div class="container">
			<p class="eyebrow">Stories</p>
			<h1 class="h-page">All stories</h1>
			<nav class="chips" aria-label="Categories">
				<a href="/posts" aria-current="page">All</a>
				{termsResult.data.map((t) => <a href={`/category/${t.slug}`}>{t.label}</a>)}
			</nav>
			{
				entries.length === 0 ? (
					<p class="empty">No stories yet.</p>
				) : (
					<ul class="card-grid" role="list">
						{entries.map((e) => (
							<li>
								<PostCard post={e.data} headingLevel={2} />
							</li>
						))}
					</ul>
				)
			}
			<nav class="pager" aria-label="Pagination">
				{cursor && <a class="text-link" href="/posts">First page</a>}
				{nextCursor && <a class="btn btn-sm" href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>Next page</a>}
			</nav>
		</div>
	</section>
</Base>
