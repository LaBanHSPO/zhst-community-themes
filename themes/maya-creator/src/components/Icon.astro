				<circle cx="12" cy="13" r="3.8" />
			</>
		)
	}
	{
		name === "bowl" && (
			<>
				<path d="M3 11h18c0 5-3.5 8-9 8s-9-3-9-8zM8 21h8M9 7c0-1.5 1-2 1-3.5M14 7c0-1.5 1-2 1-3.5" />
			</>
