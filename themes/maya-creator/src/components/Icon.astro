	}
	{
		name === "clock" && (
			<>
				<circle cx="12" cy="12" r="9" />
				<path d="M12 7v5l3 2" />
			</>
		)
	}
	{
		name === "video" && (
			<>
				<rect x="3" y="5" width="18" height="14" rx="2.5" />
				<path d="m10.5 9.5 4 2.5-4 2.5z" />
			</>
		)
	}
	{
		name === "article" && (
			<>
				<rect x="4" y="3" width="16" height="18" rx="2" />
				<path d="M8 8h8M8 12h8M8 16h5" />
			</>
		)
	}
	{
		name === "bookmark" && (
			<>
				<path d="M6.5 3h11v18L12 16.5 6.5 21z" />
			</>
		)
	}
	{
		name === "search" && (
			<>
