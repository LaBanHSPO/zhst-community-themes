	}
	{
		name === "sprig" && (
			<>
				<path d="M4 21C9 15 13 10 19 3M10.5 13.2C8 13.5 6 12.5 5 10c2.5-.3 4.5.6 5.5 3.2zM13.5 9.8c-.5-2.5.6-4.6 3-5.6.7 2.5-.4 4.6-3 5.6zM12 15c1.5-2 3.8-2.5 6-1.6-1 2.2-3.5 2.7-6 1.6z" />
			</>
		)
	}
	{
		name === "check" && (
			<>
				<path d="M20 4C10.5 4 6 9 6 14.5c0 1.6.6 2.9 1.6 3.7M5 21c1.8-4.5 4.8-8 10-10.5M7.6 18.2C9.5 19.6 12 20 14 20" />
