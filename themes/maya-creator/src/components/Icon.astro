---
/** Inline icon set. Decorative by default; the parent supplies any accessible name. */
interface Props {
	name: string;
	size?: number;
	class?: string;
}
const { name, size = 24, class: className } = Astro.props;
---

<svg
	class:list={["icon", className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{
		name === "fork" && (
			<>
				<path d="M6 2v7a2 2 0 0 0 4 0V2M8 2v20M17 22V2c-2.5 1.5-3.5 4.5-3.5 8 0 2 1 3 3.5 3.5" />
			</>
		)
	}
	{
		name === "home" && (
			<>
				<path d="M3 11.5 12 3l9 8.5M5.5 10V21h13V10M10 21v-6h4v6" />
			</>
		)
	}
	{
		name === "leaf" && (
			<>
				<path d="M20 4C10 4 4.5 8.5 4.5 14.5c0 2 .8 3.5 2 4.5C8 19.6 9.6 20 11 20c6 0 9-6.5 9-16zM4 21c2-5 5.5-8.5 11-11" />
			</>
		)
	}
	{
		name === "plant" && (
