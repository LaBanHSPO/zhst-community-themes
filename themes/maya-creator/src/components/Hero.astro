---
interface Props {
	image?: string;
	alt?: string;
	variant?: "home" | "kit" | "library" | "product" | "collab";
}
const { image, alt = "", variant = "home" } = Astro.props;
---

<section class:list={["hero", `hero--${variant}`]}>
	{
		image && (
			<div class="hero-media">
				<img src={image} alt={alt} loading="eager" decoding="async" fetchpriority="high" />
			</div>
		)
	}
	<div class="container hero-inner">
		<div class="hero-copy">
			<slot />
		</div>
	</div>
</section>
