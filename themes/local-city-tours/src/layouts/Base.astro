---
import { getEmDashCollection, getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/instrument-sans";
import Logo from "../components/Logo.astro";
import Arrow from "../components/Arrow.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getCompany, rows, telHref } from "../lib/tours";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Header sits over the page's first (photographic) section. */
	overlay?: boolean;
	/** Force which primary-menu URL is marked current. */
	current?: string;
}

const { title, pageTitle, description, image, canonical, content, overlay = false, current } = Astro.props;
const [settingsResult, menuResult, companyResult, pagesResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getCompany(),
	getEmDashCollection("pages", { limit: 20 }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(companyResult.cacheHint);
	Astro.cache.set(pagesResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName = title.startsWith(siteTitle) || title.endsWith(` | ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} | ${siteTitle}`;
const pageDescription = description ?? `${siteTitle}. Guided walking, food and highlight tours led by local people.`;
const navItems = menuResult.data?.items ?? [];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const norm = (url: string) => url.replace(/\/$/, "") || "/";
const { company } = companyResult;
const office = rows(company.office);
// CMS pages that are not in the primary menu are linked from the footer.
const menuUrls = new Set(navItems.map((i) => norm(i.url)));
const extraPages = pagesResult.entries
	.map((p) => ({ url: `/${p.data.slug ?? p.data.id}`, label: p.data.eyebrow || p.data.title }))
	.filter((p) => !menuUrls.has(p.url));

const currentUrl =
	current ??
	navItems.find((i) => norm(i.url) === path)?.url ??
	navItems.find((i) => norm(i.url) !== "/" && path.startsWith(`${norm(i.url)}/`))?.url;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Intl.DateTimeFormat("en-GB", { year: "numeric", timeZone: "Asia/Saigon" }).format(new Date());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class:list={["site-head", { "is-overlay": overlay }]}>
			<div class="head-inner">
				<div class="head-brand">
					<Logo title={siteTitle} tagline={siteTagline} logo={siteLogo} class="head-logo" />
				</div>
				<nav class="nav" aria-label="Primary">
					{
						navItems.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={item.url === currentUrl ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<a class="btn btn-green head-cta" href="/tours">Explore tours</a>
				<details class="mobile-nav">
					<summary aria-label="Menu">
						<svg class="burger" width="22" height="14" viewBox="0 0 22 14" aria-hidden="true" focusable="false">
							<path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.6" />
						</svg>
						<svg class="close" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
							<path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.6" />
						</svg>
					</summary>
					<nav class="mobile-panel" aria-label="Primary (mobile)">
						{
							navItems.map((item) => (
								<a href={item.url} aria-current={item.url === currentUrl ? "page" : undefined}>
									{item.label}
								</a>
							))
						}
						<a href="/guides" aria-current={path === "/guides" ? "page" : undefined}>Guides</a>
						<a href="/contact" aria-current={path === "/contact" ? "page" : undefined}>Book a tour</a>
						<a class="btn btn-green" href="/tours">Explore tours <Arrow /></a>
						{company.phone && <a class="mobile-phone" href={telHref(company.phone)}>Call {company.phone}</a>}
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="foot-inner">
				<div class="foot-brand">
					<Logo title={siteTitle} tagline={siteTagline} logo={siteLogo} light />
					<p>Six local guides, four languages and groups of fourteen or fewer. Walking, food and highlight tours of the old city.</p>
				</div>
				<div>
					<h2>Explore</h2>
					<ul class="foot-links">
						{navItems.map((item) => <li><a href={item.url}>{item.label}</a></li>)}
						<li><a href="/guides">Guides</a></li>
						<li><a href="/contact">Book a tour</a></li>
						{extraPages.map((p) => <li><a href={p.url}>{p.label}</a></li>)}
					</ul>
				</div>
				<div class="foot-visit">
					<h2>Contact</h2>
					{
						(company.street || company.locality) && (
							<address>
								{company.street && <>{company.street}<br /></>}
								{company.locality}
							</address>
						)
					}
					{company.phone && <a href={telHref(company.phone)}>{company.phone}</a>}
					{company.email && <a href={`mailto:${company.email}`}>{company.email}</a>}
				</div>
				<div>
					<h2>Desk hours</h2>
					<dl class="foot-hours">
						{office.map((h) => <><dt>{h.left}</dt><dd>{h.right}</dd></>)}
					</dl>
				</div>
			</div>
			<div class="foot-bottom">
				<span>© {year} {company.title || siteTitle}</span>
				<span>Sample content is fictional. Built with EmDash</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
