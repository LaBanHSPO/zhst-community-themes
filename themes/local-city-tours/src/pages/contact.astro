---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { TYPES, getCompany, getTours, langSlug, rows, telHref } from "../lib/tours";

const [{ company, cacheHint }, toursResult] = await Promise.all([getCompany(), getTours()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(toursResult.cacheHint);
}
const office = rows(company.office);
const tours = toursResult.tours;
const languages = [...new Map(tours.flatMap((t) => t.languages).map((l) => [langSlug(l), l])).entries()].sort((a, b) => a[1].localeCompare(b[1]));
// ?tour=<slug> pre-selects the tour, ?lang=<language-slug> pre-selects the language.
const selected = tours.find((t) => (t.entry.data.slug ?? t.entry.data.id) === Astro.url.searchParams.get("tour"));
const wantedLang = languages.find(([slug]) => slug === Astro.url.searchParams.get("lang"))?.[0] ?? "";
const TIMES = ["09:00", "09:30", "10:00", "10:30", "11:00", "14:00", "15:00", "16:30", "17:30", "18:30"];
---

<Base title="Book a tour" description="Send a booking request to Local City Tours: the tour, date, time, group size, language and any access needs. We confirm every booking by email. Phone and email are on this page.">
	<PageHead
		id="contact-title"
		eyebrow="Book a tour"
		title="Tell us when you want to come."
		intro="Choose a tour, a date and a time. We check the guide and the group size and confirm by email, usually within one working day."
	/>
	<section class="contact-section" aria-labelledby="contact-title">
		<div class="wrap contact-grid">
			<form
				class="enquiry-form"
				data-enquiry-form
				data-email={company.email}
				action={company.email ? `mailto:${company.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field full">
						<label for="c-tour">Tour</label>
						<select id="c-tour" name="tour" required>
							<option value="" selected={!selected}>Choose a tour</option>
							{
								TYPES.map((ty) => (
									<optgroup label={ty.label}>
										{tours
											.filter((t) => t.entry.data.tour_type === ty.slug)
											.map((t) => (
												<option value={t.entry.data.title} selected={selected?.entry.data.id === t.entry.data.id}>
													{t.entry.data.title} ({t.entry.data.duration}, {t.times.join(" or ")})
												</option>
											))}
									</optgroup>
								))
							}
						</select>
						<span class="field-error" data-error-for="c-tour"></span>
					</div>
					<div class="field">
						<label for="c-date">Date</label>
						<input id="c-date" name="date" type="date" required />
						<span class="field-error" data-error-for="c-date"></span>
					</div>
					<div class="field">
						<label for="c-time">Start time</label>
						<select id="c-time" name="time" required>
							<option value="">Choose a time</option>
							{TIMES.map((t) => <option value={t}>{t}</option>)}
							<option value="Any time you suggest">Any time you suggest</option>
						</select>
						<span class="field-error" data-error-for="c-time"></span>
					</div>
					<div class="field">
						<label for="c-people">Group size</label>
						<select id="c-people" name="people" required>
							<option value="1">1 person</option>
							<option value="2" selected>2 people</option>
							<option value="3 to 4">3 to 4 people</option>
							<option value="5 to 8">5 to 8 people</option>
							<option value="9 to 12">9 to 12 people</option>
							<option value="More than 12">More than 12 people</option>
						</select>
					</div>
					<div class="field">
						<label for="c-lang">Tour language</label>
						<select id="c-lang" name="language" required>
							{languages.map(([slug, label]) => <option value={label} selected={slug === wantedLang || (!wantedLang && slug === "english")}>{label}</option>)}
							<option value="Other, described below">Other, described below</option>
						</select>
					</div>
					<div class="field full">
						<label for="c-access">Access needs <span class="optional">(optional)</span></label>
						<textarea id="c-access" name="access" rows="3" placeholder="Mobility, strollers, allergies or diets, hearing or sight needs"></textarea>
						<span class="field-hint">We check the route and tell you what is possible before you pay anything.</span>
					</div>
					<div class="field full">
						<label for="c-name">Name</label>
						<input id="c-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="c-name"></span>
					</div>
					<div class="field">
						<label for="c-email">Email</label>
						<input id="c-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="c-email"></span>
					</div>
					<div class="field">
						<label for="c-phone">Phone <span class="optional">(optional)</span></label>
						<input id="c-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field full">
						<label for="c-notes">Anything else? <span class="optional">(optional)</span></label>
						<textarea id="c-notes" name="notes" rows="3" placeholder="An occasion, ages of children, places you would like to see"></textarea>
					</div>
				</div>
				<button class="btn btn-green btn-lg btn-block" type="submit">Send booking request</button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{company.email && <>Write to <a href={`mailto:${company.email}`}>{company.email}</a> with the tour, date, time, group size and language.</>}
					</noscript>
				</p>
			</form>

			<aside class="contact-side">
				<h2>Prefer to talk?</h2>
				<p>
					{company.phone && <>Call <a href={telHref(company.phone)}>{company.phone}</a></>}
					{company.phone && company.email && " or email "}
					{!company.phone && company.email && "Email "}
					{company.email && <a href={`mailto:${company.email}`}>{company.email}</a>}.
				</p>
				{
					(company.street || company.locality) && (
						<p>{[company.street, company.locality].filter(Boolean).join(", ")}</p>
					)
				}
				{
					office.length > 0 && (
						<>
							<h3>Desk hours</h3>
							<dl class="side-hours">
								{office.map((h) => <><dt>{h.left}</dt><dd>{h.right}</dd></>)}
							</dl>
						</>
					)
				}
				{company.booking_note && <p class="small">{company.booking_note}</p>}
				<img src="/images/cup.webp" alt="A white coffee cup on a saucer with the handwritten words Explore More Locally on it" width="222" height="300" loading="lazy" />
			</aside>
		</div>
	</section>
</Base>

<script>
	// Validate, then compose a booking request email. Nothing is sent by the site itself;
	// the company confirms by reply.
	document.querySelectorAll<HTMLFormElement>("[data-enquiry-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input[required], select[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online booking requests are not available right now. Please call us.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Booking request: ${get("tour")} on ${get("date")}`;
			const lines = [
				"Hello,",
				"",
				"I would like to book a tour:",
				`Tour: ${get("tour")}`,
				`Date: ${get("date")}`,
				`Start time: ${get("time")}`,
				`Group size: ${get("people")}`,
				`Language: ${get("language")}`,
				get("access") ? `Access needs: ${get("access")}` : "",
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("notes") ? `Notes: ${get("notes")}` : "",
				"",
				"I understand this is a request and the booking is only confirmed when I get your reply by email.",
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this request ready to send. It is only sent when you send that email, and the booking is confirmed when we reply. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
