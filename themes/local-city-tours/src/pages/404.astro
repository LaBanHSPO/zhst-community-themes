---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<div class="wrap notfound-inner">
			<div class="notfound-copy">
				<p class="eyebrow">Error 404</p>
				<h1 id="nf-title" class="display">This street is not on our map.</h1>
				<p class="lede">The page you are looking for has moved or never existed. Pick a place to start from here.</p>
				<div class="actions">
					<a class="btn btn-green" href="/">Back to home <Arrow /></a>
					<a class="btn btn-ghost" href="/tours">Tours</a>
					<a class="btn btn-ghost" href="/contact">Book a tour</a>
				</div>
			</div>
			<img class="notfound-photo" src="/images/cobbles.webp" alt="" width="548" height="466" />
		</div>
	</section>
</Base>
