---
import { formatPrice, photoSrc, typeLabel } from "../lib/tours";
import type { TourRow } from "../lib/tours";

interface Props {
	row: TourRow;
}
const { row } = Astro.props;
const d = row.entry.data;
const src = photoSrc(d.image, d.photo);
---

<a class="tcard" href={`/tours/${d.slug ?? d.id}`}>
	<span class="tcard-photo">{src && <img src={src} alt="" width="640" height="400" loading="lazy" />}</span>
	<span class="tcard-body">
		<span class="tcard-type">{typeLabel(d.tour_type)}</span>
		<span class="tcard-title" {...row.entry.edit.title}>{d.title}</span>
		<span class="tcard-summary">{d.summary}</span>
		<span class="tcard-meta">
			<span>{d.duration}</span>
			<span>Up to {d.group_max}</span>
			<span>{row.languages.join(", ")}</span>
		</span>
		<span class="tcard-foot">
			<span class="tcard-price">From {formatPrice(d.price_from, d.price_unit)}</span>
			<span class="tcard-go" aria-hidden="true">
				<svg width="16" height="12" viewBox="0 0 16 12" focusable="false"><path d="M0 6h14.5M9.5 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
			</span>
		</span>
	</span>
</a>
