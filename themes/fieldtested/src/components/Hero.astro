---
interface Props { image: string; alt?: string; compact?: boolean; eyebrow?: string; title: string; lede?: string; id?: string }
const { image, compact = false, eyebrow, title, lede, id = "hero-title" } = Astro.props;
---
<section class:list={["hero", compact && "hero-compact"]} aria-labelledby={id}>
	<img class="hero-blur" src={image} alt="" aria-hidden="true" width="800" height="400" />
	<img class="hero-photo" src={image} alt="" width="812" height="394" fetchpriority="high" />
	<div class="wrap hero-copy">
		{eyebrow && <p class="eyebrow">{eyebrow}</p>}
		<h1 id={id}>{title}</h1>
		{lede && <p class="hero-lede">{lede}</p>}
		<slot />
	</div>
</section>
