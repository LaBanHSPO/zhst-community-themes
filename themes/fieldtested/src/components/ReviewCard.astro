---
import Arrow from "./Arrow.astro";
import { photoAlt, photoSrc, reviewUrl, shortDate, isoDate } from "../lib/fieldtested";
import type { Review } from "../lib/fieldtested";
interface Props { review: Review; meta?: boolean }
const { review: r, meta = false } = Astro.props;
const src = photoSrc(r.image, r.photo);
---
<article class="rcard">
	<a class="rcard-link" href={reviewUrl(r)}>
		{src && <img src={src} alt={photoAlt(r.image, r.photo_alt, r.title)} width="322" height="139" loading="lazy" />}
		<div class="rcard-body">
			<p class="kicker">{r.gear_type}</p>
			<h3>{r.title}</h3>
			<p class="rcard-sum">{r.summary}</p>
			{
				meta ? (
					<p class="rcard-meta">
						{r.author_photo && <img class="avatar" src={r.author_photo} alt="" width="30" height="30" loading="lazy" />}
						<span class="by">By <strong>{r.author}</strong></span>
						<time datetime={isoDate(r.date)}>{shortDate(r.date)}</time>
						<span class="go" aria-hidden="true"><Arrow /></span>
					</p>
				) : (
					<span class="go" aria-hidden="true"><Arrow /></span>
				)
			}
		</div>
	</a>
</article>
