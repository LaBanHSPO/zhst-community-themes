---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Hero from "../../components/Hero.astro";
import { getGuides, getSite, guideUrl, photoSrc } from "../../lib/fieldtested";

const [{ entries, cacheHint }, { site }] = await Promise.all([getGuides(), getSite()]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Buying guides" description="Practical buying guides for hiking, camping and travel gear.">
	<Hero compact image="/images/hero-guide.webp" title="Buying guides" lede="Practical advice for choosing gear, with recommendations from our reviews." />
	<div class="wrap">
		<section class="section" aria-label="All buying guides">
			<div class="ggrid">
				{
					entries.map((e) => (
						<article class="gcard">
							<img src={photoSrc(e.data.image, e.data.photo)} alt="" width="320" height="139" loading="lazy" />
							<a href={guideUrl(e.data)}>
								<h2>{e.data.card_title ?? e.data.title}</h2>
								<p>{e.data.summary}</p>
								<span class="go" aria-hidden="true"><Arrow /></span>
							</a>
						</article>
					))
				}
			</div>
			<p class="disclosure">{site.affiliate_line} <a href="/affiliate-disclosure">Affiliate disclosure</a></p>
		</section>
	</div>
</Base>
