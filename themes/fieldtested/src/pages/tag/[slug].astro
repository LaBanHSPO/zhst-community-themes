---
import { decodeSlug, getEmDashCollection, getTaxonomyTermsWithCacheHint } from "emdash";
import Base from "../../layouts/Base.astro";
import PostGrid from "../../components/PostGrid.astro";

const slug = decodeSlug(Astro.params.slug);
const terms = await getTaxonomyTermsWithCacheHint("tag", { includeCounts: false });
const term = slug ? terms.data.find((t) => t.slug === slug) : null;
if (!term) return Astro.redirect("/404");

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(terms.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={`${term.label} — field notes`} description={`Field notes filed under ${term.label}`}>
	<div class="wrap page-top">
		<p class="kicker">Tag</p>
		<h1>{term.label}</h1>
		<PostGrid posts={entries.map((e) => e.data)} empty="No field notes here yet." />
		<nav class="pager" aria-label="Pagination">
			{cursor && <a class="text-link" href={`/tag/${term.slug}`}>First page</a>}
			{nextCursor && <a class="btn btn-sm" href={`/tag/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}>Next page</a>}
		</nav>
		<p class="pager"><a class="text-link" href="/posts">All field notes</a></p>
	</div>
</Base>
