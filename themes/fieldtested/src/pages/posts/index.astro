---
import { getEmDashCollection, getTaxonomyTermsWithCacheHint } from "emdash";
import Base from "../../layouts/Base.astro";
import PostGrid from "../../components/PostGrid.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const [{ entries, cacheHint, nextCursor }, terms] = await Promise.all([
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 12, cursor }),
	getTaxonomyTermsWithCacheHint("category", { includeCounts: false }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(terms.cacheHint);
}
---

<Base title="Field notes" description="Short notes on packing, layering and looking after your gear.">
	<div class="wrap page-top">
		<h1>Field notes</h1>
		<p>Short notes on packing, layering and looking after your gear.</p>
		{terms.data.length > 0 && (
			<nav class="term-nav" aria-label="Categories">
				{terms.data.map((t) => <a class="chip" href={`/category/${t.slug}`}>{t.label}</a>)}
			</nav>
		)}
		<PostGrid posts={entries.map((e) => e.data)} empty="No field notes yet." />
		<nav class="pager" aria-label="Pagination">
			{cursor && <a class="text-link" href="/posts">Newest notes</a>}
			{nextCursor && <a class="btn btn-sm" href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>Older notes</a>}
		</nav>
	</div>
</Base>
