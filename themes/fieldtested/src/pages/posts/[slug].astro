---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { isoDate, photoAlt, photoSrc, shortDate } from "../../lib/fieldtested";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");
const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(post, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
const p = post.data;
const src = photoSrc(p.featured_image, p.photo);
const tags = p.terms?.tag ?? [];
const categories = p.terms?.category ?? [];
---

<Base title={seo.title} pageTitle={seo.ogTitle} description={seo.description ?? p.excerpt} canonical={seo.canonical} image={seo.ogImage ?? src} content={{ collection: "posts", id: p.id, slug }}>
	<article class="page-article">
		<p class="kicker">{categories[0] ? <a href={`/category/${categories[0].slug}`}>{categories[0].label}</a> : "Field note"}</p>
		<h1 {...post.edit.title}>{p.title}</h1>
		{p.publishedAt && <p class="post-meta"><time datetime={isoDate(p.publishedAt)}>{shortDate(p.publishedAt)}</time></p>}
		{src && <img class="post-photo" src={src} alt={photoAlt(p.featured_image, p.photo_alt, p.title)} width="1180" height="513" />}
		<div class="prose"><PortableText value={p.content} /></div>
		{tags.length > 0 && (
			<ul class="tag-list" role="list" aria-label="Tags">
				{tags.map((t) => <li><a href={`/tag/${t.slug}`}>#{t.label}</a></li>)}
			</ul>
		)}
	</article>
</Base>
