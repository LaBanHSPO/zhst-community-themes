---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import ReviewCard from "../../components/ReviewCard.astro";
import { ACTIVITIES, getReviews } from "../../lib/fieldtested";

const { entries, cacheHint } = await getReviews();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const sp = Astro.url.searchParams;
const activities = sp.getAll("activity").filter((a) => ACTIVITIES.some((x) => x.slug === a));
const types = sp.getAll("type");
const brand = sp.get("brand") ?? "";
const q = (sp.get("q") ?? "").trim().slice(0, 80);
const sort = ["newest", "oldest", "name"].includes(sp.get("sort") ?? "") ? (sp.get("sort") as string) : "newest";

const all = entries.map((e) => e.data);
const typeOptions = [...new Set(all.map((r) => r.gear_type).filter(Boolean))] as string[];
const brandOptions = [...new Set(all.map((r) => r.brand).filter(Boolean))].sort() as string[];
const countFor = (slug: string) => all.filter((r) => r.activities?.includes(slug)).length;
const countType = (t: string) => all.filter((r) => r.gear_type === t).length;

let shown = all.filter(
	(r) =>
		(activities.length === 0 || activities.some((a) => r.activities?.includes(a))) &&
		(types.length === 0 || (r.gear_type && types.includes(r.gear_type))) &&
		(!brand || r.brand === brand) &&
		(!q || `${r.title} ${r.product} ${r.brand} ${r.summary}`.toLowerCase().includes(q.toLowerCase())),
);
if (sort === "oldest") shown = [...shown].sort((a, b) => a.date.localeCompare(b.date));
if (sort === "name") shown = [...shown].sort((a, b) => a.product.localeCompare(b.product));
const filtered = activities.length + types.length + (brand ? 1 : 0) + (q ? 1 : 0) > 0;
const chipActive = (slug: string) => (slug === "all" ? activities.length === 0 : activities.length === 1 && activities[0] === slug);
---

<Base title="Review catalog" description="Independent, in-depth reviews of hiking, camping and travel gear for people who live for the outdoors.">
	<Hero
		compact
		image="/images/hero-home.webp"
		title="Review catalog"
		lede="Independent, in-depth reviews of hiking, camping and travel gear for people who live for the outdoors."
	/>

	<div class="wrap catalog">
		<form id="catalog-form" method="get" action="/reviews"></form>
		<details class="filters-wrap" open>
			<summary>Filter reviews</summary>
			<div class="filters">
				<h2>Filter reviews</h2>
				<fieldset>
					<legend>Category</legend>
					{
						ACTIVITIES.map((a) => (
							<label class="check">
								<input type="checkbox" name="activity" value={a.slug} form="catalog-form" checked={activities.includes(a.slug)} />
								{a.label} <span>({countFor(a.slug)})</span>
							</label>
						))
					}
				</fieldset>
				<fieldset>
					<legend>Gear type</legend>
					{
						typeOptions.map((t) => (
							<label class="check">
								<input type="checkbox" name="type" value={t} form="catalog-form" checked={types.includes(t)} />
								{t} <span>({countType(t)})</span>
							</label>
						))
					}
				</fieldset>
				<fieldset>
					<legend>Brand</legend>
					<label class="sr-only" for="brand">Brand</label>
					<select class="field" id="brand" name="brand" form="catalog-form">
						<option value="">All brands</option>
						{brandOptions.map((b) => <option value={b} selected={b === brand}>{b}</option>)}
					</select>
				</fieldset>
				<button class="btn btn-sm" type="submit" form="catalog-form">Apply filters</button>
				{filtered && <a class="text-link clear" href="/reviews">Clear filters</a>}
			</div>
		</details>

		<div>
			<div class="toolbar">
				<nav class="chips" aria-label="Activity">
					<a class="chip" href="/reviews" aria-current={chipActive("all") ? "true" : undefined}>All gear</a>
					{
						ACTIVITIES.map((a) => (
							<a class="chip" href={`/reviews?activity=${a.slug}`} aria-current={chipActive(a.slug) ? "true" : undefined}>{a.label}</a>
						))
					}
				</nav>
				<div class="toolbar-right">
					<span aria-live="polite">{shown.length} {shown.length === 1 ? "review" : "reviews"}</span>
					<label class="sr-only" for="catalog-search">Search reviews</label>
					<input class="field search-field" id="catalog-search" type="search" name="q" value={q} placeholder="Search reviews" form="catalog-form" />
					<label class="sr-only" for="sort">Sort by</label>
					<select class="field" id="sort" name="sort" form="catalog-form">
						<option value="newest" selected={sort === "newest"}>Sort by: Newest</option>
						<option value="oldest" selected={sort === "oldest"}>Sort by: Oldest</option>
						<option value="name" selected={sort === "name"}>Sort by: Name</option>
					</select>
					<button class="btn btn-sm" type="submit" form="catalog-form">Apply</button>
				</div>
			</div>
			{
				shown.length === 0 ? (
					<p class="empty">No reviews match these filters. <a class="text-link" href="/reviews">Clear filters</a></p>
				) : (
					<div class="rgrid rgrid-3">
						{shown.map((r) => <ReviewCard review={r} meta />)}
					</div>
				)
			}
		</div>
	</div>
</Base>
