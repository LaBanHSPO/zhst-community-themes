---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import ReviewCard from "../../components/ReviewCard.astro";
import { entryKey, getReviews, getSite, isoDate, lines, photoAlt, photoSrc, shortDate, slugify, specRows } from "../../lib/fieldtested";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");
const { entry, cacheHint } = await getEmDashEntry("reviews", slug);
if (!entry) return Astro.redirect("/404");

const [all, siteResult, settings] = await Promise.all([getReviews(), getSite(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(all.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(entry, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });

const r = entry.data;
const { site } = siteResult;
const cardSrc = photoSrc(r.image, r.photo);
const heroSrc = r.hero_photo ?? cardSrc;
const sideSrc = r.side_photo ?? cardSrc;
const alt = photoAlt(r.image, r.photo_alt, r.product);
const [intro, ...rest] = r.sections ?? [];
const specs = specRows(r.specs);
const alternatives = all.entries
	.map((e) => e.data)
	.filter((o) => entryKey(o) !== entryKey(r))
	.sort((a, b) => Number(b.gear_type === r.gear_type) - Number(a.gear_type === r.gear_type) || Number((b.activities ?? []).some((x) => r.activities?.includes(x))) - Number((a.activities ?? []).some((x) => r.activities?.includes(x))))
	.slice(0, 3);
const tabs = [
	{ id: "overview", label: "Overview" },
	...rest.map((s) => ({ id: slugify(s.heading), label: s.heading })),
	{ id: "pros", label: "What we like" },
	{ id: "cons", label: "What could be better" },
	{ id: "alternatives", label: "Alternatives" },
	{ id: "bottom-line", label: "The bottom line" },
];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? r.summary}
	canonical={seo.canonical}
	image={seo.ogImage ?? cardSrc}
	content={{ collection: "reviews", id: r.id, slug }}
>
	<article>
		<header class="rev-hero">
			{heroSrc && <img src={heroSrc} alt={alt} width="920" height="438" fetchpriority="high" />}
			<div class="rev-hero-copy">
				<p class="kicker">{r.gear_type}</p>
				<h1 {...entry.edit.title}>{r.title}</h1>
				<p class="rev-sum">{r.summary}</p>
				{r.demo !== false && <span class="badge">{site.demo_label ?? "Demo review"}</span>}
				<div class="byline">
					{r.author_photo && <img src={r.author_photo} alt="" width="54" height="54" />}
					<p class="who">
						<strong>By {r.author}</strong>
						Updated <time datetime={isoDate(r.updated ?? r.date)}>{shortDate(r.updated ?? r.date)}</time>
					</p>
					<p class="aff">{site.affiliate_line}</p>
				</div>
				{r.lead && <p class="rev-lead">{r.lead}</p>}
				{
					r.retailer_url && (
						<div class="cta-row">
							<a class="btn" href={r.retailer_url} rel="sponsored noopener" target="_blank">
								View at {r.retailer_name} <Arrow />
								<span class="sr-only"> (affiliate link, opens in a new tab)</span>
							</a>
							{r.alt_retailer_url && (
								<a class="text-link text-link-ul" href={r.alt_retailer_url} rel="sponsored noopener" target="_blank">
									Check price at {r.alt_retailer_name} <Arrow />
									<span class="sr-only"> (affiliate link, opens in a new tab)</span>
								</a>
							)}
						</div>
					)
				}
			</div>
		</header>

		<nav class="tabs" aria-label="On this review">
			<div class="wrap">
				<ul role="list">
					{tabs.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
				</ul>
			</div>
		</nav>

		<div class="wrap">
			<div class="rev-grid" id="overview">
				<section class="panel" id="pros" aria-labelledby="pros-h">
					<h2 id="pros-h">Pros</h2>
					<ul class="icon-list" role="list">
						{lines(r.pros).map((t) => (
							<li>
								<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="10" fill="#2f5d44" /><path d="m5.6 10.3 3 3 5.8-6" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
								<span>{t}</span>
							</li>
						))}
					</ul>
				</section>
				<section class="panel" id="cons" aria-labelledby="cons-h">
					<h2 id="cons-h">Cons</h2>
					<ul class="icon-list" role="list">
						{lines(r.cons).map((t) => (
							<li>
								<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="10" fill="#c94f08" /><path d="M5.5 10h9" stroke="#fff" stroke-width="2" stroke-linecap="round" /></svg>
								<span>{t}</span>
							</li>
						))}
					</ul>
				</section>
				<section class="panel specs" aria-labelledby="spec-h">
					<h2 id="spec-h">Key specifications</h2>
					<table class="spec-table">
						<tbody>
							{specs.map((s) => <tr><th scope="row">{s.label}</th><td>{s.value}</td></tr>)}
						</tbody>
					</table>
				</section>
				<aside class="side-card" aria-label="Where to buy">
					{sideSrc && <img src={sideSrc} alt="" width="200" height="160" loading="lazy" />}
					<h2>{r.product}</h2>
					<p>Check current price and availability at our trusted retailer.</p>
					{r.price_note && <p class="price">{r.price_note}</p>}
					{r.retailer_url && (
						<a class="btn btn-sm" href={r.retailer_url} rel="sponsored noopener" target="_blank">
							View at {r.retailer_name} <Arrow />
							<span class="sr-only"> (affiliate link, opens in a new tab)</span>
						</a>
					)}
					{r.alt_retailer_url && (
						<a class="text-link text-link-ul" href={r.alt_retailer_url} rel="sponsored noopener" target="_blank">
							Check price at {r.alt_retailer_name} <Arrow />
							<span class="sr-only"> (affiliate link, opens in a new tab)</span>
						</a>
					)}
				</aside>
			</div>

			<div class="rev-sections">
				{
					intro && (
						<section class="rsec" aria-labelledby="closer-h">
							<div>
								<h2 id="closer-h">{intro.heading}</h2>
								<p>{intro.body}</p>
							</div>
							<figure><img src="/images/hero-home.webp" alt="" width="812" height="394" loading="lazy" /></figure>
						</section>
					)
				}
				{
					rest.map((s) => (
						<section class="rsec rsec-plain" id={slugify(s.heading)} aria-labelledby={`${slugify(s.heading)}-h`}>
							<div>
								<h2 id={`${slugify(s.heading)}-h`}>{s.heading}</h2>
								<p>{s.body}</p>
							</div>
						</section>
					))
				}
				<section class="rsec rsec-plain" id="alternatives" aria-labelledby="alt-h">
					<div>
						<h2 id="alt-h">Alternatives</h2>
						<p>Other reviews you may want to read next, or <a class="text-link text-link-ul" href="/compare">compare backpacks side by side</a>.</p>
						<div class="alts">{alternatives.map((a) => <ReviewCard review={a} />)}</div>
					</div>
				</section>
			</div>

			<section class="bottom" id="bottom-line" aria-labelledby="bl-h">
				<h2 id="bl-h">The bottom line</h2>
				<p>{r.bottom_line}</p>
			</section>
			<p class="disclosure">{site.affiliate_line} {site.price_disclaimer} <a href="/affiliate-disclosure">Affiliate disclosure</a></p>
		</div>
	</article>
</Base>
