{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "worker-configuration.d.ts", "src/**/*"],
	"exclude": ["dist", "node_modules"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"types": ["node"],
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true
	}
}
