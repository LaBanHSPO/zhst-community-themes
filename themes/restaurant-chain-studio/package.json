{
	"name": "@zerohost/theme-restaurant-chain-studio",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "astro dev --host 127.0.0.1",
		"build": "astro build",
		"preview": "wrangler dev --config dist/server/wrangler.json --local --port 4366 --persist-to .wrangler/state",
		"typecheck": "astro check",
		"types": "wrangler types --config wrangler.local.jsonc",
		"migrate:local": "wrangler d1 migrations apply RESTAURANT_DB --local --config wrangler.local.jsonc",
		"configure": "node scripts/configure.mjs",
		"build:production": "RESTAURANT_CONFIG=wrangler.production.json astro build",
		"deploy": "node scripts/deploy.mjs"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.3.3",
		"@astrojs/react": "7.0.1",
		"@cloudflare/kumo": "2.6.0",
		"@emdash-cms/auth": "1.2.0",
		"@emdash-cms/cloudflare": "1.2.0",
		"@lingui/core": "5.9.5",
		"@lingui/react": "5.9.5",
		"@zerohost/plugin-restaurant-chain": "file:../../../zhst-community-plugins/plugins/restaurant-chain",
		"astro": "7.3.5",
		"emdash": "1.2.0",
		"oxc-transform-react": "0.145.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@cloudflare/workers-types": "5.20261010.1",
		"@types/node": "24.10.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"jsonc-parser": "3.3.1",
		"typescript": "5.9.3",
		"wrangler": "4.149.0"
	},
	"overrides": {
		"@astrojs/react": {
			"@vitejs/plugin-react": "6.1.1"
		}
	},
	"engines": {
		"node": "^24.15.0 || >=26.0.0"
	}
}
