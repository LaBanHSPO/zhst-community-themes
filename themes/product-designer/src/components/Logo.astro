---
/** Wordmark: the site title in bold sans, a thin rule, then the tagline in tiny tracked caps on two lines. */
interface Props {
	title: string;
	tagline?: string;
	logo?: { url?: string; alt?: string } | null;
	class?: string;
}
const { title, tagline, logo, class: className } = Astro.props;
const words = (tagline ?? "").split(" ");
---

<a class:list={["wordmark", className]} href="/" aria-label={`${title}, home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt || title} />
		) : (
			<>
				<span class="wordmark-title">{title}</span>
				{tagline && (
					<>
						<span class="wordmark-rule" aria-hidden="true" />
						<span class="wordmark-tagline">
							{words.map((w) => (
								<span>{w}</span>
							))}
						</span>
					</>
				)}
			</>
		)
	}
</a>
