---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import WorkCard from "../components/WorkCard.astro";
import NoteCard from "../components/NoteCard.astro";
import ContactBand from "../components/ContactBand.astro";
import { getNotes, getProfile, getServices, getSteps, getWork, lines, photoAlt } from "../lib/site";

const [workResult, notesResult, servicesResult, stepsResult, profileResult] = await Promise.all([
	getWork(),
	getNotes(),
	getServices(),
	getSteps(),
	getProfile(),
]);
for (const r of [workResult, notesResult, servicesResult, stepsResult, profileResult]) {
	if (Astro.cache?.enabled) Astro.cache.set(r.cacheHint);
}
const featuredWork = workResult.entries.filter((w) => w.data.featured).slice(0, 3);
const work = featuredWork.length > 0 ? featuredWork : workResult.entries.slice(0, 3);
const latestNotes = notesResult.entries.slice(0, 3);
const services = servicesResult.entries;
const steps = stepsResult.entries;
---

<Base
	title="Prose, Product Designer"
	description="Prose is the portfolio of Noor Calder, a product designer who helps small teams turn complex problems into simple, useful products. See selected work and get in touch."
	overlay
>
	<section class="hero" aria-labelledby="hero-title">
		<img class="hero-bg" src="/images/hero-home.webp" alt={photoAlt(null, "/images/hero-home.webp")} width="1448" height="598" fetchpriority="high" />
		<div class="hero-inner">
			<p class="eyebrow hero-eyebrow">Design for a brighter everyday</p>
			<h1 id="hero-title" class="display hero-title">Thoughtful design.<br />Clear outcomes.</h1>
			<p class="hero-sub">I'm a product designer who helps teams turn complex problems into simple, useful experiences.</p>
			<a class="btn btn-dark btn-lg" href="/work"><span>View selected work</span><Arrow /></a>
			<p class="hero-caps"><span class="hero-rule" aria-hidden="true"></span><span>People</span> / <span>Products</span> / <span>Progress</span></p>
		</div>
		<div class="hero-note" aria-hidden="true">
			<p>Better<br />products<br />for brighter<br />days.</p>
			<svg viewBox="0 0 70 30" width="70" height="30" focusable="false"><path d="M2 28 C 25 22, 48 12, 68 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
		</div>
	</section>

	<section class="section selected" aria-labelledby="selected-title">
		<div class="wrap">
			<div class="section-head">
				<div>
					<p class="eyebrow">Selected work</p>
					<h2 id="selected-title" class="display display-lg">Products for real people.</h2>
				</div>
				<a class="text-link" href="/work"><span>View all work</span><Arrow /></a>
			</div>
			<ul class="work-grid">
				{work.map((w, i) => <li><WorkCard work={w} eager={i < 3} /></li>)}
			</ul>
		</div>
	</section>

	{
		steps.length > 0 && (
			<section class="section how" aria-labelledby="how-title">
				<div class="wrap how-grid">
					<figure class="how-figure">
						<img src="/images/study-sketches.webp" alt={photoAlt(null, "/images/study-sketches.webp")} width="672" height="1064" loading="lazy" />
					</figure>
					<div>
						<p class="eyebrow">How I work</p>
						<h2 id="how-title" class="display display-lg">A short path from question to release.</h2>
						<ol class="steps">
							{steps.map((s, i) => (
								<li>
									<span class="step-num">{String(i + 1).padStart(2, "0")}</span>
									<div>
										<h3>{s.data.title}</h3>
										{s.data.when_label && <p class="step-when">{s.data.when_label}</p>}
										<p>{s.data.text}</p>
										{s.data.output && <p class="step-out"><span>You get</span> {s.data.output}</p>}
									</div>
								</li>
							))}
						</ol>
					</div>
				</div>
			</section>
		)
	}

	{
		services.length > 0 && (
			<section class="section help" aria-labelledby="help-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">What I can help with</p>
							<h2 id="help-title" class="display display-lg">Where I'm most useful.</h2>
						</div>
					</div>
					<ul class="help-list">
						{services.map((s) => (
							<li>
								<a href={`/contact?service=${s.data.slug ?? s.data.id}`}>
									<span class="help-title">{s.data.title}</span>
									<span class="help-text">
										<span>{s.data.summary}</span>
										<span class="help-includes">{lines(s.data.includes).slice(0, 2).join(". ")}.</span>
									</span>
									<span class="help-ask">Ask about this<Arrow /></span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	{
		latestNotes.length > 0 && (
			<section class="section" aria-labelledby="notes-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">Latest notes</p>
							<h2 id="notes-title" class="display display-lg">Short notes on the work.</h2>
						</div>
						<a class="text-link" href="/notes"><span>All notes</span><Arrow /></a>
					</div>
					<ul class="note-grid">
						{latestNotes.map((n) => <li><NoteCard note={n} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	<ContactBand profile={profileResult.profile} />
</Base>
