---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<img class="notfound-photo" src="/images/study-olive.webp" alt="" width="594" height="1008" />
		<div class="notfound-copy">
			<p class="eyebrow">Error 404</p>
			<h1 id="nf-title" class="display display-xl">This page isn't here.</h1>
			<p class="lede">The page you were looking for has moved or never existed. Try one of these instead.</p>
			<div class="actions">
				<a class="btn btn-dark" href="/"><span>Back to home</span><Arrow /></a>
				<a class="pill" href="/work">Work</a>
				<a class="pill" href="/notes">Notes</a>
			</div>
		</div>
	</section>
</Base>
