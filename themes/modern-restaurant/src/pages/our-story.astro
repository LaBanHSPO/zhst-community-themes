---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Arrow from "../components/Arrow.astro";
import { getHighlights } from "../lib/montre";

// The story text lives in the CMS page with slug "our-story"; this route gives it the photographic layout.
const [{ entry: page, cacheHint }, highlightsResult] = await Promise.all([
	getEmDashEntry("pages", "our-story"),
	getHighlights("story"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(highlightsResult.cacheHint);
}
const values = highlightsResult.entries;
const heading = page?.data.title ?? "Our story";
const intro = page?.data.intro ?? null;
---

<Base
	title="Our Story"
	description={intro}
	content={page ? { collection: "pages", id: page.data.id, slug: "our-story" } : undefined}
>
	<PageHead
		id="story-title"
		eyebrow={page?.data.eyebrow ?? "Our story"}
		title={heading}
		intro={intro}
		image="/images/lounge.webp"
		titleAttrs={page?.edit.title}
	/>

	<section class="story" aria-label="How Montré began">
		<div class="story-text prose">
			{page?.data.content ? <PortableText value={page.data.content} /> : <p>Our story is being written.</p>}
		</div>
		<figure class="story-photos">
			<img src="/images/dining-room.webp" alt="The dining room at night with pendant lights over the tables" width="760" height="367" loading="lazy" />
			<img src="/images/wine-and-candle.webp" alt="A glass of white wine and a candle on black marble" width="328" height="540" loading="lazy" />
		</figure>
	</section>

	{
		values.length > 0 && (
			<section class="values" aria-labelledby="values-title">
				<span class="eyebrow">What we hold on to</span>
				<h2 id="values-title">Simple ingredients, exceptional experiences.</h2>
				<ul class="values-list">
					{values.map((v, i) => (
						<li>
							<span class="value-num" aria-hidden="true">0{i + 1}</span>
							<h3 {...v.edit.title}>{v.data.title}</h3>
							{v.data.text && <p>{v.data.text}</p>}
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="cta-band" aria-labelledby="story-cta">
		<h2 id="story-cta">Come and taste the season.</h2>
		<div class="actions">
			<a class="btn" href="/reserve">Reserve a table <Arrow /></a>
			<a class="text-link text-link-light" href="/menu">See the menu <Arrow /></a>
		</div>
	</section>
</Base>
