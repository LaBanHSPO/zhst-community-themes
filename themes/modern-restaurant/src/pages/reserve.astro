---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Arrow from "../components/Arrow.astro";
import { getHighlights, getHours, getVenue, mapLinks, telHref } from "../lib/montre";

const [{ venue, cacheHint }, notesResult, hoursResult] = await Promise.all([
	getVenue(),
	getHighlights("reserve"),
	getHours(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(notesResult.cacheHint);
	Astro.cache.set(hoursResult.cacheHint);
}
const notes = notesResult.entries;
const hours = hoursResult.entries;
const links = mapLinks(venue);

// Earliest selectable date is today in the site's timezone.
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Saigon" }).format(new Date());

const times: string[] = [];
for (let h = 17; h <= 21; h++) {
	for (const m of [0, 30]) {
		if (h === 17 && m === 0) continue;
		times.push(`${h - 12}:${m === 0 ? "00" : "30"} pm`);
	}
}
const sizes = ["1", "2", "3", "4", "5", "6"];
const seatings = ["Tasting menu", "À la carte", "Not sure yet"];
---

<Base title="Reserve a table" description="Request a table at Montré. We confirm every request by email or phone.">
	<PageHead
		id="reserve-title"
		eyebrow="Reserve a table"
		title="Save the evening."
		intro="Tell us when you would like to join us and we will confirm by email or phone. A request becomes a reservation once we reply."
		image="/images/scallops-plate.webp"
		compact
	/>

	<div class="reserve">
		<section class="reserve-form-wrap" aria-labelledby="form-title">
			<h2 id="form-title">Request a table</h2>
			<form
				class="reserve-form"
				data-reserve-form
				data-email={venue.email}
				action={venue.email ? `mailto:${venue.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field">
						<label for="r-date">Date</label>
						<input id="r-date" name="date" type="date" min={today} required aria-describedby="r-date-err" />
						<span class="field-error" id="r-date-err" data-error-for="r-date"></span>
					</div>
					<div class="field">
						<label for="r-time">Time</label>
						<select id="r-time" name="time" required>
							{times.map((t) => <option selected={t === "7:30 pm"}>{t}</option>)}
						</select>
					</div>
					<div class="field">
						<label for="r-party">Guests</label>
						<select id="r-party" name="party" required>
							{sizes.map((s) => <option selected={s === "2"}>{s}</option>)}
						</select>
					</div>
					<div class="field">
						<label for="r-menu">Menu</label>
						<select id="r-menu" name="menu">
							{seatings.map((s) => <option>{s}</option>)}
						</select>
					</div>
					<div class="field">
						<label for="r-name">Name</label>
						<input id="r-name" name="name" type="text" autocomplete="name" required aria-describedby="r-name-err" />
						<span class="field-error" id="r-name-err" data-error-for="r-name"></span>
					</div>
					<div class="field">
						<label for="r-email">Email</label>
						<input id="r-email" name="email" type="email" autocomplete="email" required aria-describedby="r-email-err" />
						<span class="field-error" id="r-email-err" data-error-for="r-email"></span>
					</div>
					<div class="field full">
						<label for="r-phone">Phone <span class="optional">(optional)</span></label>
						<input id="r-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field full">
						<label for="r-notes">Anything we should know? <span class="optional">(optional)</span></label>
						<textarea id="r-notes" name="notes" rows="3" placeholder="Allergies, an anniversary, a quiet corner…"></textarea>
					</div>
				</div>
				<button class="btn btn-lg" type="submit">Request a table <Arrow /></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{venue.email && <>Write to <a href={`mailto:${venue.email}`}>{venue.email}</a> with your date, time and number of guests.</>}
					</noscript>
				</p>
			</form>
		</section>

		<aside class="reserve-aside" aria-label="Contact and visit information">
			<div class="aside-block">
				<h2>Prefer to talk to us?</h2>
				<p>
					{venue.phone && <>Call <a href={telHref(venue.phone)}>{venue.phone}</a></>}
					{venue.phone && venue.email && " or email "}
					{!venue.phone && venue.email && "Email "}
					{venue.email && <a href={`mailto:${venue.email}`}>{venue.email}</a>}.
				</p>
				{venue.booking_note && <p class="small">{venue.booking_note}</p>}
			</div>
			<div class="aside-block" id="visit">
				<h2>Visit</h2>
				{
					(venue.street || venue.locality) && (
						<address>
							{venue.street && <>{venue.street}<br /></>}
							{venue.locality && <>{venue.locality}<br /></>}
							{venue.country}
						</address>
					)
				}
				<p class="aside-links">
					<a class="text-link" href={links.directions} target="_blank" rel="noopener noreferrer">
						Get directions<span class="sr-only"> (opens Google Maps in a new tab)</span> <Arrow />
					</a>
					<a class="text-link" href={links.map} target="_blank" rel="noopener noreferrer">
						View on map<span class="sr-only"> (opens Google Maps in a new tab)</span> <Arrow />
					</a>
				</p>
				{venue.getting_here && <p class="small">{venue.getting_here}</p>}
			</div>
			{
				hours.length > 0 && (
					<div class="aside-block">
						<h2>Opening hours</h2>
						<dl class="hours-list">
							{hours.map((h) => (
								<div>
									<dt>{h.data.title}</dt>
									<dd>{h.data.hours}</dd>
								</div>
							))}
						</dl>
					</div>
				)
			}
		</aside>
	</div>

	{
		notes.length > 0 && (
			<section class="reserve-notes" aria-labelledby="notes-title">
				<h2 id="notes-title" class="sr-only">Good to know</h2>
				<ul>
					{notes.map((n) => (
						<li>
							<h3 {...n.edit.title}>{n.data.title}</h3>
							{n.data.text && <p>{n.data.text}</p>}
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>

<script>
	// Compose a table-request email; the restaurant confirms it by reply. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-reserve-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | null = null;
			form.querySelectorAll<HTMLInputElement>("input[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? "Please fill this in."
						: input.type === "email"
							? "Please enter a valid email address."
							: input.type === "date"
								? "Please choose today or a later date."
								: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLInputElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online requests are not available right now. Please call the restaurant.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Table request: ${get("party")} guests on ${get("date")} at ${get("time")}`;
			const lines = [
				"Hello,",
				"",
				"I would like to request a table:",
				`Date: ${get("date")}`,
				`Time: ${get("time")}`,
				`Guests: ${get("party")}`,
				`Menu: ${get("menu")}`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("notes") ? `Notes: ${get("notes")}` : "",
				"",
				"I understand the table is confirmed only once you reply.",
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this request ready to send. It is only sent when you send that email, and we confirm by reply. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
