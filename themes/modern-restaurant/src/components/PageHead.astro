---
/** Dark photographic page header used by the inner pages (the site header floats over it). */
interface Props {
	eyebrow?: string | null;
	title: string;
	intro?: string | null;
	image?: string;
	id?: string;
	compact?: boolean;
	/** Visual-editing attributes for the title (from `entry.edit.title`). */
	titleAttrs?: Record<string, unknown>;
}
const { eyebrow, title, intro, image, id = "page-title", compact = false, titleAttrs = {} } = Astro.props;
---

<section class:list={["page-head", { "has-photo": image, "is-compact": compact }]} aria-labelledby={id}>
	{image && <img class="page-head-bg" src={image} alt="" width="1448" height="700" fetchpriority="high" />}
	<div class="page-head-inner">
		{eyebrow && <span class="eyebrow">{eyebrow}</span>}
		<h1 id={id} {...titleAttrs}>{title}</h1>
		{intro && <p class="page-head-intro">{intro}</p>}
		<slot />
	</div>
</section>
