---
/** Wordmark: the site name in wide-tracked serif capitals, the tagline in small tracked sans capitals below. */
interface Props {
	title: string;
	tagline?: string;
	logo?: { url?: string; alt?: string } | null;
	class?: string;
}
const { title, tagline, logo, class: className } = Astro.props;
---

<a class:list={["wordmark", className]} href="/" aria-label={`${title} — home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt || title} />
		) : (
			<>
				<span class="wordmark-main">{title}</span>
				{tagline && <span class="wordmark-sub">{tagline}</span>}
			</>
		)
	}
</a>
