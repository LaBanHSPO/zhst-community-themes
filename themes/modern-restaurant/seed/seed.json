	"content": {
		"pages": [
			{
				"id": "our-story",
				"slug": "our-story",
				"status": "published",
				"data": {
					"title": "Thoughtful food for meaningful moments.",
					"eyebrow": "Our story",
					"intro": "Montré is a forty-seat dining room built around one long kitchen counter, a short seasonal menu and the belief that a good evening is mostly about the people at the table.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "b0",
							"children": [
								{
									"_type": "span",
									"text": "Montré began as a series of supper evenings in a borrowed wine cellar. A cook, a sommelier and twelve guests a night, one menu, no choices, just whatever the growers and fishermen had brought in that morning, cooked carefully and served slowly.",
									"_key": "b0s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b1",
							"children": [
								{
									"_type": "span",
									"text": "When the old print works on Linden Row came up for lease, we kept what we loved about those evenings: low light, unhurried service and a kitchen you can see from every seat. Dark oak, black marble and a little candlelight do the rest.",
									"_key": "b1s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"style": "h2",
							"_key": "b2",
							"children": [
								{
									"_type": "span",
									"text": "How we cook",
									"_key": "b2s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b3",
							"children": [
								{
									"_type": "span",
									"text": "We work with a small circle of farms, a day-boat fisherman and one cheesemaker. The menu changes as their harvests do, so a dish may run for three weeks or three days. We cure, ferment and bake in house, and we waste as little as we can.",
									"_key": "b3s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"style": "h2",
							"_key": "b4",
							"children": [
								{
									"_type": "span",
									"text": "How we host",
									"_key": "b4s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b5",
							"children": [
								{
									"_type": "span",
									"text": "Our tasting menu runs to seven courses and about two and a half hours. If you would rather choose for yourself, the à la carte menu is served at the counter and in the lounge. Either way, tell us what you love and what you avoid. We would rather adjust a plate than have you leave anything behind.",
									"_key": "b5s"
								}
							],
							"markDefs": []
						}
					]
				}
			},
			{
				"id": "private-dining",
				"slug": "private-dining",
				"status": "published",
				"data": {
					"title": "Private dining",
					"eyebrow": "Gatherings",
					"intro": "The cellar room seats up to sixteen guests at one table, for birthdays, quiet celebrations and long business dinners.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "b0",
							"children": [
								{
									"_type": "span",
									"text": "The cellar room sits below the main dining room, behind a wall of wine. It has its own entrance, its own service team and a sound system you can switch off.",
									"_key": "b0s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b1",
							"children": [
								{
									"_type": "span",
									"text": "We plan each private dinner with you: a tasting menu written for your table, a pairing chosen by our sommelier and, if you like, a short welcome from the kitchen. Room hire is included when the minimum spend is met.",
									"_key": "b1s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"style": "h2",
							"_key": "b2",
							"children": [
								{
									"_type": "span",
									"text": "Planning your evening",
									"_key": "b2s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b3",
							"children": [
								{
									"_type": "span",
									"text": "Send us your preferred date, the number of guests and any dietary needs. We reply within two working days with menus and availability. Dates in December fill early, so please write well ahead.",
									"_key": "b3s"
								}
							],
							"markDefs": []
						}
					]
				}
			},
			{
				"id": "allergies",
				"slug": "allergies",
				"status": "published",
				"data": {
					"title": "Allergies & dietary needs",
					"eyebrow": "Good to know",
					"intro": "Almost every dish can be adapted. Tell us when you request your table and remind your server on the night.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "b0",
							"children": [
								{
									"_type": "span",
									"text": "Our kitchen handles nuts, gluten, dairy, shellfish and other common allergens every day. We take great care to keep dishes separate, but we cannot promise that any dish is entirely free of traces.",
									"_key": "b0s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b1",
							"children": [
								{
									"_type": "span",
									"text": "Vegetarian and pescatarian versions of the tasting menu are always available. For vegan, gluten-free or other needs, please let us know at least two days ahead so we can plan properly.",
									"_key": "b1s"
								}
							],
							"markDefs": []
						}
					]
				}
			}
		],
