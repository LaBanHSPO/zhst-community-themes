---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import PageHead from "../components/PageHead.astro";
import RecipeCard from "../components/RecipeCard.astro";
import StoryCard from "../components/StoryCard.astro";
import { COLLECTIONS, collectionLabel, countWord, courseName, getRecipes, getStories, plainText, recipesHref } from "../lib/food";

const [recipesResult, storiesResult] = await Promise.all([getRecipes(), getStories()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(recipesResult.cacheHint);
	Astro.cache.set(storiesResult.cacheHint);
}
const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 100);
const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
const recipeHay = (r: (typeof recipesResult.entries)[number]) =>
	[r.data.title, r.data.summary, r.data.ingredients, collectionLabel(r.data.collection), courseName(r.data.course)].join(" ").toLowerCase();
const storyHay = (s: (typeof storiesResult.entries)[number]) =>
	[s.data.title, s.data.summary, plainText(s.data.content)].join(" ").toLowerCase();
// Every word must appear in the recipe (title, ingredients, collection) or in the story (title, summary, text).
const recipes = terms.length === 0 ? [] : recipesResult.entries.filter((r) => terms.every((t) => recipeHay(r).includes(t)));
const stories = terms.length === 0 ? [] : storiesResult.entries.filter((s) => terms.every((t) => storyHay(s).includes(t)));
const total = recipes.length + stories.length;
---

<Base
	title={q ? `Search: ${q}` : "Search"}
	description="Search Food Journal recipes by title or ingredient, and stories by title or text."
	current="/search"
>
	<PageHead id="search-title" eyebrow="Search" title="Find a recipe or a story." />

	<section class="search-panel" aria-labelledby="search-title">
		<div class="wrap">
			<form class="search-form" action="/search" method="get" role="search">
				<label class="sr-only" for="q">Search recipes and stories</label>
				<input id="q" name="q" type="search" value={q} placeholder="A dish, an ingredient or a word" autocomplete="off" />
				<button class="btn btn-solid" type="submit"><span>Search</span><Arrow /></button>
			</form>

			{
				q && (
					<p class="search-count" role="status">
						{total === 0
							? `Nothing matches "${q}".`
							: `${countWord(recipes.length, "recipe", "recipes")} and ${countWord(stories.length, "story", "stories")} for "${q}".`}
					</p>
				)
			}

			{
				recipes.length > 0 && (
					<div class="search-group">
						<h2 class="eyebrow"><span class="rule" aria-hidden="true"></span>Recipes</h2>
						<ul class="recipe-grid recipe-grid-list">
							{recipes.map((r) => <li><RecipeCard recipe={r.data} facts /></li>)}
						</ul>
					</div>
				)
			}

			{
				stories.length > 0 && (
					<div class="search-group">
						<h2 class="eyebrow"><span class="rule" aria-hidden="true"></span>Stories</h2>
						<ul class="story-grid">
							{stories.map((s) => <li><StoryCard story={s.data} /></li>)}
						</ul>
					</div>
				)
			}

			{
				(!q || total === 0) && (
					<div class="search-hint">
						<p class="eyebrow">{q ? "Try a collection instead" : "Or browse by collection"}</p>
						<ul class="filters">
							{COLLECTIONS.map((c) => <li><a class="chip" href={recipesHref({ collection: c.value })}>{c.label}</a></li>)}
						</ul>
					</div>
				)
			}
		</div>
	</section>
</Base>
