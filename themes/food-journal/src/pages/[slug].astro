---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import PageHead from "../components/PageHead.astro";
import { photoAlt } from "../lib/food";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? page.data.intro}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<PageHead eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro} edit={{ ...page.edit.title }} />
	{
		slug === "about" && (
			<figure class="about-photo">
				<img src="/images/basil-oil.webp" alt={photoAlt(null, "/images/basil-oil.webp")} width="700" height="470" fetchpriority="high" />
				<figcaption>The windowsill where the basil lives.</figcaption>
			</figure>
		)
	}
	<div class="page-body">
		<div class="prose">
			<PortableText value={page.data.content} />
		</div>
		<p class="page-cta"><a class="btn btn-solid" href="/contact"><span>Write to me</span><Arrow /></a></p>
	</div>
</Base>
