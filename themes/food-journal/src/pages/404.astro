---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<img class="notfound-photo" src="/images/basil-oil.webp" alt="" width="700" height="470" />
		<div class="notfound-copy">
			<p class="eyebrow"><span class="rule" aria-hidden="true"></span>Error 404</p>
			<h1 id="nf-title" class="display display-xl">This page is not on the table.</h1>
			<p class="lede">The page you are looking for has moved or never existed. Here are a few places to start again.</p>
			<div class="actions">
				<a class="btn btn-solid" href="/"><span>Back to home</span><Arrow /></a>
				<a class="pill" href="/recipes">Recipes</a>
				<a class="pill" href="/stories">Stories</a>
				<a class="pill" href="/search">Search</a>
			</div>
		</div>
	</section>
</Base>
