---
import { getEmDashCollection, getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/inter";
import "@fontsource/la-belle-aurore";
import Logo from "../components/Logo.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getWriter, telHref } from "../lib/journal";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Header sits transparently over the page's first (photographic) section. */
	overlay?: boolean;
	/** Force which primary-menu URL is marked current. */
	current?: string;
}

const { title, pageTitle, description, image, canonical, content, overlay = false, current } = Astro.props;
const [settingsResult, menuResult, writerResult, pagesResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getWriter(),
	getEmDashCollection("pages", { limit: 20 }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(writerResult.cacheHint);
	Astro.cache.set(pagesResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName = title === siteTitle || title.endsWith(` | ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} | ${siteTitle}`;
const pageDescription = description ?? `${siteTitle}: ${siteTagline}`;
const navItems = menuResult.data?.items ?? [];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const norm = (url: string) => url.replace(/\/$/, "") || "/";
const { writer } = writerResult;
// CMS pages that are not in the primary menu are linked from the footer.
const menuUrls = new Set(navItems.map((i) => norm(i.url)));
const extraPages = pagesResult.entries
	.map((p) => ({ url: `/${p.data.slug ?? p.data.id}`, label: p.data.eyebrow || p.data.title }))
	.filter((p) => !menuUrls.has(p.url));

const currentUrl =
	current ??
	navItems.find((i) => norm(i.url) === path)?.url ??
	navItems.find((i) => norm(i.url) !== "/" && path.startsWith(`${norm(i.url)}/`))?.url;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Intl.DateTimeFormat("en-GB", { year: "numeric", timeZone: "Asia/Saigon" }).format(new Date());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class:list={["site-head", { "is-overlay": overlay }]}>
			<div class="head-inner">
				<Logo title={siteTitle} tagline={siteTagline} logo={siteLogo} class="head-logo" />
				<div class="head-right">
					<nav class="nav" aria-label="Primary">
						{
							navItems.map((item) => (
								<a
									href={item.url}
									target={item.target}
									rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
									aria-current={item.url === currentUrl ? "page" : undefined}
								>
									{item.label}
								</a>
							))
						}
					</nav>
					<a class="search-link" href="/search" aria-label="Search the journal">
						<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
							<circle cx="8.500" cy="8.500" r="6" fill="none" stroke="currentColor" stroke-width="1.4" />
							<path d="M13 13l5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
						</svg>
					</a>
					<details class="mobile-nav">
						<summary aria-label="Menu">
							<svg class="burger" width="22" height="14" viewBox="0 0 22 14" aria-hidden="true" focusable="false">
								<path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.5" />
							</svg>
							<svg class="close" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
								<path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.5" />
							</svg>
						</summary>
						<nav class="mobile-panel" aria-label="Primary (mobile)">
							{
								navItems.map((item) => (
									<a href={item.url} aria-current={item.url === currentUrl ? "page" : undefined}>
										{item.label}
									</a>
								))
							}
							<a href="/search" aria-current={path === "/search" ? "page" : undefined}>Search</a>
							<a href="/contact" aria-current={path === "/contact" ? "page" : undefined}>Contact</a>
							{writer.email && <a class="mobile-email" href={`mailto:${writer.email}`}>{writer.email}</a>}
						</nav>
					</details>
				</div>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="foot-inner">
				<div class="foot-brand">
					<Logo title={siteTitle} tagline={siteTagline} logo={siteLogo} />
					<p>Personal notes from the road, written slowly and read on a quiet afternoon.</p>
				</div>
				<div>
					<h2>Explore</h2>
					<ul class="foot-links">
						{navItems.map((item) => <li><a href={item.url}>{item.label}</a></li>)}
						<li><a href="/search">Search</a></li>
						<li><a href="/contact">Contact</a></li>
						{extraPages.map((p) => <li><a href={p.url}>{p.label}</a></li>)}
					</ul>
				</div>
				<div class="foot-contact">
					<h2>Write to me</h2>
					{writer.email && <a href={`mailto:${writer.email}`}>{writer.email}</a>}
					{writer.phone && <a href={telHref(writer.phone)}>{writer.phone}</a>}
					{writer.base && <span>Writing from {writer.base}</span>}
				</div>
			</div>
			<div class="foot-bottom">
				<span>© {year} {writer.title || siteTitle}</span>
				<span>Built with EmDash</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
