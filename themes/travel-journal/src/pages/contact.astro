---
import Base from "../layouts/Base.astro";
import { getWriter, telHref } from "../lib/journal";

const { writer, cacheHint } = await getWriter();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const topics = [
	{ value: "note", label: "A note about a post", subject: "A note about a post" },
	{ value: "collaboration", label: "A collaboration or guest post", subject: "Collaboration idea" },
	{ value: "newsletter", label: "New posts by email", subject: "Please send me new posts" },
	{ value: "other", label: "Something else", subject: "A message for the journal" },
];
// ?topic=<value> pre-selects a topic (links from the homepage and footer).
const wanted = Astro.url.searchParams.get("topic");
const selected = topics.find((t) => t.value === wanted);
---

<Base title="Contact" description="Write to the Travel Journal about a post, a collaboration idea or getting new posts by email. Every message is read by the writer.">
	<div class="contact">
		<aside class="contact-aside">
			<img
				src="/images/cup-blanket.webp"
				alt="A leather journal and brass compass on a striped blanket beside an enamel mug"
				width="640"
				height="640"
			/>
			<div class="contact-details">
				<h2>Prefer to write directly?</h2>
				<p>
					{writer.email && <a href={`mailto:${writer.email}`}>{writer.email}</a>}
					{writer.phone && <a href={telHref(writer.phone)}>{writer.phone}</a>}
				</p>
				{writer.response && <p class="small">{writer.response}</p>}
				{writer.contact_note && <p class="small">{writer.contact_note}</p>}
			</div>
		</aside>

		<section class="contact-panel" aria-labelledby="contact-title">
			<p class="eyebrow">Contact</p>
			<h1 id="contact-title" class="display display-xl">Write to me.</h1>
			<p class="lede">
				A note about something I wrote, an idea for working together, or a request to get new posts by email. Choose a topic and say a little about it.
			</p>

			<form
				class="contact-form"
				data-contact-form
				data-email={writer.email}
				action={writer.email ? `mailto:${writer.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field">
						<label for="c-name">Your name</label>
						<input id="c-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="c-name"></span>
					</div>
					<div class="field">
						<label for="c-email">Email</label>
						<input id="c-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="c-email"></span>
					</div>
					<div class="field full">
						<label for="c-topic">Topic</label>
						<select id="c-topic" name="topic" required>
							<option value="" selected={!selected}>Choose a topic</option>
							{topics.map((t) => <option value={t.value} data-subject={t.subject} selected={selected?.value === t.value}>{t.label}</option>)}
						</select>
						<span class="field-error" data-error-for="c-topic"></span>
					</div>
					<div class="field full">
						<label for="c-post">Post or place <span class="optional">(optional)</span></label>
						<input id="c-post" name="post" type="text" placeholder="e.g. Finding Stillness in Banff" />
					</div>
					<div class="field full">
						<label for="c-message">Your message</label>
						<textarea id="c-message" name="message" rows="5" placeholder="What you read, where you are going, or what you have in mind..." required></textarea>
						<span class="field-error" data-error-for="c-message"></span>
					</div>
				</div>
				<button class="btn btn-solid btn-block" type="submit"><span>Send message</span></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{writer.email && <>Write to <a href={`mailto:${writer.email}`}>{writer.email}</a> and say what it is about.</>}
					</noscript>
				</p>
			</form>
		</section>
	</div>
</Base>

<script>
	// Compose an email to the writer; nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online messages are not available right now. Please try again later.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const select = form.querySelector<HTMLSelectElement>("#c-topic");
			const subjectLabel = select?.selectedOptions[0]?.dataset.subject ?? "A message for the journal";
			const subject = `${subjectLabel}: ${get("name")}`;
			const body = [
				"Hello,",
				"",
				`Topic: ${select?.selectedOptions[0]?.textContent ?? ""}`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("post") ? `Post or place: ${get("post")}` : "",
				"",
				get("message"),
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body.join("\n"))}`;
			status.textContent =
				"Your email app should open with this message ready to send. It is only sent when you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
