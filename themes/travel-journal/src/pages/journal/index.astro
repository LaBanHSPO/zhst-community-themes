---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import PageHead from "../../components/PageHead.astro";
import PostCard from "../../components/PostCard.astro";
import ContactBand from "../../components/ContactBand.astro";
import { buildRegions, getDestinations, getPosts, getWriter, journalHref, slugify } from "../../lib/journal";

const PAGE_SIZE = 6;
const [postsResult, destResult, writerResult] = await Promise.all([getPosts(), getDestinations(), getWriter()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(postsResult.cacheHint);
	Astro.cache.set(destResult.cacheHint);
	Astro.cache.set(writerResult.cacheHint);
}
const all = postsResult.entries;
const regions = buildRegions(destResult.entries, all);
const params = Astro.url.searchParams;
const region = regions.find((r) => r.slug === params.get("region"));
const destination = destResult.entries.find((d) => slugify(d.data.title) === params.get("destination"));
const filtered = all.filter(
	(p) =>
		(!region || p.data.region === region.name) && (!destination || p.data.destination === destination.data.title),
);
const pages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
const page = Math.min(pages, Math.max(1, Number.parseInt(params.get("page") ?? "1", 10) || 1));
const posts = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const filterQuery = { region: region?.slug, destination: destination ? slugify(destination.data.title) : undefined };
const heading = destination ? destination.data.title : region ? region.name : "Every post, newest first.";
---

<Base
	title={destination ? `${destination.data.title} | Journal` : region ? `${region.name} | Journal` : "Journal"}
	description="Every post from the travel journal: coastal towns, mountain lakes, lantern-lit streets and notes on slow travel. Filter by region."
	current="/journal"
>
	<PageHead
		id="journal-title"
		eyebrow={destination || region ? "Journal" : "The journal"}
		title={heading}
		intro={destination?.data.note ?? "Personal notes from places I have stayed in, with photographs and a few plain tips."}
	/>

	<section class="journal-list" aria-labelledby="journal-title">
		<div class="wrap">
			<nav class="filters" aria-label="Filter by region">
				<a class="chip" href="/journal" aria-current={!region && !destination ? "true" : undefined}>All<span>{all.length}</span></a>
				{
					regions.map((r) => (
						<a class="chip" href={journalHref({ region: r.slug })} aria-current={region?.slug === r.slug && !destination ? "true" : undefined}>
							{r.name}
							<span>{r.count}</span>
						</a>
					))
				}
			</nav>

			{
				posts.length === 0 ? (
					<p class="empty-note">Nothing here yet. <a href="/journal">See every post</a>.</p>
				) : (
					<ul class="post-grid">
						{posts.map((p) => (
							<li>
								<PostCard post={p.data} edit={{ ...p.edit.title }} meta />
							</li>
						))}
					</ul>
				)
			}

			{
				pages > 1 && (
					<nav class="pager" aria-label="Pagination">
						{page > 1 ? (
							<a class="text-link text-link-back" href={journalHref({ ...filterQuery, page: page - 1 })}>
								<Arrow />
								<span>Newer posts</span>
							</a>
						) : (
							<span />
						)}
						<span class="pager-count">Page {page} of {pages}</span>
						{page < pages ? (
							<a class="text-link" href={journalHref({ ...filterQuery, page: page + 1 })}>
								<span>Older posts</span>
								<Arrow />
							</a>
						) : (
							<span />
						)}
					</nav>
				)
			}
		</div>
	</section>

	<ContactBand writer={writerResult.writer} />
</Base>
