---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Logo from "../components/Logo.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getLaunch } from "../lib/firstlight";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Force which primary-menu URL is marked current. */
	current?: string;
}

const { title, pageTitle, description, image, canonical, content, current } = Astro.props;
const [settingsResult, menuResult, launchResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getLaunch(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(launchResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menuItems = menuResult.data?.items ?? [];
const { launch } = launchResult;

const norm = (url: string) => url.replace(/[?#].*$/, "").replace(/\/$/, "") || "/";
const firstSegment = (url: string) => norm(url).split("/")[1] ?? "";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
// Exact match first; otherwise the menu item in the same section (e.g. /roadmap/x -> Public roadmap).
const currentUrl =
	current ??
	menuItems.find((i) => norm(i.url) === path)?.url ??
	(path === "/" ? undefined : menuItems.find((i) => norm(i.url) !== "/" && firstSegment(i.url) === firstSegment(path))?.url);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Intl.DateTimeFormat("en-GB", { year: "numeric", timeZone: "Asia/Saigon" }).format(new Date());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#03182f" />
		<title>{fullTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-head">
			<div class="container head-inner">
				<a class="wordmark" href="/" aria-label={`${siteTitle} — prelaunch home`}>
					{
						siteLogo ? (
							<img class="wordmark-img" src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						) : (
							<>
								<Logo />
								<span class="wordmark-name">{siteTitle}</span>
							</>
						)
					}
				</a>
				<nav class="nav" aria-label="Primary">
					{
						menuItems.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={item.url === currentUrl ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<details class="mobile-nav">
					<summary>
						<svg width="22" height="14" viewBox="0 0 22 14" aria-hidden="true" focusable="false">
							<path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="2"></path>
						</svg>
						<span>Menu</span>
					</summary>
					<nav class="mobile-panel" aria-label="Primary (mobile)">
						{
							menuItems.map((item) => (
								<a href={item.url} aria-current={item.url === currentUrl ? "page" : undefined}>
									{item.label}
								</a>
							))
						}
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="container foot-inner">
				<div class="foot-brand">
					<a class="wordmark" href="/">
						<Logo size={34} />
						<span class="wordmark-name">{siteTitle}</span>
					</a>
					{launch.footer_blurb && <p>{launch.footer_blurb}</p>}
				</div>
				<nav class="foot-nav" aria-label="Footer">
					{menuItems.map((item) => <a href={item.url}>{item.label}</a>)}
					<a href="/privacy">How we handle your email</a>
				</nav>
			</div>
			<div class="container foot-bottom">
				<span>© {year} {siteTitle}. Prelaunch — no launch date announced yet.</span>
				{launch.email && <a href={`mailto:${launch.email}`}>{launch.email}</a>}
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
