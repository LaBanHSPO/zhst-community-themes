---
import Icon from "./Icon.astro";
import type { Feature } from "../lib/firstlight";

interface Props {
	features: { data: Feature }[];
	label: string;
	divided?: boolean;
}
const { features, label, divided = false } = Astro.props;
---

{
	features.length > 0 && (
		<section class:list={["band", { "band-divided": divided }]} aria-label={label}>
			<ul class="container band-grid">
				{features.map((f) => (
					<li class="band-item">
						<Icon name={f.data.icon} size={42} class="band-icon" />
						<h2 class="band-title">{f.data.title}</h2>
						<p>{f.data.text}</p>
					</li>
				))}
			</ul>
		</section>
	)
}
