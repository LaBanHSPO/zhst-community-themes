---
/** Inline line icons (stroke = currentColor). Decorative unless a label is given. */
interface Props {
	name: string;
	size?: number;
	label?: string;
	class?: string;
}
const { name, size = 24, label, class: className } = Astro.props;

const paths: Record<string, string> = {
	sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/>',
	leaf: '<path d="M20 4C9 4 4 9.5 4 16c0 1.4.3 2.6.8 3.6C11.5 19.5 20 15 20 4Z"/><path d="M4.8 19.6C8 15 11.5 12 15.5 9.5"/>',
	bars: '<path d="M5 20v-7M10 20V7M15 20v-9.5M20 20v-5" stroke-width="2.8"/>',
	mail: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.8 6.6 8.2 6.2 8.2-6.2"/>',
	rocket: '<path d="M14.5 4.5c2.5-1 4.6-1.2 5.6-1.1.1 1-.1 3.1-1.1 5.6-1.3 3.2-4.4 6.2-7.6 7.6l-3.9-3.9c1.4-3.2 4.4-6.3 7-8.2Z"/><circle cx="15" cy="9" r="1.6"/><path d="M8.6 12.3 5 11.6l2.6-3.2 3.4.2M11.7 15.4l.7 3.6 3.2-2.6-.2-3.4M7.5 16.5c-1.7.3-2.8 1.4-3 4 2.6-.2 3.7-1.3 4-3"/>',
	arrow: '<path d="M4.5 12h14.5M13.5 6.5 19 12l-5.5 5.5"/>',
	check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
	copy: '<rect x="8.5" y="8.5" width="11" height="12" rx="2"/><path d="M15.5 8.5V5.5a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h2"/>',
	plus: '<path d="M12 5v14M5 12h14"/>',
	"plus-circle": '<circle cx="12" cy="12" r="9.2"/><path d="M12 7.8v8.4M7.8 12h8.4"/>',
	play: '<path d="M8.5 5.5v13l10-6.5-10-6.5Z" fill="currentColor" stroke="none"/>',
	clock: '<circle cx="12" cy="13" r="7.5"/><path d="M12 9.5V13l2.2 1.6M10 2.8h4"/>',
	home: '<path d="M4 10.5 12 4l8 6.5V20h-5.5v-5.5h-5V20H4Z"/>',
	calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>',
	circle: '<circle cx="12" cy="12" r="8"/>',
	note: '<path d="M6 3.5h8.5L19 8v12.5H6Z"/><path d="M14 3.5V8.5h5M9 12.5h7M9 16h7"/>',
	settings: '<circle cx="12" cy="12" r="3"/><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M5.5 18.5l1.7-1.7M16.8 7.2l1.7-1.7"/><circle cx="12" cy="12" r="6.4"/>',
	chevron: '<path d="m9.5 6 6 6-6 6"/>',
	progress: '<path d="M12 3.5a8.5 8.5 0 1 1-8.1 11" stroke-width="2.6"/><path d="M4.6 9.2a8.5 8.5 0 0 1 3-4" stroke-width="2.6" opacity=".55"/>',
	send: '<path d="M21 3 10.5 13.5M21 3l-6.5 18-4-7.5L3 9.5 21 3Z"/>',
};
const body = paths[name] ?? paths.sun;
---

<svg
	class:list={["icon", className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
	focusable="false"
	set:html={body}
/>
