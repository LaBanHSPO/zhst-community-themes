---
import Icon from "./Icon.astro";

/**
 * Email + Join waitlist pill. Submitting opens the visitor's email app with a waitlist request
 * addressed to the launch contact email; nothing is sent by the site itself.
 */
interface Props {
	id: string;
	email: string;
	size?: "lg" | "md";
	note?: string | null;
	class?: string;
}
const { id, email, size = "lg", note, class: className } = Astro.props;
const subject = "Join the Firstlight waitlist";
const fallback = `mailto:${email}?subject=${encodeURIComponent(subject)}`;
---

<form
	class:list={["waitlist", `waitlist-${size}`, className]}
	id={id}
	data-waitlist
	data-email={email}
	data-subject={subject}
	action={email ? fallback : undefined}
	method="post"
	enctype="text/plain"
	novalidate
>
	<div class="waitlist-pill">
		<label class="sr-only" for={`${id}-email`}>Email address</label>
		<input
			id={`${id}-email`}
			name="email"
			type="email"
			autocomplete="email"
			placeholder="Enter your email address"
			required
			aria-describedby={`${id}-status`}
		/>
		<button class="btn btn-lime" type="submit">Join waitlist <Icon name="arrow" size={20} /></button>
	</div>
	{note && <p class="waitlist-note">{note}</p>}
	<p class="waitlist-status" id={`${id}-status`} role="status" aria-live="polite" data-status></p>
	<noscript>
		<p class="waitlist-note">Without JavaScript, the button opens an email to <a href={`mailto:${email}`}>{email}</a>. Put your address in it and send.</p>
	</noscript>
</form>

<script>
	// Waitlist: validates the address, then opens the visitor's email app with a pre-filled request.
	// The site itself sends nothing, so the status message never claims the visitor is on the list.
	document.querySelectorAll<HTMLFormElement>("form[data-waitlist]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		const input = form.querySelector<HTMLInputElement>("input[type=email]");
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!status || !input) return;
			status.textContent = "";
			if (!input.checkValidity()) {
				input.setAttribute("aria-invalid", "true");
				status.textContent = input.value.trim() ? "Please enter a valid email address, like name@example.com." : "Please enter your email address.";
				input.focus();
				return;
			}
			input.removeAttribute("aria-invalid");
			const to = form.dataset.email ?? "";
			if (!to) {
				status.textContent = "The waitlist is not open yet. Please check back soon.";
				return;
			}
			const address = input.value.trim();
			const body = [
				"Hello Firstlight,",
				"",
				"Please add me to the Firstlight waitlist.",
				"",
				`Email: ${address}`,
				"",
				"I'd like to hear about: product launch and early access, feature updates and tips.",
				"",
			].join("\n");
			window.location.href = `mailto:${to}?subject=${encodeURIComponent(form.dataset.subject ?? "Firstlight waitlist")}&body=${encodeURIComponent(body)}`;
			status.textContent = "Your email app should open with a waitlist request. Send it and we’ll add you, then reply to confirm. ";
			const next = document.createElement("a");
			next.href = "/confirmation";
			next.textContent = "What happens next";
			const alt = document.createElement("a");
			alt.href = `mailto:${to}`;
			alt.textContent = to;
			status.append(next, ". Nothing opened? Write to ", alt, ".");
		});
	});
</script>
