---
/** Firstlight sunrise mark: half sun with rays over a horizon line. */
interface Props {
	size?: number;
}
const { size = 40 } = Astro.props;
---

<svg class="logo-mark" width={size} height={Math.round(size * 0.7)} viewBox="0 0 40 28" fill="none" aria-hidden="true" focusable="false">
	<g stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
		<path d="M10.5 22a9.5 9.5 0 0 1 19 0" />
		<path d="M20 2v4.5M8.2 6.6l2.6 3M31.8 6.6l-2.6 3M2.5 15.2l3.6 1.3M37.5 15.2l-3.6 1.3" />
		<path d="M3 26h34" />
	</g>
</svg>
