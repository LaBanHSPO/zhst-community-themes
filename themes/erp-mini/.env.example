# Local development only. Copy to .env; never commit the populated .env.
# Build-time origin also determines EmDash's passkey RP ID (localhost here).
EMDASH_SITE_URL=http://localhost:4321
ERP_CURRENCY=USD
# Selected at build time; relative paths resolve from the runtime working directory.
ERP_DATA_DIR=.local
HOST=127.0.0.1
PORT=4321
# Run npm run secrets:generate to populate .env with a unique key.
EMDASH_ENCRYPTION_KEY=
