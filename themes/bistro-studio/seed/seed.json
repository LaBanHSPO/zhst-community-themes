				"status": "published",
				"data": {
					"name": "Grilled peach salad",
					"description": "Charred peaches, whipped ricotta, mint, toasted almonds.",
					"price": "$12",
					"category": "starters",
					"available": true
				}
			},
			{
				"id": "menu-2",
				"slug": "braised-short-rib",
				"status": "published",
				"data": {
					"name": "Braised short rib",
