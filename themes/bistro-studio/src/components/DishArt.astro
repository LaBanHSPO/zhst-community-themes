---
/**
 * Decorative dish illustration for menu cards. The menu collection has no
 * image field, so each card gets an SVG plate tinted by the dish category.
 */
interface Props {
	category?: string | null;
	variant?: number;
}
const { category, variant = 0 } = Astro.props;
const kind = (category ?? "").toLowerCase().trim();

const palettes: Record<string, { base: string; accent: string; leaf: string; bg: string }> = {
	starters: { base: "#7aa34a", accent: "#e8946a", leaf: "#3f6a25", bg: "#e9dcc4" },
	mains: { base: "#b9773f", accent: "#cf4a2c", leaf: "#4d7a2b", bg: "#e4d3b8" },
	desserts: { base: "#d9b989", accent: "#5a3420", leaf: "#6b8a3a", bg: "#ead9c0" },
	drinks: { base: "#f2d46b", accent: "#f7efc9", leaf: "#6b9a3a", bg: "#e6dcc6" },
};
const p = palettes[kind] ?? { base: "#c9a26a", accent: "#b5523a", leaf: "#4d6b2b", bg: "#e8dcc7" };
const tilt = [-12, 8, -4, 14][variant % 4];
---

<svg class="dish-art" viewBox="0 0 240 150" aria-hidden="true" focusable="false">
	<rect width="240" height="150" fill={p.bg} />
	<path d="M0 118c50-14 120-18 240-6v38H0Z" fill="#5a3a22" opacity="0.18" />
	{kind === "drinks" ? (
		<g transform={`rotate(${tilt / 3} 120 80)`}>
			<ellipse cx="124" cy="132" rx="46" ry="8" fill="#2c1a0c" opacity="0.25" />
			<path d="M92 28h56l-6 98a8 8 0 0 1-8 7h-28a8 8 0 0 1-8-7Z" fill="#fff8e8" opacity="0.6" stroke="#c9b48f" />
			<path d="M96 56h48l-4 70a6 6 0 0 1-6 5h-28a6 6 0 0 1-6-5Z" fill={p.base} opacity="0.85" />
			<circle cx="134" cy="48" r="16" fill="#f4e27a" stroke="#d8b84a" stroke-width="3" />
			<path d="M134 34v28M120 48h28" stroke="#d8b84a" stroke-width="1.5" />
			<path d="M108 20c10 8 12 20 6 34" stroke={p.leaf} stroke-width="5" fill="none" stroke-linecap="round" />
			<circle cx="112" cy="80" r="2.5" fill="#fff" opacity="0.8" />
			<circle cx="124" cy="100" r="2" fill="#fff" opacity="0.8" />
			<circle cx="118" cy="114" r="1.6" fill="#fff" opacity="0.8" />
		</g>
	) : kind === "desserts" ? (
		<g>
			<ellipse cx="122" cy="96" rx="92" ry="40" fill="#efe6d6" stroke="#cdbb9c" />
			<g transform={`rotate(${tilt / 4} 122 80)`}>
				<path d="M84 52h76l8 50H76Z" fill="#f4e6c8" />
				<path d="M80 72h84l2 12H78Z" fill={p.accent} />
				<path d="M77 92h90l1 10H76Z" fill={p.accent} opacity="0.85" />
				<path d="M84 52h76l2 10H82Z" fill="#6b4126" />
				{[92, 106, 120, 134, 148].map((x) => <circle cx={x} cy="56" r="2" fill="#3c2414" />)}
			</g>
			<path d="M170 112c8-6 18-6 24 2" stroke={p.leaf} stroke-width="4" fill="none" stroke-linecap="round" />
		</g>
	) : (
		<g>
			<ellipse cx="124" cy="104" rx="98" ry="38" fill="#2c1a0c" opacity="0.2" />
			<ellipse cx="120" cy="88" rx="98" ry="52" fill="#efe6d6" stroke="#cdbb9c" />
			<ellipse cx="120" cy="90" rx="72" ry="36" fill="#e3d6bd" />
			<g transform={`rotate(${tilt} 120 88)`}>
				{kind === "starters" ? (
					<>
						<path d="M70 92c10-30 40-36 52-20 14-22 46-14 50 12-10 22-90 30-102 8Z" fill={p.base} />
						<path d="M84 84c8-12 22-14 30-6M124 76c10-8 24-6 30 6" stroke={p.leaf} stroke-width="4" fill="none" />
						<path d="M96 96a18 12 0 1 1 30 0Z" fill={p.accent} />
						<circle cx="142" cy="92" r="9" fill="#f6efe2" />
						<circle cx="88" cy="74" r="7" fill="#c8361f" />
					</>
				) : (
					<>
						<path d="M74 90c6-26 36-38 62-32 26 6 38 26 26 42-20 18-80 14-88-10Z" fill={p.base} />
						<path d="M86 80c14-8 34-10 56-2M84 92c18-6 44-6 70 2" stroke="#e7b77a" stroke-width="3" fill="none" />
						<circle cx="76" cy="102" r="10" fill={p.accent} />
						<circle cx="162" cy="100" r="9" fill={p.accent} />
						<path d="M118 60c-10-12-6-26 6-30 6 14 4 24-6 30Z" fill={p.leaf} />
						<path d="M122 60c8-14 22-16 30-8-8 12-20 14-30 8Z" fill={p.leaf} />
					</>
				)}
			</g>
		</g>
	)}
</svg>

<style>
	.dish-art {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
