---
/**
 * Decorative hero illustration: a speckled ceramic bowl of pasta with tomatoes
 * and basil, drawn in SVG so the theme needs no stock photography.
 * Purely presentational (aria-hidden); deterministic so renders are stable.
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;

let seed = 7;
const rand = () => {
	seed = (seed * 16807) % 2147483647;
	return (seed - 1) / 2147483646;
};

const cx = 330;
const cy = 300;

// Ribbon noodles: loose arcs inside the bowl.
const noodles = Array.from({ length: 46 }, () => {
	const a = rand() * Math.PI * 2;
	const r = 18 + rand() * 120;
	const x1 = cx + Math.cos(a) * r;
	const y1 = cy + Math.sin(a) * r * 0.78;
	const a2 = a + (rand() - 0.5) * 2.2;
	const r2 = 18 + rand() * 120;
	const x2 = cx + Math.cos(a2) * r2;
	const y2 = cy + Math.sin(a2) * r2 * 0.78;
	const qx = (x1 + x2) / 2 + (rand() - 0.5) * 110;
	const qy = (y1 + y2) / 2 + (rand() - 0.5) * 90;
	return {
		d: `M${x1.toFixed(1)} ${y1.toFixed(1)} Q${qx.toFixed(1)} ${qy.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`,
		light: rand() > 0.55,
	};
});

const speckles = Array.from({ length: 140 }, () => {
	const a = rand() * Math.PI * 2;
	const r = 150 + rand() * 62;
	return {
		x: cx + Math.cos(a) * r,
		y: cy + Math.sin(a) * r * 0.8,
		r: 0.8 + rand() * 1.6,
	};
});

const tomatoes = [
	{ x: 238, y: 352, r: 26 },
	{ x: 418, y: 338, r: 30 },
	{ x: 392, y: 236, r: 22 },
	{ x: 270, y: 258, r: 19 },
];

const herbs = Array.from({ length: 28 }, () => ({
	x: cx + (rand() - 0.5) * 230,
	y: cy + (rand() - 0.5) * 170,
	r: 1.4 + rand() * 1.8,
}));
---

<svg
	class:list={["plate-art", className]}
	viewBox="0 0 660 560"
	aria-hidden="true"
	focusable="false"
>
	<defs>
		<radialGradient id="pa-plate" cx="45%" cy="40%" r="65%">
			<stop offset="0" stop-color="#efe6d6" />
			<stop offset="0.7" stop-color="#d9cbb3" />
			<stop offset="1" stop-color="#a8977b" />
		</radialGradient>
		<radialGradient id="pa-well" cx="50%" cy="45%" r="60%">
			<stop offset="0" stop-color="#f1e7d3" />
			<stop offset="1" stop-color="#cdbb9c" />
		</radialGradient>
		<radialGradient id="pa-tomato" cx="35%" cy="30%" r="70%">
			<stop offset="0" stop-color="#f26b4f" />
			<stop offset="0.6" stop-color="#c8361f" />
			<stop offset="1" stop-color="#8e2414" />
		</radialGradient>
		<linearGradient id="pa-basil" x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#6f9a3a" />
			<stop offset="1" stop-color="#2f5a1f" />
		</linearGradient>
		<linearGradient id="pa-glass" x1="0" y1="0" x2="1" y2="0">
			<stop offset="0" stop-color="#fff8e6" stop-opacity="0.15" />
			<stop offset="0.5" stop-color="#fff8e6" stop-opacity="0.5" />
			<stop offset="1" stop-color="#fff8e6" stop-opacity="0.12" />
		</linearGradient>
		<filter id="pa-soft" x="-20%" y="-20%" width="140%" height="140%">
			<feGaussianBlur stdDeviation="14" />
		</filter>
	</defs>

	<!-- wine glass, softly out of focus -->
	<g opacity="0.55" filter="url(#pa-soft)" transform="translate(520 10)">
		<path d="M10 0h90c0 70-20 110-45 110S10 70 10 0Z" fill="url(#pa-glass)" />
		<path d="M18 40h74c-4 40-18 62-37 62S22 80 18 40Z" fill="#e8c96a" opacity="0.7" />
	</g>

	<!-- linen under the bowl -->
	<g transform="rotate(-8 330 430)" opacity="0.9">
		<rect x="120" y="360" width="440" height="190" rx="26" fill="#e9dfcf" />
		<path d="M150 400h380M150 520h380" stroke="#cdbfa6" stroke-width="2" stroke-dasharray="2 6" />
	</g>

	<!-- shadow -->
	<ellipse cx={cx + 14} cy={cy + 70} rx="230" ry="150" fill="#2c1a0c" opacity="0.35" filter="url(#pa-soft)" />

	<!-- bowl -->
	<ellipse cx={cx} cy={cy} rx="222" ry="180" fill="url(#pa-plate)" />
	{speckles.map((s) => <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r.toFixed(1)} fill="#6b5a44" opacity="0.45" />)}
	<ellipse cx={cx} cy={cy + 4} rx="160" ry="128" fill="url(#pa-well)" />
	<ellipse cx={cx} cy={cy} rx="222" ry="180" fill="none" stroke="#fff6e4" stroke-opacity="0.5" stroke-width="2" />

	<!-- pasta nest -->
	<ellipse cx={cx} cy={cy + 6} rx="134" ry="104" fill="#e2b86a" />
	<g fill="none" stroke-linecap="round">
		{noodles.map((n) => (
			<path d={n.d} stroke={n.light ? "#f7dc9a" : "#d39f4c"} stroke-width={n.light ? 9 : 10} />
		))}
		{noodles.slice(0, 18).map((n) => (
			<path d={n.d} stroke="#fff0c6" stroke-width="2" opacity="0.7" />
		))}
	</g>

	<!-- mushrooms and parmesan -->
	<g fill="#8a6440">
		<ellipse cx="300" cy="300" rx="16" ry="9" transform="rotate(-20 300 300)" />
		<ellipse cx="352" cy="352" rx="14" ry="8" transform="rotate(25 352 352)" />
		<ellipse cx="360" cy="270" rx="12" ry="7" transform="rotate(10 360 270)" />
	</g>
	<g fill="#fbf3dc" stroke="#e3d3ad" stroke-width="1">
		<path d="M318 248l26-8 6 14-28 6Z" />
		<path d="M286 330l22-10 8 12-24 9Z" />
		<path d="M380 300l24 4-4 14-22-6Z" />
		<path d="M330 330l18 6-6 12-16-6Z" />
	</g>

	<!-- tomatoes -->
	{tomatoes.map((t) => (
		<g>
			<circle cx={t.x} cy={t.y} r={t.r} fill="url(#pa-tomato)" />
			<ellipse cx={t.x - t.r * 0.35} cy={t.y - t.r * 0.4} rx={t.r * 0.28} ry={t.r * 0.16} fill="#ffd3c2" opacity="0.7" />
			<path
				d={`M${t.x - 5} ${t.y - t.r + 3} l5 4 5-4`}
				stroke="#4d6b27"
				stroke-width="3"
				fill="none"
				stroke-linecap="round"
			/>
		</g>
	))}

	<!-- herbs -->
	{herbs.map((h) => <circle cx={h.x.toFixed(1)} cy={h.y.toFixed(1)} r={h.r.toFixed(1)} fill="#3f6a25" opacity="0.8" />)}

	<!-- basil sprig -->
	<g>
		<path d="M332 214c-40-34-42-74-8-96 30 30 32 66 8 96Z" fill="url(#pa-basil)" />
		<path d="M336 214c26-44 66-56 98-36-20 34-56 46-98 36Z" fill="url(#pa-basil)" />
		<path d="M330 216c-50-6-82 12-92 44 38 8 70-6 92-44Z" fill="url(#pa-basil)" />
		<path d="M332 214c-14-30-14-60 -8-92M336 214c30-20 56-28 96-36M330 216c-28 10-52 24-90 44" stroke="#9cc06a" stroke-width="2" fill="none" opacity="0.6" />
	</g>

	<!-- loose olive sprigs on the table -->
	<g fill="#5b6b37" opacity="0.9">
		<path d="M60 380c30-8 52 4 60 22-26 6-48-4-60-22Z" />
		<path d="M96 350c22-20 46-20 62-6-20 18-42 18-62 6Z" />
		<path d="M30 420c26-14 50-8 62 8-24 12-48 8-62-8Z" />
		<path d="M40 430c40-30 90-70 130-90" stroke="#4a5a2c" stroke-width="3" fill="none" />
	</g>
</svg>

<style>
	.plate-art {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
