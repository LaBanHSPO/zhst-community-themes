---
export type IconName =
	| "clock"
	| "pin"
	| "phone"
	| "chevron"
	| "leaf"
	| "utensils"
	| "book"
	| "menu"
	| "close";

interface Props {
	name: IconName;
	size?: number;
	class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg
	class:list={["icon", className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{name === "clock" && (
		<>
			<circle cx="12" cy="12" r="9" />
			<path d="M12 7v5l3 2" />
		</>
	)}
	{name === "pin" && (
		<>
			<path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21Z" />
			<circle cx="12" cy="9.8" r="2.4" />
		</>
	)}
	{name === "phone" && (
		<path d="M5 4h3.2l1.6 4-2 1.3a10.5 10.5 0 0 0 5 5l1.3-2 4 1.6V17a2 2 0 0 1-2.2 2A15.4 15.4 0 0 1 3 6.2 2 2 0 0 1 5 4Z" />
	)}
	{name === "chevron" && <path d="m9 6 6 6-6 6" />}
	{name === "leaf" && (
		<>
			<path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z" />
			<path d="M5 19 13 11" />
		</>
	)}
	{name === "utensils" && (
		<>
			<path d="M7 3v8M5 3v5a2 2 0 0 0 4 0V3M7 11v10" />
			<path d="M17 21V3c-2 1.5-3 4-3 7v3h3" />
		</>
	)}
	{name === "book" && (
		<>
			<path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20V2.5H6.5A2.5 2.5 0 0 0 4 5v13.5Z" />
			<path d="M4 18.5A2.5 2.5 0 0 0 6.5 21H20v-5" />
		</>
	)}
	{name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
	{name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
