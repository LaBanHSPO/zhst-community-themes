---
import { getEmDashCollection, getEmDashEntry, getSiteSettings, getTermsForEntries } from "emdash";
import Base from "../layouts/Base.astro";
import DishCard from "../components/DishCard.astro";
import Icon from "../components/Icon.astro";
import PlateArt from "../components/PlateArt.astro";
import PostCard from "../components/PostCard.astro";
import { blockLines, categoryLabel, categoryRank, toDish } from "../utils/portable-text";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const [postsResult, menuResult, hoursResult, contactResult, settings] = await Promise.all([
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 3 }),
	getEmDashCollection("menu", { limit: 50 }),
	getEmDashEntry("pages", "hours"),
	getEmDashEntry("pages", "contact"),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(postsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	if (hoursResult.cacheHint) Astro.cache.set(hoursResult.cacheHint);
	if (contactResult.cacheHint) Astro.cache.set(contactResult.cacheHint);
}

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(settings);
const posts = postsResult.entries;
const menuItems = menuResult.entries.map((entry) => ({ entry, dish: toDish(entry.data) }));
// Home shows up to four dishes in course order (starters, mains, desserts, drinks).
const featuredDishes = [...menuItems]
	.sort((a, b) => categoryRank(a.dish.category) - categoryRank(b.dish.category))
	.slice(0, 4);
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

// Course names straight from the menu data, in the usual course order.
const courses = [...new Set(menuItems.map(({ dish }) => (dish.category ?? "").trim()).filter(Boolean))]
	.sort((a, b) => categoryRank(a) - categoryRank(b))
	.slice(0, 4)
	.map(categoryLabel);

const hours = hoursResult.entry;
const contact = contactResult.entry;
const hoursLines = hours ? blockLines(hours.data.content, 2) : [];
const addressLines = contact ? blockLines(contact.data.content, 1) : [];
const hasVisit = Boolean(hours || contact);
---

<Base title={siteTitle} description={siteTagline}>
	<section class="hero" class:list={{ "hero--solo": !hasVisit }} aria-labelledby="hero-title">
		<div class="hero__stage">
			<div class="hero__copy">
				<h1 id="hero-title">{siteTagline}</h1>
				<span class="rule" aria-hidden="true"></span>
				{
					courses.length > 0 && (
						<p class="eyebrow hero__courses">
							{courses.map((course, index) => (
								<>
									{index > 0 && <span class="hero__dot" aria-hidden="true">•</span>}
									<span>{course}</span>
								</>
							))}
						</p>
					)
				}
				<a class="btn btn--primary hero__cta" href="/menu">
					Explore Menu <Icon name="chevron" size={20} />
				</a>
			</div>
			<div class="hero__art">
				<PlateArt />
			</div>
		</div>

		{
			hasVisit && (
				<aside class="visit" aria-label="Visit us">
					<ul class="visit__list">
						{hours && (
							<li class="visit__item">
								<span class="visit__icon"><Icon name="clock" size={30} /></span>
								<div>
									<h2 class="visit__title">
										<a href="/hours" {...hours.edit.title}>{hours.data.title}</a>
									</h2>
									{hoursLines.map((line) => <p class="visit__text">{line}</p>)}
								</div>
							</li>
						)}
						{contact && addressLines.length > 0 && (
							<li class="visit__item">
								<span class="visit__icon"><Icon name="pin" size={30} /></span>
								<div>
									<h2 class="visit__title">Find Us</h2>
									{addressLines.map((line) => <p class="visit__text">{line}</p>)}
								</div>
							</li>
						)}
						{contact && (
							<li class="visit__item">
								<span class="visit__icon"><Icon name="phone" size={30} /></span>
								<div>
									<h2 class="visit__title">{contact.data.title}</h2>
									<a class="visit__link" href="/contact">
										Say Hello <Icon name="chevron" size={18} />
									</a>
								</div>
							</li>
						)}
					</ul>
					<svg class="visit__sprig" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
						<path d="M110 118C90 80 70 60 30 40" stroke="currentColor" stroke-width="2.5" fill="none" />
						<path d="M86 86c-20-2-32-14-34-32 18 4 30 14 34 32Z" fill="currentColor" />
						<path d="M70 66c4-18 18-28 36-28-4 18-18 28-36 28Z" fill="currentColor" />
						<path d="M54 54c-18-6-26-20-24-36 16 6 24 18 24 36Z" fill="currentColor" />
						<path d="M98 104c4-16 16-24 30-24-4 16-16 24-30 24Z" fill="currentColor" />
					</svg>
				</aside>
			)
		}
	</section>

	<section class="kitchen" aria-labelledby="menu-title">
		<div class="kitchen__main">
			<div class="kitchen__head">
				<h2 id="menu-title">Our Menu</h2>
				<a class="btn btn--ghost" href="/menu">View All <Icon name="chevron" size={16} /></a>
			</div>
			{
				featuredDishes.length === 0 ? (
					<p class="empty">
						No menu items yet. <a href="/_emdash/admin/content/menu/new">Add the first dish</a>.
					</p>
				) : (
					<ul class="kitchen__grid">
						{featuredDishes.map(({ entry, dish }, index) => (
							<li>
								<DishCard
									name={dish.name}
									price={dish.price}
									category={dish.category}
									available={dish.available}
									variant={index}
									href={`/menu/${entry.id}`}
									nameEdit={entry.edit.name}
									priceEdit={entry.edit.price}
								/>
							</li>
						))}
					</ul>
				)
			}
		</div>

		<aside class="kitchen__aside" aria-label={siteTitle}>
			<div class="still-life" aria-hidden="true">
				<svg viewBox="0 0 280 220" focusable="false">
					<defs>
						<linearGradient id="sl-wall" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#5b4a37" />
							<stop offset="1" stop-color="#8a6f50" />
						</linearGradient>
						<linearGradient id="sl-table" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#9b7650" />
							<stop offset="1" stop-color="#6e5034" />
						</linearGradient>
						<radialGradient id="sl-glow" cx="70%" cy="25%" r="60%">
							<stop offset="0" stop-color="#f6d9a0" stop-opacity="0.65" />
							<stop offset="1" stop-color="#f6d9a0" stop-opacity="0" />
						</radialGradient>
					</defs>
					<rect width="280" height="220" fill="url(#sl-wall)" />
					<rect width="280" height="220" fill="url(#sl-glow)" />
					<rect x="18" y="20" width="56" height="120" rx="4" fill="#3b2f22" opacity="0.5" />
					<rect x="206" y="28" width="60" height="110" rx="4" fill="#3b2f22" opacity="0.4" />
					<path d="M0 150h280v70H0Z" fill="url(#sl-table)" />
					<path d="M0 150h280" stroke="#c9a77a" stroke-width="2" />
					<g stroke="#4f5f2e" stroke-width="2" fill="none">
						<path d="M140 150V70M140 110c-14-20-30-30-48-34M140 96c14-18 30-26 46-28M140 80c-6-20-4-38 6-52" />
					</g>
					<g fill="#6d7d3c">
						<ellipse cx="96" cy="78" rx="10" ry="4" transform="rotate(-25 96 78)" />
						<ellipse cx="112" cy="90" rx="10" ry="4" transform="rotate(30 112 90)" />
						<ellipse cx="180" cy="70" rx="10" ry="4" transform="rotate(20 180 70)" />
						<ellipse cx="164" cy="82" rx="10" ry="4" transform="rotate(-30 164 82)" />
						<ellipse cx="146" cy="34" rx="9" ry="4" transform="rotate(-70 146 34)" />
						<ellipse cx="136" cy="56" rx="9" ry="4" transform="rotate(60 136 56)" />
					</g>
					<path d="M122 110h36l-4 46a6 6 0 0 1-6 5h-16a6 6 0 0 1-6-5Z" fill="#e9f0e4" opacity="0.45" stroke="#f3f6ee" stroke-opacity="0.6" />
					<ellipse cx="70" cy="168" rx="40" ry="8" fill="#efe6d6" />
					<ellipse cx="70" cy="166" rx="26" ry="5" fill="#d9cbb3" />
					<rect x="214" y="146" width="10" height="16" rx="2" fill="#f4ead8" />
					<ellipse cx="219" cy="142" rx="5" ry="8" fill="#ffd27a" opacity="0.8" />
				</svg>
			</div>
			<p class="kitchen__motto">{siteTagline}</p>
			<span class="rule kitchen__rule" aria-hidden="true"></span>
		</aside>
	</section>

	{
		posts.length > 0 && (
			<section class="wrap journal" aria-labelledby="journal-title">
				<div class="journal__head">
					<h2 id="journal-title">From the Journal</h2>
					<a class="btn btn--ghost" href="/posts">All entries <Icon name="chevron" size={16} /></a>
				</div>
				<ul class="journal__grid">
					{posts.map((post) => (
						<li>
							<PostCard post={post} tags={tagsByEntry.get(post.data.id) ?? []} />
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>

<style>
	/* Hero ------------------------------------------------------------ */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) clamp(300px, 24vw, 360px);
		max-width: 1600px;
		margin-inline: auto;
	}

	.hero--solo {
		grid-template-columns: minmax(0, 1fr);
	}

	.hero__stage {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		align-items: center;
		min-height: clamp(420px, 34vw, 520px);
		overflow: hidden;
		background:
			radial-gradient(ellipse 60% 70% at 72% 55%, rgb(255 214 150 / 0.22), transparent 70%),
			linear-gradient(90deg, #f3eadb 0%, #efe3cf 30%, #b88d62 52%, #6e4a2c 74%, #4a3020 100%);
	}

	.hero__stage::before {
		content: "";
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(
			178deg,
			rgb(40 22 10 / 0) 0 14px,
			rgb(40 22 10 / 0.05) 14px 16px
		);
		mask-image: linear-gradient(90deg, transparent 40%, #000 70%);
		pointer-events: none;
	}

	.hero__copy {
		position: relative;
		z-index: 1;
		padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4.5rem);
	}

	.hero__copy h1 {
		max-width: 11ch;
		font-size: clamp(2.6rem, 4.4vw, 4.2rem);
		line-height: 1.05;
		text-wrap: balance;
	}

	.hero__copy .rule {
		margin-block: 1.75rem 1.4rem;
	}

	.hero__courses {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.9rem;
		margin: 0 0 2rem;
		color: var(--ink-soft);
	}

	.hero__dot {
		color: var(--terracotta);
	}

	.hero__cta {
		padding-inline: 1.9rem 1.5rem;
		min-height: 56px;
		font-size: 1.25rem;
	}

	.hero__art {
		position: relative;
		align-self: stretch;
		display: flex;
		align-items: center;
		margin-left: -8%;
		margin-right: -4%;
	}

	/* Visit panel ----------------------------------------------------- */
	.visit {
		position: relative;
		overflow: hidden;
		padding: clamp(2rem, 3vw, 2.75rem) clamp(1.5rem, 3vw, 2.75rem);
		background: var(--olive);
		color: var(--olive-text);
	}

	.visit__list {
		position: relative;
		z-index: 1;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.visit__item {
		display: grid;
		grid-template-columns: 44px 1fr;
		gap: 1.25rem;
		padding-block: 1.75rem;
	}

	.visit__item:first-child {
		padding-top: 0.25rem;
	}

	.visit__item + .visit__item {
		border-top: 1px solid rgb(243 239 226 / 0.28);
	}

	.visit__icon {
		color: var(--olive-text);
	}

	.visit__title {
		margin-bottom: 0.45rem;
		color: #fff;
		font-size: 1.3rem;
		font-weight: 500;
		letter-spacing: 0;
	}

	.visit__title a {
		color: inherit;
		text-decoration: none;
	}

	.visit__title a:hover {
		text-decoration: underline;
	}

	.visit__text {
		margin: 0;
		color: var(--olive-muted);
		font-size: 1.05rem;
		line-height: 1.55;
	}

	.visit__link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		min-height: 44px;
		color: var(--olive-text);
		font-size: 1.05rem;
		text-decoration: none;
	}

	.visit__link:hover {
		color: #fff;
		text-decoration: underline;
	}

	.visit :global(:focus-visible) {
		outline-color: #fff;
	}

	.visit__sprig {
		position: absolute;
		right: -10px;
		bottom: -10px;
		width: 120px;
		color: #7d8c4a;
		opacity: 0.55;
	}

	/* Menu strip ------------------------------------------------------ */
	.kitchen {
		display: grid;
		grid-template-columns: minmax(0, 1fr) clamp(300px, 24vw, 360px);
		max-width: 1600px;
		margin-inline: auto;
	}

	.kitchen__main {
		padding: clamp(2rem, 3vw, 2.5rem) clamp(1.25rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3rem);
	}

	.kitchen__head,
	.journal__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.kitchen__head h2,
	.journal__head h2 {
		font-size: clamp(2.1rem, 3.4vw, 3rem);
	}

	.kitchen__grid,
	.journal__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.9rem, 1.4vw, 1.25rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.kitchen__aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: clamp(1.75rem, 2.5vw, 2rem) clamp(1.5rem, 2.5vw, 2rem) 2.5rem;
		background: var(--sand);
		text-align: center;
	}

	.still-life {
		width: 100%;
		overflow: hidden;
		border-radius: 6px;
		box-shadow: var(--shadow);
	}

	.still-life svg {
		display: block;
		width: 100%;
		height: auto;
	}

	.kitchen__motto {
		max-width: 16rem;
		margin: 2rem 0 1rem;
		color: var(--ink-soft);
		font-family: var(--font-ui);
		font-size: 0.85rem;
		letter-spacing: 0.32em;
		line-height: 2.2;
		text-transform: uppercase;
	}

	.kitchen__rule {
		background: var(--ink-soft);
	}

	/* Journal --------------------------------------------------------- */
	.journal {
		padding-top: clamp(2rem, 4vw, 3rem);
	}

	.journal__grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	/* Tablet ---------------------------------------------------------- */
	@media (max-width: 1100px) {
		.hero,
		.kitchen {
			grid-template-columns: minmax(0, 1fr);
		}

		.visit {
			padding: 1.5rem var(--gutter) 0;
			background: var(--cream);
			color: var(--ink);
		}

		.visit__list {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
			gap: 1rem;
		}

		.visit__item,
		.visit__item:first-child {
			grid-template-columns: 1fr;
			justify-items: center;
			gap: 0.6rem;
			padding: 1.5rem 1rem;
			text-align: center;
			background: var(--paper);
			border: 1px solid #ebe1cf;
			border-radius: var(--radius);
			box-shadow: var(--shadow);
		}

		.visit__item + .visit__item {
			border-top: 1px solid #ebe1cf;
		}

		.visit__icon {
			color: var(--terracotta);
		}

		.visit__title {
			color: var(--ink);
		}

		.visit__text {
			color: var(--muted);
		}

		.visit__link {
			color: var(--terracotta);
		}

		.visit :global(:focus-visible) {
			outline-color: var(--focus);
		}

		.visit__sprig {
			display: none;
		}

		.kitchen__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.kitchen__main {
			padding-inline: var(--gutter);
		}

		.kitchen__aside {
			display: none;
		}
	}

	/* Phone ----------------------------------------------------------- */
	@media (max-width: 720px) {
		.hero__stage {
			grid-template-columns: minmax(0, 1fr);
			min-height: 0;
			background:
				linear-gradient(180deg, #f3eadb 0%, #efe3cf 42%, #a57a52 70%, #5a3b25 100%);
		}

		.hero__stage::before {
			mask-image: linear-gradient(180deg, transparent 50%, #000 80%);
		}

		.hero__copy {
			padding: 2.25rem var(--gutter) 0.5rem;
		}

		.hero__copy h1 {
			font-size: clamp(2.3rem, 10vw, 3rem);
		}

		.hero__copy .rule {
			margin-block: 1.25rem 1rem;
		}

		.hero__courses {
			margin-bottom: 1.5rem;
			font-size: 0.72rem;
		}

		.hero__art {
			margin: 0 -12% -6%;
		}

		.journal__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 520px) {
		.kitchen__grid {
			gap: 0.75rem;
		}

		.kitchen__head .btn,
		.journal__head .btn {
			padding-inline: 0.9rem;
		}
	}
</style>
