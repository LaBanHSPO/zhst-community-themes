---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="wrap entry">
		<article class="entry__main">
			<header class="entry__head">
				<p class="eyebrow">
					<a href="/posts">Journal</a>
					{
						categories.map((c) => (
							<>
								<span aria-hidden="true"> · </span>
								<a href={`/category/${c.slug}`}>{c.label}</a>
							</>
						))
					}
				</p>
				<h1 {...post.edit.title}>{post.data.title}</h1>
				{
					post.data.publishedAt && (
						<time datetime={post.data.publishedAt.toISOString()}>
							{post.data.publishedAt.toLocaleDateString("en-US", {
								year: "numeric",
								month: "long",
								day: "numeric",
							})}
						</time>
					)
				}
				<span class="rule" aria-hidden="true"></span>
			</header>

			{
				post.data.featured_image && (
					<div class="entry__media" {...post.edit.featured_image}>
						<Image image={post.data.featured_image} />
					</div>
				)
			}

			<div class="prose">
				<PortableText value={post.data.content} />
			</div>

			{
				tags.length > 0 && (
					<div class="entry__tags" aria-label="Tags">
						{tags.map((t) => (
							<a class="chip" href={`/tag/${t.slug}`}>{t.label}</a>
						))}
					</div>
				)
			}
		</article>

		<aside class="entry__aside" aria-label="Sidebar">
			<WidgetArea name="sidebar" />
		</aside>
	</div>
</Base>

<style>
	.entry {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		gap: clamp(2rem, 5vw, 4.5rem);
		padding-top: clamp(2.5rem, 6vw, 4.5rem);
	}

	.entry__head h1 {
		margin-block: 0.75rem 1rem;
		font-size: clamp(2.3rem, 5vw, 3.6rem);
	}

	.entry__head .eyebrow a {
		color: var(--terracotta);
		text-decoration: none;
	}

	.entry__head .eyebrow a:hover {
		text-decoration: underline;
	}

	.entry__head time {
		display: block;
		margin-bottom: 1.25rem;
		color: var(--muted);
		font-family: var(--font-ui);
		font-size: 0.9rem;
	}

	.entry__media {
		margin-block: 2rem;
		overflow: hidden;
		border-radius: var(--radius-lg);
	}

	.entry__media :global(img) {
		display: block;
		width: 100%;
	}

	.prose {
		margin-top: 2rem;
	}

	.entry__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 2.5rem;
	}

	.entry__aside {
		align-self: start;
		padding: 1.5rem;
		background: var(--paper);
		border: 1px solid #ebe1cf;
		border-radius: var(--radius);
		font-family: var(--font-ui);
		font-size: 0.95rem;
	}

	.entry__aside :global(h2),
	.entry__aside :global(h3) {
		margin: 1.25rem 0 0.6rem;
		font-size: 1.25rem;
	}

	.entry__aside :global(h2:first-child),
	.entry__aside :global(h3:first-child) {
		margin-top: 0;
	}

	.entry__aside :global(ul) {
		margin: 0;
		padding-left: 1.1rem;
	}

	.entry__aside :global(li) {
		margin-block: 0.35rem;
	}

	.entry__aside :global(input) {
		width: 100%;
		min-height: 42px;
		padding: 0.5rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--cream);
		font: inherit;
	}

	@media (max-width: 900px) {
		.entry {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
