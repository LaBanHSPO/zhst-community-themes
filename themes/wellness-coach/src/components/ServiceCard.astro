---
import type { Service } from "../../emdash-env";
import Arrow from "./Arrow.astro";
import { photoSrc, serviceHref } from "../lib/coach";

interface Props {
	service: { data: Service; edit?: Record<string, any> };
}
const { service } = Astro.props;
const d = service.data;
const src = photoSrc(d.image, d.photo);
---

<article class="service-card">
	<a class="service-card-photo" href={serviceHref(d)} tabindex="-1" aria-hidden="true">
		{src && <img src={src} alt="" width="640" height="480" loading="lazy" />}
	</a>
	<h3 class="service-card-title" {...service.edit?.title}><a href={serviceHref(d)}>{d.title}</a></h3>
	<p class="service-card-text">{d.summary}</p>
	<p class="service-card-foot">
		<span class="service-card-price">{d.price_label}</span>
		<a class="text-link" href={serviceHref(d)}><span>Learn more</span><Arrow /></a>
	</p>
</article>
