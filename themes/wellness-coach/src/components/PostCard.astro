---
import type { Post } from "../../emdash-env";
import { photoSrc, postHref } from "../lib/coach";

interface Props {
	post: { data: Post; edit?: Record<string, any> };
	eager?: boolean;
}
const { post, eager = false } = Astro.props;
const d = post.data;
const src = photoSrc(d.image, d.photo);
---

<article class="post-card">
	<a class="post-card-photo" href={postHref(d)} tabindex="-1" aria-hidden="true">
		{src && <img src={src} alt="" width="640" height="480" loading={eager ? "eager" : "lazy"} />}
	</a>
	<p class="post-card-meta">
		{d.category && <span class="tag">{d.category}</span>}
		{d.date_label && <span>{d.date_label}</span>}
	</p>
	<h3 class="post-card-title" {...post.edit?.title}><a href={postHref(d)}>{d.title}</a></h3>
	<p class="post-card-text">{d.summary}</p>
</article>
