---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<img class="notfound-photo" src="/images/journal-mist-lake.webp" alt="" width="800" height="405" />
		<div class="notfound-copy">
			<p class="eyebrow">Error 404</p>
			<h1 id="nf-title" class="display display-xl">This path has wandered off.</h1>
			<p class="lede">The page you are looking for has moved or never existed. Here are some gentle places to start again.</p>
			<div class="actions">
				<a class="btn btn-sage" href="/"><span>Back to home</span><Arrow /></a>
				<a class="pill" href="/services">Services</a>
				<a class="pill" href="/journal">Journal</a>
			</div>
		</div>
	</section>
</Base>
