---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import DiscoveryBand from "../components/DiscoveryBand.astro";
import Icon from "../components/Icon.astro";
import PostCard from "../components/PostCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { getCoach, getPosts, getPrinciples, getServices, getSteps, lines } from "../lib/coach";

const [principlesResult, stepsResult, servicesResult, postsResult, coachResult] = await Promise.all([
	getPrinciples(),
	getSteps(),
	getServices(),
	getPosts(),
	getCoach(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(principlesResult.cacheHint);
	Astro.cache.set(stepsResult.cacheHint);
	Astro.cache.set(servicesResult.cacheHint);
	Astro.cache.set(postsResult.cacheHint);
	Astro.cache.set(coachResult.cacheHint);
}
const principles = principlesResult.entries;
const steps = stepsResult.entries;
const services = (servicesResult.entries.some((s) => s.data.featured) ? servicesResult.entries.filter((s) => s.data.featured) : servicesResult.entries).slice(0, 3);
const posts = (postsResult.entries.some((p) => p.data.featured) ? postsResult.entries.filter((p) => p.data.featured) : postsResult.entries).slice(0, 3);
const tints = ["sage", "peach", "sage"];
---

<Base
	title="Build a rhythm that feels like you"
	description="Willow & Well is a mindful coaching practice for a more balanced, energized and fulfilling life. Meet your coach, explore services and book a free discovery call."
>
	<section class="hero" aria-labelledby="hero-title">
		<img
			class="hero-photo"
			src="/images/hero-home.webp"
			alt="A smiling woman in a cream cardigan sits on rocks above a misty lake and mountains in soft morning light"
			width="1448"
			height="705"
			fetchpriority="high"
		/>
		<div class="hero-copy">
			<p class="hero-eyebrow">A calmer, brighter you</p>
			<h1 id="hero-title" class="hero-title">Build a rhythm<br />that feels like you.</h1>
			<p class="hero-sub">Mindful coaching for a more balanced, <br />energized and fulfilling life.</p>
			<a class="btn btn-sage" href="/about"><span>Meet your coach</span><Arrow /></a>
		</div>
		<p class="hand" aria-hidden="true">A kinder<br />today for a<br />brighter<br />tomorrow<span class="hand-stroke"></span></p>
	</section>

	<section class="approach" aria-labelledby="approach-title">
		<div class="approach-inner">
			<div class="approach-head">
				<p class="eyebrow">A whole you approach</p>
				<h2 id="approach-title" class="approach-title">Small shifts.<br />A brighter you.</h2>
				<span class="approach-rule" aria-hidden="true"></span>
			</div>
			<ul class="pillars">
				{
					principles.map((p, i) => (
						<li class="pillar">
							<span class={`pillar-icon tint-${tints[i % tints.length]}`}><Icon name={p.data.icon} /></span>
							<h3 class="pillar-title" {...p.edit.title}>{p.data.title}</h3>
							<p class="pillar-text">
								{lines(p.data.text).map((l, j) => (j === 0 ? <>{l}</> : <><br />{l}</>))}
							</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		steps.length > 0 && (
			<section class="how" aria-labelledby="how-title">
				<div class="wrap">
					<div class="section-head">
						<p class="eyebrow">How coaching works</p>
						<h2 id="how-title" class="display">Four gentle steps, at your pace.</h2>
					</div>
					<ol class="steps">
						{steps.map((s, i) => (
							<li class="step">
								<span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
								<h3 class="step-title" {...s.edit.title}>{s.data.title}</h3>
								<p class="step-text">{s.data.text}</p>
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	{
		services.length > 0 && (
			<section class="teaser" aria-labelledby="services-title">
				<div class="wrap">
					<div class="section-head section-head-row">
						<div>
							<p class="eyebrow">Ways to work together</p>
							<h2 id="services-title" class="display">Support that fits your life.</h2>
						</div>
						<a class="text-link" href="/services"><span>All services</span><Arrow /></a>
					</div>
					<ul class="card-grid">
						{services.map((s) => <li><ServiceCard service={s} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	<section class="meet" aria-labelledby="meet-title">
		<div class="wrap meet-inner">
			<img class="meet-photo" src="/images/coach-portrait.webp" alt="Iris sitting cross-legged on a woven rug at sunset, resting her chin on one hand" width="860" height="990" loading="lazy" />
			<div class="meet-copy">
				<p class="eyebrow">Your coach</p>
				<h2 id="meet-title" class="display">Hello, I'm Iris.</h2>
				<p class="meet-text">I spent eleven years in a job where being useful meant being available. What helped was not a big reset but a handful of small, ordinary changes, made on purpose and kept. That is what I now help others do.</p>
				<p class="meet-actions">
					<a class="btn btn-sage" href="/about"><span>Meet your coach</span><Arrow /></a>
				</p>
			</div>
		</div>
	</section>

	{
		posts.length > 0 && (
			<section class="teaser teaser-journal" aria-labelledby="journal-title">
				<div class="wrap">
					<div class="section-head section-head-row">
						<div>
							<p class="eyebrow">From the journal</p>
							<h2 id="journal-title" class="display">Notes for a gentler week.</h2>
						</div>
						<a class="text-link" href="/journal"><span>All posts</span><Arrow /></a>
					</div>
					<ul class="card-grid">
						{posts.map((p) => <li><PostCard post={p} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	<DiscoveryBand coach={coachResult.coach} />
</Base>
