---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import BookingBand from "../components/BookingBand.astro";
import PageHead from "../components/PageHead.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getPractice } from "../lib/practice";

const [{ entry: page, cacheHint }, practiceResult, settings] = await Promise.all([
	getEmDashEntry("pages", "about"),
	getPractice(),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	if (cacheHint) Astro.cache.set(cacheHint);
	Astro.cache.set(practiceResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = page ? getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: "/about" }) : null;
const hasBody = Boolean(page?.data.content && page.data.content.length > 0);
---

<Base
	title={seo?.title ?? "Meet your nutritionist"}
	pageTitle={seo?.ogTitle}
	description={seo?.description ?? page?.data.intro ?? "Meet Nora, the nutritionist behind NourishWay."}
	canonical={seo?.canonical}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	<PageHead
		id="about-title"
		eyebrow={page?.data.eyebrow ?? "About"}
		title={page?.data.title ?? "Meet your nutritionist"}
		intro={page?.data.intro}
		edit={page ? { ...page.edit.title } : {}}
	/>

	<section class="about-story">
		<div class="wrap about-grid">
			<figure class="about-photo">
				<img
					src="/images/nutritionist-portrait.webp"
					alt="Nora resting her chin on one hand at a kitchen counter with kale, carrots, radishes, a lemon and an avocado in front of her"
					width="690"
					height="1017"
					loading="lazy"
				/>
				<figcaption>Nora Bell, in Fernhill. A fictional nutritionist created for this theme.</figcaption>
			</figure>
			<div class="prose">
				{hasBody ? <PortableText value={page!.data.content} /> : <p>Nora's story is coming soon.</p>}
				<p class="about-links">
					<a class="btn btn-green" href="/contact"><span>Request a consultation</span><Arrow /></a>
					<a class="text-link" href="/services"><span>See services</span><Arrow /></a>
				</p>
			</div>
		</div>
	</section>

	<BookingBand practice={practiceResult.practice} />
</Base>
