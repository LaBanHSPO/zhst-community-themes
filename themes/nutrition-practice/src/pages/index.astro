---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import BookingBand from "../components/BookingBand.astro";
import Icon from "../components/Icon.astro";
import ResourceCard from "../components/ResourceCard.astro";
import ServiceRow from "../components/ServiceRow.astro";
import { getPractice, getPrinciples, getResources, getServices, getSteps, lines } from "../lib/practice";

const [principlesResult, stepsResult, servicesResult, resourcesResult, practiceResult] = await Promise.all([
	getPrinciples(),
	getSteps(),
	getServices(),
	getResources(),
	getPractice(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(principlesResult.cacheHint);
	Astro.cache.set(stepsResult.cacheHint);
	Astro.cache.set(servicesResult.cacheHint);
	Astro.cache.set(resourcesResult.cacheHint);
	Astro.cache.set(practiceResult.cacheHint);
}
const principles = principlesResult.entries;
const steps = stepsResult.entries;
const services = servicesResult.entries;
const resources = (resourcesResult.entries.some((r) => r.data.featured) ? resourcesResult.entries.filter((r) => r.data.featured) : resourcesResult.entries).slice(0, 3);
const tints = ["sage", "peach", "butter"];
---

<Base
	title="Find your balance with food"
	description="NourishWay is a nutrition practice for everyday eating: personalized guidance, simple habits that last, and help for families. Meet your nutritionist, see services and ask for a consultation."
	overlay
>
	<section class="hero" aria-labelledby="hero-title">
		<img
			class="hero-photo"
			src="/images/hero-home.webp"
			alt="A smiling woman in an olive linen shirt leans on a kitchen counter full of kale, carrots, radishes, lemons, avocado and tomatoes"
			width="1448"
			height="718"
			fetchpriority="high"
		/>
		<div class="hero-copy">
			<p class="hero-eyebrow">Real food. A brighter you.</p>
			<h1 id="hero-title" class="hero-title">Find your<br />balance with food.</h1>
			<p class="hero-sub">Personalized nutrition guidance for a healthier, <br />happier, more vibrant you.</p>
			<a class="btn btn-green" href="/about"><span>Meet your nutritionist</span><Arrow /></a>
			<p class="hero-motto" aria-hidden="true">
				<span class="motto-rule"></span><span>Good food</span>
				<svg class="motto-leaf" width="15" height="20" viewBox="0 0 15 20"><path d="M12.500 1C3 3 -1 9 2 16c2 3 7 3.500 9 .5C14.500 12 14.500 6 12.500 1Z" fill="currentColor" /><path d="M2.500 19C5 13.500 8 9.500 12 6" fill="none" stroke="#faf9f6" stroke-width="1" /></svg>
				<span>Bright days</span>
			</p>
		</div>
		<p class="hand hand-hero" aria-hidden="true">Food<br />fuels a kinder<br /><span class="in" style="margin-left:26px">you</span> <svg class="hand-heart" width="20" height="19" viewBox="0 0 20 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17C4 12.500 1.500 9.500 1.500 6c0-2.500 2-4.500 4.400-4.500 1.800 0 3.200 1 4.100 2.800C10.900 2.500 12.300 1.500 14.100 1.500 16.500 1.500 18.500 3.500 18.500 6c0 3.500-2.500 6.500-8.500 11Z" /></svg></p>
	</section>

	<section class="approach" aria-labelledby="approach-title">
		<div class="approach-inner">
			<h2 id="approach-title" class="approach-title">A kinder, more balanced approach to nutrition.</h2>
			<ul class="pillars">
				{
					principles.map((p, i) => (
						<li class="pillar">
							<span class={`pillar-icon tint-${tints[i % tints.length]}`}><Icon name={p.data.icon} /></span>
							<h3 class="pillar-title" {...p.edit.title}>{p.data.title}</h3>
							<p class="pillar-text">
								{lines(p.data.text).map((l, j) => (j === 0 ? <>{l}</> : <><br />{l}</>))}
							</p>
						</li>
					))
				}
			</ul>
		</div>
		<img class="sprig" src="/images/sprig.webp" alt="" width="108" height="278" loading="lazy" />
		<p class="hand hand-sage" aria-hidden="true">Small<br /><span class="in" style="margin-left:24px">choices</span><br /><span class="in" style="margin-left:16px">brighten</span><br /><span class="in" style="margin-left:28px">big days</span><span class="hand-stroke"></span></p>
	</section>

	{
		steps.length > 0 && (
			<section class="process" aria-labelledby="process-title">
				<div class="wrap process-inner">
					<div class="process-copy">
						<p class="eyebrow">Working together</p>
						<h2 id="process-title" class="display">What working together looks like.</h2>
						<ol class="process-steps">
							{steps.map((s, i) => (
								<li class="process-step">
									<span class="process-num" aria-hidden="true">{i + 1}</span>
									<div>
										{s.data.when_label && <p class="process-when">{s.data.when_label}</p>}
										<h3 class="process-title" {...s.edit.title}>{s.data.title}</h3>
										<p class="process-text">{s.data.text}</p>
									</div>
								</li>
							))}
						</ol>
					</div>
					<figure class="process-photo">
						<img src="/images/nutritionist-counter.webp" alt="Nora leaning on a bright kitchen counter, with bowls of kale, tomatoes and fresh vegetables in front of her" width="1066" height="543" loading="lazy" />
					</figure>
				</div>
			</section>
		)
	}

	{
		services.length > 0 && (
			<section class="pricelist" aria-labelledby="services-title">
				<div class="wrap">
					<div class="section-head section-head-row">
						<div>
							<p class="eyebrow">Services</p>
							<h2 id="services-title" class="display">Ways to work together.</h2>
						</div>
						<a class="text-link" href="/services"><span>All services</span><Arrow /></a>
					</div>
					<ul class="price-rows">
						{services.map((s) => <ServiceRow service={s} />)}
					</ul>
					<p class="price-note">Prices are starting points in US dollars. Every session is agreed with you before you book.</p>
				</div>
			</section>
		)
	}

	{
		resources.length > 0 && (
			<section class="teaser" aria-labelledby="resources-title">
				<div class="wrap">
					<div class="section-head section-head-row">
						<div>
							<p class="eyebrow">Resources</p>
							<h2 id="resources-title" class="display">Recipes, articles and guides.</h2>
						</div>
						<a class="text-link" href="/resources"><span>All resources</span><Arrow /></a>
					</div>
					<ul class="card-grid">
						{resources.map((r) => <li><ResourceCard resource={r} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	<BookingBand practice={practiceResult.practice} />
</Base>
