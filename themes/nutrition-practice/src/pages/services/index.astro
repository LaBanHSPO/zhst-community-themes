---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import BookingBand from "../../components/BookingBand.astro";
import PageHead from "../../components/PageHead.astro";
import { getPractice, getServices, lines, photoAlt, photoSrc, serviceHref } from "../../lib/practice";

const [servicesResult, practiceResult] = await Promise.all([getServices(), getPractice()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(servicesResult.cacheHint);
	Astro.cache.set(practiceResult.cacheHint);
}
const services = servicesResult.entries;
---

<Base title="Services" description="Nutrition services from NourishWay: an initial consultation, follow-up sessions, family nutrition and meal planning support, with format, length, what is included and starting prices.">
	<PageHead
		id="services-title"
		eyebrow="Services"
		title="Ways to work together."
		intro="Start with a first consultation, then add check-ins, a family session or four weeks of meal planning if they help. Prices are starting points in US dollars, and each session is agreed with you before you book."
	/>

	<section class="services" aria-labelledby="services-title">
		<div class="wrap">
			{
				services.length === 0 ? (
					<p class="empty-note">Services are being updated. Send a note and Nora will share current options.</p>
				) : (
					<ul class="service-rows">
						{services.map((s) => {
							const src = photoSrc(s.data.image, s.data.photo);
							return (
								<li class="service-row" id={s.data.slug ?? s.data.id}>
									{src && (
										<a class="service-row-photo" href={serviceHref(s.data)} tabindex="-1" aria-hidden="true">
											<img src={src} alt={photoAlt(s.data.image, s.data.photo, "")} width="640" height="544" loading="lazy" />
										</a>
									)}
									<div class="service-row-copy">
										{s.data.best_for && <p class="eyebrow">{s.data.best_for}</p>}
										<h2 class="service-row-name" {...s.edit.title}><a href={serviceHref(s.data)}>{s.data.title}</a></h2>
										<p class="service-row-summary">{s.data.summary}</p>
										<dl class="facts">
											{s.data.format && <div><dt>Format</dt><dd>{s.data.format}</dd></div>}
											{s.data.length && <div><dt>Length</dt><dd>{s.data.length}</dd></div>}
											{s.data.price_label && <div><dt>Price</dt><dd class="price">{s.data.price_label}</dd></div>}
										</dl>
										<h3 class="includes-title">What is included</h3>
										<ul class="includes">
											{lines(s.data.includes).map((i) => <li>{i}</li>)}
										</ul>
										<p class="service-row-actions">
											<a class="btn btn-green" href={`/contact?service=${encodeURIComponent(s.data.slug ?? s.data.id)}`}>
												<span>Request this</span><Arrow />
											</a>
											<a class="text-link" href={serviceHref(s.data)}><span>Read more</span><Arrow /></a>
										</p>
									</div>
								</li>
							);
						})}
					</ul>
				)
			}
		</div>
	</section>

	<BookingBand practice={practiceResult.practice} />
</Base>
