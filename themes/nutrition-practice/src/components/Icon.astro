---
interface Props {
	name?: string | null;
}
const { name } = Astro.props;
---

{
	name === "bowl" ? (
		<svg class="i-bowl" width="50" height="40" viewBox="0 0 50 40" fill="none" aria-hidden="true" focusable="false">
			<path d="M5 20h40c0 9.500-8.500 16.500-20 16.500S5 29.500 5 20Z" stroke="currentColor" stroke-width="2.600" stroke-linejoin="round" />
			<path d="M15 19c-2-5 1-8 5-8 .5-3 5-4.500 7.500-1.800C31 7.500 36 9.500 35 14.500c2 1 2.500 3 1.500 4.500Z" fill="currentColor" />
			<path d="M31 6l6-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
		</svg>
	) : name === "heart" ? (
		<svg class="i-heart" width="42" height="40" viewBox="0 0 42 40" aria-hidden="true" focusable="false">
			<path d="M21 37C9 28.500 2 22 2 13.500 2 7.800 6.300 3.500 11.700 3.500c3.800 0 7.100 2.200 9.300 5.800 2.200-3.600 5.500-5.800 9.300-5.800C35.700 3.500 40 7.800 40 13.500 40 22 33 28.500 21 37Z" fill="currentColor" />
		</svg>
	) : (
		<svg class="i-leaf" width="40" height="48" viewBox="0 0 40 48" aria-hidden="true" focusable="false">
			<path d="M34.500 3C13 5 4 18 8.500 36c3.500 5.500 11 7 17 4.200C36 35.500 38.500 18 34.500 3Z" fill="currentColor" />
			<path d="M7 46C12 35 19 25 29 15" fill="none" stroke="currentColor" stroke-width="2.600" stroke-linecap="round" />
			<path d="M12.500 33C17 28.500 22 24 28.500 19.500" class="leaf-vein" fill="none" stroke-width="1.500" stroke-linecap="round" />
		</svg>
	)
}
