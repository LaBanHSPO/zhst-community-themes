---
/** Full-bleed hero: navy copy panel on the left, photograph blended in on the right. */
interface Props {
	photo?: string;
	alt: string;
	labelledby: string;
	class?: string;
}
const { photo, alt, labelledby, class: className } = Astro.props;
---

<section class:list={["hero", className]} aria-labelledby={labelledby}>
	{
		photo && (
			<div class="hero-media">
				<img src={photo} alt={alt} fetchpriority="high" />
			</div>
		)
	}
	<div class="hero-inner container">
		<div class="hero-copy">
			<slot />
		</div>
		<slot name="aside" />
	</div>
</section>
