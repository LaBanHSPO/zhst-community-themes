---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Badges from "../components/Badges.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import { getHighlights, getPlans, money, requestUrl } from "../lib/aircare";

const [plansResult, badges] = await Promise.all([getPlans(), getHighlights("plans")]);
if (Astro.cache?.enabled) {
	Astro.cache.set(plansResult.cacheHint);
	Astro.cache.set(badges.cacheHint);
}
const plans = plansResult.entries;
---

<Base title="Maintenance plans" description="Ongoing care for cleaner air, greater efficiency and lasting peace of mind with an Aircare maintenance plan.">
	<Hero photo="/images/hero-maintenance.webp" alt="An Aircare technician servicing the filters of a wall-mounted air conditioner" labelledby="plans-hero-title" class="hero-plans">
		<h1 id="plans-hero-title" class="display display-md">Keep your AC<br /><span class="accent">running at its best</span></h1>
		<p class="hero-lede">Ongoing care for cleaner air, greater efficiency and lasting peace of mind with an Aircare maintenance plan.</p>
		<Badges items={badges.entries} />
	</Hero>

	<section class="plans container" aria-labelledby="plans-title">
		<div class="plans-head">
			<div>
				<span class="eyebrow eyebrow-muted">Maintenance plans</span>
				<h2 id="plans-title" class="section-title">A plan for every home and business</h2>
			</div>
			<p>Choose the plan that suits your needs. All plans include professional servicing by Aircare technicians and a detailed system health check.</p>
		</div>
		<ul class="plan-grid">
			{
				plans.map((p) => (
					<li class:list={["plan", { "plan-featured": p.data.featured }]}>
						{p.data.featured && <p class="plan-badge">{p.data.badge || "Most popular"}</p>}
						<div class="plan-head">
							<span class="icon-disc icon-disc-static"><Icon name={p.data.icon ?? "house"} /></span>
							<div class="plan-name">
								<h3>{p.data.title}</h3>
								{p.data.summary && <p>{p.data.summary}</p>}
							</div>
							<p class="plan-price">
								<strong>{money(p.data.price)}</strong>
								<span>{p.data.period || "per year"}</span>
							</p>
						</div>
						<ul class="plan-list">
							{p.data.frequency && <li class="plan-meta"><Icon name="calendar" />{p.data.frequency}</li>}
							{p.data.units && <li class="plan-meta"><Icon name="unit" />{p.data.units}</li>}
							{p.data.inclusions?.map((i) => <li class="plan-check">{i.item}</li>)}
						</ul>
						<a class="btn btn-block btn-md" href={requestUrl("maintenance", p.data.title)}>
							Request plan <Arrow /><span class="sr-only"> {p.data.title}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Base>
