---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import { getBusiness, getHighlights, getPlans, getServices, money } from "../lib/aircare";

const [servicesResult, plansResult, strip, businessResult] = await Promise.all([
	getServices(),
	getPlans(),
	getHighlights("request"),
	getBusiness(),
]);
if (Astro.cache?.enabled) {
	for (const hint of [servicesResult.cacheHint, plansResult.cacheHint, strip.cacheHint, businessResult.cacheHint]) {
		Astro.cache.set(hint);
	}
}
const { business } = businessResult;
const services = servicesResult.entries.map((e) => e.data);

// Links from service and plan pages preselect the service (?service=cleaning) and name the plan (?plan=Plus).
const serviceParam = Astro.url.searchParams.get("service") ?? "";
const keyOf = (s: (typeof services)[number]) => s.slug ?? s.id;
const selected =
	services.find((s) => keyOf(s) === serviceParam) ?? services.find((s) => keyOf(s) === "repairs") ?? services[0];
const planParam = (Astro.url.searchParams.get("plan") ?? "").slice(0, 60);
const plan = plansResult.entries.find((p) => p.data.title.toLowerCase() === planParam.toLowerCase())?.data;
const prefill = plan ? `${plan.title} maintenance plan (${money(plan.price)} ${plan.period || "per year"}). ` : "";

const units = ["1 unit", "2 units", "3 units", "4 units", "5 units", "6 units", "More than 6 units"];
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Saigon" }).format(new Date());
const noJs = business.email ? `mailto:${business.email}` : undefined;
---

<Base title="Request a service" description="Tell us what you need and we'll take care of the rest. Quick, easy and hassle-free.">
	<div class="request-page">
		<div class="request-grid container">
			<div class="request-main">
				<h1 class="display display-dark">Request <span class="accent-bright">a service</span></h1>
				<p class="request-lede">Tell us what you need and we’ll take care of the rest. Quick, easy and hassle-free.</p>

				<form
					class="form-card"
					id="request-form"
					aria-label="Service request"
					data-mailto-form="request"
					data-email={business.email}
					action={noJs ? `${noJs}?subject=${encodeURIComponent("Service request")}` : undefined}
					method="post"
					enctype="text/plain"
				>
					<fieldset class="choice-set">
						<legend class="step-label">1. What service do you need?</legend>
						<div class="choice-grid">
							{
								services.map((s) => (
									<label class="choice">
										<input type="radio" name="service" value={s.form_title || s.title} checked={s === selected} required />
										<Icon name={s.icon ?? "wrench"} />
										<strong>{s.form_title || s.title}</strong>
										{s.form_text && <span>{s.form_text}</span>}
									</label>
								))
							}
						</div>
					</fieldset>

					<div class="form-row form-row-issue">
						<div class="field">
							<label class="step-label" for="r-units">2. Number of AC units</label>
							<div class="select">
								<select id="r-units" name="units">
									{units.map((u) => <option selected={u === "2 units"}>{u}</option>)}
								</select>
							</div>
						</div>
						<div class="field">
							<label class="step-label" for="r-issue">3. Describe the issue (optional)</label>
							<textarea id="r-issue" name="issue" rows="2" maxlength="1500" placeholder="e.g. not cooling, unusual noise, leaking, regular service, etc.">{prefill}</textarea>
						</div>
					</div>

					<fieldset class="field-set">
						<legend class="step-label">4. Your address</legend>
						<label class="sr-only" for="r-street">Street address</label>
						<input id="r-street" name="street" type="text" autocomplete="address-line1" placeholder="Street address" required />
						<div class="form-row">
							<label class="sr-only" for="r-suburb">Suburb</label>
							<input id="r-suburb" name="suburb" type="text" autocomplete="address-level2" placeholder="Suburb" required />
							<label class="sr-only" for="r-postcode">Postcode</label>
							<input id="r-postcode" name="postcode" type="text" inputmode="numeric" autocomplete="postal-code" placeholder="Postcode" maxlength="10" required />
						</div>
					</fieldset>

					<div class="form-row form-row-contact">
						<fieldset class="field-set">
							<legend class="step-label">5. Your contact details</legend>
							<div class="form-row">
								<label class="sr-only" for="r-name">Full name</label>
								<input id="r-name" name="name" type="text" autocomplete="name" placeholder="Full name" required />
								<label class="sr-only" for="r-phone">Phone number</label>
								<input id="r-phone" name="phone" type="tel" autocomplete="tel" placeholder="Phone number" required />
							</div>
							<label class="sr-only" for="r-email">Email address</label>
							<input id="r-email" name="email" type="email" autocomplete="email" placeholder="Email address" required />
						</fieldset>
						<div class="field">
							<label class="step-label" for="r-date">6. Preferred service date</label>
							<div class="date-input">
								<Icon name="calendar" />
								<input id="r-date" name="date" type="date" min={today} />
							</div>
						</div>
					</div>

					<button class="btn btn-md" type="submit">Request service <Arrow /></button>
					<p class="form-status" role="status" aria-live="polite" data-status>
						{
							business.email ? (
								<noscript>
									Without JavaScript, send your request by email to <a href={`mailto:${business.email}`}>{business.email}</a>.
								</noscript>
							) : (
								business.phone && <>Online requests are not available right now. Please call {business.phone}.</>
							)
						}
					</p>
				</form>
			</div>

			<aside class="callback-card" aria-labelledby="callback-title">
				<img src="/images/request-technician.webp" alt="An Aircare technician holding a tablet and looking up at a wall-mounted air conditioner" width="523" height="447" loading="lazy" />
				<div class="callback-body">
					<h2 id="callback-title">Need help? <span class="accent-blue">Request a callback.</span></h2>
					<p>Not sure what service you need? Leave your number and we’ll call you back for a quick, no-obligation chat.</p>
					<form
						class="callback-form"
						data-mailto-form="callback"
						data-email={business.email}
						action={noJs ? `${noJs}?subject=${encodeURIComponent("Callback request")}` : undefined}
						method="post"
						enctype="text/plain"
					>
						<label class="sr-only" for="cb-phone">Phone number for a callback</label>
						<div class="phone-input">
							<Icon name="phone" />
							<input id="cb-phone" name="phone" type="tel" autocomplete="tel" placeholder="Phone number" required />
						</div>
						<button class="btn btn-md" type="submit">Request a callback <Arrow /></button>
						<p class="form-status" role="status" aria-live="polite" data-status></p>
					</form>
				</div>
			</aside>
		</div>

		{
			strip.entries.length > 0 && (
				<ul class="strip" aria-label="Why Aircare">
					{strip.entries.map((h) => (
						<li>
							<Icon name={h.icon ?? "shield"} />
							<div>
								<strong>{h.title}</strong>
								{h.text && <span>{h.text}</span>}
							</div>
						</li>
					))}
				</ul>
			)
		}
	</div>
</Base>

<script>
	// Service and callback requests: compose an email to the business. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-mailto-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online requests are not available right now. Please call us instead.";
				return;
			}
			const data = new FormData(form);
			const get = (k: string) => String(data.get(k) ?? "").trim();
			let subject: string;
			let lines: string[];
			if (form.dataset.mailtoForm === "callback") {
				subject = "Callback request";
				lines = ["Hello,", "", "Please call me back about air conditioning service.", "", `Phone: ${get("phone")}`, ""];
			} else {
				subject = `Service request: ${get("service")} — ${get("suburb")}`;
				lines = [
					"Hello,",
					"",
					"I would like to request the following service.",
					"",
					`Service: ${get("service")}`,
					`Number of AC units: ${get("units")}`,
					`Issue: ${get("issue") || "Not described"}`,
					`Address: ${get("street")}, ${get("suburb")} ${get("postcode")}`,
					`Name: ${get("name")}`,
					`Phone: ${get("phone")}`,
					`Email: ${get("email")}`,
					`Preferred service date: ${get("date") || "Any"}`,
					"",
				];
			}
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this request ready to send. Nothing is sent until you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
