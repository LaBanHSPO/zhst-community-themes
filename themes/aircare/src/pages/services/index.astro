---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Hero from "../../components/Hero.astro";
import Icon from "../../components/Icon.astro";
import { getServices, learnMoreUrl, photoSrc, requestUrl } from "../../lib/aircare";

const servicesResult = await getServices();
if (Astro.cache?.enabled) Astro.cache.set(servicesResult.cacheHint);
const services = servicesResult.entries;
---

<Base title="Our services" description="From installation to ongoing maintenance, Aircare keeps your air conditioning running at its best.">
	<Hero photo="/images/hero-services.webp" alt="An Aircare technician reaching into an open wall-mounted air conditioner" labelledby="services-title" class="hero-services">
		<span class="eyebrow">Our services</span>
		<h1 id="services-title" class="display display-md">Complete AC services<br /><span class="accent">for every space.</span></h1>
		<p class="hero-lede">From installation to ongoing maintenance, Aircare keeps your air conditioning running at its best. Reliable service, cleaner air and greater efficiency for homes and businesses.</p>
	</Hero>

	<section class="section-cards section-cards-services container" aria-label="Services">
		<ul class="card-grid">
			{
				services.map((s) => {
					const src = photoSrc(s.data.image, s.data.photo);
					return (
						<li class="card card-service">
							<div class="card-media">
								{src && <img src={src} alt={s.data.image?.alt || `${s.data.title} by Aircare`} width="358" height="175" loading="lazy" />}
								<span class="icon-disc"><Icon name={s.data.icon ?? "wrench"} /></span>
							</div>
							<div class="card-body">
								<h2><a class="card-title-link" href={learnMoreUrl(s.data)}>{s.data.title}</a></h2>
								{s.data.summary && <p>{s.data.summary}</p>}
								{
									(s.data.checklist?.length ?? 0) > 0 && (
										<ul class="checklist">
											{s.data.checklist?.map((c) => <li>{c.item}</li>)}
										</ul>
									)
								}
								<a class="btn btn-block" href={requestUrl(s.data.slug ?? s.data.id)}>
									Request service <Arrow /><span class="sr-only"> for {s.data.title}</span>
								</a>
							</div>
						</li>
					);
				})
			}
		</ul>
	</section>
</Base>
