---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Badges from "../components/Badges.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import { getBusiness, getHighlights, getServices, learnMoreUrl, photoSrc, requestUrl, telHref } from "../lib/aircare";

const [servicesResult, badges, businessResult] = await Promise.all([getServices(), getHighlights("home"), getBusiness()]);
if (Astro.cache?.enabled) {
	for (const hint of [servicesResult.cacheHint, badges.cacheHint, businessResult.cacheHint]) Astro.cache.set(hint);
}
const { business } = businessResult;
const cards = servicesResult.entries.filter((s) => s.data.on_home).slice(0, 4);
---

<Base title="Comfort, all year round." description="Professional air conditioning services for cleaner air, greater efficiency and a more comfortable home or business.">
	<Hero photo="/images/hero-home.webp" alt="An Aircare technician in a navy cap and gloves lifting out the filter of a wall-mounted air conditioner" labelledby="home-title" class="hero-home">
		<h1 id="home-title" class="display">Comfort,<br /><span class="accent">all year round.</span></h1>
		<p class="hero-lede">Professional air conditioning services for cleaner air, greater efficiency and a more comfortable home or business.</p>
		<div class="hero-actions">
			<a class="btn btn-lg" href={requestUrl()}>Request service <Arrow /></a>
			{
				business.phone && (
					<a class="hero-phone" href={telHref(business.phone)}>
						<span class="hero-phone-ring"><Icon name="phone" /></span>
						<span>{business.phone}</span>
					</a>
				)
			}
		</div>
		<Badges items={badges.entries} />
	</Hero>

	<section class="section-cards container" aria-labelledby="services-title">
		<h2 id="services-title" class="sr-only">Our services</h2>
		<ul class="card-grid">
			{
				cards.map((s) => {
					const src = photoSrc(s.data.card_image, s.data.card_photo) ?? photoSrc(s.data.image, s.data.photo);
					return (
						<li class="card">
							<div class="card-media">
								{src && <img src={src} alt={s.data.card_image?.alt || `${s.data.title} by Aircare`} width="337" height="174" loading="lazy" />}
								<span class="icon-disc"><Icon name={s.data.card_icon ?? s.data.icon ?? "snowflake"} /></span>
							</div>
							<div class="card-body">
								<h3>{s.data.title}</h3>
								{s.data.summary && <p>{s.data.summary}</p>}
								<a class="link-arrow" href={learnMoreUrl(s.data)}>
									Learn more <Arrow /><span class="sr-only"> about {s.data.title}</span>
								</a>
							</div>
						</li>
					);
				})
			}
		</ul>
	</section>
</Base>
