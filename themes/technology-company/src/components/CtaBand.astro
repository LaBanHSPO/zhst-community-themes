---
/** Closing "get in touch" band shared by most pages. */
import Arrow from "./Arrow.astro";
import { telHref, type OfficeData } from "../lib/nexora";

interface Props {
	office: OfficeData;
	title?: string;
	text?: string;
}
const {
	office,
	title = "Let's build what comes next.",
	text = "Tell us where you want to go. A first conversation is free, practical and carries no obligation.",
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
	<div class="container cta-inner">
		<div>
			<span class="eyebrow eyebrow-light">Get in touch</span>
			<h2 id="cta-title">{title}</h2>
			<p>{text}</p>
		</div>
		<div class="cta-actions">
			<a class="btn btn-light btn-lg" href="/contact">Get in touch <Arrow /></a>
			<p class="cta-direct">
				{office.email && <a href={`mailto:${office.email}`}>{office.email}</a>}
				{office.phone && <a href={telHref(office.phone)}>{office.phone}</a>}
			</p>
		</div>
	</div>
</section>
