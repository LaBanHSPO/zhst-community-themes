---
/** Wordmark: gradient "N" mark and the site title. An uploaded site logo replaces both. */
interface Props {
	title: string;
	logo?: { url?: string; alt?: string } | null;
	class?: string;
}
const { title, logo, class: className } = Astro.props;
const uid = `nx${Math.random().toString(36).slice(2, 8)}`;
---

<a class:list={["wordmark", className]} href="/" aria-label={`${title}, home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt || title} />
		) : (
			<>
				<svg class="wordmark-mark" viewBox="0 0 32 29" width="32" height="29" aria-hidden="true" focusable="false">
					<defs>
						<linearGradient id={`${uid}a`} x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#5b6cff" />
							<stop offset="1" stop-color="#7cc8f8" />
						</linearGradient>
						<linearGradient id={`${uid}b`} x1="0" y1="0" x2="1" y2="1">
							<stop offset="0" stop-color="#9aa8ff" />
							<stop offset="1" stop-color="#8fd0fb" />
						</linearGradient>
						<linearGradient id={`${uid}c`} x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#2c3be6" />
							<stop offset="1" stop-color="#4a63ff" />
						</linearGradient>
					</defs>
					<rect x="22.5" y="0.5" width="9" height="28" rx="2.6" fill={`url(#${uid}c)`} />
					<rect x="0.5" y="0.5" width="9" height="28" rx="2.6" fill={`url(#${uid}a)`} />
					<path d="M3.2.5h4.4c1 0 1.9.5 2.4 1.3l15.8 24.3c.6 1-.1 2.4-1.3 2.4h-4.4c-1 0-1.9-.5-2.4-1.3L1.9 2.9C1.3 1.9 2 .5 3.2.5z" fill={`url(#${uid}b)`} opacity="0.92" />
				</svg>
				<span class="wordmark-title">{title}</span>
			</>
		)
	}
</a>
