---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { getOffice, getPrinciples } from "../lib/nexora";

const [pageResult, valuesResult, approachResult, officeResult] = await Promise.all([
	getEmDashEntry("pages", "about"),
	getPrinciples("values"),
	getPrinciples("approach"),
	getOffice(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(pageResult.cacheHint);
	Astro.cache.set(valuesResult.cacheHint);
	Astro.cache.set(approachResult.cacheHint);
	Astro.cache.set(officeResult.cacheHint);
}
const page = pageResult.entry;
const values = valuesResult.entries;
const steps = approachResult.entries;
const { office } = officeResult;
const title = page?.data.title ?? "About us";
---

<Base
	title="About"
	description={page?.data.intro ?? "Who we are and how we work."}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	<section class="page-head is-narrow">
		<div class="container page-head-inner">
			<span class="eyebrow">{page?.data.eyebrow ?? "About"}</span>
			<h1 {...page?.edit.title}>{title}</h1>
			{page?.data.intro && <p class="lede">{page.data.intro}</p>}
		</div>
	</section>

	<section class="section section-white">
		<div class="container about-intro">
			<div class="prose">
				{
					page?.data.content && page.data.content.length > 0 ? (
						<PortableText value={page.data.content} />
					) : (
						<p>Add a page with the slug “about” in the admin to tell your story here.</p>
					)
				}
			</div>
			<figure class="about-photo">
				<img
					src="/images/building-glass.webp"
					alt="Light pouring through the glass facade beneath a cantilevered concrete volume"
					width="748"
					height="706"
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	{
		values.length > 0 && (
			<section class="section section-tint" aria-labelledby="values-title">
				<div class="container">
					<div class="section-head">
						<div>
							<span class="eyebrow">What we value</span>
							<h2 id="values-title">The principles behind every project.</h2>
						</div>
					</div>
					<ul class="value-grid">
						{values.map((v, i) => (
							<li>
								<span class="value-num">{String(i + 1).padStart(2, "0")}</span>
								<h3 {...v.edit.title}>{v.data.title}</h3>
								{v.data.text && <p>{v.data.text}</p>}
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	{
		steps.length > 0 && (
			<section class="approach" aria-labelledby="approach-title">
				<div class="container approach-light">
					<div class="approach-copy">
						<span class="eyebrow eyebrow-light">How we work</span>
						<h2 id="approach-title">From possibility to progress.</h2>
						<p class="lede">One accountable team, a clear plan and steady delivery, shaped around your goals.</p>
					</div>
					<ol class="steps">
						{steps.map((step, i) => (
							<li>
								<span class="step-num">{String(i + 1).padStart(2, "0")}</span>
								<div>
									<h3 {...step.edit.title}>{step.data.title}</h3>
									{step.data.text && <p>{step.data.text}</p>}
								</div>
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	<CtaBand office={office} />
</Base>
