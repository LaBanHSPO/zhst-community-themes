---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<section class="notfound">
		<div class="container">
			<span class="notfound-code" aria-hidden="true">404</span>
			<span class="eyebrow">Page not found</span>
			<h1>This page hasn't been built yet.</h1>
			<p>The page you are looking for has moved or never existed. Let's get you back to what comes next.</p>
			<div class="actions">
				<a class="btn" href="/">Back to home</a>
				<a class="btn btn-outline-light" href="/solutions">Explore solutions</a>
			</div>
		</div>
	</section>
</Base>
