---
import StoryCard from "./StoryCard.astro";
import { photoAlt, photoSrc, postUrl, type Post } from "../lib/together";

interface Props {
	posts: Post[];
	emptyText?: string;
}
const { posts, emptyText = "No stories yet." } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">{emptyText}</p>
	) : (
		<ul class="news-grid" role="list">
			{posts.map((s) => (
				<li>
					<StoryCard
						title={s.title}
						excerpt={s.excerpt}
						date={s.date}
						href={postUrl(s)}
						photo={photoSrc(s.image, s.photo)}
						alt={photoAlt(s.image, s.photo_alt, s.title)}
						headingLevel={2}
					/>
				</li>
			))}
		</ul>
	)
}
