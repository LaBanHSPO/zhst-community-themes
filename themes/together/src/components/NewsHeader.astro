---
interface Props {
	eyebrow: string;
	title: string;
	lede?: string;
	terms: { slug: string; label: string }[];
	activeCategory?: string;
}
const { eyebrow, title, lede, terms, activeCategory } = Astro.props;
---

<header class="news-head">
	<p class="eyebrow eyebrow-strong">{eyebrow}</p>
	<h1 class="display display-page">{title}</h1>
	{lede && <p class="page-lede">{lede}</p>}
	{
		terms.length > 0 && (
			<nav class="filters filters-start" aria-label="News categories">
				<a class="filter" href="/posts" aria-current={!activeCategory ? "page" : undefined}>All news</a>
				{terms.map((t) => (
					<a class="filter" href={`/category/${t.slug}`} aria-current={activeCategory === t.slug ? "page" : undefined}>
						{t.label}
					</a>
				))}
			</nav>
		)
	}
</header>
