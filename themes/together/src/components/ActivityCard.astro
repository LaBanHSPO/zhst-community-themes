---
import Arrow from "./Arrow.astro";
import Icon from "./Icon.astro";
import { categoryIcon, categoryLabel } from "../lib/together";

interface Props {
	title: string;
	summary?: string | null;
	category: string;
	location?: string | null;
	schedule?: string | null;
	href: string;
	photo?: string;
	alt: string;
	headingLevel?: 2 | 3;
}
const { title, summary, category, location, schedule, href, photo, alt, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<article class="act-card">
	<div class="act-media">
		{photo ? <img src={photo} alt={alt} width="490" height="170" loading="lazy" /> : <div class="act-media-blank" />}
		<span class:list={["chip", `chip-${category}`]}><Icon name={categoryIcon(category)} /> {categoryLabel(category)}</span>
	</div>
	<div class="act-body">
		<Heading class="act-title">{title}</Heading>
		{summary && <p class="act-text">{summary}</p>}
		<div class="act-foot">
			<ul class="meta-list" role="list">
				{location && <li><Icon name="pin" /> {location}</li>}
				{schedule && <li><Icon name="calendar" /> {schedule}</li>}
			</ul>
			<a class="btn btn-sm" href={href}>Learn more<span class="sr-only"> about {title}</span> <Arrow /></a>
		</div>
	</div>
</article>
