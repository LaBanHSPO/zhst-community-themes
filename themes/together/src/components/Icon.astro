---
/** Line icons used across the theme. Decorative: always paired with visible text. */
interface Props {
	name?: string;
	class?: string;
}
const { name = "pin", class: cls } = Astro.props;
const paths: Record<string, string> = {
	search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/>',
	calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4M7.5 13h.01M12 13h.01M16.5 13h.01M7.5 16.5h.01M12 16.5h.01"/>',
	pin: '<path d="M12 21s-6.5-5.8-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.2 12 21 12 21z"/><circle cx="12" cy="10" r="2.4"/>',
	leaf: '<path d="M4.5 19.5C4 11 9 4.5 20 4c.4 10.5-5.6 15.7-14 15.5z"/><path d="M4.5 19.5c3-4.5 6.6-8 11-10.5"/>',
	people: '<circle cx="12" cy="8" r="3"/><path d="M6.5 19.5c.5-3.3 2.6-5.2 5.5-5.2s5 1.9 5.5 5.2"/><circle cx="5.2" cy="9.6" r="2.2"/><path d="M1.8 17.5c.3-2.2 1.6-3.6 3.4-3.9"/><circle cx="18.8" cy="9.6" r="2.2"/><path d="M22.2 17.5c-.3-2.2-1.6-3.6-3.4-3.9"/>',
	spark: '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.4 1.1 2.2v.5h5V16c0-.8.4-1.6 1.1-2.2A6 6 0 0 0 12 3z"/>',
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.4 2"/>',
	glove: '<path d="M7 21v-4.5L4.6 12.4a1.5 1.5 0 0 1 2.4-1.8L8.5 12V4.8a1.4 1.4 0 0 1 2.8 0V11"/><path d="M11.3 10.5V3.6a1.4 1.4 0 0 1 2.8 0v6.9"/><path d="M14.1 10.5V4.6a1.4 1.4 0 0 1 2.8 0v6.4"/><path d="M16.9 11V7a1.4 1.4 0 0 1 2.8 0v7.2c0 3.3-1.8 5-4.2 5.5V21"/><path d="M7 18h8.5"/>',
	bottle: '<path d="M10 2.5h4v3h-4z"/><path d="M10 5.5 8.5 8.2v11.8a1.5 1.5 0 0 0 1.5 1.5h4a1.5 1.5 0 0 0 1.5-1.5V8.2L14 5.5"/><path d="M8.5 11h7M8.5 16h7"/>',
	hat: '<path d="M6.5 14.5c0-4.3 2.4-7.5 5.5-7.5s5.5 3.2 5.5 7.5"/><path d="M2.5 16.5c0-1.4 4.3-2.3 9.5-2.3s9.5.9 9.5 2.3-4.3 2.4-9.5 2.4-9.5-1-9.5-2.4z"/><path d="M6.8 12.5c1.6.6 3.3.9 5.2.9s3.6-.3 5.2-.9"/>',
	bag: '<path d="M5 8h14l-1.2 12.5H6.2z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>',
	sprout: '<path d="M12 21v-9"/><path d="M12 12C12 7.5 9 5 4 5c0 4.6 3.1 7 8 7z"/><path d="M12 14.5c0-3.9 2.7-6.5 7.5-6.5 0 4-2.9 6.5-7.5 6.5z"/>',
	heart: '<path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.6 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/>',
	chevron: '<path d="m6 9 6 6 6-6"/>',
	back: '<path d="M20 12H4.5M10 6l-6 6 6 6"/>',
	arrow: '<path d="M4 12h15.5M14 6l6 6-6 6"/>',
	mail: '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
	phone: '<path d="M6.6 3.5h3l1.5 4-2 1.3a10.5 10.5 0 0 0 5.6 5.6l1.3-2 4 1.5v3a1.8 1.8 0 0 1-2 1.8A16.6 16.6 0 0 1 4.8 5.5a1.8 1.8 0 0 1 1.8-2z"/>',
	check: '<path d="m4.5 12.5 5 5 10-11"/>',
};
const body = paths[name] ?? paths.pin;
---

<svg
	class:list={["icon", `icon-${name}`, cls]}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.7"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={body}
/>
