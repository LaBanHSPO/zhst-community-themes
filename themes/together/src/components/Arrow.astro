---
/** Small right arrow used in buttons and text links. Decorative. */
interface Props {
	class?: string;
}
const { class: cls } = Astro.props;
---

<svg class:list={["arrow", cls]} width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
	<path d="M4 12h15.5M14 6l6 6-6 6"></path>
</svg>
