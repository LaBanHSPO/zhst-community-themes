---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getAssociation } from "../lib/together";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Force which primary-menu URL is marked current. */
	current?: string;
}

const { title, pageTitle, description, image, canonical, content, current } = Astro.props;
const [settingsResult, menuResult, associationResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getAssociation(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(associationResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menuItems = menuResult.data?.items ?? [];
const { association } = associationResult;

const norm = (url: string) => url.replace(/[?#].*$/, "").replace(/\/$/, "") || "/";
const firstSegment = (url: string) => norm(url).split("/")[1] ?? "";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
// Exact match first; otherwise the menu item in the same section (e.g. any /events/x -> Event detail).
const currentUrl =
	current ??
	menuItems.find((i) => norm(i.url) === path)?.url ??
	(path === "/" ? undefined : menuItems.find((i) => norm(i.url) !== "/" && firstSegment(i.url) === firstSegment(path))?.url);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Intl.DateTimeFormat("en-GB", { year: "numeric", timeZone: "Asia/Saigon" }).format(new Date());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Caveat:wght@700&family=Figtree:wght@400..800&display=swap"
			rel="stylesheet"
		/>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-head">
			<div class="head-inner">
				<a class="wordmark" href="/" aria-label={`${siteTitle} — homepage`}>
					{
						siteLogo ? (
							<img class="wordmark-img" src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						) : (
							<>
								<Logo />
								<span class="wordmark-text">
									<span class="wordmark-name">{siteTitle}</span>
									{siteTagline && <span class="wordmark-tag">{siteTagline}</span>}
								</span>
							</>
						)
					}
				</a>
				<nav class="nav" aria-label="Primary">
					{
						menuItems.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={item.url === currentUrl ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<div class="head-actions">
					<a class="head-search" href="/search" aria-label="Search the site">
						<Icon name="search" />
					</a>
					<a class="btn head-cta" href="/join">Join us</a>
				</div>
				<details class="mobile-nav">
					<summary>
						<svg width="22" height="14" viewBox="0 0 22 14" aria-hidden="true" focusable="false">
							<path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="2"></path>
						</svg>
						<span>Menu</span>
					</summary>
					<nav class="mobile-panel" aria-label="Primary (mobile)">
						{
							menuItems.map((item) => (
								<a href={item.url} aria-current={item.url === currentUrl ? "page" : undefined}>
									{item.label}
								</a>
							))
						}
						<a href="/search">Search</a>
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="container foot-inner">
				<div class="foot-brand">
					<a class="wordmark wordmark-light" href="/">
						<Logo />
						<span class="wordmark-text">
							<span class="wordmark-name">{siteTitle}</span>
							{siteTagline && <span class="wordmark-tag">{siteTagline}</span>}
						</span>
					</a>
					{association.footer_blurb && <p>{association.footer_blurb}</p>}
					<a class="btn btn-sm" href="/join">Join us</a>
				</div>
				<nav class="foot-col" aria-label="Footer">
					<h2>Explore</h2>
					{menuItems.map((item) => <a href={item.url}>{item.label}</a>)}
					<a href="/posts">All news</a>
				</nav>
				<div class="foot-col">
					<h2>Get in touch</h2>
					{association.address && <p>{association.address}</p>}
					{association.email && <a href={`mailto:${association.email}`}><Icon name="mail" /> {association.email}</a>}
					{association.phone && <a href={`tel:${association.phone.replace(/[^\d+]/g, "")}`}><Icon name="phone" /> {association.phone}</a>}
				</div>
			</div>
			<div class="container foot-bottom">
				<span>© {year} {siteTitle}. All rights reserved.</span>
				<span>Built with EmDash</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
