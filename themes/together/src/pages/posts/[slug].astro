---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import StoryCard from "../../components/StoryCard.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { entryKey, getStories, isoOf, photoAlt, photoSrc, postUrl, storyDateLong } from "../../lib/together";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.redirect("/404");

const [settings, recent] = await Promise.all([getSiteSettings(), getStories(4)]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(recent.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const p = post.data;
const heroSrc = photoSrc(p.image, p.photo);
const authorSrc = photoSrc(p.author_image, p.author_photo);
const related = recent.entries
	.map((r) => r.data)
	.filter((r) => entryKey(r) !== entryKey(p))
	.slice(0, 2);
const categories = p.terms?.category ?? [];
const tags = p.terms?.tag ?? [];
const iso = isoOf(p.date);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? p.dek ?? p.excerpt}
	canonical={seo.canonical}
	image={seo.ogImage ?? heroSrc}
	content={{ collection: "posts", id: p.id, slug }}
>
	<article class="story" aria-labelledby="story-title">
		<header class="container story-head">
			<p class="eyebrow eyebrow-strong">
				{categories[0] ? <a href={`/category/${categories[0].slug}`}>News story</a> : "News story"}
			</p>
			<h1 id="story-title" class="display display-story" {...post.edit.title}>{p.title}</h1>
			{p.dek && <p class="story-dek">{p.dek}</p>}
			{
				(p.author || iso) && (
					<div class="byline">
						{authorSrc && <img src={authorSrc} alt="" width="48" height="48" />}
						<p>
							{p.author && <span class="byline-name">By {p.author}</span>}
							{iso && <time datetime={iso}>{storyDateLong(p.date)}</time>}
						</p>
					</div>
				)
			}
		</header>

		{heroSrc && <img class="story-photo" src={heroSrc} alt={photoAlt(p.image, p.photo_alt, p.title)} width="1672" height="298" fetchpriority="high" />}

		<div class="container story-layout">
			<div class="story-body prose">
				<PortableText value={p.content} />
				{
					tags.length > 0 && (
						<ul class="tag-list" role="list" aria-label="Tags">
							{tags.map((t) => (
								<li><a href={`/tag/${t.slug}`}>#{t.label}</a></li>
							))}
						</ul>
					)
				}
			</div>

			{
				related.length > 0 && (
					<aside class="related" aria-labelledby="related-title">
						<div class="section-head">
							<h2 id="related-title" class="title-md">Related stories</h2>
							<a class="text-link" href="/posts">View all news <Arrow /></a>
						</div>
						<ul class="related-list" role="list">
							{related.map((r) => (
								<li>
									<StoryCard
										layout="row"
										title={r.title}
										excerpt={r.excerpt}
										date={r.date}
										href={postUrl(r)}
										photo={photoSrc(r.image, r.photo)}
										alt={photoAlt(r.image, r.photo_alt, r.title)}
									/>
								</li>
							))}
						</ul>
					</aside>
				)
			}
		</div>
	</article>
</Base>
