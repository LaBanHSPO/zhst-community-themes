---
import { getTaxonomyTermsWithCacheHint } from "emdash";
import Base from "../../layouts/Base.astro";
import NewsHeader from "../../components/NewsHeader.astro";
import NewsList from "../../components/NewsList.astro";
import { getStories } from "../../lib/together";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const [{ entries, cacheHint, nextCursor }, termsResult] = await Promise.all([
	getStories(12, cursor),
	getTaxonomyTermsWithCacheHint("category", { includeCounts: false }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(termsResult.cacheHint);
}
---

<Base title="News" description="Stories from our neighborhood: events, volunteers and the people making our streets greener and kinder.">
	<section class="container news-page">
		<NewsHeader
			eyebrow="News"
			title="Stories from the neighborhood"
			lede="Events, volunteers and the people making our streets greener, cleaner and kinder."
			terms={termsResult.data}
		/>
		<NewsList posts={entries.map((p) => p.data)} emptyText="Stories from the neighborhood are on their way." />
		<nav class="pager" aria-label="Pagination">
			{cursor && <a class="text-link" href="/posts">Newest stories</a>}
			{nextCursor && <a class="btn btn-sm" href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>Older stories</a>}
		</nav>
	</section>
</Base>
