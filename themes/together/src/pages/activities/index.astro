---
import Base from "../../layouts/Base.astro";
import ActivityCard from "../../components/ActivityCard.astro";
import ScriptWord from "../../components/ScriptWord.astro";
import { CATEGORIES, eventUrl, getActivities, getEvents, longDate, photoAlt, photoSrc, timeRange } from "../../lib/together";

const [activitiesResult, eventsResult] = await Promise.all([getActivities(), getEvents()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(activitiesResult.cacheHint);
	Astro.cache.set(eventsResult.cacheHint);
}

const filters = [...CATEGORIES.map((c) => ({ value: c.value as string, label: c.label })), { value: "events", label: "Events" }];
const requested = (Astro.url.searchParams.get("category") ?? "").trim();
const active = filters.some((f) => f.value === requested) ? requested : "";
const activeLabel = filters.find((f) => f.value === active)?.label;

const activities = activitiesResult.entries
	.map((a) => a.data)
	.filter((a) => !active || a.category === active);
const allEvents = eventsResult.entries.map((e) => e.data);
// A topic filter also narrows the events; "Events" lists every event and no ongoing projects.
const events = active && active !== "events" ? allEvents.filter((e) => e.category === active) : allEvents;
const showActivities = active !== "events";
const showEvents = active === "" || active === "events" || events.length > 0;
const nothing = activities.length === 0 && events.length === 0;

const activityHref = (a: (typeof activities)[number]) => {
	if (a.event && allEvents.some((e) => (e.slug ?? e.id) === a.event)) return eventUrl(a.event);
	return `/join?interest=${encodeURIComponent(a.title)}`;
};
---

<Base title={activeLabel ? `${activeLabel} activities` : "Activities"} description="From greener streets to skill sharing, our activities bring neighbors together to help make our neighborhood a great place to live, for everyone.">
	<section class="hero hero-split" aria-labelledby="hero-title">
		<img class="hero-photo" src="/images/hero-activities.webp" alt="Volunteers in Together T-shirts planting flowers in raised garden beds beside a colorful mural" width="982" height="372" fetchpriority="high" />
		<div class="hero-inner">
			<p class="eyebrow">Our activities</p>
			<h1 id="hero-title" class="display display-page">
				Neighbors building <br class="br-wide" />stronger communities <ScriptWord class="script-page" />
			</h1>
			<p class="page-lede">
				From greener streets to skill sharing, our activities bring neighbors together to help make our neighborhood a
				great place to live, for everyone.
			</p>
		</div>
	</section>

	<section class="container container-wide activities" aria-labelledby="ongoing-title">
		<div class="activities-head">
			<div>
				<h2 id="ongoing-title" class="title-xl">{active === "events" ? "Upcoming events" : "Ongoing activities"}</h2>
				<p class="section-sub">Get involved in the projects that keep our neighborhood vibrant, connected and welcoming.</p>
			</div>
			<nav class="filters" aria-label="Filter activities">
				<a class="filter" href="/activities" aria-current={active === "" ? "page" : undefined}>All activities</a>
				{
					filters.map((f) => (
						<a class="filter" href={`/activities?category=${f.value}`} aria-current={active === f.value ? "page" : undefined}>
							{f.label}
						</a>
					))
				}
			</nav>
		</div>

		{
			nothing && (
				<p class="empty">Nothing is listed under {activeLabel ?? "this topic"} right now. <a href="/activities">See all activities</a> or <a href="/join">tell us what you’d like to start</a>.</p>
			)
		}
		{
			showActivities &&
				activities.length > 0 && (
					<ul class="act-grid" role="list">
						{activities.map((a) => (
							<li>
								<ActivityCard
									title={a.title}
									summary={a.summary}
									category={a.category}
									location={a.location}
									schedule={a.schedule}
									href={activityHref(a)}
									photo={photoSrc(a.image, a.photo)}
									alt={photoAlt(a.image, a.photo_alt, a.title)}
								/>
							</li>
						))}
					</ul>
				)
		}

		{
			showEvents && !nothing && (
				<div class:list={["events-block", { "events-only": active === "events" }]}>
					{active !== "events" && <h2 class="title-lg events-title">Upcoming events</h2>}
					{events.length > 0 ? (
						<ul class="act-grid" role="list">
							{events.map((e) => (
								<li>
									<ActivityCard
										title={e.card_title || e.title}
										summary={e.summary}
										category={e.category}
										location={e.venue}
										schedule={`${longDate(e.starts_at)}, ${timeRange(e.starts_at, e.ends_at)}`}
										href={eventUrl(e)}
										photo={photoSrc(e.image, e.photo)}
										alt={photoAlt(e.image, e.photo_alt, e.title)}
									/>
								</li>
							))}
						</ul>
					) : (
						<p class="empty">No events are scheduled yet. <a href="/join">Join us</a> to hear about the next one.</p>
					)}
				</div>
			)
		}
	</section>
</Base>
