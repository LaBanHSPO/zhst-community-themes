---
import { search } from "emdash";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";

const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 100);
const urlFor: Record<string, string> = { posts: "/posts/", events: "/events/", pages: "/" };
const kindLabel: Record<string, string> = { posts: "News story", events: "Event", pages: "Page", activities: "Activity" };

type Hit = { href: string; title: string; kind: string; snippet?: string };
let hits: Hit[] = [];
let failed = false;
if (q) {
	try {
		const result = await search(q, { collections: ["posts", "events", "activities", "pages"], limit: 20 });
		hits = result.items.map((item) => ({
			href: item.collection === "activities" ? "/activities" : `${urlFor[item.collection] ?? "/"}${encodeURIComponent(item.slug ?? item.id)}`,
			title: item.title || "Untitled",
			kind: kindLabel[item.collection] ?? "Page",
			// Title-only matches return the title as the snippet; skip it to avoid repeating the heading.
			snippet:
				item.snippet && item.snippet.replace(/<\/?mark>/g, "").trim() !== (item.title ?? "").trim() ? item.snippet : undefined,
		}));
	} catch (error) {
		console.error("Search failed", error);
		failed = true;
	}
}
---

<Base title={q ? `Search: ${q}` : "Search"} description="Search news stories, events, activities and pages.">
	<section class="container search-page" aria-labelledby="search-title">
		<p class="eyebrow eyebrow-strong">Search</p>
		<h1 id="search-title" class="display display-page">Find stories, events and activities</h1>
		<form class="search-form" action="/search" method="get" role="search">
			<label class="sr-only" for="s-q">Search the site</label>
			<span class="control control-lead">
				<Icon name="search" class="lead-icon" />
				<input id="s-q" name="q" type="search" value={q} placeholder="Try “garden” or “block party”" maxlength="100" />
			</span>
			<button class="btn" type="submit">Search</button>
		</form>
		{
			q && (
				<div class="search-results" aria-live="polite">
					{failed ? (
						<p class="empty">Search is unavailable right now. Browse <a href="/activities">activities</a> or <a href="/posts">news</a> instead.</p>
					) : hits.length === 0 ? (
						<p class="empty">No results for “{q}”. Browse <a href="/activities">activities</a> or <a href="/posts">news</a>.</p>
					) : (
						<>
							<p class="results-count">{hits.length} {hits.length === 1 ? "result" : "results"} for “{q}”</p>
							<ul class="results" role="list">
								{hits.map((h) => (
									<li>
										<p class="result-kind">{h.kind}</p>
										<h2 class="result-title"><a href={h.href}>{h.title} <Arrow /></a></h2>
										{h.snippet && <p class="result-snippet" set:html={h.snippet} />}
									</li>
								))}
							</ul>
						</>
					)}
				</div>
			)
		}
	</section>
</Base>
