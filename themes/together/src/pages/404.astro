---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ScriptWord from "../components/ScriptWord.astro";
---

<Base title="Page not found">
	<section class="notfound container" aria-labelledby="nf-title">
		<p class="eyebrow eyebrow-strong">Error 404</p>
		<h1 id="nf-title" class="display display-page">This page has moved on, <ScriptWord text="neighbor." class="script-page" /></h1>
		<p class="page-lede">The page you’re looking for doesn’t exist or has moved. See what’s happening in the neighborhood or find a way to get involved.</p>
		<div class="actions">
			<a class="btn btn-lg" href="/activities">See our activities <Arrow /></a>
			<a class="text-link" href="/join">Join us <Arrow /></a>
		</div>
	</section>
</Base>
