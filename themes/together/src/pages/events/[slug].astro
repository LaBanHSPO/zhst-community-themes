---
import { getEmDashEntry, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Icon from "../../components/Icon.astro";
import { entryKey, isoOf, lines, longDate, paragraphs, photoAlt, photoSrc, timeRange } from "../../lib/together";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry, cacheHint } = await getEmDashEntry("events", slug);
if (!entry) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const e = entry.data;
// The detail photo falls back to the card photo when no separate detail photo is set.
const heroSrc = photoSrc(e.hero_image, e.hero_photo) ?? photoSrc(e.image, e.photo);
const heroAlt = e.hero_image?.alt || e.hero_alt || photoAlt(e.image, e.photo_alt, e.title);
const bandSrc = photoSrc(e.band_image, e.band_photo);
const about = paragraphs(e.about);
const address = lines(e.address);
const agenda = e.agenda ?? [];
const bring = e.bring ?? [];
const bringIcons: Record<string, string> = { gloves: "glove", bottle: "bottle", hat: "hat", bag: "bag", shoes: "sprout" };
const register = `/join?event=${encodeURIComponent(entryKey(e))}`;
---

<Base title={e.title} description={e.intro ?? e.summary} image={heroSrc} content={{ collection: "events", id: e.id, slug: e.slug }}>
	<section class="event-top" aria-labelledby="event-title">
		<div class="event-intro">
			<a class="back-link" href="/activities"><Icon name="back" /> All activities</a>
			<h1 id="event-title" class="display display-event" {...entry.edit.title}>{e.title}</h1>
			{e.intro && <p class="event-lede">{e.intro}</p>}
			<div class="event-facts">
				<div class="event-fact">
					<Icon name="calendar" class="fact-icon" />
					<p>
						<strong><time datetime={isoOf(e.starts_at)}>{longDate(e.starts_at)}</time></strong>
						<span>{timeRange(e.starts_at, e.ends_at)}</span>
					</p>
				</div>
				<div class="event-fact">
					<Icon name="pin" class="fact-icon" />
					<p>
						<strong>{e.venue}</strong>
						{address.map((l) => <span>{l}</span>)}
					</p>
				</div>
			</div>
			<a class="btn btn-lg" href={register}>Register for this event <Arrow /></a>
		</div>
		{heroSrc && <img class="event-photo" src={heroSrc} alt={heroAlt} width="994" height="476" fetchpriority="high" />}
	</section>

	<div class="event-body container">
		{
			about.length > 0 && (
				<section class="event-about" aria-labelledby="about-title">
					<h2 id="about-title" class="title-md">About this event</h2>
					{about.map((p) => <p>{p}</p>)}
				</section>
			)
		}
		{
			agenda.length > 0 && (
				<section class="event-agenda" aria-labelledby="agenda-title">
					<h2 id="agenda-title" class="title-md">Agenda</h2>
					<ol class="agenda" role="list">
						{agenda.map((a) => (
							<li>
								<span class="agenda-time">{a.time}</span>
								<span class="agenda-item">{a.item}</span>
							</li>
						))}
					</ol>
				</section>
			)
		}
		{
			bring.length > 0 && (
				<section class="event-bring" aria-labelledby="bring-title">
					<h2 id="bring-title" class="title-md">What to bring</h2>
					<ul class="bring" role="list">
						{bring.map((b) => (
							<li>
								<span class="bring-icon"><Icon name={bringIcons[b.icon ?? ""] ?? "bag"} /></span>
								<span>
									{b.item}
									{b.detail && <><br />{b.detail}</>}
								</span>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>

	{
		(e.welcome_title || e.welcome_text) && (
			<section class="container welcome-band" aria-labelledby="welcome-title">
				<span class="welcome-icon"><Icon name="sprout" /></span>
				<div class="welcome-copy">
					<h2 id="welcome-title" class="title-sm">{e.welcome_title || "Everyone is welcome"}</h2>
					{e.welcome_text && <p>{e.welcome_text}</p>}
				</div>
				{bandSrc && <img class="welcome-photo" src={bandSrc} alt={photoAlt(e.band_image, e.band_alt, "")} width="446" height="104" loading="lazy" />}
			</section>
		)
	}

</Base>
