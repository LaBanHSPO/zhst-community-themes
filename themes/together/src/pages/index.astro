---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import ScriptWord from "../components/ScriptWord.astro";
import StoryCard from "../components/StoryCard.astro";
import {
	categoryIcon,
	categoryLabel,
	eventUrl,
	getEvents,
	getStories,
	isoOf,
	photoAlt,
	photoSrc,
	postUrl,
	shortDay,
	timeRange,
} from "../lib/together";

const [eventsResult, storiesResult] = await Promise.all([getEvents(), getStories(2)]);
if (Astro.cache?.enabled) {
	Astro.cache.set(eventsResult.cacheHint);
	Astro.cache.set(storiesResult.cacheHint);
}

const events = eventsResult.entries.map((e) => e.data);
const now = Date.now();
// The homepage feature flag wins; otherwise the next event that has not started yet; otherwise the first.
const featured =
	events.find((e) => e.home_featured) ?? events.find((e) => new Date(e.starts_at).getTime() >= now) ?? events[0];
const stories = storiesResult.entries.map((p) => p.data);
---

<Base title="A better neighborhood, together" description="Stronger neighbors. Greener streets. Brighter tomorrows. A community of residents working together to make our neighborhood a great place to live, for everyone.">
	<section class="hero hero-home" aria-labelledby="hero-title">
		<img class="hero-blur" src="/images/hero-home.webp" alt="" aria-hidden="true" width="98" height="50" />
		<img class="hero-photo" src="/images/hero-home.webp" alt="A smiling volunteer in a Together T-shirt hands a potted plant to a neighbor at a community event" width="982" height="500" fetchpriority="high" />
		<div class="hero-inner">
			<h1 id="hero-title" class="display display-hero">
				A better <br class="br-wide" />neighborhood, <ScriptWord class="script-hero" />
			</h1>
			<p class="hero-lede">
				Stronger neighbors. Greener streets. Brighter tomorrows. We’re a community of residents working together to
				make our neighborhood a great place to live, for everyone.
			</p>
			<a class="btn btn-lg" href="/join">Join us <Arrow /></a>
		</div>
	</section>

	<div class="home-lower container">
		<section class="home-upcoming" aria-labelledby="upcoming-title">
			<div class="section-head">
				<h2 id="upcoming-title" class="title-lg">Upcoming activity</h2>
				<a class="text-link" href="/activities">View all activities <Arrow /></a>
			</div>
			{
				featured ? (
					<article class="upcoming-card">
						{photoSrc(featured.image, featured.photo) && (
							<img
								class="upcoming-img"
								src={photoSrc(featured.image, featured.photo)}
								alt={photoAlt(featured.image, featured.photo_alt, featured.title)}
								width="358"
								height="242"
								loading="lazy"
							/>
						)}
						<div class="upcoming-body">
							<p class="upcoming-when">
								<Icon name="calendar" />
								<time datetime={isoOf(featured.starts_at)}>
									{shortDay(featured.starts_at)} · {timeRange(featured.starts_at, featured.ends_at)}
								</time>
							</p>
							<h3 class="upcoming-title">{featured.card_title || featured.title}</h3>
							{featured.summary && <p class="upcoming-text">{featured.summary}</p>}
							<ul class="meta-list meta-inline" role="list">
								<li><Icon name="pin" /> {featured.venue}</li>
								<li><Icon name={categoryIcon(featured.category)} /> {categoryLabel(featured.category)}</li>
							</ul>
							<a class="btn" href={eventUrl(featured)}>
								Learn more<span class="sr-only"> about {featured.card_title || featured.title}</span> <Arrow />
							</a>
						</div>
					</article>
				) : (
					<p class="empty">New activities are being planned. <a href="/join">Join us</a> to hear about them first.</p>
				)
			}
		</section>

		<section class="home-stories" aria-labelledby="stories-title">
			<div class="section-head">
				<h2 id="stories-title" class="title-lg">Latest stories</h2>
				<a class="text-link" href="/posts">View all news <Arrow /></a>
			</div>
			{
				stories.length > 0 ? (
					<div class="home-story-grid">
						{stories.map((s) => (
							<StoryCard
								title={s.title}
								excerpt={s.excerpt}
								date={s.date}
								href={postUrl(s)}
								photo={photoSrc(s.image, s.photo)}
								alt={photoAlt(s.image, s.photo_alt, s.title)}
							/>
						))}
					</div>
				) : (
					<p class="empty">Stories from the neighborhood are on their way.</p>
				)
			}
		</section>
	</div>
</Base>
