					"title": "Saturday at the community garden",
					"card_title": "Saturday at the Community Garden",
					"category": "environment",
					"summary": "Plant seasonal flowers and vegetables, tidy the garden beds and share coffee with your neighbors.",
					"intro": "Join your neighbors for a morning of gardening, learning and connection. We’ll plant seasonal flowers and vegetables, tidy the garden beds, and enjoy coffee and conversation together.",
					"starts_at": "2025-04-26T09:00:00+07:00",
					"ends_at": "2025-04-26T12:00:00+07:00",
					"venue": "Riverview Park Community Garden",
					"address": "125 Maple St, Riverside",
					"about": "Our community garden is a place to grow fresh food, greener streets and stronger connections. All are welcome — whether you’re an experienced gardener or just curious. Come lend a hand and be part of a healthier, more vibrant neighborhood.",
					"agenda": [
						{
							"time": "9:00 AM",
							"item": "Welcome & coffee"
						},
						{
							"time": "9:15 AM",
							"item": "Garden orientation and tasks"
