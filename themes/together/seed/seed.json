		"posts": [
			{
				"id": "block-party",
				"slug": "neighbors-turn-out-for-a-brighter-block-party",
				"status": "published",
				"taxonomies": {
					"category": [
						"community"
					],
					"tag": [
						"events",
						"block-party"
					]
				},
				"data": {
					"title": "Neighbors Turn Out for a Brighter Block Party",
					"date": "2025-04-12T10:00:00+07:00",
					"author": "Daniel Brooks",
					"dek": "Music, food stalls and plenty of conversation brought the whole street outside for an afternoon.",
					"excerpt": "Good food, great conversations and a stronger sense of community filled this year’s block party.",
					"photo": "/images/story-block-party.webp",
					"photo_alt": "Neighbors laughing together under colorful bunting at the block party",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "k8",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k9",
									"text": "Under strings of colorful bunting, neighbors set up tables, shared home-cooked dishes and caught up with people they usually only wave to on the way to work.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "k10",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k11",
									"text": "Volunteers ran a lost-and-found for keys and toys, a table for signing up to upcoming activities and a corner where children painted a banner for the community garden.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "k12",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k13",
									"text": "“The best part was meeting the family that moved in across the road,” said one resident. “We’ve lived three doors apart for a year.”",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "h2",
							"_key": "k14",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k15",
									"text": "Thank you",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "k16",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k17",
									"text": "Thank you to everyone who brought food, lent a table or stayed to help clean up. Want to help plan the next one? Join us and tick Community events.",
									"marks": []
								}
							]
						}
					]
				}
			},
			{
