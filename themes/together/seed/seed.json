						},
						{
							"time": "11:30 AM",
							"item": "Wrap-up and community chat"
						},
						{
							"time": "12:00 PM",
							"item": "Event ends"
						}
					],
					"bring": [
						{
							"item": "Garden gloves",
							"detail": "(if you have them)",
							"icon": "gloves"
						},
						{
