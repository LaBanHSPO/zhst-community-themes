					"welcome_title": "Everyone is welcome",
					"welcome_text": "Tools, gloves and seedlings will be provided. Come for the gardening, stay for the good company!",
					"photo": "/images/event-garden.webp",
					"photo_alt": "A smiling volunteer and a boy planting seedlings in a raised bed while neighbors garden behind them",
					"band_photo": "/images/event-welcome.webp",
