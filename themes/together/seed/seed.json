				"data": {
					"title": "A Greener, Healthier Neighborhood",
					"date": "2025-04-05T12:00:00+07:00",
					"author": "Priya Nair",
					"dek": "Blossoming street trees, cared-for flower beds and cleaner sidewalks are changing how our streets feel.",
					"excerpt": "New trees, cleaner streets and more green spaces are helping our community thrive.",
					"photo": "/images/story-greener.webp",
					"photo_alt": "Blossoming trees line a quiet street beside a colorful mural",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "k18",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k19",
									"text": "This spring the trees our volunteers planted along the avenue flowered for the first time, framing the mural that neighbors painted together last summer.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "k20",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k21",
									"text": "Monthly cleanups keep the sidewalks and the park clear, and our garden team now looks after flower beds at three street corners.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "k22",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k23",
									"text": "Green spaces only stay green with care. If you can spare an hour a month, the Neighborhood Cleanup and Community Garden teams would love to meet you.",
									"marks": []
								}
							]
						}
					]
				}
			},
			{
				"id": "place-to-grow",
				"slug": "a-place-to-grow-together",
				"status": "published",
				"taxonomies": {
					"category": [
						"environment"
					],
					"tag": [
						"trees",
						"volunteers"
					]
				},
				"data": {
					"title": "A place to grow, together",
					"date": "2025-04-05T09:00:00+07:00",
					"author": "Maya Chen",
					"author_photo": "/images/author-maya.webp",
					"dek": "New trees, cleaner streets and stronger connections are helping our neighborhood thrive — one block at a time.",
					"excerpt": "New trees, cleaner streets and stronger connections are helping our neighborhood thrive — one block at a time.",
					"photo": "/images/story-grow.webp",
					"photo_alt": "Volunteers and children planting young trees in a sunny park beside a colorful mural",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "k24",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k25",
									"text": "On a sunny Saturday morning, neighbors of all ages gathered at Riverview Park with shovels, gloves and a shared goal: a greener, healthier neighborhood for everyone.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "k26",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k27",
									"text": "The community tree planting event brought together long-time residents, new families and local volunteers to plant more than 30 native trees along our streets and in the park. Beyond the trees, it was a chance to connect, share stories and strengthen the bonds that make our neighborhood special.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "k28",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k29",
									"text": "“It’s amazing to see so many people come out and care about where we live,” said Ana Torres, a longtime resident and event volunteer. “Planting trees isn’t just about the environment — it’s about investing in our community’s future, together.”",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "h2",
							"_key": "k30",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k31",
									"text": "Roots that last",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "k32",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k33",
									"text": "Each young tree was given a water bag and a neighbor who promised to look after it through its first summer. Children painted name tags for the trees they planted, and several families have already been back to check on “their” tree.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "k34",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k35",
									"text": "The planting is part of a wider effort to make our streets cooler and more welcoming. Over the coming months the garden team will add new flower beds near the community center, and the monthly cleanup will keep the paths around the new trees clear.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "h2",
							"_key": "k36",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k37",
									"text": "How you can help",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "k38",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k39",
									"text": "Our next planting morning is coming up soon, and no experience is needed: we provide tools, gloves and saplings. If you’d rather help in other ways, we also need people to water trees during dry spells and to welcome newcomers on the day.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "k40",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k41",
									"text": "Small actions, repeated by many neighbors, add up. We hope to see you at the next one.",
									"marks": []
								}
							]
						}
					]
				}
			}
		],
