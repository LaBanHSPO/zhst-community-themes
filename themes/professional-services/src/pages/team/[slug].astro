---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Monogram from "../../components/Monogram.astro";
import PersonCard from "../../components/PersonCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getOffice, getPeople, lines } from "../../lib/practice";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: person, cacheHint } = await getEmDashEntry("people", slug);
if (!person) return Astro.rewrite("/404");

const [peopleResult, officeResult, settings] = await Promise.all([getPeople(), getOffice(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(peopleResult.cacheHint);
	Astro.cache.set(officeResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(person, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const focus = lines(person.data.focus);
const colleagues = peopleResult.entries.filter((p) => p.data.id !== person.data.id).slice(0, 3);
const { office } = officeResult;
const firstName = person.data.title.split(/\s+/)[0] ?? person.data.title;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? person.data.summary ?? `${person.data.title}, ${person.data.role}`}
	canonical={seo.canonical}
	content={{ collection: "people", id: person.data.id, slug }}
	current="/team"
>
	<section class="detail-head">
		<div class="container">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/team">Our team</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{person.data.title}</span>
			</nav>
			<div class="profile-head">
				<Monogram name={person.data.title} tone={person.data.tone} size="lg" />
				<div>
					<p class="person-role">{person.data.role}</p>
					<h1 {...person.edit.title}>{person.data.title}</h1>
					<span class="rule" aria-hidden="true"></span>
					{person.data.summary && <p class="lede">{person.data.summary}</p>}
				</div>
			</div>
		</div>
	</section>

	<section class="detail-body">
		<div class="container detail-grid">
			<div class="prose">
				{
					person.data.content && person.data.content.length > 0 ? (
						<PortableText value={person.data.content} />
					) : (
						person.data.summary && <p>{person.data.summary}</p>
					)
				}
			</div>
			<aside class="detail-aside" aria-label="Focus areas">
				{
					focus.length > 0 && (
						<>
							<h2>Focus areas</h2>
							<ul class="outcomes">
								{focus.map((f) => (
									<li>{f}</li>
								))}
							</ul>
						</>
					)
				}
				<a class="btn btn-block" href={`/contact?with=${encodeURIComponent(person.data.title)}`}>Talk to {firstName} <Arrow /></a>
				<a class="link-arrow" href="/team">All team members <Arrow /></a>
			</aside>
		</div>
	</section>

	{
		colleagues.length > 0 && (
			<section class="section section-warm" aria-labelledby="colleagues-title">
				<div class="container">
					<span class="eyebrow">Colleagues</span>
					<h2 id="colleagues-title" class="section-title">Working alongside {firstName}.</h2>
					<span class="rule" aria-hidden="true"></span>
					<div class="team-grid team-grid-3">
						{colleagues.map((p) => (
							<PersonCard person={p} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<CtaBand office={office} />
</Base>
