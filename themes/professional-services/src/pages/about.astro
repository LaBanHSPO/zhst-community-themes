---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import CtaBand from "../components/CtaBand.astro";
import { getOffice, getValues, indexLabel } from "../lib/practice";

const [pageResult, valuesResult, officeResult] = await Promise.all([
	getEmDashEntry("pages", "about"),
	getValues(),
	getOffice(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(pageResult.cacheHint);
	Astro.cache.set(valuesResult.cacheHint);
	Astro.cache.set(officeResult.cacheHint);
}
const page = pageResult.entry;
const values = valuesResult.entries;
const { office } = officeResult;
---

<Base
	title="About"
	description={page?.data.intro ?? "Who we are and how we work."}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	<section class="page-head">
		<div class="container page-head-inner">
			<div>
				<span class="eyebrow">{page?.data.eyebrow || "About"}</span>
				<h1 {...page?.edit.title}>{page?.data.title ?? "About us"}</h1>
				<span class="rule" aria-hidden="true"></span>
			</div>
			{page?.data.intro && <p class="lede">{page.data.intro}</p>}
		</div>
	</section>

	<section class="about-feature">
		<div class="container about-feature-inner">
			<figure class="about-photo">
				<img
					src="/images/model-review.webp"
					alt="Four advisers studying an architectural model on a table covered in plans, with the city at sunset behind them"
					width="1448"
					height="1086"
					loading="lazy"
					decoding="async"
				/>
			</figure>
			<aside class="about-note">
				<p class="eyebrow"><span>Ideas</span> <span>People</span> <span>Places</span> <span>Progress</span></p>
				<span class="rule" aria-hidden="true"></span>
			</aside>
		</div>
	</section>

	{
		page?.data.content && page.data.content.length > 0 && (
			<section class="section">
				<div class="container about-body">
					<div>
						<span class="eyebrow">Our story</span>
					</div>
					<div class="prose">
						<PortableText value={page.data.content} />
					</div>
				</div>
			</section>
		)
	}

	{
		values.length > 0 && (
			<section class="section section-warm" aria-labelledby="values-title">
				<div class="container">
					<span class="eyebrow">What we value</span>
					<h2 id="values-title" class="section-title">How we work with you.</h2>
					<span class="rule" aria-hidden="true"></span>
					<ol class="value-grid">
						{values.map((v, i) => (
							<li class="value-item">
								<span class="value-num">{indexLabel(i)}</span>
								<h3 {...v.edit.title}>{v.data.title}</h3>
								{v.data.text && <p>{v.data.text}</p>}
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	<section class="section about-split">
		<div class="container about-split-inner">
			<figure>
				<img
					src="/images/terrace-office.webp"
					alt="A concrete and glass office pavilion with a lit meeting room, seen from a rooftop terrace at dusk"
					width="700"
					height="698"
					loading="lazy"
					decoding="async"
				/>
			</figure>
			<div>
				<span class="eyebrow">Our team</span>
				<h2 class="section-title">Senior people, close to the work.</h2>
				<span class="rule" aria-hidden="true"></span>
				<p class="lede">Every engagement is led by an adviser who has done the work before and stays with it until the change has taken hold.</p>
				<a class="btn" href="/team">Meet our team <Arrow /></a>
			</div>
		</div>
	</section>

	<CtaBand office={office} title="Let’s talk about what comes next." />
</Base>
