---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import CtaBand from "../../components/CtaBand.astro";
import { entryHref, getOffice, getServices, getValues, indexLabel, photoSrc } from "../../lib/practice";

const [servicesResult, valuesResult, officeResult] = await Promise.all([getServices(), getValues(), getOffice()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(servicesResult.cacheHint);
	Astro.cache.set(valuesResult.cacheHint);
	Astro.cache.set(officeResult.cacheHint);
}
const services = servicesResult.entries;
const values = valuesResult.entries.slice(0, 4);
const { office } = officeResult;
---

<Base title="Services" description="Advisory, people and organization, places and infrastructure, governance and risk: how Northbridge can help.">
	<section class="page-head">
		<div class="container page-head-inner">
			<div>
				<span class="eyebrow">Services</span>
				<h1>Advice you can act on.</h1>
				<span class="rule" aria-hidden="true"></span>
			</div>
			<p class="lede">
				We work with leadership teams, public bodies and community organizations on the decisions that shape them for years. Each practice is led by senior advisers and staffed from one shared team.
			</p>
		</div>
	</section>

	<section class="section section-flush">
		<div class="container">
			{services.length === 0 && <p class="empty">Services will appear here once they are added in the admin.</p>}
			<div class="service-features">
				{
					services.map((s, i) => {
						const src = photoSrc(s.data.image, s.data.photo);
						return (
							<article class:list={["service-feature", { "is-flipped": i % 2 === 1 }]}>
								<figure class="service-feature-photo">
									{src ? <img src={src} alt={s.data.image?.alt ?? ""} loading={i === 0 ? "eager" : "lazy"} decoding="async" /> : <span class="photo-empty" />}
								</figure>
								<div class="service-feature-body">
									<span class="service-num">{indexLabel(i)}</span>
									<h2 {...s.edit.title}>
										<a href={entryHref("/services", s.data)}>{s.data.title}</a>
									</h2>
									<p class="summary">{s.data.summary}</p>
									{s.data.intro && <p>{s.data.intro}</p>}
									<span class="link-arrow" aria-hidden="true">Explore the service <Arrow /></span>
								</div>
							</article>
						);
					})
				}
			</div>
		</div>
	</section>

	{
		values.length > 0 && (
			<section class="section section-dark" aria-labelledby="how-title">
				<div class="container">
					<span class="eyebrow eyebrow-light">How we work</span>
					<h2 id="how-title" class="section-title">The same principles on every engagement.</h2>
					<span class="rule" aria-hidden="true"></span>
					<ol class="value-grid">
						{values.map((v, i) => (
							<li class="value-item">
								<span class="value-num">{indexLabel(i)}</span>
								<h3>{v.data.title}</h3>
								{v.data.text && <p>{v.data.text}</p>}
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	<CtaBand office={office} />
</Base>
