---
import Arrow from "./Arrow.astro";
import { telHref, type OfficeData } from "../lib/practice";

interface Props {
	office: OfficeData;
	title?: string;
	text?: string;
}
const {
	office,
	title = "Start with a conversation.",
	text = "Tell us what you are working on. A first conversation is informal, confidential and free of charge.",
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
	<img class="cta-photo" src="/images/city-dusk.webp" alt="" width="900" height="560" loading="lazy" decoding="async" />
	<div class="container cta-inner">
		<div>
			<span class="eyebrow eyebrow-light">Contact</span>
			<h2 id="cta-title">{title}</h2>
			<span class="rule" aria-hidden="true"></span>
			<p>{text}</p>
		</div>
		<div class="cta-actions">
			<a class="btn btn-light btn-lg" href="/contact">Get in touch <Arrow /></a>
			<div class="cta-direct">
				{office.phone && <a href={telHref(office.phone)}>{office.phone}</a>}
				{office.email && <a href={`mailto:${office.email}`}>{office.email}</a>}
			</div>
		</div>
	</div>
</section>
