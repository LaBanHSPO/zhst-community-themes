---
import { articleDate, entryHref, formatDate, photoSrc, type Insight } from "../lib/practice";

interface Props {
	post: { id: string; data: Insight; edit: Record<string, Record<string, unknown>> };
}
const { post } = Astro.props;
const href = entryHref("/insights", post.data);
const src = photoSrc(post.data.featured_image, post.data.photo);
const date = articleDate(post.data.date, post.data.publishedAt);
---

<article class="insight-card">
	<div class="insight-photo">
		{src ? <img src={src} alt={post.data.featured_image?.alt ?? ""} loading="lazy" decoding="async" /> : <span class="photo-empty" />}
	</div>
	<div class="insight-body">
		<p class="meta">
			{post.data.topic && <span class="topic">{post.data.topic}</span>}
			{date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
		</p>
		<h3 {...post.edit.title}><a href={href}>{post.data.title}</a></h3>
		{post.data.excerpt && <p class="insight-excerpt">{post.data.excerpt}</p>}
		{post.data.reading_time && <p class="reading">{post.data.reading_time}</p>}
	</div>
</article>
