---
/** Abstract avatar for a team member: initials over a quiet architectural pattern (no photos of people). */
import { initials } from "../lib/practice";

interface Props {
	name: string;
	tone?: "teal" | "copper" | "stone";
	size?: "md" | "lg";
}
const { name, tone = "teal", size = "md" } = Astro.props;
---

<span class:list={["monogram", `tone-${tone}`, `size-${size}`]} aria-hidden="true">
	<svg class="monogram-lines" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
		<path d="M0 72 L100 34 M0 86 L100 48 M0 100 L100 62" fill="none" stroke="currentColor" stroke-width="0.6" />
	</svg>
	<span class="monogram-text">{initials(name)}</span>
</span>
