---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import { getServices, photoSrc, requestUrl, serviceUrl } from "../lib/freshspace";

const { entries, cacheHint } = await getServices();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const services = entries.filter((s) => s.data.on_home);
---

<Base title="Come home to clean" description="Reliable, professional cleaning for a fresher, happier home.">
	<Hero
		photo="/images/hero-home.webp"
		alt="A smiling Freshspace cleaner in a teal uniform carrying a caddy of supplies through a bright, tidy living room"
		labelledby="home-title"
		class="hero-home"
	>
		<h1 id="home-title" class="display">Come home<br /><span class="accent">to clean.</span></h1>
		<p class="hero-lede">Reliable, professional cleaning for a fresher, happier home.</p>
		<a class="btn btn-lg" href={requestUrl()}>Book your cleaning <Arrow /></a>
	</Hero>

	<section class="container service-cards" aria-label="Our cleaning services">
		{
			services.map((s) => {
				const src = photoSrc(s.data.card_image, s.data.card_photo);
				return (
					<article class="service-card">
						<div class="card-media">
							{src && <img src={src} alt={s.data.card_image?.alt || `${s.data.title}: a bright, freshly cleaned room`} loading="lazy" decoding="async" />}
							<span class="icon-disc">
								<Icon name={s.data.icon || "house"} />
							</span>
						</div>
						<div class="card-body">
							<div>
								<h2>
									<a href={serviceUrl(s.data)} class="card-link">{s.data.title}</a>
								</h2>
								{s.data.summary && <p>{s.data.summary}</p>}
							</div>
							<span class="card-arrow" aria-hidden="true"><Arrow /></span>
						</div>
					</article>
				);
			})
		}
	</section>
</Base>
