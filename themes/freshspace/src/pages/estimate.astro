---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import {
	ESTIMATE_GROUPS,
	ESTIMATE_SERVICE,
	computeEstimate,
	getEstimateOptions,
	getHighlights,
	money,
	pickChoice,
	requestUrl,
	type EstimateChoice,
	type EstimateGroup,
} from "../lib/freshspace";

const [options, strip] = await Promise.all([getEstimateOptions(), getHighlights("estimate")]);
if (Astro.cache?.enabled) {
	Astro.cache.set(options.cacheHint);
	Astro.cache.set(strip.cacheHint);
}
const { groups } = options;

// Selections come from the query string so the form works without JavaScript (GET submit).
const selected = Object.fromEntries(
	ESTIMATE_GROUPS.map((g) => [g, pickChoice(groups[g], Astro.url.searchParams.get(g))]),
) as Partial<Record<EstimateGroup, EstimateChoice>>;
const { lines, total } = computeEstimate(selected);

const summaryMain = [selected.bedrooms?.summary, selected.bathrooms?.summary, selected.size?.summary].filter(Boolean).join(" · ");
const summarySub = [selected.property?.summary, selected.frequency?.summary].filter(Boolean).join(" · ");
const estimateText = `${summarySub} · ${summaryMain} — estimated ${money(total)}`;

const fieldsets: { group: EstimateGroup; legend: string; hint?: string }[] = [
	{ group: "property", legend: "1. Property type" },
	{ group: "size", legend: "2. Home size", hint: "(square feet)" },
	{ group: "bedrooms", legend: "3. Bedrooms" },
	{ group: "bathrooms", legend: "4. Bathrooms" },
	{ group: "frequency", legend: "5. Cleaning frequency" },
];
const hasOptions = ESTIMATE_GROUPS.every((g) => groups[g].length > 0);
---

<Base title="Get your cleaning estimate" description="Quick, transparent pricing based on your home and needs.">
	<section class="estimate" aria-labelledby="estimate-title">
		<img class="estimate-side" src="/images/estimate-side.webp" alt="" loading="eager" decoding="async" />
		<div class="container-estimate">
			<h1 id="estimate-title" class="display display-sm">Get your cleaning estimate</h1>
			<p class="estimate-lede">Quick, transparent pricing based on your home and needs.</p>

			{
				hasOptions ? (
					<div class="estimate-grid" id="estimate">
						<form class="card estimate-form" method="get" action="/estimate#estimate" data-estimate-form>
							{fieldsets.map((f) => (
								<fieldset class:list={["opt-set", `opt-set-${f.group}`]}>
									<legend>
										{f.legend} {f.hint && <span class="legend-hint">{f.hint}</span>}
									</legend>
									<div class="opt-row">
										{groups[f.group].map((c) => (
											<label class:list={["opt", { "opt-tile": f.group === "property" }]}>
												<input type="radio" name={f.group} value={c.value} checked={c.value === selected[f.group]?.value} />
												{f.group === "property" && c.icon && <Icon name={c.icon} />}
												<span>{c.label}</span>
											</label>
										))}
									</div>
								</fieldset>
							))}
							<button class="btn update-btn" type="submit">Update estimate</button>
						</form>

						<section class="card estimate-result" aria-labelledby="result-title">
							<h2 id="result-title">Your estimated price</h2>
							<p class="result-sub">Here’s a breakdown based on the details you selected.</p>
							<div class="result-summary">
								<span class="summary-icon">
									{groups.property.map((c) => (
										<span data-prop-icon={c.value} hidden={c.value !== selected.property?.value}>
											<Icon name={c.icon || "house"} />
										</span>
									))}
								</span>
								<div>
									<p class="summary-main" data-summary-main>{summaryMain}</p>
									<p class="summary-sub" data-summary-sub>{summarySub}</p>
								</div>
							</div>
							<ul class="lines" data-lines>
								{lines.map((l) => (
									<li class:list={{ "line-discount": l.discount }}>
										<div>
											<strong>{l.label}</strong>
											<span>{l.detail}</span>
										</div>
										<span class="line-amount">{l.amount === null ? "Included" : `${l.discount ? "−" : ""}${money(l.amount)}`}</span>
									</li>
								))}
							</ul>
							<div class="total" aria-live="polite">
								<span>Estimated total</span>
								<strong data-total>{money(total)}</strong>
							</div>
							<p class="total-note">This is an estimate. Final price may vary based on your home’s condition and any additional requests.</p>
							<a class="btn btn-lg btn-block" data-request href={requestUrl({ service: ESTIMATE_SERVICE, estimate: estimateText })}>
								Request cleaning <Arrow />
							</a>
						</section>
					</div>
				) : (
					<p class="card empty-note">Online estimates are not available right now. <a href={requestUrl()}>Request a cleaning</a> and we’ll quote you directly.</p>
				)
			}
		</div>
	</section>

	{
		strip.entries.length > 0 && (
			<section class="strip" aria-label="Why Freshspace">
				<ul class="container strip-list">
					{strip.entries.map((h) => (
						<li>
							<span class="icon-disc icon-disc-sm">
								<Icon name={h.data.icon || "leaf"} />
							</span>
							<div>
								<h2>{h.data.title}</h2>
								{h.data.text && <p>{h.data.text}</p>}
							</div>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<script is:inline type="application/json" id="estimate-data" set:html={JSON.stringify({ groups, service: ESTIMATE_SERVICE })} />
</Base>

<script>
	// Live estimate: mirrors computeEstimate() in src/lib/freshspace.ts so the price updates as options change.
	type Choice = { value: string; label: string; summary: string; amount: number; icon: string };
	type Data = { groups: Record<string, Choice[]>; service: string };

	const form = document.querySelector<HTMLFormElement>("[data-estimate-form]");
	const raw = document.getElementById("estimate-data")?.textContent;
	if (form && raw) {
		const data = JSON.parse(raw) as Data;
		form.classList.add("is-live");
		const money = (n: number) =>
			`$${n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		const linesEl = document.querySelector<HTMLElement>("[data-lines]");
		const totalEl = document.querySelector<HTMLElement>("[data-total]");
		const mainEl = document.querySelector<HTMLElement>("[data-summary-main]");
		const subEl = document.querySelector<HTMLElement>("[data-summary-sub]");
		const request = document.querySelector<HTMLAnchorElement>("[data-request]");

		const update = () => {
			const fd = new FormData(form);
			const pick = (g: string): Choice | undefined =>
				data.groups[g]?.find((c) => c.value === fd.get(g)) ?? data.groups[g]?.[0];
			const [property, size, bedrooms, bathrooms, frequency] = ["property", "size", "bedrooms", "bathrooms", "frequency"].map(pick);
			const base = (size?.amount ?? 0) + (property?.amount ?? 0);
			const bed = bedrooms?.amount ?? 0;
			const bath = bathrooms?.amount ?? 0;
			const subtotal = base + bed + bath;
			const pct = frequency?.amount ?? 0;
			const discount = Math.round(subtotal * pct) / 100;
			const total = subtotal - discount;
			const lines: [string, string, string, boolean][] = [
				["Standard cleaning", "All essential cleaning tasks for a fresh, tidy home.", money(base), false],
				[`Bedrooms (${bedrooms?.label ?? "–"})`, "Dusting, vacuuming, floor care, and more.", bed ? money(bed) : "Included", false],
				[`Bathrooms (${bathrooms?.label ?? "–"})`, "Deep cleaning and sanitizing.", bath ? money(bath) : "Included", false],
				["Kitchen", "Countertops, appliances (exterior), sink, and floors.", "Included", false],
			];
			if (discount > 0) {
				lines.push([`${frequency?.label ?? ""} discount (${pct}%)`, "Applied to every visit on a regular schedule.", `−${money(discount)}`, true]);
			}
			if (linesEl) {
				linesEl.replaceChildren(
					...lines.map(([label, detail, amount, isDiscount]) => {
						const li = document.createElement("li");
						if (isDiscount) li.className = "line-discount";
						const div = document.createElement("div");
						const strong = document.createElement("strong");
						strong.textContent = label;
						const span = document.createElement("span");
						span.textContent = detail;
						div.append(strong, span);
						const amt = document.createElement("span");
						amt.className = "line-amount";
						amt.textContent = amount;
						li.append(div, amt);
						return li;
					}),
				);
			}
			const main = [bedrooms?.summary, bathrooms?.summary, size?.summary].filter(Boolean).join(" · ");
			const sub = [property?.summary, frequency?.summary].filter(Boolean).join(" · ");
			document.querySelectorAll<HTMLElement>("[data-prop-icon]").forEach((el) => {
				el.hidden = el.dataset.propIcon !== property?.value;
			});
			if (totalEl) totalEl.textContent = money(total);
			if (mainEl) mainEl.textContent = main;
			if (subEl) subEl.textContent = sub;
			if (request) {
				const params = new URLSearchParams({ service: data.service, estimate: `${sub} · ${main} — estimated ${money(total)}` });
				request.href = `/request?${params.toString()}`;
			}
		};
		form.addEventListener("change", update);
		form.addEventListener("submit", (e) => {
			e.preventDefault();
			update();
		});
	}
</script>
