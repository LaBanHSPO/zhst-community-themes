---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import { getPackages, photoSrc, requestUrl } from "../lib/freshspace";

const { entries: packages, cacheHint } = await getPackages();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Cleaning packages" description="Home Clean, Deep Clean and Office Clean compared: starting prices, what each visit includes and how they differ.">
	<Hero
		photo="/images/hero-packages.webp"
		alt="A white jug of fresh green branches on a woven mat on a sunlit dining table"
		labelledby="packages-title"
		class="hero-packages"
	>
		<h1 id="packages-title" class="display display-md">Cleaning packages<br /><span class="accent">for every space.</span></h1>
		<p class="hero-lede">Choose the right clean for your home or office. Professional service, clear pricing, and a fresher space every time.</p>
	</Hero>

	<section class="container-wide package-grid" aria-label="Packages compared">
		{
			packages.map((p) => {
				const src = photoSrc(p.data.image, p.data.photo);
				const headingId = `pkg-${p.data.slug ?? p.data.id}`;
				return (
					<article class="package-card" aria-labelledby={headingId}>
						<div class="card-media">
							{src && <img src={src} alt={p.data.image?.alt || `${p.data.title}: a clean, bright space`} loading="lazy" decoding="async" />}
							<span class="icon-disc icon-disc-lg">
								<Icon name={p.data.icon || "house"} />
							</span>
						</div>
						<div class="package-body">
							<div class="package-intro">
								<h2 id={headingId}>{p.data.title}</h2>
								{p.data.summary && <p>{p.data.summary}</p>}
								<p class="price">
									<span class="price-from">From</span>
									<span class="price-amount">{p.data.price}</span>
									{p.data.price_unit && <span class="price-unit">{p.data.price_unit}</span>}
								</p>
							</div>
							{
								(p.data.inclusions?.length ?? 0) > 0 && (
									<ul class="checks" aria-label={`${p.data.title} includes`}>
										{p.data.inclusions?.map((i) => (
											<li>
												<span class="check-dot">
													<Icon name="check" />
												</span>
												{i.item}
											</li>
										))}
									</ul>
								)
							}
						</div>
						<a class="btn btn-block package-btn" href={requestUrl({ package: p.data.slug ?? p.data.id })}>
							{p.data.button_label || `Book ${p.data.title}`} <Arrow />
						</a>
					</article>
				);
			})
		}
	</section>
</Base>
