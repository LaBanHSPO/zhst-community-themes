---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import { getBusiness, getHighlights, getPackages, getServices, telHref } from "../lib/freshspace";

const [servicesResult, packagesResult, side, businessResult] = await Promise.all([
	getServices(),
	getPackages(),
	getHighlights("request"),
	getBusiness(),
]);
if (Astro.cache?.enabled) {
	for (const r of [servicesResult, packagesResult, side, businessResult]) Astro.cache.set(r.cacheHint);
}
const { business } = businessResult;

type Option = { value: string; title: string; text: string };
const options: Option[] = servicesResult.entries
	.filter((s) => s.data.on_request)
	.map((s) => ({ value: s.data.slug ?? s.data.id, title: s.data.title, text: s.data.option_text || s.data.summary || "" }));

// Links from Packages (?package=) and Estimate (?service=&estimate=) carry the selection over.
const params = Astro.url.searchParams;
const pkg = packagesResult.entries.find((p) => (p.data.slug ?? p.data.id) === params.get("package"));
let selectedValue = params.get("service") ?? "";
if (pkg) {
	const mapped = pkg.data.service && options.some((o) => o.value === pkg.data.service);
	if (mapped) {
		selectedValue = pkg.data.service ?? "";
	} else {
		// A package with no matching service (e.g. Office Clean) becomes its own option.
		const value = pkg.data.slug ?? pkg.data.id;
		options.push({ value, title: pkg.data.title, text: pkg.data.summary ?? "" });
		selectedValue = value;
	}
}
if (!options.some((o) => o.value === selectedValue)) selectedValue = options[0]?.value ?? "";

const estimate = (params.get("estimate") ?? "").replace(/[\r\n]+/g, " ").slice(0, 200).trim();
const packageSummary = pkg ? `${pkg.data.title} · From ${pkg.data.price}${pkg.data.price_unit ? ` ${pkg.data.price_unit}` : ""}` : "";
const selection = [packageSummary, estimate].filter(Boolean).join(" — ");

const times = ["Morning (8am – 12pm)", "Afternoon (12pm – 4pm)", "Late afternoon (4pm – 7pm)", "Any time"];
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Saigon" }).format(new Date());
---

<Base title="Request cleaning" description="Tell us about your home and we’ll confirm your booking and send you all the details.">
	<section class="request" aria-labelledby="request-title">
		<img class="request-photo" src="/images/request-room.webp" alt="" loading="eager" decoding="async" />
		<div class="request-inner">
			<div class="request-copy">
				<h1 id="request-title" class="display">Request<br /><span class="accent">your cleaning.</span></h1>
				<p class="hero-lede">Tell us about your home and we’ll take care of the rest. We’ll confirm your booking and send you all the details.</p>
				{
					side.entries.length > 0 && (
						<ul class="perks">
							{side.entries.map((h) => (
								<li>
									<span class="icon-disc">
										<Icon name={h.data.icon || "leaf"} />
									</span>
									<span>{h.data.title}</span>
								</li>
							))}
						</ul>
					)
				}
			</div>

			<section class="card request-card" aria-labelledby="form-title" id="request-form">
				<h2 id="form-title">Request a cleaning</h2>
				<p class="form-sub">Fill out the form below and we’ll confirm your availability.</p>
				<form
					class="request-form"
					data-request-form
					data-email={business.email}
					action={business.email ? `mailto:${business.email}?subject=${encodeURIComponent("Cleaning request")}` : undefined}
					method="post"
					enctype="text/plain"
				>
					{selection && <input type="hidden" name="selection" value={selection} />}
					{
						selection && (
							<p class="selection">
								<Icon name="tag" />
								<span>
									<strong>Your selection:</strong> {selection}
								</span>
							</p>
						)
					}
					<fieldset class="pkg-set">
						<legend>Select a package</legend>
						<div class="pkg-options">
							{options.map((o) => (
								<label class="pkg-option">
									<input type="radio" name="package" value={o.title} checked={o.value === selectedValue} required />
									<span class="pkg-text">
										<strong>{o.title}</strong>
										{o.text && <span>{o.text}</span>}
									</span>
								</label>
							))}
						</div>
					</fieldset>

					<div class="field">
						<label for="r-address">Home address</label>
						<div class="input-icon">
							<Icon name="pin" />
							<input id="r-address" name="address" type="text" autocomplete="street-address" placeholder="Street address, city, state, ZIP code" required />
						</div>
					</div>

					<div class="field-row">
						<div class="field">
							<label for="r-name">Full name</label>
							<div class="input-icon">
								<Icon name="user" />
								<input id="r-name" name="name" type="text" autocomplete="name" placeholder="Your full name" required />
							</div>
						</div>
						<div class="field">
							<label for="r-phone">Phone number</label>
							<div class="input-icon">
								<Icon name="phone" />
								<input id="r-phone" name="phone" type="tel" autocomplete="tel" placeholder="(555) 123-4567" required />
							</div>
						</div>
					</div>

					<div class="field">
						<label for="r-email">Email address</label>
						<div class="input-icon">
							<Icon name="mail" />
							<input id="r-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
						</div>
					</div>

					<div class="field-row">
						<div class="field">
							<label for="r-date">Preferred date</label>
							<div class="input-icon">
								<Icon name="calendar" />
								<input id="r-date" name="date" type="date" min={today} required />
							</div>
						</div>
						<div class="field">
							<label for="r-time">Preferred time</label>
							<div class="input-icon select">
								<Icon name="clock" />
								<select id="r-time" name="time" required>
									<option value="" selected disabled>Select a time</option>
									{times.map((t) => <option>{t}</option>)}
								</select>
								<Icon name="chevron" class="chev" />
							</div>
						</div>
					</div>

					<div class="field">
						<label for="r-notes">Additional notes <span class="optional">(optional)</span></label>
						<textarea id="r-notes" name="notes" rows="2" placeholder="Any special requests or details about your home"></textarea>
					</div>

					<button class="btn btn-lg btn-block" type="submit">Submit request <Arrow /></button>
					<p class="form-note">We’ll confirm your availability and send you all the details shortly.</p>
					<p class="form-status" role="status" aria-live="polite" data-status>
						{
							business.email ? (
								<noscript>
									Without JavaScript, send your request by email to <a href={`mailto:${business.email}`}>{business.email}</a>.
								</noscript>
							) : (
								business.phone && <>Online requests are not available right now. Please call <a href={telHref(business.phone)}>{business.phone}</a>.</>
							)
						}
					</p>
				</form>
			</section>
		</div>
	</section>
</Base>

<script>
	// Cleaning request: compose an email to the business. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-request-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			const email = form.dataset.email ?? "";
			status.classList.add("is-active");
			if (!email) {
				status.textContent = "Online requests are not available right now. Please call us instead.";
				return;
			}
			const data = new FormData(form);
			const get = (k: string) => String(data.get(k) ?? "").trim();
			const subject = `Cleaning request: ${get("package")} — ${get("date")}`;
			const body = [
				"Hello,",
				"",
				"I would like to request a cleaning.",
				"",
				`Package: ${get("package")}`,
				get("selection") ? `Selection: ${get("selection")}` : "",
				`Home address: ${get("address")}`,
				`Full name: ${get("name")}`,
				`Phone: ${get("phone")}`,
				`Email: ${get("email")}`,
				`Preferred date: ${get("date")}`,
				`Preferred time: ${get("time")}`,
				get("notes") ? `Notes: ${get("notes")}` : "",
				"",
			]
				.filter((line, i, all) => line !== "" || all[i - 1] !== "")
				.join("\n");
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			status.textContent =
				"Your email app should open with this request ready to send. Nothing is sent until you send that email, and we’ll confirm availability by reply. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
