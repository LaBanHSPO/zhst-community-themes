---
/** Full-bleed page hero: photo on the right fading into the warm-white page, copy on the left. */
interface Props {
	photo?: string;
	alt: string;
	labelledby: string;
	class?: string;
}
const { photo, alt, labelledby, class: className } = Astro.props;
---

<section class:list={["hero", className]} aria-labelledby={labelledby}>
	{
		photo && (
			<div class="hero-media">
				<img src={photo} alt={alt} loading="eager" fetchpriority="high" decoding="async" />
			</div>
		)
	}
	<div class="hero-copy container">
		<slot />
	</div>
</section>
