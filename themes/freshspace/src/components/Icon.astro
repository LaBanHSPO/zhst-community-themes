---
/** Line icons drawn inline (no icon font). Decorative unless a label is passed. */
interface Props {
	name: string;
	class?: string;
	label?: string;
}
const { name, class: className, label } = Astro.props;
const paths: Record<string, string> = {
	house: '<path d="M3 11.2 12 3.8l9 7.4"/><path d="M5.6 9.4V20.2h12.8V9.4"/><path d="M10 20.2v-5.6h4v5.6"/>',
	sparkle:
		'<path d="M10 3.5c.6 4.2 2.3 5.9 6.5 6.5-4.2.6-5.9 2.3-6.5 6.5-.6-4.2-2.3-5.9-6.5-6.5 4.2-.6 5.9-2.3 6.5-6.5z"/><path d="M17.8 13.2c.3 2.2 1.2 3.1 3.4 3.4-2.2.3-3.1 1.2-3.4 3.4-.3-2.2-1.2-3.1-3.4-3.4 2.2-.3 3.1-1.2 3.4-3.4z"/><path d="M18 3.2c.2 1.3.7 1.8 2 2-1.3.2-1.8.7-2 2-.2-1.3-.7-1.8-2-2 1.3-.2 1.8-.7 2-2z"/>',
	calendar:
		'<rect x="3.5" y="5" width="17" height="15.5" rx="2.2"/><path d="M3.5 9.6h17M8 3v4M16 3v4"/><path d="M7.6 13.3h.01M12 13.3h.01M16.4 13.3h.01M7.6 16.8h.01M12 16.8h.01M16.4 16.8h.01" stroke-width="2.4"/>',
	building:
		'<rect x="5.5" y="3" width="13" height="18" rx="1"/><path d="M9 7h1.5M13.5 7H15M9 10.5h1.5M13.5 10.5H15M9 14h1.5M13.5 14H15M10.5 21v-3h3v3"/>',
	townhouse:
		'<path d="M1.8 12 7.5 7l5.7 5"/><path d="M3.6 10.6V20h7.8v-9.4"/><path d="M10.8 12 16.5 7l5.7 5"/><path d="M12.6 10.6V20h7.8v-9.4"/><path d="M6 20v-3.6h3V20M15 20v-3.6h3V20"/>',
	tag: '<path d="M12.4 3H20.5a.5.5 0 0 1 .5.5v8.1L11.6 21 3 12.4z" transform="rotate(0)"/><circle cx="16.4" cy="7.6" r="1.4"/>',
	leaf: '<path d="M11.5 20.5C5 20.5 2.5 16 3 10.5c5.5-.3 9.5 3.2 8.5 10z"/><path d="M12.6 20c-.8-6.7 2.6-12.4 8.4-16 1.2 7.3-2.3 13.6-8.4 16z"/><path d="M5.2 12.8c2.6 1.9 4.6 4.3 6.1 7.5M18.8 7c-2.7 3.4-4.8 7.8-6 12.5"/>',
	pin: '<path d="M12 21s-7-6.5-7-11.6a7 7 0 0 1 14 0C19 14.5 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
	user: '<circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c.6-4 3.6-6.3 7.5-6.3s6.9 2.3 7.5 6.3"/>',
	phone:
		'<path d="M6.6 3.5 9.7 7.9 7.9 10c1.1 2.5 3.5 4.9 6.1 6.1l2.1-1.8 4.4 3.1-1.7 3.1C11.4 20.5 3.5 12.6 3.5 5.2z"/>',
	mail: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.8 7 8.2 6.2L20.2 7"/>',
	clock: '<circle cx="12" cy="12" r="8.6"/><path d="M12 7.4V12l3.2 2"/>',
	check: '<path d="m6.5 12.4 3.6 3.6 7.4-7.6"/>',
	x: '<path d="m8 8 8 8M16 8l-8 8"/>',
	chevron: '<path d="m6 9.5 6 6 6-6"/>',
};
const body = paths[name] ?? "";
---

<svg
	class:list={["icon", className]}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.7"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
	focusable="false"
	set:html={body}
/>
