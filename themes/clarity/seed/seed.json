 "content": {
  "pages": [
   {
    "id": "about",
    "slug": "about",
    "status": "published",
    "data": {
     "title": "About Clarity",
     "content": [
      {
       "_type": "block",
       "style": "normal",
       "_key": "b1",
       "children": [
        {
         "_type": "span",
         "text": "Clarity is a focused AI writing workspace. It helps people turn rough notes, meeting transcripts and half-formed ideas into clear writing they are ready to share.",
         "_key": "s1"
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "b2",
       "children": [
        {
         "_type": "span",
         "text": "We build for the whole writing process, not just the first draft: plan an outline, draft with AI in context, refine for clarity and tone, then export or share with your team.",
         "_key": "s2"
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "b3",
       "children": [
        {
         "_type": "span",
         "text": "How we think about AI",
         "_key": "s3"
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "b4",
       "children": [
        {
         "_type": "span",
         "text": "Your words stay yours. Clarity suggests, you decide: every change is shown before it is applied, and nothing is published without you.",
         "_key": "s4"
        }
       ]
      }
     ]
    }
   }
