     "points": [
      {
       "title": "Key points, pulled from your notes",
       "text": "Each heading is traced back to the note it came from."
      },
      {
       "title": "Drag to reorder",
       "text": "Move sections around until the argument flows."
      },
      {
       "title": "Your outline, your call",
