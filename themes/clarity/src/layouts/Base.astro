---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Logo from "../components/Logo.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { DEMO_URL, getCompany, getWorkflows, workflowUrl } from "../lib/clarity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } = Astro.props;
const [settingsResult, menuResult, companyResult, workflowsResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getCompany(),
	getWorkflows(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(companyResult.cacheHint);
	Astro.cache.set(workflowsResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const navItems = menuResult.data?.items ?? [];
const { company } = companyResult;
const workflows = workflowsResult.entries;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const norm = (url: string) => url.replace(/\/$/, "") || "/";
const firstSegment = (url: string) => norm(url).split("/")[1] ?? "";
const currentUrl =
	navItems.find((i) => norm(i.url) === path)?.url ??
	// e.g. every /customer-workflow/* page highlights the menu item that points at one story.
	navItems.find((i) => norm(i.url) !== "/" && firstSegment(i.url) === firstSegment(path))?.url;
const onDemo = path === DEMO_URL;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Intl.DateTimeFormat("en-US", { year: "numeric", timeZone: "Asia/Saigon" }).format(new Date());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-head">
			<div class="head-inner container">
				<a class="wordmark" href="/" aria-label={`${siteTitle} — homepage`}>
					{
						siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						) : (
							<>
								<Logo size={34} />
								<span>{siteTitle}</span>
							</>
						)
					}
				</a>
				<nav class="nav" aria-label="Primary">
					{
						navItems.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={item.url === currentUrl ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<a class="btn head-cta" href={DEMO_URL} aria-current={onDemo ? "page" : undefined}>Book a demo</a>
				<details class="mobile-nav">
					<summary>
						<svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true" focusable="false">
							<path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="2" />
						</svg>
						<span>Menu</span>
					</summary>
					<nav class="mobile-panel" aria-label="Primary (mobile)">
						{
							navItems.map((item) => (
								<a href={item.url} aria-current={item.url === currentUrl ? "page" : undefined}>
									{item.label}
								</a>
							))
						}
						<a class="btn" href={DEMO_URL} aria-current={onDemo ? "page" : undefined}>Book a demo</a>
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="container foot-inner">
				<div class="foot-brand">
					<a class="wordmark" href="/" aria-label={`${siteTitle} — homepage`}>
						<Logo size={30} />
						<span>{siteTitle}</span>
					</a>
					<p>{company.footer_text ?? siteTagline}</p>
					<a class="btn" href={DEMO_URL}>Book a demo</a>
				</div>
				<div>
					<h2>Product</h2>
					<ul>
						{navItems.map((item) => <li><a href={item.url}>{item.label}</a></li>)}
						<li><a href={DEMO_URL}>Book a demo</a></li>
					</ul>
				</div>
				<div>
					<h2>Customer stories</h2>
					<ul>
						{workflows.map((w) => <li><a href={workflowUrl(w.data)}>{w.data.title}</a></li>)}
						<li><a href="/customer-workflow">All workflows</a></li>
					</ul>
				</div>
				<div>
					<h2>Company</h2>
					<ul>
						<li><a href="/about">About Clarity</a></li>
						{company.email && <li><a href={`mailto:${company.email}`}>{company.email}</a></li>}
						{company.support_email && <li><a href={`mailto:${company.support_email}`}>{company.support_email}</a></li>}
					</ul>
				</div>
			</div>
			<div class="container foot-bottom">
				<span>© {year} {siteTitle}. All rights reserved.</span>
				<span class="mono">Built with EmDash</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
