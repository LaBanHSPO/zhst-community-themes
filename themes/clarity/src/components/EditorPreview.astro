---
/**
 * The Clarity editor, rebuilt in HTML/CSS from the mockups (decorative product preview, exposed to
 * assistive tech as one labelled image).
 */
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

interface Props {
	variant?: "home" | "features" | "mini";
	class?: string;
}
const { variant = "home", class: className } = Astro.props;
const mini = variant === "mini";
const label =
	"Preview of the Clarity editor: a Product launch announcement document with a highlighted passage and AI writing actions such as Improve writing, Fix grammar, Shorten and Change tone.";
const sideItems = [
	{ icon: "home", label: "Home" },
	{ icon: "drafts", label: "My drafts" },
	{ icon: "shared", label: "Shared with me" },
	{ icon: "templates", label: "Templates" },
];
const folders = ["Product", "Marketing", "Customer stories", "Archive"];
const actions = [
	{ icon: "check-circle", label: "Fix grammar" },
	{ icon: "shorten", label: "Shorten" },
	{ icon: "briefcase", label: "Make more professional" },
	{ icon: "tone", label: "Change tone" },
];
const ic = mini ? 10 : 14;
---

<div class:list={["app", { "app-lg": variant === "features", "app-mini": mini }, className]} role="img" aria-label={label}>
	<div class="app-brand">
		<Logo size={mini ? 14 : 19} />
		Clarity
		<span class="dots"><Icon name="dots" size={ic} /></span>
	</div>
	<div class="app-top">
		{!mini && <Icon name="dots" size={14} />}
		<Icon name="arrow-left" size={mini ? 9 : 13} />
		<span>Projects</span><span>/</span><span class="crumb-current">Product launch</span>
		{
			!mini && (
				<span class="app-actions">
					<span class="app-pill">Share</span>
					<span class="app-pill app-pill-dark">
						Export <Icon name="chevron-right" size={10} />
					</span>
				</span>
			)
		}
	</div>
	<div class="app-side">
		<div class="app-search"><Icon name="search" size={ic - 1} /> Search…</div>
		<div class="app-new"><Icon name="plus" size={ic} /> New document</div>
		<ul>
			{sideItems.map((i) => <li><Icon name={i.icon} size={ic} /> {i.label}</li>)}
		</ul>
		{
			!mini && (
				<>
					<div class="app-label">
						Folders <Icon name="chevron-down" size={11} />
					</div>
					<ul>
						{folders.map((f) => (
							<li>
								<Icon name={f === "Archive" ? "archive" : "folder"} size={14} /> {f}
							</li>
						))}
					</ul>
				</>
			)
		}
	</div>
	<div class="app-doc">
		<div class="app-doc-kind"><span class="kind-ic"><Icon name="type" size={mini ? 8 : 11} /></span> Document</div>
		<h3>Product launch announcement</h3>
		<div class="app-toolbar">
			<span>Paragraph</span><Icon name="chevron-down" size={mini ? 7 : 10} />
			<span class="sep"></span>
			<Icon name="bold" size={ic - 1} /><Icon name="italic" size={ic - 1} /><Icon name="underline" size={ic - 1} />
			<span class="sep hide-sm"></span>
			<span class="hide-sm" style="display:contents"><Icon name="numbers" size={ic - 1} /><Icon name="bullets" size={ic - 1} /></span>
			<span class="sep hide-sm"></span>
			<span class="hide-sm" style="display:contents"><Icon name="link" size={ic - 1} /><Icon name="image" size={ic - 1} /></span>
			<span class="sep"></span>
			<span class="ask"><Icon name="sparkle" size={ic} /> Ask Clarity</span>
		</div>
		<div class="app-body">
			{
				variant === "home" ? (
					<>
						<p>
							We’re excited to introduce a new chapter for Clarity.{" "}
							<mark>Our mission has always been to help people turn their ideas into clear, compelling writing.</mark>
						</p>
						<p>Today, we’re launching a more powerful, focused workspace — designed to help you go from rough notes to ready to share, faster than ever.</p>
						<p>Whether you’re writing a blog post, a product update, or a strategic plan, Clarity gives you the tools and AI support to think more clearly and write with confidence.</p>
					</>
				) : (
					<>
						<p>
							We’re excited to introduce a new chapter for Clarity.{" "}
							<mark>
								Our mission has always been to help people turn their ideas into clear, compelling writing
								{mini ? "." : " — and now we’re making that process even more powerful with AI."}
							</mark>
						</p>
						{!mini && <p>Today, we’re launching a more focused workspace designed to help you go from rough notes to ready to share, faster than ever.</p>}
					</>
				)
			}
		</div>
	</div>
	{
		!mini && (
			<div class="app-panel">
				<div class="app-tabs">
					<span class="on">Write</span>
					<span>Edit</span>
					<span>Chat</span>
				</div>
				<div class="app-card">
					<div class="app-card-title">
						<Icon name="target" size={14} /> Improve writing
					</div>
					<p>Make this clearer, more compelling, and more concise.</p>
					<span class="app-apply">Apply</span>
				</div>
				<ul class="app-actions-list">
					{actions.map((a) => (
						<li>
							<Icon name={a.icon} size={14} /> {a.label}
							<span class="go">
								<Icon name="chevron-right" size={13} />
							</span>
						</li>
					))}
				</ul>
			</div>
		)
	}
</div>
