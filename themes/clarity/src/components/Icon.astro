	numbers: '<path d="M10 6h10M10 12h10M10 18h10M4 5l1.5-1v5M4 14.5a1.5 1.5 0 1 1 2.5 1.2L4 18h3"/>',
	link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
	image: '<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M20.5 16l-5-5-9 8.5"/>',
	type: '<path d="M5 7V5h14v2M12 5v14M9 19h6"/>',
	play: '<path d="M9 7.5v9l7.5-4.5z" fill="currentColor" stroke="none"/>',
	shorten: '<path d="M4 7h16M4 12h16M4 17h10"/>',
