---
import Icon from "./Icon.astro";

interface Props {
	items: { title: string; text?: string | null; icon?: string | null; href?: string }[];
	class?: string;
}
const { items, class: className } = Astro.props;
---

{
	items.length > 0 && (
		<ol class:list={["steps", className]}>
			{items.map((s, i) => {
				const inner = (
					<>
						<span class="icon-disc">
							<Icon name={s.icon} />
						</span>
						<div>
							<h3>
								{i + 1}. {s.title}
							</h3>
							{s.text && <p>{s.text}</p>}
						</div>
					</>
				);
				return <li class="step">{s.href ? <a class="step-link" href={s.href}>{inner}</a> : inner}</li>;
			})}
		</ol>
	)
}
