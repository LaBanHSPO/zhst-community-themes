---
import Icon from "./Icon.astro";

interface Props {
	title?: string | null;
	meta?: string | null;
	lines: { time?: string | null; text: string }[];
	headingLevel?: "h2" | "h3" | "div";
}
const { title = "Meeting notes", meta, lines, headingLevel = "div" } = Astro.props;
const Heading = headingLevel;
---

<div class="notes-card">
	<div class="notes-head">
		<Icon name="wave" size={22} />
		<Heading style="font:inherit;letter-spacing:inherit;color:inherit;margin:0">{title}</Heading>
		{meta && <span class="meta">{meta}</span>}
	</div>
	<ol class="notes-lines">
		{
			lines.map((l) => (
				<li>
					<span class="ts">{l.time}</span>
					<span>{l.text}</span>
				</li>
			))
		}
	</ol>
</div>
