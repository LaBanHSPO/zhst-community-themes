---
/** Clarity mark: a violet leaf/drop with a soft lavender fold. */
interface Props {
	size?: number;
	class?: string;
}
const { size = 34, class: className } = Astro.props;
const id = `cl-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class={className} width={size} height={size} viewBox="0 0 34 34" aria-hidden="true" focusable="false">
	<defs>
		<linearGradient id={`${id}-a`} x1="0" y1="1" x2="1" y2="0">
			<stop offset="0" stop-color="#4f2ae6" />
			<stop offset="1" stop-color="#7d5cff" />
		</linearGradient>
		<linearGradient id={`${id}-b`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#c9b8ff" />
			<stop offset="1" stop-color="#8f72ff" />
		</linearGradient>
	</defs>
	<path d="M17 2h11a4 4 0 0 1 4 4v11c0 8.3-6.7 15-15 15S2 25.3 2 17 8.7 2 17 2z" fill={`url(#${id}-a)`} />
	<path d="M32 6v11c0 8.3-6.7 15-15 15L28 2a4 4 0 0 1 4 4z" fill={`url(#${id}-b)`} opacity="0.85" />
	<path d="M17 32L28 2" stroke="#fff" stroke-opacity="0.35" stroke-width="0.8" />
</svg>
