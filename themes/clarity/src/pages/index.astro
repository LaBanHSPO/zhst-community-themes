---
import Base from "../layouts/Base.astro";
import Benefits from "../components/Benefits.astro";
import CtaBand from "../components/CtaBand.astro";
import EditorPreview from "../components/EditorPreview.astro";
import Icon from "../components/Icon.astro";
import NotesCard from "../components/NotesCard.astro";
import { DEMO_URL, getBenefits, getWorkflows, workflowUrl } from "../lib/clarity";

const [benefits, workflows] = await Promise.all([getBenefits("home"), getWorkflows()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(benefits.cacheHint);
	Astro.cache.set(workflows.cacheHint);
}
const story = workflows.entries[0];
---

<Base title="Clarity — From rough notes to ready to share" description="Clarity helps you turn ideas into clear, compelling writing — faster. Plan, draft, and refine with AI, all in one focused workspace.">
	<section class="hero" aria-labelledby="home-title">
		<div class="container hero-grid">
			<div class="hero-copy">
				<span class="eyebrow">A focused AI writing workspace</span>
				<h1 id="home-title" class="display">From rough notes to <span class="accent">ready to share.</span></h1>
				<p class="lede">Clarity helps you turn ideas into clear, compelling writing — faster. Plan, draft, and refine with AI, all in one focused workspace.</p>
				<div class="hero-actions">
					<a class="btn btn-lg" href={DEMO_URL}>Try Clarity <Icon name="arrow-right" size={22} /></a>
					<a class="play-link" href="/features#how-it-works"><span class="play"><Icon name="play" size={20} /></span> See how it works</a>
				</div>
			</div>
			<div class="hero-media">
				<EditorPreview variant="home" />
			</div>
		</div>
	</section>

	<section class="container" aria-label="Why Clarity">
		<Benefits items={benefits.entries} placement="home" />
	</section>

	<section class="container split" aria-labelledby="better-title">
		<div class="split-media">
			<img src="/images/desk-lake.webp" alt="A coffee mug, open notebook and pen on a wooden desk by a window overlooking a lake" width="726" height="238" loading="lazy" />
		</div>
		<div class="split-copy">
			<span class="eyebrow">A better way to write</span>
			<h2 id="better-title" class="h2">Your ideas, in a clearer, more powerful form.</h2>
			<p class="lede">Clarity combines a clean, distraction-free writing experience with powerful AI, so you can focus on what matters — your ideas.</p>
			<a class="text-link" href="/features">Explore features <Icon name="arrow-right" size={18} /></a>
		</div>
	</section>

	{
		story && (
			<section class="container section" aria-labelledby="story-title" style="padding-top:0">
				<div class="teaser">
					<div>
						<span class="eyebrow">{story.data.eyebrow ?? "Customer workflow"}</span>
						<h2 id="story-title" class="h2">{story.data.title}</h2>
						{story.data.summary && <p class="lede">{story.data.summary}</p>}
						<a class="btn btn-md" href={workflowUrl(story.data)}>
							See the workflow <Icon name="arrow-right" size={18} />
						</a>
					</div>
					<NotesCard title={story.data.input_title} meta={story.data.input_meta} lines={(story.data.input_lines ?? []).slice(0, 6)} />
				</div>
			</section>
		)
	}

	<CtaBand />
</Base>
