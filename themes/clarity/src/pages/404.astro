---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { DEMO_URL } from "../lib/clarity";
---

<Base title="Page not found">
	<section class="hero notfound" aria-labelledby="nf-title">
		<div class="container">
			<span class="eyebrow">Error 404</span>
			<h1 id="nf-title" class="display display-sm">This page needs <span class="accent">a rewrite.</span></h1>
			<p class="lede">The page you’re looking for doesn’t exist or has moved. Head back to the homepage, or see what Clarity can do.</p>
			<div class="hero-actions">
				<a class="btn btn-md" href="/">Back to homepage <Icon name="arrow-right" size={18} /></a>
				<a class="btn btn-md btn-outline" href={DEMO_URL}>Book a demo</a>
			</div>
		</div>
	</section>
</Base>
