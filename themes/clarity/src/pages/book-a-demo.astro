---
import Base from "../layouts/Base.astro";
import Benefits from "../components/Benefits.astro";
import EditorPreview from "../components/EditorPreview.astro";
import Icon from "../components/Icon.astro";
import { COMPANY_SIZES, DEMO_TIMES, USE_CASES, getAgenda, getBenefits, getCompany, getPlans } from "../lib/clarity";

const [agenda, benefits, companyResult, plans] = await Promise.all([getAgenda(), getBenefits("demo"), getCompany(), getPlans()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(agenda.cacheHint);
	Astro.cache.set(benefits.cacheHint);
	Astro.cache.set(companyResult.cacheHint);
	Astro.cache.set(plans.cacheHint);
}
const { company } = companyResult;
// Pricing CTAs link here with ?plan=solo etc.; the plan is carried into the request email.
const planParam = Astro.url.searchParams.get("plan") ?? "";
const plan = plans.entries.find((p) => (p.data.slug ?? p.data.id) === planParam)?.data.title ?? "";
const perks = [
	{ icon: "doc", label: "Tailored to\nyour use case" },
	{ icon: "people", label: "Live product\nwalkthrough" },
	{ icon: "sparkle", label: "Get your\nquestions answered" },
];
---

<Base title="Book a demo" description="Get a personalized demo and see how Clarity can help you and your team turn ideas into clear, compelling writing — faster.">
	<section class="hero demo-hero" aria-labelledby="demo-title">
		<div class="container hero-grid">
			<div class="hero-copy">
				<span class="eyebrow">Book a demo</span>
				<h1 id="demo-title" class="display">See how Clarity can <span class="accent">work for you.</span></h1>
				<p class="lede">Get a personalized demo and see how Clarity can help you and your team turn ideas into clear, compelling writing — faster.</p>
				<ul class="demo-perks">
					{
						perks.map((p) => (
							<li>
								<span class="icon-disc">
									<Icon name={p.icon} />
								</span>
								<span>{p.label}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="demo-panel">
				<section class="demo-form-card" id="demo-form" aria-labelledby="form-title">
					<h2 id="form-title">Book a demo</h2>
					<p class="form-intro">Tell us a bit about yourself and we’ll tailor the demo to your needs.</p>
					<form
						class="demo-form"
						data-demo
						data-email={company.email}
						action={company.email ? `mailto:${company.email}?subject=${encodeURIComponent("Demo request")}` : undefined}
						method="post"
						enctype="text/plain"
					>
						<div class="field">
							<label for="d-email">Work email <span class="req" aria-hidden="true">*</span></label>
							<input id="d-email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required />
						</div>
						<div class="field-row">
							<div class="field">
								<label for="d-name">Full name <span class="req" aria-hidden="true">*</span></label>
								<input id="d-name" name="name" type="text" autocomplete="name" placeholder="Jane Smith" required />
							</div>
							<div class="field">
								<label for="d-company">Company name <span class="req" aria-hidden="true">*</span></label>
								<input id="d-company" name="company" type="text" autocomplete="organization" placeholder="Acme Inc." required />
							</div>
						</div>
						<div class="field">
							<label for="d-size">Company size <span class="req" aria-hidden="true">*</span></label>
							<select id="d-size" name="size" required>
								<option value="" selected disabled hidden>Select company size</option>
								{COMPANY_SIZES.map((s) => <option>{s}</option>)}
							</select>
						</div>
						<div class="field">
							<label for="d-use">What do you plan to use Clarity for? <span class="req" aria-hidden="true">*</span></label>
							<select id="d-use" name="use" required>
								<option value="" selected disabled hidden>Select a primary use case</option>
								{USE_CASES.map((u) => <option>{u}</option>)}
							</select>
						</div>
						<div class="field">
							<label for="d-time">Preferred demo time <span class="req" aria-hidden="true">*</span></label>
							<select id="d-time" name="time" required>
								<option value="" selected disabled hidden>Select a time (your local time)</option>
								{DEMO_TIMES.map((t) => <option>{t}</option>)}
							</select>
						</div>
						{plan && (
							<p class="plan-note">
								<input type="hidden" name="plan" value={plan} />
								Plan you’re interested in: <strong>{plan}</strong>
							</p>
						)}
						<p class="sr-only">Fields marked with an asterisk are required.</p>
						<button class="btn btn-block" type="submit">Book a demo <Icon name="arrow-right" size={18} /></button>
						<p class="form-status" role="status" aria-live="polite" data-status>
							{
								company.email ? (
									<noscript>
										Without JavaScript, send your request by email to <a href={`mailto:${company.email}`}>{company.email}</a>.
									</noscript>
								) : (
									<>Online demo requests are not available right now.</>
								)
							}
						</p>
					</form>
				</section>

				<aside class="agenda-card" aria-labelledby="agenda-title">
					<h2 id="agenda-title">Here’s what to expect</h2>
					<ol class="agenda">
						{
							agenda.entries.map(({ data }, i) => (
								<li>
									<span class="num" aria-hidden="true">{i + 1}</span>
									<div>
										<h3>{data.title}</h3>
										{data.text && <p>{data.text}</p>}
									</div>
								</li>
							))
						}
					</ol>
					<EditorPreview variant="mini" />
				</aside>
			</div>
		</div>
	</section>

	<section class="container demo-split" aria-labelledby="built-title">
		<div class="split-media">
			<img src="/images/desk-lake.webp" alt="A coffee mug, open notebook and pen on a wooden desk by a window overlooking a lake" width="726" height="238" loading="lazy" />
		</div>
		<div class="split-copy">
			<span class="eyebrow">A more effective writing workspace</span>
			<h2 id="built-title" class="h2">Built for the way you work.</h2>
			<p class="lede muted">Clarity adapts to your goals, your team, and your writing style — so you can get to clear, high-quality content faster.</p>
			<Benefits items={benefits.entries} placement="demo" />
		</div>
	</section>
</Base>

<script>
	// Demo request: compose an email to the Clarity team. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-demo]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online demo requests are not available right now. Please try again later.";
				return;
			}
			const data = new FormData(form);
			const get = (k: string) => String(data.get(k) ?? "").trim();
			const subject = `Demo request: ${get("company")} (${get("size")})`;
			const body = [
				"Hello Clarity team,",
				"",
				"I would like to book a demo.",
				"",
				`Name: ${get("name")}`,
				`Work email: ${get("email")}`,
				`Company: ${get("company")}`,
				`Company size: ${get("size")}`,
				`Primary use case: ${get("use")}`,
				`Preferred demo time: ${get("time")}`,
				get("plan") ? `Plan I'm interested in: ${get("plan")}` : "",
				"",
			]
				.filter((line, i, all) => line !== "" || all[i - 1] !== "")
				.join("\n");
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			status.textContent =
				"Your email app should open with this request ready to send. Nothing is sent until you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
