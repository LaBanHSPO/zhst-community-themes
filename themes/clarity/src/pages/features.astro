---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import EditorPreview from "../components/EditorPreview.astro";
import Icon from "../components/Icon.astro";
import StagePreview from "../components/StagePreview.astro";
import Steps from "../components/Steps.astro";
import { DEMO_URL, getCapabilities, getStages } from "../lib/clarity";

const [stages, capabilities] = await Promise.all([getStages(), getCapabilities()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(stages.cacheHint);
	Astro.cache.set(capabilities.cacheHint);
}
const stageId = (s: { slug: string | null; id: string }) => `stage-${s.slug ?? s.id}`;
---

<Base title="Features" description="A complete AI writing workspace for your best work: plan, draft, edit, and refine with powerful AI tools, all in one focused workspace.">
	<section class="hero hero-features" aria-labelledby="features-title">
		<div class="container hero-grid">
			<div class="hero-copy" style="padding-top:3.3rem">
				<span class="eyebrow">Features</span>
				<h1 id="features-title" class="display">A complete AI writing workspace <span class="accent">for your best work.</span></h1>
				<p class="lede">Plan, draft, edit, and refine with powerful AI tools, all in one focused workspace.</p>
				<div class="hero-actions">
					<a class="btn btn-lg" href={DEMO_URL}>Book a demo <Icon name="arrow-right" size={22} /></a>
					<a class="play-link" href="#how-it-works"><span class="play"><Icon name="play" size={20} /></span> See Clarity in action</a>
				</div>
			</div>
			<div class="hero-media" style="padding-top:2rem">
				<EditorPreview variant="features" />
			</div>
		</div>
	</section>

	<section class="container" aria-labelledby="everything-title" style="padding-top:1.5rem">
		<div class="section-head">
			<span class="eyebrow">From outline to polished writing</span>
			<h2 id="everything-title" class="h2">Everything you need, in one place.</h2>
			<p>Clarity combines powerful AI with a clean, intuitive workflow to help you write with confidence.</p>
		</div>
		<Steps items={stages.entries.map((s) => ({ title: s.data.title, text: s.data.short, icon: s.data.icon, href: `#${stageId(s.data)}` }))} />
		<div class="cap-grid" style="margin-top:2.6rem">
			{
				capabilities.entries.map(({ data }) => (
					<article class="cap-card">
						<div class="cap-visual" aria-hidden="true">
							{data.preview === "templates" ? (
								<ul class="vis-stack">
									{(data.items ?? []).map((it, i) => (
										<li style={`--i:${i}`}>
											<Icon name={it.icon} /> {it.label}
										</li>
									))}
								</ul>
							) : data.preview === "tone" ? (
								<ul class="vis-tone">
									{(data.items ?? []).map((it, i) => (
										<li class:list={{ on: i === 0 }}>
											<Icon name={it.icon} /> {it.label}
											{i === 0 && (
												<span class="tick">
													<Icon name="check" size={15} />
												</span>
											)}
										</li>
									))}
								</ul>
							) : (
								<ul class="vis-list">
									{(data.items ?? []).map((it, i) => (
										<li class:list={{ ask: i === 0 }}>
											<Icon name={it.icon} /> {it.label}
										</li>
									))}
								</ul>
							)}
						</div>
						<div class="cap-copy">
							<h3>{data.title}</h3>
							{data.text && <p>{data.text}</p>}
							{data.link_url && (
								<a class="text-link" href={data.link_url}>
									{data.link_label ?? "Learn more"} <Icon name="arrow-right" size={18} />
								</a>
							)}
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="container section" id="how-it-works" aria-labelledby="how-title" style="scroll-margin-top:80px">
		<div class="section-head">
			<span class="eyebrow">How it works</span>
			<h2 id="how-title" class="h2">From research to a finished piece.</h2>
			<p>Four steps, one workspace. Every AI suggestion is shown to you first — nothing changes until you apply it.</p>
		</div>
		<div>
			{
				stages.entries.map(({ data }, i) => (
					<article class="stage" id={stageId(data)} aria-labelledby={`${stageId(data)}-title`}>
						<div class="stage-copy">
							<span class="stage-num">
								{String(i + 1).padStart(2, "0")} · {data.eyebrow ?? data.title}
							</span>
							<h3 id={`${stageId(data)}-title`} class="h2">
								{data.headline ?? data.title}
							</h3>
							{data.body && <p>{data.body}</p>}
							{(data.points ?? []).length > 0 && (
								<ol class="points">
									{(data.points ?? []).map((pt) => (
										<li>
											<div>
												<strong>{pt.title}</strong>
												{pt.text && <span>{pt.text}</span>}
											</div>
										</li>
									))}
								</ol>
							)}
						</div>
						<StagePreview preview={data.preview} title={data.title} />
					</article>
				))
			}
		</div>
	</section>

	<CtaBand />
</Base>
