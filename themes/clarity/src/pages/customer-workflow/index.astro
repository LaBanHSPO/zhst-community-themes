---
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getWorkflows, photoSrc, workflowUrl } from "../../lib/clarity";

const workflows = await getWorkflows();
if (Astro.cache?.enabled) Astro.cache.set(workflows.cacheHint);
---

<Base title="Customer workflows" description="Real Clarity workflows, from sample inputs to finished writing.">
	<section class="hero" aria-labelledby="wf-list-title">
		<div class="container" style="padding-block:4rem 3.2rem">
			<span class="eyebrow">Customer workflow</span>
			<h1 id="wf-list-title" class="display display-sm">Real inputs, <span class="accent">finished writing.</span></h1>
			<p class="lede" style="max-width:38rem;margin-top:1.4rem">Each workflow follows one actual sample from rough input to the piece that was shared.</p>
		</div>
	</section>
	<section class="container section" aria-label="Workflows">
		{
			workflows.entries.length === 0 ? (
				<p class="lede muted">No workflows have been published yet.</p>
			) : (
				<div class="wf-list">
					{workflows.entries.map(({ data }) => {
						const src = photoSrc(data.image, data.photo);
						return (
							<a class="wf-card" href={workflowUrl(data)}>
								{src && <img src={src} alt={data.photo_alt || data.image?.alt || ""} width="938" height="280" loading="lazy" />}
								<div>
									<span class="eyebrow" style="margin:0">{data.eyebrow ?? "Customer workflow"}</span>
									<h2>{data.title}</h2>
									{data.summary && <p>{data.summary}</p>}
								</div>
							</a>
						);
					})}
				</div>
			)
		}
	</section>
	<CtaBand />
</Base>
