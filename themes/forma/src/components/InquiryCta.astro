---
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
	heading?: string;
	text?: string;
	label?: string;
	href?: string;
}

const {
	heading = "Have a project in mind?",
	text = "Tell us what you are planning. We read every enquiry and reply within two working days.",
	label = "Start a project",
	href = "/contact",
} = Astro.props;
---

<section class="cta-band" aria-labelledby="inquiry-cta-heading">
	<div class="wrap">
		<div>
			<p class="eyebrow">New projects</p>
			<h2 id="inquiry-cta-heading">{heading}</h2>
		</div>
		<div>
			<p>{text}</p>
			<a href={href} class="btn">{label} <ArrowIcon /></a>
		</div>
	</div>
</section>
