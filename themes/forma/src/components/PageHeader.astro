---
import { splitFinalPeriod } from "../utils/content";

interface Props {
	title: string;
	eyebrow?: string | null;
	lede?: string | null;
	id?: string;
}

const { title, eyebrow, lede, id = "page-title" } = Astro.props;
const headline = splitFinalPeriod(title);
---

<header class="page-head">
	<div class="wrap page-head__inner">
		<div>
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h1 id={id}>
				{headline.text}{headline.period && <span class="accent-dot">.</span>}
			</h1>
		</div>
		{lede && <p class="lede page-head__lede">{lede}</p>}
		<slot />
	</div>
</header>

<style>
	.page-head {
		background: var(--paper);
		padding: clamp(3rem, 7vw, 6.5rem) 0 clamp(3rem, 6vw, 5rem);
	}

	.page-head__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		gap: 2rem clamp(3rem, 6vw, 6rem);
		align-items: end;
	}

	h1 {
		font-size: clamp(2.9rem, 6.6vw, 6.3rem);
		line-height: 0.96;
		letter-spacing: -0.035em;
		max-width: 13ch;
	}

	.page-head__lede {
		margin: 0;
	}

	@media (max-width: 900px) {
		.page-head__inner {
			grid-template-columns: 1fr;
		}
	}
</style>
