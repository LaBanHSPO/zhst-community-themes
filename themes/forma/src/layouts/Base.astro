---
import "@fontsource-variable/newsreader";
import "@fontsource-variable/manrope";
import "../styles/global.css";

import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	pageType?: "website" | "article";
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, pageType, content } = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menuItems = menuResult.data?.items ?? [];
const absoluteImage = image ? new URL(image, Astro.url.origin).href : null;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: pageType ?? "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image: absoluteImage,
	content,
	siteName: siteTitle,
});

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
function isCurrent(url: string): boolean {
	const target = url.replace(/\/$/, "") || "/";
	if (target === "/") return currentPath === "/";
	return currentPath === target || currentPath.startsWith(`${target}/`);
}
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#f1f0ec" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline>document.documentElement.classList.add("js");</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<div class="wrap site-header__inner">
				<a href="/" class="brand" aria-label={`${siteTitle}, home`}>
					{
						siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="brand__logo" />
						) : (
							<span class="brand__word">{siteTitle}</span>
						)
					}
				</a>
				{
					menuItems.length > 0 && (
						<nav class="site-nav" aria-label="Primary">
							<button
								type="button"
								class="site-nav__toggle"
								aria-expanded="false"
								aria-controls="site-nav-list"
								data-nav-toggle
							>
								<span class="site-nav__toggle-label">Menu</span>
								<span class="site-nav__toggle-icon" aria-hidden="true"></span>
							</button>
							<ul class="site-nav__list" id="site-nav-list">
								{menuItems.map((item) => (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
											aria-current={isCurrent(item.url) ? "page" : undefined}
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
			</div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap site-footer__inner">
				<div class="site-footer__brand">
					<a href="/" class="brand"><span class="brand__word">{siteTitle}</span></a>
					<p>{siteTagline}</p>
				</div>
				{
					menuItems.length > 0 && (
						<nav aria-label="Footer">
							<ul class="site-footer__nav">
								{menuItems.map((item) => (
									<li>
										<a href={item.url}>{item.label}</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
				<p class="site-footer__meta">© {year} {siteTitle}</p>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
			const nav = toggle?.closest(".site-nav");
			if (toggle && nav) {
				const setOpen = (open: boolean) => {
					toggle.setAttribute("aria-expanded", String(open));
					nav.classList.toggle("is-open", open);
				};
				toggle.addEventListener("click", () => {
					setOpen(toggle.getAttribute("aria-expanded") !== "true");
				});
				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape" && nav.classList.contains("is-open")) {
						setOpen(false);
						toggle.focus();
					}
				});
			}
		</script>
	</body>
</html>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		background: var(--paper);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		min-height: 5.75rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		color: var(--ink);
	}

	.brand__word {
		font-family: var(--font-body);
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: 0.42em;
		text-transform: uppercase;
		margin-right: -0.42em;
	}

	.brand__logo {
		height: 2.5rem;
		width: auto;
	}

	.site-nav__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem clamp(1.5rem, 4vw, 3.5rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-nav__list a {
		display: inline-block;
		padding-block: 0.4rem;
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
		color: var(--ink);
		border-bottom: 1px solid transparent;
	}

	.site-nav__list a:hover,
	.site-nav__list a[aria-current="page"] {
		border-bottom-color: var(--accent);
	}

	.site-nav__toggle {
		display: none;
	}

	@media (max-width: 760px) {
		.site-header__inner {
			min-height: 4.5rem;
		}

		:global(html.js) .site-nav__toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.75rem;
			padding: 0.6rem 0;
			background: none;
			border: 0;
			font: inherit;
			font-size: 0.85rem;
			font-weight: 600;
			letter-spacing: 0.16em;
			text-transform: uppercase;
			color: var(--ink);
			cursor: pointer;
		}

		.site-nav__toggle-icon,
		.site-nav__toggle-icon::before {
			display: block;
			width: 1.4rem;
			height: 1px;
			background: currentColor;
			transition: transform 0.25s var(--ease);
		}

		.site-nav__toggle-icon {
			position: relative;
			transform: translateY(-3px);
		}

		.site-nav__toggle-icon::before {
			content: "";
			position: absolute;
			top: 6px;
		}

		.site-nav.is-open .site-nav__toggle-icon {
			transform: rotate(45deg);
		}

		.site-nav.is-open .site-nav__toggle-icon::before {
			transform: translateY(-6px) rotate(-90deg);
		}

		:global(html.js) .site-nav__list {
			display: none;
			position: absolute;
			left: 0;
			right: 0;
			top: 100%;
			flex-direction: column;
			gap: 0;
			padding: 0.5rem var(--gutter) 1.5rem;
			background: var(--paper);
			border-bottom: 1px solid var(--line);
		}

		:global(html.js) .site-nav.is-open .site-nav__list {
			display: flex;
		}

		:global(html.js) .site-nav__list a {
			display: block;
			padding-block: 0.9rem;
			font-family: var(--font-display);
			font-size: 1.9rem;
			border-bottom: 1px solid var(--line);
		}

		:global(html.js) .site-nav__list a[aria-current="page"] {
			color: var(--accent-strong);
			border-bottom-color: var(--line);
		}
	}

	main:focus {
		outline: none;
	}

	.site-footer {
		border-top: 1px solid var(--line);
		background: var(--paper);
		font-size: 0.92rem;
	}

	.site-footer__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) auto auto;
		gap: 2rem 4rem;
		align-items: start;
		padding-block: 3.5rem;
	}

	.site-footer__brand p {
		margin: 1rem 0 0;
		color: var(--muted);
		max-width: 24rem;
	}

	.site-footer__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-footer__nav a {
		text-decoration: none;
	}

	.site-footer__nav a:hover {
		text-decoration: underline;
		text-decoration-color: var(--accent);
	}

	.site-footer__meta {
		margin: 0;
		color: var(--muted);
	}

	@media (max-width: 760px) {
		.site-footer__inner {
			grid-template-columns: 1fr;
		}
	}
</style>
