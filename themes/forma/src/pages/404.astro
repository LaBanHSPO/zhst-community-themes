---
import Base from "../layouts/Base.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
---

<Base title="Page not found">
	<section class="not-found" aria-labelledby="not-found-title">
		<div class="wrap">
			<p class="eyebrow">Error 404</p>
			<h1 id="not-found-title">This page took another shape<span class="accent-dot">.</span></h1>
			<p class="lede">The page you were looking for has moved or no longer exists.</p>
			<div class="not-found__links">
				<a href="/work" class="btn">See the work <ArrowIcon /></a>
				<a href="/" class="link-arrow">Back to home <ArrowIcon /></a>
			</div>
		</div>
	</section>
</Base>

<style>
	.not-found {
		background: var(--paper);
		padding: clamp(4rem, 10vw, 9rem) 0;
	}

	h1 {
		font-size: clamp(2.8rem, 6.5vw, 6rem);
		max-width: 13ch;
		margin-bottom: 1.75rem;
	}

	.not-found__links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem 2.5rem;
		margin-top: 2.5rem;
	}
</style>
