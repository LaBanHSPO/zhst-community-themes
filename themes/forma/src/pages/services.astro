---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import InquiryCta from "../components/InquiryCta.astro";
import PageHeader from "../components/PageHeader.astro";
import { indexLabel, lines } from "../utils/content";

const [pageResult, servicesResult] = await Promise.all([
	getEmDashEntry("pages", "services"),
	getEmDashCollection("services", { orderBy: { sort_order: "asc" }, limit: 50 }),
]);
if (pageResult.error || servicesResult.error) {
	return new Response("Could not load services", { status: 500 });
}
if (Astro.cache?.enabled) {
	Astro.cache.set(servicesResult.cacheHint);
	if (pageResult.entry) Astro.cache.set(pageResult.cacheHint);
}

const page = pageResult.entry;
const services = servicesResult.entries;
const steps = page?.data.points ?? [];
const hasContent = Array.isArray(page?.data.content) && page.data.content.length > 0;
---

<Base
	title="Services"
	description={page?.data.lede ?? "Brand identity, packaging, spaces and art direction."}
	content={page ? { collection: "pages", id: page.data.id, slug: "services" } : undefined}
>
	<PageHeader
		title={page?.data.title ?? "Services"}
		eyebrow={page?.data.eyebrow ?? "Services"}
		lede={page?.data.lede}
	/>

	<section class="section" aria-labelledby="services-list-title">
		<div class="wrap">
			<h2 id="services-list-title" class="visually-hidden">What we offer</h2>
			{
				services.length > 0 ? (
					<ol class="service-list">
						{services.map((service, index) => {
							const deliverables = lines(service.data.deliverables);
							return (
								<li class="service">
									<span class="index-num">{indexLabel(index)}</span>
									<div class="service__main">
										<h3>{service.data.title}</h3>
										{service.data.summary && <p>{service.data.summary}</p>}
									</div>
									{deliverables.length > 0 && (
										<div class="service__deliverables">
											<h4>Typical deliverables</h4>
											<ul>
												{deliverables.map((item) => (
													<li>{item}</li>
												))}
											</ul>
										</div>
									)}
								</li>
							);
						})}
					</ol>
				) : (
					<div class="empty-state">
						<h3>Services are being updated</h3>
						<p>
							In the meantime, <a href="/contact">tell us about your project</a> and we will explain how we can help.
						</p>
					</div>
				)
			}
			{hasContent && <div class="prose services-notes"><PortableText value={page?.data.content} /></div>}
		</div>
	</section>

	{
		steps.length > 0 && (
			<section class="section process" aria-labelledby="process-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">How a project runs</p>
							<h2 id="process-title">From first call to final files.</h2>
						</div>
					</div>
					<ol class="process__steps">
						{steps.map((step, index) => (
							<li>
								<span class="index-num">{indexLabel(index)}</span>
								<h3>{step.title}</h3>
								{step.text && <p>{step.text}</p>}
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	<InquiryCta heading="Not sure which service fits?" text="Most projects combine more than one. Describe what you need and we will suggest a scope." />
</Base>

<style>
	.service-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.service {
		display: grid;
		grid-template-columns: 4rem minmax(0, 1.2fr) minmax(0, 1fr);
		gap: 1.5rem clamp(2rem, 5vw, 5rem);
		padding: clamp(2rem, 4vw, 3.25rem) 0;
		border-top: 1px solid var(--line);
	}

	.service:last-child {
		border-bottom: 1px solid var(--line);
	}

	.service .index-num {
		padding-top: 0.9rem;
	}

	.service h3 {
		font-size: clamp(2rem, 3.8vw, 3.4rem);
		margin-bottom: 1rem;
	}

	.service__main p {
		color: var(--ink-soft);
		max-width: 32rem;
		margin: 0;
	}

	.service__deliverables h4 {
		margin: 0.9rem 0 1rem;
		font-family: var(--font-body);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.service__deliverables ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.service__deliverables li {
		padding: 0.45rem 0;
		border-bottom: 1px solid var(--line);
		font-size: 0.95rem;
	}

	.services-notes {
		margin-top: 3rem;
	}

	.process {
		background: var(--paper);
	}

	.process__steps {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 2.5rem clamp(2rem, 3vw, 3rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.process__steps h3 {
		margin: 1.25rem 0 0.75rem;
		font-size: 1.7rem;
	}

	.process__steps p {
		margin: 0;
		color: var(--muted);
	}

	@media (max-width: 900px) {
		.service {
			grid-template-columns: 1fr;
		}

		.service .index-num {
			padding-top: 0;
		}
	}
</style>
