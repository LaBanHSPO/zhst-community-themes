---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import { Form } from "@emdash-cms/plugin-forms/ui";
import Base from "../layouts/Base.astro";
import FactList from "../components/FactList.astro";
import PageHeader from "../components/PageHeader.astro";
import { safeHref } from "../utils/content";

/** Slug of the form created in the admin under Plugins → Forms. */
const INQUIRY_FORM_ID = "inquiry";

const rawProject = Astro.url.searchParams.get("project")?.trim() ?? "";
const projectSlug = /^[a-z0-9-]{1,120}$/.test(rawProject) ? rawProject : "";

const [pageResult, projectResult] = await Promise.all([
	getEmDashEntry("pages", "contact"),
	projectSlug ? getEmDashEntry("projects", projectSlug) : Promise.resolve(null),
]);
if (pageResult.error) {
	return new Response("Could not load the contact page", { status: 500 });
}
if (Astro.cache?.enabled && pageResult.entry) Astro.cache.set(pageResult.cacheHint);

const page = pageResult.entry;
const data = page?.data;
const facts = data?.facts ?? [];
const referencedProject = projectResult?.entry ?? null;
const emailFact = facts.find((fact) => fact.url?.startsWith("mailto:"));
const emailHref = safeHref(emailFact?.url);
const hasContent = Array.isArray(data?.content) && data.content.length > 0;
---

<Base
	title="Contact"
	description={data?.lede ?? "Start a new project with the studio."}
	content={page ? { collection: "pages", id: page.data.id, slug: "contact" } : undefined}
>
	<PageHeader
		title={data?.title ?? "Tell us about your project."}
		eyebrow={data?.eyebrow ?? "New projects"}
		lede={data?.lede}
	/>

	<section class="section contact" aria-label="Contact the studio">
		<div class="wrap contact__grid">
			<aside class="contact__details" aria-labelledby="details-title">
				<h2 id="details-title" class="contact__subhead">Studio details</h2>
				{
					facts.length > 0 ? (
						<FactList facts={facts} />
					) : (
						<p class="contact__muted">Contact details will be published here soon.</p>
					)
				}
				{hasContent && <div class="prose contact__notes"><PortableText value={data?.content} /></div>}
			</aside>

			<div class="contact__inquiry">
				<h2 class="contact__subhead" id="inquiry-title">New project inquiry</h2>
				{
					referencedProject && (
						<p class="contact__context">
							You came here from <a href={`/work/${referencedProject.id}`}>{referencedProject.data.title}</a>. Mention it in your message if you are planning something similar.
						</p>
					)
				}
				<div class="inquiry-slot" aria-labelledby="inquiry-title">
					<Form id={INQUIRY_FORM_ID} />
				</div>
				<div class="inquiry-fallback">
					<p>
						Prefer email? Send a few lines about your project, your timeline and a budget range{
							emailHref ? (
								<>
									{" "}to <a href={emailHref}>{emailFact?.value}</a>
								</>
							) : null
						}.
					</p>
					<ul>
						<li>What you are making and who it is for</li>
						<li>When you would like it ready</li>
						<li>A budget range, even a rough one</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.contact__grid {
		display: grid;
		grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1.3fr);
		gap: 3rem clamp(3rem, 7vw, 8rem);
		align-items: start;
	}

	.contact__subhead {
		margin-bottom: 1.5rem;
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.contact__muted,
	.contact__context {
		color: var(--muted);
	}

	.contact__context {
		margin-bottom: 1.75rem;
	}

	.contact__notes {
		margin-top: 2rem;
	}

	.inquiry-fallback {
		padding: clamp(1.75rem, 3vw, 2.5rem);
		background: var(--paper);
		border-left: 2px solid var(--accent);
	}

	.inquiry-fallback p {
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2.2vw, 1.9rem);
		line-height: 1.3;
		margin-bottom: 1.25rem;
	}

	.inquiry-fallback a {
		text-decoration-color: var(--accent);
	}

	.inquiry-fallback ul {
		margin: 0;
		padding-left: 1.1rem;
		color: var(--muted);
	}

	/* When the inquiry form exists, the email prompt becomes a quiet footnote. */
	.inquiry-slot:has(form) + .inquiry-fallback {
		margin-top: 2.5rem;
		padding: 1.25rem 0 0;
		background: none;
		border-left: 0;
		border-top: 1px solid var(--line);
	}

	.inquiry-slot:has(form) + .inquiry-fallback p {
		font-family: var(--font-body);
		font-size: 0.95rem;
		margin: 0;
		color: var(--muted);
	}

	.inquiry-slot:has(form) + .inquiry-fallback ul {
		display: none;
	}

	/* Forms plugin markup (@emdash-cms/plugin-forms) restyled for Forma */
	.inquiry-slot :global(.ec-form) {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.inquiry-slot :global(.ec-form-page) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		border: 0;
		margin: 0;
		padding: 0;
		min-width: 0;
	}

	.inquiry-slot :global(.ec-form-page-title) {
		grid-column: 1 / -1;
		font-family: var(--font-display);
		font-size: 1.6rem;
		padding: 0;
	}

	.inquiry-slot :global(.ec-form-field) {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		grid-column: 1 / -1;
	}

	.inquiry-slot :global(.ec-form-field--half) {
		grid-column: span 1;
	}

	.inquiry-slot :global(.ec-form-label) {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.inquiry-slot :global(.ec-form-required) {
		color: var(--accent-strong);
		margin-left: 0.2rem;
	}

	.inquiry-slot :global(.ec-form-input:not([type="checkbox"]):not([type="radio"])) {
		width: 100%;
		padding: 0.85rem 0;
		font: inherit;
		font-size: 1.05rem;
		color: var(--ink);
		background: transparent;
		border: 0;
		border-bottom: 1px solid #9b968e;
		border-radius: 0;
	}

	.inquiry-slot :global(textarea.ec-form-input) {
		min-height: 8rem;
		resize: vertical;
	}

	.inquiry-slot :global(.ec-form-input:focus-visible) {
		outline: none;
		border-bottom: 2px solid var(--accent-strong);
		margin-bottom: -1px;
	}

	.inquiry-slot :global(.ec-form-input[aria-invalid="true"]) {
		border-bottom-color: #a4161a;
	}

	.inquiry-slot :global(.ec-form-help) {
		font-size: 0.85rem;
		color: var(--muted);
	}

	.inquiry-slot :global(.ec-form-error) {
		font-size: 0.85rem;
		color: #a4161a;
	}

	.inquiry-slot :global(.ec-form-radio-group),
	.inquiry-slot :global(.ec-form-checkbox-group) {
		border: 0;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
	}

	.inquiry-slot :global(.ec-form-radio-label),
	.inquiry-slot :global(.ec-form-checkbox-label) {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.inquiry-slot :global(.ec-form-nav) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
	}

	.inquiry-slot :global(.ec-form-submit),
	.inquiry-slot :global(.ec-form-next) {
		padding: 1.05rem 1.75rem;
		font: inherit;
		font-weight: 550;
		color: var(--on-accent);
		background: var(--accent-strong);
		border: 1px solid var(--accent-strong);
		cursor: pointer;
	}

	.inquiry-slot :global(.ec-form-prev) {
		padding: 1.05rem 1.5rem;
		font: inherit;
		background: transparent;
		border: 1px solid var(--ink);
		cursor: pointer;
	}

	.inquiry-slot :global(.ec-form-submit:hover),
	.inquiry-slot :global(.ec-form-next:hover) {
		background: var(--ink);
		border-color: var(--ink);
	}

	.inquiry-slot :global(.ec-form-status) {
		font-weight: 550;
	}

	@media (max-width: 900px) {
		.contact__grid {
			grid-template-columns: 1fr;
		}

		.contact__inquiry {
			order: -1;
		}

		.inquiry-slot :global(.ec-form-page) {
			grid-template-columns: 1fr;
		}

		.inquiry-slot :global(.ec-form-field--half) {
			grid-column: 1 / -1;
		}
	}
</style>
