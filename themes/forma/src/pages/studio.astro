---
import { getEmDashEntry } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import FactList from "../components/FactList.astro";
import InquiryCta from "../components/InquiryCta.astro";
import PageHeader from "../components/PageHeader.astro";
import { indexLabel } from "../utils/content";

const pageResult = await getEmDashEntry("pages", "studio");
if (pageResult.error) {
	return new Response("Could not load the studio page", { status: 500 });
}
if (Astro.cache?.enabled && pageResult.entry) Astro.cache.set(pageResult.cacheHint);

const page = pageResult.entry;
const data = page?.data;
const principles = data?.points ?? [];
const facts = data?.facts ?? [];
const hasContent = Array.isArray(data?.content) && data.content.length > 0;
---

<Base
	title="Studio"
	description={data?.lede ?? "About the studio."}
	image={data?.hero_image?.src}
	content={page ? { collection: "pages", id: page.data.id, slug: "studio" } : undefined}
>
	<PageHeader title={data?.title ?? "Studio"} eyebrow={data?.eyebrow ?? "Studio"} lede={data?.lede} />

	{
		data?.hero_image && (
			<figure class="wrap studio-cover">
				<div class="frame">
					<Image image={data.hero_image} priority sizes="(min-width: 1440px) 1300px, 100vw" />
				</div>
			</figure>
		)
	}

	<section class="section" aria-label="About the studio">
		<div class="wrap studio-body">
			{
				hasContent ? (
					<div class="prose" {...page?.edit.content}>
						<PortableText value={data?.content} />
					</div>
				) : (
					<p class="lede">{data?.lede ?? "We are a small design studio working across identity, packaging, spaces and art direction."}</p>
				)
			}
			{facts.length > 0 && <aside aria-label="Studio details"><FactList facts={facts} /></aside>}
		</div>
	</section>

	{
		principles.length > 0 && (
			<section class="section principles" aria-labelledby="principles-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">How we work</p>
							<h2 id="principles-title">A few things we hold on to.</h2>
						</div>
					</div>
					<ol class="principles__list">
						{principles.map((item, index) => (
							<li>
								<span class="index-num">{indexLabel(index)}</span>
								<h3>{item.title}</h3>
								{item.text && <p>{item.text}</p>}
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	<InquiryCta />
</Base>

<style>
	.studio-cover {
		margin: 0 auto;
	}

	.studio-cover .frame {
		aspect-ratio: 21 / 9;
	}

	.studio-body {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.8fr);
		gap: 3rem clamp(3rem, 7vw, 8rem);
		align-items: start;
	}

	.studio-body .prose {
		font-size: clamp(1.05rem, 1.25vw, 1.2rem);
	}

	.principles {
		background: var(--paper);
	}

	.principles__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 2.5rem clamp(2rem, 3vw, 3rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.principles__list h3 {
		margin: 1.25rem 0 0.75rem;
		font-size: 1.75rem;
	}

	.principles__list p {
		margin: 0;
		color: var(--muted);
	}

	@media (max-width: 900px) {
		.studio-cover {
			padding-inline: 0;
		}

		.studio-cover .frame {
			aspect-ratio: 4 / 3;
		}

		.studio-body {
			grid-template-columns: 1fr;
		}
	}
</style>
