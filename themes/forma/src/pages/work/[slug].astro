---
import { decodeSlug, getEmDashCollection, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { disciplineLine, disciplinesOf } from "../../utils/content";

const slug = decodeSlug(Astro.params.slug);
if (!slug) {
	return Astro.rewrite("/404");
}

const [projectResult, listResult, settings] = await Promise.all([
	getEmDashEntry("projects", slug),
	getEmDashCollection("projects", { orderBy: { sort_order: "asc", published_at: "desc" }, limit: 50 }),
	getSiteSettings(),
]);
if (projectResult.error || listResult.error) {
	return new Response("Could not load the project", { status: 500 });
}
const project = projectResult.entry;
if (!project) {
	return Astro.rewrite("/404");
}
if (Astro.cache?.enabled) {
	Astro.cache.set(projectResult.cacheHint);
	Astro.cache.set(listResult.cacheHint);
}

const data = project.data;
const disciplines = disciplinesOf(data);
const all = listResult.entries;
const position = all.findIndex((entry) => entry.id === project.id);
const next = all.length > 1 ? all[(position + 1) % all.length] : undefined;
const nextProject = next && next.id !== project.id ? next : undefined;

const facts = [
	{ label: "Client", value: data.client },
	{ label: "Year", value: data.year },
	{ label: "Location", value: data.location },
	{ label: "Discipline", value: disciplineLine(disciplines) },
	{ label: "Scope", value: data.deliverables },
].filter((fact): fact is { label: string; value: string } => Boolean(fact.value?.trim()));

const hasBlocks = (value: unknown[] | undefined) => Array.isArray(value) && value.length > 0;
const chapters = [
	{ id: "brief", label: "The brief", value: data.brief },
	{ id: "approach", label: "Approach", value: data.approach },
	{ id: "outcome", label: "Outcome", value: data.outcome },
].filter((chapter) => hasBlocks(chapter.value));
const gallery = (data.gallery ?? []).filter((item) => item?.image);

const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(project, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/work/${slug}`,
	defaultDescription: data.summary,
	defaultOgImage: data.featured_image?.src,
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	pageType="article"
	content={{ collection: "projects", id: data.id, slug }}
>
	<article class="case" aria-labelledby="case-title">
		<header class="case-head">
			<div class="wrap case-head__inner">
				<div>
					<nav aria-label="Breadcrumb" class="crumbs">
						<a href="/work">Work</a>
						{disciplines[0] && (
							<>
								<span aria-hidden="true">/</span>
								<a href={`/work?discipline=${encodeURIComponent(disciplines[0].slug)}`}>{disciplines[0].label}</a>
							</>
						)}
					</nav>
					<h1 id="case-title" {...project.edit.title}>{data.title}</h1>
					{data.summary && <p class="lede case-head__summary" {...project.edit.summary}>{data.summary}</p>}
				</div>
				{
					facts.length > 0 && (
						<dl class="case-facts">
							{facts.map((fact) => (
								<div>
									<dt>{fact.label}</dt>
									<dd>{fact.value}</dd>
								</div>
							))}
						</dl>
					)
				}
			</div>
		</header>

		{
			data.featured_image && (
				<figure class="case-cover wrap" {...project.edit.featured_image}>
					<div class="frame case-cover__frame">
						<Image image={data.featured_image} priority sizes="(min-width: 1440px) 1300px, 100vw" />
					</div>
				</figure>
			)
		}

		{
			chapters.length > 0 && (
				<div class="wrap case-chapters">
					{chapters.map((chapter, index) => (
						<section class="chapter" id={chapter.id} aria-labelledby={`${chapter.id}-title`}>
							<div class="chapter__label">
								<span class="index-num">{String(index + 1).padStart(2, "0")}</span>
								<h2 id={`${chapter.id}-title`}>{chapter.label}</h2>
							</div>
							<div class="prose chapter__body">
								<PortableText value={chapter.value} />
							</div>
						</section>
					))}
				</div>
			)
		}

		{
			gallery.length > 0 && (
				<section class="wrap case-gallery" aria-label={`${data.title} gallery`}>
					{gallery.map((item) => (
						<figure class:list={["case-gallery__item", item.layout === "half" ? "is-half" : "is-full"]}>
							<div class="frame">
								<Image image={item.image} sizes={item.layout === "half" ? "(min-width: 900px) 50vw, 100vw" : "100vw"} />
							</div>
							{item.caption && <figcaption>{item.caption}</figcaption>}
						</figure>
					))}
				</section>
			)
		}

		<section class="case-cta" aria-labelledby="case-cta-title">
			<div class="wrap case-cta__inner">
				<div>
					<p class="eyebrow">Start a conversation</p>
					<h2 id="case-cta-title">Planning something similar?</h2>
				</div>
				<div>
					<p>Tell us about your brief, your timeline and a budget range. We reply to every enquiry within two working days.</p>
					<a href={`/contact?project=${encodeURIComponent(slug)}`} class="btn">Start a project <ArrowIcon /></a>
				</div>
			</div>
		</section>

		{
			nextProject && (
				<nav class="next-project" aria-label="Next project">
					<a href={`/work/${nextProject.id}`} class="wrap next-project__link">
						<span class="eyebrow">Next project</span>
						<span class="next-project__title">
							{nextProject.data.title} <ArrowIcon size={40} />
						</span>
					</a>
				</nav>
			)
		}
	</article>
</Base>

<style>
	.case-head {
		background: var(--paper);
		padding: clamp(2.5rem, 6vw, 5.5rem) 0 clamp(3rem, 6vw, 5rem);
	}

	.case-head__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 0.75fr);
		gap: 3rem clamp(3rem, 6vw, 7rem);
		align-items: end;
	}

	.crumbs {
		display: flex;
		gap: 0.75rem;
		margin-bottom: 1.75rem;
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.crumbs a {
		text-decoration: none;
	}

	.crumbs a:hover {
		color: var(--ink);
		text-decoration: underline;
	}

	.case-head h1 {
		font-size: clamp(3.4rem, 9vw, 8.5rem);
		line-height: 0.92;
		letter-spacing: -0.04em;
	}

	.case-head__summary {
		margin: 1.75rem 0 0;
	}

	.case-facts {
		margin: 0;
		display: grid;
		gap: 0;
		border-top: 1px solid var(--line);
	}

	.case-facts div {
		display: grid;
		grid-template-columns: 7rem minmax(0, 1fr);
		gap: 1rem;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--line);
		font-size: 0.92rem;
	}

	.case-facts dt {
		color: var(--muted);
		font-weight: 600;
	}

	.case-facts dd {
		margin: 0;
	}

	.case-cover {
		margin: 0 auto;
		padding-top: 0;
	}

	.case-cover__frame {
		margin-top: calc(-1 * clamp(0rem, 2vw, 1.5rem));
		aspect-ratio: 16 / 9;
	}

	.case-chapters {
		padding-block: var(--section);
		display: grid;
		gap: clamp(3.5rem, 7vw, 6rem);
	}

	.chapter {
		display: grid;
		grid-template-columns: minmax(12rem, 0.6fr) minmax(0, 1.4fr);
		gap: 1.5rem clamp(2rem, 6vw, 6rem);
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}

	.chapter__label h2 {
		margin-top: 1.25rem;
		font-size: clamp(1.9rem, 3vw, 2.7rem);
	}

	.chapter__body {
		font-size: clamp(1.05rem, 1.2vw, 1.18rem);
	}

	.case-gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1rem, 2.5vw, 2rem);
		padding-bottom: var(--section);
	}

	.case-gallery__item {
		margin: 0;
	}

	.case-gallery__item.is-full {
		grid-column: 1 / -1;
	}

	.case-gallery__item.is-full .frame {
		aspect-ratio: 16 / 9;
	}

	.case-gallery__item.is-half .frame {
		aspect-ratio: 4 / 5;
	}

	.case-gallery figcaption {
		margin-top: 0.9rem;
		font-size: 0.88rem;
		color: var(--muted);
		max-width: 36rem;
	}

	.case-cta {
		background: var(--paper);
		border-top: 1px solid var(--line);
	}

	.case-cta__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		gap: 2rem 4rem;
		align-items: end;
		padding-block: clamp(3.5rem, 7vw, 6rem);
	}

	.case-cta h2 {
		font-size: clamp(2.3rem, 4.8vw, 4.2rem);
	}

	.case-cta p {
		color: var(--muted);
	}

	.next-project {
		background: var(--ink);
		color: var(--paper-raised);
	}

	.next-project__link {
		display: block;
		padding-block: clamp(3rem, 6vw, 5rem);
		text-decoration: none;
	}

	.next-project .eyebrow {
		color: #c9c5be;
		margin-bottom: 1rem;
	}

	.next-project__title {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		font-family: var(--font-display);
		font-size: clamp(2.6rem, 6vw, 5.5rem);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.next-project__link:hover .next-project__title {
		color: var(--accent);
	}

	.next-project__link:focus-visible {
		outline-color: var(--paper-raised);
		outline-offset: -6px;
	}

	@media (max-width: 900px) {
		.case-head__inner,
		.chapter,
		.case-cta__inner {
			grid-template-columns: 1fr;
		}

		.case-cover {
			padding-inline: 0;
		}

		.case-cover__frame {
			aspect-ratio: 4 / 3;
			margin-top: 0;
		}

		.case-gallery {
			grid-template-columns: 1fr;
		}

		.case-gallery__item.is-half .frame,
		.case-gallery__item.is-full .frame {
			aspect-ratio: 4 / 3;
		}
	}
</style>
