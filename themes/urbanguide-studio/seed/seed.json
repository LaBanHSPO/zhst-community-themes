{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "UrbanGuide Studio",
		"description": "A local directory theme with listings, categories and guides, in a studio layout",
		"author": "ZeroHostCMS"
	},
	"settings": {
		"title": "UrbanGuide",
		"tagline": "Discover your city"
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Guides",
			"labelSingular": "Guide",
			"urlPattern": "/posts/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"scheduling",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		},
		{
			"slug": "listings",
			"label": "Listings",
			"labelSingular": "Listing",
			"urlPattern": "/listings/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search"
			],
			"fields": [
				{
					"slug": "name",
					"label": "Name",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "category",
					"label": "Category",
					"type": "string"
				},
				{
					"slug": "address",
					"label": "Address",
					"type": "string"
				},
				{
					"slug": "phone",
					"label": "Phone",
					"type": "string"
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "url",
					"label": "Website",
					"type": "string"
				},
				{
					"slug": "available",
					"label": "Open now",
					"type": "boolean"
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": false,
			"collections": [
				"listings"
			],
			"terms": [
				{
					"slug": "eat",
					"label": "Food & Drink"
				},
				{
					"slug": "shop",
					"label": "Shopping"
				},
				{
					"slug": "stay",
					"label": "Hotels"
				},
				{
					"slug": "see",
					"label": "Things to Do"
				},
				{
					"slug": "coffee",
					"label": "Coffee"
				},
				{
					"slug": "services",
					"label": "Services"
				}
			]
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": [
				"posts"
			],
			"terms": [
				{
					"slug": "neighborhood",
					"label": "Neighborhood"
				},
				{
					"slug": "weekend",
					"label": "Weekend"
				},
				{
					"slug": "riverside",
					"label": "Riverside"
				}
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{
					"type": "custom",
					"label": "Home",
					"url": "/"
				},
				{
					"type": "custom",
					"label": "Places",
					"url": "/listings"
				},
				{
					"type": "custom",
					"label": "Guides",
					"url": "/posts"
				},
				{
					"type": "custom",
					"label": "About",
					"url": "/about"
				}
			]
		}
	],
	"widgetAreas": [
		{
			"name": "sidebar",
			"label": "Sidebar",
			"description": "Sidebar widget area",
			"widgets": [
				{
					"type": "component",
					"componentId": "core:search",
					"title": "Search"
				}
			]
		}
	],
	"content": {
		"pages": [
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "About",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "UrbanGuide Studio is a synthetic local-directory theme for the ZeroHostCMS community catalog. Every place, guide and phone number on this demo is invented.",
									"_key": "a0s"
								}
							],
							"_key": "a0"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Replace the sample listings, guides and this page with your own content in the admin panel.",
									"_key": "a1s"
								}
							],
							"_key": "a1"
						}
					]
				}
			}
		],
		"posts": [
			{
				"id": "post-1",
				"slug": "welcome",
				"status": "published",
				"data": {
					"title": "Welcome to UrbanGuide Studio",
					"excerpt": "How this sample directory is organised, and how to make it yours.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "This is a sample guide for the UrbanGuide Studio theme. Places live in the Listings collection; guides like this one live in Guides.",
									"_key": "w0s"
								}
							],
							"_key": "w0"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Find your way around",
									"_key": "w1s"
								}
							],
							"_key": "w1"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Use the search bar or the category chips on the home page to filter places. Each place page shows its address, phone number and website when they are filled in.",
									"_key": "w2s"
								}
							],
							"_key": "w2"
						}
					]
				},
				"taxonomies": {
					"category": [
						"eat"
					],
					"tag": [
						"neighborhood"
					]
				}
			},
			{
				"id": "post-2",
				"slug": "a-slow-saturday-by-the-river",
				"status": "published",
				"data": {
					"title": "A slow Saturday by the river",
					"excerpt": "A sample walking route that strings together coffee, a museum and a bike ride.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Start with a coffee, wander to the museum before lunch, then rent a bike for the river path. All the places in this sample route are fictional.",
									"_key": "r0s"
								}
							],
							"_key": "r0"
						}
					]
				},
				"taxonomies": {
					"tag": [
						"weekend",
						"riverside"
					]
				}
			},
			{
				"id": "post-3",
				"slug": "new-in-the-neighborhood",
				"status": "published",
				"data": {
					"title": "New in the neighborhood",
					"excerpt": "A sample checklist for your first week: groceries, repairs and a place to stay.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Moving somewhere new? This sample guide shows how to point readers at useful local services listed in the directory.",
									"_key": "n0s"
								}
							],
							"_key": "n0"
						}
					]
				},
				"taxonomies": {
					"tag": [
						"neighborhood"
					]
				}
			}
		],
