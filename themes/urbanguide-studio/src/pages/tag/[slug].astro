---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import GuideCard from "../../components/GuideCard.astro";
import Icon from "../../components/Icon.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base
	title={`Guides tagged "${term.label}"`}
	description={`Guides tagged ${term.label}`}
>
	<header class="ug-page-head">
		<p class="ug-eyebrow"><Icon name="tag" size={16} /> Tag</p>
		<h1 class="ug-page-title">#{term.label}</h1>
		<p class="ug-lede">
			{posts.length} {posts.length === 1 ? "guide" : "guides"} · <a href="/posts">All guides</a>
		</p>
	</header>

	<section class="ug-section" aria-label={`Guides tagged ${term.label}`}>
		{
			posts.length === 0 ? (
				<p class="ug-empty">No guides with this tag yet.</p>
			) : (
				<ul class="ug-grid ug-grid--guides">
					{posts.map((post) => (
						<li>
							<GuideCard post={post} />
						</li>
					))}
				</ul>
			)
		}
		<nav class="ug-pagination" aria-label="Pagination">
			{cursor && <a class="ug-btn ug-btn--ghost" href={`/tag/${term.slug}`}>First page</a>}
			{
				nextCursor && (
					<a class="ug-btn ug-btn--blue" href={`/tag/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}>
						Next page
					</a>
				)
			}
		</nav>
	</section>
</Base>
