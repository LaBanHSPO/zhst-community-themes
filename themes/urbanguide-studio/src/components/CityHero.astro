---
/** Hero band with an original illustrated waterfront skyline (inline SVG). */
interface Props {
	compact?: boolean;
	class?: string;
}
const { compact = false, class: className } = Astro.props;
---

<section class:list={["hero", { "hero--compact": compact }, className]}>
	<svg class="hero__scene" viewBox="0 0 1200 420" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
		<defs>
			<linearGradient id="ug-sky" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#dbe8ff" />
				<stop offset="0.65" stop-color="#f4f8ff" />
				<stop offset="1" stop-color="#fff4ef" />
			</linearGradient>
			<linearGradient id="ug-water" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#cfe0ff" />
				<stop offset="1" stop-color="#eaf1ff" />
			</linearGradient>
			<linearGradient id="ug-tower" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="#5d8df0" />
				<stop offset="1" stop-color="#2f62cf" />
			</linearGradient>
			<linearGradient id="ug-fade" x1="0" y1="0" x2="1" y2="0">
				<stop offset="0" stop-color="#eef4ff" stop-opacity=".95" />
				<stop offset="0.42" stop-color="#eef4ff" stop-opacity=".55" />
				<stop offset="0.62" stop-color="#eef4ff" stop-opacity="0" />
			</linearGradient>
		</defs>
		<rect width="1200" height="420" fill="url(#ug-sky)" />
		<g opacity=".85">
		<circle cx="1010" cy="92" r="46" fill="#ffd9cc" opacity=".8" />
		<!-- far skyline -->
		<g fill="#b9cdf5" opacity=".9">
			<rect x="520" y="170" width="38" height="140" />
			<rect x="566" y="140" width="30" height="170" />
			<rect x="604" y="188" width="44" height="122" />
			<rect x="900" y="150" width="34" height="160" />
			<rect x="940" y="176" width="46" height="134" />
			<rect x="1120" y="160" width="40" height="150" />
		</g>
		<!-- main towers -->
		<g>
			<rect x="660" y="110" width="52" height="200" fill="url(#ug-tower)" />
			<rect x="676" y="84" width="20" height="26" fill="#2f62cf" />
			<rect x="724" y="70" width="64" height="240" fill="#3f73e0" />
			<rect x="744" y="44" width="24" height="26" fill="#2a59c2" />
			<rect x="800" y="132" width="46" height="178" fill="#6d97ef" />
			<rect x="852" y="96" width="40" height="214" fill="#2f62cf" />
			<rect x="1000" y="120" width="56" height="190" fill="url(#ug-tower)" />
			<rect x="1062" y="150" width="40" height="160" fill="#86a9f2" />
			<rect x="996" y="104" width="64" height="16" fill="#f0583f" />
		</g>
		<g fill="#ffffff" opacity=".55">
			<rect x="734" y="90" width="44" height="3" />
			<rect x="734" y="110" width="44" height="3" />
			<rect x="734" y="130" width="44" height="3" />
			<rect x="734" y="150" width="44" height="3" />
			<rect x="734" y="170" width="44" height="3" />
			<rect x="734" y="190" width="44" height="3" />
			<rect x="1010" y="140" width="36" height="3" />
			<rect x="1010" y="160" width="36" height="3" />
			<rect x="1010" y="180" width="36" height="3" />
		</g>
		<!-- low town & trees -->
		<g fill="#f6d9c8">
			<rect x="880" y="250" width="60" height="60" />
			<rect x="944" y="236" width="48" height="74" />
		</g>
		<g fill="#7fb38b">
			<circle cx="1150" cy="246" r="44" />
			<circle cx="1100" cy="266" r="32" />
			<circle cx="1190" cy="270" r="36" />
			<circle cx="860" cy="276" r="26" />
			<circle cx="640" cy="282" r="22" />
		</g>
		<!-- water -->
		<rect y="306" width="1200" height="114" fill="url(#ug-water)" />
		<g fill="#ffffff" opacity=".7">
			<rect x="640" y="330" width="120" height="3" rx="1.5" />
			<rect x="820" y="352" width="160" height="3" rx="1.5" />
			<rect x="1010" y="334" width="110" height="3" rx="1.5" />
			<rect x="700" y="378" width="90" height="3" rx="1.5" />
		</g>
		<path d="M1060 306c20-36 100-36 120 0" fill="none" stroke="#9db7ea" stroke-width="5" />
		</g>
		<rect width="1200" height="420" fill="url(#ug-fade)" />
	</svg>
	<div class="hero__content">
		<slot />
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		border-radius: var(--ug-radius-lg);
		background: #eaf1ff;
		border: 1px solid #dbe5f7;
		isolation: isolate;
	}
	.hero__scene {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
	}
	.hero__content {
		position: relative;
		padding: clamp(1.75rem, 4vw, 3.75rem) clamp(1.25rem, 6vw, 5.5rem) clamp(1.5rem, 3vw, 2.5rem);
		min-height: clamp(300px, 30vw, 380px);
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1.25rem;
	}
	.hero__content :global(.ug-lede) {
		max-width: 42ch;
	}
	.hero--compact .hero__content {
		min-height: 0;
		padding-block: clamp(1.5rem, 3vw, 2.25rem);
	}
	@media (max-width: 760px) {
		.hero__scene {
			opacity: 0.35;
		}
		.hero__content {
			min-height: 0;
		}
	}
</style>
