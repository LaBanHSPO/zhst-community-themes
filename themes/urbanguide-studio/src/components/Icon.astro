---
/** Original 24px line icons (stroke = currentColor). Decorative by default. */
export type IconName =
	| "home"
	| "compass"
	| "grid"
	| "pin"
	| "book"
	| "info"
	| "search"
	| "chevron-right"
	| "arrow-right"
	| "arrow-left"
	| "menu"
	| "close"
	| "phone"
	| "globe"
	| "clock"
	| "tag"
	| "fork"
	| "bag"
	| "bed"
	| "camera"
	| "cup"
	| "wrench"
	| "leaf"
	| "dots"
	| "dot"
	| "calendar";

interface Props {
	name: IconName;
	size?: number;
	class?: string;
	label?: string;
}

const { name, size = 20, class: className, label } = Astro.props;

const paths: Record<IconName, string> = {
	home: '<path d="M3.5 10.5 12 3.8l8.5 6.7"/><path d="M5.5 9v10.5h4.75V14h3.5v5.5h4.75V9"/>',
	compass: '<circle cx="12" cy="12" r="8.75"/><path d="m15.6 8.4-2.1 5.1-5.1 2.1 2.1-5.1z"/>',
	grid: '<rect x="4" y="4" width="6.5" height="6.5" rx="1.6"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.6"/>',
	pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',
	book: '<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v15H5.5A1.5 1.5 0 0 0 4 20.5z"/><path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H13v15h5.5a1.5 1.5 0 0 1 1.5 1.5z"/>',
	info: '<circle cx="12" cy="12" r="8.75"/><path d="M12 11v5.5"/><path d="M12 7.6v.1"/>',
	search: '<circle cx="10.8" cy="10.8" r="6.3"/><path d="m15.5 15.5 4.6 4.6"/>',
	"chevron-right": '<path d="m9.5 6 6 6-6 6"/>',
	"arrow-right": '<path d="M5 12h14"/><path d="m13.5 6.5 5.5 5.5-5.5 5.5"/>',
	"arrow-left": '<path d="M19 12H5"/><path d="M10.5 6.5 5 12l5.5 5.5"/>',
	menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
	close: '<path d="m6 6 12 12"/><path d="M18 6 6 18"/>',
	phone: '<path d="M6.7 3.8h2.6l1.4 4-1.9 1.3a10.5 10.5 0 0 0 6.1 6.1l1.3-1.9 4 1.4v2.6a2 2 0 0 1-2.1 2A15.4 15.4 0 0 1 4.7 5.9a2 2 0 0 1 2-2.1z"/>',
	globe: '<circle cx="12" cy="12" r="8.75"/><path d="M3.5 12h17"/><path d="M12 3.3c2.4 2.4 3.5 5.3 3.5 8.7s-1.1 6.3-3.5 8.7c-2.4-2.4-3.5-5.3-3.5-8.7S9.6 5.7 12 3.3z"/>',
	clock: '<circle cx="12" cy="12" r="8.75"/><path d="M12 7.5V12l3 2"/>',
	tag: '<path d="M3.8 12.2V4.6a.8.8 0 0 1 .8-.8h7.6l8 8-8.4 8.4z"/><circle cx="8.2" cy="8.2" r="1.3"/>',
	fork: '<path d="M7 3.5v6.2a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2V3.5"/><path d="M9 11.7v8.8"/><path d="M16.5 20.5V3.5c-2 1.4-3 3.8-3 6.8v3.2h3"/>',
	bag: '<path d="M5 8h14l-1 12H6z"/><path d="M8.8 10.5V7a3.2 3.2 0 0 1 6.4 0v3.5"/>',
	bed: '<path d="M3.5 18.5V6.5"/><path d="M3.5 14h17v4.5"/><path d="M20.5 14v-2.5a3 3 0 0 0-3-3H11V14"/><circle cx="7.3" cy="10.8" r="1.8"/>',
	camera: '<path d="M4 8.5A1.5 1.5 0 0 1 5.5 7h2.3l1.5-2.2h5.4L16.2 7h2.3A1.5 1.5 0 0 1 20 8.5v9A1.5 1.5 0 0 1 18.5 19h-13A1.5 1.5 0 0 1 4 17.5z"/><circle cx="12" cy="12.8" r="3.3"/>',
	cup: '<path d="M5 9h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5z"/><path d="M16 10.5h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M8.5 3.5c-.7 1 .7 1.8 0 3"/><path d="M12 3.5c-.7 1 .7 1.8 0 3"/>',
	wrench: '<path d="M14.6 4.2a4.6 4.6 0 0 0-5.3 6L4.2 15.3a2.1 2.1 0 0 0 3 3l5.1-5.1a4.6 4.6 0 0 0 6-5.3l-2.8 2.8-2.6-.4-.4-2.6z"/>',
	leaf: '<path d="M5 19c0-8.5 5.2-13.5 14-14 .2 8.8-4.9 14-13 14z"/><path d="M5 19 13 11"/>',
	dots: '<circle cx="5.5" cy="12" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="18.5" cy="12" r="1.2"/>',
	dot: '<circle cx="12" cy="12" r="2.6"/>',
	calendar: '<rect x="4" y="5.5" width="16" height="14.5" rx="2"/><path d="M4 10h16"/><path d="M8.5 3.5v4"/><path d="M15.5 3.5v4"/>',
};
---

<svg
	class:list={["icon", className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden={label ? undefined : "true"}
	role={label ? "img" : undefined}
	aria-label={label}
	focusable="false"
	set:html={paths[name]}
/>
