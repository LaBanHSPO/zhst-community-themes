---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Badges from "../../components/Badges.astro";
import Strip from "../../components/Strip.astro";
import { getGuarantees, getServices, photoSrc, quoteUrl, serviceUrl } from "../../lib/fixwell";

const [servicesResult, badges, strip] = await Promise.all([
	getServices(),
	getGuarantees("badges"),
	getGuarantees("strip"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(servicesResult.cacheHint);
	Astro.cache.set(badges.cacheHint);
	Astro.cache.set(strip.cacheHint);
}
const services = servicesResult.entries.filter((s) => s.data.on_services);
// The page header lists the guarantees in the reverse order of the hero badges.
const headBadges = [...badges.entries].reverse();
---

<Base title="Our services" description="Plumbing, electrical and home repair services to keep your home safe, comfortable and running smoothly.">
	<section class="page-head container-wide" aria-labelledby="services-title">
		<div>
			<span class="eyebrow eyebrow-muted">What we do</span>
			<h1 id="services-title" class="display display-dark">Our <span class="accent">services</span></h1>
			<p class="page-lede">Reliable plumbing and home repair services to keep your home safe, comfortable and running smoothly.</p>
		</div>
		<Badges items={headBadges} stacked />
	</section>

	<ul class="service-panels container-wide" aria-label="Services">
		{
			services.map((s) => {
				const src = photoSrc(s.data.image, s.data.photo);
				const titleId = `svc-${s.data.slug ?? s.data.id}`;
				return (
					<li class="service-panel">
						<article aria-labelledby={titleId}>
							{src && <img src={src} alt={s.data.image?.alt || `A Fixwell tradesperson at work: ${s.data.title.toLowerCase()}`} width="513" height="254" loading="lazy" />}
							<div class="service-panel-body">
								<h2 id={titleId}>
									<a href={serviceUrl(s.data)}>{s.data.title}</a>
								</h2>
								{s.data.intro && <p class="service-intro">{s.data.intro}</p>}
								{(s.data.checklist ?? []).length > 0 && (
									<ul class="checklist">
										{(s.data.checklist ?? []).map((c) => <li>{c.item}</li>)}
									</ul>
								)}
								<a class="btn" href={quoteUrl(s.data.issue)}>
									{s.data.request_label || `Request ${s.data.title.toLowerCase()}`} <Arrow />
								</a>
							</div>
						</article>
					</li>
				);
			})
		}
	</ul>

	<Strip items={strip.entries} />
</Base>
