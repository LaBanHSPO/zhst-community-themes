---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Badges from "../components/Badges.astro";
import Hero from "../components/Hero.astro";
import Strip from "../components/Strip.astro";
import { getGuarantees, getServices, photoSrc, quoteUrl, serviceUrl } from "../lib/fixwell";

const [servicesResult, badges, strip] = await Promise.all([
	getServices(),
	getGuarantees("badges"),
	getGuarantees("strip"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(servicesResult.cacheHint);
	Astro.cache.set(badges.cacheHint);
	Astro.cache.set(strip.cacheHint);
}
const cards = servicesResult.entries.filter((s) => s.data.on_home).slice(0, 3);
---

<Base title="Small repairs. Sorted." description="Reliable plumbing and home repair services for a safer, more comfortable home.">
	<Hero photo="/images/hero-home.webp" alt="A Fixwell plumber kneeling at an open kitchen cabinet, fitting the pipework under the sink" labelledby="home-title">
		<span class="eyebrow">Local plumbers you can count on</span>
		<h1 id="home-title" class="display">Small repairs.<br /><span class="accent">Sorted.</span></h1>
		<p class="hero-lede">Reliable plumbing and home repair services for a safer, more comfortable home.</p>
		<a class="btn btn-lg" href={quoteUrl()}>Request a quote <Arrow /></a>
		<Badges items={badges.entries} />
	</Hero>

	<section class="section container" aria-labelledby="services-title">
		<div class="section-head">
			<h2 id="services-title" class="title-rule">Our services</h2>
			<a class="link-arrow" href="/services"><span>View all services</span> <Arrow /></a>
		</div>
		<ul class="card-grid">
			{
				cards.map((s) => {
					const src = photoSrc(s.data.card_image, s.data.card_photo) ?? photoSrc(s.data.image, s.data.photo);
					return (
						<li class="service-card">
							<a href={serviceUrl(s.data)}>
								{src && <img src={src} alt={s.data.card_image?.alt || `${s.data.card_title ?? s.data.title} by Fixwell`} width="427" height="151" loading="lazy" />}
								<div class="service-card-body">
									<div>
										<h3>{s.data.card_title || s.data.title}</h3>
										{s.data.card_text && <p>{s.data.card_text}</p>}
									</div>
									<Arrow />
								</div>
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>

	<Strip items={strip.entries} />
</Base>
