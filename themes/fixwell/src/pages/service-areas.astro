---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Badges from "../components/Badges.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import Strip from "../components/Strip.astro";
import { findArea, getAreas, getGuarantees, outwardCode, quoteUrl } from "../lib/fixwell";

const [areasResult, badges, strip] = await Promise.all([
	getAreas(),
	getGuarantees("badges-areas"),
	getGuarantees("strip-areas"),
]);
if (Astro.cache?.enabled) {
	for (const hint of [areasResult.cacheHint, badges.cacheHint, strip.cacheHint]) {
		Astro.cache.set(hint);
	}
}
const areas = areasResult.entries;

// Server-side postcode check (?postcode=BS3 5PL) — works without JavaScript.
const postcode = (Astro.url.searchParams.get("postcode") ?? "").trim().slice(0, 12);
const checked = postcode.length > 0;
const match = checked ? findArea(areas.map((a) => a.data), postcode) : undefined;
const code = checked ? outwardCode(postcode) : "";

// Map: up to six highlighted districts in fixed positions around the centre.
const SLOTS: Record<number, { x: number; y: number; r: number }> = {
	1: { x: 246, y: 84, r: 70 },
	2: { x: 142, y: 152, r: 66 },
	3: { x: 330, y: 154, r: 66 },
	4: { x: 234, y: 196, r: 58 },
	5: { x: 180, y: 258, r: 64 },
	6: { x: 312, y: 262, r: 62 },
};
function blob({ x, y, r }: { x: number; y: number; r: number }, seed: number): string {
	const pts: string[] = [];
	for (let i = 0; i < 12; i++) {
		const a = (Math.PI * 2 * i) / 12 + seed * 0.3;
		const k = 1 + 0.09 * Math.sin(i * 2.3 + seed);
		pts.push(`${(x + Math.cos(a) * r * k).toFixed(1)},${(y + Math.sin(a) * r * 0.86 * k).toFixed(1)}`);
	}
	return `M${pts.join("L")}Z`;
}
const mapAreas = areas
	.filter((a) => a.data.map_slot && SLOTS[a.data.map_slot])
	.map((a) => ({ title: a.data.title, slot: SLOTS[a.data.map_slot ?? 0]!, n: a.data.map_slot ?? 0 }));
---

<Base title="Service areas" description="Plumbing and home repair services across our local area. Check your postcode or request a callback.">
	<Hero photo="/images/hero-areas.webp" alt="A Fixwell tradesperson walking from the branded van towards a row of brick houses" labelledby="areas-title" class="hero-areas">
		<span class="eyebrow">Local coverage</span>
		<h1 id="areas-title" class="display">Service areas<br /><span class="accent">near you.</span></h1>
		<p class="hero-lede">Trusted plumbing and home repair services across our local area. Fast, reliable and always nearby.</p>
		<Badges items={badges.entries} />
	</Hero>

	<div class="areas-grid container">
		<section aria-labelledby="list-title">
			<h2 id="list-title" class="title-rule title-md">Our service area</h2>
			<p class="areas-intro">We provide plumbing and home repair services across the following areas:</p>
			<ul class="area-list">
				{
					areas.map((a) => (
						<li>
							<Icon name="pin" />
							{a.data.title}
						</li>
					))
				}
			</ul>
		</section>

		<figure class="area-map">
			<svg viewBox="0 0 440 340" role="img" aria-labelledby="map-cap">
				<rect width="440" height="340" fill="#eef1ee" />
				<path d="M0 214c40-8 62 6 92-6 22-9 34-2 46 6" fill="none" stroke="#a9c9e6" stroke-width="9" stroke-linecap="round" />
				<path d="M0 60c90 20 160-30 240-10s150 40 200 20M30 340c40-90 100-120 180-150s170-40 230-110M0 300c110-30 190 10 260-20s120-50 180-40M120 0c-10 90 40 160 20 240s-20 80-10 100M340 0c20 80-10 150 20 230s40 80 40 110" fill="none" stroke="#fff" stroke-width="4" />
				<path d="M60 0l40 340M0 120h440M200 0l-30 340M0 170c120 10 200-30 440-10M400 0l-60 340" fill="none" stroke="#dfe5df" stroke-width="1.5" />
				<path d="M20 20h40v30H20zM380 290h44v34h-44zM30 260l30-12 14 26-30 12z" fill="#d7e6cf" />
				{
					mapAreas.map((m) => (
						<g class="map-area">
							<path d={blob(m.slot, m.n)} />
							<text x={m.slot.x} y={m.slot.y + 5} text-anchor="middle">{m.title}</text>
						</g>
					))
				}
			</svg>
			<figcaption id="map-cap" class="sr-only">Map of the districts we cover: {mapAreas.map((m) => m.title).join(", ")}.</figcaption>
		</figure>

		<aside class="check-card" aria-labelledby="check-title" id="check">
			<h2 id="check-title">Check your area</h2>
			<p>Enter your postcode to see if we cover your location.</p>
			<form class="postcode-form" action="/service-areas#check" method="get" role="search" aria-label="Check your postcode">
				<label class="sr-only" for="postcode">Postcode</label>
				<Icon name="pin" />
				<input id="postcode" name="postcode" type="text" placeholder="Enter your postcode" value={postcode} autocomplete="postal-code" maxlength="10" required />
				<button type="submit" aria-label="Check postcode"><Arrow /></button>
			</form>
			<p class:list={["check-result", { "is-yes": match, "is-no": checked && !match }]} role="status" aria-live="polite">
				{
					checked &&
						(match ? (
							<>Good news: we cover {code} ({match.title}).</>
						) : (
							<>We don't list {code || postcode} yet. Request a callback and we'll confirm.</>
						))
				}
			</p>
			<hr />
			<h2 id="talk-title">Prefer to talk?</h2>
			<p>Request a callback and we’ll confirm if we cover your area.</p>
			<a class="btn btn-lg btn-block" href={quoteUrl("other", checked ? `Callback request: is ${postcode} covered?` : "Callback request: do you cover my area?")}>Request a callback <Arrow /></a>
		</aside>
	</div>

	<Strip items={strip.entries} />
</Base>
