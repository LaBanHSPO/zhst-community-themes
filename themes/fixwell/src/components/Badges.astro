---
/** Row of small icon + label guarantees shown under a hero (or beside a page title). */
import Icon from "./Icon.astro";
import type { Guarantee } from "../lib/fixwell";

interface Props {
	items: { data: Guarantee }[];
	stacked?: boolean;
	class?: string;
}
const { items, stacked = false, class: className } = Astro.props;
---

{
	items.length > 0 && (
		<ul class:list={["badges", { "badges-stacked": stacked }, className]}>
			{items.map((b) => (
				<li>
					<Icon name={b.data.icon ?? "house"} />
					<span>{b.data.title}</span>
				</li>
			))}
		</ul>
	)
}
