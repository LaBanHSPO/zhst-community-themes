	"content": {
		"pages": [
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "Independent advice for leaders who want to move forward.",
					"eyebrow": "About Northbridge",
					"intro": "Northbridge is a small, senior team of consultants who help organisations make clear choices and see them through. We work with founders, chief executives and leadership teams across services, technology and the public sector.",
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "We started Northbridge because we saw too many good organisations receive long reports and too little help acting on them. Our work is built around a simple idea: advice should leave you clearer, more capable and ready to act.",
									"_key": "b0s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b1",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "We keep our team deliberately small. The people you meet at the start are the people who do the work, and we only take on engagements where we believe we can make a real difference.",
									"_key": "b1s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b2",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Who we work with",
									"_key": "b2s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b3",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Our clients range from growing companies preparing for their next stage to established organisations rethinking how they operate. What they share is ambition and a willingness to look honestly at what needs to change.",
									"_key": "b3s"
								}
							],
							"markDefs": []
						}
					]
				}
			},
			{
				"id": "working-together",
				"slug": "working-together",
				"status": "published",
				"data": {
					"title": "What working together looks like",
					"eyebrow": "Working together",
					"intro": "Every engagement is shaped around your situation, but most follow a similar rhythm. Here is what to expect from the first conversation onwards.",
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "An initial conversation",
									"_key": "b0s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b1",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "We start with an informal call to understand what you are facing. There is no charge and no obligation, and we will tell you honestly if we are not the right fit.",
									"_key": "b1s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b2",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "A short proposal",
									"_key": "b2s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b3",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "If it makes sense to continue, we send a short proposal setting out the questions we would work on, who would be involved, the timeline and a fixed fee.",
									"_key": "b3s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b4",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Regular check-ins",
									"_key": "b4s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b5",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "During the engagement you will have a single point of contact and a fortnightly review of progress, so there are no surprises at the end.",
									"_key": "b5s"
								}
							],
							"markDefs": []
						}
					]
				}
			},
			{
				"id": "privacy",
				"slug": "privacy",
				"status": "published",
				"data": {
					"title": "Privacy notice",
					"eyebrow": "Privacy",
					"intro": "This sample notice explains how this website handles information. Replace it with your own before publishing.",
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "This website does not use analytics, advertising cookies or third-party trackers, and it does not store messages sent through the contact page. The contact form prepares an email in your own email app; nothing is sent until you send that email.",
									"_key": "b0s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b1",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "If you write to us, we use your details only to reply and to arrange any follow-up you ask for. You can ask us to delete your correspondence at any time.",
									"_key": "b1s"
								}
							],
							"markDefs": []
						}
					]
				}
			}
		],
		"services": [
			{
				"id": "strategy-growth",
				"slug": "strategy-growth",
				"status": "published",
				"data": {
					"title": "Strategy & Growth",
					"summary": "Sharper strategy, new opportunities, sustainable momentum.",
					"icon": "chart",
					"tone": "navy",
					"featured": true,
					"position": 10,
					"intro": "We help leadership teams decide where to play and how to win, then turn that choice into a plan people can act on.",
					"photo": "/images/planning-session.webp",
					"engagement": "Typically 6 to 12 weeks",
					"outcomes": "A clear, shared view of where you are heading and why\nA short list of priorities with owners and timelines\nA growth case your board and team can test and support\nMeasures that tell you early whether the plan is working",
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Most organisations do not lack ideas. They lack a shared, honest picture of where they stand and the confidence to say no to good options so they can say yes to the right ones.",
									"_key": "b0s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b1",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "What we do",
									"_key": "b1s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b2",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "We start with listening: to your leadership team, your people and, where it helps, your customers. We bring the evidence together into a small number of strategic questions and work through them with you in focused sessions rather than long reports.",
									"_key": "b2s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b3",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Market and position review, grounded in your own data",
									"_key": "b3s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b4",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Strategic options and the trade-offs between them",
									"_key": "b4s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b5",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Growth planning for new services, markets or partnerships",
									"_key": "b5s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b6",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Board and leadership team facilitation",
									"_key": "b6s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b7",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "How it feels to work with us",
									"_key": "b7s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b8",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "You will see working drafts early and often. We would rather test a rough idea with you on day ten than present a polished one on day sixty.",
									"_key": "b8s"
								}
							],
							"markDefs": []
						}
					]
				}
			},
			{
				"id": "people-organisation",
				"slug": "people-organisation",
				"status": "published",
				"data": {
					"title": "People & Organisation",
					"summary": "Stronger teams, healthier cultures, greater performance.",
					"icon": "people",
					"tone": "sage",
					"featured": true,
					"position": 20,
					"intro": "Strategy only moves as fast as the organisation behind it. We help you shape structures, roles and ways of working that make the right things easier.",
					"photo": "/images/team-laptop.webp",
					"engagement": "Typically 8 to 16 weeks",
					"outcomes": "Roles and decision rights that people understand\nAn organisation design that fits the strategy, not the org chart of five years ago\nLeaders equipped to have the conversations change requires\nA practical plan for culture, not a poster on the wall",
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Growth, mergers and new leadership all stretch an organisation in ways that are easy to feel and hard to name. Meetings multiply, decisions stall and good people start to drift.",
									"_key": "b0s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b1",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "What we do",
									"_key": "b1s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b2",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Organisation design and operating model reviews",
									"_key": "b2s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b3",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Leadership team effectiveness and development",
									"_key": "b3s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b4",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Culture diagnostics and practical action plans",
									"_key": "b4s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b5",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Capability building for managers leading change",
									"_key": "b5s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b6",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Our approach",
									"_key": "b6s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b7",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "We work alongside your HR and leadership teams, involve the people affected early, and design for the organisation you are becoming. Every recommendation comes with the steps to put it in place.",
									"_key": "b7s"
								}
							],
							"markDefs": []
						}
					]
				}
			},
			{
				"id": "transformation",
				"slug": "transformation",
				"status": "published",
				"data": {
					"title": "Transformation",
					"summary": "Turn ambitious ideas into real, lasting change.",
					"icon": "gear",
					"tone": "taupe",
					"featured": true,
					"position": 30,
					"intro": "From a new operating model to a new way of serving customers, we help you plan, sequence and deliver change that lasts beyond the launch.",
					"photo": "/images/strategy-tiles.webp",
					"engagement": "Typically 3 to 12 months",
