		"insights": [
			{
				"id": "strategy-on-a-page",
				"slug": "strategy-on-a-page",
				"status": "published",
				"data": {
					"title": "Why your strategy should fit on a single page",
					"topic": "Strategy",
					"reading_time": "5 min read",
					"date": "2026-10-14T08:00:00.000Z",
					"photo": "/images/team-workshop.webp",
					"excerpt": "If your team cannot explain the strategy in two minutes, it is not yet a strategy. Here is how we help leaders get to one page.",
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Long strategy documents feel thorough. They also tend to sit unread on shared drives while day-to-day decisions are made on instinct.",
									"_key": "b0s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b1",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "A strategy that fits on one page forces the hard choices into the open: where you will focus, what you will stop doing and how you will know it is working.",
									"_key": "b1s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b2",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Three questions to start with",
									"_key": "b2s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b3",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Who do we serve best, and what do they value most?",
									"_key": "b3s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b4",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "What will we do differently from the alternatives they have?",
									"_key": "b4s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b5",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "What are we prepared to stop doing to make room for it?",
									"_key": "b5s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b6",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Test it with the people who will use it",
									"_key": "b6s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b7",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Share the draft with managers two or three levels below the leadership team. Ask them which decisions it would change next week. If the answer is none, keep working.",
									"_key": "b7s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b8",
							"style": "blockquote",
							"children": [
								{
									"_type": "span",
									"text": "A good strategy is one your team can use to say no without asking permission.",
									"_key": "b8s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b9",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "The page is not the end of the work, but it is the clearest sign that the thinking is done.",
									"_key": "b9s"
								}
							],
							"markDefs": []
						}
					]
				}
			},
			{
				"id": "decisions-in-growing-teams",
				"slug": "decisions-in-growing-teams",
				"status": "published",
				"data": {
					"title": "Making decisions faster as your organisation grows",
					"topic": "People & Organisation",
					"reading_time": "6 min read",
					"date": "2026-09-30T08:00:00.000Z",
					"photo": "/images/team-laptop.webp",
					"excerpt": "Growth adds people, meetings and sign-offs. A few simple agreements about who decides what can give teams their pace back.",
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "In a team of twenty, everyone knows who to ask. In a team of two hundred, the same question can travel through four meetings before anyone feels able to answer it.",
									"_key": "b0s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b1",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Name the decisions, not just the roles",
									"_key": "b1s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b2",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Job descriptions rarely say which decisions a role owns. List the twenty decisions that come up most often and agree, for each, who decides, who must be consulted and who simply needs to know.",
									"_key": "b2s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b3",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Make it safe to decide",
									"_key": "b3s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b4",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Clarity on paper only helps if people feel trusted to act on it. Leaders set the tone by backing reasonable decisions that turn out wrong and talking openly about what they learned.",
									"_key": "b4s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b5",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Revisit the agreements every six months. Organisations change, and decision rights should change with them.",
									"_key": "b5s"
								}
							],
							"markDefs": []
						}
					]
				}
			},
			{
				"id": "change-that-sticks",
				"slug": "change-that-sticks",
				"status": "published",
				"data": {
					"title": "Five habits of change programmes that last",
					"topic": "Transformation",
					"reading_time": "7 min read",
					"date": "2026-09-16T08:00:00.000Z",
					"photo": "/images/strategy-tiles.webp",
					"excerpt": "Launch day is the easy part. What separates lasting change from a short-lived initiative is what happens in the months after.",
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Most transformation plans are strongest at the start: clear goals, energy and executive attention. The risk comes later, when attention moves on and old habits return.",
									"_key": "b0s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b1",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "What lasting programmes have in common",
									"_key": "b1s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b2",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "They define success in terms customers and colleagues would notice.",
									"_key": "b2s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b3",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "They sequence the work so early stages fund and inform later ones.",
									"_key": "b3s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b4",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "They give frontline managers the tools and time to lead the change.",
									"_key": "b4s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b5",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "They review progress honestly and adjust the plan without blame.",
									"_key": "b5s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b6",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "They plan the handover from the start, so the change outlives the programme.",
									"_key": "b6s"
								}
							],
							"markDefs": [],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b7",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "None of these are complicated. All of them require steady attention long after the launch event.",
									"_key": "b7s"
								}
							],
							"markDefs": []
						}
					]
				}
			},
			{
				"id": "first-hundred-days",
				"slug": "first-hundred-days",
				"status": "published",
				"data": {
					"title": "A practical guide to a leader's first hundred days",
					"topic": "Leadership",
					"reading_time": "4 min read",
					"date": "2026-09-02T08:00:00.000Z",
					"photo": "/images/client-meeting.webp",
					"excerpt": "New leaders feel pressure to act quickly. The best first hundred days balance listening, a few early wins and a clear story about what comes next.",
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "The first weeks in a senior role shape how colleagues, boards and customers see a new leader for years. It pays to plan them deliberately.",
									"_key": "b0s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b1",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Listen widely, then share what you heard",
									"_key": "b1s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b2",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Meet people across levels and locations, not only your direct reports. Then play back what you heard. It shows you listened and gives everyone a common starting point.",
									"_key": "b2s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b3",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Choose a few visible early wins",
									"_key": "b3s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b4",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Pick two or three problems that frustrate people and can be fixed quickly. Solving them builds trust for the harder choices to come.",
									"_key": "b4s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b5",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Tell a clear story about what comes next",
									"_key": "b5s"
								}
							],
							"markDefs": []
						},
						{
							"_type": "block",
							"_key": "b6",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "By day one hundred, people should know what you believe, what will change and what will stay the same.",
									"_key": "b6s"
								}
							],
							"markDefs": []
						}
					]
				}
			}
		],
