---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getOffice, getPrinciples, getServices, photoSrc } from "../../lib/consulting";

const [servicesResult, approachResult, officeResult] = await Promise.all([
	getServices(),
	getPrinciples("approach"),
	getOffice(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(servicesResult.cacheHint);
	Astro.cache.set(approachResult.cacheHint);
	Astro.cache.set(officeResult.cacheHint);
}
const services = servicesResult.entries;
const steps = approachResult.entries;
const { office } = officeResult;
---

<Base title="Services" description="Strategy, organisation, transformation and leadership advice from Northbridge.">
	<section class="page-head">
		<div class="container page-head-inner">
			<div>
				<span class="eyebrow">Services</span>
				<h1>Focused support where it matters most.</h1>
			</div>
			<p class="lede">
				Every engagement is shaped around your situation. These are the areas where we most often help leadership teams move from complexity to clear action.
			</p>
		</div>
	</section>

	<section class="section section-warm section-flush">
		<div class="container">
			{
				services.length > 0 ? (
					<div class="service-list">
						{services.map((s) => {
							const src = photoSrc(s.data.image, s.data.photo);
							return (
								<article class="service-row">
									<div class="service-row-body">
										<ServiceIcon icon={s.data.icon} tone={s.data.tone} size="sm" />
										<h2 {...s.edit.title}>
											<a href={`/services/${s.data.slug ?? s.data.id}`}>{s.data.title}</a>
										</h2>
										<p class="summary">{s.data.summary}</p>
										{s.data.intro && <p class="intro">{s.data.intro}</p>}
										<span class="link-arrow" aria-hidden="true">
											Explore <Arrow />
										</span>
									</div>
									<div class="service-row-photo">
										{src && <img src={src} alt={s.data.image?.alt ?? ""} loading="lazy" decoding="async" />}
									</div>
								</article>
							);
						})}
					</div>
				) : (
					<p class="empty">Services will appear here once they are added in the admin.</p>
				)
			}
		</div>
	</section>

	{
		steps.length > 0 && (
			<section class="section" aria-labelledby="how-title">
				<div class="container">
					<span class="eyebrow">How engagements run</span>
					<h2 id="how-title" class="section-title">One simple rhythm, shaped to you.</h2>
					<ol class="steps steps-row">
						{steps.map((step, i) => (
							<li>
								<span class="step-num">{String(i + 1).padStart(2, "0")}</span>
								<h3>{step.data.title}</h3>
								{step.data.text && <p>{step.data.text}</p>}
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	<CtaBand office={office} title="Not sure where to start?" text="Tell us about the challenge in front of you and we will suggest where we can help, or point you to someone better placed." />
</Base>
