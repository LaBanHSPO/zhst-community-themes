---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ServiceCard from "../components/ServiceCard.astro";
import InsightCard from "../components/InsightCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { getInsights, getOffice, getPrinciples, getServices } from "../lib/consulting";

const [servicesResult, approachResult, insightsResult, officeResult] = await Promise.all([
	getServices(),
	getPrinciples("approach"),
	getInsights(3),
	getOffice(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(servicesResult.cacheHint);
	Astro.cache.set(approachResult.cacheHint);
	Astro.cache.set(insightsResult.cacheHint);
	Astro.cache.set(officeResult.cacheHint);
}
const featured = servicesResult.entries.filter((s) => s.data.featured);
const services = (featured.length ? featured : servicesResult.entries).slice(0, 3);
const steps = approachResult.entries;
const insights = insightsResult.entries;
const { office } = officeResult;
---

<Base
	title="Northbridge | Business Consulting"
	description="We help ambitious organisations solve complex challenges, unlock opportunity and build a brighter, more resilient future."
	overlay
>
	<section class="hero" aria-labelledby="hero-title">
		<img
			class="hero-photo"
			src="/images/hero-home.webp"
			alt="Four colleagues smiling around a laptop at a meeting table in a bright city office"
			width="1448"
			height="674"
			fetchpriority="high"
		/>
		<div class="hero-fade" aria-hidden="true"></div>
		<div class="container hero-inner">
			<div class="hero-copy">
				<p class="eyebrow hero-eyebrow">People <span>Strategy</span> <span>Progress</span></p>
				<h1 id="hero-title"><span>Clarity for</span> <span>your next</span> <span>chapter.</span></h1>
				<p class="hero-lede">
					We help ambitious organisations solve complex challenges, unlock opportunity and build a brighter, more resilient future.
				</p>
				<a class="btn btn-lg hero-cta" href="/contact">Talk to us <Arrow /></a>
			</div>
			<p class="hero-note"><span>Brighter</span> <span>Businesses</span> <span>Stronger</span> <span>People</span></p>
		</div>
	</section>

	<section class="help" aria-labelledby="help-title">
		<div class="container help-inner">
			<div class="help-intro">
				<span class="eyebrow">How we help</span>
				<h2 id="help-title">From insight to impact.</h2>
				<p>Practical thinking. Lasting results. We work with you to turn complexity into clarity and ambition into action.</p>
				<span class="rule" aria-hidden="true"></span>
			</div>
			{
				services.length > 0 ? (
					<div class="service-grid">
						{services.map((s) => (
							<ServiceCard service={s} />
						))}
					</div>
				) : (
					<p class="empty">Services will appear here once they are added in the admin.</p>
				)
			}
		</div>
	</section>

	<section class="approach" aria-labelledby="approach-title">
		<div class="container approach-inner">
			<figure class="approach-photo">
				<img
					src="/images/planning-session.webp"
					alt="Three consultants reviewing a printed plan together at a large table"
					width="842"
					height="680"
					loading="lazy"
					decoding="async"
				/>
			</figure>
			<div class="approach-copy">
				<span class="eyebrow">Our approach</span>
				<h2 id="approach-title">Clear thinking, shared with your team.</h2>
				<p class="lede">
					We work alongside your people rather than handing over a report. Every engagement follows the same simple rhythm, shaped to your situation.
				</p>
				{
					steps.length > 0 && (
						<ol class="steps">
							{steps.map((step, i) => (
								<li>
									<span class="step-num">{String(i + 1).padStart(2, "0")}</span>
									<h3 {...step.edit.title}>{step.data.title}</h3>
									{step.data.text && <p>{step.data.text}</p>}
								</li>
							))}
						</ol>
					)
				}
				<a class="link-arrow" href="/about">More about us <Arrow /></a>
			</div>
		</div>
	</section>

	{
		insights.length > 0 && (
			<section class="insights-band" aria-labelledby="insights-title">
				<div class="container">
					<div class="section-head">
						<div>
							<span class="eyebrow">Insights</span>
							<h2 id="insights-title">Ideas for your next move.</h2>
						</div>
						<a class="link-arrow" href="/insights">All insights <Arrow /></a>
					</div>
					<div class="insight-grid">
						{insights.map((post) => (
							<InsightCard post={post} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<CtaBand office={office} />
</Base>
