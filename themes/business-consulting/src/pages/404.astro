---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<section class="notfound">
		<div class="container">
			<svg class="notfound-mark" viewBox="0 0 48 34" aria-hidden="true" focusable="false">
				<path class="mark-a" d="M0 29 14.5 0h3L26 20l-3 5-8.5-9.5L7.5 29z" />
				<path class="mark-b" d="M19 30.5 33.8 0h2.7L48 30l-.5 4-4-.5-9.2-19-8.8 19-4-1z" />
			</svg>
			<span class="eyebrow">404 · Page not found</span>
			<h1>This chapter hasn't been written.</h1>
			<p>The page you're looking for has moved or never existed. Let's get you back on track.</p>
			<div class="actions">
				<a class="btn" href="/">Back to home</a>
				<a class="btn btn-outline" href="/services">Explore our services</a>
			</div>
		</div>
	</section>
</Base>
