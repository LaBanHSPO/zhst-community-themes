---
import { getEmDashCollection, getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/inter";
import Logo from "../components/Logo.astro";
import Arrow from "../components/Arrow.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getOffice, getServices, mapHref, telHref } from "../lib/consulting";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Header sits transparently over the page's first (photographic) section. */
	overlay?: boolean;
	/** Force which primary-menu URL is marked current. */
	current?: string;
}

const { title, pageTitle, description, image, canonical, content, overlay = false, current } = Astro.props;
const [settingsResult, menuResult, officeResult, servicesResult, pagesResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getOffice(),
	getServices(),
	getEmDashCollection("pages", { limit: 20 }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(officeResult.cacheHint);
	Astro.cache.set(servicesResult.cacheHint);
	Astro.cache.set(pagesResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? `${siteTitle} — ${siteTagline}`;
const navItems = menuResult.data?.items ?? [];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const norm = (url: string) => url.replace(/\/$/, "") || "/";
const { office } = officeResult;
const services = servicesResult.entries;
// CMS pages not already in the primary menu (e.g. working together, privacy) are linked from the footer.
const menuUrls = new Set(navItems.map((i) => norm(i.url)));
const extraPages = pagesResult.entries
	.map((p) => ({ url: `/${p.data.slug ?? p.data.id}`, label: p.data.title, short: p.data.eyebrow }))
	.filter((p) => !menuUrls.has(p.url));

const currentUrl =
	current ??
	navItems.find((i) => norm(i.url) === path)?.url ??
	navItems.find((i) => norm(i.url) !== "/" && path.startsWith(`${norm(i.url)}/`))?.url;
const onContact = path === "/contact";

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Intl.DateTimeFormat("en-GB", { year: "numeric", timeZone: "Asia/Saigon" }).format(new Date());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class:list={["site-head", { "is-overlay": overlay }]}>
			<div class="head-inner">
				<Logo title={siteTitle} tagline={siteTagline} logo={siteLogo} class="head-logo" />
				<nav class="nav" aria-label="Primary">
					{
						navItems.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={item.url === currentUrl ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<a class="btn head-cta" href="/contact" aria-current={onContact ? "page" : undefined}>Talk to us</a>
				<details class="mobile-nav">
					<summary aria-label="Open menu">
						<svg class="burger" width="22" height="14" viewBox="0 0 22 14" aria-hidden="true" focusable="false">
							<path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.6" />
						</svg>
						<svg class="close" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
							<path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.6" />
						</svg>
					</summary>
					<nav class="mobile-panel" aria-label="Primary (mobile)">
						{
							navItems.map((item) => (
								<a href={item.url} aria-current={item.url === currentUrl ? "page" : undefined}>
									{item.label}
								</a>
							))
						}
						<a class="btn" href="/contact" aria-current={onContact ? "page" : undefined}>Talk to us <Arrow /></a>
						{office.phone && <a class="mobile-phone" href={telHref(office.phone)}>Call {office.phone}</a>}
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="container foot-inner">
				<div class="foot-brand">
					<Logo title={siteTitle} tagline={siteTagline} logo={siteLogo} />
					<p>Independent advice for leaders who want clarity, momentum and lasting results.</p>
				</div>
				<div>
					<h2>Services</h2>
					<ul class="foot-links">
						{services.map((s) => <li><a href={`/services/${s.data.slug ?? s.data.id}`}>{s.data.title}</a></li>)}
					</ul>
				</div>
				<div>
					<h2>Company</h2>
					<ul class="foot-links">
						{navItems.map((item) => <li><a href={item.url}>{item.label}</a></li>)}
						{extraPages.map((p) => <li><a href={p.url}>{p.short || p.label}</a></li>)}
					</ul>
				</div>
				<div>
					<h2>Office</h2>
					{
						(office.street || office.locality) && (
							<address>
								<a href={mapHref(office)} target="_blank" rel="noopener noreferrer">
									{office.street && <>{office.street}<br /></>}
									{office.locality && <>{office.locality}<br /></>}
									{office.country}
								</a>
							</address>
						)
					}
					{office.phone && <a href={telHref(office.phone)}>{office.phone}</a>}
					{office.email && <a href={`mailto:${office.email}`}>{office.email}</a>}
				</div>
			</div>
			<div class="container foot-bottom">
				<span>© {year} {office.title || siteTitle}</span>
				<span>Built with EmDash</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
