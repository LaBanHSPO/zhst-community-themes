---
/** Round badge with a line icon, as on the homepage service cards. */
interface Props {
	icon?: string | null;
	tone?: string | null;
	size?: "md" | "sm";
}
const { icon = "chart", tone = "navy", size = "md" } = Astro.props;
---

<span class:list={["badge", `badge-${tone ?? "navy"}`, `badge-${size}`]} aria-hidden="true">
	<svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
		{
			icon === "people" ? (
				<>
					<circle cx="16" cy="10.5" r="3.6" />
					<circle cx="8.6" cy="12.6" r="2.8" />
					<circle cx="23.4" cy="12.6" r="2.8" />
					<path d="M9.6 25.5v-2.2a6.4 6.4 0 0 1 12.8 0v2.2z" />
					<path d="M8 19.6a5 5 0 0 0-5 5v.9h4.4M24 19.6a5 5 0 0 1 5 5v.9h-4.4" />
				</>
			) : icon === "gear" ? (
				<>
					<circle cx="16" cy="16" r="3.8" />
					<path d="M14 4.5h4l.6 3.2 2.3 1 2.7-1.9 2.8 2.8-1.9 2.7 1 2.3 3.2.6v4l-3.2.6-1 2.3 1.9 2.7-2.8 2.8-2.7-1.9-2.3 1-.6 3.2h-4l-.6-3.2-2.3-1-2.7 1.9-2.8-2.8 1.9-2.7-1-2.3-3.2-.6v-4l3.2-.6 1-2.3-1.9-2.7 2.8-2.8 2.7 1.9 2.3-1z" />
				</>
			) : icon === "compass" ? (
				<>
					<circle cx="16" cy="16" r="11" />
					<path d="m20.4 11.6-2.7 6.1-6.1 2.7 2.7-6.1z" />
					<path d="M16 5v2M16 25v2M5 16h2M25 16h2" />
				</>
			) : (
				<>
					<path d="M6 26h20" />
					<rect x="8" y="18" width="3.4" height="8" />
					<rect x="12.8" y="14" width="3.4" height="12" />
					<rect x="17.6" y="10" width="3.4" height="16" />
					<rect x="22.4" y="6" width="3.4" height="20" />
				</>
			)
		}
	</svg>
</span>
