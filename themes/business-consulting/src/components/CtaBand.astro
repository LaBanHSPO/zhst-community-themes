---
/** Closing "talk to us" band shared by most pages. */
import Arrow from "./Arrow.astro";
import { telHref, type OfficeData } from "../lib/consulting";

interface Props {
	office: OfficeData;
	title?: string;
	text?: string;
}
const {
	office,
	title = "Ready for your next chapter?",
	text = "Tell us what you are working on. A first conversation is informal, confidential and free of charge.",
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
	<div class="container cta-inner">
		<div>
			<span class="eyebrow eyebrow-light">Talk to us</span>
			<h2 id="cta-title">{title}</h2>
			<p>{text}</p>
		</div>
		<div class="cta-actions">
			<a class="btn btn-light btn-lg" href="/contact">Talk to us <Arrow /></a>
			<p class="cta-direct">
				{office.phone && <a href={telHref(office.phone)}>{office.phone}</a>}
				{office.email && <a href={`mailto:${office.email}`}>{office.email}</a>}
			</p>
		</div>
	</div>
</section>
