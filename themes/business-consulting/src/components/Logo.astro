---
/** Wordmark: two-tone peak mark, the site title in serif and the tagline in tracked caps. */
interface Props {
	title: string;
	tagline?: string;
	logo?: { url?: string; alt?: string } | null;
	class?: string;
}
const { title, tagline, logo, class: className } = Astro.props;
---

<a class:list={["wordmark", className]} href="/" aria-label={`${title}, home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt || title} />
		) : (
			<>
				<svg class="wordmark-mark" viewBox="0 0 48 34" width="47" height="34" aria-hidden="true" focusable="false">
					<path class="mark-a" d="M0 29 14.5 0h3L26 20l-3 5-8.5-9.5L7.5 29z" />
					<path class="mark-b" d="M19 30.5 33.8 0h2.7L48 30l-.5 4-4-.5-9.2-19-8.8 19-4-1z" />
				</svg>
				<span class="wordmark-text">
					<span class="wordmark-title">{title}</span>
					{tagline && <span class="wordmark-tagline">{tagline}</span>}
				</span>
			</>
		)
	}
</a>
