---
import Arrow from "./Arrow.astro";
import ServiceIcon from "./ServiceIcon.astro";
import type { Service } from "../lib/consulting";

interface Props {
	service: { id: string; data: Service; edit: Record<string, Record<string, unknown>> };
	headingLevel?: "h2" | "h3";
}
const { service, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const href = `/services/${service.data.slug ?? service.data.id}`;
---

<article class="service-card">
	<ServiceIcon icon={service.data.icon} tone={service.data.tone} />
	<Heading class="service-card-title" {...service.edit.title}>
		<a href={href}>{service.data.title}</a>
	</Heading>
	<p {...service.edit.summary}>{service.data.summary}</p>
	<span class="link-arrow" aria-hidden="true">Explore <Arrow /></span>
</article>
