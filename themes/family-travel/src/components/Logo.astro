---
import type { MediaReference } from "../utils/site-identity";

interface Props {
	title: string;
	tagline?: string;
	logo?: MediaReference | null;
	class?: string;
	light?: boolean;
}
const { title, tagline, logo, class: className, light = false } = Astro.props;
// "FamilyWay" is drawn in two tones: the part before the last capital letter, then the rest.
const split = title.match(/^(.+[a-z])([A-Z][a-z]*)$/);
const first = split ? split[1] : title;
const second = split ? split[2] : "";
---

<a class:list={["wordmark", { "is-light": light }, className]} href="/" aria-label={`${title}, home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt ?? title} width="200" height="46" />
		) : (
			<>
				<svg class="wordmark-mark" viewBox="0 0 76 62" width="76" height="62" aria-hidden="true" focusable="false">
					<g stroke="#f3b23a" stroke-width="3" stroke-linecap="round">
						<path d="M38 4v6" />
						<path d="M17 12l4 4.5" />
						<path d="M59 12l-4 4.5" />
						<path d="M6 28l5.5 1.5" />
						<path d="M70 28l-5.5 1.5" />
					</g>
					<path d="M20 38a18 18 0 0 1 36 0z" fill="#f3b23a" />
					<path d="M2 44c10-9 22-9 31 0 7 6 16 6 24-2 5-5 11-6 17-3-5 16-23 24-42 20-14-3-24-9-30-15z" fill="#2b9aa6" />
					<path d="M10 53c9 4 21 4 32 0 10-4 20-9 24-14-3 12-18 21-36 21-9 0-16-3-20-7z" fill="#1d6f8a" opacity="0.9" />
				</svg>
				<span class="wordmark-text">
					<span class="wordmark-title">{first}{second && <span class="wordmark-way">{second}</span>}</span>
					{tagline && <span class="wordmark-tagline">{tagline}</span>}
				</span>
			</>
		)
	}
</a>
