---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<img class="notfound-photo" src="/images/sunset-boat.webp" alt="" width="688" height="280" />
		<div class="wrap notfound-inner">
			<p class="eyebrow">Error 404</p>
			<h1 id="nf-title" class="display">This beach is not on the map.</h1>
			<p class="lede">The page you are looking for has moved or never existed. Try one of these instead.</p>
			<div class="actions">
				<a class="btn btn-coral" href="/">Back to home <Arrow /></a>
				<a class="btn btn-outline" href="/escapes">Escapes</a>
				<a class="btn btn-outline" href="/contact">Plan Your Trip</a>
			</div>
		</div>
	</section>
</Base>
