---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import EscapeCard from "../components/EscapeCard.astro";
import PostCard from "../components/PostCard.astro";
import PlanBand from "../components/PlanBand.astro";
import { getComforts, getCompany, getEscapes, getPosts, getStyles, getSteps, lines, photoSrc } from "../lib/family";

const [stylesResult, escapesResult, comfortsResult, stepsResult, postsResult, companyResult] = await Promise.all([
	getStyles(),
	getEscapes(),
	getComforts(),
	getSteps(),
	getPosts(),
	getCompany(),
]);
for (const r of [stylesResult, escapesResult, comfortsResult, stepsResult, postsResult, companyResult]) {
	if (Astro.cache?.enabled) Astro.cache.set(r.cacheHint);
}
const featured = escapesResult.entries.filter((e) => e.data.featured).slice(0, 3);
const posts = postsResult.entries.filter((p) => p.data.featured).slice(0, 3);
---

<Base
	title="FamilyWay Travel Together"
	description="Family-friendly getaways of six to ten nights, planned around naps, short transfers and rooms that sleep everyone. Beach, culture and nature escapes."
>
	<section class="hero">
		<img
			class="hero-photo"
			src="/images/hero-home.webp"
			alt="A mother, father and two young children running and splashing through shallow turquoise sea, with a rocky headland and palms behind"
			width="1448"
			height="601"
			fetchpriority="high"
		/>
		<div class="hero-wash" aria-hidden="true"></div>
		<div class="hero-copy">
			<h1>More<br />moments<br />together.</h1>
			<p class="hero-sub">Family-friendly getaways to amazing<br />places, for brighter tomorrows.</p>
			<a class="btn btn-coral btn-lg" href="/escapes">Discover escapes <Arrow /></a>
			<p class="hero-caps"><span>Beaches</span><i aria-hidden="true">&bull;</i><span>Adventures</span><i aria-hidden="true">&bull;</i><span>A brighter you</span></p>
		</div>
		<p class="hero-note" aria-hidden="true">Good<br />Times<br />Further<br />Together<svg class="note-stroke" viewBox="0 0 150 20" width="150" height="20" focusable="false"><path d="M2 17C40 8 85 4 128 2" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /><path d="M96 14C112 10 128 8 146 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></p>
	</section>

	<section class="explore" aria-labelledby="explore-title">
		<div class="explore-head">
			<div>
				<p class="eyebrow">Explore</p>
				<h2 id="explore-title" class="display">Popular family escapes</h2>
			</div>
			<a class="link-arrow" href="/destinations">View all destinations <Arrow /></a>
		</div>
		<ul class="style-cards">
			{
				stylesResult.entries.map((s) => {
					const src = photoSrc(s.data.image, s.data.photo);
					return (
						<li>
							<a class="style-card" href={`/escapes?style=${s.data.key}`}>
								{src && <img src={src} alt="" width="430" height="224" loading="lazy" />}
								<span class="style-shade" aria-hidden="true"></span>
								<span class="style-body">
									<span class="style-title" {...s.edit.title}>{s.data.title}</span>
									<span class="style-tags">
										{lines(s.data.tags).map((t, i) => <>{i > 0 && <i aria-hidden="true">&bull;</i>}<span>{t}</span></>)}
									</span>
								</span>
								<span class="style-go" aria-hidden="true">
									<svg width="18" height="14" viewBox="0 0 18 14" focusable="false"><path d="M1 7h14.5M10.5 1.5L16 7l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
								</span>
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>

	{
		featured.length > 0 && (
			<section class="band" aria-labelledby="featured-title">
				<div class="wrap">
					<div class="band-head">
						<div>
							<p class="eyebrow">Start here</p>
							<h2 id="featured-title" class="display">Three escapes to start with</h2>
						</div>
						<a class="link-arrow" href="/escapes">All escapes <Arrow /></a>
					</div>
					<ul class="card-grid card-grid-3">
						{featured.map((e) => <li><EscapeCard entry={e} /></li>)}
					</ul>
					<p class="band-note">Prices are samples for a family of four, before flights. Each escape page lists exactly what is in the price.</p>
				</div>
			</section>
		)
	}

	{
		comfortsResult.entries.length > 0 && (
			<section class="band band-sand comforts" aria-labelledby="comforts-title">
				<div class="wrap comforts-grid">
					<figure class="comforts-photo">
						<img src="/images/beach-hats.webp" alt="A family of four in straw hats sitting together on a sandy beach at sunset, seen from behind" width="980" height="620" loading="lazy" />
					</figure>
					<div class="comforts-copy">
						<p class="eyebrow">What family-friendly means here</p>
						<h2 id="comforts-title" class="display">Planned around the children, not the sights</h2>
						<ol class="comfort-list">
							{
								comfortsResult.entries.map((c, i) => (
									<li>
										<span class="comfort-n" aria-hidden="true">{i + 1}</span>
										<span class="comfort-body">
											<strong {...c.edit.title}>{c.data.title}</strong>
											<span>{c.data.text}</span>
										</span>
									</li>
								))
							}
						</ol>
					</div>
				</div>
			</section>
		)
	}

	{
		stepsResult.entries.length > 0 && (
			<section class="band how" aria-labelledby="how-title">
				<div class="wrap">
					<p class="eyebrow">How planning works</p>
					<h2 id="how-title" class="display">From first email to packing list</h2>
					<ol class="step-list">
						{
							stepsResult.entries.map((s, i) => (
								<li>
									<span class="step-n" aria-hidden="true">{i + 1}</span>
									<strong {...s.edit.title}>{s.data.title}</strong>
									<span>{s.data.text}</span>
								</li>
							))
						}
					</ol>
				</div>
			</section>
		)
	}

	{
		posts.length > 0 && (
			<section class="band band-sand" aria-labelledby="posts-title">
				<div class="wrap">
					<div class="band-head">
						<div>
							<p class="eyebrow">Inspiration</p>
							<h2 id="posts-title" class="display">Practical notes from the planning desk</h2>
						</div>
						<a class="link-arrow" href="/inspiration">All notes <Arrow /></a>
					</div>
					<ul class="card-grid card-grid-3">
						{posts.map((p) => <li><PostCard entry={p} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	<PlanBand company={companyResult.company} />
</Base>
