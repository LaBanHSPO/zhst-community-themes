---
interface Props {
	name: string;
}
const { name } = Astro.props;
const common = { width: 40, height: 40, viewBox: "0 0 48 48", fill: "none", stroke: "currentColor", "stroke-width": 1.4, "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true", focusable: "false" } as const;
---

{
	name === "lotus" ? (
		<svg {...common}>
			<path d="M24 37c-5-4-7.500-9-7.500-14.500C16.500 17 19.500 13 24 9.500 28.500 13 31.500 17 31.500 22.500 31.500 28 29 33 24 37z" />
			<path d="M24 37C17 37 10 32.500 8 24.500c4-.5 8 .800 11 3.500M24 37c7 0 14-4.500 16-12.500-4-.5-8 .800-11 3.500" />
		</svg>
	) : name === "group" ? (
		<svg {...common}>
			<circle cx="24" cy="17" r="5" />
			<circle cx="12.500" cy="21" r="3.800" />
			<circle cx="35.500" cy="21" r="3.800" />
			<path d="M14 36c0-5.500 4.500-9 10-9s10 3.500 10 9" />
			<path d="M5 35c0-4 2.800-6.500 6.500-6.500M43 35c0-4-2.800-6.500-6.500-6.500" />
		</svg>
	) : (
		<svg {...common}>
			<path d="M10.500 33.500 33.500 14.500c2.700-2.200 6.500-1.800 8.300.8 1.800 2.600.800 5.800-1.700 7.700L16.500 40.500c-3.200 2.300-7.200 1.500-8.800-1.300-1.400-2.400-.6-4.700 2.800-5.700z" />
			<ellipse cx="14" cy="36.500" rx="3.300" ry="2.500" transform="rotate(-30 14 36.500)" />
		</svg>
	)
}
