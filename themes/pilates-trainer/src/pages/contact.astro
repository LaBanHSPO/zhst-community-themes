---
import Base from "../layouts/Base.astro";
import { DAYS, TYPES, getClasses, getSessions, getStudio, hoursRows, levelLabel, mapHref, telHref } from "../lib/pilates";

const [{ studio, cacheHint }, classesResult, sessionsResult] = await Promise.all([getStudio(), getClasses(), getSessions()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(classesResult.cacheHint);
	Astro.cache.set(sessionsResult.cacheHint);
}
const hours = hoursRows(studio.hours);
const classes = classesResult.entries;

// ?class=<slug> pre-selects a class; ?day=<mon..sun> and ?time=<HH:MM> pre-fill the preferred slot.
const q = Astro.url.searchParams;
const selected = classes.find((c) => (c.data.slug ?? c.data.id) === q.get("class"));
const wantedDay = DAYS.find((d) => d.slug === q.get("day"))?.slug ?? "";
const wantedTime = q.get("time") ?? "";

const timeSlots = new Map<string, string>();
for (const s of sessionsResult.entries) timeSlots.set(String(s.data.start), s.data.time_label);
const times = [...timeSlots.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Saigon" }).format(new Date());
---

<Base title="Contact and booking" description="Request a place in a Pilates class or a private session. We reply by email or phone within one working day.">
	<div class="book">
		<div class="book-photo">
			<img src="/images/olive-vase.webp" alt="A stone vase holding olive branches against a pale studio wall" width="420" height="480" />
		</div>
		<section class="book-panel" aria-labelledby="book-title">
			<p class="eyebrow">Contact</p>
			<h1 id="book-title" class="display">Request a place.</h1>
			<p class="lede">
				Choose a class and the day and time that suit you. We reply by email or phone within one working day. A request is not a booking until we confirm it.
			</p>

			<form
				class="book-form"
				data-book-form
				data-email={studio.email}
				action={studio.email ? `mailto:${studio.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field full">
						<label for="b-class">Class</label>
						<select id="b-class" name="class" required>
							<option value="" selected={!selected}>Choose a class</option>
							{
								TYPES.map((t) => {
									const items = classes.filter((c) => c.data.type === t.slug);
									return (
										items.length > 0 && (
											<optgroup label={t.label}>
												{items.map((c) => (
													<option value={c.data.title} selected={selected?.data.id === c.data.id}>
														{[c.data.title, c.data.length, levelLabel(c.data.level)].filter(Boolean).join(" / ")}
													</option>
												))}
											</optgroup>
										)
									);
								})
							}
							<option value="Not sure yet">Not sure yet, please advise</option>
						</select>
						<span class="field-error" id="b-class-err" data-error-for="b-class"></span>
					</div>
					<div class="field">
						<label for="b-day">Preferred day</label>
						<select id="b-day" name="day" required>
							<option value="" selected={!wantedDay}>Choose a day</option>
							{DAYS.map((d) => <option value={d.label} selected={d.slug === wantedDay}>{d.label}</option>)}
							<option value="Any day">Any day</option>
						</select>
						<span class="field-error" id="b-day-err" data-error-for="b-day"></span>
					</div>
					<div class="field">
						<label for="b-time">Preferred time</label>
						<select id="b-time" name="time" required>
							<option value="" selected={!wantedTime}>Choose a time</option>
							{times.map(([start, label]) => <option value={label} selected={start === wantedTime}>{label}</option>)}
							<option value="Any time">Any time</option>
						</select>
						<span class="field-error" id="b-time-err" data-error-for="b-time"></span>
					</div>
					<div class="field full">
						<label for="b-level">Your Pilates experience</label>
						<select id="b-level" name="experience" required>
							<option value="" selected>Choose one</option>
							<option value="New to Pilates">New to Pilates</option>
							<option value="Some experience">Some experience</option>
							<option value="Regular practice">Regular practice</option>
						</select>
						<span class="field-error" id="b-level-err" data-error-for="b-level"></span>
					</div>
					<div class="field full">
						<label for="b-date">Starting from <span class="optional">(optional)</span></label>
						<input id="b-date" name="date" type="date" min={today} />
					</div>
					<div class="field">
						<label for="b-name">Name</label>
						<input id="b-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" id="b-name-err" data-error-for="b-name"></span>
					</div>
					<div class="field">
						<label for="b-email">Email</label>
						<input id="b-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" id="b-email-err" data-error-for="b-email"></span>
					</div>
					<div class="field full">
						<label for="b-phone">Phone <span class="optional">(optional)</span></label>
						<input id="b-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field full">
						<label for="b-notes">Injuries, pregnancy or health conditions <span class="optional">(optional)</span></label>
						<textarea id="b-notes" name="notes" rows="4" placeholder="Anything Mara should know before class, or any other question."></textarea>
						<span class="field-hint">Please also check with your doctor or physiotherapist if you are unsure whether Pilates is right for you right now.</span>
					</div>
				</div>
				<button class="btn btn-lg btn-block" type="submit">Send request</button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{studio.email && <>Write to <a href={`mailto:${studio.email}`}>{studio.email}</a> with your class, day and time.</>}
					</noscript>
				</p>
			</form>

			<div class="book-contact">
				<h2>Prefer to talk?</h2>
				<p>
					{studio.phone && <>Call <a href={telHref(studio.phone)}>{studio.phone}</a></>}
					{studio.phone && studio.email && " or email "}
					{!studio.phone && studio.email && "Email "}
					{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}.
				</p>
				{
					(studio.street || studio.locality) && (
						<p>
							<a href={mapHref(studio)} target="_blank" rel="noopener noreferrer">{[studio.street, studio.locality].filter(Boolean).join(", ")}</a>
						</p>
					)
				}
				{
					hours.length > 0 && (
						<dl class="book-hours">
							{hours.map((h) => (
								<>
									<dt>{h.day}</dt>
									<dd>{h.time}</dd>
								</>
							))}
						</dl>
					)
				}
				{studio.booking_note && <p class="small">{studio.booking_note}</p>}
			</div>
		</section>
	</div>
</Base>

<script>
	// Compose a booking-request email; the studio confirms it by reply. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-book-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input[required], select[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online requests are not available right now. Please call the studio.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Class request: ${get("class")}, ${get("day")} at ${get("time")}`;
			const lines = [
				"Hello,",
				"",
				"I would like to request a place:",
				`Class: ${get("class")}`,
				`Preferred day: ${get("day")}`,
				`Preferred time: ${get("time")}`,
				`Pilates experience: ${get("experience")}`,
				get("date") ? `Starting from: ${get("date")}` : "",
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("notes") ? `Injuries, pregnancy, health or other notes: ${get("notes")}` : "",
				"",
				"I understand my place is confirmed only once you reply.",
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this request ready to send. It is only sent when you send that email, and we confirm by reply. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
