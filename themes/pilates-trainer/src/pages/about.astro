---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import PageHead from "../components/PageHead.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "about");
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: "/about" });
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? page.data.intro}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug: "about" }}
>
	<PageHead eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro} edit={{ ...page.edit.title }} />
	<div class="page-body about-body">
		<div class="wrap about-grid">
			<figure class="about-photo">
				<img src="/images/arabesque-portrait.webp" alt="The instructor on all fours on a mat, one leg and the opposite arm extended, in a bright studio" width="658" height="570" />
				<figcaption>Illustrative portrait of a fictional instructor.</figcaption>
			</figure>
			<div class="prose">
				<PortableText value={page.data.content} />
				<p class="page-cta"><a class="btn" href="/classes">Find your class <Arrow /></a></p>
			</div>
		</div>
	</div>
</Base>
