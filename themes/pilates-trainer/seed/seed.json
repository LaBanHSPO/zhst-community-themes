 "content": {
  "pages": [
   {
    "id": "about",
    "slug": "about",
    "status": "published",
    "data": {
     "title": "Hello, I'm Mara.",
     "eyebrow": "About",
     "intro": "I teach small Pilates classes and private sessions in a bright studio in Marlow Bay.",
     "content": [
      {
       "_type": "block",
       "_key": "k81",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "I teach mat classes and reformer classes in groups of up to eight, plus private sessions one to one. I keep groups small so I can see how everyone is moving and change an exercise when it is not working for you.",
         "_key": "k82"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k83",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "How I teach",
         "_key": "k84"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k85",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Every class starts with a short check-in. I explain each exercise before we do it, and I give a lighter and a harder version so that people at different levels can share a room.",
         "_key": "k86"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k87",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "I name what we are doing, not just the count.",
         "_key": "k88"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k89",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "You can stop, rest or change an exercise at any time.",
         "_key": "k90"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k91",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Mats, balls, bands and reformers are all provided.",
         "_key": "k92"
        }
       ],
       "markDefs": [],
       "listItem": "bullet",
       "level": 1
      },
      {
       "_type": "block",
       "_key": "k93",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Injuries, pregnancy and health conditions",
         "_key": "k94"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k95",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Please tell me before class if you are pregnant, recovering from an injury or managing a health condition, and check with your doctor or physiotherapist first if you are unsure. I will adjust what I can, and I will tell you honestly when a class is not the right fit yet.",
         "_key": "k96"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k97",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Training and qualifications",
         "_key": "k98"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k99",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "PLACEHOLDER: replace this paragraph with your own training and certifications, for example your Pilates teacher training provider and any first aid certificate. Only list qualifications you hold and can show on request.",
         "_key": "k100"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k101",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "About this sample",
         "_key": "k102"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k103",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Mara is a fictional, AI-generated persona used for this theme's sample content. Replace the name, portrait and text with your own when you use the theme.",
         "_key": "k104"
        }
       ],
       "markDefs": []
      }
     ]
    }
   },
   {
    "id": "studio-guide",
    "slug": "studio-guide",
    "status": "published",
    "data": {
     "title": "Studio guide",
     "eyebrow": "Studio guide",
     "intro": "The practical details: when to arrive, what to wear and how booking and cancelling work.",
     "content": [
      {
       "_type": "block",
       "_key": "k105",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Arriving",
         "_key": "k106"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k107",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Please arrive ten minutes before your first class so we can say hello, show you the changing area and set up your mat or reformer. The door is closed once class starts, so latecomers cannot join after the first five minutes.",
         "_key": "k108"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k109",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "What to wear",
         "_key": "k110"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k111",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Clothes that fit close to the body work best, because they let me see your alignment. Socks with grips are required on the reformer. Bare feet are fine on the mat.",
         "_key": "k112"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k113",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Booking and cancelling",
         "_key": "k114"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k115",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Send a request from the contact page and we reply within one working day. A request is not a booking until we confirm it. Please cancel at least 12 hours before class by email or phone so someone else can take your place.",
         "_key": "k116"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k117",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Injuries and pregnancy",
         "_key": "k118"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k119",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Tell your instructor before class, and check with your doctor or physiotherapist if you are unsure whether Pilates is right for you right now. We cannot give medical advice.",
         "_key": "k120"
        }
       ],
       "markDefs": []
      }
     ]
    }
   }
  ],
  "classes": [
   {
    "id": "mat-basics",
    "slug": "mat-basics",
    "status": "published",
    "data": {
     "title": "Mat Basics",
     "summary": "A slow, clear introduction to the core Pilates exercises on the mat.",
     "type": "mat",
     "level": "beginner",
     "length": "50 min",
     "group": "Up to 8 people",
     "featured": true,
     "position": 10,
     "intro": "New to Pilates, or coming back after a break? We go through each exercise step by step and keep the pace easy.",
     "content": [
      {
       "_type": "block",
       "_key": "k1",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "What to expect",
         "_key": "k2"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k3",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "We start with a few minutes of breathing and gentle spine movement. Then we work through about ten basic exercises, with a short explanation of each one before we do it.",
         "_key": "k4"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k5",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Mara walks around the room and offers a smaller or easier version when you need it. Class ends with a slow stretch and a minute lying down.",
         "_key": "k6"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k7",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Who it suits",
         "_key": "k8"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k9",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Anyone who has never done Pilates, or who wants to learn the basics properly before moving to faster classes. No fitness level is needed.",
         "_key": "k10"
        }
       ],
       "markDefs": []
      }
     ],
     "bring": "Comfortable clothes you can move in\nGrip socks, or bare feet\nA water bottle",
     "photo": "/images/arabesque-portrait.webp"
    }
   },
   {
    "id": "mat-flow",
    "slug": "mat-flow",
    "status": "published",
    "data": {
     "title": "Mat Flow",
     "summary": "Mat exercises linked into a steady sequence, with options for every level.",
     "type": "mat",
     "level": "all-levels",
     "length": "50 min",
     "group": "Up to 8 people",
     "featured": true,
     "position": 20,
     "intro": "A flowing class that moves from one exercise to the next without long pauses.",
     "content": [
      {
       "_type": "block",
       "_key": "k11",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "What to expect",
         "_key": "k12"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k13",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "After a short warm-up we link exercises into a sequence and repeat it a few times, so you can feel it get easier. Each exercise has a lighter and a harder option.",
         "_key": "k14"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k15",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "The last ten minutes are slower: hips, shoulders and back, then a brief rest.",
         "_key": "k16"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k17",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Who it suits",
         "_key": "k18"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k19",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "People who have done a few classes and know the basic exercises. If you are new, tell Mara at the door and she will check in with you during class.",
         "_key": "k20"
        }
       ],
       "markDefs": []
      }
     ],
     "bring": "Comfortable clothes you can move in\nGrip socks, or bare feet\nA small towel if you like",
     "photo": "/images/mat-floor.webp"
    }
   },
   {
    "id": "mat-core",
    "slug": "mat-core",
    "status": "published",
    "data": {
     "title": "Mat Core",
     "summary": "A focused 45 minutes of abdominal, hip and back work on the mat.",
     "type": "mat",
     "level": "intermediate",
     "length": "45 min",
     "group": "Up to 8 people",
     "featured": false,
     "position": 30,
     "intro": "A shorter, steadier class for people who already know the classic mat exercises.",
     "content": [
      {
       "_type": "block",
       "_key": "k21",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "What to expect",
         "_key": "k22"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k23",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "We hold positions longer and add small props such as the ball and a light resistance band. Expect slow repetitions and a lot of attention to form.",
         "_key": "k24"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k25",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "There is no jumping and no floor rolling. Rest is built in between sets.",
         "_key": "k26"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k27",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Who it suits",
         "_key": "k28"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k29",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Regular mat students. If you have not taken Mat Basics or Mat Flow first, please book one of those for your first visit.",
         "_key": "k30"
        }
       ],
       "markDefs": []
      }
     ],
     "bring": "Comfortable clothes you can move in\nGrip socks, or bare feet\nA water bottle",
     "photo": "/images/ball-blocks.webp"
    }
   },
   {
    "id": "reformer-foundations",
    "slug": "reformer-foundations",
    "status": "published",
    "data": {
     "title": "Reformer Foundations",
     "summary": "Your first classes on the reformer: setup, springs and the basic exercises.",
     "type": "reformer",
     "level": "beginner",
     "length": "55 min",
     "group": "Up to 6 people",
     "featured": true,
     "position": 40,
     "intro": "We spend the first class learning how the reformer works before we make it harder.",
     "content": [
      {
       "_type": "block",
       "_key": "k31",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "What to expect",
         "_key": "k32"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k33",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Mara shows you how to set the springs, footbar and straps for your body. We then work through footwork, leg circles, arm work and a simple abdominal series.",
         "_key": "k34"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k35",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Groups are small so you get help adjusting the machine. Plan to arrive ten minutes early the first time.",
         "_key": "k36"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k37",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Who it suits",
         "_key": "k38"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "k39",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Anyone new to the reformer, including people who have done mat Pilates for years. We ask everyone to take Foundations at least once.",
         "_key": "k40"
        }
       ],
       "markDefs": []
      }
     ],
     "bring": "Grip socks (required on the reformer)\nComfortable fitted clothes\nA water bottle",
     "photo": "/images/reformer-corner.webp"
