   {
    "id": "reformer-strength",
    "slug": "reformer-strength",
    "status": "published",
    "data": {
     "title": "Reformer Strength",
     "summary": "Heavier springs, longer sequences and more standing and kneeling work.",
     "type": "reformer",
     "level": "intermediate",
     "length": "55 min",
     "group": "Up to 6 people",
     "featured": false,
     "position": 50,
     "intro": "A steady, working class for people who are comfortable on the reformer.",
