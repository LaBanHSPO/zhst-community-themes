---
import "@fontsource-variable/plus-jakarta-sans";
import "../styles/theme.css";
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getBusinessDetails } from "../utils/business";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Where the "Request a quote" buttons point. Defaults to the contact page form. */
	quoteHref?: string;
}

const { title, pageTitle, description, image, canonical, content, quoteHref = "/contact#inquiry" } =
	Astro.props;
const [settingsResult, menuResult, business] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getBusinessDetails(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	if (business.cacheHint) Astro.cache.set(business.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const { details } = business;
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const fallbackMenu = [
	{ label: "Services", url: "/services" },
	{ label: "Service areas", url: "/areas" },
	{ label: "About", url: "/about" },
	{ label: "Contact", url: "/contact" },
];
const menuItems: Array<{ label: string; url: string; target?: string | null }> =
	menuResult.data?.items?.length ? menuResult.data.items : fallbackMenu;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (url: string) => {
	const path = url.replace(/[#?].*$/, "").replace(/\/$/, "") || "/";
	return path === "/" ? currentPath === "/" : currentPath === path || currentPath.startsWith(`${path}/`);
};

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#13213c" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="lc-skip" href="#main">Skip to content</a>

		<header class="lc-header">
			<div class="lc-wrap lc-header__inner">
				<a class="lc-brand" href="/" aria-label={`${siteTitle} home`}>
					{
						siteLogo ? (
							<img class="lc-brand__img" src={siteLogo.url} alt="" />
						) : (
							<svg class="lc-brand__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
								<path d="M6 22 L24 6 L42 22 V42 H6 z" fill="#f8c630" />
								<path d="M15 42 V27 a9 9 0 0 1 18 0 V42" fill="#fffdfa" />
								<path d="M19 42 V28 a5 5 0 0 1 10 0 V42" fill="#f8c630" />
							</svg>
						)
					}
					<span class="lc-brand__text">
						<span class="lc-brand__name">{siteTitle}</span>
						{siteTagline && <span class="lc-brand__tag">{siteTagline}</span>}
					</span>
				</a>

				<button
					class="lc-menu-toggle"
					type="button"
					aria-expanded="false"
					aria-controls="lc-nav"
					data-menu-toggle
				>
					<span class="lc-visually-hidden">Menu</span>
					<svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
					</svg>
				</button>

				<nav class="lc-nav" id="lc-nav" aria-label="Primary">
					<ul>
						{
							menuItems.map((item) => (
								<li>
									<a
										href={item.url}
										target={item.target || undefined}
										rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
										aria-current={isCurrent(item.url) ? "page" : undefined}
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
					<div class="lc-nav__actions">
						{
							details.phoneHref && (
								<a class="lc-call" href={details.phoneHref}>
									<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
										<path
											d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
											fill="currentColor"
										/>
									</svg>
									<span>
										<span class="lc-visually-hidden">Call </span>
										{details.phone}
									</span>
								</a>
							)
						}
						<a class="lc-btn lc-btn--primary" href={quoteHref}>Request a quote</a>
					</div>
				</nav>
			</div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="lc-footer">
			{
				(details.footerLeft || details.footerRight) && (
					<div class="lc-wrap lc-footer__band">
						{details.footerLeft && <p>{details.footerLeft}</p>}
						<span class="lc-footer__rule" aria-hidden="true" />
						{details.footerRight && <p>{details.footerRight}</p>}
					</div>
				)
			}
			<div class="lc-footer__main">
				<div class="lc-wrap lc-footer__grid">
					<div>
						<p class="lc-footer__name">{siteTitle}</p>
						{siteTagline && <p>{siteTagline}</p>}
						{details.base && <p>{details.base}</p>}
					</div>
					<div>
						<h2 class="lc-footer__heading">Contact</h2>
						<ul>
							{details.phoneHref && (
								<li>
									<a href={details.phoneHref}>{details.phone}</a>
								</li>
							)}
							{details.emailHref && (
								<li>
									<a href={details.emailHref}>{details.email}</a>
								</li>
							)}
							{details.hours && <li>{details.hours}</li>}
						</ul>
					</div>
					<nav aria-label="Footer">
						<h2 class="lc-footer__heading">Explore</h2>
						<ul>
							{menuItems.map((item) => (
								<li>
									<a href={item.url}>{item.label}</a>
								</li>
							))}
						</ul>
					</nav>
				</div>
				<div class="lc-wrap lc-footer__legal">
					<p>
						© {year} {siteTitle}. Quote and callback requests are enquiries, not confirmed bookings.
					</p>
				</div>
			</div>
		</footer>

		<div class="lc-mobilebar" aria-label="Quick contact" role="region">
			{
				details.phoneHref && (
					<a class="lc-btn lc-btn--navy" href={details.phoneHref}>
						<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
								fill="currentColor"
							/>
						</svg>
						Call now
					</a>
				)
			}
			<a class="lc-btn lc-btn--primary" href={quoteHref}>Request a quote</a>
		</div>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
			const nav = document.getElementById("lc-nav");
			if (toggle && nav) {
				const setOpen = (open: boolean) => {
					toggle.setAttribute("aria-expanded", String(open));
					nav.classList.toggle("is-open", open);
				};
				toggle.addEventListener("click", () => {
					setOpen(toggle.getAttribute("aria-expanded") !== "true");
				});
				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape" && nav.classList.contains("is-open")) {
						setOpen(false);
						toggle.focus();
					}
				});
			}
		</script>
	</body>
</html>

<style>
	.lc-header {
		background: var(--lc-surface);
		border-bottom: 1px solid var(--lc-line);
		position: relative;
		z-index: 20;
	}

	.lc-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 84px;
	}

	.lc-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.9rem;
		text-decoration: none;
		color: var(--lc-navy);
	}

	.lc-brand__mark {
		width: 50px;
		height: 50px;
		flex: none;
	}

	.lc-brand__img {
		height: 48px;
		width: auto;
	}

	.lc-brand__text {
		display: flex;
		flex-direction: column;
	}

	.lc-brand__name {
		font-size: 1.75rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		line-height: 1;
	}

	.lc-brand__tag {
		margin-top: 0.35rem;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.3em;
		text-transform: uppercase;
	}

	.lc-nav {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.lc-nav ul {
		display: flex;
		gap: 2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.lc-nav ul a {
		font-weight: 600;
		color: var(--lc-navy);
		text-decoration: none;
		padding-block: 0.4rem;
		border-bottom: 2px solid transparent;
	}

	.lc-nav ul a:hover,
	.lc-nav ul a[aria-current="page"] {
		border-bottom-color: var(--lc-yellow);
	}

	.lc-nav__actions {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.lc-call {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: 700;
		color: var(--lc-navy);
		text-decoration: none;
		white-space: nowrap;
	}

	.lc-call:hover {
		text-decoration: underline;
	}

	.lc-menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border: 1px solid var(--lc-line);
		border-radius: var(--lc-radius-sm);
		background: var(--lc-surface);
		color: var(--lc-navy);
		cursor: pointer;
	}

	main:focus {
		outline: none;
	}

	.lc-footer {
		margin-top: clamp(2rem, 5vw, 4rem);
	}

	.lc-footer__band {
		display: flex;
		align-items: center;
		gap: 2rem;
		padding-block: 2rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--lc-navy);
	}

	.lc-footer__band p {
		margin: 0;
		max-width: 28ch;
	}

	.lc-footer__rule {
		flex: 1;
		height: 1px;
		background: var(--lc-muted);
		opacity: 0.4;
	}

	.lc-footer__main {
		background: var(--lc-navy);
		color: #dfe4ee;
		padding-top: 3rem;
	}

	.lc-footer__grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr;
		gap: 2rem;
	}

	.lc-footer__main a {
		color: #fff;
	}

	.lc-footer__main ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.4rem;
	}

	.lc-footer__name {
		font-size: 1.3rem;
		font-weight: 800;
		color: #fff;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.lc-footer__heading {
		color: var(--lc-yellow);
		font-size: 0.8rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		margin-bottom: 0.9rem;
	}

	.lc-footer__main :focus-visible {
		outline-color: var(--lc-yellow);
	}

	.lc-footer__legal {
		border-top: 1px solid rgb(255 255 255 / 12%);
		margin-top: 2.5rem;
		padding-block: 1.25rem 1.5rem;
		font-size: 0.85rem;
		color: #b8c0d0;
	}

	.lc-footer__legal p {
		margin: 0;
	}

	.lc-mobilebar {
		display: none;
	}

	@media (max-width: 1080px) {
		.lc-nav,
		.lc-nav ul {
			gap: 1.25rem;
		}

		.lc-call span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
		}
	}

	@media (max-width: 860px) {
		.lc-header__inner {
			min-height: 72px;
		}

		.lc-brand__mark {
			width: 40px;
			height: 40px;
		}

		.lc-brand__name {
			font-size: 1.35rem;
		}

		.lc-brand__tag {
			font-size: 0.58rem;
			letter-spacing: 0.22em;
		}

		.lc-menu-toggle {
			display: inline-flex;
		}

		.lc-nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 1rem;
			padding: 1rem var(--lc-gutter) 1.5rem;
			background: var(--lc-surface);
			border-bottom: 1px solid var(--lc-line);
			box-shadow: 0 12px 24px rgb(19 33 60 / 10%);
		}

		.lc-nav.is-open {
			display: flex;
		}

		.lc-nav ul {
			flex-direction: column;
			gap: 0;
		}

		.lc-nav ul a {
			display: block;
			padding: 0.85rem 0;
			border-bottom: 1px solid var(--lc-line);
		}

		.lc-nav ul a[aria-current="page"] {
			border-bottom-color: var(--lc-yellow);
		}

		.lc-nav__actions {
			flex-direction: column;
			align-items: stretch;
		}

		.lc-call span {
			position: static;
			width: auto;
			height: auto;
			overflow: visible;
			clip: auto;
		}

		.lc-call {
			justify-content: center;
			min-height: 48px;
		}

		.lc-footer__band {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}

		.lc-footer__rule {
			width: 100%;
			flex: none;
		}

		.lc-footer__grid {
			grid-template-columns: 1fr;
		}

		.lc-mobilebar {
			display: grid;
			grid-auto-flow: column;
			grid-auto-columns: 1fr;
			gap: 0.6rem;
			position: sticky;
			bottom: 0;
			z-index: 30;
			padding: 0.6rem 1rem calc(0.6rem + env(safe-area-inset-bottom));
			background: rgb(255 253 250 / 96%);
			border-top: 1px solid var(--lc-line);
			box-shadow: 0 -6px 18px rgb(19 33 60 / 8%);
		}

		.lc-mobilebar .lc-btn {
			min-height: 50px;
			padding-inline: 0.75rem;
			font-size: 1rem;
		}
	}
</style>
