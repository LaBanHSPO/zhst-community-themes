---
import { getEmDashEntry, getEntryTerms, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import InquiryPanel from "../../components/InquiryPanel.astro";
import { getBusinessDetails, toLines } from "../../utils/business";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: service, cacheHint } = await getEmDashEntry("services", slug);
if (!service) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const [{ details }, areaTerms, settings] = await Promise.all([
	getBusinessDetails(),
	getEntryTerms("services", service.data.id, "area").catch((error: unknown) => {
		console.error("[localcraft] Failed to load service areas:", error);
		return [];
	}),
	getSiteSettings(),
]);
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(service, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const included = toLines(service.data.included);
const notIncluded = toLines(service.data.not_included);
const image = service.data.featured_image;
const hasImage = Boolean(image && (image.src || image.id));
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? service.data.summary}
	canonical={seo.canonical}
	content={{ collection: "services", id: service.data.id, slug }}
	quoteHref="#inquiry"
>
	<section class="lc-pagehead lc-svc-head">
		<div class="lc-wrap lc-svc-head__grid">
			<div>
				<nav class="lc-breadcrumb" aria-label="Breadcrumb">
					<ol>
						<li><a href="/">Home</a></li>
						<li><a href="/services">Services</a></li>
						<li aria-current="page">{service.data.title}</li>
					</ol>
				</nav>
				<div class="lc-svc-head__title">
					<Icon name={service.data.icon} size={80} />
					<h1 {...service.edit.title}>{service.data.title}</h1>
				</div>
				{service.data.summary && <p class="lc-lead" {...service.edit.summary}>{service.data.summary}</p>}
				<div class="lc-svc-head__actions">
					<a class="lc-btn lc-btn--primary" href="#inquiry">Request a quote</a>
					{details.phoneHref && (
						<a class="lc-btn lc-btn--ghost" href={details.phoneHref}>
							Call {details.phone}
						</a>
					)}
				</div>
			</div>
			{
				hasImage && image && (
					<div class="lc-svc-head__media">
						<Image image={image} priority />
					</div>
				)
			}
		</div>
	</section>

	<div class="lc-wrap lc-svc-body">
		<div class="lc-svc-main">
			{
				service.data.content && service.data.content.length > 0 && (
					<div class="lc-prose">
						<PortableText value={service.data.content} />
					</div>
				)
			}

			<div class="lc-scope">
				<section class="lc-card lc-scope__col lc-scope__col--in" aria-labelledby="included-heading">
					<h2 id="included-heading">What's included</h2>
					{
						included.length > 0 ? (
							<ul>
								{included.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						) : (
							<p class="lc-scope__empty">Ask us about the details of this service.</p>
						)
					}
				</section>
				<section class="lc-card lc-scope__col lc-scope__col--out" aria-labelledby="excluded-heading">
					<h2 id="excluded-heading">Not included</h2>
					{
						notIncluded.length > 0 ? (
							<ul>
								{notIncluded.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						) : (
							<p class="lc-scope__empty">No exclusions listed. If in doubt, ask us first.</p>
						)
					}
				</section>
			</div>

			{service.data.typical_job && <p class="lc-svc-typical">{service.data.typical_job}</p>}

			<section class="lc-svc-areas" aria-labelledby="areas-heading">
				<h2 id="areas-heading">Areas covered for {service.data.title.toLowerCase()}</h2>
				{
					areaTerms.length > 0 ? (
						<ul class="lc-chips">
							{areaTerms.map((term) => (
								<li>
									<a href={`/areas#${term.slug}`}>{term.label}</a>
								</li>
							))}
						</ul>
					) : (
						<p>
							Area coverage for this service has not been listed yet. <a href="/areas">See all service areas</a>{" "}
							or ask us directly.
						</p>
					)
				}
				<p class="lc-svc-areas__note">
					Not on the list? <a href="#inquiry">Send a request anyway</a> and tell us where you are.
				</p>
			</section>
		</div>

		<aside class="lc-svc-aside" aria-label={`Request a quote for ${service.data.title}`}>
			<InquiryPanel
				details={details}
				heading="Request a quote or callback"
				intro="Describe the job and where you are. We'll get back to you to talk it through."
				serviceName={service.data.title}
			/>
		</aside>
	</div>
</Base>

<style>
	.lc-svc-head__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: 2rem 3rem;
		align-items: center;
	}

	.lc-svc-head__title {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.lc-svc-head__title h1 {
		margin: 0;
	}

	.lc-svc-head .lc-lead {
		margin-top: 1rem;
	}

	.lc-svc-head__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.lc-svc-head__media {
		/* Seed crops are small; cap the size so they are not upscaled too far. */
		width: 100%;
		max-width: 420px;
		justify-self: end;
		border-radius: var(--lc-radius);
		overflow: hidden;
		aspect-ratio: 4 / 3;
		background: var(--lc-panel);
	}

	.lc-svc-head__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.lc-svc-body {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr);
		gap: 2.5rem;
		padding-block: clamp(2rem, 5vw, 3.5rem);
		align-items: start;
	}

	.lc-scope {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
		margin-top: 1.5rem;
	}

	.lc-scope__col {
		padding: 1.4rem 1.5rem;
	}

	.lc-scope__col h2 {
		font-size: 1.3rem;
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.lc-scope__col h2::before {
		content: "";
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 3px;
		flex: none;
	}

	.lc-scope__col--in h2::before {
		background: var(--lc-yellow);
	}

	.lc-scope__col--out h2::before {
		background: transparent;
		border: 2px solid var(--lc-navy);
	}

	.lc-scope__col ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.55rem;
	}

	.lc-scope__col li {
		position: relative;
		padding-left: 1.6rem;
	}

	.lc-scope__col--in li::before {
		content: "";
		position: absolute;
		left: 0.15rem;
		top: 0.45em;
		width: 0.7rem;
		height: 0.4rem;
		border-left: 2.5px solid var(--lc-navy);
		border-bottom: 2.5px solid var(--lc-navy);
		transform: rotate(-45deg);
	}

	.lc-scope__col--out li {
		color: var(--lc-muted);
	}

	.lc-scope__col--out li::before {
		content: "–";
		position: absolute;
		left: 0.25rem;
		font-weight: 800;
		color: var(--lc-navy);
	}

	.lc-scope__empty {
		color: var(--lc-muted);
		margin: 0;
	}

	.lc-svc-typical {
		margin-top: 1.5rem;
		padding: 1rem 1.25rem;
		border-left: 4px solid var(--lc-yellow);
		background: var(--lc-surface);
		border-radius: var(--lc-radius-sm);
	}

	.lc-svc-areas {
		margin-top: 2.5rem;
	}

	.lc-svc-areas h2 {
		font-size: 1.5rem;
	}

	.lc-svc-areas__note {
		margin-top: 1rem;
		color: var(--lc-muted);
	}

	.lc-svc-aside {
		position: sticky;
		top: 1.5rem;
	}

	@media (max-width: 960px) {
		.lc-svc-head__grid,
		.lc-svc-body {
			grid-template-columns: 1fr;
		}

		.lc-svc-aside {
			position: static;
		}
	}

	@media (max-width: 640px) {
		.lc-scope {
			grid-template-columns: 1fr;
		}

		.lc-svc-head__title :global(.lc-icon) {
			width: 60px;
			height: 60px;
		}
	}
</style>
