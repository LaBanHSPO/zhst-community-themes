---
import Base from "../layouts/Base.astro";
Astro.response.status = 404;
---

<Base title="Page not found">
	<section class="lc-pagehead">
		<div class="lc-wrap">
			<p class="lc-eyebrow">Error 404</p>
			<h1>Page not found</h1>
			<p class="lc-lead">The page you're looking for doesn't exist or has moved.</p>
			<p class="lc-404-actions">
				<a class="lc-btn lc-btn--primary" href="/">Go to the home page</a>
				<a class="lc-btn lc-btn--ghost" href="/services">Browse services</a>
			</p>
		</div>
	</section>
</Base>

<style>
	.lc-404-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
</style>
