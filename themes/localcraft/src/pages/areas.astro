---
import { getTaxonomyTerms } from "emdash";
import Base from "../layouts/Base.astro";
import { loadOrdered, loadServicesInArea } from "../utils/content";

const areas = await loadOrdered("areas");
if (Astro.cache?.enabled && areas.cacheHint) Astro.cache.set(areas.cacheHint);

// Areas are described in the "Service areas" collection; services are linked to
// them through the `area` taxonomy, matched by slug. Terms without an area entry
// are still listed so no coverage is hidden.
const terms = await getTaxonomyTerms("area", { includeCounts: false }).catch((error: unknown) => {
	console.error("[localcraft] Failed to load area terms:", error);
	return [];
});
const described = new Set(areas.entries.map((area) => area.id));
const rows = [
	...areas.entries.map((area) => ({
		slug: area.id,
		title: area.data.title,
		summary: area.data.summary,
		notes: area.data.notes,
	})),
	...terms
		.filter((term) => !described.has(term.slug))
		.map((term) => ({ slug: term.slug, title: term.label, summary: term.description, notes: undefined })),
];
const withServices = await Promise.all(
	rows.map(async (row) => ({ ...row, services: await loadServicesInArea(row.slug) })),
);
---

<Base title="Service areas" description="The neighbourhoods we cover and the services available in each.">
	<section class="lc-pagehead">
		<div class="lc-wrap">
			<p class="lc-eyebrow">Where we work</p>
			<h1>Service areas</h1>
			<p class="lc-lead">
				We work in the neighbourhoods below. Each area lists the services we usually offer there. If your street
				is just outside, ask anyway.
			</p>
			{
				withServices.length > 0 && (
					<nav class="lc-area-jump" aria-label="Jump to area">
						<ul class="lc-chips">
							{withServices.map((area) => (
								<li>
									<a href={`#${area.slug}`}>{area.title}</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</div>
	</section>

	<section class="lc-wrap lc-section--tight" aria-label="Areas and available services">
		{
			withServices.length === 0 ? (
				<p class="lc-empty">Service areas have not been published yet. Please contact us to check coverage.</p>
			) : (
				<ul class="lc-areas">
					{withServices.map((area) => (
						<li class="lc-card lc-area" id={area.slug}>
							<div class="lc-area__intro">
								<h2>{area.title}</h2>
								{area.summary && <p>{area.summary}</p>}
								{area.notes && <p class="lc-area__notes">{area.notes}</p>}
							</div>
							<div class="lc-area__services">
								<h3>Services in {area.title}</h3>
								{area.services.length > 0 ? (
									<ul>
										{area.services.map((service) => (
											<li>
												<a href={`/services/${encodeURIComponent(service.id)}`}>{service.data.title}</a>
											</li>
										))}
									</ul>
								) : (
									<p>No services are listed for this area yet. Get in touch and we will let you know.</p>
								)}
							</div>
						</li>
					))}
				</ul>
			)
		}
		<div class="lc-panel lc-areas-cta">
			<div>
				<h2>Not sure if we cover your street?</h2>
				<p>Send a request with your neighbourhood and the job. We'll tell you honestly if we can help.</p>
			</div>
			<a class="lc-btn lc-btn--primary" href="/contact#inquiry">Ask about your area</a>
		</div>
	</section>
</Base>

<style>
	.lc-area-jump {
		margin-top: 1.75rem;
	}

	.lc-areas {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.25rem;
	}

	.lc-area {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		gap: 1.5rem 2.5rem;
		padding: clamp(1.25rem, 3vw, 2rem);
		scroll-margin-top: 1.5rem;
	}

	.lc-area:target {
		outline: 3px solid var(--lc-yellow);
		outline-offset: 2px;
	}

	.lc-area h2 {
		font-size: 1.6rem;
	}

	.lc-area__intro p:last-child {
		margin-bottom: 0;
	}

	.lc-area__notes {
		color: var(--lc-muted);
		font-size: 0.98rem;
	}

	.lc-area__services {
		background: var(--lc-bg);
		border-radius: var(--lc-radius-sm);
		padding: 1rem 1.25rem;
	}

	.lc-area__services h3 {
		font-size: 0.8rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--lc-muted);
		margin-bottom: 0.75rem;
	}

	.lc-area__services ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 0.4rem 1rem;
	}

	.lc-area__services a {
		font-weight: 700;
	}

	.lc-area__services p {
		margin: 0;
		color: var(--lc-muted);
	}

	.lc-areas-cta {
		margin-top: 2rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
	}

	.lc-areas-cta h2 {
		font-size: 1.4rem;
		margin-bottom: 0.3rem;
	}

	.lc-areas-cta p {
		margin: 0;
	}

	@media (max-width: 760px) {
		.lc-area {
			grid-template-columns: 1fr;
		}
	}
</style>
