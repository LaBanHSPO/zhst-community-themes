---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import TeamGrid from "../components/TeamGrid.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import { loadOrdered } from "../utils/content";

const [pageResult, team, gallery] = await Promise.all([
	getEmDashEntry("pages", "about").catch((error: unknown) => {
		console.error("[localcraft] Failed to load about page:", error);
		return { entry: null, cacheHint: undefined };
	}),
	loadOrdered("team"),
	loadOrdered("gallery"),
]);
const page = pageResult.entry;
if (Astro.cache?.enabled) {
	for (const hint of [pageResult.cacheHint, team.cacheHint, gallery.cacheHint]) if (hint) Astro.cache.set(hint);
}
const title = page?.data.title ?? "About us";
---

<Base
	title={title}
	description="Meet the team and see recent work from the workshop."
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	<section class="lc-pagehead">
		<div class="lc-wrap">
			<p class="lc-eyebrow">Who we are</p>
			<h1 {...(page?.edit.title ?? {})}>{title}</h1>
		</div>
	</section>

	<section class="lc-wrap lc-section--tight lc-about-intro">
		{
			page?.data.content && page.data.content.length > 0 ? (
				<div class="lc-prose">
					<PortableText value={page.data.content} />
				</div>
			) : (
				<p class="lc-lead">We are a local home-repair team. Add an "about" page in the admin to tell your story.</p>
			)
		}
	</section>

	<section class="lc-wrap lc-section--tight" id="team" aria-labelledby="team-heading">
		<div class="lc-section-head">
			<div>
				<p class="lc-eyebrow">The team</p>
				<h2 id="team-heading">The people who'll turn up</h2>
			</div>
			<p>A small team, so you will usually deal with the same few faces from first call to finished job.</p>
		</div>
		<TeamGrid
			members={team.entries.map((member) => ({
				id: member.id,
				name: member.data.title,
				role: member.data.role,
				bio: member.data.bio,
				photo: member.data.photo,
			}))}
		/>
	</section>

	<section class="lc-wrap lc-section--tight" id="work" aria-labelledby="work-heading">
		<div class="lc-section-head">
			<div>
				<p class="lc-eyebrow">Work gallery</p>
				<h2 id="work-heading">From the workshop</h2>
			</div>
			<p>A look at the tools, materials and finishes behind our jobs.</p>
		</div>
		<GalleryGrid
			items={gallery.entries.map((item) => ({
				id: item.id,
				title: item.data.title,
				caption: item.data.caption,
				image: item.data.image,
			}))}
		/>
	</section>

	<section class="lc-wrap lc-section--tight">
		<div class="lc-panel lc-about-cta">
			<h2>Have a job in mind?</h2>
			<p>Tell us what needs doing. We'll call or email to talk it through.</p>
			<a class="lc-btn lc-btn--primary" href="/contact#inquiry">Request a quote or callback</a>
		</div>
	</section>
</Base>

<style>
	.lc-about-intro .lc-prose {
		font-size: 1.1rem;
	}

	.lc-about-cta {
		text-align: center;
		padding-block: 2.5rem;
	}

	.lc-about-cta p {
		color: var(--lc-muted);
	}
</style>
