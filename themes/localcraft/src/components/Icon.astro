---
/**
 * Service illustration icons in the Localcraft style: navy outline, yellow
 * accent on a soft grey disc. Decorative only (aria-hidden).
 */
interface Props {
	name?: string | null;
	size?: number;
}

const { name, size = 96 } = Astro.props;
const known = ["hammer", "pipe", "roller", "saw", "tile", "wrench"];
const icon = name && known.includes(name) ? name : "house";
---

<svg
	class="lc-icon"
	width={size}
	height={size}
	viewBox="0 0 96 96"
	aria-hidden="true"
	focusable="false"
	fill="none"
	stroke="#13213c"
	stroke-width="4"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<circle cx="40" cy="46" r="32" fill="#ecebe6" stroke="none"></circle>
	{
		icon === "hammer" && (
			<g>
				<path d="M56 14 l18 18 -7 7 -6 -6 -4 4 -9 -9 4 -4 -3 -3 z" fill="#fff" />
				<path d="M48 34 L18 72 a4 4 0 0 0 6 6 L56 42" fill="#f8c630" />
			</g>
		)
	}
	{
		icon === "pipe" && (
			<g>
				<path d="M28 14 h14 v8 h-3 v26 a8 8 0 0 0 8 8 h12 v-4 h10 v18 h-10 v-4 H47 a20 20 0 0 1 -20 -20 V22 h-3 v-8 z" fill="#fff" />
				<path d="M54 74 c0 0 -6 7 -6 11 a6 6 0 0 0 12 0 c0 -4 -6 -11 -6 -11 z" fill="#f8c630" stroke="none" />
			</g>
		)
	}
	{
		icon === "roller" && (
			<g>
				<rect x="24" y="14" width="44" height="18" rx="5" fill="#f8c630" />
				<path d="M68 23 h6 v16 H48 v10" />
				<rect x="43" y="49" width="10" height="32" rx="4" fill="#fff" />
			</g>
		)
	}
	{
		icon === "saw" && (
			<g>
				<path d="M20 30 L72 30 L72 46 L28 62 z" fill="#fff" />
				<path d="M28 62 l4 -6 4 4 4 -6 4 4 4 -6 4 4 4 -6 4 4 4 -6 4 4" />
				<rect x="64" y="22" width="16" height="30" rx="6" fill="#f8c630" />
			</g>
		)
	}
	{
		icon === "tile" && (
			<g>
				<rect x="18" y="18" width="24" height="24" rx="3" fill="#fff" />
				<rect x="46" y="18" width="24" height="24" rx="3" fill="#f8c630" />
				<rect x="18" y="46" width="24" height="24" rx="3" fill="#f8c630" />
				<rect x="46" y="46" width="24" height="24" rx="3" fill="#fff" />
			</g>
		)
	}
	{
		icon === "wrench" && (
			<g>
				<path d="M66 16 a14 14 0 0 0 -16 18 L20 64 a6 6 0 0 0 9 9 L59 43 a14 14 0 0 0 18 -16 l-9 9 -8 -2 -2 -8 z" fill="#fff" />
				<circle cx="25" cy="68" r="3" fill="#f8c630" stroke="none" />
				<path d="M36 52 l8 8" stroke="#f8c630" />
			</g>
		)
	}
	{
		icon === "house" && (
			<path d="M20 44 L44 20 L68 44 V74 H54 V56 H34 V74 H20 z" fill="#f8c630" />
		)
	}
</svg>

<style>
	.lc-icon {
		display: block;
	}
</style>
