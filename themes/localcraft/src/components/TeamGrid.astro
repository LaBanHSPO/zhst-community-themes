---
import { Image } from "emdash/ui";
import type { ImageValue } from "emdash";

export interface TeamMember {
	id: string;
	name: string;
	role?: string | null;
	bio?: string | null;
	photo?: ImageValue | null;
}

interface Props {
	members: TeamMember[];
}

const { members } = Astro.props;
const initials = (name: string) =>
	name
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((part) => part[0]?.toUpperCase() ?? "")
		.join("");
---

{
	members.length === 0 ? (
		<p class="lc-empty">Team introductions will appear here once they are added in the admin.</p>
	) : (
		<ul class="lc-team">
			{members.map((member) => (
				<li class="lc-card lc-team__member">
					<div class="lc-team__photo">
						{member.photo?.src || member.photo?.id ? (
							<Image image={member.photo} alt={member.photo.alt || `Portrait of ${member.name}`} />
						) : (
							<span class="lc-team__initials" aria-hidden="true">
								{initials(member.name)}
							</span>
						)}
					</div>
					<div class="lc-team__body">
						<h3>{member.name}</h3>
						{member.role && <p class="lc-team__role">{member.role}</p>}
						{member.bio && <p>{member.bio}</p>}
					</div>
				</li>
			))}
		</ul>
	)
}

<style>
	.lc-team {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
		gap: 1.25rem;
	}

	.lc-team__member {
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.lc-team__photo {
		aspect-ratio: 4 / 3;
		background: var(--lc-panel);
		display: grid;
		place-items: center;
		overflow: hidden;
	}

	.lc-team__photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 25%;
	}

	.lc-team__initials {
		display: grid;
		place-items: center;
		width: 88px;
		height: 88px;
		border-radius: 50%;
		background: var(--lc-navy);
		color: var(--lc-yellow);
		font-size: 1.9rem;
		font-weight: 800;
		letter-spacing: 0.04em;
	}

	.lc-team__body {
		padding: 1.1rem 1.25rem 1.3rem;
	}

	.lc-team__body h3 {
		font-size: 1.2rem;
		margin-bottom: 0.2rem;
	}

	.lc-team__role {
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--lc-muted);
		margin-bottom: 0.6rem;
	}

	.lc-team__body p:last-child {
		margin-bottom: 0;
		font-size: 0.98rem;
	}
</style>
