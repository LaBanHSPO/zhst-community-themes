---
import { Form } from "@emdash-cms/plugin-forms/ui";
import type { BusinessDetails } from "../utils/business";

interface Props {
	details: BusinessDetails;
	heading?: string;
	intro?: string;
	/** When set, shown above the form and pre-filled into a field named `service` if the form has one. */
	serviceName?: string;
	/** Slug of the form created in Plugins → Forms. */
	formId?: string;
	id?: string;
}

const {
	details,
	heading = "Get in touch",
	intro = "Tell us about your project and we'll be in touch soon.",
	serviceName,
	formId = "inquiry",
	id = "inquiry",
} = Astro.props;
---

<section class="lc-panel lc-inquiry" id={id} aria-labelledby={`${id}-heading`} data-service={serviceName}>
	<h2 id={`${id}-heading`} class="lc-inquiry__title">{heading}</h2>
	{
		serviceName && (
			<p class="lc-inquiry__service">
				<span>Enquiring about</span>
				<strong>{serviceName}</strong>
			</p>
		)
	}
	<p class="lc-inquiry__intro">{intro}</p>

	<div class="lc-inquiry__form">
		<Form id={formId} />
	</div>
	<p class="lc-inquiry__fallback">
		The online request form is not available right now. Please call or email us using the details below.
	</p>

	<div class="lc-inquiry__direct">
		<p class="lc-inquiry__direct-label">Prefer to talk?</p>
		<ul>
			{
				details.phoneHref && (
					<li>
						<a href={details.phoneHref}>
							<span class="lc-visually-hidden">Call </span>
							{details.phone}
						</a>
					</li>
				)
			}
			{
				details.emailHref && (
					<li>
						<a href={details.emailHref}>
							<span class="lc-visually-hidden">Email </span>
							{details.email}
						</a>
					</li>
				)
			}
			{details.hours && <li>{details.hours}</li>}
		</ul>
		<p class="lc-inquiry__note">
			{
				details.responseNote ??
					"A quote or callback request is an enquiry, not a confirmed booking. We will contact you to talk it through."
			}
		</p>
	</div>
</section>

<script>
	// Pre-fill a `service` field (if the admin-created form has one) with the service shown above the form.
	for (const panel of document.querySelectorAll<HTMLElement>(".lc-inquiry[data-service]")) {
		const service = panel.dataset.service;
		const field = panel.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
			'[name="service"]',
		);
		if (!service || !field || field.value) continue;
		if (field instanceof HTMLSelectElement) {
			const match = [...field.options].find((option) => option.value === service || option.text === service);
			if (match) field.value = match.value;
		} else {
			field.value = service;
		}
	}
</script>

<style>
	.lc-inquiry {
		scroll-margin-top: 1.5rem;
	}

	.lc-inquiry__title {
		font-size: 1.75rem;
		margin-bottom: 0.35rem;
	}

	.lc-inquiry__intro {
		color: var(--lc-ink);
		margin-bottom: 1.1rem;
	}

	.lc-inquiry__service {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.6rem;
		margin: 0.25rem 0 0.75rem;
		padding: 0.6rem 0.85rem;
		background: var(--lc-surface);
		border-left: 4px solid var(--lc-yellow);
		border-radius: var(--lc-radius-sm);
	}

	.lc-inquiry__service span {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--lc-muted);
	}

	.lc-inquiry__service strong {
		color: var(--lc-navy);
	}

	.lc-inquiry__fallback {
		display: none;
		padding: 0.85rem 1rem;
		background: var(--lc-surface);
		border-radius: var(--lc-radius-sm);
		color: var(--lc-ink);
	}

	/* The forms plugin renders nothing until a form with this slug exists. */
	.lc-inquiry__form:not(:has(form)) {
		display: none;
	}

	.lc-inquiry__form:not(:has(form)) + .lc-inquiry__fallback {
		display: block;
	}

	.lc-inquiry__direct {
		margin-top: 1.25rem;
		padding-top: 1.1rem;
		border-top: 1px solid var(--lc-line);
	}

	.lc-inquiry__direct-label {
		font-weight: 700;
		color: var(--lc-navy);
		margin-bottom: 0.35rem;
	}

	.lc-inquiry__direct ul {
		list-style: none;
		padding: 0;
		margin: 0 0 0.75rem;
		display: grid;
		gap: 0.25rem;
	}

	.lc-inquiry__direct a {
		font-weight: 700;
		font-size: 1.1rem;
	}

	.lc-inquiry__note {
		font-size: 0.9rem;
		color: var(--lc-muted);
		margin: 0;
	}
</style>
