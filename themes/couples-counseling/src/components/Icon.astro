---
interface Props {
	name?: string | null;
}
const { name } = Astro.props;
---

{
	name === "heart" ? (
		<svg class="i-heart" width="36" height="34" viewBox="0 0 36 34" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false">
			<path d="M18 31C9 24.500 3 19.500 3 12.500 3 8 6.500 4.500 10.800 4.500c3 0 5.600 1.700 7.200 4.300 1.600-2.600 4.200-4.300 7.200-4.300C29.500 4.500 33 8 33 12.500 33 19.500 27 24.500 18 31Z" />
			<path d="M29.500 2.500v3M28 4h3" stroke-width="1.2" />
		</svg>
	) : name === "people" ? (
		<svg class="i-people" width="40" height="34" viewBox="0 0 40 34" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false">
			<circle cx="13" cy="8" r="4.200" />
			<circle cx="27" cy="8" r="4.200" />
			<path d="M4 30v-5.500C4 20.500 7.500 17 12 17h2c1.600 0 3 .5 4.200 1.300M36 30v-5.500c0-4-3.500-7.500-8-7.500h-2c-1.600 0-3 .5-4.200 1.300" />
			<path d="M13 30v-6M27 30v-6" />
		</svg>
	) : (
		<svg class="i-leaf" width="34" height="34" viewBox="0 0 34 34" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false">
			<path d="M28.500 5C13 5.500 6 14 7.500 25.500c10 2 20-3.500 21-20.500Z" />
			<path d="M5 30C10 22 16 16 24 10" />
		</svg>
	)
}
