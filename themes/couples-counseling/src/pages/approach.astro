---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import BookingBand from "../components/BookingBand.astro";
import Fees from "../components/Fees.astro";
import PageHead from "../components/PageHead.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getFees, getPractice, photoAltByName } from "../lib/practice";

const [{ entry: page, cacheHint }, practiceResult, feesResult, settings] = await Promise.all([
	getEmDashEntry("pages", "approach"),
	getPractice(),
	getFees(),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	if (cacheHint) Astro.cache.set(cacheHint);
	Astro.cache.set(practiceResult.cacheHint);
	Astro.cache.set(feesResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = page ? getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: "/approach" }) : null;
const hasBody = Boolean(page?.data.content && page.data.content.length > 0);
---

<Base
	title={seo?.title ?? "Our approach"}
	pageTitle={seo?.ogTitle}
	description={seo?.description ?? page?.data.intro ?? "How counseling sessions work at TogetherWell: in person or online, joint and individual sessions, and how we handle confidentiality."}
	canonical={seo?.canonical}
	content={page ? { collection: "pages", id: page.data.id, slug: "approach" } : undefined}
>
	<PageHead
		id="approach-title"
		eyebrow={page?.data.eyebrow ?? "Our approach"}
		title={page?.data.title ?? "Real conversations, at your pace."}
		intro={page?.data.intro}
		edit={page ? { ...page.edit.title } : {}}
	/>

	<section class="approach-page">
		<div class="wrap about-grid">
			<div class="prose">
				{hasBody ? <PortableText value={page!.data.content} /> : <p>Details are coming soon.</p>}
				<p class="about-links">
					<a class="btn btn-sage" href="/contact"><span>Book an intro call</span><Arrow /></a>
					<a class="text-link" href="/contact?format=online"><span>Ask about online sessions</span><Arrow /></a>
				</p>
			</div>
			<figure class="about-photo">
				<img src="/images/room-wide.webp" alt={photoAltByName("room-wide")} width="1448" height="1086" loading="lazy" />
				<figcaption>The counseling room in Millbrook.</figcaption>
			</figure>
		</div>
	</section>

	<Fees fees={feesResult.entries} note={practiceResult.practice.session_note} />

	<BookingBand practice={practiceResult.practice} />
</Base>
