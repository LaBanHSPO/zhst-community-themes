  "content": {
    "pages": [
      {
        "id": "about",
        "slug": "about",
        "status": "published",
        "data": {
          "title": "Photographs that read the building.",
          "eyebrow": "About",
          "intro": "KELLEN is an architecture photography practice for architects, developers and studios who want their buildings seen the way they were designed.",
          "photo": "/images/prints-camera.webp",
          "content": [
            {
              "_type": "block",
              "_key": "k33",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "We photograph new buildings, interiors and the places around them. Our work is slow and deliberate: we scout the site, study how light moves across it and return when the conditions are right.",
                  "_key": "k33s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k34",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "How we work",
                  "_key": "k34s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k35",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Every commission begins with a conversation about what the architect wants the building to say. We then plan the days around the sun, the weather and the people who will use the space.",
                  "_key": "k35s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k36",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "We shoot on a tripod, with a tilt-shift lens, and we do not rearrange rooms unless asked. The result is photography that is sharp, calm and true to the drawings.",
                  "_key": "k36s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k37",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Who we work with",
                  "_key": "k37s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k38",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Architects, interior designers, developers and public bodies, mostly in coastal and mountain regions, and wherever a good building is waiting for good light. We take a limited number of commissions each year so every project gets full attention.",
                  "_key": "k38s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k39",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "What you receive",
                  "_key": "k39s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k40",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "A curated set of edited images, delivered web-ready and print-ready, with a usage licence that covers publication, awards entries and your own website. Delivery is usually within two weeks of the shoot.",
                  "_key": "k40s"
                }
              ],
              "markDefs": []
            }
          ]
        }
      },
      {
        "id": "usage-and-licensing",
        "slug": "usage-and-licensing",
        "status": "published",
        "data": {
          "title": "Usage and licensing",
          "eyebrow": "Usage and licensing",
          "intro": "A few plain notes on how photographs are delivered and used.",
          "content": [
            {
              "_type": "block",
              "_key": "k41",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Commissions",
                  "_key": "k41s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k42",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "A commission is agreed by email: we confirm the scope, the dates and a fee, and ask for a deposit. An enquiry on this website is not a booking.",
                  "_key": "k42s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k43",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Licence",
                  "_key": "k43s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k44",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Photographs are licensed to the architect and the client for publication, competitions, awards entries and their own websites and social channels. Further uses are agreed in writing.",
                  "_key": "k44s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k45",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Delivery",
                  "_key": "k45s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k46",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Final images are delivered through a private link, web-ready and print-ready, usually within two weeks of the shoot.",
                  "_key": "k46s"
                }
              ],
              "markDefs": []
            }
          ]
        }
      }
    ],
    "projects": [
      {
        "id": "harbour-rotunda",
        "slug": "harbour-rotunda",
        "status": "published",
        "data": {
          "title": "Harbour Rotunda",
          "category": "civic",
          "architect": "Marenne Voss Studio",
          "place": "Port Alder, Northern Coast",
          "year": "2024",
          "programme": "Maritime museum",
          "summary": "A spiralling concrete shell that opens a single oculus to the harbour sky.",
          "featured": true,
          "position": 10,
          "photo": "/images/civic.webp",
          "gallery": [
            {
              "photo": "/images/print-pool.webp",
              "caption": "The shell and its reflecting pool, minutes before sunset."
            },
            {
              "photo": "/images/curve-soffit.webp",
              "caption": "The soffit edge turns away from the sea wind."
            },
            {
              "photo": "/images/sea-horizon.webp",
              "caption": "From the upper terrace the museum looks back at the water."
            },
            {
              "photo": "/images/pavilion-pool.webp",
              "caption": "The public arcade at the foot of the rotunda."
            }
          ],
          "content": [
            {
              "_type": "block",
              "_key": "k1",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "The museum was designed as one continuous gesture: a ramp that winds up through the shell and releases visitors under a single circular opening. The architects wanted the building to feel carved rather than assembled.",
                  "_key": "k1s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k2",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "We photographed it over three evenings. The oculus only reads as a pure circle for a few minutes each day, so most of the work was waiting, and being in the same spot at the same time each time the light was right.",
                  "_key": "k2s"
                }
              ],
              "markDefs": []
            }
          ]
        }
      },
      {
        "id": "meridian-library",
        "slug": "meridian-library",
        "status": "published",
        "data": {
          "title": "Meridian Library",
          "category": "civic",
          "architect": "Okoro & Lind Architects",
          "place": "Northfield, Inland Valley",
          "year": "2023",
          "programme": "Public library",
          "summary": "A sweeping concrete canopy shelters reading rooms, a courtyard and a long reflecting pool.",
          "featured": true,
          "position": 20,
          "photo": "/images/print-pool.webp",
          "gallery": [
            {
              "photo": "/images/civic.webp",
              "caption": "Looking up through the stair rotunda."
            },
            {
              "photo": "/images/pavilion-pool.webp",
              "caption": "The reading terrace at dusk, with the pool beyond."
            },
            {
              "photo": "/images/curve-soffit.webp",
              "caption": "The canopy edge, a single curve over four storeys."
            },
            {
              "photo": "/images/print-interior.webp",
              "caption": "A study hall, lit by tall timber fins."
            }
          ],
          "content": [
            {
              "_type": "block",
              "_key": "k3",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Meridian is a library that behaves like a public square. The canopy reaches well beyond the glass so that people can shelter, meet and read outside in any weather.",
                  "_key": "k3s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k4",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "The brief for the photographs was to show the building working: slow mornings with a few readers, and the long blue hour when the whole facade glows from within.",
                  "_key": "k4s"
                }
              ],
              "markDefs": []
            }
          ]
        }
      },
      {
        "id": "cloister-hall",
        "slug": "cloister-hall",
        "status": "published",
        "data": {
          "title": "Cloister Hall",
          "category": "civic",
          "architect": "Halden Reyes Partners",
          "place": "Saint Orrin, Western Isles",
          "year": "2022",
          "programme": "Community hall and archive",
          "summary": "A calm community hall organised around a sunlit stone cloister.",
          "featured": false,
          "position": 30,
          "photo": "/images/curve-soffit.webp",
          "gallery": [
            {
              "photo": "/images/civic.webp",
              "caption": "The cloister roof opens to the sky."
            },
            {
              "photo": "/images/sea-horizon.webp",
              "caption": "The hall faces the water across a low terrace."
            },
            {
              "photo": "/images/pavilion-pool.webp",
              "caption": "Evening on the north walk."
            }
          ],
          "content": [
            {
              "_type": "block",
              "_key": "k5",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Cloister Hall holds a village archive, a small theatre and a kitchen that anyone can book. Everything faces the central court, and the court faces the weather.",
                  "_key": "k5s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k6",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "We stayed two days and shot in every kind of light the islands offered: low cloud, hard sun and a long, quiet evening.",
                  "_key": "k6s"
                }
              ],
              "markDefs": []
            }
          ]
        }
      },
      {
        "id": "house-of-oak-and-light",
        "slug": "house-of-oak-and-light",
        "status": "published",
        "data": {
          "title": "House of Oak and Light",
          "category": "interiors",
          "architect": "Atelier Brandt Sol",
          "place": "Kestrel Heights, Hillside Quarter",
          "year": "2025",
          "programme": "Private residence, interior",
          "summary": "Walnut, travertine and floor-to-ceiling glass in a hillside living hall.",
          "featured": true,
          "position": 40,
          "photo": "/images/interiors.webp",
          "gallery": [
            {
              "photo": "/images/glass-living.webp",
              "caption": "The living room opens onto the terrace."
            },
            {
              "photo": "/images/print-interior.webp",
              "caption": "A quiet landing between the library and the garden."
            },
            {
              "photo": "/images/pavilion-pool.webp",
              "caption": "From the pool terrace looking back into the house."
            },
            {
              "photo": "/images/camera-lens.webp",
              "caption": "Test frames before the final set-up."
            }
          ],
          "content": [
            {
              "_type": "block",
              "_key": "k7",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "The house is organised by light. A wall of oak breaks up the long south glazing and draws the eye to a single chair by the window, which became the heart of the series.",
                  "_key": "k7s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k8",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Interior work depends on patience: we shoot at several times through the day, never relight, and let the room show how it changes.",
                  "_key": "k8s"
                }
              ],
              "markDefs": []
            }
          ]
        }
      },
      {
        "id": "still-room",
        "slug": "still-room",
        "status": "published",
        "data": {
          "title": "Still Room",
          "category": "interiors",
          "architect": "Voss & Almeida",
          "place": "Marlow Court, Old Town",
          "year": "2024",
          "programme": "Reading room and gallery",
          "summary": "A timber-finned hall where afternoon light moves across a stone floor.",
          "featured": true,
          "position": 50,
          "photo": "/images/print-interior.webp",
          "gallery": [
            {
              "photo": "/images/interiors.webp",
              "caption": "Warm oak against pale plaster."
            },
            {
              "photo": "/images/glass-living.webp",
              "caption": "Glass and olive in the south room."
            },
            {
              "photo": "/images/print-pool.webp",
              "caption": "The room is entered from the long pool court."
            }
          ],
          "content": [
            {
              "_type": "block",
              "_key": "k9",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Still Room is almost empty by design: a stone floor, timber fins and a single bowl on a plinth. The architects asked for photographs that felt as quiet as the space.",
                  "_key": "k9s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k10",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "We kept the camera low and level, and waited for the fins to throw their shadows across the floor.",
                  "_key": "k10s"
                }
              ],
              "markDefs": []
            }
          ]
        }
      },
      {
        "id": "glass-salon",
        "slug": "glass-salon",
        "status": "published",
        "data": {
          "title": "The Glass Salon",
          "category": "interiors",
          "architect": "Studio Perrault Wyn",
          "place": "Seabright, Southern Shore",
          "year": "2023",
          "programme": "Private residence, living areas",
          "summary": "A curved glass living room that reads as a continuation of the terrace and the sea beyond.",
          "featured": false,
          "position": 60,
          "photo": "/images/glass-living.webp",
          "gallery": [
            {
              "photo": "/images/hero-home.webp",
              "caption": "The salon from the infinity pool at golden hour."
            },
            {
              "photo": "/images/interiors.webp",
              "caption": "A corner of the oak-lined hall."
            },
            {
              "photo": "/images/residential.webp",
              "caption": "The entrance loggia, framed by an olive tree."
            }
          ],
          "content": [
            {
              "_type": "block",
              "_key": "k11",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "The curved glazing is the whole idea: from inside the room there is no visible edge between the sofa, the terrace and the water.",
                  "_key": "k11s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k12",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Photographing glass means managing reflections. We shot at dusk so the interior lights balanced the sky.",
                  "_key": "k12s"
                }
              ],
              "markDefs": []
            }
          ]
        }
      },
      {
        "id": "cape-villa",
        "slug": "cape-villa",
        "status": "published",
        "data": {
          "title": "Cape Villa",
          "category": "residential",
          "architect": "Halden Reyes Partners",
          "place": "Cape Linden, Southern Shore",
          "year": "2025",
          "programme": "Private villa",
          "summary": "A monolithic stone portal frames an ancient olive tree and a view of the bay.",
          "featured": true,
