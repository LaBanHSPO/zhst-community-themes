---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import CommissionBand from "../../components/CommissionBand.astro";
import { getPosts, getStudio, photoAlt, photoSrc, postHref } from "../../lib/studio";

const [postsResult, studioResult] = await Promise.all([getPosts(), getStudio()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(postsResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const posts = postsResult.entries;
---

<Base title="Journal" description="Notes from site: field notes, technique and short briefs on photographing architecture.">
	<PageHead
		id="journal-title"
		eyebrow="Journal"
		title="Notes from site."
		intro="Field notes, technique and short briefs from the days we spend waiting for the light."
	/>

	<section class="section list-section" aria-labelledby="journal-title">
		<div class="wrap">
			{
				posts.length === 0 ? (
					<p class="empty">New notes are on their way.</p>
				) : (
					<ul class="post-list">
						{posts.map((p) => {
							const src = photoSrc(p.data.image, p.data.photo);
							return (
								<li>
									<a class="post-row" href={postHref(p.data)}>
										{src && (
											<span class="post-row-media">
												<img src={src} alt={photoAlt(p.data.image, p.data.photo, p.data.title)} width="720" height="480" loading="lazy" />
											</span>
										)}
										<span class="post-row-body">
											<span class="post-card-topic">{[p.data.topic, p.data.date_label].filter(Boolean).join(" · ")}</span>
											<span class="post-row-title" {...p.edit.title}>{p.data.title}</span>
											<span class="post-row-summary">{p.data.summary}</span>
										</span>
									</a>
								</li>
							);
						})}
					</ul>
				)
			}
		</div>
	</section>

	<CommissionBand studio={studioResult.studio} />
</Base>
