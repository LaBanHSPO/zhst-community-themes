---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CommissionBand from "../../components/CommissionBand.astro";
import { CATEGORIES, getProjects, getStudio } from "../../lib/studio";

const [projectsResult, studioResult] = await Promise.all([getProjects(), getStudio()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(projectsResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const all = projectsResult.entries;

// Category filter: one link per category that has at least one project, in the fixed Civic / Interiors / Residential order.
const categories = CATEGORIES.filter((c) => all.some((p) => p.data.category === c.slug));
const active = categories.find((c) => c.slug === Astro.url.searchParams.get("category"));
const projects = active ? all.filter((p) => p.data.category === active.slug) : all;
---

<Base
	title={active ? `${active.label} projects` : "Work"}
	description="Architecture photography projects: civic buildings, interiors and residential work, photographed for architects, developers and studios."
	current="/work"
>
	<PageHead
		eyebrow="Work"
		title={active ? `${active.label} architecture.` : "Buildings, seen clearly."}
		intro="A selection of commissions for architects and studios. Every project was photographed over several visits, in the light the architecture was designed for."
	/>

	<section class="section list-section" aria-label="Projects">
		<div class="wrap">
			{
				categories.length > 1 && (
					<nav class="filter" aria-label="Filter by category">
						<a href="/work" aria-current={active ? undefined : "true"}>All</a>
						{categories.map((c) => (
							<a href={`/work?category=${c.slug}`} aria-current={active?.slug === c.slug ? "true" : undefined}>{c.label}</a>
						))}
					</nav>
				)
			}
			{
				projects.length > 0 ? (
					<ul class="work-grid">
						{projects.map((p) => <li><ProjectCard project={p} /></li>)}
					</ul>
				) : (
					<p class="empty">No projects in this category yet.</p>
				)
			}
		</div>
	</section>

	<CommissionBand studio={studioResult.studio} type={active?.slug} />
</Base>
