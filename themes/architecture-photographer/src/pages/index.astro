---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import CommissionBand from "../components/CommissionBand.astro";
import ProjectCard from "../components/ProjectCard.astro";
import {
	CATEGORIES,
	getApproach,
	getPosts,
	getProjects,
	getStudio,
	photoAlt,
	photoSrc,
	postHref,
} from "../lib/studio";

const [projectsResult, postsResult, approachResult, studioResult] = await Promise.all([
	getProjects(),
	getPosts(),
	getApproach(),
	getStudio(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(projectsResult.cacheHint);
	Astro.cache.set(postsResult.cacheHint);
	Astro.cache.set(approachResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const projects = projectsResult.entries;
const posts = postsResult.entries.slice(0, 3);
const approach = approachResult.entries;

// One cover per category for the "Featured work" row: the first featured project in each category.
const categoryCovers = CATEGORIES.map((c) => {
	const inCategory = projects.filter((p) => p.data.category === c.slug);
	const project = inCategory.find((p) => p.data.featured) ?? inCategory[0];
	return { ...c, project };
});
const coverIds = new Set(categoryCovers.map((c) => c.project?.data.id));
const selected = projects.filter((p) => p.data.featured && !coverIds.has(p.data.id)).slice(0, 4);
---

<Base
	title="KELLEN — Architecture Photographer"
	description="Photographs of sculptural buildings, honest interiors and the places that shape a brighter tomorrow. Architecture photography for architects, developers and studios."
	overlay
>
	<section class="hero" aria-labelledby="hero-title">
		<img
			class="hero-photo"
			src="/images/hero-home.webp"
			alt="A sweeping curved concrete cantilever with floor-to-ceiling glass, an infinity pool, the sea and mountains at golden hour"
			width="1448"
			height="751"
			fetchpriority="high"
		/>
		<div class="frame hero-frame">
			<div class="hero-copy">
				<p class="hero-eyebrow">Architecture in focus</p>
				<h1 id="hero-title" class="hero-title">Space. Light.<br />Perspective.</h1>
				<p class="hero-sub">Photographs of places that shape<br class="br-wide" /> a brighter tomorrow.</p>
				<a class="btn-dark hero-btn" href="/work"><span>View projects</span><Arrow /></a>
			</div>
			<ul class="hero-rail" aria-label="Subjects">
				<li>Buildings</li>
				<li>People</li>
				<li>Places</li>
				<li>Perspective</li>
			</ul>
		</div>
	</section>

	<section class="featured" aria-labelledby="featured-title">
		<div class="frame featured-grid">
			<div class="featured-intro">
				<p class="eyebrow">Featured work</p>
				<h2 id="featured-title" class="display featured-title">Architecture<br /> Through a Clearer Lens</h2>
				<span class="rule" aria-hidden="true"></span>
				<p class="featured-text">Sculptural buildings. Honest spaces.<br class="br-wide" /> Timeless stories.</p>
			</div>
			{
				categoryCovers.map((c) => {
					const src = photoSrc(c.project?.data.image, c.project?.data.photo) ?? `/images/${c.slug}.webp`;
					const alt = photoAlt(c.project?.data.image, c.project?.data.photo, `${c.label} architecture`);
					return (
						<a class="featured-card" href={`/work?category=${c.slug}`}>
							<img src={src} alt={alt} width="570" height="408" loading="lazy" />
							<span class="featured-label">
								<span>{c.label}</span>
								<span class="dash" aria-hidden="true"></span>
							</span>
						</a>
					);
				})
			}
		</div>
	</section>

	{
		selected.length > 0 && (
			<section class="section selected" aria-labelledby="selected-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">Selected projects</p>
							<h2 id="selected-title" class="display">Recent commissions</h2>
						</div>
						<a class="text-link" href="/work"><span>All projects</span><Arrow /></a>
					</div>
					<ul class="selected-grid">
						{selected.map((p, i) => <li class:list={{ "is-wide": i === 0 || i === 3 }}><ProjectCard project={p} wide={i === 0 || i === 3} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	{
		approach.length > 0 && (
			<section class="section approach" aria-labelledby="approach-title">
				<div class="wrap approach-grid">
					<div class="approach-intro">
						<p class="eyebrow">For architects and developers</p>
						<h2 id="approach-title" class="display">Photography that works as hard as the architecture.</h2>
						<p class="lede">
							We plan every commission around the building, the light and the people who will use it, and deliver
							images that are ready to publish.
						</p>
						<a class="text-link" href="/about"><span>About the practice</span><Arrow /></a>
					</div>
					<ol class="approach-list">
						{approach.map((a, i) => (
							<li>
								<span class="approach-no">{String(i + 1).padStart(2, "0")}</span>
								<h3>{a.data.title}</h3>
								{a.data.text && <p>{a.data.text}</p>}
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	{
		posts.length > 0 && (
			<section class="section journal-teaser" aria-labelledby="journal-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">Journal</p>
							<h2 id="journal-title" class="display">Notes from site</h2>
						</div>
						<a class="text-link" href="/journal"><span>All notes</span><Arrow /></a>
					</div>
					<ul class="post-cards">
						{posts.map((p) => {
							const src = photoSrc(p.data.image, p.data.photo);
							return (
								<li>
									<a class="post-card" href={postHref(p.data)}>
										{src && <img src={src} alt={photoAlt(p.data.image, p.data.photo, p.data.title)} width="600" height="420" loading="lazy" />}
										<span class="post-card-topic">{[p.data.topic, p.data.date_label].filter(Boolean).join(" · ")}</span>
										<span class="post-card-title">{p.data.title}</span>
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	<CommissionBand studio={studioResult.studio} />
</Base>
