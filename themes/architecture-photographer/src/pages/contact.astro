---
import Base from "../layouts/Base.astro";
import { CATEGORIES, getStudio, telHref } from "../lib/studio";

const { studio, cacheHint } = await getStudio();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// ?type=<category slug> pre-selects the project type (links from work pages and the commission bands).
const wanted = Astro.url.searchParams.get("type");
const selected = CATEGORIES.find((c) => c.slug === wanted);
---

<Base
	title="Commission a shoot"
	description="Commission architecture photography from KELLEN. Tell us about the building, where it is and when it is ready; we reply personally, usually within two working days."
>
	<div class="contact">
		<div class="contact-photo">
			<img
				src="/images/pavilion-pool.webp"
				alt="A concrete pavilion with a glazed living room, a pool in the foreground and soft evening light"
				width="1212"
				height="1036"
			/>
		</div>
		<section class="contact-panel" aria-labelledby="contact-title">
			<p class="eyebrow">Commissions</p>
			<h1 id="contact-title" class="display display-xl">Tell us about the building.</h1>
			<p class="lede">
				Share the project, where it is and when it will be ready to photograph. An enquiry is not a booking until we have replied and agreed scope, dates and fee.
			</p>

			<form
				class="contact-form"
				data-contact-form
				data-email={studio.email}
				action={studio.email ? `mailto:${studio.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field">
						<label for="q-name">Your name</label>
						<input id="q-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="q-name"></span>
					</div>
					<div class="field">
						<label for="q-email">Email</label>
						<input id="q-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="q-email"></span>
					</div>
					<div class="field">
						<label for="q-phone">Phone <span class="optional">(optional)</span></label>
						<input id="q-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field">
						<label for="q-type">Project type</label>
						<select id="q-type" name="type" required>
							<option value="" selected={!selected}>Choose a project type</option>
							{CATEGORIES.map((c) => <option value={c.label} selected={selected?.slug === c.slug}>{c.label}</option>)}
							<option value="Not sure yet">Not sure yet, please advise</option>
						</select>
						<span class="field-error" data-error-for="q-type"></span>
					</div>
					<div class="field">
						<label for="q-place">Project name and location</label>
						<input id="q-place" name="place" type="text" placeholder="Building, town or region" required />
						<span class="field-error" data-error-for="q-place"></span>
					</div>
					<div class="field">
						<label for="q-timing">When is it ready? <span class="optional">(optional)</span></label>
						<input id="q-timing" name="timing" type="text" placeholder="e.g. late spring 2027" />
					</div>
					<div class="field full">
						<label for="q-notes">About the project <span class="optional">(optional)</span></label>
						<textarea id="q-notes" name="notes" rows="4" placeholder="The architect, the views that matter most, how the images will be used…"></textarea>
					</div>
				</div>
				<button class="btn-dark btn-block" type="submit"><span>Send enquiry</span></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{studio.email && <>Write to <a href={`mailto:${studio.email}`}>{studio.email}</a> with the project, its location and your timing.</>}
					</noscript>
				</p>
			</form>

			<div class="contact-details">
				<h2>Prefer to write or call?</h2>
				<p>
					{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}
					{studio.phone && <a href={telHref(studio.phone)}>{studio.phone}</a>}
				</p>
				{studio.response && <p class="small">{studio.response}</p>}
				{studio.commission_note && <p class="small">{studio.commission_note}</p>}
			</div>
		</section>
	</div>
</Base>

<script>
	// Compose an enquiry email; the studio replies to it. Nothing is sent or stored by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input[required], select[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online enquiries are not available right now. Please call us.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Commission enquiry: ${get("type")}, ${get("place")}`;
			const lines = [
				"Hello,",
				"",
				"I would like to enquire about architecture photography:",
				`Name: ${get("name")}`,
				`Project type: ${get("type")}`,
				`Project and location: ${get("place")}`,
				get("timing") ? `When it is ready: ${get("timing")}` : "",
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("notes") ? `About the project: ${get("notes")}` : "",
				"",
				"I understand this is an enquiry and not a booking until scope, dates and fee are agreed.",
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this enquiry ready to send. It is only sent when you send that email, and we reply personally. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
