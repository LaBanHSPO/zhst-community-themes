---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<div class="notfound-copy">
			<p class="eyebrow">Error 404</p>
			<h1 id="nf-title" class="display display-xl">This view is out of frame.</h1>
			<p class="lede">The page you are looking for has moved or never existed. These are good places to start again.</p>
			<div class="actions">
				<a class="btn-dark" href="/"><span>Back to home</span><Arrow /></a>
				<a class="btn-line" href="/work">Work</a>
				<a class="btn-line" href="/contact">Commission</a>
			</div>
		</div>
		<img class="notfound-photo" src="/images/curve-soffit.webp" alt="" width="680" height="880" />
	</section>
</Base>
