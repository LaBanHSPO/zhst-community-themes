---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<div class="wrap">
		<section class="notfound" aria-labelledby="nf-title">
			<div>
				<p class="eyebrow">Error 404</p>
				<h1 id="nf-title" class="display">That page has wandered off the path.</h1>
				<p class="lede">The page you are looking for has moved or never existed. The latest stories are a good place to start again.</p>
				<div class="actions">
					<a class="btn" href="/stories"><span>Read the latest</span><Arrow /></a>
					<a class="text-link" href="/"><span>Back to home</span><Arrow /></a>
				</div>
			</div>
			<img src="/images/vase-olive.webp" alt="" width="488" height="430" />
		</section>
	</div>
</Base>
