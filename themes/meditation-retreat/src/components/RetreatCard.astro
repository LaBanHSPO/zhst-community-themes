---
import { dateRange, formatPrice, nightsLabel, photoSrc, regionLabel } from "../lib/retreat";
import type { RetreatRow } from "../lib/retreat";

interface Props {
	row: RetreatRow;
	past?: boolean;
}
const { row, past = false } = Astro.props;
const d = row.entry.data;
const src = photoSrc(d.image, d.photo);
---

<a class:list={["retreat-card", { "is-past": past }]} href={`/retreats/${d.slug ?? d.id}`}>
	<span class="card-photo">{src && <img src={src} alt="" width="600" height="450" loading="lazy" />}</span>
	<span class="card-meta">
		<span>{regionLabel(d.region)}</span>
		<span aria-hidden="true">/</span>
		<span>{nightsLabel(d.nights)}</span>
	</span>
	<span class="card-title" {...row.entry.edit.title}>{d.title}</span>
	<span class="card-dates">{dateRange(row.start, row.end)}</span>
	<span class="card-place">{d.location}</span>
	{!past && d.price_from ? <span class="card-price">From {formatPrice(d.price_from)} per guest</span> : null}
</a>
