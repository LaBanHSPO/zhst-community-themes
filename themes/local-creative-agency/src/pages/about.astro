---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { getOffice, getPeople, getValues, initials, photoSrc } from "../lib/agency";

const [{ entry: page, cacheHint }, valuesResult, peopleResult, officeResult] = await Promise.all([
	getEmDashEntry("pages", "about"),
	getValues(),
	getPeople(),
	getOffice(),
]);
if (Astro.cache?.enabled) {
	if (cacheHint) Astro.cache.set(cacheHint);
	Astro.cache.set(valuesResult.cacheHint);
	Astro.cache.set(peopleResult.cacheHint);
	Astro.cache.set(officeResult.cacheHint);
}
const values = valuesResult.entries;
const people = peopleResult.entries;
const { office } = officeResult;
const title = page?.data.title ?? "About LOCAL";
---

<Base
	title="About"
	description={page?.data.intro ?? "LOCAL is a small creative agency of designers, thinkers and doers helping purposeful brands make a bigger impact."}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	<section class="page-head">
		<div class="container page-head-inner">
			<p class="eyebrow">{page?.data.eyebrow ?? "About"}</p>
			<h1 {...page?.edit.title}>{title}</h1>
			{page?.data.intro && <p class="lede">{page.data.intro}</p>}
		</div>
	</section>

	<section class="section about-story">
		<div class="container about-grid">
			<div class="prose">
				{page?.data.content && <PortableText value={page.data.content} />}
			</div>
			<figure class="about-photo">
				<img
					src="/images/studio-wide.webp"
					alt="Three colleagues around a studio table, planning a layout among plants and wall prints"
					width="1448"
					height="1086"
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	{
		values.length > 0 && (
			<section class="section values-band" aria-labelledby="values-title">
				<div class="container">
					<div class="section-head">
						<p class="eyebrow">What we believe</p>
						<h2 id="values-title" class="section-title">Small on purpose.</h2>
					</div>
					<ul class="values">
						{values.map((v) => (
							<li>
								<h3 {...v.edit.title}>{v.data.title}</h3>
								<p>{v.data.text}</p>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	{
		people.length > 0 && (
			<section class="section" aria-labelledby="team-title">
				<div class="container">
					<div class="section-head">
						<p class="eyebrow">Our team</p>
						<h2 id="team-title" class="section-title">Good people. Great work.</h2>
					</div>
					<ul class="team">
						{people.map((p) => {
							const src = photoSrc(p.data.image, p.data.photo);
							return (
								<li>
									{src ? (
										<img class="team-photo" src={src} alt="" width="96" height="96" loading="lazy" decoding="async" />
									) : (
										<span class="team-photo monogram" aria-hidden="true">{initials(p.data.title)}</span>
									)}
									<h3 {...p.edit.title}>{p.data.title}</h3>
									<p class="team-role">{p.data.role}</p>
									{p.data.summary && <p>{p.data.summary}</p>}
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	<CtaBand office={office} />
</Base>
