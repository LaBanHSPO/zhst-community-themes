---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import WorkCard from "../../components/WorkCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { disciplineLabel, getOffice, getProjects, photoSrc, tagList } from "../../lib/agency";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: project, cacheHint } = await getEmDashEntry("projects", slug);
if (!project) return Astro.rewrite("/404");

const [allResult, officeResult, settings] = await Promise.all([getProjects(), getOffice(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
	Astro.cache.set(officeResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(project, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const others = allResult.entries.filter((p) => p.data.id !== project.data.id).slice(0, 3);
const src = photoSrc(project.data.featured_image, project.data.photo);
const gallery = [project.data.photo_2, project.data.photo_3].filter(Boolean) as string[];
const { office } = officeResult;
const facts = [
	["Client", project.data.client],
	["Disciplines", tagList(project.data.tags).join(", ")],
	["Year", project.data.year],
].filter(([, v]) => v);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? project.data.summary}
	canonical={seo.canonical}
	image={seo.ogImage ?? src}
	content={{ collection: "projects", id: project.data.id, slug }}
	current="/work"
>
	<section class="detail-head">
		<div class="container">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/work">Work</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{project.data.title}</span>
			</nav>
			<div class:list={["detail-head-inner", { "is-text-only": !src }]}>
				<div class="detail-copy">
					<p class="eyebrow">{disciplineLabel(project.data.tags)}</p>
					<h1 {...project.edit.title}>{project.data.title}</h1>
					<p class="summary" {...project.edit.summary}>{project.data.summary}</p>
					<dl class="facts">
						{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
					</dl>
				</div>
				{
					src && (
						<figure class="detail-photo">
							<img src={src} alt={project.data.featured_image?.alt ?? `${project.data.title} — ${project.data.summary}`} />
						</figure>
					)
				}
			</div>
		</div>
	</section>

	<section class="detail-body">
		<div class="container">
			{
				(project.data.brief || project.data.approach) && (
					<div class="brief-grid">
						{project.data.brief && <div class="brief-card"><h2>The brief</h2><p>{project.data.brief}</p></div>}
						{project.data.approach && <div class="brief-card is-dark"><h2>Our approach</h2><p>{project.data.approach}</p></div>}
					</div>
				)
			}
			<div class="prose prose-wide">
				{project.data.content && project.data.content.length > 0 && <PortableText value={project.data.content} />}
			</div>
			{
				gallery.length > 0 && (
					<div class:list={["gallery", { "is-single": gallery.length === 1 }]}>
						{gallery.map((g) => (
							<figure><img src={g} alt="" loading="lazy" decoding="async" /></figure>
						))}
					</div>
				)
			}
			<p class="page-cta"><a class="btn-terra" href="/contact">Start a project <Arrow /></a></p>
		</div>
	</section>

	{
		others.length > 0 && (
			<section class="section more-work" aria-labelledby="more-title">
				<div class="container">
					<div class="section-head">
						<p class="eyebrow">More work</p>
						<h2 id="more-title" class="section-title">Other stories.</h2>
					</div>
					<div class="work-grid is-three">
						{others.map((p) => <WorkCard project={p} />)}
					</div>
				</div>
			</section>
		)
	}

	<CtaBand office={office} />
</Base>
