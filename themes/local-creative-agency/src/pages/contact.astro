---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { getOffice, getServices, mapHref, telHref } from "../lib/agency";

const [{ office, cacheHint }, servicesResult] = await Promise.all([getOffice(), getServices()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(servicesResult.cacheHint);
}
const options = [...servicesResult.entries.map((s) => s.data.title), "Something else"];
const requested = Astro.url.searchParams.get("service");
const selected = requested && options.includes(requested) ? requested : undefined;
---

<Base title="Let's talk" description="Tell us about your brand, your place and your idea. We reply within two working days.">
	<section class="page-head">
		<div class="container page-head-inner">
			<p class="eyebrow">Contact</p>
			<h1>Let's talk.</h1>
			<p class="lede">
				Tell us a little about the brand, the place and the idea. We read every message and reply within two working days.
			</p>
		</div>
	</section>

	<section class="contact-section">
		<div class="container contact-grid">
			<div class="contact-form">
				<h2>Your message</h2>
				<p>Your message is prepared in your own email app, so nothing is stored on this site. Company and phone are optional.</p>
				<form
					data-contact-form
					data-email={office.email}
					action={office.email ? `mailto:${office.email}` : undefined}
					method="post"
					enctype="text/plain"
					novalidate
				>
					<div class="form-grid">
						<div class="field">
							<label for="c-name">Name</label>
							<input id="c-name" name="name" type="text" autocomplete="name" required aria-describedby="c-name-err" />
							<span class="field-error" id="c-name-err" data-error-for="c-name"></span>
						</div>
						<div class="field">
							<label for="c-email">Email</label>
							<input id="c-email" name="email" type="email" autocomplete="email" required aria-describedby="c-email-err" />
							<span class="field-error" id="c-email-err" data-error-for="c-email"></span>
						</div>
						<div class="field">
							<label for="c-company">Company or brand <span class="optional">(optional)</span></label>
							<input id="c-company" name="company" type="text" autocomplete="organization" />
						</div>
						<div class="field">
							<label for="c-phone">Phone <span class="optional">(optional)</span></label>
							<input id="c-phone" name="phone" type="tel" autocomplete="tel" />
						</div>
						<div class="field full">
							<label for="c-service">What do you need help with?</label>
							<select id="c-service" name="service">
								{options.map((t) => <option selected={t === selected}>{t}</option>)}
							</select>
						</div>
						<div class="field full">
							<label for="c-message">About the project</label>
							<textarea
								id="c-message"
								name="message"
								rows="5"
								required
								aria-describedby="c-message-err"
								placeholder="Who is it for, what are you hoping to change, and when would you like to start?"
							></textarea>
							<span class="field-error" id="c-message-err" data-error-for="c-message"></span>
						</div>
					</div>
					<button class="btn-terra" type="submit">Prepare my message <Arrow /></button>
					<p class="form-status" role="status" aria-live="polite" data-status>
						<noscript>
							This form needs JavaScript to prepare your email.
							{office.email && <>Write to <a href={`mailto:${office.email}`}>{office.email}</a> instead.</>}
						</noscript>
					</p>
				</form>
			</div>

			<aside class="contact-aside" aria-label="Contact details">
				<div class="contact-card">
					<h2>Prefer to call or write?</h2>
					<dl class="contact-list">
						{office.email && <div><dt>Email</dt><dd><a href={`mailto:${office.email}`}>{office.email}</a></dd></div>}
						{office.phone && <div><dt>Phone</dt><dd><a href={telHref(office.phone)}>{office.phone}</a></dd></div>}
						{office.hours && <div><dt>Hours</dt><dd>{office.hours}</dd></div>}
						{
							(office.street || office.locality) && (
								<div>
									<dt>Studio</dt>
									<dd>
										<a href={mapHref(office)} target="_blank" rel="noopener noreferrer">
											{office.street}{office.street && <br />}
											{office.locality}
										</a>
									</dd>
								</div>
							)
						}
					</dl>
				</div>
				<div class="contact-card is-dark">
					<h2>What happens next</h2>
					<ol class="next-steps">
						<li>{office.response_note || "We reply to every message within two working days."}</li>
						<li>We set up a short call to hear the whole story.</li>
						<li>You receive a clear, written proposal before anything starts.</li>
					</ol>
				</div>
			</aside>
		</div>
	</section>
</Base>

<script>
	// Compose an enquiry email in the visitor's own email app. Nothing is sent or stored by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[required], textarea[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const valueMissing = input.value.trim() === "";
				const message = valueMissing
					? "Please fill this in."
					: !input.validity.valid
						? input.type === "email"
							? "Please enter a valid email address."
							: "Please check this field."
						: "";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online enquiries are not available right now. Please call the studio.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Project enquiry: ${get("service")}`;
			const body = [
				"Hello LOCAL,",
				"",
				get("message"),
				"",
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("company") ? `Company: ${get("company")}` : "",
				get("phone") ? `Phone: ${get("phone")}` : "",
				`Interested in: ${get("service")}`,
			]
				.filter((line, i) => line !== "" || i === 1 || i === 3)
				.join("\n");
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			status.textContent =
				"Your email app should open with this message ready to send. It is only sent when you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
