---
import Arrow from "./Arrow.astro";
import { telHref, type OfficeData } from "../lib/agency";

interface Props {
	office: OfficeData;
	heading?: string;
}
const { office, heading = "Have something worth making?" } = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
	<div class="container cta-inner">
		<div class="cta-copy">
			<p class="eyebrow">Say hello</p>
			<h2 id="cta-title">{heading}</h2>
			<p>Tell us about the people, the place and the idea. We read every message and reply within two working days.</p>
			<div class="cta-actions">
				<a class="btn-terra" href="/contact">Let's talk <Arrow /></a>
				{office.email && <a class="cta-link" href={`mailto:${office.email}`}>{office.email}</a>}
				{office.phone && <a class="cta-link" href={telHref(office.phone)}>{office.phone}</a>}
			</div>
		</div>
		<span class="cta-note" aria-hidden="true">Let's make<br />something<br />brighter</span>
	</div>
</section>
