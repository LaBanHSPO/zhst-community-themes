---
/** Work card: photo, title, discipline in tracked caps. */
import { disciplineLabel, entryHref, photoSrc } from "../lib/agency";

interface Props {
	project: { data: any; edit: Record<string, Record<string, unknown>> };
}
const { project } = Astro.props;
const p = project.data;
const src = photoSrc(p.featured_image, p.photo);
---

<a class="work-card" href={entryHref("/work", p)}>
	{src && <img class="work-card-photo" src={src} alt={p.featured_image?.alt ?? `${p.title} — ${p.summary}`} width="270" height="217" loading="lazy" decoding="async" />}
	<span class="work-card-title" {...project.edit.title}>{p.title}</span>
	<span class="work-card-tags">{disciplineLabel(p.tags)}</span>
</a>
