---
import Cover from "./Cover.astro";
import { bookHref, genreLabel } from "../lib/press";
import type { Book } from "../lib/press";

interface Props {
	book: { data: Book; edit: Record<string, Record<string, unknown>> };
	authorName?: string;
	eager?: boolean;
}
const { book, authorName = "", eager = false } = Astro.props;
const d = book.data;
---

<a class="book-card" href={bookHref(d)}>
	<span class="cover-box"><Cover book={d} authorName={authorName} eager={eager} /></span>
	<span class="bc-genre">{genreLabel(d.genre)}</span>
	<span class="bc-title" {...book.edit.title}>{d.title}</span>
	{authorName && <span class="bc-author">{authorName}</span>}
</a>
