---
import { journalHref, photoAlt, photoSrc } from "../lib/press";
import type { Journal } from "../lib/press";

interface Props {
	post: { data: Journal; edit: Record<string, Record<string, unknown>> };
	eager?: boolean;
}
const { post, eager = false } = Astro.props;
const d = post.data;
const src = photoSrc(d.image, d.photo);
---

<a class="post-card" href={journalHref(d)}>
	{src && <img src={src} alt={photoAlt(d.image, d.photo, d.title)} width="520" height="390" loading={eager ? "eager" : "lazy"} />}
	<span class="pc-meta">{[d.kind, d.date_label].filter(Boolean).join(" / ")}</span>
	<span class="pc-title" {...post.edit.title}>{d.title}</span>
	<span class="pc-excerpt">{d.summary}</span>
</a>
