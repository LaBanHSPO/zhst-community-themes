---
/** Wordmark: sprig mark, the site title in a serif and the tagline in small tracked capitals. */
interface Props {
	title: string;
	tagline?: string;
	logo?: { url?: string; alt?: string } | null;
	class?: string;
}
const { title, tagline, logo, class: className } = Astro.props;
---

<a class:list={["wordmark", className]} href="/" aria-label={`${title}, home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt || title} />
		) : (
			<>
				<svg class="sprig" width="32" height="52" viewBox="0 0 32 52" aria-hidden="true" focusable="false">
					<g fill="currentColor">
						<path d="M16.6 1.8c4.3 4.1 5.5 10.6 3.4 16.7-4.2-3.3-5.2-10.5-3.4-16.7Z" />
						<path d="M3 5.4c5.2.7 9.3 4.4 11 9.6-5.3-.2-10.4-4.1-11-9.6Z" />
						<path d="M2 17.8c5 .1 9.2 3.1 11.2 7.5-5.2.5-10.3-2.6-11.2-7.5Z" />
						<path d="M30.2 15.8c.6 5.4-2.3 10.6-7.3 12.9-1.1-5.3 1.8-10.9 7.3-12.9Z" />
						<path d="M3.6 29.8c4.6.4 8 3 9.6 6.8-4.6.4-9.3-1.7-9.6-6.8Z" />
						<path d="M24.6 29.7c-.3 4.2-3 7.8-7 9.2-.5-4.2 2-8 7-9.2Z" />
					</g>
					<path d="M15.6 50.5V12.4M15.6 40c-2.8-3.5-6.2-6.1-10.2-7.6M15.6 30c1.7-2.6 4.4-4.8 7.4-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
				</svg>
				<span class="wordmark-text">
					<span class="wordmark-title">{title}</span>
					{tagline && <span class="wordmark-tagline">{tagline}</span>}
				</span>
			</>
		)
	}
</a>
