---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import PostCard from "../../components/PostCard.astro";
import { getJournal } from "../../lib/press";

const result = await getJournal();
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
const posts = result.entries;
---

<Base title="Journal" description="Notes from the press: how books are made, reading lists and thoughts from the editors." current="/journal">
	<PageHead
		id="journal-title"
		eyebrow="Journal"
		title="Notes from the press."
		intro="How books are made, what we are reading and what the editors are thinking about."
	/>
	<section class="section list-section" aria-labelledby="journal-title">
		<div class="wrap">
			{
				posts.length > 0 ? (
					<ul class="post-grid">
						{posts.map((p, i) => <li><PostCard post={p} eager={i < 3} /></li>)}
					</ul>
				) : (
					<p class="empty">The first notes are on their way.</p>
				)
			}
		</div>
	</section>
</Base>
