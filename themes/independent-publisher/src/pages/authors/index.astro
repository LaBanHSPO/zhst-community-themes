---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import SubmitBand from "../../components/SubmitBand.astro";
import { authorHref, getAuthors, getBooks, getPress, initials, slugOf } from "../../lib/press";

const [authorsResult, booksResult, pressResult] = await Promise.all([getAuthors(), getBooks(), getPress()]);
for (const r of [authorsResult, booksResult, pressResult]) if (Astro.cache?.enabled) Astro.cache.set(r.cacheHint);
const authors = authorsResult.entries;
const titlesOf = (slug: string) => booksResult.entries.filter((b) => b.data.author === slug).map((b) => b.data.title);
---

<Base title="Authors" description="The writers published by Cord & Page: novelists, poets and essayists." current="/authors">
	<PageHead
		id="authors-title"
		eyebrow="Authors"
		title="Voices worth the long way round."
		intro="Novelists, poets and essayists published by Cord & Page. All authors are fictional examples."
	/>
	<section class="section list-section" aria-labelledby="authors-title">
		<div class="wrap">
			{
				authors.length > 0 ? (
					<ul class="author-grid author-grid-wide">
						{authors.map((a) => {
							const titles = titlesOf(slugOf(a.data));
							return (
								<li>
									<a class="author-card" href={authorHref(a.data)}>
										<span class="monogram" aria-hidden="true">{initials(a.data.title)}</span>
										<span class="ac-name" {...a.edit.title}>{a.data.title}</span>
										<span class="ac-meta">{titles.join(" / ") || "Forthcoming"}</span>
										<span class="ac-intro">{a.data.intro}</span>
									</a>
								</li>
							);
						})}
					</ul>
				) : (
					<p class="empty">Our authors will be introduced here soon.</p>
				)
			}
		</div>
	</section>
	<SubmitBand press={pressResult.press} />
</Base>
