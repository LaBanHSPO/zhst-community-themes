---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import BookCard from "../components/BookCard.astro";
import PostCard from "../components/PostCard.astro";
import SubmitBand from "../components/SubmitBand.astro";
import { authorHref, getAuthors, getBooks, getJournal, getPress, initials, lines, slugOf } from "../lib/press";

const [booksResult, authorsResult, journalResult, pressResult] = await Promise.all([getBooks(), getAuthors(), getJournal(), getPress()]);
for (const r of [booksResult, authorsResult, journalResult, pressResult]) if (Astro.cache?.enabled) Astro.cache.set(r.cacheHint);

const authorName = new Map(authorsResult.entries.map((a) => [slugOf(a.data), a.data.title]));
const allBooks = booksResult.entries;
const featuredBooks = allBooks.filter((b) => b.data.featured);
const books = (featuredBooks.length > 0 ? featuredBooks : allBooks).slice(0, 3);
const authors = authorsResult.entries.filter((a) => a.data.featured).slice(0, 3);
const posts = journalResult.entries.slice(0, 3);
const aside = lines(pressResult.press.aside);
const bookCount = (slug: string) => allBooks.filter((b) => b.data.author === slug).length;
---

<Base
	title="Independent publisher"
	home
	description="Cord & Page publishes fiction, nonfiction and poetry from independent voices around the globe. Browse the collection, meet the authors and read the journal."
>
	<section class="hero" aria-labelledby="hero-title">
		<img
			class="hero-photo"
			src="/images/hero.webp"
			alt="Three cloth-bound books on a wooden shelf beside a speckled mug and a stone vase of flowers, with leaf shadows on a cream wall"
			width="1448"
			height="554"
			fetchpriority="high"
		/>
		<div class="wrap hero-copy">
			<p class="label hero-eyebrow">Literature for a wider tomorrow</p>
			<h1 id="hero-title" class="hero-title">
				<span>A home for</span>
				<span>curious readers.</span>
			</h1>
			<p class="hero-sub">Thoughtful books. Independent voices.<br />A more interesting world.</p>
			<a class="btn" href="/books"><span>Explore the collection</span><Arrow /></a>
		</div>
	</section>

	<section class="section featured-section" aria-labelledby="featured-title">
		<div class="wrap featured">
			<div class="featured-intro">
				<p class="label">Featured titles</p>
				<h2 id="featured-title" class="display section-title">New perspectives for a wider world.</h2>
				<p class="featured-lede">Fiction, nonfiction and poetry from independent voices around the globe.</p>
				<span class="short-rule" aria-hidden="true"></span>
				<a class="text-link" href="/books"><span>View all books</span><Arrow /></a>
			</div>
			{
				books.length === 0 ? (
					<p class="empty">New titles are on their way.</p>
				) : (
					books.map((b, i) => <BookCard book={b} authorName={authorName.get(b.data.author ?? "") ?? ""} eager={i < 3} />)
				)
			}
			{
				aside.length > 0 && (
					<aside class="aside-caps" aria-hidden="true">
						{aside.map((l) => <span>{l}</span>)}
						<span class="short-rule"></span>
					</aside>
				)
			}
		</div>
	</section>

	{
		authors.length > 0 && (
			<section class="section authors-section" aria-labelledby="authors-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="label">Our authors</p>
							<h2 id="authors-title" class="display section-title">Voices worth the long way round.</h2>
						</div>
						<a class="text-link" href="/authors"><span>Meet the authors</span><Arrow /></a>
					</div>
					<ul class="author-grid">
						{authors.map((a) => (
							<li>
								<a class="author-card" href={authorHref(a.data)}>
									<span class="monogram" aria-hidden="true">{initials(a.data.title)}</span>
									<span class="ac-name" {...a.edit.title}>{a.data.title}</span>
									<span class="ac-meta">{bookCount(slugOf(a.data))} {bookCount(slugOf(a.data)) === 1 ? "title" : "titles"}</span>
									<span class="ac-intro">{a.data.intro}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	{
		posts.length > 0 && (
			<section class="section journal-section" aria-labelledby="journal-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="label">From the journal</p>
							<h2 id="journal-title" class="display section-title">Notes from the press.</h2>
						</div>
						<a class="text-link" href="/journal"><span>Read the journal</span><Arrow /></a>
					</div>
					<ul class="post-grid">
						{posts.map((p) => <li><PostCard post={p} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	<SubmitBand press={pressResult.press} />
</Base>
