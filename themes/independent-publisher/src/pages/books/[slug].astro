---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Cover from "../../components/Cover.astro";
import BookCard from "../../components/BookCard.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { authorHref, genreLabel, getAuthors, getBooks, getPress, paragraphs, photoSrc, slugOf } from "../../lib/press";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: book, cacheHint } = await getEmDashEntry("books", slug);
if (!book) return Astro.rewrite("/404");

const [booksResult, authorsResult, pressResult, settings] = await Promise.all([getBooks(), getAuthors(), getPress(), getSiteSettings()]);
for (const r of [booksResult, authorsResult, pressResult]) if (Astro.cache?.enabled) Astro.cache.set(r.cacheHint);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(book, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const d = book.data;
const author = authorsResult.entries.find((a) => slugOf(a.data) === d.author);
const authorName = new Map(authorsResult.entries.map((a) => [slugOf(a.data), a.data.title]));
const hasBody = Boolean(d.content && d.content.length > 0);
const press = pressResult.press;
const others = [
	...booksResult.entries.filter((b) => b.data.id !== d.id && b.data.genre === d.genre),
	...booksResult.entries.filter((b) => b.data.id !== d.id && b.data.genre !== d.genre),
].slice(0, 4);
const details = [
	["Genre", genreLabel(d.genre)],
	["Published", d.year],
	["Format", d.format],
	["Pages", d.pages ? String(d.pages) : ""],
	["ISBN", d.isbn],
].filter(([, v]) => v);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary}
	canonical={seo.canonical}
	image={seo.ogImage ?? photoSrc(d.image, d.photo)}
	content={{ collection: "books", id: d.id, slug }}
	current="/books"
>
	<div class="wrap book-page">
		<div class="book-media"><Cover book={d} authorName={author?.data.title} eager width={420} /></div>
		<article class="book-info">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/books">Books</a>
				<span aria-hidden="true">/</span>
				<a href={`/books?genre=${d.genre}`}>{genreLabel(d.genre)}</a>
			</nav>
			<h1 class="display" {...book.edit.title}>{d.title}</h1>
			{d.subtitle && <p class="book-sub">{d.subtitle}</p>}
			{
				author && (
					<p class="book-by">
						By <a href={authorHref(author.data)}>{author.data.title}</a>
					</p>
				)
			}
			<p class="book-summary">{d.summary}</p>
			<div class="prose book-prose">
				{paragraphs(d.synopsis).map((p) => <p>{p}</p>)}
				{hasBody && <PortableText value={d.content} />}
			</div>
			<dl class="book-details">
				{details.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
			</dl>
			<div class="book-shop">
				<h2 class="label">Where to find it</h2>
				<p>
					{press.shop_note || "Available from your local bookshop."}
					{" "}
					Bookshops and libraries can write to <a href={`mailto:${press.email}`}>{press.email}</a>.
				</p>
			</div>
			<p class="book-back"><a class="text-link" href="/books"><span>All books</span><Arrow /></a></p>
		</article>
	</div>

	{
		others.length > 0 && (
			<section class="more" aria-labelledby="more-title">
				<div class="wrap">
					<p class="label">Keep reading</p>
					<h2 id="more-title" class="display display-md">More from the list.</h2>
					<ul class="book-grid">
						{others.map((b) => <li><BookCard book={b} authorName={authorName.get(b.data.author ?? "") ?? ""} /></li>)}
					</ul>
				</div>
			</section>
		)
	}
</Base>
