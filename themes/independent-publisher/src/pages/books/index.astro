---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import BookCard from "../../components/BookCard.astro";
import SubmitBand from "../../components/SubmitBand.astro";
import { GENRES, getAuthors, getBooks, getPress, slugOf } from "../../lib/press";

const [booksResult, authorsResult, pressResult] = await Promise.all([getBooks(), getAuthors(), getPress()]);
for (const r of [booksResult, authorsResult, pressResult]) if (Astro.cache?.enabled) Astro.cache.set(r.cacheHint);
const all = booksResult.entries;
const authorName = new Map(authorsResult.entries.map((a) => [slugOf(a.data), a.data.title]));

// One filter link per genre that has at least one book, in a fixed order.
const genres = GENRES.filter((g) => all.some((b) => b.data.genre === g.slug));
const active = genres.find((g) => g.slug === Astro.url.searchParams.get("genre"));
const books = active ? all.filter((b) => b.data.genre === active.slug) : all;
---

<Base
	title={active ? `${active.label} books` : "Books"}
	description="The Cord & Page collection: fiction, nonfiction and poetry from independent voices."
	current="/books"
>
	<PageHead
		id="books-title"
		eyebrow="Books"
		title={active ? `${active.label}, from independent voices.` : "New perspectives for a wider world."}
		intro="Fiction, nonfiction and poetry from independent voices around the globe. Titles, authors and details are fictional examples used to show how the theme looks with content."
	/>

	<section class="section list-section" aria-labelledby="books-title">
		<div class="wrap">
			{
				genres.length > 1 && (
					<nav class="filter" aria-label="Filter by genre">
						<a href="/books" aria-current={active ? undefined : "true"}>All</a>
						{genres.map((g) => (
							<a href={`/books?genre=${g.slug}`} aria-current={active?.slug === g.slug ? "true" : undefined}>{g.label}</a>
						))}
					</nav>
				)
			}
			{
				books.length > 0 ? (
					<ul class="book-grid">
						{books.map((b, i) => (
							<li><BookCard book={b} authorName={authorName.get(b.data.author ?? "") ?? ""} eager={i < 4} /></li>
						))}
					</ul>
				) : (
					<p class="empty">No books in this genre yet.</p>
				)
			}
		</div>
	</section>

	<SubmitBand press={pressResult.press} />
</Base>
