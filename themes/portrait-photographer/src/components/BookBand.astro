---
import Arrow from "./Arrow.astro";
import { telHref } from "../lib/studio";
import type { StudioData } from "../lib/studio";

interface Props {
	studio: StudioData;
}
const { studio } = Astro.props;
---

<section class="book-band" aria-labelledby="book-band-title">
	<div class="wrap book-band-inner">
		<p class="eyebrow">Now booking portraits</p>
		<h2 id="book-band-title" class="display">Let&rsquo;s make something real.</h2>
		<p class="book-band-copy">Tell me who the pictures are for and how you would like to feel in them. I reply personally, usually within two working days.</p>
		<div class="book-band-actions">
			<a class="btn" href="/book"><span>Book a session</span><Arrow /></a>
			<p class="book-band-contact">
				{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}
				{studio.phone && <a href={telHref(studio.phone)}>{studio.phone}</a>}
			</p>
		</div>
	</div>
</section>
