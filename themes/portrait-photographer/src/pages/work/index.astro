---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import BookBand from "../../components/BookBand.astro";
import { getStudio, getWork, photoAlt, photoSrc, slugify, workHref } from "../../lib/studio";

const [workResult, studioResult] = await Promise.all([getWork(), getStudio()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(workResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const all = workResult.entries;

// Category filter: /work?category=<slug>. Rendered on the server, so it works without JavaScript.
const categories = [...new Set(all.map((w) => w.data.category).filter((c): c is string => Boolean(c)))].map((label) => ({
	label,
	slug: slugify(label),
}));
const wanted = Astro.url.searchParams.get("category") ?? "";
const active = categories.find((c) => c.slug === wanted);
const series = active ? all.filter((w) => slugify(w.data.category ?? "") === active.slug) : all;
---

<Base title="Work" description="Portrait series by KELLEN: natural light, studio and on-location work, with the stories behind each set.">
	<PageHead
		id="work-title"
		eyebrow="Work"
		title="People, one sitting at a time."
		intro="Portrait series made in windows, studios and kitchens. Open a series to see the full set."
	/>

	<section class="work" aria-labelledby="work-title">
		{
			categories.length > 1 && (
				<nav class="filter" aria-label="Filter by category">
					<a href="/work" aria-current={active ? undefined : "true"}>All</a>
					{categories.map((c) => (
						<a href={`/work?category=${c.slug}`} aria-current={active?.slug === c.slug ? "true" : undefined}>
							{c.label}
						</a>
					))}
				</nav>
			)
		}
		{
			series.length === 0 ? (
				<p class="empty-note">New series are on their way. In the meantime, say hello.</p>
			) : (
				<ul class="work-grid">
					{series.map((s) => {
						const src = photoSrc(s.data.image, s.data.photo);
						return (
							<li>
								<a class="series-card" href={workHref(s.data)}>
									{src && <img src={src} alt={photoAlt(s.data.image, s.data.photo, s.data.title)} width="600" height="720" loading="lazy" />}
									<span class="series-card-meta">
										<span class="series-card-name" {...s.edit.title}>{s.data.title}</span>
										<span class="series-card-sub">{[s.data.category, s.data.year_label].filter(Boolean).join(" · ")}</span>
									</span>
								</a>
							</li>
						);
					})}
				</ul>
			)
		}
	</section>

	<BookBand studio={studioResult.studio} />
</Base>
