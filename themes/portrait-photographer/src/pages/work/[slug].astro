---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import BookBand from "../../components/BookBand.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getStudio, getWork, photoAlt, photoSrc, workHref } from "../../lib/studio";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: series, cacheHint } = await getEmDashEntry("work", slug);
if (!series) return Astro.rewrite("/404");

const [allResult, studioResult, settings] = await Promise.all([getWork(), getStudio(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(series, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const cover = photoSrc(series.data.image, series.data.photo);
const photos = (series.data.gallery ?? [])
	.map((g) => ({ src: photoSrc(g.image, g.photo), alt: photoAlt(g.image, g.photo, g.caption ?? ""), caption: g.caption }))
	.filter((g): g is { src: string; alt: string; caption: string | undefined } => Boolean(g.src));
const hasBody = Boolean(series.data.content && series.data.content.length > 0);
const others = allResult.entries.filter((s) => s.data.id !== series.data.id).slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? series.data.summary}
	canonical={seo.canonical}
	image={seo.ogImage ?? cover}
	content={{ collection: "work", id: series.data.id, slug }}
	current="/work"
>
	<header class="series-head">
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href="/work">Work</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">{series.data.title}</span>
		</nav>
		<div class="series-head-grid">
			<div class="series-head-copy">
				<p class="eyebrow">{[series.data.category, series.data.year_label].filter(Boolean).join(" · ")}</p>
				<h1 class="display display-xl" {...series.edit.title}>{series.data.title}</h1>
				<p class="lede">{series.data.summary}</p>
			</div>
			{cover && <img class="series-cover" src={cover} alt={photoAlt(series.data.image, series.data.photo, series.data.title)} width="900" height="900" fetchpriority="high" />}
		</div>
	</header>

	{
		hasBody && (
			<section class="series-body">
				<div class="prose">
					<PortableText value={series.data.content} />
				</div>
			</section>
		)
	}

	{
		photos.length > 0 && (
			<section class="series-photos" aria-label={`Photographs from ${series.data.title}`}>
				<ul class="photo-grid">
					{photos.map((p) => (
						<li>
							<figure>
								<img src={p.src} alt={p.alt} width="800" height="1000" loading="lazy" />
								{p.caption && <figcaption>{p.caption}</figcaption>}
							</figure>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		others.length > 0 && (
			<section class="band" aria-labelledby="more-title">
				<div class="band-inner">
					<div class="band-head">
						<div>
							<p class="eyebrow">More work</p>
							<h2 id="more-title" class="display">Keep looking.</h2>
						</div>
						<a class="text-link" href="/work"><span>All work</span><Arrow /></a>
					</div>
					<ul class="series-cards">
						{others.map((s) => {
							const src = photoSrc(s.data.image, s.data.photo);
							return (
								<li>
									<a class="series-card" href={workHref(s.data)}>
										{src && <img src={src} alt={photoAlt(s.data.image, s.data.photo, s.data.title)} width="600" height="720" loading="lazy" />}
										<span class="series-card-meta">
											<span class="series-card-name">{s.data.title}</span>
											<span class="series-card-sub">{[s.data.category, s.data.year_label].filter(Boolean).join(" · ")}</span>
										</span>
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	<BookBand studio={studioResult.studio} />
</Base>
