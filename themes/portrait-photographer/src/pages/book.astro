---
import Base from "../layouts/Base.astro";
import { formatPrice, getSessions, getStudio, telHref } from "../lib/studio";

const [{ studio, cacheHint }, sessionsResult] = await Promise.all([getStudio(), getSessions()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(sessionsResult.cacheHint);
}
const sessions = sessionsResult.entries;

// ?session=<slug> pre-selects a session type (links from the homepage and the session list).
const wanted = Astro.url.searchParams.get("session");
const selected = sessions.find((p) => (p.data.slug ?? p.data.id) === wanted);

// Earliest selectable date is today in the site's timezone.
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Saigon" }).format(new Date());
---

<Base title="Book a session" description="Book a portrait session with KELLEN. Tell me about the pictures you have in mind; I reply personally, usually within two working days.">
	<div class="book">
		<div class="book-photo">
			<img
				src="/images/woman-window.webp"
				alt="Close portrait of a freckled woman resting her chin on her hand in soft window light"
				width="1200"
				height="1200"
			/>
		</div>
		<section class="book-panel" aria-labelledby="book-title">
			<p class="eyebrow">Book a session</p>
			<h1 id="book-title" class="display display-xl">Tell me about your portrait.</h1>
			<p class="lede">
				Tell me who the pictures are for, when you would like to sit and where. A request is not a booking until I have replied and we have agreed the details.
			</p>

			<form
				class="book-form"
				data-book-form
				data-email={studio.email}
				action={studio.email ? `mailto:${studio.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field full">
						<label for="q-name">Your name</label>
						<input id="q-name" name="name" type="text" autocomplete="name" placeholder="e.g. Noor Haddad" required />
						<span class="field-error" data-error-for="q-name"></span>
					</div>
					<div class="field">
						<label for="q-email">Email</label>
						<input id="q-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="q-email"></span>
					</div>
					<div class="field">
						<label for="q-phone">Phone <span class="optional">(optional)</span></label>
						<input id="q-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field">
						<label for="q-date">Preferred date</label>
						<input id="q-date" name="date" type="date" min={today} required />
						<span class="field-error" data-error-for="q-date"></span>
					</div>
					<div class="field">
						<label for="q-venue">Location</label>
						<input id="q-venue" name="venue" type="text" placeholder="Studio, your home, or a place you love" required />
						<span class="field-error" data-error-for="q-venue"></span>
					</div>
					<div class="field full">
						<label for="q-session">Session type</label>
						<select id="q-session" name="session" required>
							<option value="" selected={!selected}>Choose a session</option>
							{
								sessions.map((p) => {
									const label = [p.data.title, p.data.duration, `from ${formatPrice(p.data.price)}`].filter(Boolean).join(" · ");
									return <option value={p.data.title} selected={selected?.data.id === p.data.id}>{label}</option>;
								})
							}
							<option value="Not sure yet">Not sure yet, please advise</option>
						</select>
						<span class="field-error" data-error-for="q-session"></span>
					</div>
					<div class="field full">
						<label for="q-notes">Tell me about the pictures <span class="optional">(optional)</span></label>
						<textarea id="q-notes" name="notes" rows="4" placeholder="Who is in the pictures, what they are for, how you would like to feel in them…"></textarea>
					</div>
				</div>
				<button class="btn btn-block" type="submit"><span>Send booking request</span></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{studio.email && <>Write to <a href={`mailto:${studio.email}`}>{studio.email}</a> with your name, date and the session you would like.</>}
					</noscript>
				</p>
			</form>

			<div class="book-contact">
				<h2>Prefer to write or call?</h2>
				<p>
					{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}
					{studio.phone && <a href={telHref(studio.phone)}>{studio.phone}</a>}
				</p>
				{studio.response && <p class="small">{studio.response}</p>}
				{studio.inquiry_note && <p class="small">{studio.inquiry_note}</p>}
			</div>
		</section>
	</div>
</Base>

<script>
	// Compose a booking email; the studio replies to it. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-book-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input[required], select[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: input.getAttribute("type") === "date"
								? "Please choose today or a later date."
								: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online requests are not available right now. Please call.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Portrait session request: ${get("name")} on ${get("date")}`;
			const lines = [
				"Hello,",
				"",
				"I would like to book a portrait session:",
				`Name: ${get("name")}`,
				`Preferred date: ${get("date")}`,
				`Location: ${get("venue")}`,
				`Session type: ${get("session")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("notes") ? `About the pictures: ${get("notes")}` : "",
				"",
				"I understand the date is only held once you have replied and we have agreed the details.",
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this request ready to send. It is only sent when you send that email, and I reply personally. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
