---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import BookBand from "../../components/BookBand.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getJournal, getStudio, journalHref, photoAlt, photoSrc } from "../../lib/studio";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: post, cacheHint } = await getEmDashEntry("journal", slug);
if (!post) return Astro.rewrite("/404");

const [allResult, studioResult, settings] = await Promise.all([getJournal(), getStudio(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const cover = photoSrc(post.data.image, post.data.photo);
const hasBody = Boolean(post.data.content && post.data.content.length > 0);
const others = allResult.entries.filter((p) => p.data.id !== post.data.id).slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? post.data.excerpt}
	canonical={seo.canonical}
	image={seo.ogImage ?? cover}
	content={{ collection: "journal", id: post.data.id, slug }}
	current="/journal"
>
	<header class="post-head">
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href="/journal">Journal</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">{post.data.title}</span>
		</nav>
		<p class="eyebrow">{post.data.date_label}</p>
		<h1 class="display display-xl" {...post.edit.title}>{post.data.title}</h1>
		<p class="lede">{post.data.excerpt}</p>
	</header>

	{cover && <img class="post-cover" src={cover} alt={photoAlt(post.data.image, post.data.photo, post.data.title)} width="1200" height="640" fetchpriority="high" />}

	{
		hasBody && (
			<section class="post-body">
				<div class="prose">
					<PortableText value={post.data.content} />
				</div>
			</section>
		)
	}

	{
		others.length > 0 && (
			<section class="band" aria-labelledby="more-title">
				<div class="band-inner">
					<div class="band-head">
						<div>
							<p class="eyebrow">More notes</p>
							<h2 id="more-title" class="display">Keep reading.</h2>
						</div>
						<a class="text-link" href="/journal"><span>All posts</span><Arrow /></a>
					</div>
					<ul class="post-cards">
						{others.map((p) => {
							const src = photoSrc(p.data.image, p.data.photo);
							return (
								<li>
									<a class="post-card" href={journalHref(p.data)}>
										{src && <img src={src} alt={photoAlt(p.data.image, p.data.photo, p.data.title)} width="600" height="440" loading="lazy" />}
										<span class="post-card-date">{p.data.date_label}</span>
										<span class="post-card-name">{p.data.title}</span>
										<span class="post-card-excerpt">{p.data.excerpt}</span>
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	<BookBand studio={studioResult.studio} />
</Base>
