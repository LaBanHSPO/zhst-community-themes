---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import BookBand from "../../components/BookBand.astro";
import { getJournal, getStudio, journalHref, photoAlt, photoSrc } from "../../lib/studio";

const [journalResult, studioResult] = await Promise.all([getJournal(), getStudio()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(journalResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const posts = journalResult.entries;
---

<Base title="Journal" description="Notes from the KELLEN studio on light, conversation and making portraits.">
	<PageHead
		id="journal-title"
		eyebrow="Journal"
		title="Notes from the studio."
		intro="Short essays on light, conversation and what makes a portrait feel true."
	/>

	<section class="journal" aria-labelledby="journal-title">
		{
			posts.length === 0 ? (
				<p class="empty-note">The first notes are on their way.</p>
			) : (
				<ul class="post-cards post-grid">
					{posts.map((p) => {
						const src = photoSrc(p.data.image, p.data.photo);
						return (
							<li>
								<a class="post-card" href={journalHref(p.data)}>
									{src && <img src={src} alt={photoAlt(p.data.image, p.data.photo, p.data.title)} width="600" height="440" loading="lazy" />}
									<span class="post-card-date">{p.data.date_label}</span>
									<span class="post-card-name" {...p.edit.title}>{p.data.title}</span>
									<span class="post-card-excerpt">{p.data.excerpt}</span>
								</a>
							</li>
						);
					})}
				</ul>
			)
		}
	</section>

	<BookBand studio={studioResult.studio} />
</Base>
