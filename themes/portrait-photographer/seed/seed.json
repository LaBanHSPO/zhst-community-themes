          "title": "Same Room, Different Day",
          "category": "Studio",
          "year_label": "Winter 2025",
          "summary": "One studio, one chair and four sitters over four very different afternoons.",
          "featured": false,
          "position": 50,
          "photo": "/images/woman-bw.webp",
          "gallery": [
            {
              "photo": "/images/woman-bw.webp",
              "caption": "Noor, on a grey Monday."
            },
            {
              "photo": "/images/redhead.webp",
              "caption": "Imogen, on a bright Thursday."
            },
            {
              "photo": "/images/man-bw.webp",
              "caption": "Jonah, on a very cold Saturday."
            },
            {
              "photo": "/images/grey-hair.webp",
              "caption": "Teodor, on a quiet Sunday."
            },
            {
              "photo": "/images/hand-detail.webp",
              "caption": "Noor's hands, between frames."
