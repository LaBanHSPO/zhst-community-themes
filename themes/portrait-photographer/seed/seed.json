          "featured": false,
          "position": 40,
          "photo": "/images/grey-hair.webp",
          "gallery": [
            {
              "photo": "/images/grey-hair.webp",
              "caption": "Teodor, after a day in the workshop."
            },
            {
              "photo": "/images/man-bw.webp",
              "caption": "Jonah, on the walk home."
            },
            {
              "photo": "/images/woman-bw.webp",
