    ],
    "journal": [
      {
        "id": "why-i-shoot-by-one-window",
        "slug": "why-i-shoot-by-one-window",
        "status": "published",
        "data": {
          "title": "Why I shoot by one window",
          "date_label": "12 September 2026",
          "excerpt": "On limiting the light, and what a single north-facing window teaches a portrait photographer.",
          "featured": true,
          "position": 1,
          "photo": "/images/hero-home.webp",
          "content": [
            {
              "_type": "block",
              "_key": "k22",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "I used to arrive at sessions with three lights and a bag of modifiers. These days I arrive with a camera and a chair. One window gives me everything I need: a direction, a shape and a mood that changes by the minute.",
                  "_key": "k22s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k23",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "It also changes how sitters behave. Without a flash popping, there is nothing to brace against. People settle, and the picture appears in the settling.",
                  "_key": "k23s"
                }
              ],
              "markDefs": []
            }
          ]
        }
      },
      {
        "id": "a-conversation-before-the-camera",
        "slug": "a-conversation-before-the-camera",
        "status": "published",
        "data": {
          "title": "A conversation before the camera",
          "date_label": "28 August 2026",
          "excerpt": "Why every session starts with tea and a few unhurried questions.",
          "featured": true,
          "position": 2,
          "photo": "/images/hand-detail.webp",
          "content": [
            {
              "_type": "block",
              "_key": "k24",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "The first twenty minutes of a session are usually the most important, and I rarely take a photograph in them. We talk about the work, the weekend, the last time you liked a picture of yourself.",
                  "_key": "k24s"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k25",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "By the time the camera comes up, you have stopped waiting for the moment to start.",
                  "_key": "k25s"
                }
              ],
