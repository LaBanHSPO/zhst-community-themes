---
/** Terracotta leaf-sprig mark: an approximation of the design's logo glyph. */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={["sprig", className]} width="42" height="46" viewBox="0 0 42 46" aria-hidden="true" focusable="false">
	<path d="M40 44.500C35 39 30 34 27 29" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
	<g fill="currentColor">
		<path d="M0 0C5-8 16-8 24 0C16 8 5 8 0 0Z" transform="translate(31.500 34.500) rotate(172) scale(0.9 0.82)" />
		<path d="M0 0C5-8 16-8 24 0C16 8 5 8 0 0Z" transform="translate(28.500 31) rotate(-148) scale(0.82 0.75)" />
		<path d="M0 0C5-8 16-8 24 0C16 8 5 8 0 0Z" transform="translate(27 28.500) rotate(-76) scale(1 0.62)" />
		<path d="M0 0C5-8 16-8 24 0C16 8 5 8 0 0Z" transform="translate(33 37) rotate(-30) scale(0.5 0.5)" />
	</g>
</svg>
