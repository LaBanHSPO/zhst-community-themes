---
import Arrow from "./Arrow.astro";
import { telHref } from "../lib/studio";
import type { StudioData } from "../lib/studio";

interface Props {
	studio: StudioData;
}
const { studio } = Astro.props;
---

<section class="inquiry-band" aria-labelledby="inquiry-band-title">
	<img class="inquiry-band-photo" src="/images/peony-table.webp" alt="" width="1448" height="1086" loading="lazy" />
	<div class="inquiry-band-inner">
		<p class="eyebrow eyebrow-light">Now planning</p>
		<h2 id="inquiry-band-title" class="display display-light">Make the moment <em>yours.</em></h2>
		<p class="inquiry-band-copy">Share the occasion, the date and the feeling you are after, and we will reply personally, usually within two working days.</p>
		<div class="inquiry-band-actions">
			<a class="btn btn-light" href="/contact"><span>Create your event</span><Arrow /></a>
			<p class="inquiry-band-contact">
				{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}
				{studio.phone && <a href={telHref(studio.phone)}>{studio.phone}</a>}
			</p>
		</div>
	</div>
</section>
