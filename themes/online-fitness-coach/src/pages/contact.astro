---
import Base from "../layouts/Base.astro";
import { EQUIPMENT, getCoach, getPrograms, labelRows, levelLabel, telHref } from "../lib/fitness";

const [{ coach, cacheHint }, programsResult] = await Promise.all([getCoach(), getPrograms()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(programsResult.cacheHint);
}
const hours = labelRows(coach.hours);
const programs = programsResult.entries;

// ?program=<slug> pre-selects a program; ?equipment=<none|dumbbells|gym> pre-selects the kit you have.
const q = Astro.url.searchParams;
const selected = programs.find((p) => (p.data.slug ?? p.data.id) === q.get("program"));
const wantedKit = EQUIPMENT.find((e) => e.slug === q.get("equipment"))?.slug ?? selected?.data.equipment ?? "";
const kitOptions = [
	...EQUIPMENT.map((e) => ({ slug: e.slug as string, value: e.slug === "none" ? "No equipment, just a mat or towel" : e.slug === "dumbbells" ? "A pair of dumbbells or more" : "Access to a gym" })),
	{ slug: "mix", value: "A mix, I will explain" },
];
---

<Base title="Start with a free call" description="Ask for a free 20 minute call. Choose a program, tell me your goals and the equipment you have, and I reply within one working day.">
	<div class="book">
		<div class="book-photo">
			<img src="/images/coach-reach.webp" alt="The coach kneeling on a mat in a bright living room, smiling and reaching a hand towards the camera" width="1448" height="1086" />
		</div>
		<section class="book-panel" aria-labelledby="book-title">
			<p class="eyebrow">Contact</p>
			<h1 id="book-title" class="display">Start with a free call.</h1>
			<p class="lede">
				Tell me a little about you and I will reply within one working day to book a 20 minute call. You do not have to pick a program yet.
			</p>

			<form
				class="book-form"
				data-book-form
				data-email={coach.email}
				action={coach.email ? `mailto:${coach.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field full">
						<label for="b-program">Program</label>
						<select id="b-program" name="program" required>
							<option value="" selected={!selected}>Choose a program</option>
							{
								EQUIPMENT.map((e) => {
									const items = programs.filter((p) => p.data.equipment === e.slug);
									return (
										items.length > 0 && (
											<optgroup label={e.label}>
												{items.map((p) => (
													<option value={p.data.title} selected={selected?.data.id === p.data.id}>
														{[p.data.title, levelLabel(p.data.level), p.data.weeks ? `${p.data.weeks} weeks` : ""].filter(Boolean).join(" / ")}
													</option>
												))}
											</optgroup>
										)
									);
								})
							}
							<option value="Not sure yet">Not sure yet, please advise</option>
						</select>
						<span class="field-error" id="b-program-err" data-error-for="b-program"></span>
					</div>
					<div class="field full">
						<label for="b-goals">Your goals</label>
						<textarea id="b-goals" name="goals" rows="4" required placeholder="For example: build a routine, get stronger, feel less stiff at my desk."></textarea>
						<span class="field-error" id="b-goals-err" data-error-for="b-goals"></span>
					</div>
					<div class="field">
						<label for="b-kit">Equipment you have</label>
						<select id="b-kit" name="equipment" required>
							<option value="" selected={!wantedKit}>Choose one</option>
							{kitOptions.map((k) => <option value={k.value} selected={k.slug === wantedKit}>{k.value}</option>)}
						</select>
						<span class="field-error" id="b-kit-err" data-error-for="b-kit"></span>
					</div>
					<div class="field">
						<label for="b-days">Workouts a week you can fit in</label>
						<select id="b-days" name="days" required>
							<option value="" selected>Choose one</option>
							<option value="2 a week">2 a week</option>
							<option value="3 a week">3 a week</option>
							<option value="4 a week">4 a week</option>
							<option value="Not sure">Not sure yet</option>
						</select>
						<span class="field-error" id="b-days-err" data-error-for="b-days"></span>
					</div>
					<div class="field">
						<label for="b-name">Name</label>
						<input id="b-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" id="b-name-err" data-error-for="b-name"></span>
					</div>
					<div class="field">
						<label for="b-email">Email</label>
						<input id="b-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" id="b-email-err" data-error-for="b-email"></span>
					</div>
					<div class="field full">
						<label for="b-phone">Phone <span class="optional">(optional)</span></label>
						<input id="b-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field full">
						<label for="b-health">Injuries or health conditions <span class="optional">(optional)</span></label>
						<textarea id="b-health" name="health" rows="3" placeholder="Anything I should know before I plan your workouts."></textarea>
					</div>
					<p class="health-note full">
						If you have an injury, are pregnant or have a health condition, please check with your doctor before you start training. You do not have to share details here.
					</p>
				</div>
				<button class="btn btn-lg btn-block" type="submit">Ask for a free call</button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{coach.email && <>Write to <a href={`mailto:${coach.email}`}>{coach.email}</a> with your program, goals and the equipment you have.</>}
					</noscript>
				</p>
			</form>

			<div class="book-contact">
				<h2>Prefer to write or call?</h2>
				<p>
					{coach.email && <>Email <a href={`mailto:${coach.email}`}>{coach.email}</a></>}
					{coach.phone && coach.email && " or call "}
					{coach.phone && !coach.email && "Call "}
					{coach.phone && <a href={telHref(coach.phone)}>{coach.phone}</a>}.
				</p>
				{coach.place && <p>{coach.place}.</p>}
				{
					hours.length > 0 && (
						<dl class="book-hours">
							{hours.map((h) => (
								<>
									<dt>{h.label}</dt>
									<dd>{h.text}</dd>
								</>
							))}
						</dl>
					)
				}
				{coach.booking_note && <p class="small">{coach.booking_note}</p>}
			</div>
		</section>
	</div>
</Base>

<script>
	// Compose a request email; the coach replies to book the call. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-book-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input[required], select[required], textarea[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online requests are not available right now. Please call instead.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Free call request: ${get("program")}`;
			const lines = [
				"Hello,",
				"",
				"I would like to book a free call:",
				`Program: ${get("program")}`,
				`Goals: ${get("goals")}`,
				`Equipment: ${get("equipment")}`,
				`Workouts a week: ${get("days")}`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("health") ? `Injuries or health conditions: ${get("health")}` : "",
				"",
				"I understand the call is booked only once you reply.",
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this request ready to send. It is only sent when you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
