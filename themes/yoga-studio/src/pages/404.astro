---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<div class="wrap notfound-inner">
			<div>
				<p class="eyebrow">Error 404</p>
				<h1 id="nf-title" class="display">This page has <em>gone for a walk.</em></h1>
				<p class="lede">The page you are looking for has moved or never existed. These are good places to begin again.</p>
				<div class="actions">
					<a class="btn" href="/">Back to home <Arrow /></a>
					<a class="btn btn-outline" href="/classes">Classes</a>
					<a class="btn btn-outline" href="/schedule">Timetable</a>
				</div>
			</div>
			<img class="notfound-photo" src="/images/olive-vase.webp" alt="" width="400" height="860" />
		</div>
	</section>
</Base>
