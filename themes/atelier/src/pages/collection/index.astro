---
import { getEmDashCollection, getTaxonomyTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import CatalogListing from "../../components/CatalogListing.astro";
import { bySortOrder } from "../../lib/catalog";

const [{ entries: products, cacheHint }, terms] = await Promise.all([
	getEmDashCollection("products", { limit: 100 }),
	getTaxonomyTerms("collection"),
]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const sorted = [...products].sort(bySortOrder);
---

<Base
	title="Collection"
	description="Handmade ceramics and homeware, made in small batches. Browse every piece in the collection."
>
	<CatalogListing
		eyebrow="The collection"
		title="Collection"
		description="Every piece is made by hand in small batches. Choose a piece to see its material notes, care guide and where to buy it."
		terms={terms}
		products={sorted}
	/>
</Base>
