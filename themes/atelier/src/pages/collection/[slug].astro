---
import { decodeSlug, getEmDashCollection, getTaxonomyTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import CatalogListing from "../../components/CatalogListing.astro";
import { bySortOrder } from "../../lib/catalog";

const slug = decodeSlug(Astro.params.slug);
const terms = await getTaxonomyTerms("collection");
const term = slug ? terms.find((item) => item.slug === slug) : undefined;

if (!term) {
	return Astro.rewrite("/404");
}

const { entries: products, cacheHint } = await getEmDashCollection("products", {
	where: { collection: term.slug },
	limit: 100,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const sorted = [...products].sort(bySortOrder);
---

<Base
	title={`${term.label} — Collection`}
	description={term.description ?? `Handmade pieces in the ${term.label} collection.`}
>
	<CatalogListing
		eyebrow="Collection"
		title={term.label}
		description={term.description}
		terms={terms}
		activeSlug={term.slug}
		products={sorted}
	/>
</Base>
