---
import {
	decodeSlug,
	getEmDashCollection,
	getEmDashEntry,
	getEntryTerms,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import InquiryPanel from "../../components/InquiryPanel.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { bySortOrder, getStudio, safeExternalUrl, validImages } from "../../lib/catalog";

const slug = decodeSlug(Astro.params.slug);
if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: product, cacheHint } = await getEmDashEntry("products", slug);
if (!product) {
	return Astro.rewrite("/404");
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const [terms, { studio }, settings] = await Promise.all([
	getEntryTerms("products", product.data.id, "collection"),
	getStudio(),
	getSiteSettings(),
]);
const { siteTitle } = resolveStarterSiteIdentity(settings);

const gallery = validImages(product.data.images);
const purchaseUrl = safeExternalUrl(product.data.purchase_url);
const hasStory = Array.isArray(product.data.story) && product.data.story.length > 0;

const details = [
	{ label: "Material", value: product.data.material },
	{ label: "Care", value: product.data.care },
	{ label: "Dimensions", value: product.data.dimensions },
	{ label: "Made by", value: product.data.maker },
].filter((item): item is { label: string; value: string } =>
	typeof item.value === "string" && item.value.trim().length > 0,
);

let related: typeof product[] = [];
if (terms.length > 0) {
	const { entries } = await getEmDashCollection("products", {
		where: { collection: terms.map((term) => term.slug) },
		limit: 12,
	});
	related = entries
		.filter((entry) => entry.data.id !== product.data.id)
		.sort(bySortOrder)
		.slice(0, 3);
}

const seo = getSeoMeta(product, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const shareImage = gallery[0]?.image?.src
	? new URL(gallery[0].image.src, Astro.url.origin).toString()
	: null;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? product.data.summary}
	canonical={seo.canonical}
	image={shareImage}
	content={{ collection: "products", id: product.data.id, slug }}
>
	<nav class="breadcrumb wrap" aria-label="Breadcrumb">
		<ol>
			<li><a href="/collection">Collection</a></li>
			{
				terms[0] && (
					<li><a href={`/collection/${terms[0].slug}`}>{terms[0].label}</a></li>
				)
			}
			<li aria-current="page">{product.data.title}</li>
		</ol>
	</nav>

	<article class="product wrap">
		<div class="product__gallery" {...product.edit.images}>
			{
				gallery.length === 0 ? (
					<div class="product__placeholder" aria-hidden="true">
						<span>{product.data.title.charAt(0)}</span>
					</div>
				) : (
					gallery.map((item, index) => (
						<figure class:list={["product__figure", index === 0 && "product__figure--lead"]}>
							<div class="product__frame">
								{item.image && <Image image={item.image} priority={index === 0} />}
							</div>
							{item.caption && <figcaption>{item.caption}</figcaption>}
						</figure>
					))
				)
			}
		</div>

		<div class="product__info">
			{
				terms.length > 0 && (
					<p class="label product__terms">
						{terms.map((term, i) => (
							<>
								{i > 0 && <span aria-hidden="true"> · </span>}
								<a href={`/collection/${term.slug}`}>{term.label}</a>
							</>
						))}
					</p>
				)
			}
			<h1 class="product__title" {...product.edit.title}>{product.data.title}</h1>
			{product.data.price && <p class="product__price" {...product.edit.price}>{product.data.price}</p>}
			{product.data.summary && <p class="product__summary" {...product.edit.summary}>{product.data.summary}</p>}

			<div class="product__actions">
				{
					purchaseUrl && (
						<a class="button" href={purchaseUrl} target="_blank" rel="noopener noreferrer external">
							Buy from our partner shop
							<span aria-hidden="true">&nearr;</span>
							<span class="visually-hidden">(opens in a new tab)</span>
						</a>
					)
				}
				<a class:list={["button", purchaseUrl && "button--ghost"]} href="#inquiry">Ask about this piece</a>
			</div>
			{
				!purchaseUrl && (
					<p class="product__note">This piece is available by inquiry. Send us a note and we will reply with availability.</p>
				)
			}

			{
				details.length > 0 && (
					<dl class="product__details">
						{details.map((item) => (
							<div>
								<dt class="label">{item.label}</dt>
								<dd>{item.value}</dd>
							</div>
						))}
					</dl>
				)
			}

			{
				hasStory && (
					<section class="product__story prose" aria-labelledby="story-heading">
						<h2 id="story-heading">The story</h2>
						<div {...product.edit.story}>
							<PortableText value={product.data.story} />
						</div>
					</section>
				)
			}
		</div>
	</article>

	{
		related.length > 0 && (
			<section class="related wrap" aria-labelledby="related-title">
				<div class="related__head">
					<h2 id="related-title">From the same collection</h2>
				</div>
				<ul class="related__grid">
					{related.map((item) => (
						<li>
							<ProductCard
								slug={item.id}
								title={item.data.title}
								price={item.data.price}
								images={item.data.images}
							/>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<div class="wrap inquiry-wrap">
		<InquiryPanel
			studio={studio}
			heading="Ask about this piece"
			product={product.data.title}
			intro={studio.purchaseNote || null}
		/>
	</div>
</Base>

<style>
	.breadcrumb ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 1.5rem 0 0;
		font-family: var(--font-label);
		font-size: 0.6875rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.breadcrumb li + li::before {
		content: "/";
		margin-right: 0.5rem;
	}

	.breadcrumb a {
		text-decoration: none;
	}

	.breadcrumb a:hover {
		text-decoration: underline;
	}

	.product {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 6rem);
		padding-top: var(--space-4);
		align-items: start;
	}

	.product__gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.product__figure {
		margin: 0;
	}

	.product__figure--lead,
	.product__figure:nth-child(2):last-child {
		grid-column: 1 / -1;
	}

	.product__frame {
		background: #efebe4;
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.product__figure--lead .product__frame {
		aspect-ratio: 5 / 4;
	}

	.product__frame :global(figure),
	.product__frame :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		margin: 0;
		object-fit: cover;
	}

	.product__figure figcaption {
		font-size: 0.9375rem;
		color: var(--color-muted);
		margin-top: 0.6rem;
	}

	.product__placeholder {
		aspect-ratio: 5 / 4;
		background: #efebe4;
		display: grid;
		place-items: center;
		font-family: var(--font-display);
		font-size: 6rem;
		color: var(--color-line);
	}

	.product__info {
		position: sticky;
		top: 2rem;
	}

	.product__terms a {
		text-decoration: none;
	}

	.product__terms a:hover {
		text-decoration: underline;
	}

	.product__title {
		font-size: clamp(2.75rem, 5vw, 4.25rem);
		margin: 0.75rem 0 0.75rem;
	}

	.product__price {
		font-family: var(--font-label);
		letter-spacing: 0.14em;
		font-size: 1rem;
		color: var(--color-muted);
	}

	.product__summary {
		font-size: 1.25rem;
	}

	.product__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.75rem 0 1rem;
	}

	.product__note {
		color: var(--color-muted);
		font-size: 1rem;
	}

	.product__details {
		margin: 2rem 0 0;
		border-top: 1px solid var(--color-line);
	}

	.product__details > div {
		display: grid;
		grid-template-columns: 8rem 1fr;
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--color-line);
	}

	.product__details dt {
		padding-top: 0.25rem;
	}

	.product__details dd {
		margin: 0;
		font-size: 1.0625rem;
	}

	.product__story {
		margin-top: var(--space-4);
	}

	.related {
		padding-top: var(--space-6);
	}

	.related__head h2 {
		font-size: clamp(2rem, 3.5vw, 2.6rem);
		margin-bottom: 1.5rem;
	}

	.related__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2.5vw, 2.25rem);
	}

	.inquiry-wrap {
		padding-top: var(--space-6);
	}

	@media (max-width: 56rem) {
		.product {
			grid-template-columns: 1fr;
		}

		.product__info {
			position: static;
		}

		.product__details > div {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}

		.related__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 36rem) {
		.product__gallery,
		.related__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
