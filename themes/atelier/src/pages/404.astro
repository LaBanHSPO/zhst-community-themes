---
import Base from "../layouts/Base.astro";

Astro.response.status = 404;
---

<Base title="Page not found">
	<section class="not-found wrap" aria-labelledby="not-found-title">
		<p class="label label-rule">404</p>
		<h1 id="not-found-title">This piece isn’t on the shelf</h1>
		<p>The page you were looking for has moved or no longer exists.</p>
		<div class="not-found__actions">
			<a class="button" href="/collection">Browse the collection</a>
			<a class="button button--ghost" href="/">Return home</a>
		</div>
	</section>
</Base>

<style>
	.not-found {
		padding-block: var(--space-6) var(--space-4);
	}

	.not-found > * {
		max-width: 48rem;
	}

	.not-found h1 {
		font-size: clamp(2.75rem, 6vw, 4.5rem);
		margin: 1rem 0;
	}

	.not-found p:not(.label) {
		color: var(--color-muted);
	}

	.not-found__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
</style>
