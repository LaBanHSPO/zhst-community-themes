---
import type { TaxonomyTerm } from "emdash";
import ProductCard from "./ProductCard.astro";
import type { GalleryItem } from "../lib/catalog";

interface ProductSummary {
	id: string;
	data: { title: string; price?: string | null; images?: GalleryItem[] | null; summary?: string | null };
}

interface Props {
	eyebrow: string;
	title: string;
	description?: string | null;
	terms: TaxonomyTerm[];
	activeSlug?: string | null;
	products: ProductSummary[];
}

const { eyebrow, title, description, terms, activeSlug, products } = Astro.props;
---

<section class="catalog wrap" aria-labelledby="catalog-title">
	<header class="catalog__head">
		<p class="label label-rule">{eyebrow}</p>
		<h1 id="catalog-title">{title}</h1>
		{description && <p class="catalog__desc">{description}</p>}
	</header>

	{
		terms.length > 0 && (
			<nav class="filters" aria-label="Collections">
				<ul>
					<li>
						<a href="/collection" aria-current={!activeSlug ? "page" : undefined}>
							All pieces
						</a>
					</li>
					{terms.map((term) => (
						<li>
							<a
								href={`/collection/${term.slug}`}
								aria-current={activeSlug === term.slug ? "page" : undefined}
							>
								{term.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}

	{
		products.length === 0 ? (
			<div class="catalog__empty">
				<p>No pieces in this collection yet. New work is added after each firing.</p>
				<a class="button button--ghost" href="/contact">Ask about upcoming pieces</a>
			</div>
		) : (
			<ul class="catalog__grid">
				{products.map((product, index) => (
					<li>
						<ProductCard
							slug={product.id}
							title={product.data.title}
							price={product.data.price}
							images={product.data.images}
							headingLevel="h2"
							priority={index < 3}
						/>
						{product.data.summary && <p class="catalog__summary">{product.data.summary}</p>}
					</li>
				))}
			</ul>
		)
	}

</section>

<style>
	.catalog {
		padding-top: var(--space-5);
	}

	.catalog__head {
		max-width: 44rem;
		margin-bottom: var(--space-4);
	}

	.catalog__head h1 {
		font-size: clamp(3rem, 7vw, 5rem);
		margin: 1rem 0;
	}

	.catalog__desc {
		color: var(--color-muted);
		font-size: 1.25rem;
	}

	.filters {
		border-block: 1px solid var(--color-line);
		margin-bottom: var(--space-4);
	}

	.filters ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 2rem;
		list-style: none;
		margin: 0;
		padding: 0.9rem 0;
	}

	.filters a {
		font-family: var(--font-label);
		font-size: 0.75rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-muted);
		display: inline-block;
		padding: 0.45rem 0;
		border-bottom: 1px solid transparent;
	}

	.filters a:hover,
	.filters a[aria-current="page"] {
		color: var(--color-ink);
		border-bottom-color: currentColor;
	}

	.catalog__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-5) clamp(1rem, 2.5vw, 2.25rem);
	}

	.catalog__summary {
		color: var(--color-muted);
		font-size: 1rem;
		margin: 0.6rem 0 0;
		max-width: 26rem;
	}

	.catalog__empty {
		padding: var(--space-4) 0;
		color: var(--color-muted);
	}


	@media (max-width: 56rem) {
		.catalog__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 36rem) {
		.catalog__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
