---
import { Image } from "emdash/ui";
import { coverImage, type GalleryItem } from "../lib/catalog";

interface Props {
	slug: string;
	title: string;
	price?: string | null;
	images?: GalleryItem[] | null;
	headingLevel?: "h2" | "h3";
	priority?: boolean;
}

const { slug, title, price, images, headingLevel = "h3", priority = false } = Astro.props;
const cover = coverImage(images);
const Heading = headingLevel;
---

<article class="product-card">
	<a class="product-card__link" href={`/products/${slug}`}>
		<div class="product-card__media">
			{
				cover?.image ? (
					<Image image={cover.image} priority={priority} />
				) : (
					<span class="product-card__placeholder" aria-hidden="true">{title.charAt(0)}</span>
				)
			}
		</div>
		<Heading class="product-card__title">{title}</Heading>
	</a>
	{price && <p class="product-card__price">{price}</p>}
</article>

<style>
	.product-card {
		display: flex;
		flex-direction: column;
	}

	.product-card__link {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
	}

	.product-card__media {
		aspect-ratio: 2 / 1;
		background: #efebe4;
		overflow: hidden;
		display: grid;
		place-items: center;
	}

	.product-card__media :global(img),
	.product-card__media :global(figure) {
		width: 100%;
		height: 100%;
		margin: 0;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.product-card__link:hover :global(img) {
		transform: scale(1.03);
	}

	.product-card__placeholder {
		font-family: var(--font-display);
		font-size: 4rem;
		color: var(--color-line);
	}

	.product-card__title {
		font-family: var(--font-body);
		font-size: 1.1875rem;
		letter-spacing: 0;
		margin-top: 1rem;
	}

	.product-card__link:hover .product-card__title {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.product-card__price {
		font-family: var(--font-label);
		font-size: 0.8125rem;
		letter-spacing: 0.14em;
		color: var(--color-muted);
		margin: 0.2rem 0 0;
	}
</style>
