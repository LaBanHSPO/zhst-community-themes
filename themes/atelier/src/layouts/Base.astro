---
import "@fontsource/cormorant-garamond/latin-400.css";
import "@fontsource/cormorant-garamond/latin-500.css";
import "@fontsource/cormorant-garamond/latin-400-italic.css";
import "@fontsource/eb-garamond/latin-400.css";
import "@fontsource/eb-garamond/latin-500.css";
import "@fontsource/jost/latin-400.css";
import "@fontsource/jost/latin-500.css";
import "../styles/theme.css";

import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getStudio, telHref } from "../lib/catalog";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Render the header over a full-bleed hero (home page). */
	overlay?: boolean;
}

const { title, pageTitle, description, image, canonical, content, overlay = false } =
	Astro.props;
const [settingsResult, menuResult, studioResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getStudio(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const { studio } = studioResult;
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const fallbackMenu = [
	{ label: "Collection", url: "/collection", target: undefined },
	{ label: "Our story", url: "/our-story", target: undefined },
	{ label: "Contact", url: "/contact", target: undefined },
];
const menuItems = menuResult.data?.items?.length ? menuResult.data.items : fallbackMenu;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (url: string) => {
	const path = url.replace(/\/$/, "") || "/";
	if (path === "/") return currentPath === "/";
	return currentPath === path || currentPath.startsWith(`${path}/`);
};
const year = new Date().getFullYear();

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#f6f2eb" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body class:list={[overlay && "has-overlay"]}>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class:list={["site-header", overlay && "site-header--overlay"]}>
			<div class="site-header__inner wrap">
				<a class="brand" href="/" aria-label={`${siteTitle} — home`}>
					{
						siteLogo ? (
							<img class="brand__logo" src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						) : (
							<>
								<span class="brand__name">{siteTitle}</span>
								{siteTagline && <span class="brand__tagline">{siteTagline}</span>}
							</>
						)
					}
				</a>

				<button
					class="menu-toggle"
					type="button"
					aria-expanded="false"
					aria-controls="primary-nav"
					data-menu-toggle
				>
					<span class="menu-toggle__bars" aria-hidden="true"></span>
					<span class="menu-toggle__label">Menu</span>
				</button>

				<nav id="primary-nav" class="primary-nav" aria-label="Primary">
					<ul>
						{
							menuItems.map((item) => (
								<li>
									<a
										href={item.url}
										target={item.target || undefined}
										rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
										aria-current={isCurrent(item.url) ? "page" : undefined}
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				{
					studio.asideNote.length > 0 && (
						<p class="header-aside label label-rule">
							<span>
								{studio.asideNote.map((line, i) => (
									<>
										{i > 0 && <br />}
										{line}
									</>
								))}
							</span>
						</p>
					)
				}
			</div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap site-footer__grid">
				<div>
					<p class="site-footer__brand">{studio.name || siteTitle}</p>
					{siteTagline && <p class="label">{siteTagline}</p>}
				</div>
				<nav aria-label="Footer">
					<p class="label">Explore</p>
					<ul>
						{menuItems.map((item) => (
							<li><a href={item.url}>{item.label}</a></li>
						))}
					</ul>
				</nav>
				<div>
					<p class="label">Studio</p>
					{
						studio.address.length > 0 && (
							<address>
								{studio.address.map((line, i) => (
									<>
										{i > 0 && <br />}
										{line}
									</>
								))}
							</address>
						)
					}
					{studio.email && <p><a href={`mailto:${studio.email}`}>{studio.email}</a></p>}
					{studio.phone && <p><a href={telHref(studio.phone)}>{studio.phone}</a></p>}
				</div>
			</div>
			<div class="wrap site-footer__base">
				<p>© {year} {studio.name || siteTitle}. Online catalog only — purchases are completed with partner shops or by inquiry.</p>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
			const header = toggle?.closest(".site-header");
			if (toggle && header) {
				const setOpen = (open: boolean) => {
					toggle.setAttribute("aria-expanded", String(open));
					header.classList.toggle("is-open", open);
				};
				toggle.addEventListener("click", () => {
					setOpen(toggle.getAttribute("aria-expanded") !== "true");
				});
				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape" && header.classList.contains("is-open")) {
						setOpen(false);
						toggle.focus();
					}
				});
				window.matchMedia("(min-width: 56rem)").addEventListener("change", (event) => {
					if (event.matches) setOpen(false);
				});
			}
		</script>
	</body>
</html>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-line);
	}

	.site-header--overlay {
		position: absolute;
		inset: 0 0 auto 0;
		background: transparent;
		border-bottom: 0;
	}

	.site-header__inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: var(--space-3);
		padding-block: 1.6rem;
	}

	.brand {
		display: inline-flex;
		flex-direction: column;
		gap: 0.15rem;
		text-decoration: none;
		color: var(--color-ink);
	}

	.brand__name {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 500;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		line-height: 1;
	}

	.brand__tagline {
		font-family: var(--font-label);
		font-size: 0.625rem;
		letter-spacing: 0.34em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.brand__logo {
		height: 48px;
		width: auto;
	}

	.primary-nav ul {
		display: flex;
		justify-content: center;
		gap: clamp(1.5rem, 4vw, 3.25rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.primary-nav a {
		font-family: var(--font-body);
		font-size: 1.0625rem;
		text-decoration: none;
		color: var(--color-ink);
		padding-block: 0.35rem;
		border-bottom: 1px solid transparent;
	}

	.primary-nav a:hover,
	.primary-nav a[aria-current="page"] {
		border-bottom-color: currentColor;
	}

	.header-aside {
		margin: 0;
		font-size: 0.5625rem;
		text-align: left;
		color: var(--color-ink);
	}

	.site-header--overlay .header-aside {
		background: rgba(246, 242, 235, 0.72);
		padding: 0.45rem 0.8rem;
	}

	.menu-toggle {
		display: none;
	}

	main:focus {
		outline: none;
	}

	.site-footer {
		margin-top: var(--space-6);
		border-top: 1px solid var(--color-line);
		background: var(--color-surface);
		font-size: 1rem;
	}

	.site-footer__grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1.5fr;
		gap: var(--space-4);
		padding-block: var(--space-5) var(--space-4);
	}

	.site-footer__brand {
		font-family: var(--font-display);
		font-size: 1.5rem;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		margin-bottom: 0.25rem;
	}

	.site-footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.35rem;
	}

	.site-footer address {
		font-style: normal;
		margin-bottom: 1rem;
	}

	.site-footer p {
		margin-bottom: 0.5rem;
	}

	.site-footer__base {
		border-top: 1px solid var(--color-line);
		padding-block: 1.25rem;
		font-size: 0.875rem;
		color: var(--color-muted);
	}

	.site-footer__base p {
		margin: 0;
	}

	@media (max-width: 70rem) {
		.header-aside {
			display: none;
		}
		.site-header__inner {
			grid-template-columns: auto 1fr;
		}
		.primary-nav ul {
			justify-content: flex-end;
		}
	}

	@media (max-width: 56rem) {
		.site-header__inner {
			grid-template-columns: 1fr auto;
			padding-block: 1.1rem;
		}

		.brand__name {
			font-size: 1.4rem;
		}

		.menu-toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.6rem;
			min-height: 44px;
			padding: 0.5rem 0.75rem;
			background: transparent;
			border: 1px solid var(--color-ink);
			border-radius: var(--radius);
			color: var(--color-ink);
			font-family: var(--font-label);
			font-size: 0.6875rem;
			letter-spacing: 0.24em;
			text-transform: uppercase;
			cursor: pointer;
		}

		.menu-toggle__bars,
		.menu-toggle__bars::before,
		.menu-toggle__bars::after {
			display: block;
			width: 16px;
			height: 1px;
			background: currentColor;
			position: relative;
		}

		.menu-toggle__bars::before,
		.menu-toggle__bars::after {
			content: "";
			position: absolute;
			left: 0;
		}

		.menu-toggle__bars::before {
			top: -5px;
		}

		.menu-toggle__bars::after {
			top: 5px;
		}

		.primary-nav {
			grid-column: 1 / -1;
			display: none;
		}

		.site-header.is-open .primary-nav {
			display: block;
		}

		.site-header.is-open {
			background: var(--color-bg);
			border-bottom: 1px solid var(--color-line);
		}

		.primary-nav ul {
			flex-direction: column;
			gap: 0;
			padding-top: 0.5rem;
		}

		.primary-nav li + li {
			border-top: 1px solid var(--color-line);
		}

		.primary-nav a {
			display: block;
			padding: 0.9rem 0;
			font-size: 1.25rem;
			border-bottom: 0;
		}

		.primary-nav a[aria-current="page"] {
			text-decoration: underline;
		}

		.site-footer__grid {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}
	}

	@media (scripting: none) {
		.menu-toggle {
			display: none;
		}
		.primary-nav {
			display: block;
		}
	}
</style>
