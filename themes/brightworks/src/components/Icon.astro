---
/** Line icons drawn inline (no icon font). Decorative unless a label is passed. */
interface Props {
	name: string;
	class?: string;
	label?: string;
}
const { name, class: className, label } = Astro.props;
const paths: Record<string, string> = {
	chat: '<path d="M7 9.5h15a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-8l-5.5 4.5V23.5H7a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3z"/><path d="M25 14h4a3 3 0 0 1 3 3v6.5a3 3 0 0 1-3 3h-1.5V30L23 26.5"/><path d="M10 16.5h.01M14.5 16.5h.01M19 16.5h.01" stroke-width="2.8"/>',
	document: '<path d="M9 4.5h13l6 6v21H9z"/><path d="M22 4.5v6h6"/><path d="M13.5 16h10M13.5 21h10M13.5 26h6"/>',
	pencil: '<path d="M24.5 5.5l6 6L13 29l-8 2 2-8z"/><path d="M21 9l6 6"/><path d="M7 23l6 6"/>',
	gear: '<circle cx="18" cy="18" r="4.5"/><path d="M18 4.5v4M18 27.5v4M4.5 18h4M27.5 18h4M8.5 8.5l2.8 2.8M24.7 24.7l2.8 2.8M8.5 27.5l2.8-2.8M24.7 11.3l2.8-2.8"/><circle cx="18" cy="18" r="10"/>',
	truck: '<path d="M3.5 9.5h18v15h-18z"/><path d="M21.5 14h6l5 5.5v5h-11"/><circle cx="10" cy="26.5" r="2.8"/><circle cx="26.5" cy="26.5" r="2.8"/>',
	wrench: '<path d="M23 4.5a7.5 7.5 0 0 0-7 10.2L5.7 25a3 3 0 0 0 4.3 4.3L20.3 19a7.5 7.5 0 0 0 10.2-7l-4.4 2.4-4-1.4-1.4-4z"/>',
	sign: '<path d="M5 12h26v13H5z"/><path d="M10 12V8M26 12V8M7 8h22"/><path d="M11 21v-5l2.5 3 2.5-3v5M20 16v5h4"/>',
	lettering: '<path d="M6 28L12.5 8h3L22 28M8.5 21h10.5"/><path d="M24 8v20M24 8h4.5a4.5 4.5 0 0 1 0 9H24M24 17h5a5.5 5.5 0 0 1 0 11h-5"/>',
	window: '<path d="M7 5h22v26H7z"/><path d="M18 5v26"/><path d="M11 10v6"/>',
	aframe: '<path d="M14 5h8L29 31M22 5L15 31M14 5L7 31"/><path d="M11 21h14"/>',
	print: '<path d="M9 7.5h18v24H9z"/><path d="M14 5h8v5h-8z"/><path d="M13 17.5h10l-1.5 6h-7z"/><path d="M18 23.5v3"/>',
	clip: '<path d="M24 12.5L14.5 22a3 3 0 0 0 4.2 4.2l10-10a6 6 0 0 0-8.5-8.5L9.8 18.2a9 9 0 0 0 12.7 12.7l8-8"/>',
	phone: '<path d="M10 5h5l2.5 6.5-3.3 2.2a15 15 0 0 0 8.1 8.1l2.2-3.3L31 21v5a3 3 0 0 1-3 3A23 23 0 0 1 7 8a3 3 0 0 1 3-3z"/>',
	mail: '<path d="M5 9h26v18H5z"/><path d="M5 10l13 10 13-10"/>',
	pin: '<path d="M18 33s-10-9.6-10-17.2a10 10 0 0 1 20 0C28 23.4 18 33 18 33z"/><circle cx="18" cy="15.5" r="3.8"/>',
	clock: '<circle cx="18" cy="18" r="13.5"/><path d="M18 9.5V18h7"/>',
};
const body = paths[name] ?? paths.document;
---

<svg
	class:list={["icon", className]}
	viewBox="0 0 36 36"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
	focusable="false"
	set:html={body}
/>
