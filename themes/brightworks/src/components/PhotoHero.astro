---
/** Full-width photographic hero: dark ink panel on the left fading into a photo that bleeds right. */
interface Props {
	photo?: string;
	alt: string;
	labelledby: string;
	class?: string;
	width?: number;
	height?: number;
}
const { photo, alt, labelledby, class: className, width = 1052, height = 477 } = Astro.props;
---

<section class:list={["photo-hero", className]} aria-labelledby={labelledby}>
	{
		photo && (
			<div class="photo-hero-media">
				<img src={photo} alt={alt} width={width} height={height} fetchpriority="high" />
			</div>
		)
	}
	<div class="photo-hero-copy container">
		<slot />
	</div>
</section>
