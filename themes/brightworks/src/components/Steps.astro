---
import Icon from "./Icon.astro";
import type { Step } from "../lib/brightworks";
/** Process steps. `arrows`: icon rings joined by arrows; `numbered`: adds yellow number badges. */
interface Props {
	items: { data: Step }[];
	variant: "arrows" | "numbered" | "inline";
	class?: string;
}
const { items, variant, class: className } = Astro.props;
---

{
	items.length > 0 && (
		<ol class:list={["steps", `steps-${variant}`, className]}>
			{items.map((s, i) => (
				<li>
					<span class="step-mark">
						{variant !== "arrows" && <span class="step-num" aria-hidden="true">{i + 1}</span>}
						<Icon name={s.data.icon ?? "document"} />
					</span>
					<div class="step-copy">
						<h3>{variant === "arrows" ? `${i + 1}. ${s.data.title}` : s.data.title}</h3>
						{s.data.text && <p>{s.data.text}</p>}
					</div>
				</li>
			))}
		</ol>
	)
}
