---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import Steps from "../components/Steps.astro";
import { LOCATIONS, SIGN_TYPES, TIMEFRAMES, getBusiness, getSteps, telHref } from "../lib/brightworks";

const [steps, businessResult] = await Promise.all([getSteps("quote"), getBusiness()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(steps.cacheHint);
	Astro.cache.set(businessResult.cacheHint);
}
const { business } = businessResult;

// Service pages link here with ?type=exterior etc. to preselect the sign type.
const typeParam = Astro.url.searchParams.get("type") ?? "";
const selectedType = SIGN_TYPES.some((t) => t.value === typeParam) ? typeParam : "";
const contactHref = business.email ? `mailto:${business.email}` : business.phone ? telHref(business.phone) : "/services";
---

<Base title="Request a quote" description="Tell us about your business and signage needs and we'll provide a clear, no-obligation quote.">
	<div class="quote-layout">
		<div class="quote-main">
			<section class="quote-hero" aria-labelledby="quote-title">
				<div class="quote-hero-media">
					<img src="/images/hero-quote.webp" alt="Illuminated Riverside lettering and wall lamps on a timber shopfront" width="517" height="438" fetchpriority="high" />
				</div>
				<div class="quote-hero-copy">
					<span class="eyebrow eyebrow-spaced">Request a quote</span>
					<h1 id="quote-title" class="display display-md">Let’s bring your signage <span class="accent">project to life<span class="dot">.</span></span></h1>
					<p class="hero-lede">Tell us about your business and signage needs and we’ll provide a clear, no-obligation quote with expert recommendations.</p>
				</div>
			</section>

			<section class="quote-process" aria-labelledby="quote-process-title">
				<span class="eyebrow eyebrow-dark">A simple process</span>
				<h2 id="quote-process-title" class="title-lg title-rule">From idea to installation.</h2>
				<Steps items={steps.entries} variant="inline" />
			</section>
		</div>

		<section class="form-card" id="quote-form" aria-labelledby="form-title">
			<h2 id="form-title" class="title-lg">Request a quote</h2>
			<p class="form-intro">Fill in the details below and we’ll get back to you shortly with a tailored quote.</p>
			<form
				class="quote-form"
				data-quote
				data-email={business.email}
				action={business.email ? `mailto:${business.email}?subject=${encodeURIComponent("Quote request")}` : undefined}
				method="post"
				enctype="text/plain"
			>
				<div class="field-row">
					<div class="field">
						<label for="q-name">Your name <span class="req" aria-hidden="true">*</span></label>
						<input id="q-name" name="name" type="text" autocomplete="name" placeholder="Full name" required />
					</div>
					<div class="field">
						<label for="q-business">Business name <span class="req" aria-hidden="true">*</span></label>
						<input id="q-business" name="business" type="text" autocomplete="organization" placeholder="Business name" required />
					</div>
				</div>
				<div class="field-row">
					<div class="field">
						<label for="q-email">Email address <span class="req" aria-hidden="true">*</span></label>
						<input id="q-email" name="email" type="email" autocomplete="email" placeholder="you@business.com" required />
					</div>
					<div class="field">
						<label for="q-phone">Phone number <span class="req" aria-hidden="true">*</span></label>
						<input id="q-phone" name="phone" type="tel" autocomplete="tel" placeholder="e.g. 0412 345 678" required />
					</div>
				</div>
				<div class="field">
					<label for="q-type">Sign type <span class="req" aria-hidden="true">*</span></label>
					<select id="q-type" name="type" required>
						<option value="" selected={!selectedType}>Select sign type</option>
						{SIGN_TYPES.map((t) => <option value={t.label} selected={t.value === selectedType}>{t.label}</option>)}
					</select>
				</div>
				<div class="field-row">
					<div class="field">
						<label for="q-size">Approximate dimensions</label>
						<input id="q-size" name="dimensions" type="text" placeholder="e.g. 2400mm x 800mm" />
					</div>
					<div class="field">
						<label for="q-location">Installation location <span class="req" aria-hidden="true">*</span></label>
						<select id="q-location" name="location" required>
							<option value="">Select location</option>
							{LOCATIONS.map((l) => <option>{l}</option>)}
						</select>
					</div>
				</div>
				<div class="field">
					<label for="q-project">Tell us about your project <span class="req" aria-hidden="true">*</span></label>
					<textarea id="q-project" name="project" rows="3" required placeholder="A brief description of what you’re looking for, including any specific requirements, branding or design ideas."></textarea>
				</div>
				<div class="field">
					<span class="label" id="q-files-label">Attach files <span class="optional">(optional)</span></span>
					<label class="dropzone" for="q-files">
						<Icon name="clip" />
						<span>
							<strong data-files-name>Upload photos, logos or design files</strong>
							<small>JPG, PNG, PDF (max 10MB)</small>
						</span>
					</label>
					<input class="sr-only" id="q-files" name="files" type="file" multiple accept="image/jpeg,image/png,application/pdf" aria-labelledby="q-files-label" aria-describedby="q-files-note" />
					<span class="sr-only" id="q-files-note">You will be asked to attach the files to the email.</span>
				</div>
				<div class="field">
					<label for="q-when">When do you need this? <span class="req" aria-hidden="true">*</span></label>
					<select id="q-when" name="timeframe" required>
						<option value="">Select timeframe</option>
						{TIMEFRAMES.map((t) => <option>{t}</option>)}
					</select>
				</div>
				<p class="sr-only">Fields marked with an asterisk are required.</p>
				<button class="btn btn-block" type="submit">Request a quote <Arrow /></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					{
						business.email ? (
							<noscript>
								Without JavaScript, send your request by email to <a href={`mailto:${business.email}`}>{business.email}</a>.
							</noscript>
						) : (
							business.phone && <>Online requests are not available right now. Please call {business.phone}.</>
						)
					}
				</p>
			</form>
		</section>
	</div>

	<section class="help-band" aria-labelledby="help-title">
		<div class="help-media">
			<img src="/images/help-northside.webp" alt="Northside Health + Wellness dimensional lettering on a pale stone building" width="882" height="149" loading="lazy" />
		</div>
		<div class="help-copy">
			<span class="eyebrow">Need help?</span>
			<h2 id="help-title" class="title-md">Not sure what you need?</h2>
			<p>Our team can help you choose the right signage solution for your business, location and budget.</p>
			<a class="btn btn-outline" href={contactHref}>Get in touch <Arrow /></a>
		</div>
	</section>
</Base>

<script>
	// Quote request: compose an email to the business. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-quote]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		const files = form.querySelector<HTMLInputElement>('input[type="file"]');
		const filesName = form.querySelector<HTMLElement>("[data-files-name]");
		const MAX = 10 * 1024 * 1024;
		const DEFAULT_LABEL = filesName?.textContent ?? "";

		files?.addEventListener("change", () => {
			const list = Array.from(files.files ?? []);
			const tooBig = list.some((f) => f.size > MAX);
			files.setCustomValidity(tooBig ? "Please choose files under 10MB each." : "");
			if (filesName) filesName.textContent = list.length ? list.map((f) => f.name).join(", ") : DEFAULT_LABEL;
		});

		if (!status) return;
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online quote requests are not available right now. Please contact us directly.";
				return;
			}
			const data = new FormData(form);
			const get = (k: string) => String(data.get(k) ?? "").trim();
			const attached = Array.from(files?.files ?? []);
			const subject = `Quote request: ${get("type")} — ${get("business")}`;
			const body = [
				"Hello,",
				"",
				"I would like a quote for the following signage project.",
				"",
				`Name: ${get("name")}`,
				`Business: ${get("business")}`,
				`Email: ${get("email")}`,
				`Phone: ${get("phone")}`,
				`Sign type: ${get("type")}`,
				`Approximate dimensions: ${get("dimensions") || "Not sure yet"}`,
				`Installation location: ${get("location")}`,
				`Timeframe: ${get("timeframe")}`,
				"",
				"About the project:",
				get("project"),
				attached.length ? `\nFiles (attached to this email): ${attached.map((f) => f.name).join(", ")}` : "",
				"",
			].join("\n");
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			status.textContent = attached.length
				? "Your email app should open with this request ready to send. Attach your files before sending; nothing is sent until you send that email. If nothing opened, write to "
				: "Your email app should open with this request ready to send. Nothing is sent until you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
