---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import { getProjects, photoSrc, projectUrl } from "../../lib/brightworks";

const projectsResult = await getProjects();
if (Astro.cache?.enabled) Astro.cache.set(projectsResult.cacheHint);
const projects = projectsResult.entries;
---

<Base title="Projects" description="Signage, print and installation projects for local businesses.">
	<section class="page-head" aria-labelledby="projects-title">
		<div class="container">
			<span class="eyebrow eyebrow-yellow">Our work</span>
			<h1 id="projects-title" class="display display-md">Recent <span class="accent">projects<span class="dot">.</span></span></h1>
			<p class="hero-lede">Shopfronts, fascias and in-store print we have designed, made and installed for local businesses.</p>
		</div>
	</section>

	<section class="container-wide project-list" aria-label="Projects">
		{
			projects.length === 0 ? (
				<p class="empty">No projects have been published yet.</p>
			) : (
				<ul class="project-grid">
					{projects.map((p) => {
						const src = photoSrc(p.data.after_image, p.data.after_photo) ?? photoSrc(p.data.hero_image, p.data.hero_photo);
						return (
							<li class="project-card">
								<a href={projectUrl(p.data)}>
									{src && <img src={src} alt="" width="499" height="208" loading="lazy" />}
									<span class="eyebrow eyebrow-dark">{p.data.eyebrow || "Project case study"}</span>
									<h2>{p.data.title}</h2>
									{p.data.summary && <p>{p.data.summary}</p>}
									<span class="link-arrow">
										<span>Read the case study</span> <Arrow />
									</span>
								</a>
							</li>
						);
					})}
				</ul>
			)
		}
	</section>
</Base>
