---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Steps from "../../components/Steps.astro";
import { getServices, getSteps, photoSrc, serviceUrl } from "../../lib/brightworks";

const [servicesResult, steps] = await Promise.all([getServices(), getSteps("services")]);
if (Astro.cache?.enabled) {
	Astro.cache.set(servicesResult.cacheHint);
	Astro.cache.set(steps.cacheHint);
}
const services = servicesResult.entries;
---

<Base title="Services" description="Exterior signs, interior signage, print and professional installation for local businesses.">
	<section class="split-hero" aria-labelledby="services-title">
		<div class="split-hero-copy">
			<span class="eyebrow eyebrow-yellow">Our services</span>
			<h1 id="services-title" class="display display-md">Signs. Print.<br /><span class="accent">Installation<span class="dot">.</span></span></h1>
			<p class="hero-lede">
				High quality commercial signage, print and professional installation for local businesses. From storefront signs to
				interior graphics, we help your brand make an impact.
			</p>
		</div>
		<div class="split-hero-media">
			<img src="/images/hero-services.webp" alt="A Brightworks installer drilling illuminated 3D letters onto a timber fascia" width="986" height="317" fetchpriority="high" />
		</div>
	</section>

	<section class="service-list" aria-labelledby="service-list-title">
		<h2 id="service-list-title" class="sr-only">What we do</h2>
		<ul class="service-grid container-wide">
			{
				services.map((s) => {
					const src = photoSrc(s.data.image, s.data.photo);
					return (
						<li class="service-card">
							{src && <img src={src} alt={s.data.image?.alt || ""} width="362" height="194" loading="lazy" />}
							<h3>{s.data.title}</h3>
							{s.data.summary && <p>{s.data.summary}</p>}
							<a class="link-arrow" href={serviceUrl(s.data)}>
								<span>{s.data.link_label || `View ${s.data.title.toLowerCase()}`}</span> <Arrow />
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>

	<section class="process-band" aria-labelledby="process-title">
		<div class="process-inner container-wide">
			<div class="process-head">
				<span class="eyebrow">Our process</span>
				<h2 id="process-title" class="title-xl">A simpler way <span class="accent">from idea to installation.</span></h2>
				<p>We make signage and print easy with a clear process and local support at every step.</p>
			</div>
			<Steps items={steps.entries} variant="arrows" />
		</div>
	</section>
</Base>
