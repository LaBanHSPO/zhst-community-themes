---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import PhotoHero from "../../components/PhotoHero.astro";
import Steps from "../../components/Steps.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getChoices, getSteps, photoSrc, quoteUrl } from "../../lib/brightworks";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: service, cacheHint } = await getEmDashEntry("services", slug);
if (!service) return Astro.redirect("/404");
const key = service.data.slug ?? slug;
const [options, steps, settings] = await Promise.all([getChoices(key), getSteps("detail"), getSiteSettings()]);
if (Astro.cache?.enabled) {
	for (const hint of [cacheHint, options.cacheHint, steps.cacheHint]) Astro.cache.set(hint);
}

const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(service, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const d = service.data;
const heroSrc = photoSrc(d.hero_image, d.hero_photo);
// Without a wide hero photo the service card photo is shown framed instead of stretched.
const framedSrc = heroSrc ? undefined : photoSrc(d.image, d.photo);
const heroAlt = d.hero_image?.alt || d.image?.alt || `${d.title} by ${siteTitle}`;
const quote = quoteUrl(d.quote_type);
const headline = d.headline || d.title;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.lede}
	canonical={seo.canonical}
	content={{ collection: "services", id: service.data.id, slug }}
>
	<PhotoHero photo={heroSrc} alt={heroAlt} labelledby="service-title" class:list={["hero-detail", { "is-framed": !heroSrc }]} width={1052} height={387}>
		{d.eyebrow && <span class="eyebrow">{d.eyebrow}</span>}
		<h1 id="service-title" class="display display-md" {...service.edit.headline}>
			{headline}
			{d.headline_accent && <span class="accent">{d.headline_accent.replace(/\.$/, "")}{d.headline_accent.endsWith(".") && <span class="dot">.</span>}</span>}
		</h1>
		{d.lede && <p class="hero-lede">{d.lede}</p>}
		<a class="btn btn-lg" href={quote}>Request a quote <Arrow /></a>
		{
			framedSrc && (
				<div class="hero-frame">
					<img src={framedSrc} alt={heroAlt} width="362" height="194" />
				</div>
			)
		}
	</PhotoHero>

	{
		options.entries.length > 0 && (
			<section class="options container-wide" aria-labelledby="options-title">
				<div class="options-head">
					{d.options_eyebrow && <span class="eyebrow eyebrow-dark">{d.options_eyebrow}</span>}
					<h2 id="options-title" class="title-lg">{d.options_title || `${d.title} options`}</h2>
					{d.options_text && <p>{d.options_text}</p>}
				</div>
				<ul class="option-grid">
					{options.entries.map((o) => {
						const src = photoSrc(o.data.image, o.data.photo);
						return (
							<li class:list={["option", { "no-photo": !src }]}>
								{src && <img src={src} alt={o.data.image?.alt || `${o.data.title} example`} width="244" height="140" loading="lazy" />}
								<h3>{o.data.title}</h3>
								{o.data.text && <p>{o.data.text}</p>}
							</li>
						);
					})}
				</ul>
			</section>
		)
	}

	<section class="process-band process-detail" aria-labelledby="detail-process-title">
		<div class="process-inner container-wide">
			<div class="process-head">
				<span class="eyebrow">Our process</span>
				<h2 id="detail-process-title" class="title-lg">{d.process_title || "From design to installation"}</h2>
				{d.process_text && <p>{d.process_text}</p>}
			</div>
			<Steps items={steps.entries} variant="numbered" />
			<div class="process-cta">
				<span class="eyebrow">Ready to start?</span>
				<h2 class="title-md">{d.cta_title || "Get a free,"} <span class="accent">{d.cta_accent || "no-obligation quote."}</span></h2>
				{d.cta_text && <p>{d.cta_text}</p>}
				<a class="btn" href={quote}>Request a quote <Arrow /></a>
			</div>
		</div>
	</section>
</Base>
