 "content": {
  "pages": [
   {
    "id": "about",
    "status": "published",
    "data": {
     "title": "About Brightworks",
     "content": [
      {
       "_type": "block",
       "style": "normal",
       "_key": "b1",
       "children": [
        {
         "_type": "span",
         "text": "Brightworks is a local signage, print and installation company. We design, make and fit signs for shops, cafés, clinics, offices and the small businesses that keep a high street busy.",
         "_key": "b1s"
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "b2",
       "children": [
        {
         "_type": "span",
         "text": "Everything runs through one team: a site visit, clear options and pricing, visuals for your approval, production in our workshop and installation by our own fitters.",
         "_key": "b2s"
        }
       ]
      },
      {
       "_type": "block",
       "style": "h2",
       "_key": "h1",
       "children": [
        {
         "_type": "span",
         "text": "Working with us",
         "_key": "h1s"
        }
       ]
      },
      {
       "_type": "block",
       "style": "normal",
       "_key": "b3",
       "children": [
        {
         "_type": "span",
         "text": "Tell us what you need on the Request a quote page and we will get back to you with a tailored, no-obligation quote.",
         "_key": "b3s"
        }
       ]
      }
     ]
    },
    "slug": "about"
   }
