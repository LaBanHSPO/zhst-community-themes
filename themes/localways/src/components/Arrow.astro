---
/** Short arrow used inside buttons and text links. Decorative. */
interface Props {
	class?: string;
}
const { class: cls } = Astro.props;
---

<svg class:list={["arrow", cls]} viewBox="0 0 18 14" aria-hidden="true" focusable="false">
	<path d="M1 7h15.5M10.5 1.5 16.5 7l-6 5.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
</svg>
