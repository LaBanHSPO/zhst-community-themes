---
/** Line icons used across the theme. Decorative: always paired with visible text. */
interface Props {
	name?: string;
	class?: string;
}
const { name = "pin", class: cls } = Astro.props;
const paths: Record<string, string> = {
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.4 2"/>',
	users: '<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19.5c.6-3.4 3-5.3 6-5.3s5.4 1.9 6 5.3"/><path d="M15.5 5.6a3.1 3.1 0 0 1 0 5.9M17.6 14.6c1.9.6 3.1 2.3 3.4 4.9"/>',
	map: '<path d="M3 6.5 8.5 4l7 2.5L21 4v13.5L15.5 20l-7-2.5L3 20z"/><path d="M8.5 4v13.5M15.5 6.5V20"/>',
	pin: '<path d="M12 21s-6.5-5.8-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.2 12 21 12 21z"/><circle cx="12" cy="10" r="2.4"/>',
	tag: '<path d="M3.5 12.5V4.5a1 1 0 0 1 1-1h8l8 8-9 9z"/><circle cx="8.3" cy="8.3" r="1.5"/>',
	walk: '<circle cx="13" cy="4.3" r="1.8"/><path d="M10.2 21l2.2-6.2 2.6 2.6V21M8 11.5l2.3-3.6c.5-.8 1.6-1 2.4-.5l1.7 1.1 1.4 3.2 2.2.8M12.4 14.8l.4-4.2M8 11.5v3.3"/>',
	utensils: '<path d="M6.5 3v6.5a2.5 2.5 0 0 0 5 0V3M9 3v18"/><path d="M17.5 21V3c-2.2 1.2-3.2 3.7-3.2 7.3 0 2 1 3 3.2 3"/>',
	leaf: '<path d="M4.5 19.5C4 11 9 4.5 20 4c.4 10.5-5.6 15.7-14 15.5z"/><path d="M4.5 19.5c3-4.5 6.6-8 11-10.5"/>',
	chat: '<path d="M4 5.5h16v10.5H10l-4.5 3.5V16H4z"/><path d="M8.5 10.7h.01M12 10.7h.01M15.5 10.7h.01" stroke-width="2.4"/>',
	calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4M7.5 13h.01M12 13h.01M16.5 13h.01M7.5 16.5h.01M12 16.5h.01" />',
	mail: '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
	card: '<rect x="3" y="5.5" width="18" height="13" rx="1.8"/><path d="M3 10h18M6.5 14.5h4"/>',
	check: '<path d="m4.5 12.5 5 5 10-11"/>',
	search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/>',
	chevron: '<path d="m6 9 6 6 6-6"/>',
	plus: '<path d="M12 6v12M6 12h12"/>',
	minus: '<path d="M6 12h12"/>',
	back: '<path d="M20 12H4.5M10 6l-6 6 6 6"/>',
	heart: '<path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.6 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/>',
	star: '<path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.8z"/>',
};
const body = paths[name] ?? paths.pin;
---

<svg
	class:list={["icon", `icon-${name}`, cls]}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={body}
/>
