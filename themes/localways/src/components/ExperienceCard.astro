---
import Arrow from "./Arrow.astro";
import Icon from "./Icon.astro";
import { experienceUrl, km, money, photoAlt, photoSrc, type Experience } from "../lib/localways";

interface Props {
	entry: Experience;
	currency?: string;
	/** "home" shows duration only; "full" adds walking distance and price per person. */
	variant?: "home" | "full";
	headingLevel?: 2 | 3;
}

const { entry: e, currency, variant = "full", headingLevel = 3 } = Astro.props;
const src = photoSrc(e.image, e.photo);
const url = experienceUrl(e);
const distance = km(e.distance_km);
const H = headingLevel === 2 ? "h2" : "h3";
---

<article class:list={["tour-card", `tour-card-${variant}`]}>
	{src && <img class="tour-photo" src={src} alt={photoAlt(e.image, e.photo_alt, e.title)} width="363" height="177" loading="lazy" />}
	<div class="tour-body">
		<div class="tour-head">
			<H class="tour-title"><a href={url}>{e.title}</a></H>
			<span class="round-arrow" aria-hidden="true"><Arrow /></span>
		</div>
		{e.subtitle && <p class="tour-sub">{e.subtitle}</p>}
		<ul class="tour-meta" role="list">
			<li><Icon name="clock" /><span>{e.duration}</span></li>
			{
				variant === "full" && distance && (
					<li>
						<Icon name="walk" />
						<span><span class="sr-only">Walking distance </span>{distance}</span>
					</li>
				)
			}
			{
				variant === "full" && (
					<li class="tour-price">
						<Icon name="tag" />
						<span>
							<strong>{money(e.price, currency)}</strong>
							<span class="per">per person</span>
						</span>
					</li>
				)
			}
		</ul>
	</div>
</article>
