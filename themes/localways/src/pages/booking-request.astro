---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import LineArt from "../components/LineArt.astro";
import { childPrice, entryKey, getCompany, getExperiences, money, photoAlt, photoSrc, todayIso } from "../lib/localways";

const [{ entries, cacheHint }, { company }] = await Promise.all([getExperiences(), getCompany()]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const currency = company.currency || "€";
// Homepage-featured tours first (in their homepage order), then the rest in Experiences order.
const tours = entries
	.map((e) => e.data)
	.sort((a, b) => {
		const ra = a.home_featured ? (a.home_position ?? 50) : 100 + (a.position ?? 50);
		const rb = b.home_featured ? (b.home_position ?? 50) : 100 + (b.position ?? 50);
		return ra - rb;
	})
	.map((e) => ({
		key: entryKey(e),
		title: e.title,
		subtitle: e.subtitle ?? "",
		area: e.area,
		duration: e.duration,
		summary: e.summary || e.intro || "",
		price: e.price,
		child: childPrice(e),
		photo: photoSrc(e.image, e.photo) ?? "",
		alt: photoAlt(e.image, e.photo_alt, e.title),
	}));

const requested = (Astro.url.searchParams.get("experience") ?? "").trim();
const selected = tours.find((t) => t.key === requested) ?? tours[0];
const adults = 2;
const children = 0;
const optionLabel = (t: (typeof tours)[number]) => (t.subtitle ? `${t.title} – ${t.subtitle}` : t.title);
const breakdown = (t: (typeof tours)[number], a: number, c: number) =>
	[`${a} ${a === 1 ? "adult" : "adults"} × ${money(t.price, currency)}`, ...(c > 0 ? [`${c} ${c === 1 ? "child" : "children"} × ${money(t.child, currency)}`] : [])].join(" + ");
const today = todayIso();
---

<Base title="Booking request" description="Tell us a few details and a local will get back to you with availability and next steps. No payment is required at this stage.">
	<div class="booking">
		<div class="booking-left">
			<section class="booking-intro" aria-labelledby="hero-title">
				<p class="eyebrow eyebrow-ink">Booking request</p>
				<h1 id="hero-title" class="display display-dark display-booking">Let’s plan<br /> your experience</h1>
				<p class="booking-lede">Tell us a few details and we’ll get back to you with availability and next steps. No payment is required at this stage.</p>
				<ul class="promises" role="list">
					<li><span class="icon-disc"><Icon name="calendar" /></span> Availability checked for your date</li>
					<li><span class="icon-disc"><Icon name="mail" /></span> Personal response from a local</li>
					<li><span class="icon-disc"><Icon name="card" /></span> No payment required yet</li>
				</ul>
			</section>
			<div class="booking-photo">
				<img src="/images/booking-friends.webp" alt="Three friends laughing as they share street food on a busy old-town street" width="542" height="466" fetchpriority="high" />
			</div>

			{
				selected && (
					<section class="selected" aria-labelledby="selected-title" data-selected>
						<div class="selected-head">
							<h2 id="selected-title" class="title-md title-ink">Selected experience</h2>
							<a class="text-link" href="/experiences">Change experience <Arrow /></a>
						</div>
						<img data-sel="photo" src={selected.photo || undefined} alt={selected.alt} width="290" height="195" loading="lazy" hidden={!selected.photo} />
						<div class="selected-body">
							<h3 class="selected-title" data-sel="title">{selected.title}</h3>
							<p class="selected-sub" data-sel="subtitle">{selected.subtitle}</p>
							<ul class="selected-meta" role="list">
								<li><Icon name="clock" /> <span data-sel="duration">About {selected.duration}</span></li>
								<li><Icon name="pin" /> <span data-sel="area">{selected.area}</span></li>
							</ul>
							<p class="selected-summary" data-sel="summary">{selected.summary}</p>
						</div>
					</section>
				)
			}
		</div>

		<section class="booking-card" aria-labelledby="form-title">
			<h2 id="form-title" class="title-md title-ink">Your booking request</h2>
			{company.booking_lede && <p class="form-lede">{company.booking_lede}</p>}
			{
				tours.length === 0 ? (
					<p class="empty">Bookings open soon. Email us at <a href={`mailto:${company.email}`}>{company.email}</a>.</p>
				) : (
					<form
						class="booking-form"
						id="booking-form"
						data-email={company.email}
						data-currency={currency}
						action={company.email ? `mailto:${company.email}?subject=${encodeURIComponent("Booking request")}` : undefined}
						method="post"
						enctype="text/plain"
					>
						<div class="field">
							<label for="b-tour">Select experience</label>
							<span class="control">
								<select id="b-tour" name="experience" required>
									{tours.map((t) => (
										<option value={t.key} selected={t.key === selected?.key}>{optionLabel(t)}</option>
									))}
								</select>
								<Icon name="chevron" class="control-chevron" />
							</span>
						</div>
						<div class="field">
							<label for="b-date">Preferred date</label>
							<span class="control control-lead">
								<Icon name="calendar" class="lead-icon" />
								<input id="b-date" name="date" type="date" min={today} required />
							</span>
						</div>
						<fieldset class="field">
							<legend>Number of participants</legend>
							<div class="counters">
								<div class="counter">
									<label for="b-adults">Adults (13+)</label>
									<div class="stepper">
										<button type="button" class="step-btn" data-step="-1" data-for="b-adults" aria-label="Fewer adults"><Icon name="minus" /></button>
										<input id="b-adults" name="adults" type="number" inputmode="numeric" min="1" max="20" step="1" value={adults} required />
										<button type="button" class="step-btn" data-step="1" data-for="b-adults" aria-label="More adults"><Icon name="plus" /></button>
									</div>
								</div>
								<div class="counter">
									<label for="b-children">Children (4–12)</label>
									<div class="stepper">
										<button type="button" class="step-btn" data-step="-1" data-for="b-children" aria-label="Fewer children"><Icon name="minus" /></button>
										<input id="b-children" name="children" type="number" inputmode="numeric" min="0" max="20" step="1" value={children} required />
										<button type="button" class="step-btn" data-step="1" data-for="b-children" aria-label="More children"><Icon name="plus" /></button>
									</div>
								</div>
							</div>
						</fieldset>
						<fieldset class="field">
							<legend>Your contact details</legend>
							<div class="pair">
								<label class="sr-only" for="b-name">Full name</label>
								<input id="b-name" name="name" type="text" autocomplete="name" placeholder="Full name" maxlength="120" required />
								<label class="sr-only" for="b-email">Email address</label>
								<input id="b-email" name="email" type="email" autocomplete="email" placeholder="Email address" maxlength="160" required />
							</div>
						</fieldset>
						<div class="field">
							<label for="b-notes">Dietary requirements or special requests (optional)</label>
							<textarea id="b-notes" name="notes" rows="3" maxlength="1000" placeholder="E.g. vegetarian, food allergies, mobility needs..."></textarea>
						</div>

						{
							selected && (
								<div class="estimate" aria-live="polite">
									<div>
										<p class="estimate-title">Estimated price</p>
										<p class="estimate-tour" data-est="tour">{selected.title}</p>
									</div>
									<div class="estimate-sum">
										<p class="estimate-total" data-est="total">{money(selected.price * adults + selected.child * children, currency)}</p>
										<p class="estimate-break" data-est="break">{breakdown(selected, adults, children)}</p>
									</div>
								</div>
							)
						}

						<button class="btn btn-lg btn-block" type="submit">Request booking (pending confirmation) <Arrow /></button>
						{company.booking_note && <p class="form-note">{company.booking_note}</p>}
						<p class="form-status" role="status" aria-live="polite" data-status>
							{
								company.email && (
									<noscript>
										Without JavaScript, send your request by email to <a href={`mailto:${company.email}`}>{company.email}</a>.
									</noscript>
								)
							}
						</p>
					</form>
				)
			}
		</section>
	</div>

	<section class="band band-help" aria-labelledby="help-title">
		<div class="band-copy">
			<div class="band-text">
				<h2 id="help-title" class="title-lg">Questions?<br /> We’re here to help.</h2>
				<p>Have something specific in mind or a larger group?<br class="br-wide" /> Get in touch and we’ll be happy to assist.</p>
				{
					company.email && (
						<a class="btn btn-outline btn-sm" href={`mailto:${company.email}?subject=${encodeURIComponent("Question about a Localways experience")}`}>
							Contact us <Arrow />
						</a>
					)
				}
			</div>
			<LineArt class="band-art" />
		</div>
		<div class="band-photo">
			<img src="/images/band-rome.webp" alt="Rooftops and a great dome glowing at sunset" width="729" height="182" />
		</div>
	</section>

	<script type="application/json" id="tour-data" is:inline set:html={JSON.stringify(tours).replace(/</g, "\\u003c")}></script>
</Base>

<script>
	// Booking request: live estimate, steppers and a pre-filled email. Nothing is sent by the site itself.
	type Tour = { key: string; title: string; subtitle: string; area: string; duration: string; summary: string; price: number; child: number; photo: string; alt: string };

	const form = document.querySelector<HTMLFormElement>("#booking-form");
	const dataEl = document.querySelector("#tour-data");
	const tours: Tour[] = dataEl?.textContent ? (JSON.parse(dataEl.textContent) as Tour[]) : [];

	if (form && tours.length > 0) {
		const currency = form.dataset.currency ?? "€";
		const fmt = new Intl.NumberFormat("en-US", { maximumFractionDigits: 2 });
		const money = (n: number) => `${currency}${fmt.format(n)}`;
		const select = form.querySelector<HTMLSelectElement>("#b-tour");
		const adultsEl = form.querySelector<HTMLInputElement>("#b-adults");
		const childrenEl = form.querySelector<HTMLInputElement>("#b-children");
		const status = form.querySelector<HTMLElement>("[data-status]");
		const count = (el: HTMLInputElement | null, min: number) => {
			const n = Number.parseInt(el?.value ?? "", 10);
			return Number.isFinite(n) && n >= min ? Math.min(n, 20) : min;
		};
		const current = () => tours.find((t) => t.key === select?.value) ?? tours[0];
		const setText = (sel: string, text: string) => {
			const el = document.querySelector<HTMLElement>(sel);
			if (el) el.textContent = text;
		};
		const breakdown = (t: Tour, a: number, c: number) =>
			[`${a} ${a === 1 ? "adult" : "adults"} × ${money(t.price)}`, ...(c > 0 ? [`${c} ${c === 1 ? "child" : "children"} × ${money(t.child)}`] : [])].join(" + ");

		const update = () => {
			const t = current();
			const a = count(adultsEl, 1);
			const c = count(childrenEl, 0);
			setText('[data-est="tour"]', t.title);
			setText('[data-est="total"]', money(t.price * a + t.child * c));
			setText('[data-est="break"]', breakdown(t, a, c));
			setText('[data-sel="title"]', t.title);
			setText('[data-sel="subtitle"]', t.subtitle);
			setText('[data-sel="duration"]', `About ${t.duration}`);
			setText('[data-sel="area"]', t.area);
			setText('[data-sel="summary"]', t.summary);
			const img = document.querySelector<HTMLImageElement>('[data-sel="photo"]');
			if (img) {
				img.hidden = !t.photo;
				if (t.photo) {
					img.src = t.photo;
					img.alt = t.alt;
				}
			}
		};

		for (const btn of form.querySelectorAll<HTMLButtonElement>("[data-step]")) {
			btn.addEventListener("click", () => {
				const input = form.querySelector<HTMLInputElement>(`#${btn.dataset.for}`);
				if (!input) return;
				const min = Number(input.min || 0);
				const max = Number(input.max || 20);
				const next = count(input, min) + Number(btn.dataset.step);
				input.value = String(Math.max(min, Math.min(max, next)));
				update();
			});
		}
		select?.addEventListener("change", update);
		adultsEl?.addEventListener("input", update);
		childrenEl?.addEventListener("input", update);
		update();

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!status || !form.reportValidity()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online booking requests are not available right now. Please contact us directly.";
				return;
			}
			const data = new FormData(form);
			const get = (k: string) => String(data.get(k) ?? "").trim();
			const t = current();
			const a = count(adultsEl, 1);
			const c = count(childrenEl, 0);
			const date = get("date");
			const prettyDate = date
				? new Intl.DateTimeFormat("en-GB", { weekday: "short", day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`))
				: "";
			const subject = `Booking request: ${t.title}, ${prettyDate}`;
			const body = [
				"Hello,",
				"",
				"I would like to request a booking. Please confirm availability and the final price.",
				"",
				`Experience: ${t.title}`,
				`Preferred date: ${prettyDate}`,
				`Adults (13+): ${a}`,
				`Children (4–12): ${c}`,
				`Estimated price: ${money(t.price * a + t.child * c)} (${breakdown(t, a, c)})`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				`Dietary requirements or special requests: ${get("notes") || "None"}`,
				"",
			].join("\n");
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			status.textContent =
				"Your email app should open with this request ready to send. Nothing is sent until you send that email, and the booking is pending until a local confirms it. If nothing opened, write to ";
			const link = document.createElement("a");
			link.href = `mailto:${email}`;
			link.textContent = email;
			status.append(link, ".");
		});
	}
</script>
