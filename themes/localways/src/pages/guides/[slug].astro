---
import { getEmDashEntry, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Icon from "../../components/Icon.astro";
import LineArt from "../../components/LineArt.astro";
import { entryKey, paragraphs, photoAlt, photoSrc } from "../../lib/localways";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry, cacheHint } = await getEmDashEntry("guides", slug);
if (!entry) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const g = entry.data;
const portrait = photoSrc(g.image, g.photo);
const portraitAlt = photoAlt(g.image, g.photo_alt, `${g.title}, local guide`);
const toursUrl = `/experiences?guide=${encodeURIComponent(entryKey(g))}`;
const story = paragraphs(g.story);
const facts = [
	{ icon: "chat", title: "Languages", text: g.languages },
	{ icon: "utensils", title: "What I love", text: g.loves },
	{ icon: "pin", title: "My approach", text: g.approach },
].filter((f) => f.text);
const stops = (g.stops ?? []).map((s) => ({ ...s, src: photoSrc(s.image, s.photo), alt: s.image?.alt || s.alt }));
---

<Base title={`Meet ${g.title}`} description={g.intro} image={portrait} content={{ collection: "guides", id: g.id, slug: g.slug }}>
	<section class="hero hero-light" aria-labelledby="hero-title">
		{
			portrait && (
				<>
					<div class="hero-bg" aria-hidden="true"><img src={portrait} alt="" width="925" height="358" /></div>
					<div class="hero-photo">
						<img src={portrait} alt={portraitAlt} width="925" height="358" fetchpriority="high" />
					</div>
				</>
			)
		}
		<div class="hero-copy hero-copy-guide">
			{g.eyebrow && <p class="eyebrow">{g.eyebrow}</p>}
			<h1 id="hero-title" class="display display-dark" {...entry.edit.title}>{g.headline || `Hi, I’m ${g.title}.`}</h1>
			{g.intro && <p class="hero-lede">{g.intro}</p>}
			<a class="btn btn-lg" href={toursUrl}>{g.cta_label || "Explore my experiences"} <Arrow /></a>
		</div>
	</section>

	<div class="container guide-body">
		{
			story.length > 0 && (
				<section class="guide-story" aria-labelledby="story-title">
					<p class="eyebrow eyebrow-ink">{g.story_eyebrow || "My story"}</p>
					<h2 id="story-title" class="title-lg title-ink">{g.story_title || `About ${g.title}`}</h2>
					{story.map((p) => <p>{p}</p>)}
				</section>
			)
		}
		<div class="guide-main">
			{
				facts.length > 0 && (
					<ul class="guide-facts" role="list">
						{facts.map((f) => (
							<li>
								<span class="icon-disc"><Icon name={f.icon} /></span>
								<div>
									<h2 class="fact-title">{f.title}</h2>
									<p>{f.text}</p>
								</div>
							</li>
						))}
					</ul>
				)
			}
			{
				stops.length > 0 && (
					<section class="stops" aria-labelledby="stops-title">
						<h2 id="stops-title" class="eyebrow eyebrow-ink">My favorite stops</h2>
						<div class="stops-grid">
							{stops.map((s) => (
								<article class="stop">
									{s.src && <img src={s.src} alt={s.alt} width="306" height="144" loading="lazy" />}
									<div class="stop-row">
										<div>
											<h3 class="stop-title">{s.url ? <a href={s.url}>{s.title}</a> : s.title}</h3>
											{s.text && <p>{s.text}</p>}
										</div>
										{s.url && <span class="round-arrow" aria-hidden="true"><Arrow /></span>}
									</div>
								</article>
							))}
						</div>
					</section>
				)
			}
		</div>
	</div>

	<section class="cta-band" aria-labelledby="cta-title">
		<div class="container cta-inner">
			<LineArt class="cta-art" />
			<div class="cta-text">
				<p class="eyebrow eyebrow-light">{g.band_eyebrow || "Explore with me"}</p>
				<h2 id="cta-title" class="title-lg">{g.band_title || "Ready to taste the real city?"}</h2>
				{g.band_text && <p>{g.band_text}</p>}
			</div>
			<a class="btn btn-lg" href={toursUrl}>{g.band_cta || "See my experiences"} <Arrow /></a>
		</div>
	</section>
</Base>
