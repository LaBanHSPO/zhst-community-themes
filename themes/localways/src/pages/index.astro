---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import LineArt from "../components/LineArt.astro";
import { getCompany, getExperiences, getGuides, guideUrl } from "../lib/localways";

const [{ entries, cacheHint }, { company }, guidesResult] = await Promise.all([getExperiences(), getCompany(), getGuides()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(guidesResult.cacheHint);
}

const featured = entries
	.filter((e) => e.data.home_featured)
	.sort((a, b) => (a.data.home_position ?? 99) - (b.data.home_position ?? 99))
	.slice(0, 3);
const guides = guidesResult.entries;
// One guide: go straight to their profile; several: the guides list.
const guidesHref = guides.length === 1 ? guideUrl(guides[0].data) : "/guides";
---

<Base title="See the city with a local" description="Authentic food, vibrant neighborhoods and real stories, led by passionate locals.">
	<section class="hero hero-dark" aria-labelledby="hero-title">
		<div class="hero-bg" aria-hidden="true"><img src="/images/hero-home.webp" alt="" width="1030" height="398" /></div>
		<div class="hero-photo">
			<img
				src="/images/hero-home.webp"
				alt="Three friends laughing and sharing street food with their local guide on a busy market street"
				width="1030"
				height="398"
				fetchpriority="high"
			/>
		</div>
		<div class="hero-copy hero-copy-home">
			<h1 id="hero-title" class="display">See the city<br /> with a local.</h1>
			<p class="hero-lede">Authentic food, vibrant neighborhoods<br class="br-wide" /> and real stories, led by passionate locals.</p>
			<a class="btn btn-lg" href="/experiences">Explore experiences <Arrow /></a>
		</div>
	</section>

	<section class="featured container" aria-labelledby="featured-title">
		<div class="featured-intro">
			<p class="eyebrow">Our experiences</p>
			<h2 id="featured-title" class="title-xl">Featured<br /> tours</h2>
			<a class="text-link" href="/experiences">View all experiences <Arrow /></a>
		</div>
		{
			featured.length > 0 ? (
				<div class="featured-grid">
					{featured.map((e) => (
						<ExperienceCard entry={e.data} currency={company.currency} variant="home" />
					))}
				</div>
			) : (
				<p class="empty">New experiences are on the way. Check back soon.</p>
			)
		}
	</section>

	<section class="band" aria-labelledby="guide-title">
		<div class="band-copy">
			<div class="band-text">
				<p class="eyebrow eyebrow-light">The Localways difference</p>
				<h2 id="guide-title" class="title-lg">Meet your guide</h2>
				<p>
					Our guides are locals, not just tour leaders. They share the places they love, the food they eat and the stories that make their city home.
				</p>
				<a class="btn" href={guidesHref}>Our guides <Arrow /></a>
			</div>
			<LineArt class="band-art" />
		</div>
		<div class="band-photo">
			<img src="/images/band-guide.webp" alt="A smiling local guide on a terrace above the city’s rooftops and a great dome" width="729" height="208" />
		</div>
	</section>
</Base>
