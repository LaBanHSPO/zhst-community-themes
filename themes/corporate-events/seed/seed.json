   {
    "id": "corporate-meetings",
    "slug": "corporate-meetings",
    "status": "published",
    "data": {
     "title": "Corporate Meetings",
     "summary": "Productive, seamless, on brand.",
     "icon": "calendar",
     "featured": true,
     "position": 20,
     "intro": "Board days, leadership off-sites, town halls and sales kick-offs, planned so the time in the room does real work.",
     "photo": "/images/keynote-stage.webp",
     "included": "Agenda and facilitation support\nRoom layout, catering and dietary management\nBranded signage, stage dressing and materials\nTravel and accommodation coordination\nMeeting technology checked and rehearsed\nA named contact on site from set-up to close",
     "formats": "Leadership meeting for 12 to 40 people\nCompany-wide town hall\nAnnual sales or partner kick-off\nTraining day with breakout rooms",
     "content": [
      {
       "_type": "block",
       "_key": "b5",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "A good meeting feels effortless to the people attending it. That takes quiet preparation: the right room, the right timings and technology that simply works.",
         "_key": "s5"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b6",
       "style": "h2",
