 "content": {
  "pages": [
   {
    "id": "about",
    "slug": "about",
    "status": "published",
    "data": {
     "title": "A planning team for events that matter.",
     "eyebrow": "About NexusEvents",
     "intro": "NexusEvents is a small team of event planners and producers. We organise conferences, meetings and networking events for organisations that want their time together to count.",
     "content": [
      {
       "_type": "block",
       "_key": "b51",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "We started NexusEvents because we kept seeing events that were well organised but poorly purposed. Our approach is simple: decide what the event is for, then plan everything else around it.",
         "_key": "s51"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b52",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "We keep the team small on purpose. The planner you meet at the start is the planner who runs your event, and we only take on as many events at a time as we can look after properly.",
         "_key": "s52"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b53",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "What we do",
         "_key": "s53"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b54",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "We plan and run conferences, corporate meetings, networking events, product launches and offsites. We also help organisations choose venues, with a short list of rooms we know well.",
         "_key": "s54"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b55",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "How we work",
         "_key": "s55"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b56",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "We work in four steps: listen, shape, deliver and follow up. Each has a clear owner on our team and a clear output for yours.",
         "_key": "s56"
        }
       ],
       "markDefs": []
      }
     ]
    }
   },
   {
    "id": "privacy",
    "slug": "privacy",
    "status": "published",
    "data": {
     "title": "Privacy",
     "eyebrow": "Legal",
     "intro": "What this site collects, and what it does not.",
     "content": [
      {
       "_type": "block",
       "_key": "b57",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "This sample site does not use analytics or advertising cookies, and it stores nothing from the planning form. When you send a planning brief, your own email app opens with the message ready to send, and it is only sent when you send that email.",
         "_key": "s57"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b58",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Information you send us",
         "_key": "s58"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b59",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "If you email a planning brief we use it only to reply and to plan your event, and we keep it for as long as the work needs.",
         "_key": "s59"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b60",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "Questions",
         "_key": "s60"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b61",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Write to planning@nexusevents.example and we will answer promptly.",
         "_key": "s61"
        }
       ],
       "markDefs": []
      }
     ]
    }
   }
  ],
  "services": [
   {
    "id": "conferences",
    "slug": "conferences",
    "status": "published",
    "data": {
     "title": "Conferences",
     "summary": "Big ideas. Real connections.",
     "icon": "people",
     "featured": true,
     "position": 10,
     "intro": "We plan multi-session conferences from first concept to final handshake: the programme, the room, the speakers and the people who need to be in it.",
     "photo": "/images/ballroom-audience.webp",
     "included": "Programme design and session running order\nVenue search, site visits and contracting support\nSpeaker briefing, rehearsal and green-room hosting\nRegistration, badges and arrivals desk\nStage, screens, sound and lighting management\nOn-site team for the full event, plus a short wrap-up report",
     "formats": "Single-day summit for 150 to 400 guests\nTwo-day conference with parallel tracks\nAnnual member or partner conference\nHybrid keynote with a live room and an online audience",
     "content": [
      {
       "_type": "block",
       "_key": "b1",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Most conferences are won or lost long before the doors open. We start with the outcome you want people to leave with, then build the programme, room and pace around it.",
         "_key": "s1"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b2",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "How we work on it",
         "_key": "s2"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b3",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "The same planner who shapes your concept runs your event day, so nothing important is lost in a handover.",
         "_key": "s3"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b4",
       "style": "h2",
