   {
    "id": "networking-events",
    "slug": "networking-events",
    "status": "published",
    "data": {
     "title": "Networking Events",
     "summary": "People who move business forward.",
     "icon": "cocktail",
     "featured": true,
     "position": 30,
     "intro": "Receptions, dinners and mixers designed so guests actually meet the people they came to meet.",
     "photo": "/images/reception.webp",
     "included": "Guest-list and invitation management\nVenue styling, lighting and music\nCatering, drinks service and staffing\nConversation starters and hosted introductions\nCloakroom, arrivals welcome and guest flow\nFollow-up contact list prepared for your team",
     "formats": "Evening reception for 80 to 300 guests\nSeated dinner with hosted tables\nRooftop or terrace mixer\nPartner and client appreciation evening",
     "content": [
      {
       "_type": "block",
       "_key": "b9",
       "style": "normal",
       "children": [
        {
         "_type": "span",
         "text": "Networking works when the room is easy to move through and guests have a reason to talk. We design the space, the timing and the introductions together.",
         "_key": "s9"
        }
       ],
       "markDefs": []
      },
      {
       "_type": "block",
       "_key": "b10",
       "style": "h2",
       "children": [
        {
         "_type": "span",
         "text": "How we work on it",
         "_key": "s10"
