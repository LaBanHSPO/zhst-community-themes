---
/** Closing "start planning" band shared by most pages. */
import Arrow from "./Arrow.astro";
import { telHref, type OfficeData } from "../lib/events";

interface Props {
	office: OfficeData;
	title?: string;
	text?: string;
	/** Query string for the contact link, e.g. "type=conferences". */
	query?: string;
}
const {
	office,
	title = "Tell us about your event.",
	text = "Share a few details and a planner will reply within two working days with questions, ideas and a suggested next step.",
	query,
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
	<div class="container cta-inner">
		<div>
			<span class="eyebrow eyebrow-light">Start planning</span>
			<h2 id="cta-title">{title}</h2>
			<p>{text}</p>
		</div>
		<div class="cta-actions">
			<a class="btn btn-lg" href={query ? `/contact?${query}` : "/contact"}>Start planning <Arrow /></a>
			<p class="cta-direct">
				{office.phone && <a href={telHref(office.phone)}>{office.phone}</a>}
				{office.email && <a href={`mailto:${office.email}`}>{office.email}</a>}
			</p>
		</div>
	</div>
</section>
