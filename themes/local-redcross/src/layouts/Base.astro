---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveSiteIdentity(settingsResult.data);
const logoSrc = siteLogo?.url ?? "/images/logo-cross-vn.webp";
const logoAlt = siteLogo ? siteLogo.alt || siteTitle : "";
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isAdmin = path.startsWith("/_emdash");

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});

const navItems = menu?.items ?? [];
const menuActive = (url: string) => {
	const target = url.replace(/\/$/, "") || "/";
	return target !== "/" && (path === target || path.startsWith(`${target}/`));
};
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
			<symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21.5s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" /><circle cx="12" cy="10.4" r="2.5" /></symbol>
			<symbol id="i-phone" viewBox="0 0 24 24"><path d="M6.6 3.5h3l1.5 4-2 1.4a12 12 0 0 0 4.9 4.9l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4.5 5.7 2 2 0 0 1 6.6 3.5z" /></symbol>
			<symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.2" /><path d="M4 7.2l8 5.8 8-5.8" /></symbol>
			<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 1.8" /></symbol>
		</defs></svg>
		<header class="site-head">
			<a class="brand" href="/">
				<img class="logo" src={logoSrc} alt={logoAlt} width="38" height="38" />
				<div>
					<b>{siteTitle}</b>
					<span>{siteTagline}</span>
				</div>
			</a>
			<nav class="nav" aria-label="Điều hướng chính">
				{
					navItems.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							class={menuActive(item.url) ? "on" : undefined}
						>
							{item.label}
						</a>
					))
				}
			</nav>
			<div class="head-actions">
				{isAdmin ? <a class="btn btn-line btn-sm" href="/">Về trang chủ</a> : <a class="btn btn-red btn-sm" href="/_emdash/admin">Đăng nhập</a>}
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-foot">
			<div class="foot-grid">
				<div>
					<div class="brand" style="margin-bottom:12px">
						<img
							class="logo"
							src={logoSrc}
							alt={logoAlt}
							width="34"
							height="34"
							style="width:34px;height:34px"
						/>
						<div style="color:#fff">
							<b style="color:#fff">{siteTitle}</b>
							<span style="color:var(--muted-2)">{siteTagline}</span>
						</div>
					</div>
					<div class="foot-principles">
						<span>Nhân đạo</span><span>Vô tư</span><span>Trung lập</span><span>Độc lập</span><span
							>Tự nguyện</span
						><span>Thống nhất</span><span>Toàn cầu</span>
					</div>
				</div>
				<div>
					<b>Về Hội</b>
					<a href="/ve-hoi">Giới thiệu</a>
					<a href="/bo-may">Ban Thường vụ</a>
					<a href="/ban-tin">Bản tin</a>
				</div>
				<div>
					<b>Minh bạch</b>
					<a href="/quy">Quỹ &amp; thu–chi</a>
					<a href="/van-ban">Văn bản, quyết định</a>
				</div>
				<div>
					<b>Liên hệ</b>
					<a href="/lien-he">Trang liên hệ</a>
					<a href="/lien-he">Gửi câu hỏi</a>
				</div>
			</div>
			<div class="foot-bot">
				<span>© 2026 {siteTitle}. Bảo lưu mọi quyền.</span>
				<span>Phát triển trên Astro + EmDash CMS</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
