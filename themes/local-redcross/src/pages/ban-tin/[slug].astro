---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const categories = post.data.terms?.category ?? [];
const tags = post.data.terms?.tag ?? [];
const hero = post.data.featured_image?.src
	? `url('${post.data.featured_image.src}'),linear-gradient(135deg,#7a0e14,#E11923)`
	: "linear-gradient(135deg,#7a0e14,#E11923)";
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="article-hero" style={`background-image:${hero}`}>
		<div class="article-title">
			{categories.length > 0 && <span class="cat">{categories[0].label.toUpperCase()}</span>}
			<h1>{post.data.title}</h1>
			<div class="meta">
				{post.data.publishedAt && <span>{post.data.publishedAt.toLocaleDateString("vi-VN")}</span>}
				{post.data.byline?.displayName && <span>· {post.data.byline.displayName}</span>}
			</div>
		</div>
	</div>
	<div class="layout-side">
		<nav class="side-nav" aria-label="Mục lục">
			<a class="on" href="/ban-tin">← Về Bản tin</a>
			<a href="/quy">Minh bạch quỹ</a>
			<a href="/lien-he">Liên hệ tham gia</a>
		</nav>
		<div class="article-body">
			{post.data.excerpt && <p style="font-size:16px;font-weight:600">{post.data.excerpt}</p>}
			<PortableText value={post.data.content} />
			{
				tags.length > 0 && (
					<div class="article-tags">
						{categories.map((c) => (
							<span class="tag">{c.label}</span>
						))}
						{tags.map((t) => (
							<span class="tag">#{t.label}</span>
						))}
					</div>
				)
			}
			<div class="author-box">
				<div class="av">{siteTitle.slice(0, 2).toUpperCase()}</div>
				<div>
					<b>{post.data.byline?.displayName ?? "Ban Truyền thông"}</b>
					<span>{siteTitle}</span>
				</div>
			</div>
			<div class="post-nav" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:28px">
				<a class="btn btn-line" href="/ban-tin">← Xem tất cả bản tin</a>
				<a class="btn btn-line" href="/van-ban">Văn bản &amp; quyết định →</a>
			</div>
		</div>
	</div>
</Base>
