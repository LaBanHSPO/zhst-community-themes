---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<div class="notfound-copy">
			<p class="eyebrow">Error 404</p>
			<h1 id="nf-title" class="display display-xl">This page wandered off.</h1>
			<p class="lede">The page you are looking for has moved or never existed. These are good places to start again.</p>
			<div class="actions">
				<a class="pill" href="/"><span>Back to home</span><Arrow /></a>
				<a class="pill pill-line" href="/work">Work</a>
				<a class="pill pill-line" href="/contact">Contact</a>
			</div>
		</div>
		<img class="notfound-photo" src="/images/plant.webp" alt="A leafy houseplant in a marble pot in soft window light" width="600" height="940" />
	</section>
</Base>
