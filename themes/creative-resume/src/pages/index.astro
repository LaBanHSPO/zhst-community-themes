---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ContactBand from "../components/ContactBand.astro";
import Timeline from "../components/Timeline.astro";
import WorkCard from "../components/WorkCard.astro";
import { getExperience, getProjects, getSkills, getStudio, lines } from "../lib/site";

const [projectsResult, experienceResult, skillsResult, studioResult] = await Promise.all([
	getProjects(),
	getExperience(),
	getSkills(),
	getStudio(),
]);
if (Astro.cache?.enabled) {
	for (const r of [projectsResult, experienceResult, skillsResult, studioResult]) Astro.cache.set(r.cacheHint);
}
const allProjects = projectsResult.entries;
const featured = allProjects.filter((p) => p.data.featured);
const selected = (featured.length > 0 ? featured : allProjects).slice(0, 3);
const work = experienceResult.entries.filter((e) => e.data.kind !== "education").slice(0, 3);
const skills = skillsResult.entries;
---

<Base
	home
	title="Curiosity, craft, and fresh ideas"
	description="CreativeResume is the resume site of Mara Ellison, a multidisciplinary designer. See selected projects in brand, web, product and print, read the experience timeline and get in touch."
>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-inner">
			<img
				class="hero-art"
				src="/images/hero.webp"
				alt="Mara, a designer with freckles and a messy bun in a black knit sweater, resting her chin on one hand and looking up, in front of a terracotta circle, torn paper and a dark-leaved plant"
				width="908"
				height="700"
				fetchpriority="high"
			/>
			<div class="hero-copy">
				<p class="hero-eyebrow">Designer <i>/</i> Creative thinker <i>/</i> Problem solver</p>
				<h1 id="hero-title" class="hero-title">
					<span class="hl">Curiosity, craft,</span>
					<span class="hl">and fresh <span class="hl-u">ideas.<svg class="stroke" viewBox="0 0 232 22" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M2 14C58 10 128 4.500 229 2C206 8.500 150 13.500 100 16.500C64 18.500 30 20.500 3 21.500Z" fill="currentColor" /></svg></span></span>
				</h1>
				<p class="hero-sub">I’m a multidisciplinary designer who turns <br />curiosity into meaningful digital experiences.</p>
				<a class="pill pill-lg" href="/about"><span>Explore my profile</span><Arrow /></a>
			</div>
			<p class="hero-motto"><i aria-hidden="true"></i><span>Good ideas</span><span>travel far.</span></p>
			<p class="hand" aria-hidden="true"><span>Different</span><span>perspectives</span><span>brighter</span><span>solutions.</span><i></i></p>
			<p class="hero-caption" aria-hidden="true"><span>Design</span><span>People</span><span>Ideas</span><span>A kinder</span><span>Internet</span><i></i></p>
		</div>
	</section>

	<section class="selected" aria-labelledby="selected-title">
		<div class="selected-inner">
			<div class="selected-head">
				<p class="eyebrow">Featured work</p>
				<h2 id="selected-title" class="display display-lg">Selected<br />Projects</h2>
				<p class="selected-note">A few recent explorations at the intersection<br />of design, technology, and human ideas.</p>
				<a class="text-link" href="/work"><span>View all work</span><Arrow /></a>
			</div>
			<ul class="selected-grid">
				{selected.map((p, i) => <li><WorkCard project={p} eager={i < 3} /></li>)}
			</ul>
		</div>
	</section>

	{
		work.length > 0 && (
			<section class="experience" aria-labelledby="exp-title">
				<div class="wrap split">
					<div class="split-head">
						<p class="eyebrow">Experience</p>
						<h2 id="exp-title" class="display display-lg">Where I’ve<br />worked</h2>
						<p class="split-note">Three recent roles, newest first. The full list is on the About page.</p>
						<a class="text-link" href="/about#resume"><span>Read the full resume</span><Arrow /></a>
					</div>
					<Timeline entries={work} />
				</div>
			</section>
		)
	}

	{
		skills.length > 0 && (
			<section class="skills" aria-labelledby="skills-title">
				<div class="wrap split">
					<div class="split-head">
						<p class="eyebrow">Skills &amp; tools</p>
						<h2 id="skills-title" class="display display-lg">What I use<br />every week</h2>
						<p class="split-note">Listed plainly, with no bars or percentages.</p>
					</div>
					<div class="skill-groups">
						{skills.map((s) => (
							<div class="skill-group">
								<h3 {...s.edit.title}>{s.data.title}</h3>
								<ul>{lines(s.data.items).map((item) => <li>{item}</li>)}</ul>
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}

	<ContactBand studio={studioResult.studio} />
</Base>
