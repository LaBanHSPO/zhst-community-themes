---
import Base from "../layouts/Base.astro";
import { REASONS, getStudio, profileLinks, telHref } from "../lib/site";

const { studio, cacheHint } = await getStudio();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// ?reason=role|freelance|other pre-selects the reason (links from work pages and the "Currently open to" band).
const wanted = Astro.url.searchParams.get("reason");
const selected = REASONS.find((r) => r.slug === wanted);
const links = profileLinks(studio.links);
---

<Base
	title="Contact"
	description="Write to Mara Ellison about a full-time role, a freelance project or anything else. Pick a reason, add a few lines and your email app opens with the message ready. Email and phone are always listed."
>
	<div class="contact">
		<section class="contact-panel" aria-labelledby="contact-title">
			<p class="eyebrow">Contact</p>
			<h1 id="contact-title" class="display display-xl">Tell me what you have in mind.</h1>
			<p class="lede">A few lines are enough. I reply myself, usually within two working days.</p>

			<form
				class="contact-form"
				data-contact-form
				data-email={studio.email}
				action={studio.email ? `mailto:${studio.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field">
						<label for="q-name">Your name</label>
						<input id="q-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="q-name"></span>
					</div>
					<div class="field">
						<label for="q-email">Email</label>
						<input id="q-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="q-email"></span>
					</div>
					<div class="field full">
						<label for="q-reason">What is this about?</label>
						<select id="q-reason" name="reason" required>
							<option value="" selected={!selected}>Choose an option</option>
							{REASONS.map((r) => <option value={r.label} selected={selected?.slug === r.slug}>{r.label}</option>)}
						</select>
						<span class="field-error" data-error-for="q-reason"></span>
					</div>
					<div class="field">
						<label for="q-company">Company or studio <span class="optional">(optional)</span></label>
						<input id="q-company" name="company" type="text" autocomplete="organization" />
					</div>
					<div class="field">
						<label for="q-start">When would it start? <span class="optional">(optional)</span></label>
						<select id="q-start" name="start">
							<option value="" selected>Not sure yet</option>
							<option>As soon as possible</option>
							<option>In one to three months</option>
							<option>Later this year</option>
						</select>
					</div>
					<div class="field full">
						<label for="q-notes">Your message</label>
						<textarea id="q-notes" name="notes" rows="5" maxlength="800" placeholder="What it is, who it is for, and anything you already have: a brief, a deadline, a link." required></textarea>
						<span class="field-error" data-error-for="q-notes"></span>
					</div>
				</div>
				<button class="pill pill-block" type="submit"><span>Send message</span></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{studio.email && <>Write to <a href={`mailto:${studio.email}`}>{studio.email}</a> and say what it is about.</>}
					</noscript>
				</p>
			</form>
		</section>

		<aside class="contact-aside">
			<img src="/images/portrait-collage.webp" alt="Mara resting her chin on one hand, with a terracotta circle and torn grey paper behind her" width="960" height="1050" />
			<div class="contact-details">
				<h2>Prefer to write or call?</h2>
				<p>
					{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}
					{studio.phone && <a href={telHref(studio.phone)}>{studio.phone}</a>}
					{studio.base && <span>{studio.base}</span>}
				</p>
				{studio.availability && <p class="small">{studio.availability}</p>}
				{studio.response && <p class="small">{studio.response}</p>}
				{studio.note && <p class="small">{studio.note}</p>}
				{
					links.length > 0 && (
						<ul class="contact-links" aria-label="Profile links">
							{links.map((l) => <li><a href={l.url} rel="noopener noreferrer">{l.label}</a></li>)}
						</ul>
					)
				}
			</div>
		</aside>
	</div>
</Base>

<script>
	// Compose an email to Mara. Nothing is sent or stored by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input[required], select[required], textarea[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online messages are not available right now. Please call instead.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `${get("reason")}: message from ${get("name")}`;
			const lines = [
				"Hello Mara,",
				"",
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				`About: ${get("reason")}`,
				get("company") ? `Company or studio: ${get("company")}` : "",
				get("start") ? `Start: ${get("start")}` : "",
				"",
				get("notes"),
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this message ready to send. It is only sent when you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
