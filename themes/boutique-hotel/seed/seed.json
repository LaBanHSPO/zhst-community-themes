  "content": {
    "pages": [
      {
        "id": "about",
        "slug": "about",
        "status": "published",
        "data": {
          "title": "A small house on a hill.",
          "eyebrow": "About",
          "intro": "Elmwood is a six-room hotel in the village of Valmora, run by a team of five.",
          "content": [
            {
              "_type": "block",
              "_key": "k136",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "The house",
                  "_key": "k137"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k138",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Elmwood was built in 1931 as a doctor's home, with thick stone walls and a chestnut tree that still stands by the gate. It was a boarding house for a while, then stood empty for years.",
                  "_key": "k139"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k140",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "The present owners bought it in 2016. They kept the walls, the tile floors and the shutters, and added bathrooms and heating. It opened as a hotel in spring 2018.",
                  "_key": "k141"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k142",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "How we run it",
                  "_key": "k143"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k144",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "With six rooms we know every guest by name. Breakfast is cooked to order, and the menu on the table says where the eggs, honey and cheese came from.",
                  "_key": "k145"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k146",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "We answer booking requests ourselves, usually the same day. If we are full, we say so and suggest other dates or another house in the village.",
                  "_key": "k147"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k148",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "What it is not",
                  "_key": "k149"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k150",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "There is no pool, no spa and no lift. The house has stairs, and the upper rooms are up one or two flights. If that is a problem, ask for the ground floor when you send your request.",
                  "_key": "k151"
                }
              ],
              "markDefs": []
            }
          ]
        }
      },
      {
        "id": "policies",
        "slug": "policies",
        "status": "published",
        "data": {
          "title": "House policies",
          "eyebrow": "Policies",
          "intro": "The short version of how a stay works. Please read it before you send a request.",
          "content": [
            {
              "_type": "block",
              "_key": "k152",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Check-in and check-out",
                  "_key": "k153"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k154",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Check-in is from 3:00 pm and check-out is by 11:00 am. If you arrive earlier we will keep your bags and tell you when the room is ready. If you will arrive after 10:00 pm, tell us in your request so we can arrange a key.",
                  "_key": "k155"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k156",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Cancellation",
                  "_key": "k157"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k158",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Sample text, replace it with your own terms before you publish. You can cancel free of charge up to 7 days before arrival. After that we charge the first night. If you do not arrive and have not told us, we charge the full stay.",
                  "_key": "k159"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k160",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Payment",
                  "_key": "k161"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k162",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Nothing is charged when you send a request. When we confirm your dates we will tell you the total and how to pay. The tourist tax is paid at check-out.",
                  "_key": "k163"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k164",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Pets",
                  "_key": "k165"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k166",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Dogs under 15 kg are welcome in the Garden Room and the Courtyard Single for $15 per stay. They are not allowed in the dining room or on the terrace at breakfast.",
                  "_key": "k167"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k168",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Children",
                  "_key": "k169"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k170",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Children of any age are welcome. Travel cots are free, so ask when you send your request. The Family Loft and the Lake Suite each sleep four.",
                  "_key": "k171"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k172",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "text": "Quiet hours",
                  "_key": "k173"
                }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "k174",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Quiet hours run from 10:00 pm to 7:30 am. The walls are thick, but the stairs are wooden.",
                  "_key": "k175"
                }
              ],
              "markDefs": []
            }
          ]
        }
      }
    ],
