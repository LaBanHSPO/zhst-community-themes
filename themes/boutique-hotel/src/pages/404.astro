---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<div class="wrap notfound-inner">
			<div class="notfound-copy">
				<p class="eyebrow"><span>Error 404</span><span class="rule" aria-hidden="true"></span></p>
				<h1 id="nf-title" class="display">This page is not on the map.</h1>
				<p class="lede">The page you are looking for has moved or never existed. Here are a few places to start.</p>
				<div class="actions">
					<a class="btn btn-dark" href="/">Back to home <Arrow /></a>
					<a class="btn btn-ghost" href="/rooms">Rooms</a>
					<a class="btn btn-ghost" href="/contact">Book</a>
				</div>
			</div>
			<img class="notfound-photo" src="/images/bench.webp" alt="" width="870" height="384" />
		</div>
	</section>
</Base>
