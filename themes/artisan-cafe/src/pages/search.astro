---
import Base from "../layouts/Base.astro";
import ItemPhoto from "../components/ItemPhoto.astro";
import { getItems, itemUrl, photoSrc, sectionLabel } from "../lib/cafe";

const { entries: items, cacheHint } = await getItems();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 80);
const needle = q.toLowerCase();
const results = needle
	? items.filter((i) =>
			[i.data.title, i.data.summary, i.data.description, i.data.ingredients]
				.filter(Boolean)
				.some((t) => String(t).toLowerCase().includes(needle)),
		)
	: [];
const suggestions = ["croissant", "oat milk", "cinnamon", "chai"];
---

<Base title={q ? `Search: ${q}` : "Search"} description="Search the café menu.">
	<section class="search-page">
		<span class="eyebrow">Search</span>
		<h1>Find something good.</h1>
		<form class="search-form" action="/search" method="get" role="search">
			<label class="sr-only" for="q">Search for a drink, pastry or ingredient</label>
			<input id="q" name="q" type="search" value={q} placeholder="Try “almond” or “oat milk”" />
			<button class="btn" type="submit">Search</button>
		</form>
		{
			!q && (
				<p class="search-hint">
					Popular:
					{suggestions.map((s) => (
						<a href={`/search?q=${encodeURIComponent(s)}`}>{s}</a>
					))}
				</p>
			)
		}
		{
			q && (
				<p class="search-count" role="status">
					{results.length === 0
						? `Nothing on the menu matches “${q}”.`
						: `${results.length} result${results.length === 1 ? "" : "s"} for “${q}”`}
				</p>
			)
		}
		{
			results.length > 0 && (
				<ul class="search-results">
					{results.map((r) => (
						<li>
							<a href={itemUrl(r.data)}>
								<ItemPhoto src={photoSrc(r.data.image, r.data.photo)} alt="" />
								<span>
									<span class="eyebrow no-rule">{sectionLabel(r.data.category)}</span>
									<strong>{r.data.title}</strong>
									{r.data.summary && <span class="sub">{r.data.summary}</span>}
								</span>
								<span class="price">{r.data.price}</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</Base>
