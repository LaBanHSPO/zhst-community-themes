---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found" overlay>
	<section class="photo-hero notfound-hero" style="--hero-img:url('/images/hero-home.webp')">
		<div class="container notfound">
			<span class="eyebrow on-dark">404 · Page not found</span>
			<h1>This cup<br />is empty.</h1>
			<p>The page you were looking for has moved or never existed. The coffee, happily, is still warm.</p>
			<div class="actions">
				<a class="btn" href="/menu">View menu <Arrow /></a>
				<a class="btn btn-ghost" href="/">Back to home</a>
			</div>
		</div>
	</section>
</Base>
