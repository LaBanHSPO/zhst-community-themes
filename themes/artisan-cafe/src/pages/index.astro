---
import { getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import FavGrid from "../components/FavGrid.astro";
import Hours from "../components/Hours.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getHours, getItems, getVenue } from "../lib/cafe";

const [itemsResult, hoursResult, venueResult, settings] = await Promise.all([
	getItems(),
	getHours(),
	getVenue(),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(itemsResult.cacheHint);
	Astro.cache.set(hoursResult.cacheHint);
	Astro.cache.set(venueResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const favourites = itemsResult.entries.filter((i) => i.data.featured).slice(0, 4);
const { venue } = venueResult;
---

<Base title={siteTitle} description="Handcrafted espresso and fresh pastries, made slowly in a warm neighbourhood café." overlay>
	<section class="photo-hero hero-home" style="--hero-img:url('/images/hero-home.webp')" aria-labelledby="hero-title">
		<div class="hero-copy">
			<h1 id="hero-title">Coffee,<br />made slowly.</h1>
			<p class="hero-sub">Handcrafted espresso<br />and fresh pastries</p>
			<a class="btn" href="/menu">View menu <Arrow /></a>
		</div>
		<div class="hero-marker" aria-hidden="true">
			<div class="container"><span>Better coffee<br />Brighter days</span></div>
		</div>
	</section>

	<section class="kitchen" aria-labelledby="kitchen-title">
		<div class="kitchen-copy">
			<span class="eyebrow">From our kitchen</span>
			<h2 id="kitchen-title">Small batches.<br />A brighter day.</h2>
			<p>Thoughtfully sourced coffee, house-baked pastries, and a welcoming space to slow down.</p>
			<a class="link-arrow" href="/menu"><span>Explore our menu</span> <Arrow /></a>
		</div>
		<figure class="kitchen-photo">
			<img src="/images/cinnamon-bun.webp" alt="Glazed cinnamon buns on a baking tray next to a chalkboard reading “Fresh pastries daily”" width="351" height="356" loading="lazy" />
		</figure>
		<figure class="kitchen-photo is-wide">
			<img src="/images/interior.webp" alt="Quiet corner of the café with wooden tables, a pendant lamp and plants by the window" width="424" height="356" loading="lazy" />
		</figure>
	</section>

	{
		favourites.length > 0 && (
			<section class="counter" aria-labelledby="counter-title">
				<div class="container">
					<div class="section-head">
						<div>
							<span class="eyebrow">On the counter today</span>
							<h2 class="section-title" id="counter-title">Our regulars’ favourites.</h2>
						</div>
						<a class="link-arrow" href="/menu"><span>See the full menu</span> <Arrow /></a>
					</div>
					<FavGrid items={favourites} />
				</div>
			</section>
		)
	}

	<section class="band" aria-labelledby="visit-title">
		<div class="band-inner">
			<div class="band-photo" style="--band-img:url('/images/croissant-latte.webp')" role="img" aria-label="A latte and a croissant on a wooden table in warm morning light"></div>
			<div class="band-copy">
				<span class="eyebrow">Visit us</span>
				<h2 class="section-title" id="visit-title">Come in.<br />Stay a while.</h2>
				<p class="band-lede">Warm wood, soft lamps and a window seat that is always worth the wait.</p>
				<div class="band-facts">
					<div>
						<h3>Find us</h3>
						<address>
							{venue.street && <>{venue.street}<br /></>}
							{venue.locality}
						</address>
					</div>
					<div>
						<h3>Opening hours</h3>
						<Hours rows={hoursResult.entries} />
					</div>
				</div>
				<a class="btn btn-ghost btn-sm" href="/visit">Plan your visit <Arrow /></a>
			</div>
		</div>
	</section>
</Base>
