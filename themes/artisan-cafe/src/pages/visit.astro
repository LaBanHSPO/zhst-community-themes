---
import Base from "../layouts/Base.astro";
import Hours from "../components/Hours.astro";
import Arrow from "../components/Arrow.astro";
import { getHours, getVenue, mapUrl } from "../lib/cafe";

const [{ venue, cacheHint }, hoursResult] = await Promise.all([getVenue(), getHours()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(hoursResult.cacheHint);
}
const mapHref = mapUrl(venue);
const today = new Intl.DateTimeFormat("en-US", { weekday: "long", timeZone: "Asia/Saigon" }).format(new Date());
---

<Base title="Visit" description={`Opening hours, address and directions for ${venue.title}.`}>
	<div class="container visit">
		<div class="visit-head">
			<span class="eyebrow">Visit</span>
			<h1>Come in,<br />slow down.</h1>
			<p>Pull up a chair by the window. Walk-ins only. There is usually a seat, and always a cup.</p>
		</div>

		<div class="visit-grid">
			<section class="visit-card" aria-labelledby="hours-title">
				<h2 id="hours-title">Opening hours</h2>
				{hoursResult.entries.length > 0 ? <Hours rows={hoursResult.entries} /> : <p class="note">Opening hours coming soon.</p>}
				<p class="today">Today is {today}</p>
				<p class="note">Kitchen closes thirty minutes before the doors. Holiday hours are posted on the door and here.</p>
			</section>

			<section class="visit-card" aria-labelledby="where-title">
				<h2 id="where-title">Where to find us</h2>
				<address>
					{venue.title}<br />
					{venue.street && <>{venue.street}<br /></>}
					{venue.locality && <>{venue.locality}<br /></>}
					{venue.country}
				</address>
				<div class="contact">
					{venue.phone && <a href={`tel:${venue.phone.replace(/[^\d+]/g, "")}`}>{venue.phone}</a>}
					{venue.email && <a href={`mailto:${venue.email}`}>{venue.email}</a>}
				</div>
				{venue.getting_here && <p class="note">{venue.getting_here}</p>}
				{venue.seating && <p class="note">{venue.seating}</p>}
				{
					mapHref && (
						<a class="link-arrow" href={mapHref} target="_blank" rel="noopener noreferrer">
							<span>Open in Google Maps</span> <Arrow />
						</a>
					)
				}
			</section>

			<figure class="visit-photo">
				<img src="/images/interior.webp" alt="Inside the café: wooden tables, a pendant lamp and plants in the window light" width="424" height="356" loading="lazy" />
			</figure>
		</div>
	</div>
</Base>
