---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";

// The about copy is the CMS page with slug "about"; the layout and photos belong to the theme.
const { entry: page, cacheHint } = await getEmDashEntry("pages", "about");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const intro = page?.data.intro || "A small neighbourhood café that roasts carefully and bakes at dawn.";
---

<Base
	title={page?.data.title || "About"}
	description={intro}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
	overlay
>
	<section class="photo-hero page-hero" style="--hero-img:url('/images/croissant-latte.webp')" aria-labelledby="about-title">
		<div class="container">
			<span class="eyebrow">{page?.data.title || "About"}</span>
			<h1 id="about-title" class="is-long">{intro}</h1>
		</div>
	</section>

	<div class="container about-body">
		<div class="prose">
			{page?.data.content ? <PortableText value={page.data.content} /> : <p>Add a page with the slug “about” in the admin to tell your story here.</p>}
		</div>
		<div class="about-photos">
			<img src="/images/interior.webp" alt="Café corner with a pendant lamp, wooden chairs and plants" width="424" height="356" loading="lazy" />
			<img src="/images/cinnamon-bun.webp" alt="Freshly glazed cinnamon buns" width="351" height="356" loading="lazy" />
		</div>
	</div>

	<section class="band" aria-labelledby="taste-title">
		<div class="band-inner">
			<div class="band-copy">
				<span class="eyebrow">Taste it for yourself</span>
				<h2 class="section-title" id="taste-title">There is always time<br />for one more cup.</h2>
				<p class="band-lede">See what is on the bar and in the oven today.</p>
				<a class="btn btn-sm" href="/menu">View menu <Arrow /></a>
			</div>
			<div class="band-photo" style="--band-img:url('/images/hero-home.webp')" role="img" aria-label="Cappuccino in a speckled Artisan Café mug beside almond croissants"></div>
		</div>
	</section>
</Base>
