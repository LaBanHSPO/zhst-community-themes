---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import FavGrid from "../../components/FavGrid.astro";
import ItemPhoto from "../../components/ItemPhoto.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getItems, photoSrc, sectionLabel } from "../../lib/cafe";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: item, cacheHint } = await getEmDashEntry("items", slug);
if (!item) return Astro.redirect("/404");
const [{ entries: all, cacheHint: listHint }, settings] = await Promise.all([getItems(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(listHint);
}

const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(item, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const d = item.data;
const src = photoSrc(d.image, d.photo);
const section = sectionLabel(d.category);
const more = all.filter((i) => i.data.category === d.category && i.data.id !== d.id).slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary ?? null}
	canonical={seo.canonical}
	image={seo.ogImage ?? src ?? null}
	content={{ collection: "items", id: d.id, slug }}
	current="/menu"
>
	<div class="container">
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href="/menu">Menu</a><span aria-hidden="true">/</span><a href={`/menu#${d.category}`}>{section}</a>
		</nav>
		<article class="item-detail">
			<ItemPhoto src={src} alt={d.image?.alt || d.title} eager />
			<div class="item-info">
				<span class="eyebrow">{section}</span>
				<h1 {...item.edit.title}>{d.title}</h1>
				<p class="price-lg">{d.price}</p>
				{d.description ? <p class="desc" {...item.edit.description}>{d.description}</p> : d.summary && <p class="desc">{d.summary}</p>}
				{
					(d.ingredients || d.allergens) && (
						<dl class="facts">
							{d.ingredients && (
								<div>
									<dt>What’s in it</dt>
									<dd>{d.ingredients}</dd>
								</div>
							)}
							{d.allergens && (
								<div>
									<dt>Allergens</dt>
									<dd>{d.allergens}</dd>
								</div>
							)}
						</dl>
					)
				}
				<div class="item-actions">
					<a class="btn btn-sm" href="/visit">Find the café <Arrow /></a>
					<a class="btn btn-sm btn-line" href="/menu">Back to the menu</a>
				</div>
			</div>
		</article>
	</div>

	{
		more.length > 0 && (
			<section class="more" aria-labelledby="more-title">
				<div class="container">
					<div class="section-head">
						<div>
							<span class="eyebrow">Also in {section.toLowerCase()}</span>
							<h2 class="section-title" id="more-title">You might also like.</h2>
						</div>
					</div>
					<FavGrid items={more} />
				</div>
			</section>
		)
	}
</Base>
