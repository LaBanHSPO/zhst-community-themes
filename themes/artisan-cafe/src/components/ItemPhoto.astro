---
/** Item photo with a quiet branded fallback when an entry has no image. */
import Leaf from "./Leaf.astro";

interface Props {
	src?: string;
	alt: string;
	class?: string;
	eager?: boolean;
}

const { src, alt, class: className, eager = false } = Astro.props;
---

<div class:list={["ph", className]}>
	{
		src ? (
			<img src={src} alt={alt} loading={eager ? "eager" : "lazy"} decoding="async" />
		) : (
			<div class="ph-fallback" role="img" aria-label={alt}>
				<Leaf />
			</div>
		)
	}
</div>
