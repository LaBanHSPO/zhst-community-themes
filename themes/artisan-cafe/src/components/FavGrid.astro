---
/** Grid of menu item cards (homepage favourites, "more from" rows). */
import ItemPhoto from "./ItemPhoto.astro";
import { itemUrl, photoSrc, type Item } from "../lib/cafe";

interface Props {
	items: { data: Item }[];
}

const { items } = Astro.props;
---

<ul class="fav-grid">
	{
		items.map(({ data }) => (
			<li>
				<a class="fav" href={itemUrl(data)}>
					<ItemPhoto src={photoSrc(data.image, data.photo)} alt={data.image?.alt || data.title} />
					<div class="fav-meta">
						<h3>{data.title}</h3>
						<span class="price">{data.price}</span>
					</div>
					{data.summary && <p>{data.summary}</p>}
				</a>
			</li>
		))
	}
</ul>
