---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { getPackages, lines, photoSrc } from "../lib/outline";

const { entries, cacheHint } = await getPackages();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base
	title="Services & packages"
	description="Strategic design for ambitious brands. Choose a package that fits your goals, or get in touch for a custom proposal."
	headCta={false}
>
	<section class="hero hero-sub">
		<div class="hero-copy">
			<p class="eyebrow">Services &amp; packages.</p>
			<h1>
				<span class="line">Brand and</span>
				<span class="line accent">website design.</span>
			</h1>
			<p class="lead">
				Strategic design for ambitious brands. Choose a package that fits your goals, or get in touch for a custom
				proposal.
			</p>
			<a class="btn" href="/start-a-project">Start a project <Arrow /></a>
		</div>
		<div class="hero-photo">
			<img
				src="/images/hero-desk.webp"
				alt="Studio desk in front of a vermilion wall with a vase of olive branches, a stack of design books and a laptop"
				width="770"
				height="553"
			/>
		</div>
	</section>

	<section class="section packages" aria-labelledby="packages-title">
		<div class="section-head packages-head">
			<h2 id="packages-title" class="h2">Our packages</h2>
			<p>Each package combines strategy, design and development, with ongoing support to help your brand grow.</p>
		</div>
		<ol class="package-grid">
			{
				entries.map((e) => {
					const src = photoSrc(e.data.image, e.data.photo);
					const items = lines(e.data.includes);
					const slug = e.data.slug ?? e.data.id;
					return (
						<li class="package" id={slug}>
							<span class="package-no">{e.data.number}</span>
							<h3>{e.data.title}</h3>
							<p class="package-summary">{e.data.summary}</p>
							{src && <img src={src} alt={e.data.image?.alt || e.data.alt || `${e.data.title} sample work`} loading="lazy" />}
							<div class="package-price">
								<strong>{e.data.price}</strong>
								<a class="text-link" href={`#${slug}-included`}>
									What’s included <Arrow />
								</a>
							</div>
							<div class="package-foot">
								<ul class="checks" id={`${slug}-included`} aria-label={`${e.data.title}: what’s included`}>
									{items.map((i) => (
										<li>
											<svg width="12" height="10" viewBox="0 0 12 10" aria-hidden="true" focusable="false">
												<path d="m1 5 3.2 3.2L11 1.4" fill="none" stroke="currentColor" stroke-width="1.4" />
											</svg>
											{i}
										</li>
									))}
								</ul>
								<a class="btn btn-sm" href={`/start-a-project?service=${encodeURIComponent(slug)}`}>
									Get started <Arrow />
								</a>
							</div>
						</li>
					);
				})
			}
		</ol>
	</section>

	<section class="cta-band" aria-labelledby="cta-title">
		<h2 id="cta-title" class="h2">Need something custom?</h2>
		<a class="btn" href="/start-a-project">Start a project <Arrow /></a>
	</section>
</Base>
