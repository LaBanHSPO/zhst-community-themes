---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="page-hero notfound">
		<p class="eyebrow">404</p>
		<h1>
			<span class="line">Page not</span>
			<span class="line accent">found.</span>
		</h1>
		<p class="lead">The page you’re looking for doesn’t exist or has moved.</p>
		<div class="actions">
			<a class="btn" href="/work">See our work <Arrow /></a>
			<a class="btn btn-ghost" href="/">Back to the homepage</a>
		</div>
	</section>
</Base>
