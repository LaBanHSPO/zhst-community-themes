---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects, lines, photoSrc } from "../../lib/outline";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: project, cacheHint } = await getEmDashEntry("projects", slug);
if (!project) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { entries: all } = await getProjects();
const more = all.filter((e) => e.data.listed !== false && e.data.id !== project.data.id).slice(0, 3);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(project, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const d = project.data;
const hero = photoSrc(d.image, d.photo);
const deliverables = lines(d.deliverables);
const gallery = (d.gallery ?? []).filter((g) => g.image?.src || g.photo);
const lead = d.headline_lead ?? d.title;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary}
	canonical={seo.canonical}
	content={{ collection: "projects", id: d.id, slug }}
>
	<section class="hero hero-case">
		<div class="hero-copy">
			<p class="eyebrow">Brand. Web. Creative.</p>
			<h1 {...project.edit.title}>
				<span class="line">{lead}</span>
				{d.headline_accent && <span class="line accent">{d.headline_accent}</span>}
			</h1>
			{d.lead && <p class="lead">{d.lead}</p>}
		</div>
		{
			hero && (
				<div class="hero-photo">
					<img src={hero} alt={d.image?.alt || `${d.title} — project artwork`} />
				</div>
			)
		}
	</section>

	<section class="case-body" aria-label={`${d.title} case study`}>
		<div class="case-col">
			<p class="eyebrow">The challenge</p>
			<h2 class="h3">{d.challenge_title}</h2>
			<p>{d.challenge}</p>
		</div>
		<div class="case-col">
			<p class="eyebrow">Our approach</p>
			<h2 class="h3">{d.approach_title}</h2>
			<p>{d.approach}</p>
		</div>
		<div class="case-col">
			<p class="eyebrow">Deliverables</p>
			<h2 class="sr-only">Deliverables</h2>
			<ul class="deliverables">
				{deliverables.map((x) => <li>{x}</li>)}
			</ul>
		</div>
	</section>

	{
		gallery.length > 0 && (
			<section class="case-gallery" aria-label="Project imagery">
				{gallery.map((g) => (
					<figure>
						<img src={g.image?.src ?? g.photo ?? ""} alt={g.alt} loading="lazy" />
					</figure>
				))}
			</section>
		)
	}

	<section class="section more-work" aria-labelledby="more-work-title">
		<div class="section-head">
			<h2 id="more-work-title" class="h2">More work</h2>
			<a class="text-link" href="/work">View all work <Arrow /></a>
		</div>
		<div class="work-grid is-home">
			{more.map((e) => <ProjectCard project={e.data} />)}
		</div>
	</section>

	<section class="cta-band" aria-labelledby="cta-title">
		<h2 id="cta-title" class="h2">Have a project in mind?</h2>
		<a class="btn" href="/start-a-project">Start a project <Arrow /></a>
	</section>
</Base>
