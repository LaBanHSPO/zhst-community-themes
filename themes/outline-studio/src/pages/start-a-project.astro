---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { getPackages, getStudio } from "../lib/outline";

const [{ studio, cacheHint }, { entries: packages }] = await Promise.all([getStudio(), getPackages()]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const wanted = Astro.url.searchParams.get("service") ?? "";
const services = [
	...packages.map((p) => ({ value: p.data.slug ?? p.data.id, label: p.data.title })),
	{ value: "not-sure", label: "Not sure yet" },
];
const budgets = ["Under $6,000", "$6,000 – $12,000", "$12,000 – $25,000", "$25,000 or more", "Monthly partnership"];
const timelines = ["As soon as possible", "Within 1–2 months", "In 3–6 months", "Just exploring"];
const response = studio.response ?? "2 business days";
---

<Base
	title="Start a project"
	description="Share a few details and we’ll get back to you to set up a conversation."
	headCta={false}
>
	<section class="enquiry">
		<div class="enquiry-copy">
			<p class="eyebrow">Let’s make it happen.</p>
			<h1>
				<span class="line">Tell us</span>
				<span class="line">about your</span>
				<span class="line accent">project.</span>
			</h1>
			<p class="lead">
				Share a few details and we’ll get back to you within {response} to set up a conversation.
			</p>
		</div>

		<form
			class="enquiry-form"
			data-enquiry-form
			data-email={studio.email}
			action={`mailto:${studio.email}`}
			method="post"
			enctype="text/plain"
		>
			<div class="form-grid">
				<div class="field">
					<label for="f-name">Your name <span class="req" aria-hidden="true">*</span></label>
					<input id="f-name" name="name" type="text" autocomplete="name" placeholder="Jane Cooper" required />
				</div>
				<div class="field">
					<label for="f-email">Email address <span class="req" aria-hidden="true">*</span></label>
					<input id="f-email" name="email" type="email" autocomplete="email" placeholder="jane@company.com" required />
				</div>
				<div class="field">
					<label for="f-company">Company (optional)</label>
					<input id="f-company" name="company" type="text" autocomplete="organization" placeholder="Your company" />
				</div>
				<div class="field">
					<label for="f-phone">Phone (optional)</label>
					<input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="+1 123 456 7890" />
				</div>
				<div class="field">
					<label for="f-service">Service you’re interested in <span class="req" aria-hidden="true">*</span></label>
					<select id="f-service" name="service" required>
						<option value="" disabled selected={!services.some((s) => s.value === wanted)}>Select a service</option>
						{services.map((s) => <option value={s.label} selected={s.value === wanted}>{s.label}</option>)}
					</select>
				</div>
				<div class="field">
					<label for="f-budget">Project budget (USD) <span class="req" aria-hidden="true">*</span></label>
					<select id="f-budget" name="budget" required>
						<option value="" disabled selected>Select a budget range</option>
						{budgets.map((b) => <option>{b}</option>)}
					</select>
				</div>
				<div class="field full">
					<label for="f-timeline">When are you looking to start? <span class="req" aria-hidden="true">*</span></label>
					<select id="f-timeline" name="timeline" required>
						<option value="" disabled selected>Select a timeline</option>
						{timelines.map((t) => <option>{t}</option>)}
					</select>
				</div>
				<div class="field full">
					<label for="f-details">Tell us about your project <span class="req" aria-hidden="true">*</span></label>
					<textarea
						id="f-details"
						name="details"
						rows="4"
						placeholder="What are you looking to achieve? Share any background, ideas or inspiration."
						required></textarea>
				</div>
			</div>
			<button class="btn" type="submit">Send enquiry <Arrow /></button>
			<p class="form-status" role="status" aria-live="polite" data-status>
				<noscript>
					This form needs JavaScript to prepare your email. You can also write to
					<a href={`mailto:${studio.email}`}>{studio.email}</a> with your service, budget and timing.
				</noscript>
			</p>
		</form>
	</section>

	<section class="contact-band" aria-labelledby="touch-title">
		<div class="contact-photo">
			<img
				src="/images/contact-desk.webp"
				alt="Studio desk with a stack of design books, a stone vase and a laptop in front of a vermilion wall"
				loading="lazy"
			/>
		</div>
		<div class="contact-copy">
			<p class="eyebrow">Prefer to say hello?</p>
			<h2 id="touch-title" class="h1-sm">Get in <span class="accent">touch.</span></h2>
			<dl class="contact-list">
				<div>
					<dt>Email</dt>
					<dd><a href={`mailto:${studio.email}`}>{studio.email}</a></dd>
				</div>
				{
					studio.phone && (
						<div>
							<dt>Phone</dt>
							<dd><a href={`tel:${studio.phone.replace(/[^\d+]/g, "")}`}>{studio.phone}</a></dd>
						</div>
					)
				}
				<div>
					<dt>Studio</dt>
					<dd>
						{studio.street}<br />
						{studio.locality}
					</dd>
				</div>
			</dl>
		</div>
	</section>
</Base>

<script>
	// Compose a project enquiry email; the studio replies to it. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-enquiry-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online enquiries are not available right now. Please call the studio.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Project enquiry: ${get("service")} — ${get("name")}`;
			const body = [
				"Hello,",
				"",
				"I would like to start a project:",
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("company") ? `Company: ${get("company")}` : "",
				get("phone") ? `Phone: ${get("phone")}` : "",
				`Service: ${get("service")}`,
				`Budget (USD): ${get("budget")}`,
				`Start: ${get("timeline")}`,
				"",
				"About the project:",
				get("details"),
			]
				.filter((line, i, arr) => line !== "" || arr[i - 1] !== "")
				.join("\n");
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			status.textContent = "";
			status.append(
				"Your email app should open with this enquiry ready to send. It is only sent once you send that email. If nothing opened, write to ",
			);
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
