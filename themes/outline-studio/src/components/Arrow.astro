---
interface Props {
	/** "right" is the CTA arrow, "up-right" the project-card arrow. */
	dir?: "right" | "up-right";
}
const { dir = "right" } = Astro.props;
---

{
	dir === "right" ? (
		<svg class="arrow" width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" focusable="false">
			<path d="M0 6h16M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" />
		</svg>
	) : (
		<svg class="arrow" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
			<path d="M1 11 11 1M3 1h8v8" fill="none" stroke="currentColor" stroke-width="1.2" />
		</svg>
	)
}
