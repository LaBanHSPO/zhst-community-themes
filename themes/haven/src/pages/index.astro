---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PropertyCard from "../components/PropertyCard.astro";
import SearchForm from "../components/SearchForm.astro";
import { distinctLocations } from "../utils/listing";
import { MAX_LISTINGS } from "../utils/queries";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entries, cacheHint } = await getEmDashCollection("properties", {
	orderBy: { published_at: "desc" },
	limit: MAX_LISTINGS,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
const locations = distinctLocations(entries.map((e) => e.data.location));
const flagged = entries.filter((e) => e.data.featured);
// Fall back to the newest listings when nothing is flagged as featured.
const featured = (flagged.length > 0 ? flagged : entries).slice(0, 3);
---

<Base title={siteTitle} description={siteTagline} overlayHeader>
	<section class="hero" aria-labelledby="hero-title">
		<img
			class="hero-image"
			src="/images/haven/hero-pavilion.jpg"
			alt=""
			width="913"
			height="382"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="hero-inner">
			<div class="hero-copy">
				<h1 id="hero-title">A place to call your own</h1>
				<p>Beautiful homes in extraordinary places.<br />Let's find the one that feels like home.</p>
				<a class="btn" href="/properties">
					Explore properties
					<Icon name="arrow" size={20} />
				</a>
			</div>
			<p class="hero-aside" aria-hidden="true">
				<span>More than houses</span>
				<span class="hero-aside-rule"></span>
				<span>Brighter lives</span>
			</p>
		</div>
	</section>

	<div class="container hero-search">
		<SearchForm locations={locations} variant="floating" label="Find a property" />
	</div>

	<section class="section container" aria-labelledby="featured-title">
		<div class="section-head">
			<div>
				<p class="eyebrow">Featured properties</p>
				<h2 id="featured-title">Homes worth discovering</h2>
			</div>
			<a class="text-link" href="/properties">
				View all properties
				<Icon name="arrow" size={20} />
			</a>
		</div>

		{
			featured.length === 0 ? (
				<p class="empty">
					No properties are listed yet. Add one in the admin under
					<a href="/_emdash/admin/content/properties">Properties</a>.
				</p>
			) : (
				<ul class="property-grid">
					{featured.map((p) => (
						<li>
							<PropertyCard slug={p.id} data={p.data} />
						</li>
					))}
				</ul>
			)
		}
	</section>

	<section class="section sell-band" aria-labelledby="sell-title">
		<div class="container sell-inner">
			<div>
				<p class="eyebrow">Selling or letting?</p>
				<h2 id="sell-title">Talk to an agent who knows your street</h2>
				<p>We list a small number of homes at a time, so each one gets careful photography and honest details.</p>
			</div>
			<div class="sell-actions">
				<a class="btn" href="/sell">How selling works</a>
				<a class="btn btn--ghost" href="/contact">Get in touch</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		min-height: clamp(30rem, 58vw, 40rem);
		margin-top: -5.3rem; /* run the photo under the translucent header */
		padding-top: 5.3rem;
		display: flex;
		background: #c9d6dd;
	}
	.hero-image {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		object-position: 62% 40%;
	}
	/* Light wash on the left keeps the navy headline readable over the sky. */
	.hero::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(90deg, rgb(246 242 236 / 0.92) 0%, rgb(246 242 236 / 0.72) 32%, rgb(246 242 236 / 0) 58%);
	}
	.hero-inner {
		width: min(100% - 2 * var(--gutter), var(--container));
		margin-inline: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding-block: 3rem 6.5rem;
	}
	.hero-copy {
		max-width: 33rem;
	}
	.hero-copy h1 {
		font-size: clamp(2.6rem, 5.6vw, 4.6rem);
		line-height: 1.04;
		margin-bottom: 1.4rem;
	}
	.hero-copy p {
		font-size: 1.12rem;
		color: var(--ink);
		margin-bottom: 2.2rem;
	}
	.hero-aside {
		align-self: center;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		width: 5.5rem;
		margin: 0;
		color: #fff;
		font-size: 0.72rem;
		letter-spacing: 0.32em;
		line-height: 1.9;
		text-transform: uppercase;
		text-shadow: 0 1px 6px rgb(0 0 0 / 0.35);
	}
	.hero-aside-rule {
		width: 2.6rem;
		height: 1px;
		background: rgb(255 255 255 / 0.75);
	}
	.hero-search {
		position: relative;
		z-index: 5;
		margin-top: -3.6rem;
		max-width: 1040px;
	}
	.sell-band {
		background: var(--sand);
	}
	.sell-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}
	.sell-inner p:last-child {
		margin: 0;
		max-width: 46ch;
		color: var(--muted);
	}
	.sell-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	@media (max-width: 820px) {
		.hero {
			margin-top: 0;
			padding-top: 0;
			min-height: 0;
		}
		.hero::before {
			background: linear-gradient(180deg, rgb(246 242 236 / 0.9) 0%, rgb(246 242 236 / 0.7) 55%, rgb(246 242 236 / 0.15) 100%);
		}
		.hero-inner {
			padding-block: 2.5rem 5.5rem;
		}
		.hero-aside {
			display: none;
		}
		.hero-search {
			margin-top: -3rem;
		}
	}
</style>
