---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<section class="container notfound">
		<p class="eyebrow">404</p>
		<h1>We couldn't find that page</h1>
		<p class="lede">The listing may have been sold, let or removed, or the address may be mistyped.</p>
		<p class="actions">
			<a class="btn" href="/properties">Browse properties</a>
			<a class="btn btn--ghost" href="/">Back to home</a>
		</p>
	</section>
</Base>

<style>
	.notfound {
		padding-block: clamp(3rem, 10vw, 7rem);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
</style>
