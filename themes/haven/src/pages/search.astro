---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import PropertyCard from "../components/PropertyCard.astro";
import SearchForm from "../components/SearchForm.astro";
import {
	LISTING_TYPES,
	PROPERTY_TYPES,
	hasCriteria,
	inBudget,
	parseSearch,
	plural,
	searchHref,
	type SearchCriteria,
} from "../utils/listing";
import { MAX_LISTINGS, getLocations } from "../utils/queries";

const { locations, cacheHint: locationsHint } = await getLocations();
const criteria = parseSearch(Astro.url.searchParams, locations);

// Exact-match filters run in the database query; the price band is applied after.
const where: Record<string, string> = {};
if (criteria.listing) where.listing_type = criteria.listing;
if (criteria.type) where.property_type = criteria.type;
if (criteria.location) where.location = criteria.location;

const { entries, cacheHint } = await getEmDashCollection("properties", {
	where,
	orderBy: { published_at: "desc" },
	limit: MAX_LISTINGS,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(locationsHint);
	Astro.cache.set(cacheHint);
}

const budget = criteria.budget;
const results = entries.filter(
	(e) => !budget || (e.data.listing_type === budget.listing && inBudget(e.data.price, budget)),
);

/** One removable chip per active criterion. */
const chips: { label: string; removeHref: string }[] = [];
function without(key: keyof SearchCriteria): string {
	const next = { ...criteria };
	delete next[key];
	return searchHref(next);
}
if (criteria.listing) chips.push({ label: LISTING_TYPES[criteria.listing], removeHref: without("listing") });
if (criteria.location) chips.push({ label: criteria.location, removeHref: without("location") });
if (criteria.type) chips.push({ label: PROPERTY_TYPES[criteria.type], removeHref: without("type") });
if (budget) chips.push({ label: budget.label, removeHref: without("budget") });

const filtered = hasCriteria(criteria);
const heading = criteria.listing === "sale" ? "Homes for sale" : criteria.listing === "rent" ? "Homes to rent" : "Search results";
const conflict = Boolean(budget && criteria.listing && budget.listing !== criteria.listing);
---

<Base title={heading} description="Search homes by location, property type and budget.">
	<header class="page-head">
		<div class="container">
			<p class="eyebrow">Property search</p>
			<h1>{heading}</h1>
			<p class="lede" role="status">
				{plural(results.length, "property", "properties")} found{filtered ? " for your search" : ""}.
			</p>
		</div>
	</header>

	<div class="container">
		<SearchForm locations={locations} criteria={criteria} label="Refine your search" />

		{
			chips.length > 0 && (
				<div class="criteria">
					<h2 class="visually-hidden">Current search</h2>
					<ul class="chips">
						{chips.map((chip) => (
							<li>
								<span>{chip.label}</span>
								<a href={chip.removeHref} aria-label={`Remove filter: ${chip.label}`}>×</a>
							</li>
						))}
					</ul>
					<a class="text-link" href="/search">Clear all</a>
				</div>
			)
		}
	</div>

	<section class="section container" aria-label="Results">
		{
			results.length === 0 ? (
				<div class="empty">
					<h2>No homes match these criteria</h2>
					{conflict && budget && (
						<p>
							The budget “{budget.label}” is for homes {budget.listing === "rent" ? "to rent" : "for sale"}, but this
							search is limited to homes {criteria.listing === "rent" ? "to rent" : "for sale"}.
						</p>
					)}
					<p>Try removing a filter above, browse every listing, or tell us what you are looking for.</p>
					<p class="empty-actions">
						<a class="btn" href="/properties">View all properties</a>
						<a class="btn btn--ghost" href="/contact">Contact an agent</a>
					</p>
				</div>
			) : (
				<ul class="property-grid">
					{results.map((p) => (
						<li>
							<PropertyCard slug={p.id} data={p.data} headingLevel="h2" />
						</li>
					))}
				</ul>
			)
		}
	</section>
</Base>

<style>
	.criteria {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		margin-top: 1.25rem;
	}
	.chips {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.chips li {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.3rem 0.4rem 0.3rem 0.85rem;
		border-radius: 999px;
		background: var(--navy-100);
		color: var(--navy);
		font-size: 0.9rem;
	}
	.chips a {
		display: inline-grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 50%;
		text-decoration: none;
		font-size: 1.1rem;
		line-height: 1;
	}
	.chips a:hover {
		background: rgb(22 42 69 / 0.12);
	}
	.empty h2 {
		font-size: 1.6rem;
	}
	.empty-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.5rem 0 0;
	}
</style>
