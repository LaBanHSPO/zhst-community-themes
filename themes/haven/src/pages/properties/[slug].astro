---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import AgentCard from "../../components/AgentCard.astro";
import InquiryPanel from "../../components/InquiryPanel.astro";
import { formatPrice, listingLabel, plural, propertyTypeLabel } from "../../utils/listing";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: property, cacheHint } = await getEmDashEntry("properties", slug);
if (!property) {
	return Astro.rewrite("/404");
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const data = property.data;
const agentSlug = data.agent?.trim();
const agentResult = agentSlug ? await getEmDashEntry("agents", agentSlug) : null;
const agent = agentResult?.entry ?? null;
if (agentResult && Astro.cache?.enabled) Astro.cache.set(agentResult.cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const ogImage = data.featured_image?.src ? new URL(data.featured_image.src, Astro.url.origin).href : undefined;
const seo = getSeoMeta(property, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultDescription: data.summary,
	defaultOgImage: ogImage,
});

type Photo = NonNullable<typeof data.featured_image>;
const photos: { image: Photo; caption?: string | null }[] = [];
if (data.featured_image?.src || data.featured_image?.id) photos.push({ image: data.featured_image });
for (const item of data.gallery ?? []) {
	if (item?.image?.src || item?.image?.id) photos.push({ image: item.image, caption: item.caption });
}

const facts: { icon: "bed" | "bath" | "area" | "home"; label: string }[] = [];
if (typeof data.beds === "number") facts.push({ icon: "bed", label: plural(data.beds, "bedroom", "bedrooms") });
if (typeof data.baths === "number") facts.push({ icon: "bath", label: plural(data.baths, "bathroom", "bathrooms") });
if (typeof data.area_sqft === "number") facts.push({ icon: "area", label: `${data.area_sqft.toLocaleString("en-US")} sq ft` });
const typeLabel = propertyTypeLabel(data.property_type);
if (typeLabel) facts.push({ icon: "home", label: typeLabel });
const badge = listingLabel(data.listing_type);
const features = (data.features ?? []).map((f) => f?.label?.trim()).filter((l): l is string => Boolean(l));
const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "properties", id: data.id, slug }}
>
	<div class="container detail">
		<nav class="crumbs" aria-label="Breadcrumb">
			<ol>
				<li><a href="/properties">Properties</a></li>
				{data.location && <li><a href={`/search?location=${encodeURIComponent(data.location)}`}>{data.location}</a></li>}
				<li aria-current="page">{data.title}</li>
			</ol>
		</nav>

		<header class="detail-head">
			<div>
				{badge && <p class="eyebrow">{badge}{typeLabel ? ` · ${typeLabel}` : ""}</p>}
				<h1 {...property.edit.title}>{data.title}</h1>
				{
					(data.address || data.location) && (
						<p class="address">
							<Icon name="pin" size={18} />
							{data.address || data.location}
						</p>
					)
				}
			</div>
			<div class="price-block">
				<p class="price">{formatPrice(data.price, data.listing_type)}</p>
				<a class="btn" href="#inquiry">Request a viewing</a>
			</div>
		</header>

		<section class="gallery" aria-label="Photos">
			{
				photos.length === 0 ? (
					<div class="gallery-lead media-frame">
						<div class="media-placeholder">Photos coming soon</div>
					</div>
				) : (
					<ul class:list={["gallery-grid", `gallery-grid--${Math.min(photos.length, 4)}`]}>
						{photos.slice(0, 4).map((photo, i) => (
							<li class:list={["gallery-item", i === 0 && "gallery-item--lead"]}>
								<figure class="media-frame">
									<Image image={photo.image} priority={i === 0} alt={photo.image.alt ?? ""} />
									{photo.caption && <figcaption>{photo.caption}</figcaption>}
								</figure>
							</li>
						))}
					</ul>
				)
			}
			{
				photos.length > 4 && (
					<ul class="gallery-more">
						{photos.slice(4).map((photo) => (
							<li>
								<figure class="media-frame">
									<Image image={photo.image} alt={photo.image.alt ?? ""} />
									{photo.caption && <figcaption>{photo.caption}</figcaption>}
								</figure>
							</li>
						))}
					</ul>
				)
			}
		</section>

		<div class="detail-body">
			<div class="detail-main">
				{
					facts.length > 0 && (
						<ul class="facts" aria-label="Key facts">
							{facts.map((f) => (
								<li>
									<Icon name={f.icon} size={22} />
									{f.label}
								</li>
							))}
						</ul>
					)
				}

				{data.summary && <p class="summary">{data.summary}</p>}

				{
					data.description && data.description.length > 0 && (
						<section class="prose" aria-labelledby="about-home">
							<h2 id="about-home">About this home</h2>
							<PortableText value={data.description} />
						</section>
					)
				}

				{
					features.length > 0 && (
						<section aria-labelledby="features-title">
							<h2 id="features-title">Key features</h2>
							<ul class="features">
								{features.map((f) => (
									<li>{f}</li>
								))}
							</ul>
						</section>
					)
				}

				{
					typeof data.year_built === "number" && (
						<p class="meta">Built in {data.year_built}.</p>
					)
				}
			</div>

			<aside class="detail-aside" aria-label="Listing agent">
				{
					agent ? (
						<AgentCard slug={agent.id} data={agent.data} compact />
					) : (
						<div class="no-agent">
							<p>Questions about this home?</p>
							<a class="text-link" href="/contact">Contact our team</a>
						</div>
					)
				}
			</aside>
		</div>

		<InquiryPanel
			title={data.title}
			address={data.address || data.location}
			price={formatPrice(data.price, data.listing_type)}
			pageUrl={pageUrl}
			agent={agent ? { name: agent.data.title, email: agent.data.email, phone: agent.data.phone } : null}
		/>
	</div>
</Base>

<style>
	.detail {
		padding-block: 1.75rem 4rem;
	}
	.crumbs ol {
		list-style: none;
		margin: 0 0 1.75rem;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		font-size: 0.9rem;
		color: var(--muted);
	}
	.crumbs li + li::before {
		content: "/";
		margin-right: 0.4rem;
		color: #b3aa9c;
	}
	.detail-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1.5rem 3rem;
		margin-bottom: 1.75rem;
	}
	.detail-head h1 {
		margin-bottom: 0.35em;
	}
	.address {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		color: var(--muted);
		font-size: 1.05rem;
	}
	.price-block {
		text-align: right;
	}
	.price {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		font-weight: 500;
		color: var(--navy);
		margin: 0 0 0.75rem;
	}

	.gallery-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
		border-radius: 6px;
		overflow: hidden;
		grid-template-columns: 2fr 1fr;
		grid-auto-rows: clamp(9rem, 17vw, 14rem);
	}
	.gallery-grid--1 {
		grid-template-columns: 1fr;
		grid-auto-rows: clamp(14rem, 36vw, 30rem);
	}
	.gallery-grid--2 .gallery-item--lead,
	.gallery-grid--2 .gallery-item:not(.gallery-item--lead) {
		grid-row: span 2;
	}
	.gallery-grid--3 .gallery-item--lead {
		grid-row: span 2;
	}
	.gallery-grid--4 {
		grid-template-columns: 2fr 1fr 1fr;
	}
	.gallery-grid--4 .gallery-item--lead {
		grid-row: span 2;
	}
	.gallery-grid--4 .gallery-item:last-child {
		grid-column: span 2;
	}
	.gallery-item figure,
	.gallery-more figure {
		margin: 0;
		height: 100%;
	}
	.gallery-lead {
		aspect-ratio: 16 / 7;
		border-radius: 6px;
	}
	figcaption {
		position: absolute;
		left: 0.6rem;
		bottom: 0.6rem;
		padding: 0.25rem 0.6rem;
		border-radius: 2px;
		background: rgb(22 42 69 / 0.78);
		color: #fff;
		font-size: 0.82rem;
	}
	.gallery-more {
		list-style: none;
		margin: 0.6rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
		grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
		grid-auto-rows: 9rem;
	}

	.detail-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 21rem;
		gap: 3rem;
		margin-top: 2.5rem;
	}
	.facts {
		list-style: none;
		margin: 0 0 1.75rem;
		padding: 1.1rem 1.25rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2rem;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 6px;
	}
	.facts li {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--navy);
	}
	.summary {
		font-family: var(--font-display);
		font-size: 1.3rem;
		line-height: 1.5;
		color: var(--navy);
		max-width: 60ch;
	}
	.detail-main h2 {
		font-size: 1.6rem;
		margin-top: 2rem;
	}
	.features {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 0.6rem 1.5rem;
	}
	.features li {
		position: relative;
		padding-left: 1.4rem;
	}
	.features li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.62em;
		width: 0.55rem;
		height: 0.55rem;
		border: 1.5px solid var(--navy);
		border-radius: 50%;
	}
	.meta {
		margin-top: 1.5rem;
		color: var(--muted);
	}
	.detail-aside {
		align-self: start;
		position: sticky;
		top: 1.5rem;
	}
	.no-agent {
		padding: 1.5rem;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 6px;
	}

	@media (max-width: 900px) {
		.detail-body {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.detail-aside {
			position: static;
		}
		.price-block {
			text-align: left;
		}
	}
	@media (max-width: 640px) {
		.gallery-grid,
		.gallery-grid--4 {
			grid-template-columns: 1fr 1fr;
			grid-auto-rows: 8rem;
		}
		.gallery-grid .gallery-item--lead {
			grid-column: 1 / -1;
			grid-row: span 2;
		}
		.gallery-grid--2 .gallery-item:not(.gallery-item--lead),
		.gallery-grid--4 .gallery-item:last-child {
			grid-column: 1 / -1;
			grid-row: span 1;
		}
	}
</style>
