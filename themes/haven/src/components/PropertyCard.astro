---
import { Image } from "emdash/ui";
import type { EmDashCollections } from "emdash";
import Icon from "./Icon.astro";
import { formatPrice, listingLabel, plural } from "../utils/listing";

interface Props {
	/** Entry slug (used for the URL). */
	slug: string;
	data: EmDashCollections["properties"];
	headingLevel?: "h2" | "h3";
}

const { slug, data, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const href = `/properties/${encodeURIComponent(slug)}`;
const badge = listingLabel(data.listing_type);
---

<article class="card">
	<div class="card-media media-frame">
		{
			data.featured_image?.src || data.featured_image?.id ? (
				<Image image={data.featured_image} alt={data.featured_image.alt ?? ""} />
			) : (
				<div class="media-placeholder">Photos coming soon</div>
			)
		}
		{badge && <span class="card-badge">{badge}</span>}
	</div>
	<div class="card-body">
		<p class="card-price">{formatPrice(data.price, data.listing_type)}</p>
		<Heading class="card-title">
			<a href={href} class="card-link">{data.title}</a>
		</Heading>
		<ul class="card-facts" aria-label="Key facts">
			{typeof data.beds === "number" && <li>{plural(data.beds, "bed", "beds")}</li>}
			{typeof data.baths === "number" && <li>{plural(data.baths, "bath", "baths")}</li>}
			{
				data.location && (
					<li class="card-location">
						<Icon name="pin" size={17} />
						{data.location}
					</li>
				)
			}
		</ul>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--paper);
		border-radius: 6px;
		overflow: hidden;
		box-shadow: 0 1px 0 var(--line);
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.card:hover,
	.card:focus-within {
		box-shadow: var(--shadow);
	}
	@media (prefers-reduced-motion: no-preference) {
		.card:hover {
			transform: translateY(-2px);
		}
	}
	.card-media {
		aspect-ratio: 16 / 7.5;
	}
	.card-badge {
		position: absolute;
		top: 0.85rem;
		left: 0.85rem;
		padding: 0.3rem 0.7rem;
		border-radius: 2px;
		background: rgb(246 242 236 / 0.94);
		color: var(--navy);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.card-body {
		padding: 1.15rem 1.25rem 1.35rem;
	}
	.card-price {
		font-family: var(--font-body);
		font-size: 1.35rem;
		font-weight: 500;
		color: var(--navy);
		margin: 0 0 0.15rem;
	}
	.card-title {
		font-family: var(--font-body);
		font-size: 0.98rem;
		font-weight: 500;
		margin: 0 0 0.7rem;
		color: var(--ink);
	}
	.card-link {
		color: inherit;
		text-decoration: none;
	}
	/* Whole card is clickable via the title link. */
	.card-link::after {
		content: "";
		position: absolute;
		inset: 0;
	}
	.card-link:focus-visible {
		outline: none;
	}
	.card:has(.card-link:focus-visible) {
		outline: 3px solid var(--focus);
		outline-offset: 3px;
	}
	.card-facts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		color: var(--muted);
		font-size: 0.92rem;
	}
	.card-facts li {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.card-facts li + li::before {
		content: "";
		width: 1px;
		height: 1rem;
		margin: 0 0.9rem;
		background: #c9c1b4;
	}
	.card-location {
		color: var(--ink);
	}
</style>
