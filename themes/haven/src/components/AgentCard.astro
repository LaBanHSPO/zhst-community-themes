---
import { Image } from "emdash/ui";
import type { EmDashCollections } from "emdash";
import Icon from "./Icon.astro";
import { initials } from "../utils/listing";

interface Props {
	slug: string;
	data: EmDashCollections["agents"];
	/** Compact variant for the property sidebar. */
	compact?: boolean;
	headingLevel?: "h2" | "h3";
}

const { slug, data, compact = false, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const href = `/agents/${encodeURIComponent(slug)}`;
const hasPhoto = Boolean(data.photo?.src || data.photo?.id);
---

<div class:list={["agent", compact && "agent--compact"]}>
	{compact && <p class="eyebrow">Listing agent</p>}
	<div class="agent-top">
		<div class="agent-photo">
			{
				hasPhoto && data.photo ? (
					<Image image={data.photo} alt={data.photo.alt || data.title} />
				) : (
					<span class="agent-initials" aria-hidden="true">{initials(data.title)}</span>
				)
			}
		</div>
		<div>
			<Heading class="agent-name"><a href={href}>{data.title}</a></Heading>
			{data.role && <p class="agent-role">{data.role}</p>}
			{data.areas && <p class="agent-areas">Covers {data.areas}</p>}
		</div>
	</div>
	<ul class="agent-contact">
		{
			data.phone && (
				<li>
					<Icon name="phone" size={18} />
					<a href={`tel:${data.phone.replace(/[^\d+]/g, "")}`}>{data.phone}</a>
				</li>
			)
		}
		{
			data.email && (
				<li>
					<Icon name="mail" size={18} />
					<a href={`mailto:${data.email}`}>{data.email}</a>
				</li>
			)
		}
	</ul>
	{compact && <a class="text-link" href={href}>View profile <Icon name="arrow" size={18} /></a>}
</div>

<style>
	.agent {
		padding: 1.5rem;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 6px;
	}
	.agent-top {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.agent-photo {
		flex: none;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 50%;
		overflow: hidden;
		background: var(--navy);
	}
	.agent-photo :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
	}
	.agent-initials {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		color: #fff;
		font-family: var(--font-display);
		font-size: 1.45rem;
		letter-spacing: 0.04em;
	}
	.agent-name {
		font-size: 1.35rem;
		margin: 0 0 0.15rem;
	}
	.agent-name a {
		text-decoration: none;
	}
	.agent-name a:hover {
		text-decoration: underline;
	}
	.agent-role,
	.agent-areas {
		margin: 0;
		color: var(--muted);
		font-size: 0.92rem;
	}
	.agent-contact {
		list-style: none;
		margin: 1.1rem 0 0;
		padding: 1rem 0 0;
		border-top: 1px solid var(--line);
		display: grid;
		gap: 0.5rem;
	}
	.agent-contact li {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--navy);
		overflow-wrap: anywhere;
	}
	.agent--compact .text-link {
		margin-top: 1rem;
	}
</style>
