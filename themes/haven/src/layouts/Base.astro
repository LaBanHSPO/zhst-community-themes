---
import "@fontsource/libre-caslon-text/400.css";
import "@fontsource-variable/figtree";
import "../styles/theme.css";

import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Icon from "../components/Icon.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Let the hero image run underneath the header (home page). */
	overlayHeader?: boolean;
}

const { title, pageTitle, description, image, canonical, content, overlayHeader = false } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menuItems = menuResult.data?.items ?? [];

/** A menu item is current when its path and query parameters all match the request. */
function isCurrent(href: string): boolean {
	try {
		const target = new URL(href, Astro.url);
		if (target.origin !== Astro.url.origin || target.pathname !== Astro.url.pathname) return false;
		for (const [k, v] of target.searchParams) {
			if (Astro.url.searchParams.get(k) !== v) return false;
		}
		return true;
	} catch {
		return false;
	}
}

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<script is:inline>document.documentElement.classList.add("js");</script>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class:list={["site-header", overlayHeader && "site-header--overlay"]}>
			<div class="header-inner">
				<a class="brand" href="/" aria-label={`${siteTitle} home`}>
					{
						siteLogo ? (
							<img src={siteLogo.url} alt="" class="brand-logo" />
						) : (
							<svg class="brand-mark" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true" focusable="false">
								<path d="M4 27V14C4 7.9 8.9 3 15 3s11 4.9 11 11v13" fill="none" stroke="currentColor" stroke-width="1.6" />
								<path d="M10 27V15.5a5 5 0 0 1 10 0V27" fill="none" stroke="currentColor" stroke-width="1.6" />
							</svg>
						)
					}
					<span class="brand-name">{siteTitle}</span>
				</a>

				<button
					class="nav-toggle"
					type="button"
					aria-expanded="false"
					aria-controls="site-nav"
					data-nav-toggle
				>
					<Icon name="menu" size={24} />
					<span class="visually-hidden">Menu</span>
				</button>

				<nav id="site-nav" class="site-nav" aria-label="Primary">
					<ul>
						{
							menuItems.map((item) => (
								<li>
									<a
										href={item.url}
										target={item.target}
										rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
										aria-current={isCurrent(item.url) ? "page" : undefined}
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
					<a class="btn header-cta header-cta--mobile" href="/contact">Get in touch</a>
				</nav>

				{siteTagline && <p class="header-tagline">{siteTagline}</p>}
				<a class="btn header-cta header-cta--desktop" href="/contact">Get in touch</a>
			</div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-grid">
				<div>
					<p class="footer-brand">{siteTitle}</p>
					{siteTagline && <p class="footer-tagline">{siteTagline}</p>}
				</div>
				<nav aria-label="Explore">
					<p class="footer-heading">Explore</p>
					<ul>
						<li><a href="/properties">All properties</a></li>
						<li><a href="/search?listing=sale">Homes for sale</a></li>
						<li><a href="/search?listing=rent">Homes to rent</a></li>
					</ul>
				</nav>
				<nav aria-label="Company">
					<p class="footer-heading">Company</p>
					<ul>
						<li><a href="/about">About</a></li>
						<li><a href="/sell">Sell with us</a></li>
						<li><a href="/contact">Contact</a></li>
					</ul>
				</nav>
			</div>
			<div class="container footer-base">
				<p>© {year} {siteTitle}. Viewing requests are inquiries; the agent will reply to arrange a time.</p>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
			const nav = document.getElementById("site-nav");
			if (toggle && nav) {
				const setOpen = (open: boolean) => {
					toggle.setAttribute("aria-expanded", String(open));
					nav.classList.toggle("is-open", open);
				};
				toggle.addEventListener("click", () => {
					setOpen(toggle.getAttribute("aria-expanded") !== "true");
				});
				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape" && nav.classList.contains("is-open")) {
						setOpen(false);
						toggle.focus();
					}
				});
			}
		</script>
	</body>
</html>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		background: rgb(246 242 236 / 0.96);
		border-bottom: 1px solid var(--line);
	}
	.site-header--overlay {
		background: rgb(246 242 236 / 0.9);
		backdrop-filter: blur(6px);
	}
	.header-inner {
		width: min(100% - 2 * var(--gutter), 1360px);
		margin-inline: auto;
		min-height: 5.25rem;
		display: flex;
		align-items: center;
		gap: 2.5rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		color: var(--navy);
		text-decoration: none;
	}
	.brand-mark {
		color: var(--navy);
	}
	.brand-logo {
		height: 40px;
		width: auto;
	}
	.brand-name {
		font-family: var(--font-body);
		font-size: 1.45rem;
		font-weight: 500;
		letter-spacing: 0.32em;
		text-transform: uppercase;
	}
	.site-nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 2.1rem;
	}
	.site-nav a:not(.btn) {
		color: var(--ink);
		text-decoration: none;
		font-size: 0.98rem;
		padding-block: 0.4rem;
		border-bottom: 1px solid transparent;
	}
	.site-nav a:not(.btn):hover,
	.site-nav a[aria-current="page"] {
		border-bottom-color: var(--navy);
		color: var(--navy);
	}
	.header-tagline {
		margin: 0 0 0 auto;
		font-size: 0.68rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.header-cta {
		padding-inline: 1.7rem;
	}
	.header-cta--mobile,
	.nav-toggle {
		display: none;
	}

	@media (max-width: 1080px) {
		.header-tagline {
			display: none;
		}
		.header-cta--desktop {
			margin-left: auto;
		}
	}

	@media (max-width: 820px) {
		.header-inner {
			min-height: 4.25rem;
			gap: 1rem;
			flex-wrap: wrap;
		}
		.brand-name {
			font-size: 1.2rem;
		}
		.header-cta--desktop {
			display: none;
		}
		.nav-toggle {
			display: inline-flex;
			margin-left: auto;
			align-items: center;
			justify-content: center;
			width: 2.9rem;
			height: 2.9rem;
			border: 1px solid var(--line);
			border-radius: var(--radius);
			background: transparent;
			color: var(--navy);
			cursor: pointer;
		}
		.site-nav {
			flex-basis: 100%;
			padding-bottom: 1rem;
		}
		/* Without JS the menu stays visible; with JS it is a disclosure. */
		:global(html.js) .site-nav:not(.is-open) {
			display: none;
		}
		.site-nav ul {
			flex-direction: column;
			gap: 0;
		}
		.site-nav a:not(.btn) {
			display: block;
			padding: 0.85rem 0;
			border-bottom: 1px solid var(--line);
		}
		.header-cta--mobile {
			display: flex;
			margin-top: 1rem;
		}
	}

	main:focus {
		outline: none;
	}

	.site-footer {
		margin-top: 0;
		background: var(--navy);
		color: #dfe5ee;
		padding-top: 3.5rem;
	}
	.site-footer a {
		color: #fff;
		text-decoration: none;
	}
	.site-footer a:hover {
		text-decoration: underline;
	}
	.footer-grid {
		display: grid;
		gap: 2rem;
		grid-template-columns: 2fr 1fr 1fr;
	}
	.footer-grid ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.5rem;
	}
	.footer-brand {
		font-size: 1.3rem;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: #fff;
		margin-bottom: 0.4rem;
	}
	.footer-tagline {
		color: #c4cdda;
	}
	.footer-heading {
		font-size: 0.75rem;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: #c4cdda;
		margin-bottom: 0.9rem;
	}
	.footer-base {
		margin-top: 2.5rem;
		padding-block: 1.5rem;
		border-top: 1px solid rgb(255 255 255 / 0.15);
		font-size: 0.85rem;
		color: #c4cdda;
	}
	.footer-base p {
		margin: 0;
	}
	@media (max-width: 720px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
		.footer-grid > :first-child {
			grid-column: 1 / -1;
		}
	}
</style>
