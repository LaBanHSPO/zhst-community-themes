{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Haven",
		"description": "A real estate theme with property listings, search, agent profiles and viewing inquiries",
		"author": "ZeroHostCMS community"
	},
	"settings": {
		"title": "Haven",
		"tagline": "Homes for a brighter tomorrow"
	},
	"collections": [
		{
			"slug": "properties",
			"label": "Properties",
			"labelSingular": "Property",
			"urlPattern": "/properties/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "listing_type",
					"label": "Listing type",
					"type": "select",
					"required": true,
					"indexed": true,
					"validation": {
						"options": [
							"sale",
							"rent"
						]
					},
					"defaultValue": "sale"
				},
				{
					"slug": "property_type",
					"label": "Property type",
					"type": "select",
					"required": true,
					"indexed": true,
					"validation": {
						"options": [
							"house",
							"villa",
							"apartment",
							"townhouse"
						]
					},
					"defaultValue": "house"
				},
				{
					"slug": "location",
					"label": "Location (town or area)",
					"type": "string",
					"required": true,
					"indexed": true,
					"searchable": true
				},
				{
					"slug": "address",
					"label": "Address",
					"type": "string",
					"searchable": true
				},
				{
					"slug": "price",
					"label": "Price (sale) or monthly rent",
					"type": "integer",
					"required": true,
					"indexed": true
				},
				{
					"slug": "beds",
					"label": "Bedrooms",
					"type": "integer"
				},
				{
					"slug": "baths",
					"label": "Bathrooms",
					"type": "number"
				},
				{
					"slug": "area_sqft",
					"label": "Floor area (sq ft)",
					"type": "integer"
				},
				{
					"slug": "year_built",
					"label": "Year built",
					"type": "integer"
				},
				{
					"slug": "featured",
					"label": "Feature on home page",
					"type": "boolean",
					"defaultValue": false
				},
				{
					"slug": "agent",
					"label": "Agent slug",
					"type": "string"
				},
				{
					"slug": "summary",
					"label": "Summary",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Main photo",
					"type": "image"
				},
				{
					"slug": "gallery",
					"label": "Gallery",
					"type": "repeater",
					"validation": {
						"subFields": [
							{
								"slug": "image",
								"label": "Photo",
								"type": "image",
								"required": true
							},
							{
								"slug": "caption",
								"label": "Caption",
								"type": "string"
							}
						]
					}
				},
				{
					"slug": "features",
					"label": "Key features",
					"type": "repeater",
					"validation": {
						"subFields": [
							{
								"slug": "label",
								"label": "Feature",
								"type": "string",
								"required": true
							}
						]
					}
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "portableText",
					"searchable": true
				}
			]
		},
		{
			"slug": "agents",
			"label": "Agents",
			"labelSingular": "Agent",
			"urlPattern": "/agents/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Name",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "role",
					"label": "Role",
					"type": "string"
				},
				{
					"slug": "photo",
					"label": "Photo",
					"type": "image"
				},
				{
					"slug": "email",
					"label": "Email",
					"type": "string"
				},
				{
					"slug": "phone",
					"label": "Phone",
					"type": "string"
				},
				{
					"slug": "areas",
					"label": "Areas covered",
					"type": "string"
				},
				{
					"slug": "bio",
					"label": "Bio",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{
					"type": "custom",
					"label": "Buy",
					"url": "/search?listing=sale"
				},
				{
					"type": "custom",
					"label": "Rent",
					"url": "/search?listing=rent"
				},
				{
					"type": "custom",
					"label": "Sell",
					"url": "/sell"
				},
				{
					"type": "custom",
					"label": "About",
					"url": "/about"
				},
				{
					"type": "custom",
					"label": "Contact",
					"url": "/contact"
				}
			]
		}
	],
