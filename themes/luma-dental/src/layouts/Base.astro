---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getClinic, telHref } from "../lib/luma";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Force which primary-menu URL is marked current. */
	current?: string;
}

const { title, pageTitle, description, image, canonical, content, current } = Astro.props;
const [settingsResult, menuResult, clinicResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getClinic(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(clinicResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menuItems = menuResult.data?.items ?? [];
const { clinic } = clinicResult;

// Wordmark: first word strong, the rest light ("Luma" + "Dental"), as designed.
const [brandFirst, ...brandRest] = siteTitle.split(" ");

// The appointment menu item doubles as the header button; it also stays in the text nav, as designed.
const CTA_URL = "/request-appointment";
const norm = (url: string) => url.replace(/[?#].*$/, "").replace(/\/$/, "") || "/";
const ctaItem = menuItems.find((i) => norm(i.url) === CTA_URL);
const ctaLabel = ctaItem?.label ?? "Request appointment";
const ctaUrl = ctaItem?.url ?? CTA_URL;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentUrl =
	current ??
	menuItems.find((i) => norm(i.url) === path)?.url ??
	menuItems
		.filter((i) => norm(i.url) !== "/" && path.startsWith(`${norm(i.url)}/`))
		.sort((a, b) => b.url.length - a.url.length)[0]?.url;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Intl.DateTimeFormat("en-GB", { year: "numeric", timeZone: "Asia/Saigon" }).format(new Date());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@300..700&family=Mrs+Saint+Delafield&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>document.documentElement.classList.add("js");</script>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-head">
			<div class="container head-inner">
				<a class="wordmark" href="/" aria-label={`${siteTitle} — homepage`}>
					{
						siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						) : (
							<>
								<Logo />
								<span class="wordmark-text">
									<strong>{brandFirst}</strong>
									{brandRest.length > 0 && <span> {brandRest.join(" ")}</span>}
								</span>
							</>
						)
					}
				</a>
				<nav class="nav" aria-label="Primary">
					{
						menuItems.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={item.url === currentUrl ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<a class="btn btn-sm head-cta" href={ctaUrl}>{ctaLabel} <Arrow /></a>
				<details class="mobile-nav">
					<summary>
						<svg width="22" height="14" viewBox="0 0 22 14" aria-hidden="true" focusable="false">
							<path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.6" />
						</svg>
						<span>Menu</span>
					</summary>
					<nav class="mobile-panel" aria-label="Primary (mobile)">
						{
							menuItems.map((item) => (
								<a href={item.url} aria-current={item.url === currentUrl ? "page" : undefined}>
									{item.label}
								</a>
							))
						}
						<a class="btn" href={ctaUrl}>{ctaLabel} <Arrow /></a>
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="container foot-inner">
				<div class="foot-brand">
					<a class="wordmark wordmark-light" href="/">
						<Logo />
						<span class="wordmark-text">
							<strong>{brandFirst}</strong>
							{brandRest.length > 0 && <span> {brandRest.join(" ")}</span>}
						</span>
					</a>
					{clinic.footer_blurb && <p>{clinic.footer_blurb}</p>}
					<a class="btn btn-light btn-sm" href={ctaUrl}>{ctaLabel} <Arrow /></a>
				</div>
				<div class="foot-col">
					<h2>Explore</h2>
					{menuItems.map((item) => <a href={item.url}>{item.label}</a>)}
				</div>
				<div class="foot-col">
					<h2>Visit us</h2>
					{
						(clinic.address_line1 || clinic.address_line2) && (
							<p class="foot-icon-line">
								<Icon name="pin" />
								<span>
									{clinic.address_line1}
									{clinic.address_line1 && clinic.address_line2 && <br />}
									{clinic.address_line2}
								</span>
							</p>
						)
					}
					{
						clinic.directions_url && (
							<a href={clinic.directions_url} target="_blank" rel="noopener noreferrer">
								Get directions <span class="sr-only">(opens in a new tab)</span>
							</a>
						)
					}
				</div>
				<div class="foot-col">
					<h2>Opening hours</h2>
					{
						(clinic.hours ?? []).map((h) => (
							<p class="foot-hours">
								<span>{h.days}</span> <span>{h.time}</span>
							</p>
						))
					}
					{clinic.phone && <a href={telHref(clinic.phone)}>{clinic.phone}</a>}
					{clinic.email && <a href={`mailto:${clinic.email}`}>{clinic.email}</a>}
				</div>
			</div>
			<div class="container foot-bottom">
				<span>© {year} {siteTitle}. All rights reserved.</span>
				<span>Built with EmDash</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
