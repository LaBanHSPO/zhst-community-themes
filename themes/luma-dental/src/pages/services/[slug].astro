---
import { getEmDashEntry, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Icon from "../../components/Icon.astro";
import Title from "../../components/Title.astro";
import { entryKey, money, photoAlt, photoSrc, splitLast } from "../../lib/luma";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry, cacheHint } = await getEmDashEntry("services", slug);
if (!entry) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const s = entry.data;
const headline = splitLast(s.headline || s.title);
const heroSrc = photoSrc(s.hero_image, s.hero_photo) ?? photoSrc(s.image, s.photo);
const heroAlt = s.hero_image?.alt || s.hero_alt || photoAlt(s.image, s.photo_alt, s.title);
const requestUrl = `/request-appointment?service=${encodeURIComponent(entryKey(s))}`;
const steps = s.steps ?? [];
const prepare = s.prepare ?? [];
const faqs = s.faqs ?? [];
const feeLabel = s.fee_label || "Indicative fee";
const bookWhat = feeLabel.replace(/\s*fee$/i, "").trim().toLowerCase() || "appointment";
const hasFee = typeof s.fee === "number" && s.fee > 0;
---

<Base
	title={s.headline || s.title}
	description={s.intro ?? s.summary}
	image={heroSrc}
	content={{ collection: "services", id: s.id, slug: s.slug }}
>
	<section class="hero hero-detail" aria-labelledby="hero-title">
		{
			heroSrc && (
				<div class="hero-media">
					<img src={heroSrc} alt={heroAlt} width="1032" height="378" fetchpriority="high" />
				</div>
			)
		}
		<div class="container hero-copy">
			{s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
			<h1 id="hero-title" class="title title-hero title-hero-detail">
				{headline.lead}<span class="nowrap">{headline.last}<span class="dot">.</span></span>
			</h1>
			{s.intro && <p class="lede lede-detail">{s.intro}</p>}
			<a class="btn" href={requestUrl}>Request appointment <Arrow /></a>
		</div>
	</section>

	<div class="container expect">
		{
			steps.length > 0 && (
				<section class="expect-main" aria-labelledby="steps-title">
					<p class="eyebrow">What to expect</p>
					<Title id="steps-title" class="title-section" text={s.steps_title || "A simple, step-by-step experience"} />
					<ol class="steps" role="list">
						{steps.map((step, i) => (
							<li class="step">
								<span class="step-icon">
									<Icon name={step.icon} />
								</span>
								<span class="step-num">{String(i + 1).padStart(2, "0")}</span>
								<h3>{step.title}</h3>
								{step.text && <p>{step.text}</p>}
								{i < steps.length - 1 && (
									<span class="step-arrow" aria-hidden="true">
										<Arrow />
									</span>
								)}
							</li>
						))}
					</ol>
				</section>
			)
		}
		<aside class="fee-card" aria-labelledby="fee-title">
			<p class="eyebrow" id="fee-title">{feeLabel}</p>
			{hasFee && <p class="fee-amount">{money(s.fee as number)}</p>}
			{s.fee_note && <p class="fee-note">{s.fee_note}</p>}
			<div class="fee-book">
				<Icon name="calendar" />
				<p>
					<strong>Book your {bookWhat} today</strong>
					<span>Choose a time that suits you.</span>
				</p>
			</div>
			<a class="btn btn-block" href={requestUrl}>Request appointment <Arrow /></a>
		</aside>
	</div>

	{
		(prepare.length > 0 || faqs.length > 0) && (
			<div class="container detail-bottom">
				{prepare.length > 0 && (
					<section class="panel prepare" aria-labelledby="prepare-title">
						<p class="eyebrow eyebrow-sm">How to prepare</p>
						<Title id="prepare-title" class="title-panel" text={s.prepare_title || "A few simple steps"} />
						<ul class="prepare-list" role="list">
							{prepare.map((p) => (
								<li>
									<Icon name={p.icon} />
									<div>
										<h3>{p.title}</h3>
										{p.text && <p>{p.text}</p>}
									</div>
								</li>
							))}
						</ul>
					</section>
				)}
				{faqs.length > 0 && (
					<section class="panel faq" aria-labelledby="faq-title">
						<p class="eyebrow eyebrow-sm">Frequently asked questions</p>
						<Title id="faq-title" class="title-panel" text="Your questions, answered" />
						<div class="faq-list">
							{faqs.map((f) => (
								<details>
									<summary>
										<span>{f.question}</span>
										<Icon name="chevron" />
									</summary>
									<p>{f.answer}</p>
								</details>
							))}
						</div>
					</section>
				)}
			</div>
		)
	}
</Base>
