---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Title from "../../components/Title.astro";
import { dentistUrl, getDentists, photoAlt, photoSrc } from "../../lib/luma";

const result = await getDentists();
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
const dentists = result.entries.map((e) => e.data);
---

<Base title="Our dentists" description="Meet the dentists at Luma Dental.">
	<section class="container team" aria-labelledby="team-title">
		<p class="eyebrow">Our team</p>
		<Title as="h1" id="team-title" class="title-section" text="Meet your dentist" />
		<ul class="team-grid" role="list">
			{
				dentists.map((d) => {
					const src = photoSrc(d.image, d.photo);
					return (
						<li>
							<a class="team-card" href={dentistUrl(d)}>
								{src && <img src={src} alt={photoAlt(d.image, d.photo_alt, d.title)} width="645" height="512" loading="lazy" />}
								<h2>{d.title}</h2>
								{d.credentials && <p>{d.credentials}</p>}
								<span class="text-link">
									View profile <Arrow />
								</span>
							</a>
						</li>
					);
				})
			}
		</ul>
		{dentists.length === 0 && <p class="empty">Dentist profiles will appear here once they are published.</p>}
	</section>
</Base>
