---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound container" aria-labelledby="nf-title">
		<p class="eyebrow">Error 404</p>
		<h1 id="nf-title" class="title title-hero">We couldn’t find<br /> that page<span class="dot">.</span></h1>
		<p class="lede">The page you’re looking for doesn’t exist or has moved. Explore our services, or request an appointment and we’ll be in touch.</p>
		<div class="actions">
			<a class="btn" href="/request-appointment">Request appointment <Arrow /></a>
			<a class="btn btn-outline" href="/services">View all services <Arrow /></a>
		</div>
	</section>
</Base>
