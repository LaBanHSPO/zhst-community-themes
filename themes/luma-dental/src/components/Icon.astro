---
/** Line icons from the mockups. Decorative unless a label is given. Unknown names fall back to the tooth. */
interface Props {
	name?: string | null;
	label?: string;
	class?: string;
}
const { name, label, class: cls } = Astro.props;
const tooth =
	'<path d="M8.2 3.5C5.4 3.5 4 5.6 4 8.3c0 2.5.9 4.1 1.5 6.4.6 2.4.8 6.3 2.6 6.3 1.6 0 1.7-3 2.3-5.1.4-1.4.9-2 1.6-2s1.2.6 1.6 2c.6 2.1.7 5.1 2.3 5.1 1.8 0 2-3.9 2.6-6.3.6-2.3 1.5-3.9 1.5-6.4 0-2.7-1.4-4.8-4.2-4.8-1.7 0-2.6.9-3.8.9s-2.1-.9-3.8-.9z"/>';
const paths: Record<string, string> = {
	tooth,
	sparkle:
		'<path d="M10 3.5c.6 4.2 2.3 5.9 6.5 6.5-4.2.6-5.9 2.3-6.5 6.5-.6-4.2-2.3-5.9-6.5-6.5 4.2-.6 5.9-2.3 6.5-6.5zM17.5 13.5c.3 2 1.1 2.7 3 3-1.9.3-2.7 1.1-3 3-.3-1.9-1.1-2.7-3-3 1.9-.3 2.7-1 3-3z"/>',
	implant:
		'<path d="M7 4.5c0-.6.4-1 1-1h8c.6 0 1 .4 1 1v2.6c0 1.3-1.1 2.4-2.4 2.4H9.4C8.1 9.5 7 8.4 7 7.1z"/><path d="M8.5 9.5v1.5h7V9.5M8 11.5h8M9 13.5h6M9.5 15.5h5M10 17.5h4M10.5 19.5 12 21l1.5-1.5"/>',
	heart:
		'<path d="M12 20s-7.5-4.6-7.5-10.2C4.5 6.9 6.5 5 9 5c1.4 0 2.4.7 3 1.6.6-.9 1.6-1.6 3-1.6 2.5 0 4.5 1.9 4.5 4.8C19.5 15.4 12 20 12 20z"/>',
	clipboard:
		'<rect x="5.5" y="4.5" width="13" height="16.5" rx="1.5"/><path d="M9 4.5V3h6v1.5M9 9.5h6M9 13h6M9 16.5h4"/>',
	xray: '<rect x="3.5" y="4.5" width="17" height="12" rx="1.5"/><path d="M9 20.5h6M12 16.5v4"/><path d="M9.6 7.4c-1.2 0-1.9.9-1.9 2.1 0 1.1.5 1.8.7 2.8.2 1 .4 2.3 1.1 2.3.6 0 .7-1.2 1-2 .2-.6.4-.8.6-.8s.4.2.6.8c.3.8.4 2 1 2 .7 0 .9-1.3 1.1-2.3.2-1 .7-1.7.7-2.8 0-1.2-.7-2.1-1.9-2.1-.7 0-1 .4-1.5.4s-.8-.4-1.5-.4z"/>',
	notes:
		'<path d="M6 3.5h9l3.5 3.5v13.5H6z"/><path d="M15 3.5V7h3.5M8.5 10.5h7M8.5 13.5h7M8.5 16.5h4.5"/>',
	toothbrush: '<path d="M4 20.5 14.5 10M14.5 10l2 2 4-4-2-2M16 6.5l-3 3M17.5 4.5l2 2M19.5 3l1.5 1.5"/>',
	calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>',
	user: '<circle cx="12" cy="8" r="3.8"/><path d="M4.5 20.5c.7-4 3.6-6.3 7.5-6.3s6.8 2.3 7.5 6.3"/>',
	users:
		'<circle cx="9" cy="8" r="3.4"/><path d="M2.5 20c.6-3.6 3.1-5.6 6.5-5.6s5.9 2 6.5 5.6"/><path d="M15 4.8a3.4 3.4 0 0 1 0 6.5M17.3 14.8c2.2.6 3.6 2.3 4.2 5.2"/>',
	chat: '<path d="M4 5.5h16v11H11l-4.5 3.5v-3.5H4z"/><path d="M8.5 11h.01M12 11h.01M15.5 11h.01" stroke-width="2.2"/>',
	cap: '<path d="M2.5 9.5 12 5l9.5 4.5L12 14z"/><path d="M6.5 11.5v4.2c1.4 1.4 3.3 2.1 5.5 2.1s4.1-.7 5.5-2.1v-4.2M21.5 9.5v5"/>',
	clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
	phone:
		'<path d="M6.5 3.5h3l1.5 4-2 1.5c1 2.2 2.8 4 5 5l1.5-2 4 1.5v3c0 1.1-.9 2-2 2C10.4 18.5 5.5 13.6 4.5 5.5c0-1.1.9-2 2-2z"/>',
	mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="m4 6.5 8 6 8-6"/>',
	pin: '<path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',
	chevron: '<path d="M6 9l6 6 6-6"/>',
	check: '<circle cx="12" cy="12" r="8.5"/><path d="m8.2 12.3 2.6 2.6 5-5.2"/>',
};
const svg = (name && paths[name.trim().toLowerCase()]) || tooth;
---

<svg
	class:list={["icon", cls]}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
	focusable="false"
	set:html={svg}
/>
