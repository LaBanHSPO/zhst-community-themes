---
import type { MediaReference } from "../utils/site-identity";

interface Props {
	title: string;
	tagline?: string;
	logo?: MediaReference | null;
	class?: string;
	light?: boolean;
}
const { title, tagline, logo, class: className, light = false } = Astro.props;
---

<a class:list={["wordmark", { "is-light": light }, className]} href="/" aria-label={`${title} ${tagline ?? ""}, home`.replace(/\s+/g, " ")}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt ?? title} width="200" height="46" />
		) : (
			<>
				<svg class="wordmark-mark" viewBox="0 0 440 105" width="72" height="17" aria-hidden="true" focusable="false">
					<g fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round">
						<path d="M6 100 L132 12 L248 98" />
						<path d="M150 62 L228 6 L432 100" />
						<path d="M176 36 L250 100" opacity="0.7" />
					</g>
				</svg>
				<span class="wordmark-title">{title}</span>
				{tagline && <span class="wordmark-tagline">{tagline}</span>}
			</>
		)
	}
</a>
