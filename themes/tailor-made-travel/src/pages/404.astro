---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<div class="wrap notfound-inner">
			<div class="notfound-copy">
				<p class="eyebrow">Error 404</p>
				<h1 id="nf-title" class="display">This page is not on the map.</h1>
				<p class="lede">The page you are looking for has moved or never existed. Pick a place to start from here.</p>
				<div class="actions">
					<a class="btn" href="/">Back to home <Arrow /></a>
					<a class="btn btn-ghost" href="/journeys">Journeys</a>
					<a class="btn btn-ghost" href="/contact">Plan your journey</a>
				</div>
			</div>
			<img class="notfound-photo" src="/images/globe.webp" alt="" width="700" height="670" />
		</div>
	</section>
</Base>
