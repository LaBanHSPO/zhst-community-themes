---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { categoryLabel, dishUrl, formatPrice, getDishes, getVenue, photoSrc } from "../../lib/bistro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: dish, cacheHint } = await getEmDashEntry("dishes", slug);
if (!dish) return Astro.redirect("/404");
const [{ entries: all, cacheHint: listHint }, { venue, cacheHint: venueHint }, settings] = await Promise.all([
	getDishes(),
	getVenue(),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(listHint);
	Astro.cache.set(venueHint);
}

const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(dish, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const d = dish.data;
const mainSrc = photoSrc(d.image, d.photo);
const gallery = (d.gallery ?? [])
	.map((g) => ({ src: photoSrc(g.image, g.photo), alt: g.alt || d.title }))
	.filter((g): g is { src: string; alt: string } => Boolean(g.src));
const slides = gallery.length > 0 ? gallery : mainSrc ? [{ src: mainSrc, alt: d.image?.alt || d.title }] : [];

const self = d.slug ?? d.id;
const wanted = (d.related ?? "")
	.split(",")
	.map((s) => s.trim())
	.filter(Boolean);
const others = all.filter((e) => (e.data.slug ?? e.data.id) !== self);
const picked = wanted
	.map((w) => others.find((e) => (e.data.slug ?? e.data.id) === w))
	.filter((e): e is (typeof others)[number] => Boolean(e));
const related = [
	...picked,
	...others.filter((e) => !picked.includes(e) && photoSrc(e.data.image, e.data.photo)),
].slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary ?? null}
	canonical={seo.canonical}
	image={seo.ogImage ?? mainSrc ?? null}
	content={{ collection: "dishes", id: d.id, slug }}
>
	<article class="dish-detail">
		<div class="dish-grid">
			<div class="dish-media" data-gallery>
				<div class="dish-main">
					{slides[0] && <img data-main src={slides[0].src} alt={slides[0].alt} width="839" height="463" />}
				</div>
				{
					slides.length > 1 && (
						<div class="thumbs">
							<button class="icon-btn" type="button" data-step="-1" aria-label="Previous photo">
								<svg viewBox="0 0 16 28" aria-hidden="true">
									<path d="M14 2L2 14l12 12" fill="none" stroke="currentColor" stroke-width="1.6" />
								</svg>
							</button>
							<div class="thumb-row">
								{slides.map((s, i) => (
									<button
										class="thumb"
										type="button"
										data-index={i}
										data-src={s.src}
										data-alt={s.alt}
										aria-pressed={i === 0 ? "true" : "false"}
										aria-label={`Show photo ${i + 1}: ${s.alt}`}
									>
										<img src={s.src} alt="" loading="lazy" />
									</button>
								))}
							</div>
							<button class="icon-btn" type="button" data-step="1" aria-label="Next photo">
								<svg viewBox="0 0 16 28" aria-hidden="true">
									<path d="M2 2l12 12L2 26" fill="none" stroke="currentColor" stroke-width="1.6" />
								</svg>
							</button>
						</div>
					)
				}
			</div>

			<div class="dish-info">
				<span class="eyebrow">{categoryLabel(d.category)}</span>
				<h1 {...dish.edit.title}>{d.title}</h1>
				<p class="price-lg">{formatPrice(d.price)}</p>
				{d.description && <p class="desc" {...dish.edit.description}>{d.description}</p>}
				{
					d.ingredients && (
						<section aria-labelledby="ing-title">
							<h2 id="ing-title">Ingredients</h2>
							<p>{d.ingredients}</p>
						</section>
					)
				}
				<section aria-labelledby="alg-title">
					<h2 id="alg-title">Allergens</h2>
					<p>{d.allergens || "Please ask your server."}</p>
					<p class="note">Please inform your server of any food allergies or dietary restrictions.</p>
				</section>

				<form
					class="order-form"
					data-order-form
					data-email={venue.email}
					data-dish={d.title}
					data-price={formatPrice(d.price)}
					action={`mailto:${venue.email}?subject=${encodeURIComponent(`Order request: ${d.title}`)}`}
					method="post"
					enctype="text/plain"
				>
					<div class="order-row">
						<label for="qty">Quantity</label>
						<div class="stepper">
							<button type="button" data-qty="-1" aria-label="Decrease quantity">−</button>
							<input id="qty" name="quantity" type="number" inputmode="numeric" min="1" max="20" value="1" required />
							<button type="button" data-qty="1" aria-label="Increase quantity">+</button>
						</div>
						<button class="btn" type="submit">Add to order request</button>
					</div>
					<p class="form-status" role="status" aria-live="polite" data-status>
						<noscript>
							To request this dish, email <a href={`mailto:${venue.email}`}>{venue.email}</a> with the dish and quantity.
						</noscript>
					</p>
				</form>
			</div>
		</div>

		{
			related.length > 0 && (
				<section class="related" aria-labelledby="related-title">
					<div class="related-head">
						<h2 id="related-title">You<br />might also like</h2>
						<a class="eyebrow" href="/menu">More seasonal dishes</a>
					</div>
					{related.map((r) => {
						const src = photoSrc(r.data.image, r.data.photo);
						return (
							<a class="related-card" href={dishUrl(r.data)}>
								<div class="ph">{src && <img src={src} alt={r.data.image?.alt || r.data.title} loading="lazy" />}</div>
								<div>
									<h3>{r.data.title}</h3>
									<p class="price">{formatPrice(r.data.price)}</p>
									{r.data.summary && <p>{r.data.summary}</p>}
									<Arrow />
								</div>
							</a>
						);
					})}
				</section>
			)
		}
	</article>
</Base>

<script>
	// Thumbnail gallery: swap the main photo, step with the arrows.
	document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
		const main = root.querySelector<HTMLImageElement>("[data-main]");
		const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>(".thumb"));
		if (!main || thumbs.length === 0) return;
		let current = 0;
		const show = (i: number) => {
			current = (i + thumbs.length) % thumbs.length;
			const t = thumbs[current];
			main.src = t.dataset.src ?? main.src;
			main.alt = t.dataset.alt ?? main.alt;
			thumbs.forEach((b, j) => b.setAttribute("aria-pressed", String(j === current)));
			t.scrollIntoView({ block: "nearest", inline: "nearest" });
		};
		thumbs.forEach((b, i) => b.addEventListener("click", () => show(i)));
		root.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) =>
			b.addEventListener("click", () => show(current + Number(b.dataset.step))),
		);
	});

	// Order request: compose an email to the restaurant. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-order-form]").forEach((form) => {
		const qty = form.querySelector<HTMLInputElement>("input[name=quantity]");
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!qty || !status) return;
		const clamp = (n: number) => Math.min(20, Math.max(1, Number.isFinite(n) ? Math.round(n) : 1));
		form.querySelectorAll<HTMLButtonElement>("[data-qty]").forEach((b) =>
			b.addEventListener("click", () => {
				qty.value = String(clamp(Number(qty.value) + Number(b.dataset.qty)));
			}),
		);
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Order requests are not available right now. Please call the restaurant.";
				return;
			}
			const n = clamp(Number(qty.value));
			const subject = `Order request: ${n} × ${form.dataset.dish}`;
			const body = `Hello,\n\nI would like to request ${n} × ${form.dataset.dish} (${form.dataset.price} each).\n\nName:\nPhone:\nPreferred pick-up or dining time:\n`;
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			status.innerHTML = "";
			status.append(
				"Your email app should open with this request ready to send. It is only sent once you send that email. If nothing opened, write to ",
			);
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
