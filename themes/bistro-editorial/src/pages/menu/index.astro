---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import DietMarks from "../../components/DietMarks.astro";
import MenuGroup from "../../components/MenuGroup.astro";
import { CATEGORIES, DIETARY, dishUrl, formatPrice, getDishes, photoSrc } from "../../lib/bistro";

const { entries: dishes, cacheHint } = await getDishes();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const requested = Astro.url.searchParams.get("category") ?? "";
const active = CATEGORIES.some((c) => c.slug === requested) ? requested : "all";
const groups = CATEGORIES.filter((c) => active === "all" || c.slug === active)
	.map((c) => ({ ...c, items: dishes.filter((d) => d.data.category === c.slug) }))
	.filter((g) => g.items.length > 0);

const recommended = dishes.find((d) => d.data.recommended) ?? null;
const stripPhoto = (d: (typeof dishes)[number]) =>
	photoSrc(d.data.banner_image, d.data.banner_photo) ?? photoSrc(d.data.image, d.data.photo);
const highlights = dishes.filter((d) => d.data.highlight && stripPhoto(d)).slice(0, 3);
// The design shows the first two sections, then the photo strip, then the rest of the menu.
const firstGroups = groups.slice(0, 2);
const restGroups = groups.slice(2);
const tabs = [{ slug: "all", label: "All" }, ...CATEGORIES];
const recSrc = recommended ? photoSrc(recommended.data.image, recommended.data.photo) : undefined;
---

<Base
	title="Our seasonal menu"
	description="Our seasonal menu: starters, mains, pastas, seafood, steaks, sides and desserts."
	overlay
>
	<section class="hero hero-page" style="--hero-img:url('/images/menu-hero.webp')" aria-labelledby="menu-title">
		<div class="hero-copy">
			<h1 id="menu-title">Our seasonal menu</h1>
			<hr class="rule" />
			<p class="lede-caps">Fresh ingredients. Inspired dishes. Always a warm welcome.</p>
		</div>
	</section>

	<div class="menu-body">
		<div class="menu-layout">
			<div>
				<nav class="tabs" aria-label="Menu sections">
					{
						tabs.map((t) => (
							<a
								href={t.slug === "all" ? "/menu" : `/menu?category=${t.slug}`}
								aria-current={active === t.slug ? "page" : undefined}
							>
								{t.label}
							</a>
						))
					}
				</nav>
				{
					groups.length === 0 ? (
						<p class="empty">No dishes in this section yet.</p>
					) : (
						<div class="menu-columns">
							{firstGroups.map((g) => (
								<MenuGroup {...g} />
							))}
						</div>
					)
				}
			</div>
			<div class="vline" aria-hidden="true"></div>
			{
				recommended && (
					<aside class="recommend" aria-labelledby="rec-title">
						{recSrc && (
							<img
								src={recSrc}
								alt={recommended.data.image?.alt || recommended.data.title}
								width="409"
								height="279"
							/>
						)}
						<div>
							<span class="eyebrow">Seasonal recommendation</span>
							<div class="row">
								<h2 id="rec-title">{recommended.data.title}</h2>
								<span class="price">{formatPrice(recommended.data.price)}</span>
							</div>
							{recommended.data.summary && <p>{recommended.data.summary}</p>}
							<a class="btn btn-sm" href={dishUrl(recommended.data)}>
								View dish detail <Arrow />
							</a>
						</div>
					</aside>
				)
			}
		</div>
	</div>

	{
		highlights.length > 0 && (
			<section class="photo-strip" aria-label="Dishes to try">
				{highlights.map((d) => (
					<a class="photo-card" href={dishUrl(d.data)}>
						<img src={stripPhoto(d)} alt={d.data.banner_image?.alt || d.data.image?.alt || d.data.title} loading="lazy" />
						<span class="cap">
							<span>
								{d.data.title} <DietMarks marks={d.data.dietary} />
							</span>
							<span>{formatPrice(d.data.price)}</span>
						</span>
					</a>
				))}
			</section>
		)
	}
	<div class="menu-rest">
		{
			restGroups.length > 0 && (
				<div class="menu-columns">
					{restGroups.map((g) => (
						<MenuGroup {...g} />
					))}
				</div>
			)
		}
		<p class="diet-legend">
			<span class="sr-only">Dietary key:</span>
			{
				Object.entries(DIETARY).map(([key, d]) => (
					<span>
						<DietMarks marks={[key]} />
						{d.label}
					</span>
				))
			}
		</p>
	</div>
</Base>
