---
import Base from "../layouts/Base.astro";
import { getVenue } from "../lib/bistro";

const { venue, cacheHint } = await getVenue();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Earliest selectable date is today in the site's timezone.
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Saigon" }).format(new Date());

const times: string[] = [];
for (let h = 11; h <= 21; h++) {
	for (const m of [0, 30]) {
		if (h === 21 && m === 30) continue;
		const hour = h > 12 ? h - 12 : h;
		times.push(`${hour}:${m === 0 ? "00" : "30"} ${h >= 12 ? "PM" : "AM"}`);
	}
}
const sizes = ["1", "2", "3", "4", "5", "6", "7", "8", "9+"];
---

<Base title="Reserve a table" description="Request a table at Bistro. We confirm every reservation by email or phone." overlay>
	<div class="reserve">
		<div class="reserve-photo" role="img" aria-label="Candlelit table set for dinner in the dining room"></div>
		<div class="reserve-panel">
			<div class="reserve-form-wrap">
				<span class="eyebrow">Reserve a table</span>
				<h1>A seat at our table.</h1>
				<p class="intro">
					Join us for seasonal food, thoughtful drinks and a warm neighborhood atmosphere. We look forward to welcoming
					you.
				</p>
				<form
					class="reserve-form"
					data-reserve-form
					data-email={venue.email}
					action={`mailto:${venue.email}`}
					method="post"
					enctype="text/plain"
				>
					<div class="form-grid">
						<div class="field">
							<label for="r-date">Date</label>
							<input id="r-date" name="date" type="date" min={today} required />
						</div>
						<div class="field">
							<label for="r-time">Time</label>
							<select id="r-time" name="time" required>
								{times.map((t) => <option selected={t === "7:00 PM"}>{t}</option>)}
							</select>
						</div>
						<div class="field">
							<label for="r-size">Party size</label>
							<select id="r-size" name="party" required>
								{sizes.map((s) => <option selected={s === "2"}>{s}</option>)}
							</select>
						</div>
						<div class="field">
							<label for="r-name">Full name</label>
							<input id="r-name" name="name" type="text" autocomplete="name" placeholder="Your name" required />
						</div>
						<div class="field">
							<label for="r-email">Email</label>
							<input id="r-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
						</div>
						<div class="field">
							<label for="r-phone">Phone</label>
							<input id="r-phone" name="phone" type="tel" autocomplete="tel" placeholder="(555) 123-4567" required />
						</div>
						<div class="field full">
							<label for="r-notes">Special requests (optional)</label>
							<textarea id="r-notes" name="notes" rows="3" placeholder="Any special requests or notes for your visit?"></textarea>
						</div>
					</div>
					<button class="btn btn-block" type="submit">Request reservation</button>
					<p class="helper">We'll confirm your reservation by email or phone as soon as possible.</p>
					<p class="form-status" role="status" aria-live="polite" data-status>
						<noscript>
							This form needs JavaScript to prepare your email. You can also write to
							<a href={`mailto:${venue.email}`}>{venue.email}</a> with your date, time and party size.
						</noscript>
					</p>
				</form>
			</div>
		</div>
	</div>

	<section class="reserve-notes" aria-label="Good to know">
		<ul>
			<li>
				<svg viewBox="0 0 46 46" aria-hidden="true">
					<rect x="3" y="7" width="40" height="36" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
					<path d="M3 17h40M13 2v10M33 2v10" fill="none" stroke="currentColor" stroke-width="2" />
				</svg>
				<div>
					<h2>Advance reservations</h2>
					<p>We recommend booking ahead, especially on weekends.</p>
				</div>
			</li>
			<li>
				<svg viewBox="0 0 46 60" aria-hidden="true">
					<path
						d="M9 3h28c0 14-2 26-14 26S9 17 9 3zM10 12h26M23 29v27M12 57h22"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					/>
				</svg>
				<div>
					<h2>Special occasions</h2>
					<p>Celebrating something special?<br />Let us know and we'll help make it memorable.</p>
				</div>
			</li>
			<li>
				<svg viewBox="0 0 46 60" aria-hidden="true">
					<path d="M23 57S5 37 5 22a18 18 0 0 1 36 0c0 15-18 35-18 35z" fill="none" stroke="currentColor" stroke-width="2" />
					<circle cx="23" cy="22" r="7" fill="none" stroke="currentColor" stroke-width="2" />
				</svg>
				<div>
					<h2>Walk-ins welcome</h2>
					<p>We always keep a few tables for walk-ins, subject to availability.</p>
				</div>
			</li>
		</ul>
	</section>
</Base>

<script>
	// Compose a reservation request email; the restaurant confirms it by reply. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-reserve-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online requests are not available right now. Please call the restaurant.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Table request: ${get("party")} on ${get("date")} at ${get("time")}`;
			const body = [
				"Hello,",
				"",
				"I would like to request a table:",
				`Date: ${get("date")}`,
				`Time: ${get("time")}`,
				`Party size: ${get("party")}`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				`Phone: ${get("phone")}`,
				get("notes") ? `Special requests: ${get("notes")}` : "",
				"",
				"I understand the reservation is confirmed only once you reply.",
			]
				.filter((line, i, arr) => line !== "" || arr[i - 1] !== "")
				.join("\n");
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			status.textContent = "";
			status.append(
				"Your email app should open with this request ready to send. It is only sent once you send that email, and we confirm by reply. If nothing opened, write to ",
			);
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
