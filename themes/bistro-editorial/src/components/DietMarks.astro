---
import { DIETARY } from "../lib/bistro";

interface Props {
	marks?: string[] | null;
}
const marks = (Astro.props.marks ?? []).filter((m) => m in DIETARY);
---

{
	marks.length > 0 && (
		<span class="diet">
			{marks.map((m) => {
				const d = DIETARY[m];
				return d.short === "leaf" ? (
					<span class="diet-mark is-leaf" title={d.label}>
						<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
							<path
								d="M4 16c0-7 4-11 12-12-1 8-5 12-12 12zM4 16l7-7"
								fill="none"
								stroke="currentColor"
								stroke-width="1.4"
								stroke-linecap="round"
							/>
						</svg>
						<span class="sr-only">{d.label}</span>
					</span>
				) : (
					<span class="diet-mark" title={d.label}>
						<span aria-hidden="true">{d.short}</span>
						<span class="sr-only">{d.label}</span>
					</span>
				);
			})}
		</span>
	)
}
