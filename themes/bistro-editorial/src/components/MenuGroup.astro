---
import type { ContentEntry } from "emdash";
import DietMarks from "./DietMarks.astro";
import { dishUrl, formatPrice, type Dish } from "../lib/bistro";

interface Props {
	slug: string;
	label: string;
	items: ContentEntry<Dish>[];
}
const { slug, label, items } = Astro.props;
---

<section class="menu-group" aria-labelledby={`sec-${slug}`}>
	<h2 id={`sec-${slug}`}>{label}</h2>
	<ul class="menu-list">
		{
			items.map((d) => (
				<li class="menu-item">
					<div class="row">
						<a href={dishUrl(d.data)}>
							<span {...d.edit.title}>{d.data.title}</span>
							<DietMarks marks={d.data.dietary} />
						</a>
						<span class="price">{formatPrice(d.data.price)}</span>
					</div>
					{d.data.summary && <p>{d.data.summary}</p>}
				</li>
			))
		}
	</ul>
</section>
