	"content": {
		"pages": [
			{
				"id": "our-story",
				"slug": "our-story",
				"status": "published",
				"data": {
					"title": "Our story",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "b3",
							"children": [
								{
									"_type": "span",
									"text": "Bistro was born from a simple idea — great food brings people together. We're a neighborhood restaurant where seasonal ingredients, good drinks and warm hospitality always have a place.",
									"_key": "s3"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b4",
							"children": [
								{
									"_type": "span",
									"text": "The menu follows the market: we cook what local growers bring to the back door each week, and we change the board when the season turns.",
									"_key": "s4"
								}
							]
						}
					]
				}
			},
			{
				"id": "private-dining",
				"slug": "private-dining",
				"status": "published",
				"data": {
					"title": "Private dining",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "b1",
							"children": [
								{
									"_type": "span",
									"text": "Our back room seats up to eighteen guests for birthdays, rehearsal dinners and long Sunday lunches. We build a set menu with you from whatever the season is giving us that week.",
									"_key": "s1"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "b2",
							"children": [
								{
									"_type": "span",
									"text": "Write to us through the Reserve a table page with your date, party size and occasion, and we will reply with menus and availability.",
									"_key": "s2"
								}
							]
						}
					]
				}
			}
		],
