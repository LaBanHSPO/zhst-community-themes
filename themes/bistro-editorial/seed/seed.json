{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Bistro",
		"description": "A warm editorial restaurant theme: seasonal menu, dish pages, table requests and a visit page",
		"author": "ZeroHostCMS"
	},
	"settings": {
		"title": "Bistro",
		"tagline": "Good food. Great company."
	},
	"collections": [
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		},
		{
			"slug": "dishes",
			"label": "Dishes",
			"labelSingular": "Dish",
			"urlPattern": "/menu/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Dish name",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "category",
					"label": "Menu section",
					"type": "select",
					"required": true,
					"indexed": true,
					"defaultValue": "mains",
					"validation": {
						"options": [
							"starters",
							"mains",
							"pastas",
							"seafood",
							"steaks",
							"sides",
							"desserts"
						]
					}
				},
				{
					"slug": "price",
					"label": "Price (USD)",
					"type": "number",
					"required": true,
					"validation": {
						"min": 0
					}
				},
				{
					"slug": "summary",
					"label": "Menu line (short description)",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "description",
					"label": "Full description",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "ingredients",
					"label": "Ingredients",
					"type": "text"
				},
				{
					"slug": "allergens",
					"label": "Allergens",
					"type": "string"
				},
				{
					"slug": "dietary",
					"label": "Dietary marks",
					"type": "multiSelect",
					"validation": {
						"options": [
							"vegetarian",
							"vegan-on-request",
							"gluten-free"
						]
					}
				},
				{
					"slug": "featured",
					"label": "Show on homepage (seasonal dishes)",
					"type": "boolean",
					"indexed": true
				},
				{
					"slug": "highlight",
					"label": "Show in menu photo strip",
					"type": "boolean",
					"indexed": true
				},
				{
					"slug": "recommended",
					"label": "Seasonal recommendation",
					"type": "boolean",
					"indexed": true
				},
				{
					"slug": "related",
					"label": "Related dish slugs (comma separated)",
					"type": "string"
				},
				{
					"slug": "position",
					"label": "Sort order",
					"type": "integer"
				},
				{
					"slug": "image",
					"label": "Photo (upload)",
					"type": "image"
				},
				{
					"slug": "photo",
					"label": "Bundled photo path",
					"type": "string"
				},
				{
					"slug": "banner_image",
					"label": "Wide photo for the menu strip (upload)",
					"type": "image"
				},
				{
					"slug": "banner_photo",
					"label": "Wide photo for the menu strip (bundled path)",
					"type": "string"
				},
				{
					"slug": "gallery",
					"label": "Gallery",
					"type": "repeater",
					"validation": {
						"maxItems": 8,
						"subFields": [
							{
								"slug": "image",
								"label": "Photo (upload)",
								"type": "image"
							},
							{
								"slug": "photo",
								"label": "Bundled photo path",
								"type": "string"
							},
							{
								"slug": "alt",
								"label": "Alt text",
								"type": "string",
								"required": true
							}
						]
					}
				}
			]
		},
