---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import PageHead from "../../components/PageHead.astro";
import { getTraining, lines, photoSrc, trainingHref } from "../../lib/pt";

const trainingResult = await getTraining();
if (Astro.cache?.enabled) Astro.cache.set(trainingResult.cacheHint);
const items = trainingResult.entries;
---

<Base title="Training" description="Personal training options at Movement: one-to-one sessions, small group classes, online coaching, strength for beginners and conditioning circuits. Who each one is for, what a session looks like and how long it runs.">
	<PageHead eyebrow="Training" title="Five ways to train." intro="Each format has a set length, a set place and a clear first session. Start with a free intro chat and we will pick one together." />
	<section class="train-list">
		<div class="wrap">
			<ol class="train-cards">
				{
					items.map((t, i) => {
						const src = photoSrc(t.data.image, t.data.photo);
						const steps = lines(t.data.session);
						return (
							<li class="train-card">
								<a class="train-card-photo" href={trainingHref(t.data)} tabindex="-1" aria-hidden="true">
									{src && <img src={src} alt="" width="520" height="400" loading="lazy" />}
								</a>
								<div class="train-card-body">
									<p class="label label-plain">{String(i + 1).padStart(2, "0")} / {t.data.where}</p>
									<h2 class="train-card-title" {...t.edit.title}><a href={trainingHref(t.data)}>{t.data.title}</a></h2>
									<p class="train-card-sum">{t.data.summary}</p>
									<dl class="facts">
										<div><dt>Who it is for</dt><dd>{t.data.who_for}</dd></div>
										<div><dt>Length</dt><dd>{t.data.length}</dd></div>
										{steps.length > 0 && <div><dt>First step</dt><dd>{steps[0]}</dd></div>}
									</dl>
									<a class="text-link" href={trainingHref(t.data)}><span>See what a session looks like</span><Arrow /></a>
								</div>
							</li>
						);
					})
				}
			</ol>
		</div>
	</section>
	<section class="start" aria-labelledby="start-title">
		<div class="wrap start-inner">
			<div>
				<h2 id="start-title" class="section-title">Not sure which<br />one is for you?</h2>
			</div>
			<div class="start-copy">
				<p>Book a free 20-minute intro chat. Tell me what you want to do and what you have tried, and I will suggest where to begin.</p>
				<a class="btn btn-dark" href="/contact"><span>Book an intro chat</span><Arrow /></a>
			</div>
		</div>
	</section>
</Base>
