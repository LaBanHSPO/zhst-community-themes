    "steps": [
      {
        "id": "intro-chat",
        "slug": "intro-chat",
        "status": "published",
        "data": {
          "title": "Free intro chat",
          "text": "Twenty minutes by phone or in the studio. You tell me what you want to do, what you have tried and anything that hurts.",
          "position": 10
        }
      },
