---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import BookingBand from "../components/BookingBand.astro";
import PageHead from "../components/PageHead.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getSpeaker } from "../lib/site";

const [{ entry: page, cacheHint }, speakerResult, settings] = await Promise.all([
	getEmDashEntry("pages", "speaker-kit"),
	getSpeaker(),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	if (cacheHint) Astro.cache.set(cacheHint);
	Astro.cache.set(speakerResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = page ? getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: "/speaker-kit" }) : null;
const hasBody = Boolean(page?.data.content && page.data.content.length > 0);

// The photos in the kit are the theme's own images, served from /images.
const photos = [
	{
		file: "headshot-portrait.webp",
		label: "Portrait",
		size: "960 x 1196 px",
		alt: "Caleb Rivers in a dark blazer with a headset microphone, smiling and looking up",
		w: 960,
		h: 1196,
	},
	{
		file: "headshot-wide.webp",
		label: "On stage, wide",
		size: "1350 x 924 px",
		alt: "Caleb Rivers on a dark stage with his arms open, a spotlight behind him",
		w: 1350,
		h: 924,
	},
	{
		file: "headshot-gesture.webp",
		label: "Gesture, cropped",
		size: "1420 x 572 px",
		alt: "Caleb Rivers from the chest down, one hand held out and one raised, in a dark blazer",
		w: 1420,
		h: 572,
	},
];
---

<Base
	title={seo?.title ?? "Speaker kit"}
	pageTitle={seo?.ogTitle}
	description={seo?.description ?? page?.data.intro ?? "Bios, an introduction to read aloud, photos to download and technical basics for Caleb Rivers."}
	canonical={seo?.canonical}
	content={page ? { collection: "pages", id: page.data.id, slug: "speaker-kit" } : undefined}
>
	<PageHead
		id="kit-title"
		eyebrow={page?.data.eyebrow ?? "For organisers"}
		title={page?.data.title ?? "Speaker kit"}
		intro={page?.data.intro}
		edit={page ? { ...page.edit.title } : {}}
	/>

	<section class="kit-photos" aria-labelledby="kit-photos-title">
		<div class="wrap">
			<h2 id="kit-photos-title" class="kit-photos-title">Photos to download</h2>
			<ul class="photo-grid">
				{
					photos.map((p) => (
						<li class="photo">
							<a class="photo-frame" href={`/images/${p.file}`} download>
								<img src={`/images/${p.file}`} alt={p.alt} width={p.w} height={p.h} loading="lazy" />
							</a>
							<p class="photo-name">{p.label}</p>
							<p class="photo-meta">WebP, {p.size}</p>
							<a class="text-link" href={`/images/${p.file}`} download><span>Download</span><Arrow /></a>
						</li>
					))
				}
			</ul>
			<p class="photo-note">Caleb Rivers is a fictional speaker and these portraits are AI-generated for this theme.</p>
		</div>
	</section>

	<section class="kit-body">
		<div class="wrap">
			<div class="prose">
				{hasBody ? <PortableText value={page!.data.content} /> : <p>The speaker kit is coming soon.</p>}
			</div>
		</div>
	</section>

	<BookingBand speaker={speakerResult.speaker} />
</Base>
