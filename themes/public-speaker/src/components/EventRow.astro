---
import { dateParts, talkHref } from "../lib/site";

interface Props {
	day: string;
	title: string;
	venue?: string | null;
	city?: string | null;
	kind?: string | null;
	note?: string | null;
	talk?: { slug: string | null; id: string; title: string } | null;
	past?: boolean;
}
const { day, title, venue, city, kind, note, talk, past = false } = Astro.props;
const p = dateParts(day);
const place = [venue, city].filter(Boolean).join(", ");
---

<li class:list={["event", { "is-past": past }]}>
	<time class="event-date" datetime={day}>
		<span class="event-day">{p.day}</span>
		<span class="event-month">{p.month} {p.year}</span>
	</time>
	<div class="event-main">
		<h3 class="event-title">{title}</h3>
		<p class="event-place">{place}{note ? `. ${note}` : ""}</p>
	</div>
	<div class="event-side">
		{kind && <span class="event-kind">{kind}</span>}
		{talk && <a class="event-talk" href={talkHref(talk)}>{talk.title}</a>}
	</div>
</li>
