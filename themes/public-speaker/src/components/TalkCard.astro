---
import { photoSrc, talkHref, topicLabel } from "../lib/site";
import type { Talk } from "../../emdash-env";

interface Props {
	talk: { data: Talk; edit?: Record<string, any> };
	eager?: boolean;
}
const { talk, eager = false } = Astro.props;
const d = talk.data;
const src = photoSrc(d.image, d.photo);
---

<a class="talk-card" href={talkHref(d)}>
	{src && <img src={src} alt="" width="856" height="470" loading={eager ? "eager" : "lazy"} />}
	<span class="talk-card-body">
		<span class="talk-card-text">
			<span class="talk-card-topic">{topicLabel(d.topic)}</span>
			<span class="talk-card-title" {...talk.edit?.title}>{d.title}</span>
			<span class="talk-card-line">{d.summary}</span>
		</span>
		<span class="circle-arrow" aria-hidden="true">
			<svg width="18" height="14" viewBox="0 0 20 14" focusable="false"><path d="M1 7h17M12 1.500 18 7l-6 5.500" fill="none" stroke="currentColor" stroke-width="1.500" stroke-linecap="round" stroke-linejoin="round" /></svg>
		</span>
	</span>
</a>
