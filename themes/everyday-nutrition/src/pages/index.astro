---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import LineIcon from "../components/LineIcon.astro";
import { getPackages, getRecipes, getSteps, mealLabel, packageHref, photoAlt, photoSrc, recipeHref } from "../lib/nutri";

const [packagesResult, recipesResult, stepsResult] = await Promise.all([getPackages(), getRecipes(), getSteps()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(packagesResult.cacheHint);
	Astro.cache.set(recipesResult.cacheHint);
	Astro.cache.set(stepsResult.cacheHint);
}
const allPackages = packagesResult.entries;
const packages = (allPackages.some((p) => p.data.featured) ? allPackages.filter((p) => p.data.featured) : allPackages).slice(0, 3);
const allRecipes = recipesResult.entries;
const recipes = (allRecipes.some((r) => r.data.featured) ? [...allRecipes.filter((r) => r.data.featured), ...allRecipes.filter((r) => !r.data.featured)] : allRecipes).slice(0, 4);
const steps = stepsResult.entries;
---

<Base
	title="Good food for real life"
	description="Everyday Nutrition is a nutrition coaching practice with a test kitchen. Practical coaching packages, home-tested recipes and everyday support, run by video call."
>
	<section class="hero" aria-labelledby="hero-title">
		<img
			class="hero-photo"
			src="/images/hero-bowl.webp"
			alt="A grain bowl with roasted sweet potato, chickpeas, kale, avocado and radish on a linen cloth, with a board of pumpkin seeds and a glass of lemon water"
			width="1448"
			height="629"
			fetchpriority="high"
		/>
		<div class="hero-copy">
			<p class="hero-label">Simple choices. Brighter days.</p>
			<h1 id="hero-title" class="hero-title">Good food<br />for real life.</h1>
			<p class="hero-sub">Practical nutrition coaching, wholesome recipes and everyday support to help you feel your best, at home and beyond.</p>
			<a class="btn" href="/contact"><span>Start your journey</span><Arrow /></a>
			<ul class="hero-points">
				<li><LineIcon name="leaf" size={44} /><span>Real Food<br />Habits</span></li>
				<li><LineIcon name="bowl" size={46} /><span>Balanced<br />Meals</span></li>
				<li><LineIcon name="sun" size={50} /><span>A Healthier<br />Happier You</span></li>
			</ul>
		</div>
		<p class="hero-note" aria-hidden="true"><span>Nourishing</span><span>today</span><span>brighter</span><span>tomorrow</span></p>
		<svg class="hero-stroke" width="34" height="6" viewBox="0 0 34 6" aria-hidden="true" focusable="false">
			<path d="M1 4.500C10 2.500 22 1.500 33 1" fill="none" stroke="currentColor" stroke-width="1.400" stroke-linecap="round" />
		</svg>
	</section>

	<section class="kinder" aria-labelledby="kinder-title">
		<div class="kinder-copy">
			<p class="eyebrow">A kinder way to eat</p>
			<h2 id="kinder-title" class="section-title">Nutrition that<br />fits your life.</h2>
			<p class="body">Personalised guidance, delicious food and realistic tools to help you build a balanced lifestyle, one meal at a time.</p>
		</div>
		<div class="cards">
			<a class="photo-card" href="/recipes"><img src="/images/card-recipes.webp" alt="Hands chopping curly kale on a wooden board with a chef's knife" width="588" height="536" loading="eager" /><span>Simple<br />Recipes</span></a>
			<a class="photo-card" href="/approach"><img src="/images/card-choices.webp" alt="A speckled bowl of lentil salad with roasted vegetables and herbs on a wooden table" width="588" height="536" loading="eager" /><span>Balanced<br />Choices</span></a>
			<a class="photo-card" href="/coaching"><img src="/images/card-habits.webp" alt="A speckled mug of tea beside a spiral notebook with handwriting on a wooden table" width="590" height="536" loading="eager" /><span>Lasting<br />Habits</span></a>
		</div>
	</section>

	{
		steps.length > 0 && (
			<section class="section how" aria-labelledby="how-title">
				<div class="wrap how-grid">
					<div class="how-photo">
						<img src="/images/kitchen-wide.webp" alt="A sunlit kitchen counter with a grain bowl, a bottle of olive oil, a lemon half, a pot of basil and a green cloth" width="1448" height="1086" loading="lazy" />
					</div>
					<div class="how-copy">
						<p class="eyebrow">How coaching works</p>
						<h2 id="how-title" class="section-title">From a first call to<br />a routine you keep.</h2>
						<ol class="step-list">
							{steps.map((s, i) => (
								<li>
									<span class="step-num" aria-hidden="true">{i + 1}</span>
									<div>
										<strong {...s.edit.title}>{s.data.title}</strong>
										<span class="t">{s.data.text}</span>
									</div>
								</li>
							))}
						</ol>
						<a class="text-link" href="/approach"><span>Read about our approach</span><Arrow /></a>
					</div>
				</div>
			</section>
		)
	}

	{
		recipes.length > 0 && (
			<section class="section recipes" aria-labelledby="recipes-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">Recipes</p>
							<h2 id="recipes-title" class="section-title">Cooked in our kitchen<br />before it is written down.</h2>
						</div>
						<div class="recipes-head-actions">
							<nav class="filters" aria-label="Recipes by meal">
								<a href="/recipes?meal=breakfast">Breakfast</a>
								<a href="/recipes?meal=lunch">Lunch</a>
								<a href="/recipes?meal=dinner">Dinner</a>
								<a href="/recipes?meal=snacks">Snacks</a>
							</nav>
						</div>
					</div>
					<ul class="recipe-grid">
						{recipes.map((r) => {
							const src = photoSrc(r.data.image, r.data.photo);
							return (
								<li>
									<a class="recipe-card" href={recipeHref(r.data)}>
										<span class="ph">{src && <img src={src} alt={photoAlt(r.data.image, r.data.photo, r.data.title)} width="520" height="440" loading="lazy" />}</span>
										<span class="recipe-meta">{[mealLabel(r.data.meal), r.data.time].filter(Boolean).join(" / ")}</span>
										<strong class="recipe-title" {...r.edit.title}>{r.data.title}</strong>
									</a>
								</li>
							);
						})}
					</ul>
					<p style="margin-top:40px"><a class="text-link" href="/recipes"><span>All recipes</span><Arrow /></a></p>
				</div>
			</section>
		)
	}

	{
		packages.length > 0 && (
			<section class="section packages" aria-labelledby="pkg-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">Coaching packages</p>
							<h2 id="pkg-title" class="section-title">Pick the length<br />that suits you.</h2>
						</div>
						<a class="text-link" href="/coaching"><span>Compare all packages</span><Arrow /></a>
					</div>
					<ul class="pkg-rows">
						{packages.map((p) => (
							<li>
								<a class="pkg-row" href={packageHref(p.data)}>
									<strong class="pkg-name" {...p.edit.title}>{p.data.title}</strong>
									<span class="pkg-sum">{p.data.summary}</span>
									<span class="pkg-len">{p.data.length}</span>
									<span class="pkg-price">{p.data.price}</span>
									<span class="pkg-go" aria-hidden="true"><Arrow /></span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<section class="start" aria-labelledby="start-title">
		<div class="wrap start-inner">
			<div>
				<p class="eyebrow">Start here</p>
				<h2 id="start-title" class="section-title">Tell us what a normal<br />week looks like.</h2>
			</div>
			<div>
				<p>Send a few lines about your week, who you cook for and what you would like to change. We reply within two working days to set up a free 20-minute call.</p>
				<a class="btn btn-light" href="/contact"><span>Start your journey</span><Arrow /></a>
			</div>
		</div>
	</section>
</Base>
