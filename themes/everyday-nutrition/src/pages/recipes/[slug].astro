---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getRecipes, lines, mealLabel, photoAlt, photoSrc, recipeHref, tagList } from "../../lib/nutri";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: recipe, cacheHint } = await getEmDashEntry("recipes", slug);
if (!recipe) return Astro.rewrite("/404");

const [allResult, settings] = await Promise.all([getRecipes(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(recipe, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
const d = recipe.data;
const cover = photoSrc(d.image, d.photo);
const ingredients = lines(d.ingredients);
const method = lines(d.method);
const tags = tagList(d.tags);
const more = allResult.entries.filter((r) => r.data.id !== d.id && r.data.meal === d.meal).concat(allResult.entries.filter((r) => r.data.id !== d.id && r.data.meal !== d.meal)).slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary}
	canonical={seo.canonical}
	image={seo.ogImage ?? cover}
	content={{ collection: "recipes", id: d.id, slug }}
	current="/recipes"
>
	<header class="recipe-head">
		<div class="wrap">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/recipes">Recipes</a>
				<span aria-hidden="true">/</span>
				{d.meal && <a href={`/recipes?meal=${d.meal}`}>{mealLabel(d.meal)}</a>}
			</nav>
			<div class="recipe-hero">
				<div>
					<p class="eyebrow">{mealLabel(d.meal)}</p>
					<h1 class="display" {...recipe.edit.title}>{d.title}</h1>
					<p class="lede">{d.summary}</p>
					<dl class="recipe-facts">
						{d.time && <div><dt>Time</dt><dd>{d.time}</dd></div>}
						{d.servings && <div><dt>Serves</dt><dd>{d.servings}</dd></div>}
						<div><dt>Meal</dt><dd>{mealLabel(d.meal)}</dd></div>
					</dl>
					{tags.length > 0 && <ul class="tags" aria-label="Tags">{tags.map((t) => <li>{t}</li>)}</ul>}
				</div>
				{cover && <img src={cover} alt={photoAlt(d.image, d.photo, d.title)} width="900" height="756" fetchpriority="high" />}
			</div>
		</div>
	</header>

	<section class="recipe-body">
		<div class="wrap recipe-cols">
			<div class="ingredients">
				<h2>Ingredients</h2>
				<ul>{ingredients.map((i) => <li>{i}</li>)}</ul>
			</div>
			<div class="method">
				<h2>Method</h2>
				<ol>{method.map((s) => <li>{s}</li>)}</ol>
				{d.tip && <p class="tip"><strong>Cook's note.</strong> {d.tip}</p>}
			</div>
		</div>
	</section>

	{
		more.length > 0 && (
			<section class="more-band" aria-labelledby="more-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">Keep cooking</p>
							<h2 id="more-title" class="section-title">More from the kitchen.</h2>
						</div>
						<a class="text-link" href="/recipes"><span>All recipes</span><Arrow /></a>
					</div>
					<ul class="more-list">
						{more.map((r) => (
							<li>
								<a href={recipeHref(r.data)}>
									<strong>{r.data.title}</strong>
									<span>{r.data.summary}</span>
									<em>{[mealLabel(r.data.meal), r.data.time].filter(Boolean).join(" / ")}</em>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}
</Base>
