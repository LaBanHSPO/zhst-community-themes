---
interface Props {
	name: "leaf" | "bowl" | "sun";
	size?: number;
}
const { name, size = 40 } = Astro.props;
const attrs = { width: size, height: size, viewBox: "0 0 40 40", fill: "none", stroke: "currentColor", "stroke-width": 1.2, "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true", focusable: "false" } as const;
---

{
	name === "leaf" ? (
		<svg width={size} height={size} viewBox="0 0 40 40" fill="currentColor" opacity=".85" aria-hidden="true" focusable="false">
			<path d="M7 31C4 19 12 8 32 6c1 17-6 26-23 27Z" />
			<path d="M7 34L26 14" stroke="#f7f3ef" stroke-width="1.100" fill="none" />
		</svg>
	) : name === "bowl" ? (
		<svg {...attrs}>
			<path d="M4 18h32c0 8-6 15-16 15S4 26 4 18Z" fill="currentColor" fill-opacity=".62" />
			<path d="M4 18c0-2 7-3 16-3s16 1 16 3-7 3-16 3S4 20 4 18Z" />
			<path d="M13 33h14" />
			<path d="M16 14c1-3 3-4 5-4" />
		</svg>
	) : (
		<svg {...attrs}>
			<circle cx="20" cy="20" r="6.500" />
			<path d="M20 4v5M20 31v5M4 20h5M31 20h5M8.700 8.700l3.500 3.500M27.800 27.800l3.500 3.500M31.300 8.700l-3.500 3.500M12.200 27.800l-3.500 3.500" />
		</svg>
	)
}
