---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<img class="notfound-photo" src="/images/desk-pen.webp" alt="" width="409" height="1029" />
		<div class="notfound-copy">
			<p class="eyebrow">Error 404</p>
			<h1 id="nf-title" class="notfound-title">That page is not on my resume.</h1>
			<p class="notfound-text">The page you are looking for has moved or never existed. These pages are a good place to start again.</p>
			<div class="actions">
				<a class="btn btn-pill" href="/"><span>Back to home</span><Arrow /></a>
				<a class="pill" href="/about">About</a>
				<a class="pill" href="/projects">Projects</a>
			</div>
		</div>
	</section>
</Base>
