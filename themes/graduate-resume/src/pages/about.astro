---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ContactBand from "../components/ContactBand.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getCredentials, getProfile, getProjects, getRoles, getSkills, lines, telHref, kindLabel } from "../lib/site";

const [{ entry: page, cacheHint }, profileResult, settings, rolesResult, projectsResult, skillsResult, credentialsResult] = await Promise.all([
	getEmDashEntry("pages", "about"),
	getProfile(),
	getSiteSettings(),
	getRoles(),
	getProjects(),
	getSkills(),
	getCredentials(),
]);
if (Astro.cache?.enabled) {
	if (cacheHint) Astro.cache.set(cacheHint);
	Astro.cache.set(profileResult.cacheHint);
}
const { profile } = profileResult;
const roles = rolesResult.entries;
const projects = projectsResult.entries;
const skills = skillsResult.entries;
const credentials = credentialsResult.entries;
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = page ? getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: "/about" }) : null;
const hasBody = Boolean(page?.data.content && page.data.content.length > 0);
---

<Base
	title={seo?.title ?? "About"}
	pageTitle={seo?.ogTitle}
	description={seo?.description ?? page?.data.intro ?? "About Maya Linden, a fictional recent graduate in human-computer interaction, with a print-friendly resume."}
	canonical={seo?.canonical}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	<header class="about-head no-print">
		<div class="wrap about-head-grid">
			<div class="about-head-copy">
				<p class="eyebrow">{page?.data.eyebrow ?? "About"}</p>
				<h1 id="about-title" class="display display-xl" {...(page ? page.edit.title : {})}>{page?.data.title ?? "Hello, I'm Maya."}</h1>
				{page?.data.intro && <p class="lede">{page.data.intro}</p>}
				<p class="about-links">
					<a class="btn btn-pill btn-sm" href="/contact"><span>Let's Talk</span><Arrow /></a>
					<a class="text-link" href="#resume"><span>Jump to my resume</span><Arrow /></a>
				</p>
			</div>
			<figure class="about-photo">
				<img
					src="/images/hero-graduate.webp"
					alt="Maya Linden, a smiling young woman with long dark hair in a dark sweater, holding a laptop"
					width="716"
					height="634"
					fetchpriority="high"
				/>
				<figcaption>Maya Linden is a fictional person. This is an AI-generated portrait made for the theme.</figcaption>
			</figure>
		</div>
	</header>

	<section class="about-story no-print">
		<div class="wrap">
			<div class="prose">
				{hasBody ? <PortableText value={page!.data.content} /> : <p>My story is coming soon.</p>}
			</div>
		</div>
	</section>

	<section class="resume-section" id="resume" aria-labelledby="resume-title">
		<div class="wrap">
			<div class="resume-tools no-print">
				<div>
					<p class="eyebrow">Resume</p>
					<h2 id="resume-title" class="display">One page, ready to print.</h2>
				</div>
				<button class="btn btn-pill btn-sm" type="button" data-print hidden><span>Print or save as PDF</span></button>
				<noscript><span>Use your browser's Print command to save this page as a PDF.</span></noscript>
			</div>
			<article class="resume">
				<header class="resume-head">
					<h2 class="resume-name">{profile.title}</h2>
					<p class="resume-headline">{profile.headline}</p>
					<p class="resume-contact">
						{profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
						{profile.phone && <a href={telHref(profile.phone)}>{profile.phone}</a>}
						{profile.location && <span>{profile.location}</span>}
						{profile.profile_url && <a href={profile.profile_url}>{profile.profile_url.replace(/^https?:\/\//, "")}</a>}
					</p>
					{profile.summary && <p class="resume-summary">{profile.summary}</p>}
				</header>
				<section class="resume-block">
					<h3>Education</h3>
					{credentials.map((c) => (
						<p class="resume-line"><strong>{c.data.title}</strong>, {[c.data.org, c.data.years].filter(Boolean).join(", ")}{c.data.note ? `. ${c.data.note}` : ""}</p>
					))}
				</section>
				<section class="resume-block">
					<h3>Projects</h3>
					{projects.map((p) => (
						<p class="resume-line"><strong>{p.data.title}</strong> ({[kindLabel(p.data.kind), p.data.year].filter(Boolean).join(", ")}). {p.data.summary} Role: {p.data.role}.</p>
					))}
				</section>
				<section class="resume-block">
					<h3>Experience</h3>
					{roles.map((r) => (
						<p class="resume-line"><strong>{r.data.title}</strong>, {r.data.company}, {r.data.period}. {r.data.summary}</p>
					))}
				</section>
				<section class="resume-block">
					<h3>Skills</h3>
					{skills.map((s) => (
						<p class="resume-line"><strong>{s.data.title}.</strong> {lines(s.data.items).join(", ")}.</p>
					))}
				</section>
			</article>
		</div>
	</section>

	<ContactBand profile={profile} />
</Base>

<script>
	const button = document.querySelector<HTMLButtonElement>("[data-print]");
	if (button) {
		button.hidden = false;
		button.addEventListener("click", () => window.print());
	}
</script>
