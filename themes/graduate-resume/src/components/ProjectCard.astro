---
import Arrow from "./Arrow.astro";
import { photoAlt, photoSrc, projectHref, kindLabel } from "../lib/site";

interface Props {
	project: { data: any; edit: any };
	eager?: boolean;
	showKind?: boolean;
}
const { project, eager = false, showKind = false } = Astro.props;
const d = project.data;
const src = photoSrc(d.image, d.photo);
---

<a class="project-card" href={projectHref(d)}>
	<span class="project-card-photo">
		{src && <img src={src} alt={photoAlt(d.image, d.photo, d.title)} width="615" height="300" loading={eager ? "eager" : "lazy"} />}
	</span>
	<span class="project-card-body">
		<span class="project-card-text">
			<span class="project-card-title" {...project.edit?.title}>{d.title}</span>
			<span class="project-card-summary">{d.summary}</span>
			{showKind && <span class="project-card-meta">{[kindLabel(d.kind), d.year].filter(Boolean).join(" · ")}</span>}
		</span>
		<Arrow class="project-card-arrow" />
	</span>
</a>
