---
import type { MediaReference } from "../utils/site-identity";

interface Props {
	title: string;
	tagline?: string;
	logo?: MediaReference | null;
	class?: string;
}
const { title, tagline, logo, class: className } = Astro.props;
---

<a class:list={["wordmark", className]} href="/" aria-label={`${title} ${tagline ?? ""}, home`.replace(/\s+/g, " ")}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt ?? title} width="200" height="64" />
		) : (
			<>
				<svg class="wordmark-mark" viewBox="0 0 112 40" width="110" height="38" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
					<path d="M1.5 38.5 28 13.5l8 7.5L55.5 3l24 27 6-5.5 4 4" />
					<path d="M44 13.5l4.5 4.5 4-4.5 5.5 6.5M18 24.5l5-3.5 4 4" />
					<path d="M97 38.5V32M97 11l-5.5 8h3.5L90 26h4l-5 7h18l-5-7h4l-5-7h3.5z" />
				</svg>
				<span class="wordmark-title">{title}</span>
				{tagline && <span class="wordmark-tagline">{tagline}</span>}
			</>
		)
	}
</a>
