---
import { formatPrice, photoSrc, sleepsLabel, typeLabel } from "../lib/lodge";
import type { StayEntry } from "../lib/lodge";

interface Props {
	stay: StayEntry;
}
const { stay } = Astro.props;
const d = stay.data;
const src = photoSrc(d.image, d.photo);
---

<a class="stay-card" href={`/stay/${d.slug ?? d.id}`}>
	<span class="stay-photo">
		{src && <img src={src} alt={d.image?.alt ?? d.photo_alt ?? ""} width="640" height="480" loading="lazy" />}
	</span>
	<span class="stay-body">
		<span class="stay-type">{typeLabel(d.type)}{d.fireplace ? ", wood fire" : ""}</span>
		<span class="stay-name" {...stay.edit.title}>{d.title}</span>
		<span class="stay-meta">{sleepsLabel(d.sleeps)} · {d.beds} · {d.size_m2} m²</span>
		{d.price_from ? <span class="stay-price">From <strong>{formatPrice(d.price_from)}</strong> per night</span> : null}
	</span>
</a>
