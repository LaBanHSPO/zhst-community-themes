	"heart-line": '<path d="M18 30.5S5 23 5 13.6C5 9.2 8.3 6 12.3 6c2.4 0 4.5 1.2 5.7 3.1C19.2 7.2 21.3 6 23.7 6 27.7 6 31 9.2 31 13.6 31 23 18 30.5 18 30.5z"/>',
