	cat: '<path d="M7 27.5V6.5l6.5 5.5h9L29 6.5v21c0 1.7-1.3 3-3 3H10c-1.7 0-3-1.3-3-3z"/><path d="M15.8 21.5l2.2 1.7 2.2-1.7M3.5 21h6M3.5 25h6M26.5 21h6M26.5 25h6"/><path d="M13.3 17h.5M22.2 17h.5" stroke-width="2.8"/>',
	"dog-side":
		'<path d="M5.5 26.5v-7c0-2.2 1.8-4 4-4h10l4-6.5h3.2l1.8 2.5h3.5l-.8 3.2-4.2 1.3v10.5M9 26.5V20M22.5 26.5v-6.5"/><path d="M5.5 19.5c-1.7-.4-2.5-2-2-3.8"/>',
	chevron: '<path d="M10 14l8 8 8-8"/>',
	phone: '<path d="M9.5 4.5l5 7-3.2 3.3c1.6 3.7 5.2 7.3 9 9l3.2-3.3 7 5-3.3 5c-11.5 0-22.3-10.8-22.3-22.3z"/>',
	mail: '<rect x="4.5" y="8" width="27" height="20" rx="3"/><path d="M5.5 9.5L18 19l12.5-9.5"/>',
	pin: '<path d="M18 31.5s-10-9.3-10-17a10 10 0 0 1 20 0c0 7.7-10 17-10 17z"/><circle cx="18" cy="14.5" r="3.5"/>',
};
const body = paths[name] ?? "";
---

<svg
	class:list={["icon", className]}
	viewBox="0 0 36 36"
	fill="none"
	stroke="currentColor"
	stroke-width="2.4"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
	focusable="false"
	set:html={body}
/>
