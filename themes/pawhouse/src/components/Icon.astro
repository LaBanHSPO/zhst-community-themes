---
/** Icons drawn inline (no icon font). Decorative unless a label is passed. */
interface Props {
	name: string;
	class?: string;
	label?: string;
}
const { name, class: className, label } = Astro.props;
const solid = 'fill="currentColor" stroke="none"';
const paths: Record<string, string> = {
	paw: `<g ${solid}><ellipse cx="18" cy="24.5" rx="7.6" ry="6.4"/><ellipse cx="8.2" cy="15.6" rx="3.3" ry="4.2" transform="rotate(-18 8.2 15.6)"/><ellipse cx="14" cy="8.8" rx="3.3" ry="4.4" transform="rotate(-6 14 8.8)"/><ellipse cx="22" cy="8.8" rx="3.3" ry="4.4" transform="rotate(6 22 8.8)"/><ellipse cx="27.8" cy="15.6" rx="3.3" ry="4.2" transform="rotate(18 27.8 15.6)"/></g>`,
	scissors:
		'<circle cx="9" cy="27" r="4.6"/><circle cx="20.5" cy="29.5" r="4.6"/><path d="M12.4 23.8L28.5 5.5M18.3 25.4L11 4.5"/>',
	house: '<path d="M4.5 17.5L18 5.5l13.5 12"/><path d="M8.5 14.5V31h19V14.5"/><path d="M14.5 31v-8.5h7V31"/>',
	calendar:
