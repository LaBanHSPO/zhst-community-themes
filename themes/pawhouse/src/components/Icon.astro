	sun: '<circle cx="18" cy="18" r="6.5"/><path d="M18 3.5v4M18 28.5v4M3.5 18h4M28.5 18h4M7.7 7.7l2.8 2.8M25.5 25.5l2.8 2.8M7.7 28.3l2.8-2.8M25.5 10.5l2.8-2.8"/>',
	bowl: '<path d="M4.5 15.5h27l-3 11.5a3 3 0 0 1-2.9 2.2H10.4A3 3 0 0 1 7.5 27z"/><ellipse cx="18" cy="15.5" rx="13.5" ry="4.5"/>',
