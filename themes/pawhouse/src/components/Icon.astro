	ball: '<circle cx="18" cy="18" r="13"/><path d="M8.8 8.8c4.6 4.6 4.6 13.8 0 18.4M27.2 8.8c-4.6 4.6-4.6 13.8 0 18.4M5 18h26"/>',
	clock: '<circle cx="18" cy="18" r="13"/><path d="M18 10v8l5 3"/>',
	check: '<path d="M10.5 18.5l5 5 10-10.5"/>',
	doc: '<path d="M8.5 4.5h13l6 6v21h-19z"/><path d="M21.5 4.5v6h6M13 17h10M13 22h10M13 27h6"/>',
