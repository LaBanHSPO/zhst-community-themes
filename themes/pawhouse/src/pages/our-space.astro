---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Heart from "../components/Heart.astro";
import Icon from "../components/Icon.astro";
import PreviewCard from "../components/PreviewCard.astro";
import Sparks from "../components/Sparks.astro";
import { bookingUrl, getFaqs, getPreviews, getTeam, photoSrc } from "../lib/pawhouse";

const [cards, team, faqs] = await Promise.all([getPreviews("space"), getTeam(), getFaqs()]);
if (Astro.cache?.enabled) {
	for (const hint of [cards.cacheHint, team.cacheHint, faqs.cacheHint]) Astro.cache.set(hint);
}
---

<Base title="Our space" description="Bright, calm and pet-friendly spaces designed for comfort, play and peace of mind. Meet our team and read our care requirements.">
	<section class="hero hero-space" aria-labelledby="space-title">
		<div class="hero-media">
			<img src="/images/hero-space.webp" alt="A golden retriever and a small terrier trotting across the bright indoor play space, with a poodle on a climbing ramp" width="1032" height="394" fetchpriority="high" />
		</div>
		<div class="hero-inner wrap">
			<div class="hero-copy">
				<Sparks class="hero-sparks" />
				<h1 id="space-title" class="display">A home away<br /> from home.<Heart /></h1>
				<p class="hero-lede">Bright, calm and pet-friendly spaces designed for comfort, play and peace of mind. Come see where happy pets spend their days.</p>
				<a class="btn btn-lg" href={bookingUrl()}>Request booking <Icon name="calendar" /> <Arrow /></a>
			</div>
		</div>
	</section>

	{
		cards.entries.length > 0 && (
			<section id="spaces" class="wrap-wide space-cards" aria-label="Our spaces">
				{cards.entries.map((c) => <PreviewCard card={c.data} size="md" />)}
			</section>
		)
	}

	<div class="wrap-wide team-row">
		<section class="team-intro" aria-labelledby="team-title">
			<Sparks class="team-sparks" />
			<h2 id="team-title" class="section-title section-title-lg">Meet our <span class="nowrap">team<Heart /></span></h2>
			<p>Pet lovers, caring hands and friendly faces. We’re here to make every pet feel at home.</p>
			<a class="pill pill-yellow" href="#spaces">Our space <Arrow /></a>
		</section>
		{
			team.entries.length > 0 && (
				<ul class="team-photos" aria-label="Our team">
					{team.entries.map((t) => (
						<li>
							<figure>
								<img src={photoSrc(t.data.image, t.data.photo)} alt={t.data.image?.alt || t.data.alt || t.data.title} width="248" height="208" loading="lazy" />
								<figcaption>
									<strong>{t.data.title}</strong>
									{t.data.note && <span>{t.data.note}</span>}
								</figcaption>
							</figure>
						</li>
					))}
				</ul>
			)
		}
		<section class="care-card" aria-labelledby="care-title">
			<h2 id="care-title"><span>Care requirements</span><Icon name="doc" /></h2>
			<p>A few helpful things to know before your visit, so we can keep everyone happy and safe.</p>
			{
				faqs.entries.map((q) => (
					<details class="faq">
						<summary>
							{q.data.title}
							<Icon name="chevron" />
						</summary>
						<p>{q.data.answer}</p>
					</details>
				))
			}
		</section>
	</div>
</Base>
