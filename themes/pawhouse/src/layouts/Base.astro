---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getBusiness, telHref } from "../lib/pawhouse";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Force which primary-menu URL is marked current. */
	current?: string;
}

const { title, pageTitle, description, image, canonical, content, current } = Astro.props;
const [settingsResult, menuResult, businessResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getBusiness(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(businessResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const navItems = menuResult.data?.items ?? [];
const { business } = businessResult;

// The booking request item becomes the coral header button; the other menu items are the text nav.
const isBooking = (url: string) => /^\/booking\/?(\?|#|$)/.test(url);
const ctaItem = navItems.find((i) => isBooking(i.url));
const textItems = navItems.filter((i) => i !== ctaItem);
const ctaUrl = ctaItem?.url ?? "/booking";
const ctaLabel = ctaItem?.label ?? "Request booking";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const norm = (url: string) => url.replace(/\/$/, "") || "/";
const currentUrl =
	current ??
	navItems.find((i) => norm(i.url) === path)?.url ??
	navItems
		.filter((i) => norm(i.url) !== "/" && path.startsWith(`${norm(i.url)}/`))
		.sort((a, b) => b.url.length - a.url.length)[0]?.url;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Intl.DateTimeFormat("en-GB", { year: "numeric", timeZone: "Asia/Saigon" }).format(new Date());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fredoka:wght@500;600;700&family=Patrick+Hand&display=swap"
			rel="stylesheet"
		/>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-head">
			<div class="head-inner wrap-head">
				<a class="wordmark" href="/" aria-label={`${siteTitle} — homepage`}>
					{
						siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						) : (
							<>
								<span class="wordmark-name">
									{siteTitle}
									<Icon name="paw" class="wordmark-paw" />
								</span>
								<span class="wordmark-tag">{siteTagline}</span>
							</>
						)
					}
				</a>
				<nav class="nav" aria-label="Primary">
					{
						textItems.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={item.url === currentUrl ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<a class="btn btn-sm head-cta" href={ctaUrl} aria-current={ctaUrl === currentUrl ? "page" : undefined}>
					<Icon name="calendar" />
					{ctaLabel}
					<Arrow />
				</a>
				<details class="mobile-nav">
					<summary>
						<svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true" focusable="false">
							<path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
						</svg>
						<span>Menu</span>
					</summary>
					<nav class="mobile-panel" aria-label="Primary (mobile)">
						{
							navItems.map((item) => (
								<a href={item.url} aria-current={item.url === currentUrl ? "page" : undefined}>
									{item.label}
								</a>
							))
						}
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="wrap-head foot-inner">
				<div class="foot-brand">
					<a class="wordmark wordmark-light" href="/">
						<span class="wordmark-name">
							{siteTitle}
							<Icon name="paw" class="wordmark-paw" />
						</span>
						<span class="wordmark-tag">{siteTagline}</span>
					</a>
					<p>Gentle grooming and comfortable pet hotel stays for dogs and cats. Every booking is a request we confirm with you.</p>
				</div>
				<div class="foot-col">
					<h2>Visit &amp; contact</h2>
					{business.address && <p><Icon name="pin" />{business.address}</p>}
					{business.hours && <p><Icon name="clock" />{business.hours}</p>}
					{business.phone && <a href={telHref(business.phone)}><Icon name="phone" />{business.phone}</a>}
					{business.email && <a href={`mailto:${business.email}`}><Icon name="mail" />{business.email}</a>}
				</div>
				<div class="foot-col">
					<h2>Explore</h2>
					{navItems.map((item) => <a href={item.url}>{item.label}</a>)}
				</div>
			</div>
			<div class="wrap-head foot-bottom">
				<span>© {year} {siteTitle}. All rights reserved.</span>
				<span>Built with EmDash</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
