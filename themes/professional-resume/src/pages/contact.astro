---
import Base from "../layouts/Base.astro";
import { REASONS, getProfile, telHref } from "../lib/site";

const { profile, cacheHint } = await getProfile();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// ?reason=role|project|other pre-selects the reason.
const wanted = Astro.url.searchParams.get("reason");
const selected = REASONS.find((r) => r.value === wanted);
---

<Base title="Contact" description="Write to Theo Alder, a fictional product design lead: choose a reason (a role, a project or something else), add a few sentences and your email app opens with the message ready. Email and phone are always listed.">
	<div class="contact">
		<section class="contact-panel" aria-labelledby="contact-title">
			<p class="eyebrow">Contact</p>
			<h1 id="contact-title" class="display display-xl">Tell me what you are working on.</h1>
			<p class="lede">A few sentences are enough. I reply within two working days.</p>

			<div class="notice" role="note">
				<strong>Email only.</strong>{" "}
				{profile.contact_note ?? "Tell me a little about the role or the project. A few sentences are enough."}
			</div>

			<form
				class="contact-form"
				data-contact-form
				data-email={profile.email}
				action={profile.email ? `mailto:${profile.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field">
						<label for="c-name">Your name</label>
						<input id="c-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="c-name"></span>
					</div>
					<div class="field">
						<label for="c-email">Email</label>
						<input id="c-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="c-email"></span>
					</div>
					<div class="field">
						<label for="c-org">Company or team <span class="optional">(optional)</span></label>
						<input id="c-org" name="org" type="text" autocomplete="organization" />
					</div>
					<div class="field">
						<label for="c-when">Timing <span class="optional">(optional)</span></label>
						<input id="c-when" name="when" type="text" placeholder="Start date, or a rough month" />
					</div>
					<div class="field full">
						<label for="c-reason">What is this about?</label>
						<select id="c-reason" name="reason" required>
							<option value="" selected={!selected}>Choose an option</option>
							{REASONS.map((r) => <option value={r.value} selected={selected?.value === r.value}>{r.label}</option>)}
						</select>
						<span class="field-error" data-error-for="c-reason"></span>
					</div>
					<div class="field full">
						<label for="c-message">Message</label>
						<textarea id="c-message" name="message" rows="6" maxlength="1200" placeholder="For example: the team, what you are building and what you would like to talk about." required></textarea>
						<span class="field-error" data-error-for="c-message"></span>
					</div>
				</div>
				<button class="btn btn-green btn-block" type="submit"><span>Send message</span></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{profile.email && <>Write to <a href={`mailto:${profile.email}`}>{profile.email}</a> with a few sentences about the role or project.</>}
					</noscript>
				</p>
			</form>
		</section>

		<aside class="contact-aside">
			<img src="/images/portrait-close.webp" alt="Close portrait of Theo Alder, a man with curly dark hair and glasses" width="440" height="520" />
			<div class="contact-details">
				<h2>Prefer to write directly?</h2>
				<p class="detail-line">
					{profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
					{profile.phone && <a href={telHref(profile.phone)}>{profile.phone}</a>}
					{profile.location && <span>{profile.location}</span>}
				</p>
				{profile.availability && <p class="small">{profile.availability}</p>}
				<ul class="profile-links">
					{profile.profile_url && <li><a href={profile.profile_url} rel="noopener noreferrer">Professional profile</a></li>}
					{profile.notes_url && <li><a href={profile.notes_url} rel="noopener noreferrer">Writing and notes</a></li>}
					<li><a href="/resume">Printable resume</a></li>
				</ul>
				<p class="small">The profile links are placeholders on the <code>.example</code> domain. Replace them in the admin.</p>
			</div>
		</aside>
	</div>
</Base>

<script>
	// Compose an email to Theo; nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Email is not available right now. Please call instead.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const select = form.querySelector<HTMLSelectElement>("#c-reason");
			const reasonLabel = select?.selectedOptions[0]?.textContent ?? "";
			const subject = `${reasonLabel} (from ${get("name")})`;
			const body = [
				"Hello Theo,",
				"",
				`Topic: ${reasonLabel}`,
				get("when") ? `Timing: ${get("when")}` : "",
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("org") ? `Company or team: ${get("org")}` : "",
				"",
				get("message"),
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body.join("\n"))}`;
			status.textContent =
				"Your email app should open with this message ready to send. It is only sent when you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
