---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ContactBand from "../components/ContactBand.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getProfile } from "../lib/site";

const [{ entry: page, cacheHint }, profileResult, settings] = await Promise.all([
	getEmDashEntry("pages", "about"),
	getProfile(),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	if (cacheHint) Astro.cache.set(cacheHint);
	Astro.cache.set(profileResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = page ? getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: "/about" }) : null;
const hasBody = Boolean(page?.data.content && page.data.content.length > 0);
---

<Base
	title={seo?.title ?? "About"}
	pageTitle={seo?.ogTitle}
	description={seo?.description ?? page?.data.intro ?? "About Theo Alder, a fictional product design lead."}
	canonical={seo?.canonical}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	<header class="about-head">
		<div class="wrap about-head-grid">
			<div class="about-head-copy">
				<p class="eyebrow">{page?.data.eyebrow ?? "About"}</p>
				<h1 id="about-title" class="display display-xl" {...(page ? page.edit.title : {})}>{page?.data.title ?? "Hello, I'm Theo."}</h1>
				{page?.data.intro && <p class="lede">{page.data.intro}</p>}
				<p class="about-links">
					<a class="btn btn-green" href="/experience"><span>View experience</span><Arrow /></a>
					<a class="text-link" href="/contact"><span>Get in touch</span><Arrow /></a>
				</p>
			</div>
			<figure class="about-photo">
				<img
					src="/images/portrait.webp"
					alt="Theo Alder, a man with curly dark hair and glasses, in a dark blazer, looking off to the side"
					width="570"
					height="660"
					fetchpriority="high"
				/>
				<figcaption>Theo Alder is a fictional person. This is an AI-generated portrait made for the theme.</figcaption>
			</figure>
		</div>
	</header>

	<section class="about-story">
		<div class="wrap">
			<div class="prose">
				{hasBody ? <PortableText value={page!.data.content} /> : <p>My story is coming soon.</p>}
			</div>
		</div>
	</section>

	<ContactBand profile={profileResult.profile} />
</Base>
