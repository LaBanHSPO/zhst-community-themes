---
import Arrow from "./Arrow.astro";
import { telHref } from "../lib/site";
import type { ProfileData } from "../lib/site";

interface Props {
	profile: ProfileData;
}
const { profile } = Astro.props;
---

<section class="band-contact" aria-labelledby="band-title">
	<div class="band-contact-inner">
		<div>
			<p class="eyebrow eyebrow-gold">Get in touch</p>
			<h2 id="band-title" class="display display-light">Talking about a role or a project?</h2>
			<p class="band-text">Send a few sentences about what you are working on. I reply within two working days.</p>
		</div>
		<div class="band-actions">
			<a class="btn btn-light" href="/contact"><span>Write to me</span><Arrow /></a>
			<p class="band-links">
				{profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
				{profile.phone && <a href={telHref(profile.phone)}>{profile.phone}</a>}
			</p>
		</div>
	</div>
</section>
