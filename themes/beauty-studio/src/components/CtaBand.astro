---
import Arrow from "./Arrow.astro";
import { hoursRows, mapHref, telHref } from "../lib/studio";
import type { StudioData } from "../lib/studio";

interface Props {
	studio: StudioData;
	hours?: { day: string; time: string }[];
}
const { studio } = Astro.props;
const hours = Astro.props.hours ?? hoursRows(studio.hours);
---

<section class="cta-band" aria-labelledby="cta-title">
	<div class="wrap cta-grid">
		<div class="cta-copy">
			<p class="eyebrow eyebrow-light"><span class="eyebrow-rule" aria-hidden="true"></span>Visit us</p>
			<h2 id="cta-title" class="display">Ready for a <em>brighter day?</em></h2>
			<p>Send us a request and we will confirm a time by email or phone.</p>
			<a class="btn btn-light btn-lg" href="/book">Book a visit <Arrow /></a>
		</div>
		<div class="cta-info">
			{
				(studio.street || studio.locality) && (
					<div>
						<h3>Find us</h3>
						<address>
							<a href={mapHref(studio)} target="_blank" rel="noopener noreferrer">
								{studio.street && <>{studio.street}<br /></>}
								{studio.locality}
							</a>
						</address>
						{studio.phone && <a href={telHref(studio.phone)}>{studio.phone}</a>}
						{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}
					</div>
				)
			}
			{
				hours.length > 0 && (
					<div>
						<h3>Opening hours</h3>
						<dl>
							{hours.map((h) => (
								<>
									<dt>{h.day}</dt>
									<dd>{h.time}</dd>
								</>
							))}
						</dl>
					</div>
				)
			}
		</div>
	</div>
</section>
