---
import { getEmDashCollection, getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/figtree";
import Logo from "../components/Logo.astro";
import Arrow from "../components/Arrow.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getStudio, hoursRows, mapHref, telHref } from "../lib/studio";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Header sits transparently over the page's first (photographic) section. */
	overlay?: boolean;
	/** Force which primary-menu URL is marked current. */
	current?: string;
}

const { title, pageTitle, description, image, canonical, content, overlay = false, current } = Astro.props;
const [settingsResult, menuResult, studioResult, pagesResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getStudio(),
	getEmDashCollection("pages", { limit: 20 }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
	Astro.cache.set(pagesResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} | ${siteTitle}`;
const pageDescription = description ?? `${siteTitle} ${siteTagline}`;
const navItems = menuResult.data?.items ?? [];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const norm = (url: string) => url.replace(/\/$/, "") || "/";
const { studio } = studioResult;
const hours = hoursRows(studio.hours);
// CMS pages that are not in the primary menu are linked from the footer.
const menuUrls = new Set(navItems.map((i) => norm(i.url)));
const extraPages = pagesResult.entries
	.map((p) => ({ url: `/${p.data.slug ?? p.data.id}`, label: p.data.eyebrow || p.data.title }))
	.filter((p) => !menuUrls.has(p.url));

const currentUrl =
	current ??
	navItems.find((i) => norm(i.url) === path)?.url ??
	navItems.find((i) => norm(i.url) !== "/" && path.startsWith(`${norm(i.url)}/`))?.url;
const onBook = path === "/book";

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Intl.DateTimeFormat("en-GB", { year: "numeric", timeZone: "Asia/Saigon" }).format(new Date());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class:list={["site-head", { "is-overlay": overlay }]}>
			<div class="head-inner">
				<Logo title={siteTitle} tagline={siteTagline} logo={siteLogo} class="head-logo" />
				<nav class="nav" aria-label="Primary">
					{
						navItems.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={item.url === currentUrl ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<a class="btn head-cta" href="/book" aria-current={onBook ? "page" : undefined}>Book a visit</a>
				<details class="mobile-nav">
					<summary aria-label="Menu">
						<svg class="burger" width="22" height="14" viewBox="0 0 22 14" aria-hidden="true" focusable="false">
							<path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.5" />
						</svg>
						<svg class="close" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
							<path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.5" />
						</svg>
					</summary>
					<nav class="mobile-panel" aria-label="Primary (mobile)">
						{
							navItems.map((item) => (
								<a href={item.url} aria-current={item.url === currentUrl ? "page" : undefined}>
									{item.label}
								</a>
							))
						}
						<a class="btn" href="/book">Book a visit <Arrow /></a>
						{studio.phone && <a class="mobile-phone" href={telHref(studio.phone)}>Call {studio.phone}</a>}
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="foot-inner">
				<div class="foot-brand">
					<Logo title={siteTitle} tagline={siteTagline} logo={siteLogo} />
					<p>Hair, skin and nails in a calm, light-filled studio. Everyday beauty, done with care.</p>
				</div>
				<div>
					<h2>Explore</h2>
					<ul class="foot-links">
						{navItems.map((item) => <li><a href={item.url}>{item.label}</a></li>)}
						<li><a href="/book">Book a visit</a></li>
						{extraPages.map((p) => <li><a href={p.url}>{p.label}</a></li>)}
					</ul>
				</div>
				<div class="foot-visit">
					<h2>Visit</h2>
					{
						(studio.street || studio.locality) && (
							<address>
								<a href={mapHref(studio)} target="_blank" rel="noopener noreferrer">
									{studio.street && <>{studio.street}<br /></>}
									{studio.locality}
								</a>
							</address>
						)
					}
					{studio.phone && <a href={telHref(studio.phone)}>{studio.phone}</a>}
					{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}
				</div>
				<div>
					<h2>Hours</h2>
					<dl class="foot-hours">
						{hours.map((h) => <><dt>{h.day}</dt><dd>{h.time}</dd></>)}
					</dl>
				</div>
			</div>
			<div class="foot-bottom">
				<span>© {year} {studio.title || siteTitle}</span>
				<span>Built with EmDash</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
