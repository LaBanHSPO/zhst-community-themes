---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Arrow from "../components/Arrow.astro";
import { getGallery, photoSrc } from "../lib/studio";

const { entries, cacheHint } = await getGallery();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const photos = entries
	.map((p) => ({ entry: p, src: photoSrc(p.data.image, p.data.photo) }))
	.filter((p): p is typeof p & { src: string } => Boolean(p.src));
---

<Base title="Gallery" description="Inside LUMIÈRE: the studio, the light and some of our work.">
	<PageHead
		id="gallery-title"
		eyebrow="Gallery"
		title="Light, calm and a little gold."
		intro="A look around the studio and some of the treatments we love to do."
	/>

	<section class="gallery" aria-labelledby="gallery-title">
		{
			photos.length === 0 ? (
				<p class="empty-note">Photos are on their way. In the meantime, come and see the studio for yourself.</p>
			) : (
				<ul class="gallery-grid">
					{photos.map(({ entry, src }) => (
						<li class:list={["gallery-item", { "is-wide": entry.data.wide }]}>
							<figure>
								<img
									src={src}
									alt={entry.data.image?.alt || entry.data.alt || entry.data.title}
									width="800"
									height="640"
									loading="lazy"
								/>
								<figcaption>
									<span class="gallery-caption" {...entry.edit.title}>{entry.data.title}</span>
									{entry.data.text && <span class="gallery-note">{entry.data.text}</span>}
								</figcaption>
							</figure>
						</li>
					))}
				</ul>
			)
		}
		<p class="gallery-cta">
			<a class="btn" href="/book">Book a visit <Arrow /></a>
		</p>
	</section>
</Base>
