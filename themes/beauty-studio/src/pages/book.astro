---
import Base from "../layouts/Base.astro";
import { formatPrice, getStudio, getTreatments, groupByCategory, hoursRows, mapHref, telHref } from "../lib/studio";

const [{ studio, cacheHint }, treatmentsResult] = await Promise.all([getStudio(), getTreatments()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(treatmentsResult.cacheHint);
}
const groups = groupByCategory(treatmentsResult.entries);
const hours = hoursRows(studio.hours);

// ?treatment=<slug> pre-selects a treatment (links from the treatment pages).
const wanted = Astro.url.searchParams.get("treatment");
const selected = treatmentsResult.entries.find((t) => (t.data.slug ?? t.data.id) === wanted);

// Earliest selectable date is today in the site's timezone.
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Saigon" }).format(new Date());

const times: string[] = [];
for (let h = 9; h <= 18; h++) {
	for (const m of [0, 30]) {
		if (h === 18 && m === 30) continue;
		const hour12 = h > 12 ? h - 12 : h;
		times.push(`${hour12}:${m === 0 ? "00" : "30"} ${h >= 12 ? "pm" : "am"}`);
	}
}
---

<Base title="Book a visit" description="Request a visit at LUMIÈRE Beauty Studio. We confirm every request by email or phone.">
	<div class="book">
		<div class="book-photo">
			<img src="/images/salon-chair-light.webp" alt="A cream salon chair with a rose towel in soft morning light" width="1448" height="1086" />
		</div>
		<section class="book-panel" aria-labelledby="book-title">
			<p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span>Book a visit</p>
			<h1 id="book-title" class="display">Let us <em>save you a seat.</em></h1>
			<p class="lede">
				Tell us what you would like and when, and we will confirm by email or phone. A request is not a booking until we reply.
			</p>

			<form
				class="book-form"
				data-book-form
				data-email={studio.email}
				action={studio.email ? `mailto:${studio.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field full">
						<label for="b-treatment">Treatment</label>
						<select id="b-treatment" name="treatment" required>
							<option value="" selected={!selected}>Choose a treatment</option>
							{
								groups.map(({ category, items }) => (
									<optgroup label={category.label}>
										{items.map((t) => {
											const label = [t.data.title, t.data.duration, formatPrice(t.data.price)].filter(Boolean).join(" · ");
											return <option value={t.data.title} selected={selected?.data.id === t.data.id}>{label}</option>;
										})}
									</optgroup>
								))
							}
							<option value="Not sure yet">Not sure yet, please advise</option>
						</select>
						<span class="field-error" id="b-treatment-err" data-error-for="b-treatment"></span>
					</div>
					<div class="field">
						<label for="b-date">Preferred date</label>
						<input id="b-date" name="date" type="date" min={today} required />
						<span class="field-error" id="b-date-err" data-error-for="b-date"></span>
					</div>
					<div class="field">
						<label for="b-time">Preferred time</label>
						<select id="b-time" name="time" required>
							{times.map((t) => <option selected={t === "11:00 am"}>{t}</option>)}
						</select>
					</div>
					<div class="field">
						<label for="b-name">Name</label>
						<input id="b-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" id="b-name-err" data-error-for="b-name"></span>
					</div>
					<div class="field">
						<label for="b-email">Email</label>
						<input id="b-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" id="b-email-err" data-error-for="b-email"></span>
					</div>
					<div class="field full">
						<label for="b-phone">Phone <span class="optional">(optional)</span></label>
						<input id="b-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field full">
						<label for="b-notes">Anything we should know? <span class="optional">(optional)</span></label>
						<textarea id="b-notes" name="notes" rows="3" placeholder="Allergies, sensitivities, an event you are preparing for…"></textarea>
					</div>
				</div>
				<button class="btn btn-lg btn-block" type="submit">Request a visit</button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{studio.email && <>Write to <a href={`mailto:${studio.email}`}>{studio.email}</a> with your treatment, date and time.</>}
					</noscript>
				</p>
			</form>

			<div class="book-contact">
				<h2>Prefer to talk to us?</h2>
				<p>
					{studio.phone && <>Call <a href={telHref(studio.phone)}>{studio.phone}</a></>}
					{studio.phone && studio.email && " or email "}
					{!studio.phone && studio.email && "Email "}
					{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}.
				</p>
				{
					(studio.street || studio.locality) && (
						<p>
							<a href={mapHref(studio)} target="_blank" rel="noopener noreferrer">
								{[studio.street, studio.locality].filter(Boolean).join(", ")}
							</a>
						</p>
					)
				}
				{
					hours.length > 0 && (
						<dl class="book-hours">
							{hours.map((h) => (
								<>
									<dt>{h.day}</dt>
									<dd>{h.time}</dd>
								</>
							))}
						</dl>
					)
				}
				{studio.booking_note && <p class="small">{studio.booking_note}</p>}
			</div>
		</section>
	</div>
</Base>

<script>
	// Compose a booking-request email; the studio confirms it by reply. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-book-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input[required], select[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: input.getAttribute("type") === "date"
								? "Please choose today or a later date."
								: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online requests are not available right now. Please call the studio.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Booking request: ${get("treatment")} on ${get("date")} at ${get("time")}`;
			const lines = [
				"Hello,",
				"",
				"I would like to request a visit:",
				`Treatment: ${get("treatment")}`,
				`Date: ${get("date")}`,
				`Time: ${get("time")}`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("notes") ? `Notes: ${get("notes")}` : "",
				"",
				"I understand the visit is confirmed only once you reply.",
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this request ready to send. It is only sent when you send that email, and we confirm by reply. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
