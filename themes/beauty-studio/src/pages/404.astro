---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<div class="wrap notfound-inner">
			<p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span>Error 404</p>
			<h1 id="nf-title" class="display">This page has <em>slipped away.</em></h1>
			<p class="lede">The page you are looking for has moved or never existed. These are good places to start again.</p>
			<div class="actions">
				<a class="btn" href="/">Back to home <Arrow /></a>
				<a class="btn btn-outline" href="/services">Our services</a>
				<a class="btn btn-outline" href="/book">Book a visit</a>
			</div>
		</div>
		<img class="notfound-photo" src="/images/peonies-marble.webp" alt="" width="578" height="530" />
	</section>
</Base>
