---
import Base from "../layouts/Base.astro";
import { getClinic, getServices, hoursRows, lines, telHref } from "../lib/clinic";

const [{ clinic, cacheHint }, servicesResult] = await Promise.all([getClinic(), getServices()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(servicesResult.cacheHint);
}

const options = [
	...servicesResult.entries.map((s) => ({ value: s.data.slug ?? s.data.id, label: s.data.title })),
	{ value: "not-sure", label: "Not sure yet" },
];
// ?service=<slug> pre-selects a service (links from the service pages).
const wanted = Astro.url.searchParams.get("service");
const selected = options.find((o) => o.value === wanted);
const rows = hoursRows(clinic.hours);
const address = lines(clinic.address);
---

<Base title="Book a visit" description="Request an appointment at MoveWell Physiotherapy Clinic: choose a service, say whether you are new or returning, and pick the day and time that suit you. Phone, email, address and hours are always listed.">
	<div class="contact">
		<section class="contact-panel" aria-labelledby="contact-title">
			<p class="eyebrow">Book a visit</p>
			<h1 id="contact-title" class="display display-xl">Request an appointment.</h1>
			<p class="lede">Pick a service and the days that suit you. The front desk replies within one working day with a time.</p>

			<div class="notice" role="note">
				<strong>Requests only.</strong>{" "}
				{clinic.form_note ?? "This form is for appointment requests only. Please leave out medical details, scan results and anything urgent."}
				{" "}<strong class="notice-strong">For anything urgent, call your local emergency number.</strong>
			</div>

			<form
				class="contact-form"
				data-contact-form
				data-email={clinic.email}
				action={clinic.email ? `mailto:${clinic.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field">
						<label for="c-name">Your name</label>
						<input id="c-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="c-name"></span>
					</div>
					<div class="field">
						<label for="c-email">Email</label>
						<input id="c-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="c-email"></span>
					</div>
					<div class="field">
						<label for="c-phone">Phone <span class="optional">(optional)</span></label>
						<input id="c-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<fieldset class="field choice">
						<legend>Have you visited us before?</legend>
						<label class="radio"><input type="radio" name="patient" value="New patient" required /><span>First visit</span></label>
						<label class="radio"><input type="radio" name="patient" value="Returning patient" /><span>Returning</span></label>
						<span class="field-error" data-error-for="patient-group"></span>
					</fieldset>
					<div class="field full">
						<label for="c-service">Which service?</label>
						<select id="c-service" name="service" required>
							<option value="" selected={!selected}>Choose an option</option>
							{options.map((o) => <option value={o.value} selected={selected?.value === o.value}>{o.label}</option>)}
						</select>
						<span class="field-error" data-error-for="c-service"></span>
					</div>
					<div class="field">
						<label for="c-day">Preferred day <span class="optional">(optional)</span></label>
						<select id="c-day" name="day">
							<option value="">No preference</option>
							<option>Monday</option>
							<option>Tuesday</option>
							<option>Wednesday</option>
							<option>Thursday</option>
							<option>Friday</option>
							<option>Saturday (morning only)</option>
						</select>
					</div>
					<div class="field">
						<label for="c-time">Preferred time <span class="optional">(optional)</span></label>
						<select id="c-time" name="time">
							<option value="">No preference</option>
							<option>Morning</option>
							<option>Afternoon</option>
							<option>Early evening (Tuesday and Thursday)</option>
						</select>
					</div>
					<div class="field full">
						<label for="c-message">Anything the front desk should know? <span class="optional">(optional)</span></label>
						<textarea id="c-message" name="message" rows="4" maxlength="400" placeholder="For example: you need a ground-floor room, or a later appointment. Please leave out medical details."></textarea>
					</div>
				</div>
				<button class="btn btn-block" type="submit"><span>Send appointment request</span></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{clinic.email && <>Write to <a href={`mailto:${clinic.email}`}>{clinic.email}</a> with your name, the kind of visit and the days that suit you.</>}
					</noscript>
				</p>
			</form>
		</section>

		<aside class="contact-aside">
			<img src="/images/mobility.webp" alt="A woman stretches one arm forward and one leg back on a mat while a physiotherapist supports her hip" width="800" height="690" />
			<div class="contact-details">
				<h2>Find the clinic</h2>
				<p class="detail-line">
					{clinic.phone && <a href={telHref(clinic.phone)}>{clinic.phone}</a>}
					{clinic.email && <a href={`mailto:${clinic.email}`}>{clinic.email}</a>}
					{address.length > 0 && <span>{address.join(", ")}</span>}
				</p>
				<h3>Opening hours</h3>
				<dl class="hours">
					{rows.map((r) => <div><dt>{r.day}</dt><dd>{r.time}</dd></div>)}
				</dl>
				{clinic.hours_note && <p class="small">{clinic.hours_note}</p>}
			</div>
		</aside>
	</div>
</Base>

<script>
	// Compose an email to the clinic; nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input[required]:not([type=radio]), select[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			const patientChosen = form.querySelector<HTMLInputElement>("input[name=patient]:checked");
			const patientSlot = form.querySelector<HTMLElement>('[data-error-for="patient-group"]');
			if (patientSlot) patientSlot.textContent = patientChosen ? "" : "Please choose one.";
			if (!patientChosen && !firstInvalid) firstInvalid = form.querySelector<HTMLElement>("input[name=patient]");
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online requests are not available right now. Please call the clinic instead.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const select = form.querySelector<HTMLSelectElement>("#c-service");
			const serviceLabel = select?.selectedOptions[0]?.textContent ?? "";
			const subject = `Appointment request: ${get("name")}`;
			const body = [
				"Hello,",
				"",
				"I would like to request an appointment.",
				"",
				`Visit: ${get("patient")}`,
				`Service: ${serviceLabel}`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("day") ? `Preferred day: ${get("day")}` : "",
				get("time") ? `Preferred time: ${get("time")}` : "",
				"",
				get("message"),
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body.join("\n"))}`;
			status.textContent =
				"Your email app should open with this request ready to send. It is only sent when you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
