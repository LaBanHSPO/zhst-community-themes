---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import VisitBand from "../../components/VisitBand.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getClinic, getServices, lines, photoAlt, photoSrc, serviceHref } from "../../lib/clinic";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: service, cacheHint } = await getEmDashEntry("services", slug);
if (!service) return Astro.rewrite("/404");

const [allResult, clinicResult, settings] = await Promise.all([getServices(), getClinic(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
	Astro.cache.set(clinicResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(service, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
const d = service.data;
const cover = photoSrc(d.image, d.photo);
const hasBody = Boolean(d.content && d.content.length > 0);
const others = allResult.entries.filter((s) => s.data.id !== d.id).slice(0, 3);
const bookHref = `/contact?service=${encodeURIComponent(d.slug ?? d.id)}`;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary}
	canonical={seo.canonical}
	image={seo.ogImage ?? cover}
	content={{ collection: "services", id: d.id, slug }}
	current="/services"
>
	<header class="detail-head">
		<div class="wrap">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/services">Services</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{d.title}</span>
			</nav>
			<div class="detail-grid">
				<div class="detail-copy">
					<p class="eyebrow">Service</p>
					<h1 class="display display-xl" {...service.edit.title}>{d.title}</h1>
					<p class="lede">{d.summary}</p>
					<dl class="facts">
						{d.best_for && <div><dt>Who it is for</dt><dd>{d.best_for}</dd></div>}
						{d.length && <div><dt>Typical length</dt><dd>{d.length}</dd></div>}
						{d.price && <div><dt>Price</dt><dd>{d.price}</dd></div>}
					</dl>
					<p class="detail-actions">
						<a class="btn" href={bookHref}><span>Book a visit</span><Arrow /></a>
					</p>
				</div>
				{cover && <img class="detail-cover" src={cover} alt={photoAlt(d.image, d.photo, d.title)} width="800" height="690" fetchpriority="high" />}
			</div>
		</div>
	</header>

	<section class="detail-body">
		<div class="wrap detail-body-grid">
			<div class="prose">
				{hasBody ? <PortableText value={d.content} /> : <p>{d.summary}</p>}
			</div>
			<aside class="side-stack">
				{
					lines(d.visit).length > 0 && (
						<div class="side-card">
							<h2 class="side-title">What a session involves</h2>
							<ol class="visit-steps">
								{lines(d.visit).map((i) => <li>{i}</li>)}
							</ol>
						</div>
					)
				}
				<div class="side-card side-card-tint">
					<h2 class="side-title">How to book</h2>
					<p>{d.how_to_book || "Send a request and the front desk will reply with times. Please leave medical details out of the form."}</p>
					<p class="side-action"><a class="btn" href={bookHref}><span>Book a visit</span><Arrow /></a></p>
				</div>
			</aside>
		</div>
	</section>

	{
		others.length > 0 && (
			<section class="more-band" aria-labelledby="more-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="eyebrow">More services</p>
							<h2 id="more-title" class="display">Other ways we can <span class="accent">help.</span></h2>
						</div>
						<a class="text-link" href="/services"><span>All services</span><Arrow /></a>
					</div>
					<ul class="more-list">
						{others.map((s) => (
							<li>
								<a href={serviceHref(s.data)}>
									<strong>{s.data.title}</strong>
									<span>{s.data.summary}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<VisitBand clinic={clinicResult.clinic} />
</Base>
