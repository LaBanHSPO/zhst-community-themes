---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound container" aria-labelledby="nf-title">
		<p class="eyebrow">Error 404</p>
		<h1 id="nf-title" class="display display-xxl">This room<br /> isn’t here.</h1>
		<p>The page you’re looking for doesn’t exist or has moved. Browse our projects, or book a site visit and tell us about your home.</p>
		<div class="actions">
			<a class="btn" href="/projects">See our projects <Arrow /></a>
			<a class="text-link" href="/site-visit">Book a site visit <Arrow /></a>
		</div>
	</section>
</Base>
