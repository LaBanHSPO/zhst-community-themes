---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { getMaterials, getServices, getSteps, photoAlt, photoSrc } from "../lib/formhouse";

const [servicesResult, materialsResult, stepsResult] = await Promise.all([getServices(), getMaterials(), getSteps()]);
if (Astro.cache?.enabled) {
	for (const hint of [servicesResult.cacheHint, materialsResult.cacheHint, stepsResult.cacheHint]) Astro.cache.set(hint);
}
const services = servicesResult.entries.map((e) => e.data);
const materials = materialsResult.entries.map((e) => e.data);
const steps = stepsResult.entries.map((e) => e.data);
---

<Base
	title="Services & process"
	description="Kitchen, whole-home and tailored renovations, managed with clarity, craft and care."
	header="overlay"
>
	<section class="hero hero-services" aria-labelledby="services-title">
		<img
			class="hero-photo"
			src="/images/services-hero.webp"
			alt="A kitchen with a long stone island, timber stools and walnut cabinetry open to a garden"
			width="952"
			height="282"
			fetchpriority="high"
		/>
		<div class="hero-copy container">
			<p class="eyebrow eyebrow-light">Services &amp; process</p>
			<h1 id="services-title" class="display display-services">Thoughtful renovations,<br class="br-wide" /> from concept to home.</h1>
			<p class="hero-lede">Kitchen, whole-home and tailored renovations,<br class="br-wide" /> managed with clarity, craft and care.</p>
		</div>
	</section>

	{
		services.length > 0 && (
			<section class="packages container" aria-label="Renovation services">
				{services.map((s) => {
					const src = photoSrc(s.image, s.photo);
					return (
						<article class="package" aria-labelledby={`pkg-${s.id}`}>
							{src && <img src={src} alt={photoAlt(s.image, s.photo_alt, s.eyebrow)} width="395" height="201" loading="lazy" />}
							<div class="package-body">
								<p class="eyebrow">{s.eyebrow}</p>
								<h2 id={`pkg-${s.id}`} class="display display-pkg">{s.title}</h2>
								{s.summary && <p>{s.summary}</p>}
								{s.link && <a class="text-link" href={s.link}>{s.link_label || `Explore ${s.eyebrow.toLowerCase()}`} <Arrow /></a>}
							</div>
						</article>
					);
				})}
			</section>
		)
	}

	<section class="materials" aria-labelledby="materials-title">
		<div class="materials-inner container">
			<div class="materials-head">
				<p class="eyebrow">Our materials approach</p>
				<h2 id="materials-title" class="display display-md">Natural materials.<br /> Lasting spaces.</h2>
			</div>
			<div class="materials-text">
				<p>We work with honest, durable materials that age beautifully — stone, timber, plaster and texture — to create homes with soul and longevity.</p>
				{
					materials.length > 0 && (
						<details class="palette">
							<summary class="text-link">Explore our material palette <Arrow /></summary>
							<dl>
								{materials.map((m) => (
									<div>
										<dt>{m.title}</dt>
										{m.note && <dd>{m.note}</dd>}
									</div>
								))}
							</dl>
						</details>
					)
				}
			</div>
			{
				materials.length > 0 && (
					<ul class="swatches" aria-label="Material palette">
						{materials.map((m) => {
							const src = photoSrc(m.image, m.photo);
							return src ? (
								<li>
									<img src={src} alt={photoAlt(m.image, null, `${m.title} sample`)} title={m.title} width="144" height="120" loading="lazy" />
								</li>
							) : null;
						})}
					</ul>
				)
			}
		</div>
	</section>

	<section class="process" aria-labelledby="process-title">
		<div class="process-inner container">
			<div class="process-head">
				<p class="eyebrow">Our process</p>
				<h2 id="process-title" class="display display-lg-alt">A clear path<br /> to home.</h2>
			</div>
			{
				steps.length > 0 && (
					<ol class="steps">
						{steps.map((s, i) => {
							const src = photoSrc(s.image, s.photo);
							return (
								<li class="step">
									<span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
									<div class="step-body">
										<h3>{s.title}</h3>
										{s.text && <p>{s.text}</p>}
									</div>
									{src && <img src={src} alt={photoAlt(s.image, s.photo_alt, s.title)} width="290" height="105" loading="lazy" />}
								</li>
							);
						})}
					</ol>
				)
			}
		</div>
		<div class="container process-cta">
			<p>Ready to start with a conversation?</p>
			<a class="btn" href="/site-visit">Book a site visit <Arrow /></a>
		</div>
	</section>
</Base>
