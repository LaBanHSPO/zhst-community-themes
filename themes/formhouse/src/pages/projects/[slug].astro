---
import { getEmDashEntry, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { categoryKey, getProjects, photoAlt, photoSrc } from "../../lib/formhouse";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const [{ entry, cacheHint }, projectsResult] = await Promise.all([getEmDashEntry("projects", slug), getProjects()]);
if (!entry) return Astro.redirect("/404");
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(projectsResult.cacheHint);
}

const p = entry.data;
const key = p.slug ?? p.id;
const heroSrc = photoSrc(p.hero_image, p.hero_photo) ?? photoSrc(p.image, p.photo);
const heroAlt =
	p.hero_image || p.hero_photo
		? photoAlt(p.hero_image, p.hero_alt, `${p.title} interior`)
		: photoAlt(p.image, p.photo_alt, `${p.title} interior`);
const beforeSrc = photoSrc(p.before_image, p.before_photo);
const afterSrc = photoSrc(p.after_image, p.after_photo);
// Full-width closing photo: the dedicated detail photo, else the homepage feature photo.
const hasDetail = Boolean(p.detail_image || p.detail_photo);
const detailSrc = hasDetail ? photoSrc(p.detail_image, p.detail_photo) : photoSrc(p.feature_image, p.feature_photo);
const detailAlt = hasDetail
	? photoAlt(p.detail_image, p.detail_alt, `${p.title} detail`)
	: photoAlt(p.feature_image, p.feature_alt, `${p.title} detail`);
const hasBeforeAfter = Boolean(photoSrc(p.before_image, p.before_photo) && photoSrc(p.after_image, p.after_photo));

const specs = [
	["Location", p.location],
	["Project type", p.project_type],
	["Size", p.size],
	["Timeline", p.timeline],
	["Key materials", p.materials],
].filter((row): row is [string, string] => Boolean(row[1]));

// Two more projects, continuing from this one in the list order.
const others = projectsResult.entries.map((e) => e.data);
const at = others.findIndex((o) => (o.slug ?? o.id) === key);
const more = [...others.slice(at + 1), ...others.slice(0, Math.max(at, 0))].filter((o) => (o.slug ?? o.id) !== key).slice(0, 2);
---

<Base
	title={p.title}
	description={p.summary ?? p.overview}
	image={heroSrc}
	header="overlay"
	content={{ collection: "projects", id: p.id, slug: key }}
>
	<section class="hero hero-detail" aria-labelledby="project-title">
		{heroSrc && <img class="hero-photo" src={heroSrc} alt={heroAlt} width="1212" height="404" fetchpriority="high" />}
		<div class="hero-copy container">
			<p class="eyebrow eyebrow-light">{p.eyebrow || "Residential renovation"}</p>
			<h1 id="project-title" class="display display-detail" {...entry.edit.title}>{p.title}</h1>
			{p.summary && <p class="hero-lede">{p.summary}</p>}
		</div>
	</section>

	<section class="overview" aria-labelledby="overview-title">
		<div class:list={["overview-inner container", { "overview-inner-split": !hasBeforeAfter }]}>
			<div class="overview-text">
				<h2 id="overview-title" class="display display-sm">Project overview</h2>
				{p.overview && <p>{p.overview}</p>}
			</div>
			{
				specs.length > 0 && (
					<dl class="specs">
						{specs.map(([label, value]) => (
							<div>
								<dt>{label}</dt>
								<dd>{value}</dd>
							</div>
						))}
					</dl>
				)
			}
			{
				beforeSrc && afterSrc && (
					<div class="before-after" role="group" aria-label="Before and after">
						<figure>
							<img src={beforeSrc} alt={`${p.title} before the renovation`} width="288" height="172" loading="lazy" />
							<figcaption>Before</figcaption>
						</figure>
						<span class="ba-arrow" aria-hidden="true"><Arrow /></span>
						<figure>
							<img src={afterSrc} alt={`${p.title} after the renovation`} width="349" height="172" loading="lazy" />
							<figcaption>After</figcaption>
						</figure>
					</div>
				)
			}
		</div>
	</section>

	{
		(detailSrc || p.closing_title) && (
			<section class:list={["closing", { "closing-plain": !detailSrc }]} aria-labelledby={p.closing_title ? "closing-title" : undefined} aria-label={p.closing_title ? undefined : "Detail photography"}>
				{detailSrc && <img class="closing-photo" src={detailSrc} alt={detailAlt} width="1137" height="221" loading="lazy" />}
				{p.closing_title && (
					<div class="closing-panel">
						<h2 id="closing-title" class="display display-md">{p.closing_title}</h2>
						{p.closing_text && <p>{p.closing_text}</p>}
					</div>
				)}
			</section>
		)
	}

	<section class="more container" aria-labelledby="more-title">
		<div class="more-head">
			<h2 id="more-title" class="display display-md">More projects</h2>
			<a class="text-link" href="/projects">All projects <Arrow /></a>
		</div>
		{
			more.length > 0 && (
				<div class="project-grid project-grid-compact">
					{more.map((o) => <ProjectCard project={o} headingLevel="h3" />)}
				</div>
			)
		}
		<div class="cta-band">
			<p class="display display-sm">Planning a renovation of your own?</p>
			<a class="btn" href={`/site-visit?type=${categoryKey(p.category)}`}>Book a site visit <Arrow /></a>
		</div>
	</section>
</Base>
