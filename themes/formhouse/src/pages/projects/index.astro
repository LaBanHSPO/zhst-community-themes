---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { CATEGORIES, categoryKey, getProjects } from "../../lib/formhouse";

const projectsResult = await getProjects();
if (Astro.cache?.enabled) Astro.cache.set(projectsResult.cacheHint);

// Server-side filter: /projects?type=kitchen | living | whole-home. Unknown values show everything.
const typeParam = (Astro.url.searchParams.get("type") ?? "").toLowerCase();
const active = CATEGORIES.find((c) => categoryKey(c) === typeParam) ?? null;
const all = projectsResult.entries;
const projects = active ? all.filter((e) => e.data.category === active) : all;
const filters = [{ label: "All", href: "/projects", on: !active }].concat(
	CATEGORIES.map((c) => ({ label: c, href: `/projects?type=${categoryKey(c)}`, on: c === active })),
);
---

<Base
	title={active ? `${active} projects` : "Projects"}
	description="Considered renovations for homes that feel more like you."
	header="solid"
>
	<section class="page-intro container" aria-labelledby="projects-title">
		<div class="page-intro-main">
			<p class="eyebrow">Our work</p>
			<h1 id="projects-title" class="display display-xxl">Projects</h1>
		</div>
		<div class="page-intro-side">
			<p class="intro-note">Considered renovations for homes<br class="br-wide" /> that feel more like you.</p>
			<nav class="filters" aria-label="Filter projects by type">
				{
					filters.map((f) => (
						<a class:list={["pill", { "is-active": f.on }]} href={f.href} aria-current={f.on ? "page" : undefined}>
							{f.label}
						</a>
					))
				}
			</nav>
		</div>
	</section>

	<section class="project-grid container" aria-label="Project list">
		{
			projects.length > 0 ? (
				projects.map((entry) => <ProjectCard project={entry.data} />)
			) : (
				<p class="empty-note">
					No {active ? `${active.toLowerCase()} ` : ""}projects to show yet. <a href="/projects">See all projects</a>.
				</p>
			)
		}
	</section>
</Base>
