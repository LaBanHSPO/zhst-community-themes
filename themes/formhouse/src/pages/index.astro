---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { getProjects, photoAlt, photoSrc, projectUrl } from "../lib/formhouse";

const projectsResult = await getProjects();
if (Astro.cache?.enabled) Astro.cache.set(projectsResult.cacheHint);

const projects = projectsResult.entries.map((e) => e.data);
const featured = projects.find((p) => p.featured) ?? projects[0];
const featuredSrc = featured
	? (photoSrc(featured.feature_image, featured.feature_photo) ?? photoSrc(featured.image, featured.photo))
	: undefined;
const featuredAlt = featured
	? featured.feature_image || featured.feature_photo
		? photoAlt(featured.feature_image, featured.feature_alt, featured.title)
		: photoAlt(featured.image, featured.photo_alt, featured.title)
	: "";
---

<Base title="Make room for better living" description="Thoughtful renovations for homes that feel more like you." header="overlay">
	<section class="hero hero-home" aria-labelledby="home-title">
		<img
			class="hero-photo"
			src="/images/home-hero.webp"
			alt="A renovated open-plan room with a walnut kitchen, a stone island, a marble coffee table and a deep cream sofa"
			width="1072"
			height="576"
			fetchpriority="high"
		/>
		<div class="hero-copy container">
			<h1 id="home-title" class="display display-xl">Make room<br />for better<br />living.</h1>
			<p class="hero-lede">Thoughtful renovations for homes<br class="br-wide" /> that feel more like you.</p>
			<a class="text-link text-link-light" href="/projects">Explore our work <Arrow /></a>
		</div>
	</section>

	{
		featured && (
			<section class="featured container" aria-labelledby="featured-title">
				<div class="featured-copy">
					<p class="eyebrow">Featured project</p>
					<h2 id="featured-title" class="display display-lg">{featured.title}</h2>
					{(featured.teaser || featured.summary) && <p class="featured-text">{featured.teaser || featured.summary}</p>}
					<a class="text-link" href={projectUrl(featured)}>View project <Arrow /></a>
				</div>
				{featuredSrc && (
					<figure class="featured-media">
						<img src={featuredSrc} alt={featuredAlt} width="864" height="255" loading="lazy" />
					</figure>
				)}
			</section>
		)
	}
</Base>
