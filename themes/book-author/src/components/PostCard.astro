---
import { photoAlt, photoSrc, postHref } from "../lib/author";
import type { JournalPost } from "../lib/author";

interface Props {
	post: JournalPost;
	edit?: Record<string, unknown>;
}
const { post, edit = {} } = Astro.props;
const src = photoSrc(post.image, post.photo);
---

<a class="post-card" href={postHref(post)}>
	{src && <img src={src} alt={photoAlt(post.image, post.photo, post.title)} width="600" height="440" loading="lazy" />}
	<span class="post-card-meta">
		<span class="post-card-kind">{[post.category, post.date_label].filter(Boolean).join(" · ")}</span>
		<span class="post-card-title" {...edit}>{post.title}</span>
		<span class="post-card-summary">{post.summary}</span>
	</span>
</a>
