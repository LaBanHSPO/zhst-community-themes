---
import Cover from "./Cover.astro";
import { bookHref } from "../lib/author";
import type { Book } from "../lib/author";

interface Props {
	book: Book;
	edit?: Record<string, unknown>;
}
const { book, edit = {} } = Astro.props;
---

<a class="book-card" href={bookHref(book)}>
	<Cover book={book} />
	<span class="book-card-meta">
		<span class="book-card-kind">{[book.kind, book.year].filter(Boolean).join(" · ")}</span>
		<span class="book-card-title" {...edit}>{book.title}</span>
		<span class="book-card-tagline">{book.tagline}</span>
	</span>
</a>
