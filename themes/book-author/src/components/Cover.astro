---
import { photoAlt, photoSrc } from "../lib/author";
import type { Book } from "../lib/author";

interface Props {
	book: Book;
	sizes?: string;
	eager?: boolean;
	class?: string;
}
const { book, eager = false, class: className } = Astro.props;
const src = photoSrc(book.cover, book.cover_photo);
const alt = photoAlt(book.cover, book.cover_photo, "");
---

<div class:list={["cover", { "cover-typeset": !src }, className]}>
	{src && <img src={src} alt={book.cover_overlay ? "" : alt || `Cover of ${book.title}`} width="424" height="566" loading={eager ? "eager" : "lazy"} />}
	{
		(book.cover_overlay || !src) && (
			<span class="cover-lettering" aria-hidden={src ? undefined : "true"}>
				<span class="cover-title">{book.title}</span>
				<span class="cover-author">Elise Rowan</span>
			</span>
		)
	}
	{!src && <span class="sr-only">Cover of {book.title}</span>}
</div>
