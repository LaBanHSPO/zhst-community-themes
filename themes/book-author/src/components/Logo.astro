---
/** Wordmark: a leaf-sprig mark, the site title in widely tracked serif caps and the tagline in tiny tracked caps. */
interface Props {
	title: string;
	tagline?: string;
	logo?: { url?: string; alt?: string } | null;
	class?: string;
}
const { title, tagline, logo, class: className } = Astro.props;
---

<a class:list={["wordmark", className]} href="/" aria-label={`${title} — home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt || title} />
		) : (
			<>
				<svg class="wordmark-mark" width="36" height="58" viewBox="0 0 36 58" aria-hidden="true" focusable="false">
					<g fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
						<path d="M6 55C9 38 16 22 30 6" />
						<path d="M9.5 44c-5-1-7.500-5-7.500-9 5 1 8 4 7.500 9z" />
						<path d="M12 37c3-4 8-5 10.500-4-1 4.500-5.500 6.500-10.500 4z" />
						<path d="M14.500 29c-3.500-3-4-8-2.500-11 4 2 5.500 6.500 2.500 11z" />
						<path d="M18.500 22.500c4-2 8.500-1.500 10.500.5-2 3.500-7 4.500-10.500-.5z" />
						<path d="M22 15c-2.500-3-2-7.500.5-10 2.500 3 2 7-.5 10z" />
					</g>
				</svg>
				<span class="wordmark-text">
					<span class="wordmark-title">{title}</span>
					{tagline && <span class="wordmark-tagline">{tagline}</span>}
				</span>
			</>
		)
	}
</a>
