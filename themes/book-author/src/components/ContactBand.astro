---
import Arrow from "./Arrow.astro";
import { telHref } from "../lib/author";
import type { AuthorData } from "../lib/author";

interface Props {
	author: AuthorData;
}
const { author } = Astro.props;
---

<section class="contact-band" aria-labelledby="contact-band-title">
	<div class="wrap contact-band-inner">
		<p class="eyebrow eyebrow-light">Write to the author</p>
		<h2 id="contact-band-title" class="display display-light">A note to the author is always welcome.</h2>
		<p class="contact-band-copy">Readers, reading groups and event organisers: tell me what you are planning, or simply what a book meant to you.</p>
		<div class="contact-band-actions">
			<a class="btn btn-solid" href="/contact"><span>Get in touch</span><Arrow /></a>
			<p class="contact-band-contact">
				{author.email && <a href={`mailto:${author.email}`}>{author.email}</a>}
				{author.phone && <a href={telHref(author.phone)}>{author.phone}</a>}
			</p>
		</div>
	</div>
</section>
