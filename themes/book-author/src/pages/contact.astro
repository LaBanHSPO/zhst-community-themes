---
import Base from "../layouts/Base.astro";
import { getAuthor, telHref } from "../lib/author";

const { author, cacheHint } = await getAuthor();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const topics = [
	{ value: "events", label: "Events and talks", subject: "Event or talk" },
	{ value: "book-clubs", label: "Book clubs and reading groups", subject: "Book club" },
	{ value: "rights", label: "Rights and translation", subject: "Rights and translation" },
	{ value: "general", label: "A general note to the author", subject: "A note to the author" },
];
// ?topic=<value> pre-selects a topic (links from book pages and the homepage).
const wanted = Astro.url.searchParams.get("topic");
const selected = topics.find((t) => t.value === wanted);
---

<Base title="Contact" description="Write to Elise Rowan about events, book clubs, rights and translation, or simply to say hello. Every message is read by the author.">
	<div class="contact">
		<aside class="contact-aside">
			<img
				src="/images/desk-notebook.webp"
				alt="A speckled ceramic cup beside an open notebook and a fountain pen"
				width="568"
				height="320"
			/>
			<div class="contact-details">
				<h2>Prefer to write directly?</h2>
				<p>
					{author.email && <a href={`mailto:${author.email}`}>{author.email}</a>}
					{author.phone && <a href={telHref(author.phone)}>{author.phone}</a>}
				</p>
				{author.response && <p class="small">{author.response}</p>}
				{author.contact_note && <p class="small">{author.contact_note}</p>}
			</div>
		</aside>

		<section class="contact-panel" aria-labelledby="contact-title">
			<p class="eyebrow">Contact</p>
			<h1 id="contact-title" class="display display-xl">Write to the author.</h1>
			<p class="lede">
				Planning an event, choosing a book for your group, or enquiring about rights? Choose a topic and tell me a little about it.
			</p>

			<form
				class="contact-form"
				data-contact-form
				data-email={author.email}
				action={author.email ? `mailto:${author.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field">
						<label for="c-name">Your name</label>
						<input id="c-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="c-name"></span>
					</div>
					<div class="field">
						<label for="c-email">Email</label>
						<input id="c-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="c-email"></span>
					</div>
					<div class="field full">
						<label for="c-topic">Topic</label>
						<select id="c-topic" name="topic" required>
							<option value="" selected={!selected}>Choose a topic</option>
							{topics.map((t) => <option value={t.value} data-subject={t.subject} selected={selected?.value === t.value}>{t.label}</option>)}
						</select>
						<span class="field-error" data-error-for="c-topic"></span>
					</div>
					<div class="field full">
						<label for="c-group">Group, venue or organisation <span class="optional">(optional)</span></label>
						<input id="c-group" name="group" type="text" placeholder="e.g. Thursday Readers, Harbour Library" />
					</div>
					<div class="field full">
						<label for="c-message">Your message</label>
						<textarea id="c-message" name="message" rows="5" placeholder="Dates, how many of you, or what a book meant to you…" required></textarea>
						<span class="field-error" data-error-for="c-message"></span>
					</div>
				</div>
				<button class="btn btn-solid btn-block" type="submit"><span>Send message</span></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{author.email && <>Write to <a href={`mailto:${author.email}`}>{author.email}</a> and say what it is about.</>}
					</noscript>
				</p>
			</form>
		</section>
	</div>
</Base>

<script>
	// Compose an email to the author; nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online messages are not available right now. Please call the events office.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const select = form.querySelector<HTMLSelectElement>("#c-topic");
			const subjectLabel = select?.selectedOptions[0]?.dataset.subject ?? "A note to the author";
			const subject = `${subjectLabel}: ${get("name")}`;
			const body = [
				"Hello,",
				"",
				`Topic: ${select?.selectedOptions[0]?.textContent ?? ""}`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("group") ? `Group, venue or organisation: ${get("group")}` : "",
				"",
				get("message"),
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body.join("\n"))}`;
			status.textContent =
				"Your email app should open with this message ready to send. It is only sent when you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
