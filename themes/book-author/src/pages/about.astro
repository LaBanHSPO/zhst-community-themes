---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ContactBand from "../components/ContactBand.astro";
import PageHead from "../components/PageHead.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getAuthor } from "../lib/author";

const [{ entry: page, cacheHint }, authorResult, settings] = await Promise.all([
	getEmDashEntry("pages", "about"),
	getAuthor(),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	if (cacheHint) Astro.cache.set(cacheHint);
	Astro.cache.set(authorResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = page ? getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: "/about" }) : null;
const hasBody = Boolean(page?.data.content && page.data.content.length > 0);
const { author } = authorResult;
---

<Base
	title={seo?.title ?? "About"}
	pageTitle={seo?.ogTitle}
	description={seo?.description ?? page?.data.intro ?? "About Elise Rowan, a writer of warm, thoughtful fiction."}
	canonical={seo?.canonical}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	<PageHead
		id="about-title"
		eyebrow={page?.data.eyebrow ?? "About"}
		title={page?.data.title ?? "A writer of brighter places."}
		intro={page?.data.intro}
		edit={page ? { ...page.edit.title } : {}}
	/>

	<section class="about-story">
		<figure class="about-photo">
			<img
				src="/images/portrait-author.webp"
				alt="The author at a wooden table, chin resting on her hand, smiling thoughtfully"
				width="758"
				height="1000"
				loading="lazy"
			/>
			{author.title && <figcaption>{author.title}{author.base ? `, ${author.base}` : ""}</figcaption>}
		</figure>
		<div class="prose">
			{hasBody ? <PortableText value={page!.data.content} /> : <p>The author's story is coming soon.</p>}
			<p class="about-links">
				<a class="btn btn-outline" href="/books"><span>See the books</span><Arrow /></a>
				<a class="text-link" href="/contact"><span>Write to me</span><Arrow /></a>
			</p>
		</div>
	</section>

	<ContactBand author={author} />
</Base>
