---
/** Brush wordmark: a leading "The" sits small above the rest of the site title; an uploaded logo replaces it. */
interface Props {
	title: string;
	logo?: { url?: string; alt?: string } | null;
	class?: string;
}
const { title, logo, class: className } = Astro.props;
const match = title.match(/^(the)\s+(.+)$/i);
const small = match ? match[1] : "";
const main = match ? match[2] : title;
---

<a class:list={["wordmark", className]} href="/" aria-label={`${title} — home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt || title} />
		) : (
			<span class="wordmark-text" aria-hidden="true">
				{small && <span class="wordmark-small">{small}</span>}
				<span class="wordmark-main">{main}</span>
			</span>
		)
	}
</a>
