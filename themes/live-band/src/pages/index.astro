---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ShowCard from "../components/ShowCard.astro";
import {
	getMembers,
	getPhotos,
	getReleases,
	getShows,
	initialsOf,
	photoAlt,
	photoSrc,
	releaseHref,
} from "../lib/band";

const [showsResult, releasesResult, membersResult, photosResult] = await Promise.all([
	getShows(),
	getReleases(),
	getMembers(),
	getPhotos(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(showsResult.cacheHint);
	Astro.cache.set(releasesResult.cacheHint);
	Astro.cache.set(membersResult.cacheHint);
	Astro.cache.set(photosResult.cacheHint);
}
// "Next Stops": the next three dates that are still happening.
const nextStops = showsResult.upcoming.filter((s) => s.entry.data.ticket_status !== "cancelled").slice(0, 3);
const latest = releasesResult.entries[0];
const tracks = latest?.data.tracklist ?? [];
const members = membersResult.entries.slice(0, 4);
const photos = photosResult.entries.slice(0, 6);
---

<Base
	title="Made for the live moment."
	description="The Live Band is an independent four-piece: tour dates, new music and a loud, happy room. Real people, louder together."
	overlay
>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-stage" aria-hidden="true">
			<img src="/images/hero-home.webp" alt="" width="1448" height="743" fetchpriority="high" decoding="async" />
			<p class="hero-note">
				<span>Music</span><span>People</span><span>Better</span><span>Days</span>
				<svg viewBox="0 0 60 8" preserveAspectRatio="none" focusable="false">
					<path d="M2 6c18-1 36-3 56-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
				</svg>
			</p>
		</div>
		<div class="hero-inner">
			<h1 id="hero-title">Made for<br />the live moment.</h1>
			<p class="hero-tag">Real people. Louder together.</p>
			<a class="btn-red" href="/tour"><span>See tour dates</span><Arrow size={22} /></a>
		</div>
	</section>

	<section class="stops" aria-labelledby="stops-title">
		<div class="stops-grid">
			<div class="stops-intro">
				<p class="eyebrow">Upcoming shows</p>
				<h2 id="stops-title" class="serif-display">Next Stops</h2>
				<span class="red-rule" aria-hidden="true"></span>
				<p class="stops-sub">New cities. Familiar energy.<br />Let’s do this again.</p>
				<a class="text-link" href="/tour"><span>See all tour dates</span><Arrow size={18} /></a>
			</div>
			<div class="stops-cards">
				{
					nextStops.length > 0 ? (
						nextStops.map((s) => <ShowCard show={s.entry} day={s.day} />)
					) : (
						<p class="stops-empty">
							No new dates right now. <a href="/contact?topic=updates">Get updates</a> and we will tell you first.
						</p>
					)
				}
			</div>
			<aside class="stops-strip" aria-hidden="true">
				<p class="strip-note">
					<span>Same</span><span>Stage</span><span>Brighter</span><span>People</span>
					<svg viewBox="0 0 60 8" preserveAspectRatio="none" focusable="false">
						<path d="M2 6c18-1 36-3 56-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
					</svg>
				</p>
			</aside>
		</div>
	</section>

	{
		latest && (
			<section class="latest" aria-labelledby="latest-title">
				<div class="wrap latest-grid">
					<a class="latest-cover" href={releaseHref(latest.data)} tabindex="-1" aria-hidden="true">
						<img
							src={photoSrc(latest.data.image, latest.data.photo)}
							alt=""
							width="548"
							height="548"
							loading="lazy"
							decoding="async"
						/>
					</a>
					<div class="latest-copy">
						<p class="eyebrow eyebrow-red">Latest release</p>
						<h2 id="latest-title" class="serif-display">{latest.data.title}</h2>
						<p class="latest-meta">
							{latest.data.kind} · {latest.data.year}
							{tracks.length > 0 && ` · ${tracks.length} tracks`}
						</p>
						<p class="latest-sum">{latest.data.summary}</p>
						{
							tracks.length > 0 && (
								<ol class="tracks">
									{tracks.slice(0, 9).map((t) => (
										<li>
											<span class="track-title">{t.title}</span>
											<span class="track-len">{t.length}</span>
										</li>
									))}
								</ol>
							)
						}
						<p class="latest-actions">
							<a class="btn-red" href={releaseHref(latest.data)}>
								<span>Read the liner notes</span>
								<Arrow size={20} />
							</a>
							<a class="text-link text-link-light" href="/music"><span>All music</span><Arrow size={18} /></a>
						</p>
					</div>
				</div>
			</section>
		)
	}

	{
		members.length > 0 && (
			<section class="band" aria-labelledby="band-title">
				<div class="wrap">
					<div class="section-head">
						<p class="eyebrow">The band</p>
						<h2 id="band-title" class="serif-display">Four people. One loud room.</h2>
						<span class="red-rule" aria-hidden="true" />
					</div>
					<ul class="member-grid">
						{members.map((m) => {
							const src = photoSrc(m.data.image, m.data.photo);
							return (
								<li class="member">
									<div class="member-photo">
										{src ? (
											<img
												src={src}
												alt={photoAlt(m.data.image, m.data.photo, m.data.title)}
												width="400"
												height="500"
												loading="lazy"
												decoding="async"
											/>
										) : (
											<span class="member-initials" aria-hidden="true">
												{initialsOf(m.data.title, m.data.initials)}
											</span>
										)}
									</div>
									<h3>{m.data.title}</h3>
									<p>{m.data.role}</p>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	{
		photos.length > 0 && (
			<section class="gallery" aria-labelledby="gallery-title">
				<div class="wrap">
					<div class="section-head section-head-light">
						<p class="eyebrow eyebrow-red">From the stage</p>
						<h2 id="gallery-title" class="serif-display">Louder together.</h2>
					</div>
					<ul class="gallery-grid">
						{photos.map((p, i) => (
							<li class={`g${i + 1}`}>
								<img
									src={photoSrc(p.data.image, p.data.photo)}
									alt={photoAlt(p.data.image, p.data.photo, p.data.title)}
									width="800"
									height="600"
									loading="lazy"
									decoding="async"
								/>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<section class="updates" aria-labelledby="updates-title">
		<div class="wrap updates-inner">
			<div>
				<p class="eyebrow eyebrow-light">Stay in the loop</p>
				<h2 id="updates-title" class="serif-display">Never miss a night.</h2>
				<p>New dates, new songs, nothing else. Tell us where to send it and we write when something happens.</p>
			</div>
			<a class="btn-light" href="/contact?topic=updates"><span>Get updates</span><Arrow size={20} /></a>
		</div>
	</section>
</Base>
