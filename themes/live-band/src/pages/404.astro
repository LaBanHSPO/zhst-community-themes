---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<img class="notfound-bg" src="/images/hero-home.webp" alt="" width="1448" height="743" />
		<div class="wrap notfound-copy">
			<p class="eyebrow eyebrow-red">Error 404</p>
			<h1 id="nf-title" class="display">This page left the stage.</h1>
			<p class="lede">The page you are looking for has moved or never existed. Try one of these instead.</p>
			<div class="actions">
				<a class="btn-red" href="/"><span>Back to home</span><Arrow size={20} /></a>
				<a class="pill" href="/tour">Tour</a>
				<a class="pill" href="/music">Music</a>
			</div>
		</div>
	</section>
</Base>
