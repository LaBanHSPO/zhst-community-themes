---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import PageHead from "../../components/PageHead.astro";
import ShowCard from "../../components/ShowCard.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { dayKey, getShows, longDate, photoAlt, photoSrc, statusLabel, todayKey } from "../../lib/band";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: show, cacheHint } = await getEmDashEntry("shows", slug);
if (!show) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const d = show.data;
const day = dayKey(d.show_date);
const isPast = day < todayKey();
const status = d.ticket_status ?? "on-sale";
const src = photoSrc(d.image, d.photo);
const more = (await getShows()).upcoming.filter((s) => s.entry.data.id !== d.id && s.entry.data.ticket_status !== "cancelled").slice(0, 3);
const seo = getSeoMeta(show, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
---

<Base
	title={`${d.title}, ${d.venue}`}
	pageTitle={seo.ogTitle}
	description={seo.description ?? `The Live Band at ${d.venue}, ${d.title} on ${day ? longDate(day) : ""}.`}
	canonical={seo.canonical}
	content={{ collection: "shows", id: d.id, slug }}
	current="/tour"
>
	<PageHead eyebrow={isPast ? "Past show" : "Tour date"} title={d.title} intro={d.venue} edit={{ ...show.edit.title }} />
	<section class="section-paper">
		<div class="wrap show-detail">
			<div class="show-facts">
				<dl>
					<div><dt>Date</dt><dd>{day ? longDate(day) : ""}</dd></div>
					<div><dt>Venue</dt><dd>{d.venue}</dd></div>
					{d.doors && <div><dt>Time</dt><dd>{d.doors}</dd></div>}
					<div><dt>Tickets</dt><dd><span class={`chip chip-${isPast ? "past" : status}`}>{isPast ? "Show has passed" : statusLabel(status)}</span></dd></div>
				</dl>
				{d.note && <p class="show-note">{d.note}</p>}
				{
					!isPast && status === "on-sale" && d.ticket_url && (
						<p>
							<a class="btn-red" href={d.ticket_url} target="_blank" rel="noopener noreferrer">
								<span>Get tickets</span>
								<Arrow size={20} />
							</a>
						</p>
					)
				}
				<div class="prose"><PortableText value={d.content} /></div>
				<p><a class="text-link" href="/tour"><span>All tour dates</span><Arrow size={18} /></a></p>
			</div>
			{src && <img class="show-photo" src={src} alt={photoAlt(d.image, d.photo)} width="710" height="412" decoding="async" />}
		</div>
	</section>
	{
		more.length > 0 && (
			<section class="section-dark">
				<div class="wrap">
					<h2 class="list-title list-title-light">More nights</h2>
					<div class="stops-cards stops-cards-flat">
						{more.map((s) => <ShowCard show={s.entry} day={s.day} />)}
					</div>
				</div>
			</section>
		)
	}
</Base>
