---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Arrow from "../../components/Arrow.astro";
import { getShows, longDate, shortDate, showHref, statusLabel } from "../../lib/band";

const { upcoming, past, cacheHint } = await getShows();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base
	title="Tour"
	description="Upcoming and past shows by The Live Band: dates, cities, venues and ticket status."
>
	<PageHead eyebrow="Tour" title="Next Stops" intro="New cities. Familiar energy. Find a night near you and come make it louder." note={["Same", "Stage", "Brighter", "People"]} />

	<section class="section-paper" aria-labelledby="up-title">
		<div class="wrap">
			<h2 id="up-title" class="list-title">Upcoming shows</h2>
			{
				upcoming.length > 0 ? (
					<ul class="show-list">
						{upcoming.map(({ entry, day }) => {
							const d = entry.data;
							const status = d.ticket_status ?? "on-sale";
							return (
								<li class:list={["show-row", `is-${status}`]}>
									<a class="show-row-link" href={showHref(d)}>
										<span class="show-row-date">
											<span class="show-row-md">{shortDate(day)}</span>
											<span class="show-row-year">{day.slice(0, 4)}</span>
										</span>
										<span class="show-row-main">
											<span class="show-row-city">{d.title}</span>
											<span class="show-row-venue">{d.venue}{d.doors ? ` · ${d.doors}` : ""}</span>
										</span>
										<span class={`chip chip-${status}`}>{statusLabel(status)}</span>
										<span class="show-row-go"><Arrow size={20} /></span>
									</a>
									{status === "on-sale" && d.ticket_url && (
										<a class="btn-red btn-small" href={d.ticket_url} target="_blank" rel="noopener noreferrer">
											<span>Tickets</span>
										</a>
									)}
								</li>
							);
						})}
					</ul>
				) : (
					<p class="empty">
						No dates are announced right now. <a href="/contact?topic=updates">Get updates</a> and we will tell you first.
					</p>
				)
			}
		</div>
	</section>

	{
		past.length > 0 && (
			<section class="section-dark" aria-labelledby="past-title">
				<div class="wrap">
					<h2 id="past-title" class="list-title list-title-light">Past shows</h2>
					<ul class="past-list">
						{past.map(({ entry, day }) => (
							<li>
								<a href={showHref(entry.data)}>
									<span class="past-date">{longDate(day)}</span>
									<span class="past-city">{entry.data.title}</span>
									<span class="past-venue">{entry.data.venue}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}
</Base>
