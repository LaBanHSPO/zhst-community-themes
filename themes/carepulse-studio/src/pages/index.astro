---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import HeroArt from "../components/HeroArt.astro";
import Icon from "../components/Icon.astro";
import ServiceCard from "../components/ServiceCard.astro";
import OpeningHoursPanel from "../components/OpeningHoursPanel.astro";
import InquiryPanel from "../components/InquiryPanel.astro";
import PostCard from "../components/PostCard.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import {
	categoryLabel,
	getAvailableServiceNames,
	getCategoryLabels,
	getHeroIntro,
	getInquiryHref,
	getOpeningHours,
	serviceVisual,
} from "../utils/practice";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 10,
});
const { entries: services } = await getEmDashCollection("services", { limit: 6 });
const [settings, heroIntro, hours, inquiryHref, labels, formServiceNames] = await Promise.all([
	getSiteSettings(),
	getHeroIntro(),
	getOpeningHours(),
	getInquiryHref(Astro.locals, Astro.url),
	getCategoryLabels(),
	getAvailableServiceNames(),
]);
// The Forms-plugin inquiry form is active: show the compact form in the right rail.
const showInquiryForm = inquiryHref?.endsWith("#inquiry") ?? false;
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(settings);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const recentPosts = posts.slice(0, 3);
const serviceNames = services
	.filter((service) => service.data.available !== false)
	.map((service) => service.data.name)
	.filter(Boolean)
	.slice(0, 4);
---

<Base title={siteTitle} description={siteTagline}>
	<div class="wrap home-grid">
		<div class="home-main">
			<section class="hero" aria-labelledby="hero-title">
				<HeroArt class="hero-art" />
				<div class="hero-copy">
					<h1 id="hero-title">{siteTagline}</h1>
					<span class="rule" aria-hidden="true"></span>
					{heroIntro && <div class="hero-intro"><PortableText value={heroIntro.content as any} /></div>}
					<div class="hero-actions">
						{
							inquiryHref ? (
								<a class="btn btn-peach" href={inquiryHref}>
									<Icon name="mail" />
									Inquire
								</a>
							) : (
								<a class="btn btn-peach" href="/services">
									View services
								</a>
							)
						}
					</div>
				</div>
			</section>

			<section class="services" aria-labelledby="services-title">
				<div class="section-head">
					<h2 id="services-title">Our Services</h2>
					<a class="text-link" href="/services">View all services <Icon name="arrow-right" /></a>
				</div>
				{
					services.length === 0 ? (
						<p class="empty">
							No services yet. <a href="/_emdash/admin/content/services/new">Create one</a>.
						</p>
					) : (
						<ul class="service-grid">
							{services.map((service, index) => {
								const label = categoryLabel(service.data.category, labels);
								return (
									<li>
										<ServiceCard
											href={`/services/${service.id}`}
											name={service.data.name}
											nameAttrs={service.edit.name}
											summary={service.data.description}
											meta={[service.data.duration].filter(Boolean) as string[]}
											category={label}
											available={service.data.available}
											visual={serviceVisual(service.data.category, index)}
										/>
									</li>
								);
							})}
						</ul>
					)
				}
			</section>
		</div>

		{
			(hours || inquiryHref) && (
				<aside class="home-aside" aria-label="Practice details">
					{hours && <OpeningHoursPanel hours={hours} />}
					{inquiryHref && (
						<InquiryPanel
							href={inquiryHref}
							serviceNames={showInquiryForm ? formServiceNames : serviceNames}
							showForm={showInquiryForm}
						/>
					)}
				</aside>
			)
		}
	</div>

	{
		recentPosts.length > 0 && (
			<section class="wrap notes" aria-labelledby="notes-title">
				<div class="section-head">
					<div>
						<span class="eyebrow">Health notes</span>
						<h2 id="notes-title">From our practice</h2>
					</div>
					<a class="text-link" href="/posts">All health notes <Icon name="arrow-right" /></a>
				</div>
				<ul class="note-grid">
					{recentPosts.map((post) => (
						<li>
							<PostCard post={post} />
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>

<style>
	.home-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 360px;
		gap: 28px;
		padding-top: 24px;
		align-items: start;
	}

	.home-main {
		min-width: 0;
	}

	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 430px;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--surface);
		isolation: isolate;
	}

	.hero :global(.hero-art) {
		position: absolute;
		inset: 0 0 0 auto;
		width: 72%;
		height: 100%;
		z-index: -2;
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(
			90deg,
			var(--surface) 0%,
			var(--surface) 30%,
			rgba(252, 249, 244, 0.82) 42%,
			rgba(252, 249, 244, 0) 58%
		);
	}

	.hero-copy {
		max-width: 470px;
		padding: clamp(32px, 4vw, 56px) clamp(24px, 4vw, 56px);
	}

	.hero h1 {
		font-size: clamp(2.6rem, 4.6vw, 4.1rem);
		line-height: 1.04;
		letter-spacing: -0.02em;
	}

	.hero-intro {
		color: var(--ink-soft);
		font-size: 1.2rem;
		line-height: 1.5;
	}

	.hero-intro :global(p) {
		margin: 0;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
	}

	.hero-actions .btn {
		min-width: 188px;
		min-height: 54px;
		font-size: 1.15rem;
	}

	.services {
		position: relative;
		margin-top: 32px;
	}

	.service-grid,
	.note-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-aside {
		display: grid;
		gap: 22px;
		position: sticky;
		top: 104px;
	}

	.notes {
		margin-top: clamp(48px, 6vw, 72px);
	}

	.notes .eyebrow {
		margin-bottom: 6px;
	}

	@media (max-width: 1180px) {
		.home-grid {
			grid-template-columns: minmax(0, 1fr) 320px;
		}

		.service-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 1023px) {
		.home-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-aside {
			position: static;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: start;
			order: 1;
		}

		.home-main {
			display: contents;
		}

		.hero {
			order: 0;
		}

		.services {
			order: 2;
			margin-top: 12px;
		}

		.note-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 680px) {
		.home-grid {
			padding-top: 16px;
			gap: 20px;
		}

		.hero {
			flex-direction: column;
			align-items: stretch;
			min-height: 0;
		}

		.hero :global(.hero-art) {
			position: relative;
			order: 2;
			width: 100%;
			height: 220px;
			z-index: 0;
		}

		.hero::before {
			display: none;
		}

		.hero-copy {
			max-width: none;
			padding: 28px 22px 24px;
		}

		.hero h1 {
			font-size: 2.45rem;
		}

		.hero-intro {
			font-size: 1.08rem;
		}

		.hero-actions .btn {
			width: 100%;
		}

		.home-aside,
		.service-grid,
		.note-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
