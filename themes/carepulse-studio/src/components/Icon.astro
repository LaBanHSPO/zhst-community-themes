---
/** Line icons for CarePulse Studio. Decorative by default (aria-hidden). */
export type IconName =
	| "mail"
	| "send"
	| "clock"
	| "calendar"
	| "arrow-right"
	| "arrow-left"
	| "menu"
	| "close"
	| "lotus"
	| "sprout"
	| "person"
	| "pulse"
	| "leaf"
	| "search"
	| "check";

interface Props {
	name: IconName;
	class?: string;
	label?: string;
}

const { name, class: className, label } = Astro.props;

const paths: Record<IconName, string> = {
	mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/>',
	send: '<path d="M21 3 10.5 13.5"/><path d="M21 3 14.5 21l-4-7.5L3 9.5 21 3Z"/>',
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/>',
	calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
	"arrow-right": '<path d="M5 12h14M13 6l6 6-6 6"/>',
	"arrow-left": '<path d="M19 12H5M11 6l-6 6 6 6"/>',
	menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
	close: '<path d="M6 6l12 12M18 6 6 18"/>',
	lotus:
		'<path d="M12 19c-3.5-1.6-5.5-4.7-5.5-8.2C8.6 11.6 10.9 13.4 12 19Z"/><path d="M12 19c3.5-1.6 5.5-4.7 5.5-8.2-2.1.8-4.4 2.6-5.5 8.2Z"/><path d="M12 19c-1.8-2.4-2.6-5.2-2.2-8.4L12 5l2.2 5.6c.4 3.2-.4 6-2.2 8.4Z"/><path d="M4 19h16"/>',
	sprout:
		'<path d="M12 20v-8"/><path d="M12 12C12 8 9 5.5 5 5.5 5 9.5 8 12 12 12Z"/><path d="M12 14c0-3.6 2.7-6 6.5-6 0 3.7-2.7 6-6.5 6Z"/>',
	person: '<circle cx="12" cy="8" r="3.6"/><path d="M5 20c.6-3.8 3.4-6 7-6s6.4 2.2 7 6"/>',
	pulse: '<path d="M3 12h4l2-5 4 10 2-5h6"/>',
	leaf: '<path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z"/><path d="M5 19 13 11"/>',
	search: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.4-4.4"/>',
	check: '<circle cx="12" cy="12" r="9"/><path d="m8 12.4 2.7 2.6L16 9.5"/>',
};
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden={label ? undefined : "true"}
	role={label ? "img" : undefined}
	aria-label={label}
	focusable="false"
	set:html={paths[name]}
/>
