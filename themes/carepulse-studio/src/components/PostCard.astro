---
import { Image } from "emdash/ui";
import Icon from "./Icon.astro";
import { formatDate } from "../utils/practice";

interface Props {
	post: any;
	tags?: { slug: string; label: string }[];
	headingLevel?: "h2" | "h3";
}

const { post, tags = [], headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const href = `/posts/${post.id}`;
---

<article class="post-card">
	<div class="post-media" {...post.edit.featured_image}>
		{
			post.data.featured_image ? (
				<Image image={post.data.featured_image} />
			) : (
				<div class="post-placeholder" aria-hidden="true">
					<Icon name="leaf" />
				</div>
			)
		}
	</div>
	<div class="post-body">
		{
			post.data.publishedAt && (
				<time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
			)
		}
		<Heading class="post-title">
			<a href={href} {...post.edit.title}>{post.data.title}</a>
		</Heading>
		{post.data.excerpt && <p class="post-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>}
		{
			tags.length > 0 && (
				<ul class="post-tags" aria-label="Tags">
					{tags.map((tag) => (
						<li>
							<a class="pill" href={`/tag/${tag.slug}`}>
								{tag.label}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</article>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		background: var(--card);
		border: 1px solid var(--line-soft);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}

	.post-media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--sage-wash);
	}

	.post-media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.post-media:has(.post-placeholder) {
		aspect-ratio: auto;
		height: 150px;
	}

	.post-placeholder {
		display: grid;
		place-items: center;
		height: 100%;
		background:
			radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.6) 0 22%, transparent 23%),
			linear-gradient(135deg, var(--peach-wash), var(--sage-soft));
		color: rgba(74, 93, 71, 0.55);
	}

	.post-placeholder :global(svg) {
		width: 64px;
		height: 64px;
		stroke-width: 1.1;
	}

	.post-body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 20px 22px 24px;
	}

	time {
		color: var(--muted);
		font-size: 0.85rem;
	}

	.post-title {
		font-size: 1.35rem;
	}

	.post-title a {
		color: var(--ink);
		text-decoration: none;
	}

	.post-title a:hover {
		color: var(--sage-deep);
		text-decoration: underline;
	}

	.post-excerpt {
		margin: 0;
		color: var(--ink-soft);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 6px 0 0;
		padding: 0;
		list-style: none;
	}
</style>
