---
import type { MediaReference } from "../utils/site-identity";

interface Props {
	title: string;
	tagline?: string;
	logo?: MediaReference | null;
	class?: string;
	light?: boolean;
}
const { title, tagline, logo, class: className, light = false } = Astro.props;
// The tagline is short phrases separated by two or more spaces: "People  Places  Good Food".
const phrases = (tagline ?? "").split(/\s{2,}|\|/).filter(Boolean);
---

<a class:list={["wordmark", { "is-light": light }, className]} href="/" aria-label={`${title}, home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt ?? title} width="200" height="46" />
		) : (
			<>
				<svg class="wordmark-mark" viewBox="0 0 42 46" width="38" height="42" aria-hidden="true" focusable="false">
					<g fill="currentColor">
						<path d="M22.5 1.5C28.6 6.4 29.6 13.6 25 20.5 19.6 15.6 18.6 8 22.5 1.5Z" />
						<path d="M7.5 10.5C14.2 11.4 18.4 16.6 17.7 25 11 24 6.8 18.4 7.5 10.5Z" />
						<path d="M39.5 17.2C36.4 24.8 30 28 22.2 26.2 25.3 18.6 31.6 15.4 39.5 17.2Z" />
						<path d="M2.2 34.2C6.6 28.8 14 28.2 20.4 31.6 16.3 37.6 8 39.4 2.2 34.2Z" />
					</g>
					<path d="M20.6 45C19.7 36 20.2 25 23.4 10" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
				</svg>
				<span class="wordmark-text">
					<span class="wordmark-title">{title}</span>
					{phrases.length > 0 && <span class="wordmark-tagline">{phrases.map((p) => <span>{p}</span>)}</span>}
				</span>
			</>
		)
	}
</a>
