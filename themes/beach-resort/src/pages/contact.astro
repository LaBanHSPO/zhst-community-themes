---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { formatPrice, getCompany, getExperiences, getSuites, mapHref, rows, telHref, viewLabel } from "../lib/resort";

const [{ company, cacheHint }, suitesResult, expResult] = await Promise.all([getCompany(), getSuites(), getExperiences()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(suitesResult.cacheHint);
	Astro.cache.set(expResult.cacheHint);
}
const office = rows(company.office);
const times = rows(company.stay_times);
const getting = rows(company.getting_here);
const suites = suitesResult.suites;
// ?suite=<slug> pre-selects the suite. ?experience=<slug> adds a line to the requests box.
// ?checkin=YYYY-MM-DD, ?checkout=YYYY-MM-DD, ?adults= and ?children= fill the other fields.
const q = Astro.url.searchParams;
const selected = suites.find((s) => (s.data.slug ?? s.data.id) === q.get("suite"));
const exp = expResult.experiences.find((e) => (e.data.slug ?? e.data.id) === q.get("experience"));
const day = (v: string | null) => (v && /^\d{4}-\d{2}-\d{2}$/.test(v) ? v : "");
const checkin = day(q.get("checkin"));
const checkout = day(q.get("checkout"));
const count = (v: string | null, min: number, max: number, fallback: number) => {
	const n = Number(v);
	return Number.isInteger(n) && n >= min && n <= max ? n : fallback;
};
const adults = count(q.get("adults"), 1, 8, 2);
const children = count(q.get("children"), 0, 6, 0);
const requestsDefault = exp ? `I would also like to ask about: ${exp.data.title} (${exp.data.duration}).` : "";
---

<Base title="Book Your Stay" description="Ask SandCove about your dates: choose a suite, check-in and check-out, guests and any requests. The resort confirms availability and the rate by email. Phone and email are on this page.">
	<PageHead
		id="contact-title"
		eyebrow="Book Your Stay"
		title="Tell us when you would like to come."
		intro="Choose a suite and your dates. We check availability and reply by email with the rate."
	/>
	<section class="contact-section" aria-labelledby="contact-title">
		<div class="wrap contact-grid">
			<form
				class="enquiry-form"
				data-enquiry-form
				data-email={company.email}
				action={company.email ? `mailto:${company.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field full">
						<label for="c-suite">Suite</label>
						<select id="c-suite" name="suite" required>
							<option value="" selected={!selected}>Choose a suite</option>
							{
								suites.map((s) => (
									<option
										value={s.data.title}
										data-slug={s.data.slug ?? s.data.id}
										data-max={s.data.max_guests}
										selected={selected?.data.id === s.data.id}
									>
										{s.data.title} · {viewLabel(s.data.view)} · sleeps {s.data.max_guests}{s.data.price_from ? ` · from ${formatPrice(s.data.price_from)}` : ""}
									</option>
								))
							}
							<option value="Not sure yet">Not sure yet, please suggest one</option>
						</select>
						<span class="field-error" data-error-for="c-suite"></span>
					</div>
					<div class="field">
						<label for="c-in">Check-in</label>
						<input id="c-in" name="checkin" type="date" value={checkin} required />
						<span class="field-error" data-error-for="c-in"></span>
					</div>
					<div class="field">
						<label for="c-out">Check-out</label>
						<input id="c-out" name="checkout" type="date" value={checkout} required />
						<span class="field-error" data-error-for="c-out"></span>
					</div>
					<div class="field">
						<label for="c-adults">Adults</label>
						<select id="c-adults" name="adults" required>
							{[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <option value={String(n)} selected={n === adults}>{n}</option>)}
						</select>
					</div>
					<div class="field">
						<label for="c-children">Children</label>
						<select id="c-children" name="children">
							{[0, 1, 2, 3, 4, 5, 6].map((n) => <option value={String(n)} selected={n === children}>{n}</option>)}
						</select>
						<span class="field-hint">Add their ages in the requests box.</span>
					</div>
					<div class="field full">
						<span class="field-error" data-error-for="c-adults" data-guests-error></span>
					</div>
					<div class="field full">
						<label for="c-name">Name</label>
						<input id="c-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="c-name"></span>
					</div>
					<div class="field">
						<label for="c-email">Email</label>
						<input id="c-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="c-email"></span>
					</div>
					<div class="field">
						<label for="c-phone">Phone <span class="optional">(optional)</span></label>
						<input id="c-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field full">
						<label for="c-notes">Special requests <span class="optional">(optional)</span></label>
						<textarea id="c-notes" name="notes" rows="4" placeholder="Arrival time, ages of children, allergies, a celebration, airport transfer">{requestsDefault}</textarea>
					</div>
				</div>
				<button class="btn btn-lg btn-block" type="submit">Send availability request</button>
				<p class="form-note">The resort confirms availability and the rate by email. A request does not hold a room or take a payment.</p>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{company.email && <>Write to <a href={`mailto:${company.email}`}>{company.email}</a> with the suite, dates and number of guests.</>}
					</noscript>
				</p>
			</form>

			<aside class="contact-side">
				<h2>Prefer to talk?</h2>
				<p>
					{company.phone && <>Call <a href={telHref(company.phone)}>{company.phone}</a></>}
					{company.phone && company.email && " or email "}
					{!company.phone && company.email && "Email "}
					{company.email && <a href={`mailto:${company.email}`}>{company.email}</a>}.
				</p>
				{
					(company.street || company.locality) && (
						<p>
							<a href={mapHref(company)} target="_blank" rel="noopener noreferrer">{[company.street, company.locality].filter(Boolean).join(", ")}</a>
						</p>
					)
				}
				{
					office.length > 0 && (
						<>
							<h3>Reservations desk</h3>
							<dl class="side-hours">
								{office.map((h) => <><dt>{h.left}</dt><dd>{h.right}</dd></>)}
							</dl>
						</>
					)
				}
				{
					times.length > 0 && (
						<>
							<h3>Arriving and leaving</h3>
							<dl class="side-hours">
								{times.map((h) => <><dt>{h.left}</dt><dd>{h.right}</dd></>)}
							</dl>
						</>
					)
				}
				{
					getting.length > 0 && (
						<>
							<h3>Getting here</h3>
							<dl class="side-hours side-stack">
								{getting.map((h) => <><dt>{h.left}</dt><dd>{h.right}</dd></>)}
							</dl>
						</>
					)
				}
				{company.enquiry_note && <p class="small">{company.enquiry_note}</p>}
			</aside>
		</div>
	</section>
</Base>

<script>
	// Keep the dates and guest count sensible, then compose an availability request email.
	// Nothing is sent by the site itself; the resort confirms by reply.
	document.querySelectorAll<HTMLFormElement>("[data-enquiry-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		const suiteSel = form.querySelector<HTMLSelectElement>("#c-suite");
		const inInput = form.querySelector<HTMLInputElement>("#c-in");
		const outInput = form.querySelector<HTMLInputElement>("#c-out");
		const adultsSel = form.querySelector<HTMLSelectElement>("#c-adults");
		const kidsSel = form.querySelector<HTMLSelectElement>("#c-children");
		if (!status || !suiteSel || !inInput || !outInput || !adultsSel || !kidsSel) return;

		const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
		inInput.min = iso(new Date());
		const syncOut = () => {
			if (!inInput.value) return;
			const next = new Date(`${inInput.value}T00:00:00`);
			next.setDate(next.getDate() + 1);
			outInput.min = iso(next);
		};
		syncOut();
		inInput.addEventListener("change", () => {
			syncOut();
			if (outInput.value && outInput.value < outInput.min) outInput.value = "";
		});

		const nights = (): number => {
			if (!inInput.value || !outInput.value) return 0;
			return Math.round((new Date(`${outInput.value}T00:00:00`).getTime() - new Date(`${inInput.value}T00:00:00`).getTime()) / 86400000);
		};
		const maxGuests = (): number => Number(suiteSel.selectedOptions[0]?.dataset.max ?? 0);
		const guestSlot = form.querySelector<HTMLElement>("[data-guests-error]");

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input[required], select[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				let message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				if (!message && input === outInput && nights() < 1) message = "Check-out must be after check-in.";
				if (!message && input === inInput && inInput.value < inInput.min) message = "Please choose a date from today.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			const total = Number(adultsSel.value) + Number(kidsSel.value);
			const max = maxGuests();
			if (guestSlot) {
				guestSlot.textContent = max && total > max ? `This suite sleeps up to ${max} guests. Choose another suite or fewer guests.` : "";
				adultsSel.setAttribute("aria-invalid", max && total > max ? "true" : "false");
				if (max && total > max && !firstInvalid) firstInvalid = adultsSel;
			}
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online requests are not available right now. Please call us.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Availability request: ${get("suite")}, ${get("checkin")} to ${get("checkout")}`;
			const lines = [
				"Hello,",
				"",
				"I would like to ask about availability:",
				`Suite: ${get("suite")}`,
				`Check-in: ${get("checkin")}`,
				`Check-out: ${get("checkout")} (${nights()} nights)`,
				`Adults: ${get("adults")}`,
				`Children: ${get("children")}`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("notes") ? `Special requests: ${get("notes")}` : "",
				"",
				"I understand this is a request and no room is held until I receive a written confirmation with the rate.",
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this request ready to send. It is only sent when you send that email, and we reply to it. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
