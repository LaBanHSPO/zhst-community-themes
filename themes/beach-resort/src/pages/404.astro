---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<div class="wrap notfound-inner">
			<div class="notfound-copy">
				<p class="eyebrow">Error 404<span class="eyebrow-rule" aria-hidden="true"></span></p>
				<h1 id="nf-title" class="display">That page has drifted out to sea.</h1>
				<p class="lede">The address may have changed, or the page never existed. Try one of these instead.</p>
				<div class="actions">
					<a class="btn" href="/">Back to home <Arrow /></a>
					<a class="btn btn-ghost" href="/stay">Stay</a>
					<a class="btn btn-ghost" href="/contact">Book Your Stay</a>
				</div>
			</div>
			<img class="notfound-photo" src="/images/beach-sunset.webp" alt="" width="760" height="430" />
		</div>
	</section>
</Base>
