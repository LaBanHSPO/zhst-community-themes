---
import { getSeoMeta, getSiteSettings } from "emdash";
import type { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "./Arrow.astro";
import PageHead from "./PageHead.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

interface Props {
	slug: string;
	/** The pages entry. The route looks it up so a missing page can rewrite to 404 before any HTML is sent. */
	page: NonNullable<Awaited<ReturnType<typeof getEmDashEntry<"pages">>>["entry"]>;
}
const { slug, page } = Astro.props;

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? page.data.intro}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<PageHead eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro} edit={{ ...page.edit.title }} />
	<div class="page-body">
		<div class="wrap wrap-narrow">
			<div class="prose">
				<PortableText value={page.data.content} />
			</div>
			<slot />
			<p class="page-cta"><a class="btn" href="/contact">Book Your Stay <Arrow /></a></p>
		</div>
	</div>
</Base>
