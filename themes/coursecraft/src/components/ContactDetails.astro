---
import { getWidgetAreaWithCacheHint } from "emdash";
import { PortableText } from "emdash/ui";

/**
 * Renders the "contact" widget area (seeded with an email address). It is always shown
 * next to the inquiry form so visitors have a way to reach out even when no form exists yet.
 */
const areaResult = await getWidgetAreaWithCacheHint("contact");
if (Astro.cache?.enabled) Astro.cache.set(areaResult.cacheHint);
const area = areaResult.data;
const widgets = (area?.widgets ?? []).filter((w) => w.type === "content" && w.content?.length);
---

<div class="contact-details">
	{
		widgets.length > 0 ? (
			widgets.map((widget) => (
				<section class="contact-widget" aria-label={widget.title || "Contact details"}>
					{widget.title && <h3 class="contact-title">{widget.title}</h3>}
					<PortableText value={widget.content!} />
				</section>
			))
		) : (
			<p class="contact-missing">
				Contact details have not been added yet. Add a content widget to the “Contact details” widget area in the admin.
			</p>
		)
	}
</div>

<style>
	.contact-details {
		padding: 1.25rem 1.4rem;
		border-radius: var(--radius-sm);
		background: var(--color-surface-muted);
		font-size: 0.98rem;
	}

	.contact-title {
		font-family: var(--font-body);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-bottom: 0.6rem;
	}

	.contact-details :global(p:last-child) {
		margin-bottom: 0;
	}

	.contact-details :global(a) {
		font-weight: 600;
	}

	.contact-missing {
		margin: 0;
		color: var(--color-ink-soft);
	}
</style>
