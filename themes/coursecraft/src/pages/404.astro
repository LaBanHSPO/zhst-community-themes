---
import Base from "../layouts/Base.astro";

Astro.response.status = 404;
---

<Base title="Page not found">
	<div class="container not-found">
		<p class="eyebrow">Error 404</p>
		<h1>This page took a different path.</h1>
		<p class="lede">The page you are looking for does not exist or has moved. Try the course catalog instead.</p>
		<p class="actions">
			<a class="btn btn-primary" href="/courses">Browse courses <span class="arrow" aria-hidden="true">→</span></a>
			<a class="btn btn-outline" href="/">Go home</a>
		</p>
	</div>
</Base>

<style>
	.not-found {
		padding-block: clamp(3rem, 8vw, 6rem);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}
</style>
