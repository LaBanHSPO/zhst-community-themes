---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import InstructorAvatar from "../../components/InstructorAvatar.astro";
import { levelLabel } from "../../utils/courses";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404");

const { entry: person, cacheHint } = await getEmDashEntry("instructors", slug, {
	references: { courses: true },
});
if (!person) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const data = person.data;
const courses = person.references?.courses.entries ?? [];
---

<Base
	title={data.name}
	description={data.short_bio ?? `${data.name}, instructor`}
	image={data.photo?.src ?? null}
	content={{ collection: "instructors", id: data.id, slug: person.id }}
>
	<div class="container">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<ol role="list">
				<li><a href="/instructors">Instructors</a></li>
				<li><span aria-current="page">{data.name}</span></li>
			</ol>
		</nav>

		<header class="profile-head">
			<InstructorAvatar name={data.name} photo={data.photo} size={168} class="profile-avatar" />
			<div>
				<p class="eyebrow">Instructor</p>
				<h1 {...person.edit.name}>{data.name}</h1>
				{data.role && <p class="role">{data.role}</p>}
				{data.short_bio && <p class="lede">{data.short_bio}</p>}
			</div>
		</header>

		<div class="profile-body">
			{
				data.bio && data.bio.length > 0 && (
					<section class="prose" aria-labelledby="bio-title">
						<h2 id="bio-title">About {data.name.split(" ")[0]}</h2>
						<PortableText value={data.bio} />
					</section>
				)
			}

			<section aria-labelledby="taught-title" class="taught">
				<h2 id="taught-title">Courses</h2>
				{
					courses.length > 0 ? (
						<ul role="list">
							{courses.map((course) => (
								<li>
									<a href={`/courses/${course.id}`}>
										<span class="taught-title">{course.data.title}</span>
										<span class="level" data-level={course.data.level}>
											{levelLabel(course.data.level)}
										</span>
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="none">No published courses yet.</p>
					)
				}
			</section>
		</div>
	</div>
</Base>

<style>
	.breadcrumb ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.9rem;
		color: var(--color-muted);
	}

	.breadcrumb li + li::before {
		content: "/";
		margin-right: 0.4rem;
	}

	.breadcrumb a {
		color: var(--color-ink-soft);
	}

	.profile-head {
		display: flex;
		align-items: center;
		gap: clamp(1.25rem, 4vw, 3rem);
		padding-block: clamp(2rem, 5vw, 3.5rem);
	}

	.profile-head h1 {
		font-size: clamp(2.2rem, 4.6vw, 3.4rem);
		margin-bottom: 0.25rem;
	}

	.role {
		font-size: 1.1rem;
		color: var(--color-muted);
	}

	.profile-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
		border-top: 1px solid var(--color-line);
		padding-top: 2rem;
	}

	.profile-body h2 {
		font-size: 1.6rem;
	}

	.taught ul {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.taught a {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1rem 1.15rem;
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		border-radius: var(--radius-sm);
		text-decoration: none;
	}

	.taught a:hover {
		border-color: var(--color-ink-soft);
	}

	.taught-title {
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 640;
	}

	.none {
		color: var(--color-muted);
	}

	@media (max-width: 760px) {
		.profile-head {
			flex-direction: column;
			align-items: flex-start;
		}

		.profile-body {
			grid-template-columns: 1fr;
		}
	}
</style>
