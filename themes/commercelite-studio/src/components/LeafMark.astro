---
/** Original two-leaf brand mark. Decorative; inherits currentColor. */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 48 48" width="100%" fill="none" aria-hidden="true" focusable="false">
	<path
		d="M24.5 43C22 33 23.5 22 31 13.5C34.6 9.4 39.4 6.6 44 5.5C44.8 12 43 19.5 38.6 25.2C34.2 31 28.4 34.5 24.5 43Z"
		fill="currentColor"></path>
	<path
		d="M22.5 43C21 36.4 17.2 31.4 11.8 28.5C8.6 26.8 5.6 26.3 3.5 26.5C3.9 31.6 7 36.3 11.7 39.1C15.1 41.1 19 42 22.5 43Z"
		fill="currentColor"
		opacity="0.72"></path>
	<path
		d="M24.5 43C27 32 32 22.6 41 9"
		style="stroke: var(--color-bg, #fff)"
		stroke-width="1.4"
		stroke-linecap="round"></path>
</svg>
