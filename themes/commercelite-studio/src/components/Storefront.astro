---
import { sanitizeHref } from "emdash";
import { Icon } from "astro-iconset/components";
import type { PageContentBlock } from "../../emdash-env";
import {
	SORT_OPTIONS,
	buildStorefront,
	matchesQuery,
	readSort,
	sortProducts,
} from "../lib/catalog";
import MarketingBlocks from "./MarketingBlocks.astro";
import ProductCard from "./ProductCard.astro";
import ShelfIllustration from "./ShelfIllustration.astro";

interface Props {
	value?: PageContentBlock[] | null;
	/** Path of the page this storefront lives on; filter and sort links stay on it. */
	path: string;
	/** Fallback heading when the page has no introduction hero. */
	fallbackTitle?: string;
}

const { value, path, fallbackTitle = "Our products" } = Astro.props;
const store = buildStorefront(value);
const hasCatalog = store.products.length > 0;

const params = Astro.url.searchParams;
const query = (params.get("q") ?? "").trim().slice(0, 80);
const sort = readSort(params.get("sort"));
const requested = params.get("category");
const activeCategory = store.categories.find((category) => category.slug === requested) ?? null;

const visible = sortProducts(
	store.products.filter(
		(product) =>
			(!activeCategory || product.category === activeCategory) && matchesQuery(product, query),
	),
	sort,
);

function linkFor(options: { category?: string | null; sort?: string; q?: string }): string {
	const next = new URLSearchParams();
	const q = options.q ?? query;
	const s = options.sort ?? sort;
	if (q) next.set("q", q);
	if (options.category) next.set("category", options.category);
	if (s && s !== "featured") next.set("sort", s);
	const search = next.toString();
	return `${path}${search ? `?${search}` : ""}#catalog`;
}

const intro = store.intro;
const introPrimary =
	intro?.primary_cta_label && intro.primary_cta_url
		? { label: intro.primary_cta_label, url: sanitizeHref(intro.primary_cta_url) }
		: null;
const introSecondary =
	intro?.secondary_cta_label && intro.secondary_cta_url
		? { label: intro.secondary_cta_label, url: sanitizeHref(intro.secondary_cta_url) }
		: null;
const heading = activeCategory ? activeCategory.label : "All Products";
const filtered = !!(query || activeCategory);
---

{
	hasCatalog ? (
		<div class="storefront">
			<aside class="store-aside" aria-label="Catalog introduction and categories">
				<div class="store-intro" id={intro?.anchor_id || undefined}>
					<h1 class="store-title">{intro?.headline || fallbackTitle}</h1>
					<span class="sand-rule" aria-hidden="true" />
					{intro?.subheadline && <p class="store-lede">{intro.subheadline}</p>}
					{(introPrimary || introSecondary) && (
						<div class="store-intro-actions">
							{introPrimary && (
								<a class="btn btn-primary" href={introPrimary.url}>
									{introPrimary.label}
								</a>
							)}
							{introSecondary && (
								<a class="btn btn-secondary" href={introSecondary.url}>
									{introSecondary.label}
								</a>
							)}
						</div>
					)}
				</div>

				<nav class="store-categories" aria-label="Product categories">
					<ul>
						<li>
							<a
								href={linkFor({ category: null })}
								aria-current={!activeCategory ? "page" : undefined}
							>
								<Icon name="ph:squares-four" aria-hidden="true" />
								<span class="cat-label">All Products</span>
								<span class="cat-count">{store.products.length}</span>
							</a>
						</li>
						{store.categories.map((category) => (
							<li>
								<a
									href={linkFor({ category: category.slug })}
									aria-current={activeCategory === category ? "page" : undefined}
								>
									<Icon name="ph:tag-simple" aria-hidden="true" />
									<span class="cat-label">{category.label}</span>
									<span class="cat-count">{category.count}</span>
								</a>
							</li>
						))}
					</ul>
				</nav>
			</aside>

			<section class="store-main" id="catalog" aria-labelledby="catalog-heading">
				<header class="store-toolbar">
					<div>
						<h2 id="catalog-heading" class="store-heading">
							{heading}
						</h2>
						{filtered && (
							<p class="store-result" role="status">
								{visible.length} of {store.products.length} products
								{query && (
									<>
										{" "}
										matching “<strong>{query}</strong>”
									</>
								)}
								<a href={linkFor({ category: null, q: "" })}>Clear filters</a>
							</p>
						)}
					</div>
					<form class="store-sort" method="get" action={`${path}#catalog`} data-sort-form>
						{query && <input type="hidden" name="q" value={query} />}
						{activeCategory && (
							<input type="hidden" name="category" value={activeCategory.slug} />
						)}
						<label for="catalog-sort">Sort by</label>
						<span class="select-wrap">
							<select id="catalog-sort" name="sort">
								{SORT_OPTIONS.map((option) => (
									<option value={option.value} selected={option.value === sort}>
										{option.label}
									</option>
								))}
							</select>
						</span>
						<button type="submit" class="btn btn-secondary sort-apply" data-sort-apply>
							Apply
						</button>
					</form>
				</header>

				{visible.length > 0 ? (
					<ul class="product-grid">
						{visible.map((product, index) => (
							<li>
								<ProductCard product={product} index={index} />
							</li>
						))}
					</ul>
				) : (
					<div class="store-empty">
						<p>No products match this search.</p>
						<a class="btn btn-secondary" href={linkFor({ category: null, q: "" })}>
							Show all products
						</a>
					</div>
				)}
			</section>

			<aside class="store-ask" aria-labelledby="ask-heading">
				<Icon name="ph:envelope-simple" class="ask-icon" aria-hidden="true" />
				<h2 id="ask-heading">Have a question?</h2>
				<p>Ask about a product before you buy. We reply by email.</p>
				<a class="btn btn-primary" href="/contact#ask">
					Contact us
				</a>
			</aside>

			<div class="store-art" aria-hidden="true">
				<ShelfIllustration />
			</div>
		</div>
	) : null
}

{store.rest.length > 0 && <MarketingBlocks value={store.rest} />}

<script>
	// Progressive enhancement: sort as soon as the select changes.
	for (const form of document.querySelectorAll<HTMLFormElement>("[data-sort-form]")) {
		form.querySelector<HTMLButtonElement>("[data-sort-apply]")?.setAttribute("hidden", "");
		form.querySelector("select")?.addEventListener("change", () => form.requestSubmit());
	}
</script>

<style>
	.storefront {
		--aside-width: 340px;
		max-width: var(--wide-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: var(--aside-width) minmax(0, 1fr);
		grid-template-rows: auto auto 1fr;
		grid-template-areas:
			"aside main"
			"ask main"
			"art main";
		background: linear-gradient(
			to right,
			var(--color-panel) 0,
			var(--color-panel) var(--aside-width),
			transparent var(--aside-width)
		);
	}

	.store-aside {
		grid-area: aside;
		padding: var(--spacing-2xl) var(--spacing-xl) var(--spacing-lg);
	}

	.store-title {
		font-size: clamp(2.25rem, 3.2vw, 3rem);
		font-weight: 400;
		line-height: 1.12;
		letter-spacing: -0.015em;
		color: var(--color-text);
	}

	.store-intro .sand-rule {
		margin: var(--spacing-lg) 0 var(--spacing-lg);
	}

	.store-lede {
		margin-bottom: var(--spacing-lg);
		color: var(--color-muted);
	}

	.store-intro-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-lg);
	}

	.store-categories ul {
		list-style: none;
		display: grid;
		gap: 4px;
	}

	.store-categories a {
		display: flex;
		align-items: center;
		gap: 14px;
		min-height: 46px;
		padding: 8px 18px;
		font-size: 1.0625rem;
		color: var(--color-text);
		text-decoration: none;
		border-radius: var(--radius-sm);
		transition: background var(--transition-fast);
	}

	.store-categories a:hover {
		background: var(--color-panel-strong);
	}

	.store-categories a[aria-current="page"] {
		color: var(--color-on-brand);
		background: var(--color-brand);
	}

	.store-categories :global(svg) {
		width: 22px;
		height: 22px;
		flex-shrink: 0;
	}

	.cat-label {
		flex: 1;
	}

	.cat-count {
		font-size: var(--font-size-xs);
		font-variant-numeric: tabular-nums;
		opacity: 0.7;
	}

	.store-ask {
		grid-area: ask;
		margin: 0 var(--spacing-xl) var(--spacing-lg);
		padding: var(--spacing-lg);
		display: grid;
		justify-items: start;
		gap: var(--spacing-sm);
		background: color-mix(in srgb, var(--color-surface) 70%, transparent);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-lg);
	}

	.store-ask :global(.ask-icon) {
		width: 28px;
		height: 28px;
		color: var(--color-brand);
	}

	.store-ask h2 {
		font-size: var(--font-size-xl);
	}

	.store-ask p {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.store-ask .btn {
		margin-top: var(--spacing-xs);
	}

	.store-art {
		grid-area: art;
		align-self: end;
		padding: var(--spacing-xl) 0 0;
		overflow: hidden;
	}

	.store-main {
		grid-area: main;
		padding: var(--spacing-2xl) var(--spacing-xl) var(--spacing-3xl);
		min-width: 0;
	}

	.store-toolbar {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--spacing-lg);
		margin-bottom: var(--spacing-lg);
	}

	.store-heading {
		font-size: clamp(1.9rem, 2.4vw, 2.25rem);
		font-weight: 500;
		line-height: 1.15;
	}

	.store-result {
		margin-top: 6px;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.store-result a {
		margin-left: var(--spacing-sm);
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.store-sort {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		flex-shrink: 0;
	}

	.store-sort label {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.select-wrap {
		position: relative;
	}

	.select-wrap::after {
		content: "";
		position: absolute;
		right: 16px;
		top: 50%;
		width: 8px;
		height: 8px;
		border-right: 1.5px solid var(--color-text);
		border-bottom: 1.5px solid var(--color-text);
		transform: translateY(-70%) rotate(45deg);
		pointer-events: none;
	}

	.store-sort select {
		appearance: none;
		min-width: 190px;
		height: 44px;
		padding: 0 44px 0 16px;
		font: inherit;
		font-size: var(--font-size-sm);
		color: var(--color-text);
		background: var(--color-surface);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius);
		cursor: pointer;
	}

	.store-sort select:focus-visible {
		outline: none;
		border-color: var(--color-brand);
		box-shadow: var(--focus-ring);
	}

	.sort-apply[hidden] {
		display: none;
	}

	.product-grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--spacing-lg);
	}

	.store-empty {
		display: grid;
		justify-items: start;
		gap: var(--spacing-md);
		padding: var(--spacing-2xl);
		background: var(--color-surface);
		border: 1px dashed var(--color-border-strong);
		border-radius: var(--radius-lg);
		color: var(--color-muted);
	}

	@media (max-width: 1280px) {
		.product-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 1080px) {
		.storefront {
			--aside-width: 280px;
		}

		.store-aside {
			padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-lg);
		}

		.store-ask {
			margin: 0 var(--spacing-lg) var(--spacing-lg);
		}

		.store-categories a {
			padding: 8px 12px;
			font-size: var(--font-size-base);
		}

		.store-main {
			padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-2xl);
		}
	}

	@media (max-width: 900px) {
		.product-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.storefront {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: none;
			grid-template-areas:
				"aside"
				"main"
				"ask";
			background: none;
		}

		.store-aside {
			position: relative;
			padding: var(--spacing-xl) var(--spacing-md) var(--spacing-md);
			background: var(--color-panel);
			overflow: hidden;
		}

		.store-intro {
			max-width: 70%;
		}

		.store-title {
			font-size: 2rem;
		}

		.store-intro .sand-rule {
			margin: var(--spacing-md) 0;
		}

		.store-categories {
			margin: var(--spacing-sm) calc(-1 * var(--spacing-md)) 0;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.store-categories ul {
			display: flex;
			gap: var(--spacing-sm);
			padding: 2px var(--spacing-md) var(--spacing-xs);
			width: max-content;
		}

		.store-categories a {
			min-height: 40px;
			padding: 6px 14px;
			font-size: var(--font-size-sm);
			white-space: nowrap;
			background: var(--color-surface);
			border: 1px solid var(--color-border-strong);
			border-radius: 999px;
		}

		.store-categories a[aria-current="page"] {
			border-color: var(--color-brand);
		}

		.store-categories :global(svg) {
			width: 18px;
			height: 18px;
		}

		.cat-count {
			display: none;
		}

		.store-art {
			display: none;
		}

		.store-main {
			padding: var(--spacing-lg) var(--spacing-md) var(--spacing-xl);
		}

		.store-toolbar {
			flex-direction: column;
			gap: var(--spacing-md);
		}

		.store-sort {
			width: 100%;
		}

		.store-sort .select-wrap {
			flex: 1;
		}

		.store-sort select {
			width: 100%;
			min-width: 0;
		}

		.product-grid {
			gap: 12px;
		}

		.store-ask {
			margin: 0 var(--spacing-md) var(--spacing-2xl);
		}
	}

	@media (max-width: 360px) {
		.product-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
