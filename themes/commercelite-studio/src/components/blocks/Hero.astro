---
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import ShelfIllustration from "../ShelfIllustration.astro";

type HeroBlock = Extract<PageContentBlock, { _type: "marketing_hero" }>;
type Props = BlockComponentProps<HeroBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline, image, centered } = value;

const primaryCta =
	value.primary_cta_label && value.primary_cta_url
		? { label: value.primary_cta_label, url: sanitizeHref(value.primary_cta_url) }
		: undefined;
const secondaryCta =
	value.secondary_cta_label && value.secondary_cta_url
		? { label: value.secondary_cta_label, url: sanitizeHref(value.secondary_cta_url) }
		: undefined;
---

<section
	id={anchor_id || undefined}
	class:list={["hero", { "hero-centered": centered, "hero-with-image": !!image }]}
>
	<div class="hero-content">
		<h1 class="hero-headline">{headline}</h1>
		{subheadline && <p class="hero-subheadline">{subheadline}</p>}
		{(primaryCta || secondaryCta) && (
			<div class="hero-actions">
				{primaryCta && (
					<a href={primaryCta.url} class="btn btn-primary btn-lg">
						{primaryCta.label}
					</a>
				)}
				{secondaryCta && (
					<a href={secondaryCta.url} class="btn btn-secondary btn-lg">
						{secondaryCta.label}
					</a>
				)}
			</div>
		)}
	</div>
		{image ? (
			<div class="hero-image">
				<Image image={image} class="hero-image-media" priority />
		</div>
	) : !centered && (
		<div class="hero-visual" aria-hidden="true">
			<ShelfIllustration />
		</div>
	)}
</section>

<style>
	.hero {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-3xl) var(--spacing-xl);
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: var(--spacing-2xl);
		align-items: center;
		background: var(--color-panel);
	}

	.hero-centered {
		max-width: none;
		grid-template-columns: 1fr;
		justify-items: center;
		text-align: center;
		padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-2xl);
		background: var(--color-panel);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-centered .hero-content {
		max-width: var(--max-width);
		align-items: center;
	}

	.hero-centered .hero-actions {
		justify-content: center;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
		max-width: 600px;
	}

	.hero-content::after {
		content: "";
		order: 1;
		width: 56px;
		height: 2px;
		background: var(--color-accent);
	}

	.hero-headline {
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
	}

	.hero-subheadline {
		order: 2;
		font-size: var(--font-size-lg);
		line-height: var(--leading-normal);
		color: var(--color-muted);
	}

	.hero-actions {
		order: 3;
		display: flex;
		gap: var(--spacing-md);
		flex-wrap: wrap;
	}

	.hero-image :global(.hero-image-media) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-xl);
	}

	.hero-visual {
		width: 100%;
		max-width: 420px;
		justify-self: center;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			padding: var(--spacing-2xl) var(--spacing-md);
		}

		.hero-visual {
			display: none;
		}
	}
</style>
