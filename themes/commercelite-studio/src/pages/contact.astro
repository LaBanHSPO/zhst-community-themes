---
import { Icon } from "astro-iconset/components";
import { getEmDashEntry, getSeoMeta } from "emdash";
import MarketingBlocks from "../components/MarketingBlocks.astro";
import Base from "../layouts/Base.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "contact");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = page
	? getSeoMeta(page, {
			siteUrl: Astro.url.origin,
			path: "/contact",
			defaultDescription: "Questions about a product, availability or an order? Email the shop directly.",
		})
	: null;

// Product cards link here with ?product=<name>. The name only pre-fills the email subject.
const product = (Astro.url.searchParams.get("product") ?? "").replace(/\s+/g, " ").trim().slice(0, 120);
const subject = product ? `Question about ${product}` : "";

function withSubject(address: string): string {
	return subject ? `mailto:${address}?subject=${encodeURIComponent(subject)}` : `mailto:${address}`;
}

const contactMethods = [
	{
		icon: "ph:envelope",
		title: "General questions",
		description: "Ask about a product, sizes, materials or availability.",
		address: "hello@acme.example",
	},
	{
		icon: "ph:lifebuoy",
		title: "Customer support",
		description: "Help with an order you placed through one of our purchase links.",
		address: "support@acme.example",
	},
	{
		icon: "ph:currency-dollar",
		title: "Sales",
		description: "Larger orders, gift sets and trade enquiries.",
		address: "sales@acme.example",
	},
].map((method) => ({ ...method, href: withSubject(method.address) }));
---

<Base
	title={seo?.title || "Contact"}
	pageTitle={page?.data.title || "Contact"}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	{
		page?.data.content && (
			<div {...page.edit.content}>
				<MarketingBlocks value={page.data.content} />
			</div>
		)
	}

	<section class="contact-section" id="ask" aria-labelledby="contact-heading">
		<div class="container contact-container">
			<div class="contact-intro">
				<p class="contact-eyebrow">Talk to a real person</p>
				<h2 id="contact-heading">Choose who can help</h2>
				<span class="sand-rule" aria-hidden="true"></span>
				<p>
					Email us directly and include any useful context. We will reply from the address you
					contacted.
				</p>
				{
					product && (
						<p class="contact-product">
							<Icon name="ph:tag-simple" aria-hidden="true" />
							<span>
								Asking about <strong>{product}</strong>. The subject line is filled in for you.
							</span>
						</p>
					)
				}
			</div>

			<ul class="contact-grid">
				{
					contactMethods.map((method) => (
						<li class="contact-card">
							<div class="icon-tile contact-icon">
								<Icon name={method.icon} aria-hidden="true" />
							</div>
							<h3>{method.title}</h3>
							<p>{method.description}</p>
							<a class="contact-link" href={method.href}>
								{method.address}
								<Icon name="ph:arrow-right" aria-hidden="true" />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Base>

<style>
	.contact-section {
		padding: var(--spacing-xl) 0 var(--spacing-4xl);
	}

	.contact-container {
		display: grid;
		gap: var(--spacing-2xl);
	}

	.contact-intro {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		justify-items: center;
		gap: var(--spacing-md);
		text-align: center;
	}

	.contact-eyebrow {
		color: var(--color-brand);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.contact-intro h2 {
		font-size: var(--font-size-4xl);
		font-weight: 400;
	}

	.contact-intro > p:not([class]) {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.contact-product {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-sm);
		padding: var(--spacing-sm) var(--spacing-md);
		font-size: var(--font-size-sm);
		background: var(--color-panel);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius);
		text-align: left;
	}

	.contact-product :global(svg) {
		flex-shrink: 0;
		color: var(--color-brand);
	}

	.contact-grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-lg);
		max-width: 1120px;
		width: 100%;
		margin: 0 auto;
	}

	.contact-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: flex-start;
		padding: var(--spacing-xl);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-sm);
	}

	.contact-icon {
		margin-bottom: var(--spacing-lg);
	}

	.contact-card h3 {
		margin-bottom: var(--spacing-sm);
		font-size: var(--font-size-2xl);
	}

	.contact-card p {
		flex: 1;
		margin-bottom: var(--spacing-xl);
		color: var(--color-muted);
	}

	.contact-link {
		display: inline-flex;
		max-width: 100%;
		align-items: center;
		gap: var(--spacing-sm);
		min-height: 40px;
		padding: 8px 14px;
		color: var(--color-on-brand);
		background: var(--color-brand);
		border-radius: var(--radius-sm);
		font-size: var(--font-size-sm);
		font-weight: 500;
		overflow-wrap: anywhere;
	}

	.contact-link:hover {
		background: var(--color-brand-strong);
	}

	@media (max-width: 900px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}

		.contact-intro h2 {
			font-size: var(--font-size-3xl);
		}
	}
</style>
