---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { Icon } from "astro-iconset/components";
import LeafMark from "../components/LeafMark.astro";
import { splitWordmark } from "../lib/catalog";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	/** Path the header search submits to. Catalog pages search themselves. */
	searchAction?: string;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	content,
	searchAction = "/",
} = Astro.props;
const [settingsResult, menuResult, footerProductResult, footerCompanyResult, footerSupportResult] =
	await Promise.all([
		getSiteSettingsWithCacheHint(),
		getMenuWithCacheHint("primary"),
		getMenuWithCacheHint("footer_product"),
		getMenuWithCacheHint("footer_company"),
		getMenuWithCacheHint("footer_support"),
	]);

if (Astro.cache?.enabled) {
	for (const result of [
		settingsResult,
		menuResult,
		footerProductResult,
		footerCompanyResult,
		footerSupportResult,
	]) {
		Astro.cache.set(result.cacheHint);
	}
}

const settings = settingsResult.data;
const siteTitle = settings?.title || "CommerceLite";
const fullTitle = title ? (title.includes(siteTitle) ? title : `${title} — ${siteTitle}`) : siteTitle;
const siteDescription = settings?.tagline || "A small catalog, done well";
const siteLogo = settings.logo?.url ? settings.logo : null;
const wordmark = splitWordmark(siteTitle);
const menu = menuResult.data;
const footerProduct = footerProductResult.data;
const footerCompany = footerCompanyResult.data;
const footerSupport = footerSupportResult.data;

const footerColumns = [
	{ heading: "Shop", menu: footerProduct },
	{ heading: "Company", menu: footerCompany },
	{ heading: "Support", menu: footerSupport },
].filter((col) => col.menu && col.menu.items.length > 0);

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
function isCurrent(url: string): boolean {
	if (!url.startsWith("/") || url.startsWith("//") || url.includes("#")) return false;
	const path = (url.split("?")[0] ?? "").replace(/\/+$/, "") || "/";
	return path === currentPath;
}

const searchQuery = (Astro.url.searchParams.get("q") ?? "").slice(0, 80);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteDescription,
	canonical: canonical ?? `${Astro.url.origin}${Astro.url.pathname}`,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-serif" preload />
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="nav">
				<a href="/" class="site-logo">
					{siteLogo ? (
						<img
							src={siteLogo.url}
							alt={siteLogo.alt || siteTitle}
							width={siteLogo.width}
							height={siteLogo.height}
							class="site-logo-img"
						/>
					) : (
						<span class="wordmark">
							{wordmark.lead}
							{wordmark.tail && <span class="wordmark-tail">{wordmark.tail}</span>}
						</span>
					)}
				</a>

				<button
					type="button"
					class="nav-toggle"
					aria-expanded="false"
					aria-controls="site-menu"
					data-nav-toggle
				>
					<Icon name="ph:list" class="nav-toggle-open" aria-hidden="true" />
					<Icon name="ph:x" class="nav-toggle-close" aria-hidden="true" />
					<span class="visually-hidden">Menu</span>
				</button>

				<div class="nav-menu" id="site-menu" data-nav-menu>
					<nav class="nav-links" aria-label="Primary">
						{
							menu?.items.map((item) => (
								<a
									href={item.url}
									target={item.target}
									rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
									aria-current={isCurrent(item.url) ? "page" : undefined}
								>
									{item.label}
								</a>
							))
						}
						{isLoggedIn && (
							<a href="/_emdash/admin" class="nav-admin">
								Admin
							</a>
						)}
					</nav>

					<form class="nav-search" role="search" action={searchAction} method="get">
						<label for="site-search" class="visually-hidden">Search products</label>
						<Icon name="ph:magnifying-glass" class="nav-search-icon" aria-hidden="true" />
						<input
							id="site-search"
							type="search"
							name="q"
							value={searchQuery}
							placeholder="Search products…"
							autocomplete="off"
							maxlength="80"
						/>
					</form>
				</div>

				<span class="nav-mark" aria-hidden="true"><LeafMark /></span>
			</div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-content">
				<div class="footer-brand">
					<span class="footer-logo">
						{siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								width={siteLogo.width}
								height={siteLogo.height}
								class="footer-logo-img"
							/>
						) : (
							<span class="wordmark">
								{wordmark.lead}
								{wordmark.tail && <span class="wordmark-tail">{wordmark.tail}</span>}
							</span>
						)}
					</span>
					<span class="sand-rule" aria-hidden="true"></span>
					<p class="footer-tagline">{siteDescription}</p>
				</div>
				<div class="footer-links">
					{
						footerColumns.map((col) => (
							<div class="footer-col">
								<h2>{col.heading}</h2>
								{col.menu!.items.map((item) => (
									<a
										href={item.url}
										target={item.target}
										rel={item.target ? "noopener noreferrer" : undefined}
									>
										{item.label}
									</a>
								))}
							</div>
						))
					}
				</div>
			</div>
			<div class="footer-bottom">
				<p>
					&copy; {`${new Date().getFullYear()} ${siteTitle}`}. All rights reserved.
				</p>
				<div class="theme-switcher" role="group" aria-label="Colour theme">
					<button
						type="button"
						class="theme-btn"
						data-theme="light"
						aria-pressed="false"
						aria-label="Light mode">Light</button
					>
					<button
						type="button"
						class="theme-btn"
						data-theme="dark"
						aria-pressed="false"
						aria-label="Dark mode">Dark</button
					>
					<button
						type="button"
						class="theme-btn"
						data-theme="system"
						aria-pressed="false"
						aria-label="System theme">System</button
					>
				</div>
				<p class="footer-powered">
					Powered by <a href="https://emdashcms.com">EmDash</a>
				</p>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			// Theme switcher
			const THEME_REGEX = /theme=([^;]+)/;
			const themeBtns = document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setTheme(theme: string) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (theme === "system") {
					document.cookie = `theme=; path=/; max-age=0; SameSite=Lax${secure}`;
					root.classList.remove("light", "dark");
				} else {
					document.cookie = `theme=${theme}; path=/; max-age=31536000; SameSite=Lax${secure}`;
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function getStoredTheme(): string {
				const match = document.cookie.match(THEME_REGEX);
				return match ? match[1] : "system";
			}

			setTheme(getStoredTheme());

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});

			// Mobile menu disclosure
			const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
			const menuPanel = document.querySelector<HTMLElement>("[data-nav-menu]");

			function setMenu(open: boolean, restoreFocus = false) {
				if (!toggle || !menuPanel) return;
				toggle.setAttribute("aria-expanded", String(open));
				menuPanel.toggleAttribute("data-open", open);
				if (open) {
					menuPanel.querySelector<HTMLElement>("a, input")?.focus();
				} else if (restoreFocus) {
					toggle.focus();
				}
			}

			toggle?.addEventListener("click", () => {
				setMenu(toggle.getAttribute("aria-expanded") !== "true");
			});

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
					setMenu(false, true);
				}
			});

			window.matchMedia("(min-width: 961px)").addEventListener("change", (event) => {
				if (event.matches) setMenu(false);
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				@media (prefers-reduced-motion: reduce) {
					html {
						scroll-behavior: auto;
					}

					*,
					*::before,
					*::after {
						scroll-behavior: auto !important;
						transition-duration: 0.01ms !important;
						animation-duration: 0.01ms !important;
					}
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: currentColor;
					text-decoration: none;
				}

				p a:not([class]),
				li a:not([class]) {
					color: var(--color-brand);
					text-decoration: underline;
					text-underline-offset: 2px;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					font-weight: var(--font-weight-heading);
					line-height: var(--leading-snug);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-size: var(--font-size-5xl);
				}
				h2 {
					font-size: var(--font-size-3xl);
				}
				h3 {
					font-size: var(--font-size-2xl);
				}
				h4 {
					font-size: var(--font-size-xl);
				}

				.container {
					max-width: var(--wide-width);
					margin: 0 auto;
					padding: 0 var(--spacing-xl);
				}

				.section {
					padding: var(--spacing-4xl) 0;
				}

				.section-header {
					text-align: center;
					max-width: var(--max-width);
					margin: 0 auto var(--spacing-3xl);
				}

				.section-headline {
					font-size: var(--font-size-4xl);
				}

				.section-subheadline {
					margin-top: var(--spacing-md);
					font-size: var(--font-size-lg);
					color: var(--color-muted);
				}

				.icon-tile {
					width: 48px;
					height: 48px;
					display: flex;
					align-items: center;
					justify-content: center;
					flex-shrink: 0;
					font-size: 1.5rem;
				}

				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: var(--spacing-sm);
					min-height: 40px;
					padding: var(--spacing-sm) var(--spacing-lg);
					font-family: inherit;
					font-size: var(--font-size-sm);
					line-height: 1.2;
					border: 1px solid transparent;
					cursor: pointer;
					transition:
						background var(--transition-fast),
						border-color var(--transition-fast),
						color var(--transition-fast);
				}

				.btn-lg {
					min-height: 48px;
					padding: var(--spacing-md) var(--spacing-xl);
					font-size: var(--font-size-base);
				}
			}
		</style>

		<style>
			.skip-link {
				position: absolute;
				left: var(--spacing-md);
				top: -100px;
				z-index: 200;
				padding: var(--spacing-sm) var(--spacing-md);
				background: var(--color-brand);
				color: var(--color-on-brand);
				border-radius: var(--radius-sm);
			}

			.skip-link:focus {
				top: var(--spacing-md);
			}

			main:focus {
				outline: none;
			}

			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: color-mix(in srgb, var(--color-bg) 94%, transparent);
				backdrop-filter: blur(8px);
				border-bottom: 1px solid var(--color-border);
			}

			.nav {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 0 var(--spacing-xl);
				min-height: 88px;
				display: flex;
				align-items: center;
				gap: var(--spacing-xl);
			}

			.site-logo {
				flex-shrink: 0;
				color: var(--color-brand);
			}

			.wordmark {
				font-family: var(--font-serif);
				font-size: 2.35rem;
				font-weight: 500;
				line-height: 1;
				letter-spacing: -0.02em;
				color: var(--color-brand);
			}

			.wordmark-tail {
				color: var(--color-brand-soft);
			}

			.site-logo-img {
				height: 48px;
				width: auto;
				display: block;
			}

			.nav-menu {
				flex: 1;
				display: flex;
				align-items: center;
				gap: var(--spacing-xl);
				min-width: 0;
			}

			.nav-links {
				flex: 1;
				display: flex;
				justify-content: center;
				gap: var(--spacing-2xl);
			}

			.nav-links a {
				position: relative;
				padding: var(--spacing-sm) 0;
				font-size: 1.0625rem;
				font-weight: 400;
				color: var(--color-text);
				transition: color var(--transition-fast);
			}

			.nav-links a::after {
				content: "";
				position: absolute;
				left: 0;
				right: 0;
				bottom: -2px;
				height: 2px;
				background: var(--color-brand);
				transform: scaleX(0);
				transition: transform var(--transition-base);
			}

			.nav-links a:hover::after,
			.nav-links a[aria-current="page"]::after {
				transform: scaleX(1);
			}

			.nav-links a[aria-current="page"] {
				font-weight: 600;
				color: var(--color-brand);
			}

			.nav-admin {
				color: var(--color-muted) !important;
			}

			.nav-search {
				position: relative;
				width: min(300px, 26vw);
			}

			.nav-search :global(.nav-search-icon) {
				position: absolute;
				left: 14px;
				top: 50%;
				transform: translateY(-50%);
				font-size: 1.15rem;
				color: var(--color-text);
				pointer-events: none;
			}

			.nav-search input {
				width: 100%;
				height: 46px;
				padding: 0 var(--spacing-md) 0 44px;
				font: inherit;
				font-size: var(--font-size-sm);
				color: var(--color-text);
				background: var(--color-surface);
				border: 1px solid var(--color-border-strong);
				border-radius: var(--radius);
			}

			.nav-search input::placeholder {
				color: var(--color-muted);
			}

			.nav-search input:focus-visible {
				outline: none;
				border-color: var(--color-brand);
				box-shadow: var(--focus-ring);
			}

			.nav-mark {
				display: inline-flex;
				flex-shrink: 0;
				width: 40px;
				color: var(--color-brand);
			}

			.nav-toggle {
				display: none;
				margin-left: auto;
				width: 44px;
				height: 44px;
				align-items: center;
				justify-content: center;
				font-size: 1.5rem;
				color: var(--color-brand);
				background: transparent;
				border: 1px solid var(--color-border-strong);
				border-radius: var(--radius);
				cursor: pointer;
			}

			.nav-toggle :global(.nav-toggle-close) {
				display: none;
			}

			.nav-toggle[aria-expanded="true"] :global(.nav-toggle-open) {
				display: none;
			}

			.nav-toggle[aria-expanded="true"] :global(.nav-toggle-close) {
				display: block;
			}

			main {
				min-height: calc(100vh - 300px);
			}

			.site-footer {
				background: var(--color-panel);
				border-top: 1px solid var(--color-border);
			}

			.footer-content {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-3xl) var(--spacing-xl) var(--spacing-2xl);
				display: grid;
				grid-template-columns: 1fr 2fr;
				gap: var(--spacing-3xl);
			}

			.footer-brand {
				display: grid;
				gap: var(--spacing-md);
				align-content: start;
			}

			.footer-brand .wordmark {
				font-size: 1.75rem;
			}

			.footer-logo-img {
				height: 32px;
				width: auto;
			}

			.footer-tagline {
				font-family: var(--font-serif);
				font-size: var(--font-size-lg);
				color: var(--color-muted);
			}

			.footer-links {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--spacing-xl);
			}

			.footer-col h2 {
				font-family: var(--font-body);
				font-size: var(--font-size-xs);
				font-weight: 600;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--color-muted);
				margin-bottom: var(--spacing-md);
			}

			.footer-col a {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-text);
				padding: var(--spacing-xs) 0;
			}

			.footer-col a:hover {
				color: var(--color-brand);
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			.footer-bottom {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-lg) var(--spacing-xl);
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: var(--spacing-md);
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				border-top: 1px solid var(--color-border-strong);
			}

			.footer-powered a {
				color: var(--color-text);
				text-decoration: underline;
				text-underline-offset: 2px;
			}

			.theme-switcher {
				display: flex;
				gap: var(--spacing-xs);
			}

			.theme-btn {
				min-height: 36px;
				background: transparent;
				border: 1px solid var(--color-border-strong);
				color: var(--color-muted);
				font-family: var(--font-body);
				font-size: var(--font-size-sm);
				padding: var(--spacing-xs) var(--spacing-md);
				border-radius: var(--radius-sm);
				cursor: pointer;
			}

			.theme-btn:hover {
				color: var(--color-text);
				border-color: var(--color-text);
			}

			.theme-btn.active {
				background: var(--color-brand);
				color: var(--color-on-brand);
				border-color: var(--color-brand);
			}

			@media (max-width: 1180px) {
				.nav-links {
					gap: var(--spacing-xl);
				}

				.nav-mark {
					display: none;
				}
			}

			@media (max-width: 960px) {
				.nav {
					min-height: 68px;
					padding: 0 var(--spacing-md);
					gap: var(--spacing-md);
					flex-wrap: wrap;
				}

				.wordmark {
					font-size: 1.85rem;
				}

				.nav-toggle {
					display: inline-flex;
				}

				.nav-menu {
					display: none;
					flex: 1 0 100%;
