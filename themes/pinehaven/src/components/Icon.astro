---
/** Line icons from the mockups. Decorative unless a label is given. */
interface Props {
	name: "calendar" | "guests" | "bed" | "bath" | "home" | "walk" | "car" | "chevron" | "back" | "check";
	label?: string;
	class?: string;
}
const { name, label, class: cls } = Astro.props;
const paths: Record<Props["name"], string> = {
	calendar: '<rect x="3.5" y="5" width="17" height="15" rx="1.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>',
	guests:
		'<circle cx="9" cy="8" r="3.2"/><path d="M3 19.5c.6-3.4 3-5.3 6-5.3s5.4 1.9 6 5.3H3z"/><path d="M15 4.9a3.2 3.2 0 0 1 0 6.2M17.2 14.4c2 .6 3.4 2.3 3.8 5.1h-3"/>',
	bed: '<path d="M3 19v-7.5h18V19M3 16h18M5 11.5V6.5h14v5M7.5 11.5V9.5h3.5v2M13 11.5V9.5h3.5v2"/>',
	bath: '<path d="M3 11.5h18v2a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5v-2zM6.5 11.5V5.5a2 2 0 0 1 3.8-.9M7 18.5l-1 2M17 18.5l1 2"/>',
	home: '<path d="M4 10.5 12 4l8 6.5V20h-5.5v-5.5h-5V20H4z"/>',
	walk:
		'<circle cx="13" cy="4.5" r="1.8"/><path d="M10.5 21l2.2-6.5 2.8 2.6V21M12.7 14.5l.8-5.2-3.2 1.4-1.3 3.3M13.5 9.3l2 3.2 2.8.8"/>',
	car: '<path d="M4 16.5V12l2-5h12l2 5v4.5zM4 12h16M6.5 16.5v2M17.5 16.5v2"/><circle cx="7.5" cy="14" r=".6"/><circle cx="16.5" cy="14" r=".6"/>',
	chevron: '<path d="M6 9l6 6 6-6"/>',
	back: '<path d="M20 12H4.5M10 6l-6 6 6 6"/>',
	check: '<path d="M4.5 12.5l5 5 10-11"/>',
};
---

<svg
	class:list={["icon", cls]}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
	focusable="false"
	set:html={paths[name]}
/>
