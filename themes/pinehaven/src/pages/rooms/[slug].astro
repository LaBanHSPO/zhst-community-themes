---
import { getEmDashEntry, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Icon from "../../components/Icon.astro";
import {
	cabinKey,
	cabinUrl,
	getCabins,
	getGallery,
	getLodge,
	guestsLabel,
	money,
	photoAlt,
	photoSrc,
	plural,
} from "../../lib/pinehaven";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const [{ entry, cacheHint }, galleryResult, cabinsResult, lodgeResult] = await Promise.all([
	getEmDashEntry("cabins", slug),
	getGallery(),
	getCabins(),
	getLodge(),
]);
if (!entry) return Astro.redirect("/404");
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(galleryResult.cacheHint);
	Astro.cache.set(cabinsResult.cacheHint);
	Astro.cache.set(lodgeResult.cacheHint);
}

const c = entry.data;
const key = cabinKey(c);
const { lodge } = lodgeResult;
const heroSrc = photoSrc(c.hero_image, c.hero_photo) ?? photoSrc(c.image, c.photo);
const heroAlt =
	c.hero_image || c.hero_photo ? photoAlt(c.hero_image, c.hero_alt, c.title) : photoAlt(c.image, c.photo_alt, c.title);
const photos = galleryResult.entries
	.map((g) => g.data)
	.filter((g) => g.cabin === key)
	.map((g) => ({ src: photoSrc(g.image, g.photo), alt: photoAlt(g.image, null, g.title) }))
	.filter((g): g is { src: string; alt: string } => Boolean(g.src))
	.slice(0, 4);
const amenities = (c.amenities ?? []).map((a) => a.name).filter(Boolean);
const sleeping = (c.sleeping ?? []).filter((s) => s.room && s.beds);
const requestUrl = `/request-a-stay?cabin=${encodeURIComponent(key)}`;
const others = cabinsResult.entries.map((e) => e.data).filter((o) => cabinKey(o) !== key).slice(0, 3);

const tabs = [
	{ id: "overview", label: "Overview", show: true },
	{ id: "amenities", label: "Amenities", show: amenities.length > 0 },
	{ id: "sleeping", label: "Sleeping arrangements", show: sleeping.length > 0 },
	{ id: "gallery", label: "Gallery", show: photos.length > 0 },
	{ id: "location", label: "Location", show: Boolean(c.location || lodge.address) },
].filter((t) => t.show);
---

<Base
	title={c.title}
	description={c.intro ?? c.summary}
	image={heroSrc}
	content={{ collection: "cabins", id: c.id, slug: key }}
>
	<section class="cabin-hero" aria-labelledby="cabin-title">
		<div class="cabin-intro">
			<a class="back-link" href="/rooms"><Icon name="back" /> All cabins</a>
			<h1 id="cabin-title" class="display display-cabin" {...entry.edit.title}>{c.title}</h1>
			{c.tagline && <p class="eyebrow eyebrow-ink">{c.tagline}</p>}
			{c.intro && <p class="cabin-lede">{c.intro}</p>}
			<ul class="cabin-specs" role="list">
				<li>
					<Icon name="guests" />
					<span><strong>{c.guests}</strong><br />{c.guests.trim() === "1" ? "guest" : "guests"}</span>
				</li>
				{
					(c.bedrooms || c.bed_layout) && (
						<li>
							<Icon name="bed" />
							<span>
								<strong>{c.bedrooms ?? c.bed_layout}</strong>
								{c.bedrooms && c.bed_layout && <span class="spec-sub">{c.bed_layout}</span>}
							</span>
						</li>
					)
				}
				{
					typeof c.bathrooms === "number" && c.bathrooms > 0 && (
						<li>
							<Icon name="bath" />
							<span><strong>{c.bathrooms}</strong><br />{c.bathrooms === 1 ? "bathroom" : "bathrooms"}</span>
						</li>
					)
				}
			</ul>
			<div class="cabin-buy">
				<p class="price price-lg">
					<span class="price-from">From</span>
					<span class="price-amount">{money(c.price)}</span> <span class="price-unit">/ night</span>
				</p>
				<a class="btn btn-lg" href={requestUrl}>Request availability <Arrow /></a>
			</div>
		</div>
		{
			heroSrc && (
				<figure class="cabin-hero-photo">
					<img src={heroSrc} alt={heroAlt} width="1092" height="480" fetchpriority="high" />
				</figure>
			)
		}
	</section>

	<nav class="cabin-tabs" aria-label="Cabin sections">
		<div class="cabin-tabs-inner">
			{tabs.map((t, i) => <a href={`#${t.id}`} class:list={{ "is-first": i === 0 }}>{t.label}</a>)}
		</div>
	</nav>

	<section id="overview" class="cabin-overview" aria-labelledby="overview-title">
		<div class="overview-copy">
			<p class="eyebrow">Cabin overview</p>
			<h2 id="overview-title" class="display display-overview">{c.overview_title ?? c.title}</h2>
			{c.overview && <p>{c.overview}</p>}
		</div>
		{
			photos.length > 0 && (
				<div id="gallery" class:list={["mosaic", `mosaic-${photos.length}`]} role="group" aria-label={`${c.title} gallery`}>
					{photos.map((p, i) => (
						<figure class={`mosaic-${i + 1}`}>
							<img src={p.src} alt={p.alt} loading="lazy" width={i === 0 ? 553 : 526} height={i === 0 ? 284 : 146} />
						</figure>
					))}
				</div>
			)
		}
	</section>

	{
		(amenities.length > 0 || sleeping.length > 0) && (
			<div class="cabin-details">
				{amenities.length > 0 && (
					<section id="amenities" class="detail-block" aria-labelledby="amenities-title">
						<h2 id="amenities-title" class="display display-block">Amenities</h2>
						<ul class="amenities" role="list">
							{amenities.map((a) => (
								<li>
									<Icon name="check" /> {a}
								</li>
							))}
						</ul>
					</section>
				)}
				{sleeping.length > 0 && (
					<section id="sleeping" class="detail-block" aria-labelledby="sleeping-title">
						<h2 id="sleeping-title" class="display display-block">Sleeping arrangements</h2>
						<ul class="sleeping" role="list">
							{sleeping.map((s) => (
								<li>
									<Icon name="bed" />
									<span>
										<strong>{s.room}</strong>
										<span class="spec-sub">{s.beds}</span>
									</span>
								</li>
							))}
						</ul>
						<p class="detail-note">
							Sleeps {guestsLabel(c.guests)}
							{typeof c.bathrooms === "number" && c.bathrooms > 0 && <>, with {plural(c.bathrooms, "bathroom", "bathrooms")}</>}.
						</p>
					</section>
				)}
			</div>
		)
	}

	{
		(c.location || lodge.address) && (
			<section id="location" class="cabin-location" aria-labelledby="location-title">
				<div>
					<p class="eyebrow">Location</p>
					<h2 id="location-title" class="display display-block">Getting here</h2>
				</div>
				<div class="location-text">
					{c.location && <p>{c.location}</p>}
					{lodge.address && (
						<p class="location-address">
							{lodge.title}, {lodge.address}
						</p>
					)}
					{(lodge.check_in || lodge.check_out) && (
						<p class="detail-note">
							{lodge.check_in && <>Check-in from {lodge.check_in}</>}
							{lodge.check_in && lodge.check_out && " · "}
							{lodge.check_out && <>Check-out by {lodge.check_out}</>}
						</p>
					)}
				</div>
				<div class="location-cta">
					<p class="price">
						<span class="price-from">From</span>
						<span class="price-amount">{money(c.price)}</span> <span class="price-unit">/ night</span>
					</p>
					<a class="btn" href={requestUrl}>Request availability <Arrow /></a>
				</div>
			</section>
		)
	}

	{
		others.length > 0 && (
			<section class="more-cabins" aria-labelledby="more-title">
				<div class="section-head">
					<h2 id="more-title" class="display display-block">More cabins</h2>
					<a class="text-link" href="/rooms">View all cabins <Arrow /></a>
				</div>
				<ul class="featured-grid" role="list">
					{others.map((o) => {
						const src = photoSrc(o.image, o.photo);
						return (
							<li>
								<a class="featured-card" href={cabinUrl(o)}>
									{src && <img src={src} alt={photoAlt(o.image, o.photo_alt, o.title)} width="488" height="192" loading="lazy" />}
									<span class="featured-name">
										{o.title} <Arrow />
									</span>
								</a>
							</li>
						);
					})}
				</ul>
			</section>
		)
	}
</Base>
