---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import {
	cabinKey,
	cabinUrl,
	getCabins,
	getLodge,
	isoDay,
	money,
	nightsBetween,
	photoAlt,
	photoSrc,
	plural,
	prettyDay,
	telHref,
	validIso,
} from "../lib/pinehaven";

const [cabinsResult, lodgeResult] = await Promise.all([getCabins(), getLodge()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cabinsResult.cacheHint);
	Astro.cache.set(lodgeResult.cacheHint);
}
const { lodge } = lodgeResult;

const cabins = cabinsResult.entries.map((e) => {
	const c = e.data;
	const interior = photoSrc(c.interior_image, c.interior_photo);
	return {
		key: cabinKey(c),
		title: c.title,
		price: c.price,
		max: Math.max(1, c.max_guests ?? 2),
		url: cabinUrl(c),
		photo: interior ?? photoSrc(c.image, c.photo) ?? "",
		alt: interior ? photoAlt(c.interior_image, c.interior_alt, c.title) : photoAlt(c.image, c.photo_alt, c.title),
	};
});
const maxGuests = Math.max(2, ...cabins.map((c) => c.max));

// Prefill from the homepage strip or a cabin page: ?checkin=&checkout=&guests=&cabin=
const q = Astro.url.searchParams;
const today = isoDay(0);
let checkIn = validIso(q.get("checkin")) ?? isoDay(7);
if (checkIn < today) checkIn = today;
let checkOut = validIso(q.get("checkout")) ?? "";
if (!checkOut || checkOut <= checkIn) {
	const d = new Date(`${checkIn}T00:00:00Z`);
	d.setUTCDate(d.getUTCDate() + 3);
	checkOut = d.toISOString().slice(0, 10);
}
const guestsParam = Number.parseInt(q.get("guests") ?? "", 10);
const guests = Number.isInteger(guestsParam) && guestsParam >= 1 && guestsParam <= maxGuests ? guestsParam : 2;
const selected = cabins.find((c) => c.key === q.get("cabin")) ?? cabins[0];
const nights = nightsBetween(checkIn, checkOut);
const minOut = (() => {
	const d = new Date(`${checkIn}T00:00:00Z`);
	d.setUTCDate(d.getUTCDate() + 1);
	return d.toISOString().slice(0, 10);
})();
const note =
	lodge.note ??
	"This is a request for availability. We’ll confirm current availability and share pricing and details with you directly.";
---

<Base
	title="Request a stay"
	description="Tell us a few details and we’ll check availability for your stay at Pinehaven."
	header="overlay"
	image="/images/hero-request.webp"
>
	<section class="hero hero-request" aria-labelledby="request-title">
		<img
			class="hero-photo"
			src="/images/hero-request.webp"
			alt="A timber cabin deck with a fire pit and lounge chairs, looking over a pine forest and mountain lake at sunset"
			width="1672"
			height="287"
			fetchpriority="high"
		/>
		<div class="hero-copy container">
			<p class="eyebrow eyebrow-light">Request a stay</p>
			<h1 id="request-title" class="display display-hero">Your cabin<br /> awaits.</h1>
			<p class="hero-lede">Tell us a few details and we’ll check<br class="br-wide" /> availability for your stay at Pinehaven.</p>
		</div>
	</section>

	<div class="request container">
		<section class="request-main" aria-labelledby="details-title">
			<h2 id="details-title" class="display display-form">Stay details</h2>
			<p class="request-lede">
				Share your preferred dates, cabin and group size. We’ll get back to you with availability and next steps.
			</p>

			<form
				class="stay-form"
				id="stay-form"
				aria-label="Stay request"
				data-email={lodge.email}
				data-cabins={JSON.stringify(cabins)}
				action={lodge.email ? `mailto:${lodge.email}?subject=${encodeURIComponent("Stay request")}` : undefined}
				method="post"
				enctype="text/plain"
			>
				<div class="field">
					<label for="r-in">Check in</label>
					<span class="control control-icon date-wrap">
						<Icon name="calendar" class="control-lead" />
						<input id="r-in" class="date-input" name="checkin" type="date" min={today} value={checkIn} required />
						<span class="date-pretty" aria-hidden="true">{prettyDay(checkIn)}</span>
						<Icon name="chevron" class="control-chevron" />
					</span>
				</div>
				<div class="field">
					<label for="r-out">Check out</label>
					<span class="control control-icon date-wrap">
						<Icon name="calendar" class="control-lead" />
						<input id="r-out" class="date-input" name="checkout" type="date" min={minOut} value={checkOut} required />
						<span class="date-pretty" aria-hidden="true">{prettyDay(checkOut)}</span>
						<Icon name="chevron" class="control-chevron" />
					</span>
				</div>
				<div class="field">
					<label for="r-guests">Guests</label>
					<span class="control control-icon">
						<Icon name="guests" class="control-lead" />
						<select id="r-guests" name="guests" required>
							{Array.from({ length: maxGuests }, (_, i) => i + 1).map((n) => (
								<option value={n} selected={n === guests}>{n} {n === 1 ? "guest" : "guests"}</option>
							))}
						</select>
						<Icon name="chevron" class="control-chevron" />
					</span>
				</div>
				<div class="field">
					<label for="r-cabin">Cabin</label>
					<span class="control control-icon">
						<Icon name="home" class="control-lead" />
						<select id="r-cabin" name="cabin" required>
							{cabins.length === 0 && <option value="">No cabins published</option>}
							{cabins.map((c) => <option value={c.key} selected={c.key === selected?.key}>{c.title}</option>)}
						</select>
						<Icon name="chevron" class="control-chevron" />
					</span>
				</div>

				<fieldset class="field-wide contact">
					<legend>Your contact information</legend>
					<div class="field">
						<label for="r-name">Full name</label>
						<input id="r-name" class="control" name="name" type="text" autocomplete="name" placeholder="Taylor Morgan" maxlength="120" required />
					</div>
					<div class="field">
						<label for="r-email">Email address</label>
						<input
							id="r-email"
							class="control"
							name="email"
							type="email"
							autocomplete="email"
							placeholder="taylor.morgan@example.com"
							maxlength="160"
							required
						/>
					</div>
				</fieldset>

				<div class="field field-wide">
					<label for="r-notes" class="label-lg">Special requests (optional)</label>
					<textarea
						id="r-notes"
						class="control"
						name="requests"
						rows="3"
						maxlength="2000"
						placeholder="Celebrating our anniversary — if possible, a cabin with lake views would be wonderful."></textarea>
				</div>

				<button class="btn btn-block field-wide" type="submit">Request availability <Arrow /></button>
				<p class="form-status field-wide" role="status" aria-live="polite" data-status>
					{
						lodge.email ? (
							<noscript>
								Without JavaScript, send your request by email to <a href={`mailto:${lodge.email}`}>{lodge.email}</a>.
							</noscript>
						) : (
							lodge.phone && (
								<>
									Online requests are not available right now. Please call <a href={telHref(lodge.phone)}>{lodge.phone}</a>.
								</>
							)
						)
					}
				</p>
			</form>
		</section>

		<aside class="summary" aria-labelledby="summary-title">
			<h2 id="summary-title" class="display display-form">Your stay summary</h2>
			{
				selected ? (
					<>
						{selected.photo && (
							<img class="summary-photo" src={selected.photo} alt={selected.alt} width="521" height="233" loading="lazy" data-sum-photo />
						)}
						<div class="summary-head">
							<p class="summary-name" data-sum-name>{selected.title}</p>
							<a class="text-link" href={selected.url} data-sum-link>
								View cabin detail <Arrow />
							</a>
						</div>
						<ul class="summary-rows" role="list">
							<li>
								<Icon name="calendar" />
								<span data-sum-dates>
									{prettyDay(checkIn)} <span aria-hidden="true">–</span><span class="sr-only">to</span> {prettyDay(checkOut)}
								</span>
								<span class="summary-end" data-sum-nights>{plural(nights, "night", "nights")}</span>
							</li>
							<li>
								<Icon name="guests" />
								<span data-sum-guests>{plural(guests, "guest", "guests")}</span>
							</li>
							<li>
								<Icon name="home" />
								<span data-sum-cabin>{selected.title}</span>
							</li>
						</ul>
						<dl class="summary-items">
							<div>
								<dt data-sum-rate>{money(selected.price)} × {plural(nights, "night", "nights")}</dt>
								<dd data-sum-subtotal>{money(selected.price * nights)}</dd>
							</div>
							<div class="summary-total">
								<dt>Indicative total</dt>
								<dd data-sum-total>{money(selected.price * nights)}</dd>
							</div>
						</dl>
						<p class="summary-note">
							{note} Starting nightly rates shown; taxes and any seasonal changes are confirmed in our reply.
						</p>
					</>
				) : (
					<p class="summary-note">{note}</p>
				)
			}
		</aside>
	</div>
</Base>

<script>
	// Live stay summary + request email. Nothing is sent by the site itself.
	type CabinOption = { key: string; title: string; price: number; max: number; url: string; photo: string; alt: string };
	const form = document.querySelector<HTMLFormElement>("#stay-form");
	const status = form?.querySelector<HTMLElement>("[data-status]");
	const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);

	if (form && status) {
		let cabins: CabinOption[] = [];
		try {
			cabins = JSON.parse(form.dataset.cabins ?? "[]") as CabinOption[];
		} catch {
			cabins = [];
		}
		const inEl = form.querySelector<HTMLInputElement>("#r-in");
		const outEl = form.querySelector<HTMLInputElement>("#r-out");
		const guestsEl = form.querySelector<HTMLSelectElement>("#r-guests");
		const cabinEl = form.querySelector<HTMLSelectElement>("#r-cabin");
		const money = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
		const day = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
		const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
		const toUtc = (iso: string) => Date.parse(`${iso}T00:00:00Z`);
		const setText = (sel: string, text: string) => {
			const el = $(sel);
			if (el) el.textContent = text;
		};

		const update = () => {
			if (!inEl || !outEl || !guestsEl || !cabinEl) return;
			const cabin = cabins.find((c) => c.key === cabinEl.value);
			if (inEl.value) {
				const next = new Date(toUtc(inEl.value));
				next.setUTCDate(next.getUTCDate() + 1);
				outEl.min = next.toISOString().slice(0, 10);
			}
			const nights = inEl.value && outEl.value ? Math.round((toUtc(outEl.value) - toUtc(inEl.value)) / 86_400_000) : 0;
			outEl.setCustomValidity(nights >= 1 || !outEl.value ? "" : "Check-out must be after check-in.");
			const guests = Number(guestsEl.value);
			guestsEl.setCustomValidity(
				cabin && guests > cabin.max ? `${cabin.title} sleeps up to ${plural(cabin.max, "guest", "guests")}.` : "",
			);

			setText(
				"[data-sum-dates]",
				inEl.value && outEl.value ? `${day.format(toUtc(inEl.value))} – ${day.format(toUtc(outEl.value))}` : "Choose your dates",
			);
			setText("[data-sum-nights]", nights >= 1 ? plural(nights, "night", "nights") : "");
			setText("[data-sum-guests]", plural(guests, "guest", "guests"));
			if (!cabin) return;
			setText("[data-sum-name]", cabin.title);
			setText("[data-sum-cabin]", cabin.title);
			const link = $<HTMLAnchorElement>("[data-sum-link]");
			if (link) link.href = cabin.url;
			const photo = $<HTMLImageElement>("[data-sum-photo]");
			if (photo && cabin.photo && photo.getAttribute("src") !== cabin.photo) {
				photo.src = cabin.photo;
				photo.alt = cabin.alt;
			}
			const n = Math.max(nights, 0);
			setText("[data-sum-rate]", `${money.format(cabin.price)} × ${plural(n, "night", "nights")}`);
			setText("[data-sum-subtotal]", money.format(cabin.price * n));
			setText("[data-sum-total]", money.format(cabin.price * n));
		};
		form.addEventListener("input", update);
		form.addEventListener("change", update);
		update();

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			update();
			if (!form.reportValidity()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online requests are not available right now. Please contact the lodge by phone.";
				return;
			}
			const data = new FormData(form);
			const get = (k: string) => String(data.get(k) ?? "").trim();
			const cabin = cabins.find((c) => c.key === get("cabin"));
			const nights = Math.round((toUtc(get("checkout")) - toUtc(get("checkin"))) / 86_400_000);
			const subject = `Stay request: ${cabin?.title ?? "Cabin"}, ${day.format(toUtc(get("checkin")))} – ${day.format(toUtc(get("checkout")))}`;
			const body = [
				"Hello,",
				"",
				"I would like to request a stay. Please let me know about availability.",
				"",
				`Cabin: ${cabin?.title ?? get("cabin")}`,
				`Check in: ${day.format(toUtc(get("checkin")))}`,
				`Check out: ${day.format(toUtc(get("checkout")))} (${plural(nights, "night", "nights")})`,
				`Guests: ${get("guests")}`,
				cabin ? `Indicative: ${money.format(cabin.price)} × ${plural(nights, "night", "nights")} = ${money.format(cabin.price * nights)}` : "",
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				`Special requests: ${get("requests") || "None"}`,
				"",
			].join("\n");
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			status.textContent =
				"Your email app should open with this request ready to send. Nothing is sent until you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	}
</script>
