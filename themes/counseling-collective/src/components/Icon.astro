---
interface Props {
	name?: string | null;
	size?: number;
}
const { name, size = 32 } = Astro.props;
const attrs = { width: size, height: size, viewBox: "0 0 32 32", fill: "none", stroke: "currentColor", "stroke-width": 1.3, "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true", focusable: "false" } as const;
---

{
	name === "people" ? (
		<svg {...attrs}>
			<circle cx="16" cy="9.500" r="3" />
			<circle cx="8" cy="12.500" r="2.500" />
			<circle cx="24" cy="12.500" r="2.500" />
			<path d="M10.500 22.500c0-3.600 2.400-6 5.500-6s5.500 2.400 5.500 6" />
			<path d="M3.500 21.500c0-2.800 1.800-4.800 4.500-4.800" />
			<path d="M28.500 21.500c0-2.800-1.800-4.800-4.500-4.800" />
		</svg>
	) : name === "leaf" ? (
		<svg {...attrs}>
			<path d="M7 25C5 15 11 7 25 7c.6 11-5.500 19-18 18Z" />
			<path d="M7.500 25.500C12 20 16 16.500 21 12.500" />
		</svg>
	) : name === "sun" ? (
		<svg {...attrs}>
			<circle cx="16" cy="16" r="5.200" />
			<path d="M16 4.500v3M16 24.500v3M4.500 16h3M24.500 16h3M7.900 7.900l2.100 2.100M22 22l2.100 2.100M7.900 24.100 10 22M22 10l2.100-2.100" />
		</svg>
	) : name === "family" ? (
		<svg {...attrs}>
			<circle cx="10" cy="10" r="3" />
			<circle cx="22" cy="10" r="3" />
			<circle cx="16" cy="17.500" r="2.400" />
			<path d="M4 23c0-3.500 2.600-5.800 6-5.800" />
			<path d="M28 23c0-3.500-2.600-5.800-6-5.800" />
			<path d="M11.500 27.500c0-3.200 2.100-5 4.500-5s4.500 1.800 4.500 5" />
		</svg>
	) : (
		<svg {...attrs}>
			<circle cx="16" cy="9" r="3" />
			<circle cx="9" cy="20" r="3" />
			<circle cx="23" cy="20" r="3" />
			<path d="M12 12.500 10.500 17M20 12.500 21.500 17M12.500 22.500h7" />
		</svg>
	)
}
