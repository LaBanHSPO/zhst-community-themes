---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { formatDate, getPosts, photoAlt, photoSrc, postHref } from "../../lib/collective";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.rewrite("/404");

const [allResult, settings] = await Promise.all([getPosts(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(post, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
const d = post.data;
const cover = photoSrc(d.image, d.photo);
const more = allResult.entries.filter((p) => p.data.id !== d.id).slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.excerpt}
	canonical={seo.canonical}
	image={seo.ogImage ?? cover}
	content={{ collection: "posts", id: d.id, slug }}
	current="/resources"
>
	<header class="article-head">
		<div class="wrap">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/resources">Resources</a>
				<span aria-hidden="true">/</span>
				{d.category && <a href={`/resources?category=${encodeURIComponent(d.category)}`}>{d.category}</a>}
			</nav>
			<p class="mono-label">{[d.category, formatDate(d.posted), d.read_time].filter(Boolean).join(" / ")}</p>
			<h1 class="display display-xl" {...post.edit.title}>{d.title}</h1>
			{d.excerpt && <p class="lede">{d.excerpt}</p>}
		</div>
	</header>
	{cover && <div class="wrap"><img class="article-cover" src={cover} alt={photoAlt(d.image, d.photo, d.title)} width="1200" height="520" fetchpriority="high" /></div>}
	<section class="article-body">
		<div class="wrap">
			<div class="prose">
				<PortableText value={d.content} />
				<p class="prose-note">This page is general information. It is not advice for your situation. If you are in crisis or at risk, contact your local emergency number or a crisis line now.</p>
			</div>
		</div>
	</section>
	{
		more.length > 0 && (
			<section class="section more-band" aria-labelledby="more-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="mono-label">Keep reading</p>
							<h2 id="more-title" class="section-title">More from our<br />counselors.</h2>
						</div>
						<a class="text-link" href="/resources"><span>All resources</span><Arrow /></a>
					</div>
					<ul class="more-list">
						{more.map((p) => (
							<li>
								<a href={postHref(p.data)}>
									<strong>{p.data.title}</strong>
									<span>{p.data.excerpt}</span>
									<em>{[p.data.category, formatDate(p.data.posted)].filter(Boolean).join(" / ")}</em>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}
</Base>
