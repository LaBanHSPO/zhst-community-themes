---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import { formatDate, getPosts, photoAlt, photoSrc, postHref } from "../../lib/collective";

const result = await getPosts();
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
const all = result.entries;
const categories = [...new Set(all.map((p) => p.data.category).filter((c): c is string => Boolean(c)))];
// ?category=<name> filters the list; an unknown value shows everything.
const wanted = Astro.url.searchParams.get("category");
const active = categories.find((c) => c.toLowerCase() === (wanted ?? "").toLowerCase());
const posts = active ? all.filter((p) => p.data.category === active) : all;
---

<Base title="Resources" description="Short, practical reads from the counselors at Counseling Collective on starting counseling, relationships and everyday wellbeing. Filter by category.">
	<PageHead eyebrow="Resources" title="Short reads, plain language." intro="Notes from our counselors on what to expect, how to talk about hard things and what to try on a bad day. They are general information, not advice for your situation." />
	<section class="listing" aria-label="Resources">
		<div class="wrap">
			{
				categories.length > 0 && (
					<nav class="filters" aria-label="Filter by category">
						<a href="/resources" aria-current={active ? undefined : "true"}>All</a>
						{categories.map((c) => <a href={`/resources?category=${encodeURIComponent(c)}`} aria-current={c === active ? "true" : undefined}>{c}</a>)}
					</nav>
				)
			}
			{
				posts.length > 0 ? (
					<ul class="post-grid">
						{posts.map((p, i) => {
							const src = photoSrc(p.data.image, p.data.photo);
							return (
								<li>
									<a class="post-card" href={postHref(p.data)}>
										{src && <img src={src} alt={photoAlt(p.data.image, p.data.photo, p.data.title)} width="520" height="340" loading={i < 3 ? "eager" : "lazy"} />}
										<span class="mono-label">{[p.data.category, formatDate(p.data.posted)].filter(Boolean).join(" / ")}</span>
										<strong class="post-title" {...p.edit.title}>{p.data.title}</strong>
										<span class="post-excerpt">{p.data.excerpt}</span>
									</a>
								</li>
							);
						})}
					</ul>
				) : (
					<p class="empty">Nothing in this category yet.</p>
				)
			}
		</div>
	</section>
</Base>
