---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import TeamCard from "../../components/TeamCard.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { firstName, getTeam, list, photoAlt, photoSrc } from "../../lib/collective";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: member, cacheHint } = await getEmDashEntry("team", slug);
if (!member) return Astro.rewrite("/404");

const [allResult, settings] = await Promise.all([getTeam(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(member, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
const d = member.data;
const src = photoSrc(d.image, d.photo);
const key = d.slug ?? d.id;
const others = allResult.entries.filter((m) => m.data.id !== d.id).slice(0, 4);
const hasBody = Boolean(d.content && d.content.length > 0);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.intro}
	canonical={seo.canonical}
	image={seo.ogImage ?? src}
	content={{ collection: "team", id: d.id, slug }}
	current="/team"
>
	<header class="detail-head">
		<div class="wrap">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/team">Our Team</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{d.title}</span>
			</nav>
			<div class="profile-grid">
				{src && <img class="profile-photo" src={src} alt={photoAlt(d.image, d.photo, d.title)} width="320" height="400" fetchpriority="high" />}
				<div class="profile-copy">
					<p class="mono-label">{d.role}</p>
					<h1 class="display display-xl" {...member.edit.title}>{d.title}</h1>
					{d.intro && <p class="lede">{d.intro}</p>}
					<dl class="facts">
						{list(d.focus).length > 0 && <div><dt>Focus areas</dt><dd>{list(d.focus).map((f, i) => <>{i > 0 && ", "}<a href={`/team?focus=${encodeURIComponent(f)}`}>{f}</a></>)}</dd></div>}
						{d.languages && <div><dt>Languages</dt><dd>{d.languages}</dd></div>}
						{d.meets && <div><dt>Meets clients</dt><dd>{d.meets}</dd></div>}
						{d.availability && <div><dt>Availability</dt><dd>{d.availability}</dd></div>}
						{d.registration && <div><dt>Registration details</dt><dd class="placeholder">{d.registration}</dd></div>}
					</dl>
					<p class="detail-actions">
						<a class="btn btn-green" href={`/contact?counselor=${encodeURIComponent(key)}`}>
							<span>Ask for {firstName(d.title)}</span><Arrow />
						</a>
					</p>
				</div>
			</div>
		</div>
	</header>

	{
		hasBody && (
			<section class="detail-body">
				<div class="wrap">
					<div class="prose">
						<PortableText value={d.content} />
					</div>
				</div>
			</section>
		)
	}

	{
		others.length > 0 && (
			<section class="section more-band" aria-labelledby="more-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="mono-label">Our team</p>
							<h2 id="more-title" class="section-title">Other counselors.</h2>
						</div>
						<a class="text-link" href="/team"><span>Everyone</span><Arrow /></a>
					</div>
					<ul class="counselor-row">
						{others.map((m) => <li><TeamCard member={m} /></li>)}
					</ul>
				</div>
			</section>
		)
	}
</Base>
