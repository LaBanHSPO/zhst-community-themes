---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import PageHead from "../../components/PageHead.astro";
import { getServices, photoSrc, serviceHref } from "../../lib/collective";

const { entries, cacheHint } = await getServices();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base
	title="Services"
	description="Individual, couples, family, life transitions and group counseling at Counseling Collective: who each is for, the format, how long a session lasts and a sample fee."
>
	<PageHead
		eyebrow="Services"
		title="Ways to work with us."
		intro="Five kinds of session. Each one says who it is for, how it runs, how long it lasts and what it costs. Fees are sample figures for you to replace."
	/>
	<section class="listing" aria-label="Services">
		<div class="wrap">
			<ol class="service-list">
				{
					entries.map((s, i) => {
						const src = photoSrc(s.data.image, s.data.photo);
						return (
							<li class="service-row">
								<a class="service-photo" href={serviceHref(s.data)} tabindex="-1" aria-hidden="true">
									{src && <img src={src} alt="" width="520" height="400" loading={i < 2 ? "eager" : "lazy"} />}
								</a>
								<div class="service-body">
									<p class="mono-label">{String(i + 1).padStart(2, "0")}</p>
									<h2 class="service-title" {...s.edit.title}><a href={serviceHref(s.data)}>{s.data.title}</a></h2>
									<p class="service-sum">{s.data.summary}</p>
									<dl class="facts">
										{s.data.who && <div><dt>Who it is for</dt><dd>{s.data.who}</dd></div>}
										{s.data.format && <div><dt>Format</dt><dd>{s.data.format}</dd></div>}
										{s.data.length && <div><dt>Length</dt><dd>{s.data.length}</dd></div>}
										{s.data.fee && <div><dt>Fee</dt><dd>{s.data.fee}</dd></div>}
									</dl>
									<a class="text-link" href={serviceHref(s.data)}><span>Read more</span><Arrow /></a>
								</div>
							</li>
						);
					})
				}
			</ol>
		</div>
	</section>
</Base>
