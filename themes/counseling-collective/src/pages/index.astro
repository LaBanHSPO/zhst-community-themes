---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import TeamCard from "../components/TeamCard.astro";
import ContactBand from "../components/ContactBand.astro";
import { formatDate, getPosts, getPractice, getServices, getSteps, getTeam, lines, photoAlt, photoSrc, postHref, serviceHref } from "../lib/collective";

const [servicesResult, teamResult, stepsResult, postsResult, practiceResult] = await Promise.all([
	getServices(),
	getTeam(),
	getSteps(),
	getPosts(),
	getPractice(),
]);
for (const r of [servicesResult, teamResult, stepsResult, postsResult, practiceResult]) {
	if (Astro.cache?.enabled) Astro.cache.set(r.cacheHint);
}
const services = (servicesResult.entries.some((s) => s.data.featured) ? servicesResult.entries.filter((s) => s.data.featured) : servicesResult.entries).slice(0, 3);
const team = teamResult.entries.slice(0, 4);
const steps = stepsResult.entries;
const posts = postsResult.entries.slice(0, 3);
const { practice } = practiceResult;
---

<Base
	title="Support, at your pace"
	description="Counseling Collective is a group practice of six counselors offering individual, couples, family and group counseling in person and online. Meet the team and ask for a first session."
>
	<section class="hero" aria-labelledby="hero-title">
		<img
			class="hero-photo"
			src="/images/hero-home.webp"
			alt="Five smiling counselors sit and stand around a round wooden coffee table in a warm lounge with shelves, plants and a framed print"
			width="1448"
			height="725"
			fetchpriority="high"
		/>
		<div class="hero-copy">
			<p class="hero-eyebrow">Real people. Brighter tomorrows.</p>
			<h1 id="hero-title" class="hero-title">Support,<br />at your pace.</h1>
			<p class="hero-sub">A collaborative counseling practice<br />for real life, wherever you are<br />on your journey.</p>
			<a class="btn btn-green" href="/team"><span>Find your counselor</span><Arrow /></a>
		</div>
		<p class="hero-note" aria-hidden="true"><span>A kinder<br />tomorrow together.</span></p>
		<p class="hero-safe">A<br />Safe space<br />A brighter<br />You</p>
	</section>

	<section class="help" aria-labelledby="help-title">
		<div class="help-inner">
			<div class="help-head">
				<p class="mono-label">How we help</p>
				<h2 id="help-title" class="help-title">A more supported<br />you is possible.</h2>
			</div>
			<ul class="help-cols">
				{
					services.map((s) => (
						<li>
							<a class="help-col" href={serviceHref(s.data)}>
								<span class="help-icon"><Icon name={s.data.icon} size={38} /></span>
								<h3 class="help-col-title" {...s.edit.title}>{s.data.title}</h3>
								<p class="help-col-text">{(lines(s.data.tile_text).length ? lines(s.data.tile_text) : [s.data.summary]).map((l, j) => (j === 0 ? <>{l}</> : <><br />{l}</>))}</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		team.length > 0 && (
			<section class="section meet" aria-labelledby="meet-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="mono-label">Our team</p>
							<h2 id="meet-title" class="section-title">Meet a few of our<br />counselors.</h2>
						</div>
						<a class="text-link" href="/team"><span>See everyone</span><Arrow /></a>
					</div>
					<ul class="counselor-row">
						{team.map((m, i) => <li><TeamCard member={m} eager={i < 2} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	{
		steps.length > 0 && (
			<section class="section matching" aria-labelledby="matching-title">
				<div class="wrap matching-grid">
					<figure class="matching-photo">
						<img src="/images/room-session.webp" alt={photoAlt(null, "/images/room-session.webp")} width="1448" height="1086" loading="lazy" />
					</figure>
					<div>
						<p class="mono-label">How matching works</p>
						<h2 id="matching-title" class="section-title">Three steps to a<br />first session.</h2>
						<ol class="steps">
							{steps.map((s, i) => (
								<li>
									<span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
									<div>
										<h3 class="step-title" {...s.edit.title}>{s.data.title}</h3>
										<p class="step-text">{s.data.text}</p>
									</div>
								</li>
							))}
						</ol>
					</div>
				</div>
			</section>
		)
	}

	<section class="section fees" aria-labelledby="fees-title">
		<div class="wrap fees-grid">
			<div>
				<p class="mono-label">Fees</p>
				<h2 id="fees-title" class="section-title">Clear fees, with<br />reduced-fee places.</h2>
			</div>
			<div class="fees-text">
				{practice.fees_note && <p>{practice.fees_note}</p>}
				{practice.sliding_note && <p>{practice.sliding_note}</p>}
				<p><a class="text-link" href="/services"><span>See all services</span><Arrow /></a></p>
			</div>
		</div>
	</section>

	{
		posts.length > 0 && (
			<section class="section reads" aria-labelledby="reads-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="mono-label">Resources</p>
							<h2 id="reads-title" class="section-title">Short reads from<br />our counselors.</h2>
						</div>
						<a class="text-link" href="/resources"><span>All resources</span><Arrow /></a>
					</div>
					<ul class="read-list">
						{posts.map((p) => {
							const src = photoSrc(p.data.image, p.data.photo);
							return (
								<li>
									<a class="read" href={postHref(p.data)}>
										{src && <img src={src} alt="" width="240" height="180" loading="lazy" />}
										<span>
											<span class="mono-label">{[p.data.category, formatDate(p.data.posted)].filter(Boolean).join(" / ")}</span>
											<strong class="read-title" {...p.edit.title}>{p.data.title}</strong>
											<span class="read-excerpt">{p.data.excerpt}</span>
										</span>
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	<ContactBand practice={practice} />
</Base>
