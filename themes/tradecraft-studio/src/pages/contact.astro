---
import { Icon } from "astro-iconset/components";
import { getEmDashEntry, getSeoMeta } from "emdash";
import MarketingBlocks from "../components/MarketingBlocks.astro";
import Base from "../layouts/Base.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "contact");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = page
	? getSeoMeta(page, {
			siteUrl: Astro.url.origin,
			path: "/contact",
			defaultDescription: "Have questions or want a demo? Talk directly with the Acme team.",
		})
	: null;

const contactMethods = [
	{
		icon: "ph:envelope",
		title: "General questions",
		description: "Ask about Acme, partnerships, or anything else.",
		label: "hello@acme.example",
		href: "mailto:hello@acme.example",
	},
	{
		icon: "ph:lifebuoy",
		title: "Customer support",
		description: "Get help with your account or an existing project.",
		label: "support@acme.example",
		href: "mailto:support@acme.example",
	},
	{
		icon: "ph:currency-dollar",
		title: "Sales",
		description: "Discuss plans, procurement, and your team's needs.",
		label: "sales@acme.example",
		href: "mailto:sales@acme.example",
	},
];
---

<Base
	title={seo?.title || "Contact"}
	pageTitle={page?.data.title || "Contact"}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	{page?.data.content && (
		<div {...page.edit.content}>
			<MarketingBlocks value={page.data.content} />
		</div>
	)}

	<section class="contact-section section" aria-labelledby="contact-heading">
		<div class="container">
			<header class="section-header contact-intro">
				<div>
					<p class="contact-eyebrow">Talk to a real person</p>
					<h2 class="section-headline" id="contact-heading">Choose the team that can help</h2>
				</div>
				<p class="section-subheadline">
					Email us directly and include any useful context. We will reply from the address you
					contacted.
				</p>
			</header>

			<ul class="contact-grid" role="list">
				{contactMethods.map((method, i) => (
					<li class:list={["contact-card", { "contact-card-ink": i === 0 }]}>
						<div class="icon-tile contact-icon">
							<Icon name={method.icon} aria-hidden="true" />
						</div>
						<h3>{method.title}</h3>
						<p>{method.description}</p>
						<a class="contact-link" href={method.href}>
							<span>{method.label}</span>
							<Icon name="ph:arrow-right" aria-hidden="true" />
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</Base>

<style>
	.contact-section {
		padding-bottom: var(--spacing-4xl);
	}

	.contact-eyebrow {
		margin-bottom: var(--spacing-sm);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-lg);
	}

	.contact-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: flex-start;
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.contact-card-ink {
		color: var(--color-on-ink);
		background: var(--color-ink);
		border-color: var(--color-ink);
	}

	.contact-card-ink :focus-visible {
		outline-color: var(--color-lime);
	}

	.contact-icon {
		margin-bottom: var(--spacing-xl);
	}

	.contact-card h3 {
		margin-bottom: var(--spacing-sm);
		font-size: var(--font-size-xl);
	}

	.contact-card p {
		flex: 1;
		margin-bottom: var(--spacing-xl);
		color: var(--color-muted);
	}

	.contact-card-ink p {
		color: var(--color-on-ink-muted);
	}

	.contact-link {
		display: inline-flex;
		max-width: 100%;
		min-height: 44px;
		align-items: center;
		gap: var(--spacing-sm);
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-color: var(--color-lime);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
		overflow-wrap: anywhere;
	}

	.contact-link :global(svg) {
		flex-shrink: 0;
		width: 1.1em;
		height: 1.1em;
	}

	@media (max-width: 900px) {
		.contact-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
