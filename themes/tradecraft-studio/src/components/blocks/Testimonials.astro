---
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type TestimonialsBlock = Extract<PageContentBlock, { _type: "marketing_testimonials" }>;
type Props = BlockComponentProps<TestimonialsBlock>;

const { value, index = 0 } = Astro.props;
const { anchor_id, headline, testimonials } = value;
const headingId = headline ? `testimonials-${anchor_id || index}-heading` : undefined;
---

<section class="testimonials section" id={anchor_id || undefined} aria-labelledby={headingId}>
	<div class="container">
		{headline && (
			<header class="section-header">
				<h2 class="section-headline" id={headingId}>{headline}</h2>
			</header>
		)}
		<ul class="testimonials-grid" role="list">
			{testimonials.map((testimonial) => (
				<li class="testimonial-card">
					<figure>
						<blockquote class="testimonial-quote">
							<p>{testimonial.quote}</p>
						</blockquote>
						<figcaption class="testimonial-author">
							{testimonial.avatar && (
								<Image
									image={testimonial.avatar}
									alt=""
									class="testimonial-avatar"
									width={48}
									height={48}
								/>
							)}
							<span class="testimonial-info">
								<span class="testimonial-name">{testimonial.author}</span>
								{(testimonial.role || testimonial.company) && (
									<span class="testimonial-role">
										{testimonial.role}
										{testimonial.role && testimonial.company && " · "}
										{testimonial.company}
									</span>
								)}
							</span>
						</figcaption>
					</figure>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.testimonials {
		background: var(--color-band);
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-lg);
	}

	.testimonial-card figure {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xl);
		height: 100%;
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-left: 4px solid var(--color-lime);
		border-radius: var(--radius);
	}

	.testimonial-quote {
		flex: 1;
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
		font-weight: 600;
		line-height: 1.45;
	}

	.testimonial-author {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
	}

	:global(.testimonial-avatar) {
		width: 48px;
		height: 48px;
		border-radius: var(--radius-full);
		object-fit: cover;
		filter: grayscale(1);
	}

	.testimonial-info {
		display: flex;
		flex-direction: column;
	}

	.testimonial-name {
		font-weight: 700;
		font-size: var(--font-size-sm);
	}

	.testimonial-role {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	@media (max-width: 960px) {
		.testimonials-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.testimonials-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
