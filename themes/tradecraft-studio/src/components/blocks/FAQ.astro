---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type FAQBlock = Extract<PageContentBlock, { _type: "marketing_faq" }>;
type Props = BlockComponentProps<FAQBlock>;

const { value, index = 0 } = Astro.props;
const { anchor_id, headline, items } = value;
const headingId = headline ? `faq-${anchor_id || index}-heading` : undefined;
const groupName = `faq-${anchor_id || index}`;
---

<section class="faq section" id={anchor_id || undefined} aria-labelledby={headingId}>
	<div class:list={["container", "faq-layout", { "faq-no-heading": !headline }]}>
		{headline && (
			<header class="faq-header">
				<h2 class="section-headline" id={headingId}>{headline}</h2>
			</header>
		)}
		<div class="faq-list">
			{items.map((item) => (
				<details class="faq-item" name={groupName}>
					<summary class="faq-question">
						<span>{item.question}</span>
						<span class="faq-icon" aria-hidden="true"></span>
					</summary>
					<div class="faq-answer">
						<p>{item.answer}</p>
					</div>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	.faq {
		border-top: 1px solid var(--color-border);
	}

	.faq-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		gap: var(--spacing-2xl);
		align-items: start;
	}

	.faq-no-heading {
		grid-template-columns: minmax(0, 1fr);
		max-width: 880px;
	}

	.faq-header {
		position: sticky;
		top: 104px;
	}

	.faq-header .section-headline::after {
		content: "";
		display: block;
		width: 48px;
		height: 5px;
		margin-top: var(--spacing-md);
		border-radius: 5px;
		background: var(--color-lime);
	}

	.faq-list {
		border-top: 1px solid var(--color-border);
	}

	.faq-item {
		border-bottom: 1px solid var(--color-border);
	}

	.faq-question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-md);
		min-height: 64px;
		padding: var(--spacing-md) 0;
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
		font-weight: 600;
		cursor: pointer;
		list-style: none;
	}

	.faq-question::-webkit-details-marker {
		display: none;
	}

	.faq-icon {
		position: relative;
		flex-shrink: 0;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--color-surface-2);
		transition: background var(--transition-base);
	}

	.faq-icon::before,
	.faq-icon::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		width: 12px;
		height: 2px;
		margin: -1px 0 0 -6px;
		background: var(--color-text);
		transition: transform var(--transition-base);
	}

	.faq-icon::after {
		transform: rotate(90deg);
	}

	.faq-item[open] .faq-icon {
		background: var(--color-lime);
	}

	.faq-item[open] .faq-icon::before,
	.faq-item[open] .faq-icon::after {
		background: var(--color-on-brand);
	}

	.faq-item[open] .faq-icon::after {
		transform: rotate(0deg);
	}

	.faq-answer {
		padding: 0 var(--spacing-3xl) var(--spacing-lg) 0;
	}

	.faq-answer p {
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
	}

	@media (max-width: 820px) {
		.faq-layout {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--spacing-lg);
		}

		.faq-header {
			position: static;
		}

		.faq-question {
			font-size: var(--font-size-base);
		}

		.faq-answer {
			padding-right: 0;
		}
	}
</style>
