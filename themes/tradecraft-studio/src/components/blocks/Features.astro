---
import { Icon } from "astro-iconset/components";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import TileArt from "../TileArt.astro";

type FeaturesBlock = Extract<PageContentBlock, { _type: "marketing_features" }>;
type Props = BlockComponentProps<FeaturesBlock>;

const { value, index = 0 } = Astro.props;
const { anchor_id, headline, subheadline, features } = value;

const iconMap: Record<string, string> = {
	zap: "ph:lightning",
	shield: "ph:shield-check",
	users: "ph:users-three",
	chart: "ph:chart-bar",
	code: "ph:code",
	globe: "ph:globe",
	heart: "ph:heart",
	star: "ph:star",
	check: "ph:check-circle",
	lock: "ph:lock",
	clock: "ph:clock",
	cloud: "ph:cloud",
};

// Two, three or four cards per row on wide screens, following the item count.
const columns = features.length === 2 || features.length === 3 ? features.length : 4;
const headingId = `features-${anchor_id || index}-heading`;
---

<section class="features section" id={anchor_id || undefined} aria-labelledby={headingId}>
	<div class="container">
		<header class="section-header">
			<h2 class="section-headline" id={headingId}>{headline}</h2>
			{subheadline && <p class="section-subheadline">{subheadline}</p>}
		</header>
		<ul class="features-grid" role="list" style={`--cols: ${columns}; --visual-ratio: ${columns === 4 ? "1 / 1" : "16 / 10"}`}>
			{features.map((feature, i) => (
				<li class="feature-card">
					<div class="feature-visual">
						<TileArt variant={i + index} />
					</div>
					<div class="feature-body">
						<div class="feature-text">
							<h3 class="feature-title">{feature.title}</h3>
							<p class="feature-description">{feature.description}</p>
						</div>
						<span class="feature-icon" aria-hidden="true">
							<Icon name={iconMap[feature.icon] || "ph:sparkle"} />
						</span>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.features-grid {
		display: grid;
		grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
		gap: var(--spacing-lg);
	}

	.feature-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		transition:
			transform var(--transition-base),
			box-shadow var(--transition-base);
	}

	.feature-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-lg);
	}

	.feature-visual {
		aspect-ratio: var(--visual-ratio, 1 / 1);
		overflow: hidden;
		background: var(--color-ink);
	}

	.feature-visual :global(.tile-art) {
		transition: transform var(--transition-slow);
	}

	.feature-card:hover .feature-visual :global(.tile-art) {
		transform: scale(1.04);
	}

	.feature-body {
		flex: 1;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding: var(--spacing-md) var(--spacing-lg) var(--spacing-lg);
	}

	.feature-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-base);
		font-weight: 700;
		letter-spacing: -0.01em;
		margin-bottom: 0.2rem;
	}

	.feature-description {
		font-size: var(--font-size-sm);
		line-height: 1.5;
		color: var(--color-muted);
	}

	.feature-icon {
		display: inline-flex;
		flex-shrink: 0;
		margin-top: 2px;
		font-size: 1.25rem;
		color: var(--color-text);
	}

	@media (max-width: 1100px) {
		.features-grid {
			grid-template-columns: repeat(min(var(--cols, 4), 3), minmax(0, 1fr));
		}
	}

	@media (max-width: 820px) {
		.features-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Phones: a stacked list of compact rows */
	@media (max-width: 600px) {
		.features-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-sm);
		}

		.feature-card {
			flex-direction: row;
			align-items: stretch;
			background: var(--color-surface-2);
			border-color: transparent;
		}

		.feature-visual {
			flex: 0 0 88px;
			aspect-ratio: auto;
			min-height: 88px;
		}

		.feature-body {
			align-items: center;
			padding: var(--spacing-md);
		}

		.feature-description {
			font-size: var(--font-size-xs);
		}
	}
</style>
