---
/*
 * Original decorative artwork for the studio hero: graphite blocks around an
 * acid-lime disc. Colours come from CSS custom properties so the piece follows
 * light and dark mode. Purely decorative (aria-hidden).
 */
interface Props {
	class?: string;
	variant?: "full" | "compact";
}

const { class: className, variant = "full" } = Astro.props;
const uid = `art-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
	class:list={["hero-art", `hero-art-${variant}`, className]}
	viewBox="0 0 800 640"
	preserveAspectRatio="xMidYMid slice"
	aria-hidden="true"
	focusable="false"
>
	<defs>
		<linearGradient id={`${uid}-wall`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="var(--art-wall-a)" />
			<stop offset="1" stop-color="var(--art-wall-b)" />
		</linearGradient>
		<linearGradient id={`${uid}-top`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="var(--art-top-a)" />
			<stop offset="1" stop-color="var(--art-top-b)" />
		</linearGradient>
		<linearGradient id={`${uid}-left`} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#3b3e3f" />
			<stop offset="1" stop-color="#1f2122" />
		</linearGradient>
		<linearGradient id={`${uid}-right`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#2a2c2d" />
			<stop offset="1" stop-color="#121314" />
		</linearGradient>
		<linearGradient id={`${uid}-slab`} x1="0" y1="0" x2="1" y2="0">
			<stop offset="0" stop-color="#2e3132" />
			<stop offset="1" stop-color="#18191a" />
		</linearGradient>
		<radialGradient id={`${uid}-lime`} cx="0.35" cy="0.35" r="0.75">
			<stop offset="0" stop-color="#e4ff7a" />
			<stop offset="0.55" stop-color="#c8f03c" />
			<stop offset="1" stop-color="#9fcf12" />
		</radialGradient>
		<linearGradient id={`${uid}-glow`} x1="0" y1="0" x2="1" y2="0">
			<stop offset="0" stop-color="#c8f03c" stop-opacity="0.55" />
			<stop offset="1" stop-color="#c8f03c" stop-opacity="0" />
		</linearGradient>
		<filter id={`${uid}-grain`} x="0" y="0" width="100%" height="100%">
			<feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="7" result="noise" />
			<feColorMatrix in="noise" type="matrix" values="0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0.18 0" />
			<feComposite in2="SourceGraphic" operator="in" />
		</filter>
	</defs>

	<!-- Wall -->
	<rect width="800" height="640" fill={`url(#${uid}-wall)`} />
	<rect width="800" height="640" fill="#000" filter={`url(#${uid}-grain)`} opacity="0.5" />

	<!-- Back slab -->
	<polygon points="180,0 470,0 470,250 180,372" fill={`url(#${uid}-slab)`} />
	<polygon points="180,0 470,0 470,250 180,372" fill="#000" filter={`url(#${uid}-grain)`} opacity="0.35" />

	<!-- Lime disc -->
	<circle cx="560" cy="270" r="205" fill={`url(#${uid}-lime)`} />


	<!-- Front block: top, left, right faces -->
	<polygon points="70,402 340,286 640,402 370,520" fill={`url(#${uid}-top)`} />
	<polygon points="70,402 340,286 640,402 370,520" fill="#000" filter={`url(#${uid}-grain)`} opacity="0.55" />
	<polygon points="70,402 370,520 370,640 70,640" fill={`url(#${uid}-left)`} />
	<polygon points="370,520 640,402 640,640 370,640" fill={`url(#${uid}-right)`} />
	<polygon points="70,402 370,520 370,640 70,640" fill="#000" filter={`url(#${uid}-grain)`} opacity="0.45" />

	<!-- Lime light spilling onto the top face -->
	<polygon points="340,286 520,354 470,374 300,304" fill={`url(#${uid}-glow)`} />
	<line x1="370" y1="520" x2="370" y2="640" stroke="#c8f03c" stroke-opacity="0.35" stroke-width="2" />
</svg>

<style>
	.hero-art {
		--art-wall-a: light-dark(#e9e9e6, #2a2d2d);
		--art-wall-b: light-dark(#c9cac6, #1a1c1c);
		--art-top-a: light-dark(#9a9c99, #4a4d4d);
		--art-top-b: light-dark(#6f7270, #353838);
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
