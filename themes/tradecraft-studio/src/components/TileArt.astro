---
/*
 * Original decorative tile artwork for catalog cards: graphite forms with an
 * acid-lime accent. Six compositions, chosen by `variant` (any integer).
 * Purely decorative (aria-hidden).
 */
interface Props {
	variant?: number;
	class?: string;
}

const { variant = 0, class: className } = Astro.props;
const v = ((variant % 6) + 6) % 6;
const uid = `tile-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
	class:list={["tile-art", className]}
	viewBox="0 0 400 400"
	preserveAspectRatio="xMidYMid slice"
	aria-hidden="true"
	focusable="false"
>
	<defs>
		<linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color={v % 2 === 0 ? "#1e2021" : "#d6d7d3"} />
			<stop offset="1" stop-color={v % 2 === 0 ? "#0f1010" : "#b9bab6"} />
		</linearGradient>
		<linearGradient id={`${uid}-lime`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#e4ff7a" />
			<stop offset="1" stop-color="#a6d417" />
		</linearGradient>
		<linearGradient id={`${uid}-glass`} x1="0" y1="0" x2="1" y2="0">
			<stop offset="0" stop-color="#ffffff" stop-opacity="0.22" />
			<stop offset="1" stop-color="#ffffff" stop-opacity="0.04" />
		</linearGradient>
		<linearGradient id={`${uid}-dark`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#3a3d3e" />
			<stop offset="1" stop-color="#141516" />
		</linearGradient>
		<radialGradient id={`${uid}-glow`} cx="0.5" cy="0.8" r="0.6">
			<stop offset="0" stop-color="#c8f03c" stop-opacity="0.9" />
			<stop offset="1" stop-color="#c8f03c" stop-opacity="0" />
		</radialGradient>
	</defs>
	<rect width="400" height="400" fill={`url(#${uid}-bg)`} />

	{v === 0 && (
		<g>
			<polygon points="110,120 230,70 230,330 110,380" fill={`url(#${uid}-glass)`} stroke="#ffffff" stroke-opacity="0.25" />
			<polygon points="160,110 280,60 280,320 160,370" fill={`url(#${uid}-lime)`} opacity="0.85" />
			<polygon points="210,100 330,50 330,310 210,360" fill={`url(#${uid}-glass)`} stroke="#ffffff" stroke-opacity="0.3" />
			<polygon points="250,90 360,46 360,300 250,344" fill={`url(#${uid}-glass)`} stroke="#ffffff" stroke-opacity="0.2" />
		</g>
	)}

	{v === 1 && (
		<g>
			<rect x="120" y="40" width="190" height="360" rx="34" transform="rotate(24 215 220)" fill={`url(#${uid}-dark)`} />
			<rect x="132" y="54" width="166" height="332" rx="26" transform="rotate(24 215 220)" fill="#101112" />
			<ellipse cx="230" cy="330" rx="150" ry="90" fill={`url(#${uid}-glow)`} />
		</g>
	)}

	{v === 2 && (
		<g>
			<ellipse cx="170" cy="250" rx="110" ry="62" fill={`url(#${uid}-lime)`} />
			<ellipse cx="220" cy="262" rx="110" ry="62" fill="#1a1b1c" />
			<ellipse cx="220" cy="246" rx="110" ry="62" fill="#2c2f30" />
			<ellipse cx="236" cy="196" rx="82" ry="46" fill={`url(#${uid}-lime)`} />
			<ellipse cx="236" cy="184" rx="82" ry="46" fill="#3a3d3e" />
			<ellipse cx="226" cy="140" rx="60" ry="36" fill="#4a4d4e" />
		</g>
	)}

	{v === 3 && (
		<g>
			<polygon points="60,250 240,120 360,220 180,350" fill="#f1f1ee" />
			<polygon points="180,350 360,220 360,236 180,366" fill="#9c9e9a" />
			<polygon points="200,250 300,200 290,290" fill={`url(#${uid}-lime)`} />
			<polygon points="140,170 250,90 300,135 190,215" fill="#1d1f20" />
		</g>
	)}

	{v === 4 && (
		<g>
			<circle cx="250" cy="170" r="110" fill={`url(#${uid}-lime)`} />
			<polygon points="60,250 200,190 340,250 200,310" fill="#5b5e5c" />
			<polygon points="60,250 200,310 200,400 60,400" fill="#2a2c2d" />
			<polygon points="200,310 340,250 340,400 200,400" fill="#161718" />
		</g>
	)}

	{v === 5 && (
		<g>
			<rect x="70" y="70" width="120" height="120" rx="18" fill="#2a2c2d" />
			<rect x="210" y="70" width="120" height="120" rx="60" fill={`url(#${uid}-lime)`} />
			<rect x="70" y="210" width="120" height="120" rx="60" fill="#3a3d3e" />
			<rect x="210" y="210" width="120" height="120" rx="18" fill="#1a1b1c" />
		</g>
	)}
</svg>

<style>
	.tile-art {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
