							"anchor_id": "products",
							"headline": "Featured products",
							"subheadline": "Templates, kits and tools made in the studio. Ask about any of them and we will tell you what fits your project.",
							"features": [
								{
									"icon": "code",
									"title": "Core UI",
									"description": "Web · Template"
								},
								{
									"icon": "globe",
									"title": "Studio Kit",
									"description": "Mobile · Template"
								},
								{
									"icon": "star",
									"title": "Mono Icons",
									"description": "Tools · Icons"
								},
								{
									"icon": "zap",
									"title": "Launch Pad",
									"description": "Web · Template"
								}
							]
						},
						{
							"_type": "marketing_features",
							"_version": 1,
							"_key": "process",
							"anchor_id": "process",
							"headline": "How we work",
							"subheadline": "One small team takes an idea from the first sketch to a product people can use.",
							"features": [
								{
									"icon": "chart",
									"title": "Build",
									"description": "We scope the smallest useful version together, then build it in short, reviewable steps."
								},
								{
									"icon": "heart",
									"title": "Design",
									"description": "Interfaces, type and motion are designed alongside the code, so nothing is lost in handoff."
								},
								{
									"icon": "cloud",
									"title": "Launch",
									"description": "We help you publish, watch how it is used, and plan the next round of improvements."
								}
							]
						},
						{
							"_type": "marketing_faq",
							"_version": 1,
							"_key": "faq",
							"anchor_id": "faq",
							"headline": "Questions",
							"items": [
								{
									"question": "Can I use a product as the start of my own project?",
									"answer": "Yes. Each template and kit is a starting point. Tell us what you are building and we will suggest the closest fit."
								},
								{
									"question": "Do you take custom projects?",
									"answer": "Yes. Send an inquiry with a short description of the idea, your timeline and any constraints, and we will reply with next steps."
								},
								{
									"question": "What do you need from us to start?",
									"answer": "A clear goal, the people who will use the product, and someone on your side who can make decisions quickly."
								},
								{
									"question": "How do we stay in touch during a project?",
									"answer": "You get regular reviews of working software, not slide decks, plus one shared place for questions and decisions."
								}
							]
						}
					]
				}
			},
			{
				"id": "pricing",
				"slug": "pricing",
				"status": "published",
				"data": {
					"title": "Pricing",
					"content": [
						{
							"_type": "marketing_hero",
							"_version": 1,
							"_key": "pricing-hero",
							"headline": "Simple, transparent pricing",
							"subheadline": "Pick a starting point. Every engagement begins with a short conversation about your idea.",
							"centered": true
						},
						{
							"_type": "marketing_pricing",
							"_version": 1,
							"_key": "pricing-plans",
							"plans": [
								{
									"name": "Template",
									"price": "$0",
									"period": "/project",
									"description": "Start from a studio product",
									"features": "Any featured template or kit\nSetup notes\nCommunity questions",
									"cta_label": "Inquire",
									"cta_url": "/contact"
								},
								{
									"name": "Studio",
									"price": "$2,400",
									"period": "/sprint",
									"description": "A focused two-week build",
									"features": "Scoping session\nDesign and build in one team\nWeekly reviews\nLaunch checklist",
									"cta_label": "Inquire",
									"cta_url": "/contact",
									"highlighted": true
								},
								{
									"name": "Partner",
									"price": "Custom",
									"description": "An ongoing product team",
									"features": "Everything in Studio\nRoadmap planning\nOngoing improvements\nShared decision log",
									"cta_label": "Contact us",
									"cta_url": "/contact"
								}
							]
						},
						{
							"_type": "marketing_faq",
							"_version": 1,
							"_key": "pricing-faq",
							"headline": "Pricing FAQ",
							"items": [
								{
									"question": "Can I change plans later?",
									"answer": "Yes. Many projects start from a template and grow into a sprint or an ongoing partnership."
								},
								{
									"question": "How do you invoice?",
									"answer": "Sprints are invoiced at the start of each sprint. Partner work is invoiced monthly."
								},
								{
									"question": "What if my idea does not fit a plan?",
									"answer": "Send an inquiry anyway. We will tell you honestly whether we are the right studio for it."
								}
							]
						}
					]
				}
