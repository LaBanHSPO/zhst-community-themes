						{
							"_type": "marketing_hero",
							"_version": 1,
							"_key": "hero",
							"headline": "Digital products for ideas",
							"subheadline": "Build. Design. Launch.",
							"primary_cta_label": "Browse products",
							"primary_cta_url": "/#products",
							"secondary_cta_label": "Inquire",
