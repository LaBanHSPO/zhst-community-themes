---
interface Props {
	name: "leaf" | "bowl" | "mountains";
	size?: number;
}
const { name, size = 44 } = Astro.props;
const attrs = { width: Math.round((size * 56) / 48), height: size, viewBox: "0 0 56 48", fill: "none", stroke: "currentColor", "stroke-width": 1.2, "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true", focusable: "false" } as const;
---

{
	name === "leaf" ? (
		<svg {...attrs}>
			<path d="M16 42C11 26 20 10 44 7c1 22-8 34-28 35Z" />
			<path d="M15 43C24 32 33 21 41 12" />
		</svg>
	) : name === "bowl" ? (
		<svg {...attrs}>
			<path d="M3 18c0-3 11-5 25-5s25 2 25 5c0 14-10 24-25 24S3 32 3 18Z" />
			<path d="M3 18c0 3 11 5 25 5s25-2 25-5" />
		</svg>
	) : (
		<svg {...attrs}>
			<path d="M3 42L18 18l9 14" />
			<path d="M17 42L36 8l17 34H17" />
		</svg>
	)
}
