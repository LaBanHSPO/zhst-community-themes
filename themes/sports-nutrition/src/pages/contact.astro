---
import Base from "../layouts/Base.astro";
import { getPlans, getStudio, hoursRows, lines, telHref } from "../lib/nutri";

const [{ studio, cacheHint }, plansResult] = await Promise.all([getStudio(), getPlans()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(plansResult.cacheHint);
}

const interests = [
	{ value: "coaching", label: "Coaching" },
	{ value: "meal-prep", label: "Meal prep" },
	{ value: "other", label: "Something else" },
];
// ?interest=coaching|meal-prep|other pre-selects the interest; ?plan=<slug> pre-selects a plan.
const interest = interests.find((o) => o.value === Astro.url.searchParams.get("interest"));
const planOptions = [
	...plansResult.entries.map((p) => ({ value: p.data.slug ?? p.data.id, label: p.data.title })),
	{ value: "not-sure", label: "Not sure yet" },
];
const plan = planOptions.find((o) => o.value === Astro.url.searchParams.get("plan"));
const rows = hoursRows(studio.hours);
const address = lines(studio.address);
---

<Base title="Get Started" description="Tell Nutriforce what you train for: choose coaching, meal prep or something else, add your sport and goals, and your email app opens with the message ready to send. Phone, email, pickup address and hours are always listed.">
	<div class="contact">
		<section class="contact-panel" aria-labelledby="contact-title">
			<p class="mono-label">Get started</p>
			<h1 id="contact-title" class="display display-xl">Tell us what you train for.</h1>
			<p class="lede">Send your sport, your usual week and what you would like to change. We reply within two working days.</p>

			<div class="notice" role="note">
				<strong>Requests only.</strong>{" "}
				{studio.form_note ?? "Please leave out medical details and test results. Tell us about allergies and foods you avoid in the message box."}
			</div>

			<form
				class="contact-form"
				data-contact-form
				data-email={studio.email}
				action={studio.email ? `mailto:${studio.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field">
						<label for="c-name">Your name</label>
						<input id="c-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="c-name"></span>
					</div>
					<div class="field">
						<label for="c-email">Email</label>
						<input id="c-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="c-email"></span>
					</div>
					<div class="field">
						<label for="c-phone">Phone <span class="optional">(optional)</span></label>
						<input id="c-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field">
						<label for="c-interest">What are you interested in?</label>
						<select id="c-interest" name="interest" required>
							<option value="" selected={!interest}>Choose an option</option>
							{interests.map((o) => <option value={o.value} selected={interest?.value === o.value}>{o.label}</option>)}
						</select>
						<span class="field-error" data-error-for="c-interest"></span>
					</div>
					<div class="field" data-plan-field>
						<label for="c-plan">Which coaching plan? <span class="optional">(optional)</span></label>
						<select id="c-plan" name="plan">
							<option value="" selected={!plan}>No preference</option>
							{planOptions.map((o) => <option value={o.value} selected={plan?.value === o.value}>{o.label}</option>)}
						</select>
					</div>
					<div class="field">
						<label for="c-sport">Your sport or activity</label>
						<input id="c-sport" name="sport" type="text" placeholder="For example: half marathon, rugby, gym" required />
						<span class="field-error" data-error-for="c-sport"></span>
					</div>
					<div class="field full">
						<label for="c-goals">Your goals</label>
						<textarea id="c-goals" name="goals" rows="4" maxlength="600" placeholder="For example: eat better on long training days, or cook ahead for a busy week." required></textarea>
						<span class="field-error" data-error-for="c-goals"></span>
					</div>
					<div class="field full">
						<label for="c-message">Allergies, foods you avoid, anything else <span class="optional">(optional)</span></label>
						<textarea id="c-message" name="message" rows="3" maxlength="400" placeholder="Please leave out medical details and test results."></textarea>
					</div>
				</div>
				<button class="btn btn-block" type="submit"><span>Send your details</span></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{studio.email && <>Write to <a href={`mailto:${studio.email}`}>{studio.email}</a> with your name, your sport and your goals.</>}
					</noscript>
				</p>
			</form>
		</section>

		<aside class="contact-aside">
			<img src="/images/bowl-side.webp" alt="A bowl of grilled chicken, quinoa, avocado, rocket, red cabbage and tomato on a stone ledge, with a mountain behind" width="900" height="600" />
			<div class="contact-details">
				<h2>Reach us</h2>
				<p class="detail-line">
					{studio.phone && <a href={telHref(studio.phone)}>{studio.phone}</a>}
					{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}
					{address.length > 0 && <span>{address.join(", ")}</span>}
				</p>
				<h3>Hours</h3>
				<dl class="hours">
					{rows.map((r) => <div><dt>{r.day}</dt><dd>{r.time}</dd></div>)}
				</dl>
				{studio.hours_note && <p class="small">{studio.hours_note}</p>}
			</div>
		</aside>
	</div>
</Base>

<script>
	// Compose an email to the studio; nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input[required], select[required], textarea[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online requests are not available right now. Please call instead.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const label = (id: string) => form.querySelector<HTMLSelectElement>(id)?.selectedOptions[0]?.textContent ?? "";
			const subject = `Get started: ${label("#c-interest")}, ${get("name")}`;
			const body = [
				"Hello,",
				"",
				"I would like to get started.",
				"",
				`Interested in: ${label("#c-interest")}`,
				get("plan") ? `Coaching plan: ${label("#c-plan")}` : "",
				`Sport or activity: ${get("sport")}`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				"",
				"Goals:",
				get("goals"),
				get("message") ? `Allergies and other notes: ${get("message")}` : "",
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body.join("\n"))}`;
			status.textContent =
				"Your email app should open with this message ready to send. It is only sent when you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
