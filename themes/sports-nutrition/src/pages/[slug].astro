---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import PageHead from "../components/PageHead.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getStudio, hoursRows, telHref } from "../lib/nutri";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) return Astro.rewrite("/404");
const { studio, cacheHint: studioHint } = await getStudio();
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(studioHint);
}

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
const rows = hoursRows(studio.hours);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? page.data.intro}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<PageHead eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro} edit={{ ...page.edit.title }} />
	<div class="page-body">
		<div class="wrap page-body-grid">
			<div>
				<div class="prose">
					<PortableText value={page.data.content} />
				</div>
				<p class="page-cta"><a class="btn" href="/contact"><span>Get Started</span><Arrow /></a></p>
			</div>
			<aside class="side-card" aria-labelledby="aside-title">
				<h2 id="aside-title" class="side-title">Hours and contact</h2>
				<dl class="hours">
					{rows.map((r) => <div><dt>{r.day}</dt><dd>{r.time}</dd></div>)}
				</dl>
				{studio.phone && <p>Phone: <a href={telHref(studio.phone)}>{studio.phone}</a></p>}
				{studio.email && <p>Email: <a href={`mailto:${studio.email}`}>{studio.email}</a></p>}
			</aside>
		</div>
	</div>
</Base>
