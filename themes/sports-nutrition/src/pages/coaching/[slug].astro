---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getPlans, lines, photoAlt, photoSrc, planHref } from "../../lib/nutri";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: plan, cacheHint } = await getEmDashEntry("plans", slug);
if (!plan) return Astro.rewrite("/404");

const [allResult, settings] = await Promise.all([getPlans(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(plan, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
const d = plan.data;
const cover = photoSrc(d.image, d.photo);
const hasBody = Boolean(d.content && d.content.length > 0);
const others = allResult.entries.filter((p) => p.data.id !== d.id).slice(0, 3);
const startHref = `/contact?interest=coaching&plan=${encodeURIComponent(d.slug ?? d.id)}`;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary}
	canonical={seo.canonical}
	image={seo.ogImage ?? cover}
	content={{ collection: "plans", id: d.id, slug }}
	current="/coaching"
>
	<header class="detail-head">
		<div class="wrap">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/coaching">Coaching</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{d.title}</span>
			</nav>
			<div class="detail-grid">
				<div class="detail-copy">
					<p class="mono-label">Coaching plan</p>
					<h1 class="display display-xl" {...plan.edit.title}>{d.title}</h1>
					<p class="lede">{d.summary}</p>
					<dl class="facts">
						{d.who_for && <div><dt>Who it is for</dt><dd>{d.who_for}</dd></div>}
						{d.format && <div><dt>Format</dt><dd>{d.format}</dd></div>}
						{d.check_ins && <div><dt>Check-ins</dt><dd>{d.check_ins}</dd></div>}
						{d.price && <div><dt>Price</dt><dd>{d.price}</dd></div>}
					</dl>
					<p class="detail-actions">
						<a class="btn" href={startHref}><span>Get Started</span><Arrow /></a>
					</p>
				</div>
				{cover && <img class="detail-cover" src={cover} alt={photoAlt(d.image, d.photo, d.title)} width="800" height="690" fetchpriority="high" />}
			</div>
		</div>
	</header>

	<section class="detail-body">
		<div class="wrap detail-body-grid">
			<div class="prose">
				{hasBody ? <PortableText value={d.content} /> : <p>{d.summary}</p>}
			</div>
			<aside class="side-stack">
				{
					lines(d.includes).length > 0 && (
						<div class="side-card">
							<h2 class="side-title">What is included</h2>
							<ul class="check-list">
								{lines(d.includes).map((i) => <li>{i}</li>)}
							</ul>
						</div>
					)
				}
				<div class="side-card side-card-dark">
					<h2 class="side-title">How to start</h2>
					<p>Send your sport and goals with the Get Started form. We reply within two working days to set up a 20-minute intro call.</p>
					<p class="side-action"><a class="btn btn-light" href={startHref}><span>Get Started</span><Arrow /></a></p>
				</div>
			</aside>
		</div>
	</section>

	{
		others.length > 0 && (
			<section class="more-band" aria-labelledby="more-title">
				<div class="wrap">
					<div class="section-head">
						<div>
							<p class="mono-label">More plans</p>
							<h2 id="more-title" class="section-title">Other ways to<br />work with us.</h2>
						</div>
						<a class="text-link" href="/coaching"><span>All plans</span><Arrow /></a>
					</div>
					<ul class="more-list">
						{others.map((p) => (
							<li>
								<a href={planHref(p.data)}>
									<strong>{p.data.title}</strong>
									<span>{p.data.summary}</span>
									<em>{p.data.price}</em>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}
</Base>
