---
interface Props {
	name?: string | null;
}
const { name } = Astro.props;
---

{
	name === "people" ? (
		<svg width="44" height="40" viewBox="0 0 44 40" fill="none" stroke="currentColor" stroke-width="1.700" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
			<circle cx="22" cy="9" r="5" />
			<circle cx="8.500" cy="17" r="4.200" />
			<circle cx="35.500" cy="17" r="4.200" />
			<path d="M12.500 33c0-5.500 4-9 9.500-9s9.500 3.500 9.500 9" />
			<path d="M2 32c0-4.500 2.800-7.500 6.500-7.500M42 32c0-4.500-2.800-7.500-6.500-7.500" />
		</svg>
	) : name === "bars" ? (
		<svg width="34" height="36" viewBox="0 0 34 36" fill="none" stroke="currentColor" stroke-width="1.800" stroke-linejoin="round" aria-hidden="true" focusable="false">
			<rect x="3" y="20" width="6.500" height="13" rx="1" />
			<rect x="13.800" y="10" width="6.500" height="23" rx="1" />
			<rect x="24.500" y="3" width="6.500" height="30" rx="1" />
		</svg>
	) : (
		<svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.800" stroke-linejoin="round" aria-hidden="true" focusable="false">
			<circle cx="20" cy="20" r="16.500" />
			<path d="M26.500 13.500 22.500 22.500 13.500 26.500 17.500 17.500Z" />
			<circle cx="20" cy="20" r="1.300" fill="currentColor" stroke="none" />
		</svg>
	)
}
