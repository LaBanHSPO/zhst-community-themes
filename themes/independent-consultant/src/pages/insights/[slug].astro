---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import ContactBand from "../../components/ContactBand.astro";
import InsightCard from "../../components/InsightCard.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { topicLabel, getPractice, getInsights, photoAlt, photoSrc } from "../../lib/site";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: insight, cacheHint } = await getEmDashEntry("insights", slug);
if (!insight) return Astro.rewrite("/404");

const [allResult, practiceResult, settings] = await Promise.all([getInsights(), getPractice(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
	Astro.cache.set(practiceResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(insight, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
const d = insight.data;
const cover = photoSrc(d.image, d.photo);
const hasBody = Boolean(d.content && d.content.length > 0);
const label = topicLabel(d.topic);
const others = allResult.entries
	.filter((r) => r.data.id !== d.id)
	.sort((a, b) => Number(b.data.topic === d.topic) - Number(a.data.topic === d.topic))
	.slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary}
	canonical={seo.canonical}
	image={seo.ogImage ?? cover}
	content={{ collection: "insights", id: d.id, slug }}
	current="/insights"
>
	<header class="article-head">
		<div class="wrap">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/insights">Insights</a>
				<span aria-hidden="true">/</span>
				{d.topic && label ? <a href={`/insights?topic=${d.topic}`}>{label}</a> : <span aria-current="page">Insight</span>}
			</nav>
			<h1 class="display" {...insight.edit.title}>{d.title}</h1>
			<p class="byline">
				{d.date_label && <span>{d.date_label}</span>}
				{d.read_minutes && <span>{d.read_minutes} min read</span>}
				<span>By Clara Weston</span>
			</p>
			{cover && <div class="article-cover"><img src={cover} alt={photoAlt(d.image, d.photo, d.title)} width="1200" height="600" fetchpriority="high" /></div>}
		</div>
	</header>

	<section class="article-body">
		<p class="article-summary">{d.summary}</p>
		{hasBody && <div class="prose"><PortableText value={d.content} /></div>}
	</section>

	{
		others.length > 0 && (
			<section class="more-posts" aria-labelledby="more-title">
				<div class="wrap">
					<div class="section-head">
						<p class="eyebrow">Keep reading</p>
						<h2 id="more-title" class="display">More notes.</h2>
					</div>
					<ul class="card-grid">
						{others.map((r) => <li><InsightCard insight={r} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	<ContactBand practice={practiceResult.practice} />
</Base>
