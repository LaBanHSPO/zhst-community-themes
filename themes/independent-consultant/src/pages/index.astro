---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ContactBand from "../components/ContactBand.astro";
import InsightCard from "../components/InsightCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { getInsights, getPractice, getProjects, getServices, getSteps, serviceHref } from "../lib/site";

const [servicesResult, stepsResult, projectsResult, insightsResult, practiceResult] = await Promise.all([
	getServices(),
	getSteps(),
	getProjects(),
	getInsights(),
	getPractice(),
]);
if (Astro.cache?.enabled) {
	for (const r of [servicesResult, stepsResult, projectsResult, insightsResult, practiceResult]) Astro.cache.set(r.cacheHint);
}
const allServices = servicesResult.entries;
const featured = allServices.filter((s) => s.data.featured);
const cards = (featured.length > 0 ? featured : allServices).slice(0, 3);
const steps = stepsResult.entries;
const projects = projectsResult.entries;
const serviceTitle = (slug: string | undefined) => allServices.find((s) => (s.data.slug ?? s.data.id) === slug)?.data.title;
const insightsAll = insightsResult.entries;
const insights = (insightsAll.some((i) => i.data.featured) ? insightsAll.filter((i) => i.data.featured) : insightsAll).slice(0, 3);
const tints = ["sage", "rose", "blue"] as const;
---

<Base
	title="Turn expertise into momentum"
	description="Bridgewell is an independent consultant for owners, managers and small teams. Strategy, leadership coaching and hands-on help to get a plan moving. Read how it works and send an enquiry."
	overlay
>
	<section class="hero" aria-labelledby="hero-title">
		<img
			class="hero-photo"
			src="/images/hero-home.webp"
			alt="Clara Weston, a consultant in a dark green blazer, resting her chin on one hand at a desk with a laptop and a mug"
			width="1448"
			height="702"
			fetchpriority="high"
		/>
		<div class="hero-copy">
			<p class="hero-eyebrow">Clearer thinking. Brighter progress.</p>
			<h1 id="hero-title" class="hero-title">Turn expertise<br />into momentum.</h1>
			<p class="hero-sub">I help ambitious individuals and teams turn complex <br />challenges into clear strategies and meaningful progress.</p>
			<a class="btn btn-green" href="/contact"><span>Work with me</span><Arrow /></a>
		</div>
		<p class="hand hand-hero" aria-hidden="true">People<br /><span class="in1">Ideas</span><br /><span class="in2">Progress</span><span class="hand-stroke"></span></p>
	</section>

	<section class="help" aria-labelledby="help-title">
		<div class="help-head">
			<div>
				<p class="eyebrow">How I can help</p>
				<h2 id="help-title" class="help-title">Practical support for<br />what’s next.</h2>
			</div>
			<p class="help-intro">Strategy, structure and a fresh perspective <br />to help you move forward with confidence.</p>
		</div>
		<ul class="svc-cards">
			{cards.map((s, i) => <li><ServiceCard service={s} tint={tints[i % tints.length]} /></li>)}
		</ul>
		<p class="help-more"><a class="text-link" href="/services"><span>All services, formats and prices</span><Arrow /></a></p>
	</section>

	{
		steps.length > 0 && (
			<section class="process" aria-labelledby="process-title">
				<div class="wrap process-inner">
					<div class="process-copy">
						<p class="eyebrow">Working together</p>
						<h2 id="process-title" class="display">How an engagement works.</h2>
						<p class="process-lede">Four steps, each one written down, so you always know what happens next and what it costs.</p>
						<a class="btn btn-green" href="/contact"><span>Book a discovery call</span><Arrow /></a>
					</div>
					<ol class="process-steps">
						{steps.map((s, i) => (
							<li class="process-step">
								<span class="process-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
								<div>
									<h3 class="process-title" {...s.edit.title}>{s.data.title}</h3>
									{s.data.when_label && <p class="process-when">{s.data.when_label}</p>}
									<p class="process-text">{s.data.text}</p>
								</div>
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	{
		projects.length > 0 && (
			<section class="projects" aria-labelledby="projects-title">
				<div class="wrap">
					<div class="section-head">
						<p class="eyebrow">Typical projects</p>
						<h2 id="projects-title" class="display">The kind of work I take on.</h2>
						<p class="section-note">Short, anonymous descriptions. Details change, and no client is named.</p>
					</div>
					<ul class="project-list">
						{projects.map((p) => (
							<li class="project">
								<p class="project-who">{p.data.who}</p>
								<h3 class="project-title" {...p.edit.title}>{p.data.title}</h3>
								<p class="project-text">{p.data.text}</p>
								{p.data.service && serviceTitle(p.data.service) && (
									<a class="text-link" href={serviceHref({ slug: p.data.service, id: p.data.service })}>
										<span>{serviceTitle(p.data.service)}</span>
										<Arrow />
									</a>
								)}
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	{
		insights.length > 0 && (
			<section class="teaser" aria-labelledby="insights-title">
				<div class="wrap">
					<div class="section-head section-head-row">
						<div>
							<p class="eyebrow">Insights</p>
							<h2 id="insights-title" class="display">Notes from recent work.</h2>
						</div>
						<a class="text-link" href="/insights"><span>All insights</span><Arrow /></a>
					</div>
					<ul class="card-grid">
						{insights.map((r) => <li><InsightCard insight={r} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	<ContactBand practice={practiceResult.practice} />
</Base>
