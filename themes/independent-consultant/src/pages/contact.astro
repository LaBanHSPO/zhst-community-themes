---
import Base from "../layouts/Base.astro";
import { getPractice, getServices, telHref } from "../lib/site";

const [{ practice, cacheHint }, servicesResult] = await Promise.all([getPractice(), getServices()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(servicesResult.cacheHint);
}

const options = [
	...servicesResult.entries.map((s) => ({ value: s.data.slug ?? s.data.id, label: s.data.title })),
	{ value: "not-sure", label: "Not sure yet" },
];
// ?service=<slug> pre-selects a service (links from the services pages).
const wanted = Astro.url.searchParams.get("service");
const selected = options.find((o) => o.value === wanted);
---

<Base title="Work with me" description="Send Bridgewell an enquiry: choose a service, say how big your organisation is, when you would like to start and what you want to move forward. Email and phone are always listed.">
	<div class="contact">
		<section class="contact-panel" aria-labelledby="contact-title">
			<p class="eyebrow">Work with me</p>
			<h1 id="contact-title" class="display display-xl">Tell me what you want to move forward.</h1>
			<p class="lede">A few details are enough. Clara replies within two working days to book a free thirty-minute call.</p>

			<div class="notice" role="note">
				<strong>Enquiries only.</strong>{" "}
				{practice.contact_note ?? "Please leave out anything confidential. The first call is free and there is no obligation."}
			</div>

			<form
				class="contact-form"
				data-contact-form
				data-email={practice.email}
				action={practice.email ? `mailto:${practice.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field">
						<label for="c-name">Your name</label>
						<input id="c-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="c-name"></span>
					</div>
					<div class="field">
						<label for="c-email">Email</label>
						<input id="c-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="c-email"></span>
					</div>
					<div class="field">
						<label for="c-org">Organisation <span class="optional">(optional)</span></label>
						<input id="c-org" name="org" type="text" autocomplete="organization" />
					</div>
					<div class="field">
						<label for="c-phone">Phone <span class="optional">(optional)</span></label>
						<input id="c-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field full">
						<label for="c-service">What are you interested in?</label>
						<select id="c-service" name="service" required>
							<option value="" selected={!selected}>Choose an option</option>
							{options.map((o) => <option value={o.value} selected={selected?.value === o.value}>{o.label}</option>)}
						</select>
						<span class="field-error" data-error-for="c-service"></span>
					</div>
					<div class="field">
						<label for="c-size">Organisation size</label>
						<select id="c-size" name="size" required>
							<option value="" selected>Choose an option</option>
							<option>Just me</option>
							<option>2 to 10 people</option>
							<option>11 to 50 people</option>
							<option>51 to 250 people</option>
							<option>More than 250 people</option>
						</select>
						<span class="field-error" data-error-for="c-size"></span>
					</div>
					<div class="field">
						<label for="c-timeline">When would you like to start?</label>
						<select id="c-timeline" name="timeline" required>
							<option value="" selected>Choose an option</option>
							<option>Within a month</option>
							<option>In one to three months</option>
							<option>Later this year</option>
							<option>Just exploring</option>
						</select>
						<span class="field-error" data-error-for="c-timeline"></span>
					</div>
					<div class="field full">
						<label for="c-goals">What would you like to move forward?</label>
						<textarea id="c-goals" name="goals" rows="5" maxlength="600" placeholder="For example: we have three product ideas and room to build one, or I have just taken on a team of eight." required></textarea>
						<span class="field-error" data-error-for="c-goals"></span>
					</div>
				</div>
				<button class="btn btn-green btn-block" type="submit"><span>Send enquiry</span></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{practice.email && <>Write to <a href={`mailto:${practice.email}`}>{practice.email}</a> with your name, what you are interested in and when you would like to start.</>}
					</noscript>
				</p>
			</form>
		</section>

		<aside class="contact-aside">
			<img src="/images/about-portrait.webp" alt="Clara resting her chin on one hand at her desk, in a dark green blazer, with a laptop and a mug beside her" width="862" height="963" />
			<div class="contact-details">
				<h2>Prefer to write directly?</h2>
				<p class="detail-line">
					{practice.email && <a href={`mailto:${practice.email}`}>{practice.email}</a>}
					{practice.phone && <a href={telHref(practice.phone)}>{practice.phone}</a>}
					{practice.base && <span>{practice.base}</span>}
				</p>
				{practice.response && <p class="small">{practice.response}</p>}
			</div>
		</aside>
	</div>
</Base>

<script>
	// Compose an email to the practice; nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online requests are not available right now. Please call instead.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const select = form.querySelector<HTMLSelectElement>("#c-service");
			const serviceLabel = select?.selectedOptions[0]?.textContent ?? "";
			const subject = `Enquiry from ${get("name")}`;
			const body = [
				"Hello Clara,",
				"",
				"I would like to ask about working together.",
				"",
				`Interested in: ${serviceLabel}`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("org") ? `Organisation: ${get("org")}` : "",
				`Organisation size: ${get("size")}`,
				`Would like to start: ${get("timeline")}`,
				"",
				get("goals"),
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body.join("\n"))}`;
			status.textContent =
				"Your email app should open with this enquiry ready to send. It is only sent when you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
