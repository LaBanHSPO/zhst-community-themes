---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import ContactBand from "../../components/ContactBand.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getPractice, getServices, lines } from "../../lib/site";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: service, cacheHint } = await getEmDashEntry("services", slug);
if (!service) return Astro.rewrite("/404");

const [allResult, practiceResult, settings] = await Promise.all([getServices(), getPractice(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
	Astro.cache.set(practiceResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(service, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
const d = service.data;
const hasBody = Boolean(d.content && d.content.length > 0);
const others = allResult.entries.filter((s) => s.data.id !== d.id);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "services", id: d.id, slug }}
	current="/services"
>
	<header class="detail-head">
		<div class="wrap">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/services">Services</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{d.title}</span>
			</nav>
			<div class="detail-grid detail-grid-single">
				<div class="detail-copy">
					<p class="eyebrow">Service</p>
					<h1 class="display display-xl" {...service.edit.title}>{d.title}</h1>
					<p class="lede">{d.summary}</p>
					{d.best_for && <p class="detail-for"><strong>Who it is for.</strong> {d.best_for}</p>}
					<dl class="facts">
						{d.format && <div><dt>Format</dt><dd>{d.format}</dd></div>}
						{d.length && <div><dt>Length</dt><dd>{d.length}</dd></div>}
						{d.price_label && <div><dt>Price</dt><dd class="price">{d.price_label}</dd></div>}
					</dl>
					<p class="detail-actions">
						<a class="btn btn-green" href={`/contact?service=${encodeURIComponent(d.slug ?? d.id)}`}>
							<span>Enquire about this</span><Arrow />
						</a>
					</p>
				</div>
				
			</div>
		</div>
	</header>

	<section class="detail-body">
		<div class="wrap detail-body-grid">
			<div class="prose">
				{hasBody ? <PortableText value={d.content} /> : <p>{d.summary}</p>}
			</div>
			<aside class="includes-card" aria-labelledby="inc-title">
				<h2 id="inc-title" class="includes-title">What is included</h2>
				<ul class="includes">
					{lines(d.includes).map((i) => <li>{i}</li>)}
				</ul>
			</aside>
		</div>
	</section>

	{
		others.length > 0 && (
			<section class="more-band" aria-labelledby="more-title">
				<div class="wrap">
					<div class="section-head section-head-row">
						<div>
							<p class="eyebrow">More services</p>
							<h2 id="more-title" class="display">Other ways to work with me.</h2>
						</div>
						<a class="text-link" href="/services"><span>All services</span><Arrow /></a>
					</div>
					<ul class="svc-cards svc-cards-more">
						{others.slice(0, 3).map((s, i) => <li><ServiceCard service={s} tint={(["sage", "rose", "blue"] as const)[i % 3]} /></li>)}
					</ul>
				</div>
			</section>
		)
	}

	<ContactBand practice={practiceResult.practice} />
</Base>
