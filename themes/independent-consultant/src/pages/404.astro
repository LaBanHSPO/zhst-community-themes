---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<img class="notfound-photo" src="/images/cover-route.webp" alt="" width="861" height="646" />
		<div class="notfound-copy">
			<p class="eyebrow">Error 404</p>
			<h1 id="nf-title" class="display display-xl">This page is off the route.</h1>
			<p class="lede">The page you are looking for has moved or never existed. Here are a few places to pick the thread back up.</p>
			<div class="actions">
				<a class="btn btn-green" href="/"><span>Back to home</span><Arrow /></a>
				<a class="pill" href="/services">Services</a>
				<a class="pill" href="/insights">Insights</a>
			</div>
		</div>
	</section>
</Base>
