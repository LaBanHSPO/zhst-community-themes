---
/** Thin line icons drawn for the theme (decorative; always aria-hidden). */
interface Props {
	name: string;
	class?: string;
}
const { name, class: className } = Astro.props;

const paths: Record<string, string> = {
	lotus:
		'<path d="M12 4.5c-2.2 2.6-2.2 6.8 0 10 2.2-3.2 2.2-7.4 0-10z"/><path d="M12 14.5c-.6-3.4-3.4-5.6-6.6-5.9-.2 3.4 2.4 6.2 6.6 5.9z"/><path d="M12 14.5c.6-3.4 3.4-5.6 6.6-5.9.2 3.4-2.4 6.2-6.6 5.9z"/><path d="M12 14.5c-2.4 1.6-6.2 1.3-9-1 .8-1.4 1.9-2.2 3-2.6"/><path d="M12 14.5c2.4 1.6 6.2 1.3 9-1-.8-1.4-1.9-2.2-3-2.6"/>',
	sprout:
		'<path d="M12 20.5V12"/><path d="M12 12C12 8 9.2 5 4.5 5c0 4.2 3 7 7.5 7z"/><path d="M12 12c0-4 2.8-7 7.5-7 0 4.2-3 7-7.5 7z"/>',
	stones:
		'<ellipse cx="12" cy="18.2" rx="7.2" ry="2.8"/><ellipse cx="12" cy="12.6" rx="5.2" ry="2.4"/><ellipse cx="12" cy="7.4" rx="3.2" ry="2"/>',
	face:
		'<ellipse cx="12" cy="11.6" rx="4" ry="5"/><path d="M12 3c-4.4 0-6.6 3.3-6.6 7.4 0 3.2 1 5.6 2.4 7.1V21"/><path d="M12 3c4.4 0 6.6 3.3 6.6 7.4 0 3.2-1 5.6-2.4 7.1V21"/><path d="M8 7.6c1.8.4 3.4-.4 4.4-1.8 1 1.4 2.2 2 3.6 1.9"/>',
	leaf: '<path d="M5 19.5C4.6 11.2 9.6 5 19.6 4.4c.6 9.4-5 15.4-14.6 15.1z"/><path d="M5 19.5 15 9.5"/>',
	steam:
		'<path d="M8 4c-1.6 2 1.6 3.5 0 5.5s1.6 3.5 0 5.5 1.6 3.5 0 5"/><path d="M12 4c-1.6 2 1.6 3.5 0 5.5s1.6 3.5 0 5.5 1.6 3.5 0 5"/><path d="M16 4c-1.6 2 1.6 3.5 0 5.5s1.6 3.5 0 5.5 1.6 3.5 0 5"/>',
	clock: '<circle cx="12" cy="12" r="8.6"/><path d="M12 7v5.3l3.4 2"/>',
	calendar:
		'<rect x="3.8" y="5.2" width="16.4" height="15" rx="1.6"/><path d="M3.8 9.6h16.4M8 3.2v4M16 3.2v4"/>',
	phone:
		'<path d="M6.5 3.8h3l1.4 4-2 1.4a10 10 0 0 0 5.9 5.9l1.4-2 4 1.4v3a1.8 1.8 0 0 1-1.9 1.8A16.4 16.4 0 0 1 4.7 5.7a1.8 1.8 0 0 1 1.8-1.9z"/>',
	mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="1.4"/><path d="m4 6.5 8 6.2 8-6.2"/>',
	pin: '<path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
};
const body = paths[name] ?? paths.lotus;
---
<svg
	class:list={["icon", className]}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.1"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={body}
/>
