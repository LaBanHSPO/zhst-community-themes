---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { appointmentUrl, firstName, getTherapists, photoSrc, practiceList, slugOf } from "../lib/still";

const { entries, cacheHint } = await getTherapists();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Therapists" description="Our experienced therapists bring care, intention and expertise to every treatment.">
	<section class="hero hero-therapists" aria-labelledby="th-title">
		<img class="hero-bg" src="/images/hero-therapists.webp" alt="" width="1672" height="297" fetchpriority="high" />
		<div class="wrap hero-copy">
			<p class="eyebrow eyebrow-light">Our therapists</p>
			<h1 id="th-title" class="display display-xl-2">Expert hands,<br /> a warmer you.</h1>
			<p class="hero-lede">Our experienced therapists bring care, intention<br class="br-wide" /> and expertise to every treatment.</p>
		</div>
	</section>

	<section class="wrap team" aria-label="Therapists">
		{
			entries.length > 0 ? (
				<div class="team-grid">
					{entries.map(({ data: p }) => {
						const src = photoSrc(p.image, p.photo);
						const practice = practiceList(p.practice);
						return (
							<article class="therapist">
								{src && (
									<div class="therapist-media">
										<img src={src} alt={p.image?.alt || p.alt || `Portrait of ${p.title}`} width="392" height="226" loading="lazy" />
									</div>
								)}
								<h2 class="display display-sm-2">{p.title}</h2>
								{practice.length > 0 && (
									<p class="practice caps">
										{practice.map((x, i) => (
											<>
												{i > 0 && <span aria-hidden="true">|</span>}
												<span>{x}</span>
											</>
										))}
									</p>
								)}
								{p.bio && <p class="therapist-bio">{p.bio}</p>}
								<a class="btn btn-wide" href={appointmentUrl({ therapist: slugOf(p) })}>
									Book with {firstName(p.title)} <Arrow />
								</a>
							</article>
						);
					})}
				</div>
			) : (
				<p class="empty">Our therapist profiles are on their way. Request an appointment and we’ll match you with the right therapist.</p>
			)
		}
	</section>

	<section class="photo-band" aria-labelledby="choose-title">
		<img class="hero-bg" src="/images/band-basin.webp" alt="" width="1672" height="93" loading="lazy" />
		<div class="wrap photo-band-inner">
			<div>
				<h2 id="choose-title" class="display display-sm">Not sure who to choose?</h2>
				<p>Tell us what you’re looking for and we’ll help you find the right therapist.</p>
			</div>
			<a class="btn btn-ghost btn-xs" href={appointmentUrl()}>Request an appointment <Arrow /></a>
		</div>
	</section>
</Base>
