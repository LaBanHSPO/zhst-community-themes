---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
---

<Base title="Page not found">
	<section class="wrap notfound" aria-labelledby="nf-title">
		<Icon name="lotus" class="notfound-icon" />
		<p class="eyebrow">Error 404</p>
		<h1 id="nf-title" class="display display-lg">This page has<br /> drifted away.</h1>
		<p>The page you’re looking for doesn’t exist or has moved. Take a breath, then explore our treatments or request an appointment.</p>
		<div class="actions">
			<a class="btn" href="/treatments">Explore treatments <Arrow /></a>
			<a class="text-link" href="/appointment">Appointment request <Arrow /></a>
		</div>
	</section>
</Base>
