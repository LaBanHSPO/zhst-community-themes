---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import { CATEGORIES, getBusiness, getHighlights, getTherapists, getTreatments, minutes, money, slugOf, telHref } from "../lib/still";

const [treatments, therapists, notes, businessResult] = await Promise.all([
	getTreatments(),
	getTherapists(),
	getHighlights("appointment"),
	getBusiness(),
]);
if (Astro.cache?.enabled) {
	for (const hint of [treatments.cacheHint, therapists.cacheHint, notes.cacheHint, businessResult.cacheHint]) {
		Astro.cache.set(hint);
	}
}
const { business } = businessResult;

// Links from treatment cards and therapist profiles preselect: ?treatment=<slug>&therapist=<slug>
const q = Astro.url.searchParams;
const treatmentParam = q.get("treatment") ?? "";
const therapistParam = q.get("therapist") ?? "";
const groups = CATEGORIES.map((c) => ({
	label: c.label,
	items: treatments.entries.map((e) => e.data).filter((t) => (t.category ?? "massage") === c.key),
})).filter((g) => g.items.length > 0);
const optionLabel = (t: { title: string; duration?: number; price?: number }) =>
	[t.title, minutes(t.duration), money(t.price)].filter(Boolean).join(" · ");

const times = ["Any time", "Morning (9am–12pm)", "Afternoon (12pm–4pm)", "Evening (4pm–8pm)"];
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Saigon" }).format(new Date());
const noJs = business.email ? `mailto:${business.email}` : undefined;
---

<Base title="Appointment request" description="Request your appointment. Choose your preferred treatment, therapist and date and we’ll confirm as soon as possible.">
	<section class="hero hero-appointment" aria-labelledby="ap-title">
		<img class="hero-bg" src="/images/hero-appointment.webp" alt="" width="1672" height="257" fetchpriority="high" />
		<div class="wrap hero-copy">
			<h1 id="ap-title" class="display display-xl-2">Request your<br /> appointment</h1>
			<p class="hero-lede">Take time for you. We’ll take care of the rest.</p>
		</div>
	</section>

	<div class="wrap appt">
		<section class="appt-form-col" aria-labelledby="form-title">
			<h2 id="form-title" class="display display-md">Book an appointment</h2>
			<p class="section-intro">Choose your preferred treatment, therapist and date below. We’ll confirm your booking as soon as possible.</p>

			<form id="appt-form" class="appt-form" method="post" action={noJs} enctype="text/plain" data-email={business.email}>
				<div class="field">
					<label for="a-treatment">Treatment</label>
					<div class="select">
						<select id="a-treatment" name="treatment" required>
							<option value="" selected={!treatmentParam}>Select a treatment</option>
							{
								groups.map((g) => (
									<optgroup label={g.label}>
										{g.items.map((t) => (
											<option value={optionLabel(t)} selected={slugOf(t) === treatmentParam}>
												{optionLabel(t)}
											</option>
										))}
									</optgroup>
								))
							}
						</select>
					</div>
				</div>
				<div class="field">
					<label for="a-therapist">Preferred therapist <span class="opt">(optional)</span></label>
					<div class="select">
						<select id="a-therapist" name="therapist">
							<option value="Any therapist">Any therapist</option>
							{
								therapists.entries.map(({ data: p }) => (
									<option value={p.title} selected={slugOf(p) === therapistParam}>
										{p.title}
									</option>
								))
							}
						</select>
					</div>
				</div>
				<div class="field">
					<label for="a-date">Preferred date</label>
					<div class="date">
						<input id="a-date" name="date" type="date" min={today} required />
						<Icon name="calendar" />
					</div>
				</div>
				<div class="field">
					<label for="a-time">Preferred time</label>
					<div class="select">
						<select id="a-time" name="time">
							{times.map((t) => <option value={t}>{t}</option>)}
						</select>
					</div>
				</div>
				<div class="field">
					<label for="a-name">Your name</label>
					<input id="a-name" name="name" type="text" autocomplete="name" placeholder="Full name" required />
				</div>
				<div class="field">
					<label for="a-phone">Phone number</label>
					<input id="a-phone" name="phone" type="tel" autocomplete="tel" placeholder="e.g. 0412 345 678" required />
				</div>
				<div class="field field-full">
					<label for="a-notes">Additional notes <span class="opt">(optional)</span></label>
					<textarea id="a-notes" name="notes" rows="3" maxlength="1500" placeholder="Let us know anything we should be aware of (e.g. focus areas, preferences)."></textarea>
				</div>
				<div class="field-full">
					<button class="btn btn-submit" type="submit">Request appointment <Arrow /></button>
					<p class="form-note">
						We’ll be in touch shortly to confirm your booking. For urgent requests, please call us directly{business.phone ? <> on <a href={telHref(business.phone)}>{business.phone}</a></> : null}.
					</p>
					<p class="form-status" role="status" aria-live="polite" data-status>{!business.email && business.phone && <>Online requests are not available right now. Please call {business.phone}.</>}</p>
					{
						business.email && (
							<noscript>
								<p class="form-status">
									Without JavaScript, send your appointment request by email to <a href={`mailto:${business.email}`}>{business.email}</a>.
								</p>
							</noscript>
						)
					}
				</div>
			</form>
		</section>

		<aside class="appt-side" aria-labelledby="know-title">
			<img src="/images/stone-basin.webp" alt="A candlelit stone basin scattered with petals in the treatment room" width="431" height="241" loading="lazy" />
			<h2 id="know-title" class="display display-sm-2">A few things to know</h2>
			{
				notes.entries.length > 0 && (
					<ul class="know">
						{notes.entries.map((n) => (
							<li>
								<Icon name={n.data.icon ?? "lotus"} />
								<div>
									<h3>{n.data.title}</h3>
									{n.data.text && <p>{n.data.text}</p>}
								</div>
							</li>
						))}
					</ul>
				)
			}
		</aside>
	</div>
</Base>

<script>
	// Appointment request: compose an email to the spa. Nothing is sent by the site itself.
	const form = document.querySelector<HTMLFormElement>("#appt-form");
	const status = form?.querySelector<HTMLElement>("[data-status]");

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		if (!status || !form.reportValidity()) return;
		const email = form.dataset.email ?? "";
		if (!email) {
			status.textContent = "Online requests are not available right now. Please call us instead.";
			return;
		}
		const data = new FormData(form);
		const get = (k: string) => String(data.get(k) ?? "").trim();
		const lines = [
			"Hello Still,",
			"",
			"I would like to request an appointment. Please confirm availability.",
			"",
			`Treatment: ${get("treatment")}`,
			`Preferred therapist: ${get("therapist") || "Any therapist"}`,
			`Preferred date: ${get("date")}`,
			`Preferred time: ${get("time") || "Any time"}`,
			"",
			`Name: ${get("name")}`,
			`Phone: ${get("phone")}`,
			"",
			`Notes: ${get("notes") || "None"}`,
			"",
		];
		const subject = `Appointment request: ${get("treatment").split(" · ")[0]} for ${get("name")}`;
		window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
		status.textContent =
			"Your email app should open with this request ready to send. Nothing is sent until you send that email, and your appointment is pending until we confirm it. If nothing opened, write to ";
		const a = document.createElement("a");
		a.href = `mailto:${email}`;
		a.textContent = email;
		status.append(a, ".");
	});
</script>
