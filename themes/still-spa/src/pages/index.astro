---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import { getHighlights, getSignature, treatmentUrl } from "../lib/still";

const [features, signature] = await Promise.all([getHighlights("home"), getSignature()]);
if (Astro.cache?.enabled) {
	for (const hint of [features.cacheHint, signature.cacheHint]) Astro.cache.set(hint);
}
const sig = signature.entry?.data;
---

<Base title="Still — Day spa" description="A little time, entirely yours. Massage, facials and body rituals at Still day spa.">
	<section class="hero hero-home" aria-labelledby="home-title">
		<img class="hero-bg" src="/images/hero-home.webp" alt="" width="1672" height="419" fetchpriority="high" />
		<div class="wrap hero-copy">
			<h1 id="home-title" class="display display-xl">A little time,<br /> entirely yours.</h1>
			<p class="hero-lede">Rest. Reconnect. Feel like you again.</p>
			<a class="btn btn-ghost" href="/treatments">Explore treatments <Arrow /></a>
		</div>
	</section>

	{
		features.entries.length > 0 && (
			<section class="features" aria-label="Why Still">
				<ul class="wrap features-row">
					{features.entries.map((f) => (
						<li>
							<Icon name={f.data.icon ?? "lotus"} class="feature-icon" />
							<h2 class="caps">{f.data.title}</h2>
							{f.data.text && <p>{f.data.text}</p>}
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="triptych" aria-labelledby="sig-title">
		<div class="triptych-media">
			<img src="/images/home-linen.webp" alt="Folded linen towels and a wooden tray with mineral salt and a plum orchid" width="544" height="286" loading="lazy" />
		</div>
		<div class="triptych-copy">
			<p class="eyebrow">Signature treatment</p>
			<h2 id="sig-title" class="display display-md">{sig?.title ?? "The Still Ritual"}</h2>
			{sig?.summary && <p>{sig.summary}</p>}
			{sig && <a class="btn" href={treatmentUrl(sig)}>Discover the ritual <Arrow /></a>}
		</div>
		<div class="triptych-media triptych-space">
			<img src="/images/home-space.webp" alt="A candlelit treatment room with a stone foot basin, lanterns and olive trees" width="596" height="286" loading="lazy" />
			<p class="space-quote">A more<br /> peaceful<br /> kind of place.</p>
		</div>
	</section>
</Base>
