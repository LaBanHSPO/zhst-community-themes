---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Icon from "../../components/Icon.astro";
import TreatmentCard from "../../components/TreatmentCard.astro";
import { CATEGORIES, appointmentUrl, categoryOf, getTreatments } from "../../lib/still";

const { entries, cacheHint } = await getTreatments();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Tabs are server-side filters: /treatments?category=massage|facial|body
const active = categoryOf(Astro.url.searchParams.get("category"));
const list = entries.filter((e) => (e.data.category ?? "massage") === active.key).map((e) => e.data);
---

<Base title="Treatments" description="Restorative massage, facial and body treatments with clear durations and prices.">
	<section class="hero hero-band" aria-labelledby="treat-title">
		<img class="hero-bg" src="/images/hero-treatments.webp" alt="" width="1672" height="242" fetchpriority="high" />
		<div class="wrap hero-copy">
			<p class="eyebrow eyebrow-light">Treatments</p>
			<h1 id="treat-title" class="display display-lg">Restorative treatments<br /> for body, mind and skin.</h1>
			<p class="hero-lede">Thoughtfully curated treatments to help you relax,<br class="br-wide" /> reconnect and feel like you again.</p>
		</div>
	</section>

	<nav class="tabs" aria-label="Treatment categories">
		<ul class="tabs-row">
			{
				CATEGORIES.map((c) => (
					<li>
						<a href={`/treatments?category=${c.key}#list`} aria-current={c.key === active.key ? "true" : undefined}>
							<Icon name={c.icon} />
							{c.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<section class="wrap treat-list" id="list" aria-labelledby="list-title">
		<h2 id="list-title" class="display display-md">{active.heading}</h2>
		<p class="section-intro">{active.intro}</p>
		{
			list.length > 0 ? (
				<div class="t-grid">
					{list.map((t) => <TreatmentCard treatment={t} />)}
				</div>
			) : (
				<p class="empty">No {active.label.toLowerCase()} treatments are listed yet. Ask us when you request an appointment.</p>
			)
		}
	</section>

	<section class="split-band" aria-labelledby="help-title">
		<div class="split-media">
			<img src="/images/salt-orchid.webp" alt="A bowl of pink mineral salt beside a plum orchid on soft towels" width="906" height="143" loading="lazy" />
		</div>
		<div class="split-copy">
			<p class="eyebrow eyebrow-sm">Discover more</p>
			<h2 id="help-title" class="display display-sm">Not sure what’s right for you?</h2>
			<p>Our therapists are here to help you find the perfect treatment<br class="br-wide" /> based on your goals and how you’re feeling today.</p>
			<a class="btn btn-xs" href={appointmentUrl()}>Request an appointment <Arrow /></a>
		</div>
	</section>
</Base>
