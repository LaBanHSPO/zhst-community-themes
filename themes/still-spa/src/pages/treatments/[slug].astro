---
import { getEmDashEntry, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Icon from "../../components/Icon.astro";
import { appointmentUrl, categoryOf, minutes, money, photoSrc, slugOf } from "../../lib/still";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry, cacheHint } = await getEmDashEntry("treatments", slug);
if (!entry) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const t = entry.data;
const key = slugOf(t);
const category = categoryOf(t.category);
const heroSrc = photoSrc(t.hero_image, t.hero_photo) ?? "/images/hero-treatments.webp";
const expectSrc = photoSrc(t.expect_image, t.expect_photo) ?? photoSrc(t.image, t.photo);
const duration = minutes(t.duration);
const price = money(t.price);
const steps = t.steps ?? [];
const lede = t.lede ?? t.summary;
// "More than a massage. A return to yourself." sets each sentence on its own line, as designed.
const expectLines = (t.expect_title ?? t.title).split(/(?<=[.!?])\s+/);
---

<Base
	title={t.title}
	description={lede}
	image={photoSrc(t.image, t.photo)}
	content={{ collection: "treatments", id: t.id, slug: key }}
	current={t.signature ? undefined : "/treatments"}
>
	<section class="hero hero-detail" aria-labelledby="t-title">
		<img class="hero-bg" src={heroSrc} alt="" width="1672" height="387" fetchpriority="high" />
		<div class="wrap hero-copy">
			<p class="eyebrow eyebrow-light">{t.signature ? "Signature treatment" : `${category.label} treatment`}</p>
			<h1 id="t-title" class="display display-xl" {...entry.edit.title}>{t.title}</h1>
			{lede && <p class="hero-lede hero-lede-md">{lede}</p>}
			{
				(duration || price) && (
					<p class="hero-facts">
						{duration && (
							<span>
								<Icon name="clock" />
								{duration}
							</span>
						)}
						{duration && price && <span class="meta-rule" aria-hidden="true" />}
						{price && <span>{price}</span>}
					</p>
				)
			}
			<a class="btn btn-ghost" href={appointmentUrl({ treatment: key })}>Request an appointment <Arrow /></a>
		</div>
	</section>

	{
		steps.length > 0 && (
			<section class="journey" aria-labelledby="journey-title">
				<div class="wrap-wide journey-inner">
					<div class="journey-head">
						<p class="eyebrow">The treatment journey</p>
						<h2 id="journey-title" class="display display-lg-2">{t.journey_title ?? "A considered flow."}</h2>
					</div>
					<ol class="journey-steps">
						{steps.map((s, i) => (
							<li>
								<span class="journey-icon">
									<Icon name={s.icon || "lotus"} />
								</span>
								<h3 class="caps">
									{i + 1}. {s.title}
								</h3>
								<p>{s.text}</p>
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	<section class="expect" aria-labelledby="expect-title">
		{
			expectSrc && (
				<div class="expect-media">
					<img src={expectSrc} alt={t.expect_image?.alt || t.alt || t.title} width="630" height="269" loading="lazy" />
				</div>
			)
		}
		<div class="expect-copy">
			<p class="eyebrow eyebrow-sm">What to expect</p>
			<h2 id="expect-title" class="display display-sm-2">
				{expectLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
			</h2>
			{(t.expect_text ?? t.summary) && <p>{t.expect_text ?? t.summary}</p>}
		</div>
		<aside class="consult" aria-labelledby="consult-title">
			<img src="/images/consultation.webp" alt="A therapist in a plum uniform preparing a treatment" width="177" height="183" loading="lazy" />
			<div>
				<p class="eyebrow eyebrow-sm">Therapist consultation</p>
				<h2 id="consult-title" class="display display-sm">Personalised to you.</h2>
				<p>Your treatment begins with a brief consultation to understand your needs, focus areas and any preferences, so we can tailor the experience to support how you feel today.</p>
			</div>
		</aside>
	</section>
</Base>
