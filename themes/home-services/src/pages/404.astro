---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound">
		<div class="container notfound-inner">
			<p class="eyebrow">Error 404</p>
			<h1>Something is missing here.</h1>
			<p>The page you are looking for has moved or never existed. These are good places to start again.</p>
			<div class="actions">
				<a class="btn" href="/">Back to home <Arrow /></a>
				<a class="btn btn-outline" href="/services">Our services</a>
				<a class="btn btn-outline" href="/contact">Request a quote</a>
			</div>
		</div>
	</section>
</Base>
