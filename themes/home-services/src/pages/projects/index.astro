---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getOffice, getProjects } from "../../lib/home";

const [projectsResult, officeResult] = await Promise.all([getProjects(), getOffice()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(projectsResult.cacheHint);
	Astro.cache.set(officeResult.cacheHint);
}
const projects = projectsResult.entries;
const { office } = officeResult;
---

<Base title="Projects" description="Recent HearthFix jobs, each with how the home looked before and after.">
	<section class="page-head">
		<div class="container page-head-inner">
			<p class="eyebrow">Projects</p>
			<h1>Small jobs, done properly.</h1>
			<p class="lede">A look at recent work: what the home needed, what we did and how it looked afterwards.</p>
		</div>
	</section>

	<section class="section list-section">
		<div class="container">
			{
				projects.length > 0 ? (
					<div class="project-grid is-wide">
						{projects.map((p) => <ProjectCard project={p} />)}
					</div>
				) : (
					<p class="empty">Projects will appear here once they are added in the admin.</p>
				)
			}
		</div>
	</section>

	<CtaBand office={office} />
</Base>
