---
import Base from "../../layouts/Base.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getOffice, getServices, getSteps } from "../../lib/home";

const [servicesResult, stepsResult, officeResult] = await Promise.all([getServices(), getSteps(), getOffice()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(servicesResult.cacheHint);
	Astro.cache.set(stepsResult.cacheHint);
	Astro.cache.set(officeResult.cacheHint);
}
const services = servicesResult.entries;
const steps = stepsResult.entries;
const { office } = officeResult;
---

<Base title="Services" description="Plumbing, electrical, painting, repairs and regular maintenance visits for your home.">
	<section class="page-head">
		<div class="container page-head-inner">
			<p class="eyebrow">Our services</p>
			<h1>Care for every corner.</h1>
			<p class="lede">From everyday repairs to bigger improvements, we help you maintain a home you love. Every job starts with a written quote.</p>
		</div>
	</section>

	<section class="section list-section">
		<div class="container">
			{
				services.length > 0 ? (
					<div class="service-cards is-wide">
						{services.map((s) => <ServiceCard service={s} />)}
					</div>
				) : (
					<p class="empty">Services will appear here once they are added in the admin.</p>
				)
			}
		</div>
	</section>

	{
		steps.length > 0 && (
			<section class="section section-white" aria-labelledby="steps-title">
				<div class="container">
					<div class="section-head">
						<p class="eyebrow">How it works</p>
						<h2 id="steps-title" class="section-title">Simple from the first message.</h2>
					</div>
					<ol class="steps">
						{steps.map((s, i) => (
							<li>
								<span class="step-num">{String(i + 1).padStart(2, "0")}</span>
								<h3>{s.data.title}</h3>
								<p>{s.data.text}</p>
							</li>
						))}
					</ol>
				</div>
			</section>
		)
	}

	<CtaBand office={office} />
</Base>
