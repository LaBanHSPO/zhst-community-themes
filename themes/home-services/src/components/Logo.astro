---
/** Wordmark: navy line-icon house, heavy sans title and the tagline in small tracked caps. */
interface Props {
	title: string;
	tagline?: string;
	logo?: { url?: string; alt?: string } | null;
	class?: string;
	light?: boolean;
}
const { title, tagline, logo, class: className, light = false } = Astro.props;
---

<a class:list={["wordmark", { "is-light": light }, className]} href="/" aria-label={`${title} — home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt || title} />
		) : (
			<>
				<svg class="wordmark-icon" width="56" height="52" viewBox="0 0 56 52" aria-hidden="true" focusable="false">
					<path d="M3 26 28 4l25 22" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
					<path d="M11 21v27h11V33h12v15h11V21" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				<span class="wordmark-text">
					<span class="wordmark-title">{title}</span>
					{tagline && <span class="wordmark-tagline">{tagline}</span>}
				</span>
			</>
		)
	}
</a>
