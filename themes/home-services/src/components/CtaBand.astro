---
import Arrow from "./Arrow.astro";
import { telHref, type OfficeData } from "../lib/home";

interface Props {
	office: OfficeData;
	title?: string;
	text?: string;
}
const {
	office,
	title = "Ready when you are.",
	text = "Tell us what needs doing. We reply within one working day with a time to visit and a written quote.",
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
	<img class="cta-photo" src="/images/tech-house.webp" alt="" width="1448" height="1086" loading="lazy" decoding="async" />
	<div class="container cta-inner">
		<div class="cta-copy">
			<span class="eyebrow eyebrow-light">Request a quote</span>
			<h2 id="cta-title">{title}</h2>
			<p>{text}</p>
			<div class="cta-actions">
				<a class="btn btn-light btn-lg" href="/contact">Request a quote <Arrow /></a>
				<div class="cta-direct">
					{office.phone && <a href={telHref(office.phone)}>{office.phone}</a>}
					{office.email && <a href={`mailto:${office.email}`}>{office.email}</a>}
				</div>
			</div>
		</div>
	</div>
</section>
