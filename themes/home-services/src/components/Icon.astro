---
/** Line icons for services and trust items (inline SVG, inherits the text colour). */
interface Props {
	name: string;
	size?: number;
}
const { name, size = 34 } = Astro.props;
---

<svg class="icon" width={size} height={size} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
	{name === "drop" && <path d="M16 4C12 10 7 14.5 7 20a9 9 0 0 0 18 0C25 14.5 20 10 16 4Z M12 21a4 4 0 0 0 4 4" />}
	{name === "bolt" && <path d="M19 3 7 18h8l-2 11 12-16h-8l2-10Z" />}
	{name === "roller" && <path d="M6 5h17v8H6V5Zm17 4h3v7H15v4m0 0h-2v7h4v-7h-2" />}
	{name === "wrench" && <path d="M4 28 14 18m4-13a7 7 0 0 0 7.5 9.5L28 12l-4-1-1-4 2.5-2.5A7 7 0 0 0 18 5Zm-12 6 6 6M5 5l5 5m0 0 3 3M7 20l-3 3 5 5 3-3" />}
	{name === "house" && <path d="M3 15 16 4l13 11M7 13v15h6v-9h6v9h6V13" />}
	{name === "tools" && <path d="m6 6 20 20M26 6 6 26M4 4l5 2-2 3-3-5Zm24 0-5 2 2 3 3-5ZM4 28l5-2-2-3-3 5Zm24 0-5-2 2-3 3 5Z" />}
	{name === "leaf" && <path d="M5 27C4 14 12 5 28 5c0 16-9 23-21 22Zm0 0L19 13M14 21c-1-3 0-6 3-8" />}
</svg>
