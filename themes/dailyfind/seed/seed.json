{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Dailyfind",
		"description": "A home & living deals theme: featured deals, filterable catalog, offer pages with a reveal-code dialog, store offers with expired offers, and an affiliate disclosure",
		"author": "ZeroHostCMS"
	},
	"settings": {
		"title": "Dailyfind",
		"tagline": "Useful finds. Better prices."
	},
	"collections": [
		{
			"slug": "deals",
			"label": "Deals",
			"labelSingular": "Deal",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"urlPattern": "/deals/{slug}",
			"fields": [
				{
					"slug": "title",
					"label": "Product",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "summary",
					"label": "Short description",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "content",
					"label": "About this deal",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "store",
					"label": "Store (store slug)",
					"type": "string",
					"required": true,
					"indexed": true
				},
				{
					"slug": "price",
					"label": "Sale price (USD)",
					"type": "number",
					"required": true,
					"validation": {
						"min": 0
					}
				},
				{
					"slug": "was_price",
					"label": "Original price (USD)",
					"type": "number",
					"validation": {
						"min": 0
					}
				},
				{
					"slug": "discount",
					"label": "Discount percent",
					"type": "integer",
					"indexed": true,
					"validation": {
						"min": 0,
						"max": 100
					}
				},
				{
					"slug": "categories",
					"label": "Categories",
					"type": "multiSelect",
					"validation": {
						"options": [
							"living-room",
							"bedroom",
							"kitchen-dining",
							"bath",
							"home-decor",
							"organization",
							"lighting",
							"rugs-textiles",
							"outdoor",
							"storage"
						]
					}
				},
				{
					"slug": "code",
					"label": "Coupon code",
					"type": "string"
				},
				{
					"slug": "code_note",
					"label": "Code note (after 'Use this code at {store}')",
					"type": "string"
				},
				{
					"slug": "expires",
					"label": "Offer expires (listed date)",
					"type": "datetime"
				},
				{
					"slug": "valid_for",
					"label": "Valid for",
					"type": "string"
				},
				{
					"slug": "exclusions",
					"label": "Exclusions",
					"type": "string"
				},
				{
					"slug": "deal_url",
					"label": "Retailer link",
					"type": "url"
				},
				{
					"slug": "highlights",
					"label": "About highlights",
					"type": "repeater",
					"validation": {
						"maxItems": 3,
						"subFields": [
							{
								"slug": "icon",
								"label": "Icon (sofa, grid, home)",
								"type": "string"
							},
							{
								"slug": "label",
								"label": "Label",
								"type": "string",
								"required": true
							}
						]
					}
				},
				{
					"slug": "image",
					"label": "Photo (upload)",
					"type": "image"
				},
				{
					"slug": "photo",
					"label": "Bundled photo path",
					"type": "string"
				},
				{
					"slug": "photo_alt",
					"label": "Photo alt text",
					"type": "string"
				},
				{
					"slug": "image_fit",
					"label": "Photo fit",
					"type": "select",
					"validation": {
						"options": [
							"cover",
							"contain"
						]
					},
					"defaultValue": "cover"
				},
				{
					"slug": "gallery",
					"label": "Gallery",
					"type": "repeater",
					"validation": {
						"maxItems": 6,
						"subFields": [
							{
								"slug": "image",
								"label": "Photo (upload)",
								"type": "image"
							},
							{
								"slug": "photo",
								"label": "Bundled photo path",
								"type": "string"
							},
							{
								"slug": "alt",
								"label": "Alt text",
								"type": "string",
								"required": true
							}
						]
					}
				},
				{
					"slug": "featured",
					"label": "Show on homepage",
					"type": "boolean",
					"indexed": true
				},
				{
					"slug": "home_position",
					"label": "Homepage order",
					"type": "number"
				},
				{
					"slug": "position",
					"label": "Catalog order",
					"type": "number",
					"indexed": true
				}
			]
		},
		{
			"slug": "stores",
			"label": "Stores",
			"labelSingular": "Store",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"urlPattern": "/stores/{slug}",
