								"type": "string"
							},
							{
								"slug": "title",
								"label": "Title",
								"type": "string",
								"required": true
							},
							{
								"slug": "note",
								"label": "Note",
								"type": "string"
							}
						]
					}
				},
				{
					"slug": "position",
					"label": "Sort order",
					"type": "number"
				}
			]
		},
