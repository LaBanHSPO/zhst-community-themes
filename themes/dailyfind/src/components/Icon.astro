---
/** Inline icon set. Decorative by default; the parent supplies any accessible name. */
interface Props {
	name: string;
	size?: number;
	class?: string;
	stroke?: number;
}
const { name, size = 24, class: className, stroke = 1.8 } = Astro.props;
---

<svg
	class:list={["icon", className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={stroke}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{name === "house" && <path d="M3.5 11 12 3.5 20.5 11M5.5 9.5V20.5h13V9.5M10 20.5v-4.5h4v4.5" />}
	{name === "search" && <><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.4-4.4" /></>}
	{name === "heart" && <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.5C19.500 15.400 12 20 12 20Z" />}
	{name === "bag" && <><path d="M5.5 8h13l-.8 12H6.300Z" /><path d="M9 8V6.500a3 3 0 0 1 6 0V8" /></>}
	{name === "arrow" && <path d="M4 12h15M13 6l6 6-6 6" />}
	{name === "external" && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
	{name === "calendar" && <><rect x="4" y="5.500" width="16" height="14.500" rx="2" /><path d="M4 10h16M8.500 3.500v4M15.500 3.500v4" /></>}
	{name === "tag" && <><path d="m3.500 12.600 8-8.100h8v8l-8.100 8Z" /><circle cx="15.500" cy="8.500" r="1.200" /></>}
	{name === "person" && <><circle cx="12" cy="8" r="3.600" /><path d="M5 20c.5-3.700 3.200-5.500 7-5.500s6.500 1.800 7 5.500" /></>}
	{name === "chevron" && <path d="m6 9 6 6 6-6" />}
	{name === "chevron-up" && <path d="m6 15 6-6 6 6" />}
	{name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
	{name === "copy" && <><rect x="8.500" y="8.500" width="11" height="11" rx="2" /><path d="M15.500 8.500v-2a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2" /></>}
	{name === "check" && <path d="m5 12.500 4.500 4.500L19 7.500" />}
	{name === "sofa" && <><path d="M6 11V8.500A2.500 2.500 0 0 1 8.500 6h7A2.500 2.500 0 0 1 18 8.500V11" /><path d="M4 12.500a2 2 0 0 1 4 0V14h8v-1.500a2 2 0 0 1 4 0V17H4Z" /><path d="M6 17v2M18 17v2" /></>}
	{name === "grid" && <path d="M9 3.500 8 20.500M16 3.500l-1 17M3.500 9h17M3.500 15.500h17" />}
	{name === "home" && <path d="M3.500 11 12 3.500 20.500 11M5.500 9.500V20.500h13V9.500M10 20.500v-4.500h4v4.500" />}
	{name === "truck" && <><path d="M3 6.500h11V16H3ZM14 9.500h4l3 3V16h-7" /><circle cx="7.500" cy="17.500" r="1.800" /><circle cx="17" cy="17.500" r="1.800" /></>}
	{name === "box" && <><path d="m12 3 8 4v10l-8 4-8-4V7Z" /><path d="m4 7 8 4 8-4M12 11v10" /></>}
</svg>
