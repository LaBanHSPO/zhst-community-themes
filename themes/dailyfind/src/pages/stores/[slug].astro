---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import DealCard from "../../components/DealCard.astro";
import {
	STORE_CATEGORIES,
	categoryLabel,
	formatDate,
	getDeals,
	getStoreOffers,
	isExpired,
	photoSrc,
	safeUrl,
	storeUrl,
} from "../../lib/dailyfind";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry, cacheHint } = await getEmDashEntry("stores", slug);
if (!entry) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const store = entry.data;
const key = store.slug ?? entry.id;

const [offersResult, dealsResult, settings] = await Promise.all([getStoreOffers(), getDeals(), getSiteSettings()]);
const { siteTitle } = resolveStarterSiteIdentity(settings);
const validCats = new Set<string>(STORE_CATEGORIES.map((c) => c.slug));
const catParam = Astro.url.searchParams.get("category") ?? "";
const cat = validCats.has(catParam) ? catParam : "";
const sortParam = Astro.url.searchParams.get("sort");
const sort = sortParam === "ending" ? "ending" : "featured";

const mine = offersResult.entries.filter((e) => e.data.store === key);
const inCat = mine.filter((e) => !cat || e.data.categories?.includes(cat));
const byDate = (a: (typeof mine)[number], b: (typeof mine)[number]) =>
	(a.data.expires ?? "").localeCompare(b.data.expires ?? "");
const active = inCat.filter((e) => !isExpired(e.data.expires)).sort(sort === "ending" ? byDate : () => 0);
const expired = inCat.filter((e) => isExpired(e.data.expires));
// Tabs follow the data: only categories this store has offers for.
const tabs = STORE_CATEGORIES.filter((c) => mine.some((e) => e.data.categories?.includes(c.slug)));

const tabHref = (value?: string) => {
	const next = new URLSearchParams();
	if (value) next.set("category", value);
	if (sort !== "featured") next.set("sort", sort);
	const qs = next.toString();
	return qs ? `${storeUrl(key)}?${qs}` : storeUrl(key);
};
const storeLink = safeUrl(store.url);
const storeDeals = dealsResult.entries.filter((e) => e.data.store === key);
const storeNames = new Map([[key, store.title]]);

const seo = getSeoMeta(entry, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={`${store.title} offers`}
	pageTitle={seo.ogTitle}
	description={store.blurb ?? seo.description}
	canonical={seo.canonical}
	content={{ collection: "stores", id: store.id, slug: key }}
>
	<section class="hero hero-store" aria-labelledby="store-title">
		<img class="hero-photo" src="/images/hero-store.webp" alt="Sunlit living room with a speckled vase of greenery and a sofa with terracotta cushions" width="952" height="252" />
		<div class="container hero-copy store-hero-copy">
			<span class="store-logo" aria-hidden="true">
				{
					store.mark === "bullseye" ? (
						<svg viewBox="0 0 100 100" width="100" height="100" focusable="false">
							<circle cx="50" cy="50" r="46" fill="#d3121b" />
							<circle cx="50" cy="50" r="32" fill="#fff" />
							<circle cx="50" cy="50" r="19" fill="#d3121b" />
						</svg>
					) : (
						<span class="monogram">{store.title.slice(0, 1)}</span>
					)
				}
			</span>
			<div>
				<h1 id="store-title" {...entry.edit.title}>{store.title}</h1>
				{store.tagline && <p class="store-tagline">{store.tagline}</p>}
				{store.blurb && <p class="lede">{store.blurb}</p>}
				{
					storeLink && (
						<a class="btn btn-lg" href={storeLink} target="_blank" rel="sponsored noopener">
							Visit store offers <Icon name="arrow" size={20} />
							<span class="visually-hidden">(opens {store.title} in a new tab)</span>
						</a>
					)
				}
			</div>
		</div>
	</section>

	{
		tabs.length > 0 && (
			<div class="container">
				<nav class="pills pills-store" aria-label="Offer categories">
					<a href={tabHref()} aria-current={cat === "" ? "page" : undefined}>All Offers</a>
					{tabs.map((t) => <a href={tabHref(t.slug)} aria-current={cat === t.slug ? "page" : undefined}>{t.label}</a>)}
				</nav>
			</div>
		)
	}

	{
		mine.length > 0 ? (
			<section class="section store-section" aria-labelledby="active-title">
				<div class="container">
					<div class="section-head">
						<h2 id="active-title" class="h-section">
							Active offers <span class="count">({active.length})</span>
						</h2>
						<form method="get" action={storeUrl(key)} class="sort-form">
							{cat && <input type="hidden" name="category" value={cat} />}
							<label class="sort sort-boxed">
								<span class="select-wrap">
									<select name="sort" data-autosubmit aria-label="Sort offers">
										<option value="featured" selected={sort === "featured"}>Sort by: Featured</option>
										<option value="ending" selected={sort === "ending"}>Sort by: Ending soonest</option>
									</select>
									<Icon name="chevron" size={16} />
								</span>
							</label>
							<noscript><button class="btn btn-sm" type="submit">Sort</button></noscript>
						</form>
					</div>
					{
						active.length === 0 ? (
							<p class="empty">No active {cat ? categoryLabel(cat).toLowerCase() : ""} offers right now. Expired offers are listed below.</p>
						) : (
							<ul class="offer-grid" role="list">
								{active.map((e) => {
									const o = e.data;
									const src = photoSrc(o.image, o.photo);
									return (
										<li>
											<article class="offer-card">
												<div class="deal-photo">
													{src && <img src={src} alt={o.photo_alt ?? ""} loading="lazy" />}
													{o.badge && <span class="badge">{o.badge}</span>}
												</div>
												<div class="offer-card-body">
													<h3>{o.title}</h3>
													{o.summary && <p class="offer-card-text">{o.summary}</p>}
													<p class="offer-ends">
														<Icon name="calendar" size={18} /> Ends {formatDate(o.expires)}
													</p>
													{
														o.code ? (
															<details class="reveal">
																<summary class="btn btn-block">Reveal code</summary>
																<div class="code-row">
																	<span class="code-box">{o.code}</span>
																	<button class="btn-copy" type="button" data-copy={o.code} aria-label={`Copy code ${o.code}`}>Copy</button>
																</div>
															</details>
														) : (
															<p class="btn btn-block is-disabled">No code needed</p>
														)
													}
													<details class="see-details">
														<summary>See details <Icon name="chevron" size={14} /></summary>
														<p>{o.offer_terms}</p>
													</details>
												</div>
											</article>
										</li>
									);
								})}
							</ul>
						)
					}
				</div>
			</section>
		) : (
			<section class="section store-section">
				<div class="container">
					<p class="empty">No store-wide codes are listed for {store.title} right now. Individual product deals are below.</p>
				</div>
			</section>
		)
	}

	{
		expired.length > 0 && (
			<section class="section expired-section" aria-labelledby="expired-title">
				<div class="container">
					<h2 id="expired-title" class="h-sub">
						Expired offers <span class="count">({expired.length})</span>
					</h2>
					<ul class="expired-grid" role="list">
						{expired.map((e) => {
							const o = e.data;
							const src = photoSrc(o.image, o.photo);
							return (
								<li class="expired-card">
									<div class="expired-photo">
										{src && <img src={src} alt="" loading="lazy" />}
										<span class="chip-expired">Expired</span>
									</div>
									<div>
										<h3>{o.title}</h3>
										<p>This offer has expired. Check back for new offers.</p>
										<p class="expired-date">Ended {formatDate(o.expires)}</p>
									</div>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	{
		storeDeals.length > 0 && (
			<section class="section" aria-labelledby="store-deals-title">
				<div class="container">
					<div class="section-head">
						<h2 id="store-deals-title" class="h-section">Deals at {store.title}</h2>
						<a class="text-link" href={`/deals?store=${encodeURIComponent(key)}`}>
							View in the catalog <Icon name="arrow" size={18} />
						</a>
					</div>
					<ul class="deal-grid deal-grid-4" role="list">
						{storeDeals.map((e) => <li><DealCard deal={e.data} storeName={storeNames.get(key) ?? key} /></li>)}
					</ul>
					<p class="example-note">
						<strong>Example offers.</strong> Codes, prices and dates are the editor’s listing, not live retailer data.
						<a href="/disclosure">Affiliate disclosure</a>
					</p>
				</div>
			</section>
		)
	}
</Base>

<script>
	document.querySelectorAll<HTMLSelectElement>("[data-autosubmit]").forEach((select) => {
		select.addEventListener("change", () => select.form?.requestSubmit());
	});
</script>
