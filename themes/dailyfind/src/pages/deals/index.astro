---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import DealCard from "../../components/DealCard.astro";
import { CATEGORIES, PILL_ORDER, categoryLabel, getDeals, getStores } from "../../lib/dailyfind";

const params = Astro.url.searchParams;
const validCats = new Set<string>(CATEGORIES.map((c) => c.slug));
const selectedCats = [...new Set(params.getAll("category").filter((c) => validCats.has(c)))];
const selectedStores = [...new Set(params.getAll("store").map((s) => s.slice(0, 60)))];
const discountParam = Number.parseInt(params.get("discount") ?? "0", 10);
const minDiscount = [10, 25, 50].includes(discountParam) ? discountParam : 0;
const num = (v: string | null) => {
	if (!v) return null;
	const n = Number.parseFloat(v);
	return Number.isFinite(n) && n >= 0 ? n : null;
};
const minPrice = num(params.get("min"));
const maxPrice = num(params.get("max"));
const q = (params.get("q") ?? "").trim().slice(0, 80);
const SORTS = [
	{ value: "featured", label: "Featured" },
	{ value: "discount", label: "Biggest discount" },
	{ value: "price-asc", label: "Price: low to high" },
	{ value: "price-desc", label: "Price: high to low" },
];
const sortParam = params.get("sort") ?? "featured";
const sort = SORTS.some((s) => s.value === sortParam) ? sortParam : "featured";
const savedView = params.get("saved") === "1";

const [dealsResult, storesResult] = await Promise.all([getDeals(), getStores()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(dealsResult.cacheHint);
	Astro.cache.set(storesResult.cacheHint);
}
const stores = storesResult.entries.map((s) => ({ slug: s.data.slug ?? s.id, title: s.data.title }));
const storeName = new Map(stores.map((s) => [s.slug, s.title]));
const all = dealsResult.entries;
const catCount = (slug: string) => all.filter((e) => e.data.categories?.includes(slug)).length;

const needle = q.toLowerCase();
const results = all
	.filter(({ data }) => {
		if (selectedCats.length && !selectedCats.some((c) => data.categories?.includes(c))) return false;
		if (selectedStores.length && !selectedStores.includes(data.store)) return false;
		if (minDiscount && (data.discount ?? 0) < minDiscount) return false;
		if (minPrice !== null && data.price < minPrice) return false;
		if (maxPrice !== null && data.price > maxPrice) return false;
		if (needle) {
			const hay = `${data.title} ${data.summary ?? ""} ${storeName.get(data.store) ?? data.store} ${(data.categories ?? []).map(categoryLabel).join(" ")}`.toLowerCase();
			if (!hay.includes(needle)) return false;
		}
		return true;
	})
	.sort((a, b) => {
		if (sort === "discount") return (b.data.discount ?? 0) - (a.data.discount ?? 0);
		if (sort === "price-asc") return a.data.price - b.data.price;
		if (sort === "price-desc") return b.data.price - a.data.price;
		return (a.data.position ?? 0) - (b.data.position ?? 0);
	});

const hasFilters = selectedCats.length > 0 || selectedStores.length > 0 || minDiscount > 0 || minPrice !== null || maxPrice !== null || q !== "";
const pillHref = (slug?: string) => {
	const next = new URLSearchParams();
	if (slug) next.set("category", slug);
	if (q) next.set("q", q);
	if (sort !== "featured") next.set("sort", sort);
	const qs = next.toString();
	return qs ? `/deals?${qs}` : "/deals";
};
const pills = PILL_ORDER.map((slug) => ({ slug, label: categoryLabel(slug) }));
---

<Base title="Deals catalog" description="Browse home & living deals by category, discount, price and store. Every code and date is the editor’s listing.">
	<section class="hero hero-deals" aria-labelledby="catalog-title">
		<img class="hero-photo" src="/images/hero-deals.webp" alt="Wooden bowl of lemons and a vase of greenery on a bright kitchen counter" width="952" height="150" />
		<div class="container hero-copy">
			<h1 id="catalog-title">Deals catalog</h1>
			<p class="lede">Top home &amp; living deals from your favorite stores. Great style. Better prices.</p>
		</div>
	</section>

	<div class="container catalog">
		<aside class="filters" aria-label="Filter deals">
			<form id="filters" method="get" action="/deals">
				{q && <input type="hidden" name="q" value={q} />}
				{savedView && <input type="hidden" name="saved" value="1" />}
				<details class="filter-group" open>
					<summary>Category <Icon name="chevron-up" size={18} /></summary>
					<ul role="list">
						{
							CATEGORIES.map((c) => (
								<li>
									<label class="check">
										<input type="checkbox" name="category" value={c.slug} checked={selectedCats.includes(c.slug)} />
										<span>{c.label} ({catCount(c.slug)})</span>
									</label>
								</li>
							))
						}
					</ul>
				</details>
				<details class="filter-group" open>
					<summary>Discount <Icon name="chevron-up" size={18} /></summary>
					<ul role="list">
						{
							[
								{ v: 0, label: "Any discount" },
								{ v: 10, label: "10% off or more" },
								{ v: 25, label: "25% off or more" },
								{ v: 50, label: "50% off or more" },
							].map((d) => (
								<li>
									<label class="check radio">
										<input type="radio" name="discount" value={d.v} checked={minDiscount === d.v} />
										<span>{d.label}</span>
									</label>
								</li>
							))
						}
					</ul>
				</details>
				<details class="filter-group" open={minPrice !== null || maxPrice !== null}>
					<summary>Price range <Icon name="chevron" size={18} /></summary>
					<div class="price-range">
						<label>
							<span class="visually-hidden">Minimum price in dollars</span>
							<input type="number" name="min" min="0" step="1" inputmode="decimal" placeholder="Min $" value={minPrice ?? ""} />
						</label>
						<span aria-hidden="true">–</span>
						<label>
							<span class="visually-hidden">Maximum price in dollars</span>
							<input type="number" name="max" min="0" step="1" inputmode="decimal" placeholder="Max $" value={maxPrice ?? ""} />
						</label>
					</div>
				</details>
				<details class="filter-group" open={selectedStores.length > 0}>
					<summary>Store <Icon name="chevron" size={18} /></summary>
					<ul role="list">
						{
							stores.map((s) => (
								<li>
									<label class="check">
										<input type="checkbox" name="store" value={s.slug} checked={selectedStores.includes(s.slug)} />
										<span>{s.title}</span>
									</label>
								</li>
							))
						}
					</ul>
				</details>
				<div class="filter-actions">
					<button class="btn btn-sm" type="submit">Apply filters</button>
					{hasFilters && <a class="text-link" href="/deals">Clear filters</a>}
				</div>
			</form>
		</aside>

		<div class="results">
			<div class="results-bar">
				<p class="result-count" role="status" aria-live="polite" id="result-count">
					{savedView ? "Saved deals" : <>{results.length} {results.length === 1 ? "deal" : "deals"} found</>}{q ? ` for “${q}”` : ""}
				</p>
				<label class="sort">
					<span>Sort by</span>
					<span class="select-wrap">
						<select name="sort" form="filters" data-autosubmit>
							{SORTS.map((s) => <option value={s.value} selected={s.value === sort}>{s.label}</option>)}
						</select>
						<Icon name="chevron" size={16} />
					</span>
				</label>
			</div>

			<nav class="pills" aria-label="Category quick filter">
				<a href={pillHref()} aria-current={selectedCats.length === 0 ? "page" : undefined}>All</a>
				{
					pills.map((p) => (
						<a href={pillHref(p.slug)} aria-current={selectedCats.length === 1 && selectedCats[0] === p.slug ? "page" : undefined}>
							{p.label}
						</a>
					))
				}
			</nav>

			{
				results.length === 0 ? (
					<p class="empty">
						No deals match those filters. <a class="text-link" href="/deals">Clear filters</a>.
					</p>
				) : (
					<ul class="deal-grid deal-grid-4" role="list" id="deal-list">
						{results.map((e) => (
							<li data-deal-item={e.data.slug ?? e.id}>
								<DealCard deal={e.data} storeName={storeName.get(e.data.store) ?? e.data.store} showCode />
							</li>
						))}
					</ul>
				)
			}
			<p class="empty" id="saved-empty" hidden>You haven’t saved any deals yet. Tap the heart on a deal to keep it here.</p>
			<p class="example-note">
				<strong>Example offers.</strong> Prices, codes and expiry dates are the editor’s listing, not live retailer data.
				<a href="/disclosure">Affiliate disclosure</a>
			</p>
		</div>
	</div>
</Base>

<script>
	document.querySelectorAll<HTMLSelectElement>("[data-autosubmit]").forEach((select) => {
		select.addEventListener("change", () => select.form?.requestSubmit());
	});

	// "?saved=1" shows only the deals saved in this browser.
	if (new URLSearchParams(location.search).get("saved") === "1") {
		const items = document.querySelectorAll<HTMLElement>("[data-deal-item]");
		const count = document.getElementById("result-count");
		const empty = document.getElementById("saved-empty");
		const apply = () => {
			let saved: string[] = [];
			try {
				saved = JSON.parse(localStorage.getItem("dailyfind-saved") ?? "[]");
			} catch {
				saved = [];
			}
			let shown = 0;
			items.forEach((li) => {
				const keep = saved.includes(li.dataset.dealItem ?? "");
				li.hidden = !keep;
				if (keep) shown += 1;
			});
			if (count) count.textContent = `${shown} saved ${shown === 1 ? "deal" : "deals"}`;
			if (empty) empty.hidden = shown > 0;
		};
		document.addEventListener("dailyfind:saved", apply);
		apply();
	}
</script>
