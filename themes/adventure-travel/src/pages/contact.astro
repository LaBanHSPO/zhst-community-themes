---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { dateRange, daysLabel, getCompany, getTrips, mapHref, rows, telHref } from "../lib/travel";

const [{ company, cacheHint }, tripsResult] = await Promise.all([getCompany(), getTrips()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(tripsResult.cacheHint);
}
const office = rows(company.office);
const trips = tripsResult.trips;
// ?trip=<slug> pre-selects the trip, ?departure=YYYY-MM-DD pre-selects one of its dates.
const wantedTrip = Astro.url.searchParams.get("trip");
const wantedDeparture = Astro.url.searchParams.get("departure");
const selected = trips.find((t) => (t.entry.data.slug ?? t.entry.data.id) === wantedTrip);
const selectedDeparture = selected?.departures.find((d) => d.start === wantedDeparture);
---

<Base title="Plan your trip" description="Send an enquiry about a WILDROUTES trip. Phone, email and office hours are listed on this page.">
	<PageHead
		id="contact-title"
		eyebrow="Plan your trip"
		title="Tell us where and when."
		intro="Choose a trip and a date, say how many are coming and what you have done outdoors. We reply within two working days."
	/>
	<section class="contact-section" aria-labelledby="contact-title">
		<div class="wrap contact-grid">
			<form
				class="enquiry-form"
				data-enquiry-form
				data-email={company.email}
				action={company.email ? `mailto:${company.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field full">
						<label for="c-trip">Trip</label>
						<select id="c-trip" name="trip" required>
							<option value="" selected={!selected}>Choose a trip</option>
							{
								trips.map((t) => (
									<option value={t.entry.data.title} selected={selected?.entry.data.id === t.entry.data.id}>
										{t.entry.data.title} · {daysLabel(t.entry.data.days)}
									</option>
								))
							}
							<option value="Not sure yet">Not sure yet, please advise</option>
						</select>
						<span class="field-error" data-error-for="c-trip"></span>
					</div>
					<div class="field full">
						<label for="c-departure">Preferred departure</label>
						<select id="c-departure" name="departure">
							<option value="Flexible on dates">Flexible on dates</option>
							{
								trips
									.filter((t) => t.departures.length > 0)
									.map((t) => (
										<optgroup label={t.entry.data.title} data-trip={t.entry.data.title}>
											{t.departures.map((d) => (
												<option
													value={`${dateRange(d.start, d.end)} (${t.entry.data.title})`}
													data-trip={t.entry.data.title}
													selected={selected?.entry.data.id === t.entry.data.id && selectedDeparture?.start === d.start}
												>
													{dateRange(d.start, d.end)}
												</option>
											))}
										</optgroup>
									))
							}
						</select>
						<span class="field-hint">Choosing a trip above narrows this list to its dates.</span>
					</div>
					<div class="field">
						<label for="c-group">How many people</label>
						<select id="c-group" name="group" required>
							<option value="1">1 person</option>
							<option value="2" selected>2 people</option>
							<option value="3">3 people</option>
							<option value="4">4 people</option>
							<option value="5 to 8">5 to 8 people</option>
							<option value="More than 8">More than 8 people</option>
						</select>
					</div>
					<div class="field">
						<label for="c-level">Experience level</label>
						<select id="c-level" name="level" required>
							<option value="First multi-day trip">First multi-day trip</option>
							<option value="Some hiking or paddling" selected>Some hiking or paddling</option>
							<option value="Regular multi-day trips">Regular multi-day trips</option>
							<option value="Experienced in the mountains or on water">Experienced in the mountains or on water</option>
						</select>
					</div>
					<div class="field full">
						<label for="c-name">Name</label>
						<input id="c-name" name="name" type="text" autocomplete="name" required />
						<span class="field-error" data-error-for="c-name"></span>
					</div>
					<div class="field">
						<label for="c-email">Email</label>
						<input id="c-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="c-email"></span>
					</div>
					<div class="field">
						<label for="c-phone">Phone <span class="optional">(optional)</span></label>
						<input id="c-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field full">
						<label for="c-notes">Anything else? <span class="optional">(optional)</span></label>
						<textarea id="c-notes" name="notes" rows="4" placeholder="What you have done before, injuries we should know about, dietary needs, who you are travelling with"></textarea>
					</div>
				</div>
				<button class="btn btn-lg btn-block" type="submit">Send enquiry</button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{company.email && <>Write to <a href={`mailto:${company.email}`}>{company.email}</a> with the trip, dates and number of people.</>}
					</noscript>
				</p>
			</form>

			<aside class="contact-side">
				<h2>Prefer to talk?</h2>
				<p>
					{company.phone && <>Call <a href={telHref(company.phone)}>{company.phone}</a></>}
					{company.phone && company.email && " or email "}
					{!company.phone && company.email && "Email "}
					{company.email && <a href={`mailto:${company.email}`}>{company.email}</a>}.
				</p>
				{
					(company.street || company.locality) && (
						<p>
							<a href={mapHref(company)} target="_blank" rel="noopener noreferrer">{[company.street, company.locality].filter(Boolean).join(", ")}</a>
						</p>
					)
				}
				{
					office.length > 0 && (
						<>
							<h3>Office hours</h3>
							<dl class="side-hours">
								{office.map((h) => <><dt>{h.left}</dt><dd>{h.right}</dd></>)}
							</dl>
						</>
					)
				}
				{company.enquiry_note && <p class="small">{company.enquiry_note}</p>}
				<img src="/images/lake-sunset.webp" alt="A long turquoise lake below forested slopes in evening light" width="768" height="420" loading="lazy" />
			</aside>
		</div>
	</section>
</Base>

<script>
	// Narrow the departure list to the chosen trip, then compose an enquiry email.
	// Nothing is sent by the site itself; the company confirms by reply.
	document.querySelectorAll<HTMLFormElement>("[data-enquiry-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		const tripSelect = form.querySelector<HTMLSelectElement>("#c-trip");
		const depSelect = form.querySelector<HTMLSelectElement>("#c-departure");
		if (!status) return;

		const filterDepartures = () => {
			if (!tripSelect || !depSelect) return;
			const trip = tripSelect.value;
			depSelect.querySelectorAll<HTMLOptGroupElement>("optgroup").forEach((g) => {
				const show = !trip || trip === "Not sure yet" || g.dataset.trip === trip;
				g.hidden = !show;
				g.disabled = !show;
			});
			const current = depSelect.selectedOptions[0];
			if (current && current.parentElement instanceof HTMLOptGroupElement && current.parentElement.hidden) {
				depSelect.value = "Flexible on dates";
			}
		};
		tripSelect?.addEventListener("change", filterDepartures);
		filterDepartures();

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input[required], select[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online enquiries are not available right now. Please call us.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Trip enquiry: ${get("trip")}`;
			const lines = [
				"Hello,",
				"",
				"I would like to ask about a trip:",
				`Trip: ${get("trip")}`,
				`Preferred departure: ${get("departure")}`,
				`People: ${get("group")}`,
				`Experience: ${get("level")}`,
				`Name: ${get("name")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("notes") ? `Notes: ${get("notes")}` : "",
				"",
				"I understand a place is held only once you confirm it by email.",
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this enquiry ready to send. It is only sent when you send that email, and we reply to it. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
