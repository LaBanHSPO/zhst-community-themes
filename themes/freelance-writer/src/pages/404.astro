---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<div class="wrap">
		<section class="notfound" aria-labelledby="nf-title">
			<div>
				<p class="label">Error 404</p>
				<h1 id="nf-title" class="display">This page has gone off to write something else.</h1>
				<p class="lede">The page you are looking for has moved or never existed. These are good places to start again.</p>
				<div class="actions">
					<a class="btn" href="/"><span>Back to home</span><Arrow /></a>
					<a class="text-link" href="/work"><span>Selected work</span><Arrow /></a>
				</div>
			</div>
			<img src="/images/plant-sea.webp" alt="" width="600" height="420" />
		</section>
	</div>
</Base>
