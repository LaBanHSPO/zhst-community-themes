---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import CommissionBand from "../components/CommissionBand.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getStudio, photoAlt, photoSrc } from "../lib/studio";

const [{ entry: page, cacheHint }, studioResult, settings] = await Promise.all([
	getEmDashEntry("pages", "about"),
	getStudio(),
	getSiteSettings(),
]);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: "/about" });
const src = photoSrc(page.data.image, page.data.photo);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? page.data.intro}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug: "about" }}
	current="/about"
>
	<PageHead eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro} edit={{ ...page.edit.title }} />
	<div class="wrap about-grid">
		<div class="prose">
			<PortableText value={page.data.content} />
		</div>
		{
			src && (
				<figure class="about-photo" style="margin: 0">
					<img src={src} alt={photoAlt(page.data.image, page.data.photo, "The writing desk")} width="1448" height="1086" />
					<figcaption>The desk where most of it gets written</figcaption>
				</figure>
			)
		}
	</div>
	<CommissionBand studio={studioResult.studio} />
</Base>
