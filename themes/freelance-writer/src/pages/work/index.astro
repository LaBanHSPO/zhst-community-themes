---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import CommissionBand from "../../components/CommissionBand.astro";
import { CATEGORIES, getArticles, getStudio } from "../../lib/studio";

const [articlesResult, studioResult] = await Promise.all([getArticles(), getStudio()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(articlesResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const all = articlesResult.entries;

// One filter link per category that has at least one article, in a fixed order.
const categories = CATEGORIES.filter((c) => all.some((a) => a.data.category === c.slug));
const active = categories.find((c) => c.slug === Astro.url.searchParams.get("category"));
const articles = active ? all.filter((a) => a.data.category === active.slug) : all;
---

<Base
	title={active ? `${active.label} writing` : "Work"}
	description="Selected articles, essays and features on technology, productivity, lifestyle and culture."
	current="/work"
>
	<PageHead
		id="work-title"
		eyebrow="Work"
		title={active ? `${active.label}, in words.` : "Ideas, people and the wider picture."}
		intro="Selected articles and essays. Publication names are fictional examples used to show how the theme looks with content."
	/>

	<section class="section" style="padding-top: 8px" aria-labelledby="work-title">
		<div class="wrap">
			{
				categories.length > 1 && (
					<nav class="filter" aria-label="Filter by category">
						<a href="/work" aria-current={active ? undefined : "true"}>All</a>
						{categories.map((c) => (
							<a href={`/work?category=${c.slug}`} aria-current={active?.slug === c.slug ? "true" : undefined}>{c.label}</a>
						))}
					</nav>
				)
			}
			{
				articles.length > 0 ? (
					<ul class="work-grid">
						{articles.map((a, i) => <li><ArticleCard article={a} eager={i < 3} /></li>)}
					</ul>
				) : (
					<p class="empty">No articles in this category yet.</p>
				)
			}
		</div>
	</section>

	<CommissionBand studio={studioResult.studio} />
</Base>
