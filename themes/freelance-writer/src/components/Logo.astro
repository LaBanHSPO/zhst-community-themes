---
/** Wordmark: quill mark, the site title in a serif and the tagline in small tracked monospace capitals. */
interface Props {
	title: string;
	tagline?: string;
	logo?: { url?: string; alt?: string } | null;
	class?: string;
}
const { title, tagline, logo, class: className } = Astro.props;
---

<a class:list={["wordmark", className]} href="/" aria-label={`${title} — home`}>
	{
		logo?.url ? (
			<img src={logo.url} alt={logo.alt || title} />
		) : (
			<>
				<svg class="quill" width="33" height="44" viewBox="0 0 33 44" aria-hidden="true" focusable="false">
					<path
						d="M31.6 1.2C20.5 1.6 8.6 7.6 4.4 20.2c-1.2 3.6-1.3 7.6-.4 11.2L1 42.6l1.7.4 3.1-8.9c2.8 1.7 6.2 2.4 9.7 1.9C27.8 34.3 33.6 17.6 31.6 1.2Z"
						fill="currentColor"
					/>
					<path d="M5.9 36.2C11 26.4 18.4 17.4 27.6 10.4" fill="none" stroke="var(--paper)" stroke-width="1.1" stroke-linecap="round" opacity=".55" />
				</svg>
				<span class="wordmark-text">
					<span class="wordmark-title">{title}</span>
					{tagline && <span class="wordmark-tagline">{tagline}</span>}
				</span>
			</>
		)
	}
</a>
