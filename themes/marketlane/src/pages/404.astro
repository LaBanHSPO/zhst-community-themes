---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";

Astro.response.status = 404;
---

<Base title="Page not found">
	<section class="container not-found">
		<p class="eyebrow">Error 404</p>
		<h1>We couldn’t find that page</h1>
		<p class="lede">The item or collection may have moved, or the link may be mistyped.</p>
		<p class="actions">
			<a class="btn btn-primary" href="/category">Shop all <Icon name="arrow" size={20} /></a>
			<a class="text-link" href="/collections">Browse collections</a>
		</p>
	</section>
</Base>

<style>
	.not-found {
		padding-block: var(--space-8);
	}
	.not-found h1 {
		font-size: var(--step-3);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-5);
		margin-top: var(--space-6);
	}
</style>
