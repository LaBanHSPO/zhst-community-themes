---
import { decodeSlug, getEmDashCollection, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import Icon from "../../components/Icon.astro";
import {
	formatPrice,
	getColors,
	getCoverImage,
	getSizes,
	type ProductImage,
} from "../../lib/catalog";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: product, cacheHint } = await getEmDashEntry("products", slug);
if (!product) {
	return Astro.rewrite("/404");
}

const p = product.data;
const category = p.terms?.category?.[0] ?? null;
const collections = p.terms?.collection ?? [];
const colors = getColors(p);
const sizes = getSizes(p);

// Gallery slides: one per colour image (so picking a colour can show it), then the main image
// if no colour uses it, then extra gallery images. Duplicate sources are skipped.
interface Slide {
	image: ProductImage;
	alt: string;
	caption: string | null;
	color: string | null;
}
const slides: Slide[] = [];
const seen = new Set<string>();
const keyOf = (img: ProductImage) => img.src || img.id;
function addSlide(image: ProductImage | null | undefined, alt: string, caption: string | null, color: string | null) {
	if (!image || !keyOf(image) || seen.has(keyOf(image))) return;
	seen.add(keyOf(image));
	slides.push({ image, alt: image.alt || alt, caption, color });
}
for (const c of colors) addSlide(c.image, `${p.title} in ${c.name}`, c.name, c.slug);
addSlide(getCoverImage(p), p.title, null, null);
for (const g of p.gallery ?? []) addSlide(g?.image, `${p.title} detail`, g?.caption ?? null, null);

const initialColor = colors[0] ?? null;
const [relatedResult, settings] = await Promise.all([
	category
		? getEmDashCollection("products", { where: { category: category.slug }, limit: 5 })
		: Promise.resolve(null),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	if (relatedResult) Astro.cache.set(relatedResult.cacheHint);
}
const related = (relatedResult?.entries ?? []).filter((e) => e.id !== product.id).slice(0, 4);

const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(product, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const hasDescription = Array.isArray(p.description) && p.description.length > 0;
const anyUnavailable = sizes.some((s) => !s.available);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? p.summary ?? null}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "products", id: p.id, slug }}
>
	<div class="container">
		<nav aria-label="Breadcrumb" class="crumbs pdp-crumbs">
			<a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/category">Shop</a>
			{
				category && (
					<>
						{" "}<span aria-hidden="true">/</span>{" "}
						<a href={`/category/${encodeURIComponent(category.slug)}`}>{category.label}</a>
					</>
				)
			}
			{" "}<span aria-hidden="true">/</span> <span aria-current="page">{p.title}</span>
		</nav>

		<div class="pdp" data-pdp>
			<section class="gallery" aria-label={`${p.title} images`}>
				<div class="stage">
					{
						slides.length === 0 ? (
							<div class="no-image">
								<span>Product photography coming soon</span>
							</div>
						) : (
							slides.map((s, i) => (
								<figure class="slide" id={`slide-${i}`} data-slide={i} data-color={s.color ?? undefined} hidden={i !== 0}>
									<Image image={s.image} alt={s.alt} priority={i === 0} />
									{s.caption && <figcaption class="sr-only">{s.caption}</figcaption>}
								</figure>
							))
						)
					}
				</div>
				{
					slides.length > 1 && (
						<ul class="thumbs" aria-label="Choose an image">
							{slides.map((s, i) => (
								<li>
									<button
										type="button"
										class="thumb"
										data-thumb={i}
										aria-controls={`slide-${i}`}
										aria-pressed={i === 0 ? "true" : "false"}
									>
										<Image image={s.image} alt="" width={160} height={120} />
										<span class="sr-only">
											Show image {i + 1} of {slides.length}: {s.alt}
										</span>
									</button>
								</li>
							))}
						</ul>
					)
				}
			</section>

			<section class="details" aria-labelledby="product-title">
				{collections[0] && (
					<p class="eyebrow">
						<a href={`/collections/${encodeURIComponent(collections[0].slug)}`}>{collections[0].label}</a>
					</p>
				)}
				<h1 id="product-title" {...product.edit.title}>{p.title}</h1>
				<p class="price">{formatPrice(p.price)}</p>
				{p.summary && <p class="summary" {...product.edit.summary}>{p.summary}</p>}

				<form class="options" method="get" action="/contact" data-options>
					<input type="hidden" name="product" value={product.id} />

					{
						colors.length > 0 && (
							<fieldset class="color-group">
								<legend>
									Color: <span class="selected-value" data-color-label>{initialColor?.name}</span>
								</legend>
								<div class="swatch-row">
									{colors.map((c, i) => (
										<label class="swatch" title={c.name}>
											<input
												type="radio"
												name="color"
												value={c.slug}
												checked={i === 0}
												data-color-name={c.name}
											/>
											<span class="swatch-dot" style={c.swatch ? `--swatch:${c.swatch}` : undefined} aria-hidden="true">
												{!c.swatch && c.name.slice(0, 1)}
											</span>
											<span class="sr-only">{c.name}</span>
										</label>
									))}
								</div>
							</fieldset>
						)
					}

					{
						sizes.length > 0 && (
							<fieldset class="size-group">
								<legend>
									Size: <span class="selected-value" data-size-label>Choose a size</span>
								</legend>
								<div class="size-row">
									{sizes.map((s) => (
										<label class:list={["size", { unavailable: !s.available }]}>
											<input
												type="radio"
												name="size"
												value={s.label}
												disabled={!s.available}
												aria-describedby={!s.available ? "size-unavailable-note" : undefined}
											/>
											<span>{s.label}</span>
										</label>
									))}
								</div>
								<p class="hint">
									{anyUnavailable && (
										<span id="size-unavailable-note">Crossed-out sizes are not offered in this style. </span>
									)}
									<a href="/size-guide">
										<Icon name="ruler" size={18} /> Size guide
									</a>
								</p>
							</fieldset>
						)
					}

					<div class="purchase">
						<button class="btn btn-primary ask" type="submit">
							Ask about this item
							<Icon name="arrow" size={20} />
						</button>
						<p class="purchase-note" id="purchase-note">
							<strong>Purchase coming soon.</strong> Online checkout is not available yet. Send us this
							item with your chosen colour and size, and we will reply by email.
						</p>
						<p class="selection-summary" aria-live="polite" data-selection-summary>
							Your selection: {p.title}{initialColor ? `, ${initialColor.name}` : ""}{sizes.length > 0 ? ", no size chosen" : ""}
						</p>
					</div>
				</form>

				<div class="info">
					{
						hasDescription && (
							<section>
								<h2>Description</h2>
								<div class="prose">
									<PortableText value={p.description} />
								</div>
							</section>
						)
					}
					{
						p.fit_notes && (
							<section>
								<h2>Fit</h2>
								<p>{p.fit_notes}</p>
							</section>
						)
					}
					{
						p.materials && (
							<section>
								<h2>Materials</h2>
								<p>{p.materials}</p>
							</section>
						)
					}
					{
						p.care && (
							<section>
								<h2>Care</h2>
								<p>{p.care}</p>
							</section>
						)
					}
				</div>
			</section>
		</div>

		{
			related.length > 0 && (
				<section class="section related" aria-labelledby="related-heading">
					<div class="section-head">
						<h2 id="related-heading">More {category?.label.toLowerCase()}</h2>
						{category && (
							<a class="text-link" href={`/category/${encodeURIComponent(category.slug)}`}>
								View all <Icon name="arrow" size={18} />
							</a>
						)}
					</div>
					<div class="related-row">
						{related.map((r) => (
							<ProductCard slug={r.id} product={r.data} />
						))}
					</div>
				</section>
			)
		}
	</div>
</Base>

<script>
	// Progressive enhancement: the options form works without JS (it submits the chosen
	// colour/size to /contact). With JS, selecting a colour swaps the visible image and
	// the legends/summary reflect the current choice.
	for (const root of document.querySelectorAll<HTMLElement>("[data-pdp]")) {
		const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
		const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-thumb]"));
		const form = root.querySelector<HTMLFormElement>("[data-options]");
		const colorLabel = root.querySelector<HTMLElement>("[data-color-label]");
		const sizeLabel = root.querySelector<HTMLElement>("[data-size-label]");
		const summary = root.querySelector<HTMLElement>("[data-selection-summary]");
		const title = root.querySelector("h1")?.textContent?.trim() ?? "";

		const show = (index: number) => {
			if (index < 0 || index >= slides.length) return;
			slides.forEach((s, i) => (s.hidden = i !== index));
			thumbs.forEach((t, i) => t.setAttribute("aria-pressed", String(i === index)));
		};
		thumbs.forEach((t, i) => t.addEventListener("click", () => show(i)));

		const update = () => {
			if (!form) return;
			const color = form.querySelector<HTMLInputElement>('input[name="color"]:checked');
			const size = form.querySelector<HTMLInputElement>('input[name="size"]:checked');
			const hasSizes = form.querySelector('input[name="size"]') !== null;
			if (colorLabel && color) colorLabel.textContent = color.dataset.colorName ?? color.value;
			if (sizeLabel) sizeLabel.textContent = size ? size.value : "Choose a size";
			if (summary) {
				const parts = [title];
				if (color) parts.push(color.dataset.colorName ?? color.value);
				if (hasSizes) parts.push(size ? `size ${size.value}` : "no size chosen");
				summary.textContent = `Your selection: ${parts.join(", ")}`;
			}
		};

		form?.addEventListener("change", (event) => {
			const target = event.target as HTMLInputElement;
			if (target.name === "color") {
				const index = slides.findIndex((s) => s.dataset.color === target.value);
				if (index >= 0) show(index);
			}
			update();
		});
		// Browsers may restore a previous selection on back/forward navigation.
		update();
		const checked = form?.querySelector<HTMLInputElement>('input[name="color"]:checked');
		if (checked) {
			const index = slides.findIndex((s) => s.dataset.color === checked.value);
			if (index >= 0) show(index);
		}
	}
</script>

<style>
	.pdp-crumbs {
		padding-top: var(--space-5);
	}
	.pdp {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: var(--space-7);
		align-items: start;
	}
	.stage {
		background: var(--color-tile);
		aspect-ratio: 4 / 3;
		position: relative;
		overflow: hidden;
	}
	.slide {
		margin: 0;
		position: absolute;
		inset: 0;
	}
	.slide[hidden] {
		display: none;
	}
	.slide :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
	}
	.no-image {
		display: grid;
		place-items: center;
		height: 100%;
		color: var(--color-muted);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: var(--step--1);
		background: repeating-linear-gradient(135deg, #f3f3f1 0 14px, #eeeeeb 14px 28px);
	}
	.thumbs {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
		gap: var(--space-3);
		padding: 0;
		margin: var(--space-3) 0 0;
	}
	.thumb {
		display: block;
		width: 100%;
		padding: 0;
		border: 1px solid transparent;
		background: var(--color-tile);
		cursor: pointer;
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}
	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.thumb[aria-pressed="true"] {
		border-color: var(--color-ink);
		box-shadow: inset 0 0 0 1px var(--color-ink);
	}

	.details .eyebrow a {
		color: inherit;
		text-decoration: none;
	}
	.details h1 {
		font-size: var(--step-3);
		margin-bottom: var(--space-2);
	}
	.price {
		font-size: 1.35rem;
		color: var(--color-ink);
		margin-bottom: var(--space-4);
	}
	.summary {
		color: var(--color-muted);
		font-size: var(--step-1);
	}

	.options {
		display: grid;
		gap: var(--space-5);
		margin-top: var(--space-5);
		padding-top: var(--space-5);
		border-top: 1px solid var(--color-line);
	}
	fieldset {
		border: 0;
		padding: 0;
		margin: 0;
	}
	legend {
		font-weight: 600;
		color: var(--color-ink);
		margin-bottom: var(--space-3);
		padding: 0;
	}
	.selected-value {
		font-weight: 400;
		color: var(--color-muted);
	}
	.swatch-row,
	.size-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}
	.swatch,
	.size {
		position: relative;
		cursor: pointer;
	}
	.swatch input,
	.size input {
		position: absolute;
		opacity: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		cursor: pointer;
	}
	.swatch-dot {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		background: var(--swatch, #ddd);
		box-shadow:
			inset 0 0 0 1px rgba(15, 26, 43, 0.2),
			0 0 0 3px #fff;
		font-size: 0.8rem;
		text-transform: uppercase;
	}
	.swatch input:checked + .swatch-dot {
		box-shadow:
			inset 0 0 0 1px rgba(15, 26, 43, 0.2),
			0 0 0 3px #fff,
			0 0 0 4.5px var(--color-ink);
	}
	.swatch input:focus-visible + .swatch-dot {
		outline: 2px solid var(--color-focus);
		outline-offset: 6px;
	}
	.size span {
		display: inline-grid;
		place-items: center;
		min-width: 3.25rem;
		min-height: 2.75rem;
		padding: 0 0.85rem;
		border: 1px solid #b9bcc4;
		color: var(--color-ink);
		background: #fff;
		font-variant-numeric: tabular-nums;
	}
	.size:hover span {
		border-color: var(--color-ink);
	}
	.size input:checked + span {
		background: var(--color-ink);
		border-color: var(--color-ink);
		color: #fff;
	}
	.size input:focus-visible + span {
		outline: 2px solid var(--color-focus);
		outline-offset: 3px;
	}
	.size.unavailable {
		cursor: not-allowed;
	}
	.size.unavailable input {
		cursor: not-allowed;
	}
	.size.unavailable span {
		color: #8d919b;
		background: linear-gradient(to top right, transparent calc(50% - 0.5px), #b9bcc4 50%, transparent calc(50% + 0.5px));
		border-color: var(--color-line);
	}
	.hint {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 1rem;
		font-size: var(--step--1);
		color: var(--color-muted);
		margin: var(--space-3) 0 0;
	}
	.hint a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--color-ink);
	}
	.purchase {
		display: grid;
		gap: var(--space-3);
	}
	.ask {
		width: 100%;
	}
	.purchase-note {
		margin: 0;
		font-size: var(--step--1);
		background: var(--color-notice-bg);
		border: 1px solid var(--color-notice-line);
		padding: var(--space-3) var(--space-4);
	}
	.selection-summary {
		margin: 0;
		font-size: var(--step--1);
		color: var(--color-muted);
	}
	.info {
		margin-top: var(--space-6);
	}
	.info section {
		border-top: 1px solid var(--color-line);
		padding-block: var(--space-4);
	}
	.info h2 {
		font-family: var(--font-body);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		margin-bottom: var(--space-2);
	}
	.info p {
		margin-bottom: var(--space-2);
	}
	.related {
		margin-top: var(--space-6);
	}
	.related-row {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-5);
	}
	@media (max-width: 960px) {
		.pdp {
			grid-template-columns: 1fr;
			gap: var(--space-5);
		}
		.related-row {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-5) var(--space-3);
		}
	}
</style>
