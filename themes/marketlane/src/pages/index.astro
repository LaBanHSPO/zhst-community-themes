---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import CampaignHero from "../components/CampaignHero.astro";
import ProductCard from "../components/ProductCard.astro";
import Icon from "../components/Icon.astro";
import { getTermOptions } from "../lib/catalog";

const [campaignsResult, featuredResult, newResult, categoriesResult] = await Promise.all([
	getEmDashCollection("campaigns", { orderBy: { sort_order: "asc" }, limit: 6 }),
	getEmDashCollection("products", { where: { featured: "1" }, orderBy: { created_at: "asc" }, limit: 4 }),
	getEmDashCollection("products", { where: { is_new: "1" }, orderBy: { created_at: "desc" }, limit: 4 }),
	getTermOptions("category"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(campaignsResult.cacheHint);
	Astro.cache.set(featuredResult.cacheHint);
	Astro.cache.set(newResult.cacheHint);
	Astro.cache.set(categoriesResult.cacheHint);
}

const campaigns = campaignsResult.entries;
const lead = campaigns[0] ?? null;
const favorites = featuredResult.entries;
const newArrivals = newResult.entries;
const categories = categoriesResult.options;
---

<Base title="Marketlane" description={lead?.data.intro ?? null}>
	{
		lead ? (
			<CampaignHero
				campaign={lead.data}
				ctaHref={`/collections/${encodeURIComponent(lead.id)}`}
				showValueProps
			/>
		) : (
			<section class="container section intro">
				<h1>New collections are on the way</h1>
				<p class="lede">
					Add a collection in the admin to feature it here, or <a href="/category">browse all products</a>.
				</p>
			</section>
		)
	}

	<section class="container section" aria-labelledby="favorites-heading">
		<div class="section-head">
			<h2 id="favorites-heading">Our favorites</h2>
			<a class="text-link" href="/category">Shop all <Icon name="arrow" size={18} /></a>
		</div>
		{
			favorites.length > 0 ? (
				<div class="product-row">
					{favorites.map((p, i) => (
						<ProductCard slug={p.id} product={p.data} priority={i < 2} />
					))}
				</div>
			) : (
				<p class="muted">Mark products as “Show in Our favorites” in the admin to list them here.</p>
			)
		}
	</section>

	{
		campaigns.length > 1 && (
			<section class="container section" aria-labelledby="collections-heading">
				<div class="section-head">
					<h2 id="collections-heading">Collections</h2>
					<a class="text-link" href="/collections">All collections <Icon name="arrow" size={18} /></a>
				</div>
				<ul class="campaign-row">
					{campaigns.slice(1, 3).map((c) => (
						<li class="campaign-card">
							<a href={`/collections/${encodeURIComponent(c.id)}`}>
								<div class="campaign-media">
									{c.data.hero_image && (c.data.hero_image.src || c.data.hero_image.id) ? (
										<Image image={c.data.hero_image} />
									) : (
										<div class="campaign-fallback" />
									)}
								</div>
								<div class="campaign-copy">
									{c.data.eyebrow && <p class="eyebrow">{c.data.eyebrow}</p>}
									<h3>{c.data.title}</h3>
									{c.data.intro && <p>{c.data.intro}</p>}
								</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		newArrivals.length > 0 && (
			<section class="container section" aria-labelledby="new-heading">
				<div class="section-head">
					<h2 id="new-heading">New arrivals</h2>
					<a class="text-link" href="/category?new=1">See what’s new <Icon name="arrow" size={18} /></a>
				</div>
				<div class="product-row">
					{newArrivals.map((p) => (
						<ProductCard slug={p.id} product={p.data} />
					))}
				</div>
			</section>
		)
	}

	{
		categories.length > 0 && (
			<section class="container section" aria-labelledby="categories-heading">
				<h2 id="categories-heading">Shop by category</h2>
				<ul class="category-list">
					{categories.map((c) => (
						<li>
							<a href={`/category/${encodeURIComponent(c.slug)}`}>
								{c.label}
								<Icon name="arrow" size={18} />
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="container section">
		<div class="ask-banner">
			<div>
				<h2>See something you like?</h2>
				<p>
					Online purchase is coming soon. Pick a colour and size on any product and send us your question;
					we reply by email.
				</p>
			</div>
			<a class="btn btn-secondary" href="/contact">Ask us about an item</a>
		</div>
	</section>
</Base>

<style>
	.muted {
		color: var(--color-muted);
	}
	.product-row {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-5);
	}
	.campaign-row {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-5);
	}
	.campaign-card a {
		display: block;
		color: inherit;
		text-decoration: none;
		background: var(--color-band);
		height: 100%;
	}
	.campaign-media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-tile);
	}
	.campaign-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.campaign-fallback {
		width: 100%;
		height: 100%;
		background: linear-gradient(120deg, #e4e2dd, #f4f3f0);
	}
	.campaign-copy {
		padding: var(--space-5);
	}
	.campaign-copy h3 {
		margin-bottom: var(--space-2);
	}
	.campaign-copy p:last-child {
		margin: 0;
		color: var(--color-muted);
	}
	.campaign-card a:hover h3 {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	.category-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
		gap: var(--space-3);
	}
	.category-list a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--color-line);
		color: var(--color-ink);
		text-decoration: none;
		font-weight: 500;
	}
	.category-list a:hover {
		border-color: var(--color-ink);
	}
	.ask-banner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-5);
		border-top: 1px solid var(--color-line);
		border-bottom: 1px solid var(--color-line);
		padding-block: var(--space-6);
	}
	.ask-banner p {
		margin: 0;
		color: var(--color-muted);
		max-width: 38rem;
	}
	@media (max-width: 960px) {
		.product-row {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-5) var(--space-3);
		}
	}
	@media (max-width: 640px) {
		.campaign-row {
			grid-template-columns: 1fr;
		}
	}
</style>
