---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import CampaignHero from "../../components/CampaignHero.astro";
import ProductListing from "../../components/ProductListing.astro";
import { getTermOptions, parseFilters, queryProducts } from "../../lib/catalog";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: campaign, cacheHint } = await getEmDashEntry("campaigns", slug);
if (!campaign) {
	return Astro.rewrite("/404");
}

// Products join a collection through the "collection" taxonomy term with the same slug.
const filters = parseFilters(Astro.url, { collection: campaign.id });
const [result, categories, settings] = await Promise.all([
	queryProducts(filters),
	getTermOptions("category"),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(result.cacheHint);
	Astro.cache.set(categories.cacheHint);
}

const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(campaign, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const basePath = `/collections/${encodeURIComponent(campaign.id)}`;
const hasStory = Array.isArray(campaign.data.story) && campaign.data.story.length > 0;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? campaign.data.intro ?? null}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "campaigns", id: campaign.data.id, slug }}
>
	<CampaignHero campaign={campaign.data} ctaHref="#collection-products" ctaLabel="See the pieces" />

	{
		hasStory && (
			<div class="container section story">
				<div class="prose">
					<PortableText value={campaign.data.story} />
				</div>
			</div>
		)
	}

	<div class="container" id="collection-products">
		<h2 class="listing-heading">In this collection</h2>
		<ProductListing
			basePath={basePath}
			label={campaign.data.title}
			filters={filters}
			fixedKeys={["collection"]}
			categories={categories.options}
			entries={result.entries}
			nextCursor={result.nextCursor}
		>
			<p slot="empty">
				This collection is still being put together. <a href="/contact">Ask us</a> to hear when it lands, or{" "}
				<a href="/collections">explore other collections</a>.
			</p>
		</ProductListing>
	</div>
</Base>

<style>
	.story {
		padding-bottom: 0;
	}
	.story .prose {
		font-size: var(--step-1);
		color: #3c4252;
	}
	.listing-heading {
		margin: var(--space-7) 0 var(--space-5);
	}
</style>
