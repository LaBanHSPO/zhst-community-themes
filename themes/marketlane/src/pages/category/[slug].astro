---
import { decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import ProductListing from "../../components/ProductListing.astro";
import { getTermOptions, parseFilters, queryProducts } from "../../lib/catalog";

const slug = decodeSlug(Astro.params.slug);
const [categories, departments] = await Promise.all([getTermOptions("category"), getTermOptions("department")]);
const term = slug ? categories.options.find((c) => c.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const filters = parseFilters(Astro.url, { category: term.slug });
const result = await queryProducts(filters);
if (Astro.cache?.enabled) {
	Astro.cache.set(categories.cacheHint);
	Astro.cache.set(departments.cacheHint);
	Astro.cache.set(result.cacheHint);
}
const basePath = `/category/${encodeURIComponent(term.slug)}`;
---

<Base
	title={term.label}
	description={`Shop ${term.label.toLowerCase()}: filter by department and price.`}
	canonical={new URL(basePath, Astro.url).href}
>
	<div class="container page-head">
		<nav aria-label="Breadcrumb" class="crumbs">
			<a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/category">Shop</a>{" "}
			<span aria-hidden="true">/</span> <span aria-current="page">{term.label}</span>
		</nav>
		<h1>{term.label}</h1>
		<ul class="category-tabs" aria-label="Categories">
			<li><a href="/category">All</a></li>
			{
				categories.options.map((c) => (
					<li>
						<a
							href={`/category/${encodeURIComponent(c.slug)}`}
							aria-current={c.slug === term.slug ? "page" : undefined}
						>
							{c.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
	<div class="container">
		<ProductListing
			basePath={basePath}
			label={term.label}
			filters={filters}
			fixedKeys={["category"]}
			departments={departments.options}
			entries={result.entries}
			nextCursor={result.nextCursor}
		>
			<p slot="empty">There are no {term.label.toLowerCase()} in the range right now.</p>
		</ProductListing>
	</div>
</Base>

<style>
	.category-tabs {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		margin: var(--space-4) 0 0;
	}
	.category-tabs a {
		display: inline-block;
		padding: 0.4rem 0.9rem;
		border: 1px solid var(--color-line);
		border-radius: 999px;
		color: var(--color-ink);
		text-decoration: none;
	}
	.category-tabs a:hover {
		border-color: var(--color-ink);
	}
	.category-tabs a[aria-current="page"] {
		background: var(--color-ink);
		border-color: var(--color-ink);
		color: #fff;
	}
</style>
