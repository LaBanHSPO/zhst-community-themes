---
import Base from "../../layouts/Base.astro";
import ProductListing from "../../components/ProductListing.astro";
import { getTermOptions, parseFilters, queryProducts } from "../../lib/catalog";

const filters = parseFilters(Astro.url);
const [result, categories, departments] = await Promise.all([
	queryProducts(filters),
	getTermOptions("category"),
	getTermOptions("department"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(result.cacheHint);
	Astro.cache.set(categories.cacheHint);
	Astro.cache.set(departments.cacheHint);
}

const department = departments.options.find((d) => d.slug === filters.department);
const activeCategory = categories.options.find((c) => c.slug === filters.category);
const heading = filters.newOnly
	? "New arrivals"
	: department
		? department.label
		: activeCategory
			? activeCategory.label
			: "All categories";
const intro = filters.newOnly
	? "The latest pieces to join the range."
	: department
		? `Everything in ${department.label.toLowerCase()}, across every category.`
		: "Every product in the range. Narrow it down by category, department or price.";
---

<Base title={heading} description={intro} canonical={new URL("/category", Astro.url).href}>
	<div class="container page-head">
		<nav aria-label="Breadcrumb" class="crumbs">
			<a href="/">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">{heading}</span>
		</nav>
		<h1>{heading}</h1>
		<p class="lede">{intro}</p>
	</div>
	<div class="container">
		<ProductListing
			basePath="/category"
			label="products"
			filters={filters}
			categories={categories.options}
			departments={departments.options}
			entries={result.entries}
			nextCursor={result.nextCursor}
		>
			<p slot="empty">No products have been published yet.</p>
		</ProductListing>
	</div>
</Base>

