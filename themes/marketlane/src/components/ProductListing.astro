---
/**
 * Filterable product listing. Filtering is a plain GET form: the server reads the query
 * (?category=&department=&min=&max=&new=&sort=), queries EmDash and renders the result,
 * so it works without JavaScript and every filtered view has a shareable URL.
 */
import type { Product } from "../../emdash-env";
import {
	filtersToQuery,
	hasActiveFilters,
	SORT_OPTIONS,
	type ProductFilters,
	type TermOption,
} from "../lib/catalog";
import ProductCard from "./ProductCard.astro";

interface Props {
	basePath: string;
	filters: ProductFilters;
	/** Filters pinned by the route; not shown as controls and kept out of URLs. */
	fixedKeys?: (keyof ProductFilters)[];
	categories?: TermOption[];
	departments?: TermOption[];
	entries: { id: string; data: Product }[];
	nextCursor?: string | null;
	label: string;
}

const {
	basePath,
	filters,
	fixedKeys = [],
	categories = [],
	departments = [],
	entries,
	nextCursor,
	label,
} = Astro.props;

const show = (k: keyof ProductFilters) => !fixedKeys.includes(k);
const active = hasActiveFilters(filters, fixedKeys);
const clearHref = basePath + (filters.sort !== "newest" ? `?sort=${filters.sort}` : "");
const unknownCategory =
	show("category") && filters.category != null && !categories.some((c) => c.slug === filters.category);
const unknownDepartment =
	show("department") && filters.department != null && !departments.some((d) => d.slug === filters.department);
const nextHref = nextCursor
	? basePath + filtersToQuery({ ...filters, cursor: null }, fixedKeys, { cursor: nextCursor })
	: null;
const firstHref = filters.cursor ? basePath + filtersToQuery({ ...filters, cursor: null }, fixedKeys) : null;

const pricePresets = [
	{ label: "Under $90", min: null, max: 89.99 },
	{ label: "$90 to $120", min: 90, max: 120 },
	{ label: "Over $120", min: 120.01, max: null },
];
const priceSummary =
	filters.min != null && filters.max != null
		? `$${filters.min} to $${filters.max}`
		: filters.min != null
			? `from $${filters.min}`
			: filters.max != null
				? `up to $${filters.max}`
				: null;
const activeLabels = [
	show("category") && filters.category
		? (categories.find((c) => c.slug === filters.category)?.label ?? filters.category)
		: null,
	show("department") && filters.department
		? (departments.find((d) => d.slug === filters.department)?.label ?? filters.department)
		: null,
	show("newOnly") && filters.newOnly ? "New arrivals" : null,
	priceSummary ? `Price ${priceSummary}` : null,
].filter(Boolean);
---

<div class="listing">
	<details class="filters-wrap" open data-filters data-active={active ? "true" : undefined}>
	<summary class="filters-summary">Filter and sort{active && <span class="summary-count"> ({activeLabels.length} active)</span>}</summary>
	<form class="filters" method="get" action={basePath} aria-label={`Filter ${label}`}>
		<h2 class="filters-title">Filter</h2>

		{
			show("category") && categories.length > 0 && (
				<fieldset>
					<legend>Category</legend>
					<label class="opt">
						<input type="radio" name="category" value="" checked={!filters.category} />
						<span>All categories</span>
					</label>
					{categories.map((c) => (
						<label class="opt">
							<input type="radio" name="category" value={c.slug} checked={filters.category === c.slug} />
							<span>{c.label}</span>
						</label>
					))}
				</fieldset>
			)
		}

		{
			show("department") && departments.length > 0 && (
				<fieldset>
					<legend>Department</legend>
					<label class="opt">
						<input type="radio" name="department" value="" checked={!filters.department} />
						<span>Everyone</span>
					</label>
					{departments.map((d) => (
						<label class="opt">
							<input type="radio" name="department" value={d.slug} checked={filters.department === d.slug} />
							<span>{d.label}</span>
						</label>
					))}
				</fieldset>
			)
		}

		<fieldset>
			<legend>Price (USD)</legend>
			<div class="price-row">
				<label>
					<span>Min</span>
					<input type="number" name="min" min="0" step="1" inputmode="numeric" value={filters.min ?? ""} />
				</label>
				<label>
					<span>Max</span>
					<input type="number" name="max" min="0" step="1" inputmode="numeric" value={filters.max ?? ""} />
				</label>
			</div>
			<ul class="presets" aria-label="Price shortcuts">
				{
					pricePresets.map((p) => (
						<li>
							<a
								href={
									basePath +
									filtersToQuery({ ...filters, min: p.min, max: p.max, cursor: null }, fixedKeys)
								}
								aria-current={filters.min === p.min && filters.max === p.max ? "true" : undefined}
							>
								{p.label}
							</a>
						</li>
					))
				}
			</ul>
		</fieldset>

		{
			show("newOnly") && (
				<label class="opt check">
					<input type="checkbox" name="new" value="1" checked={filters.newOnly} />
					<span>New arrivals only</span>
				</label>
			)
		}

		<label class="sort">
			<span>Sort by</span>
			<select name="sort">
				{SORT_OPTIONS.map((o) => (
					<option value={o.value} selected={filters.sort === o.value}>
						{o.label}
					</option>
				))}
			</select>
		</label>

		<div class="filter-actions">
			<button class="btn btn-primary" type="submit">Apply filters</button>
			{active && <a class="text-link" href={clearHref}>Clear filters</a>}
		</div>
	</form>
	</details>

	<section class="results" aria-labelledby="results-heading">
		<div class="results-head">
			<h2 id="results-heading" class="results-count" aria-live="polite">
				{entries.length === 0 ? "No products" : `${entries.length}${nextCursor ? "+" : ""} ${entries.length === 1 ? "product" : "products"}`}
			</h2>
			{
				activeLabels.length > 0 && (
					<p class="active-filters">
						<span class="sr-only">Active filters:</span>
						{activeLabels.map((l) => (
							<span class="chip">{l}</span>
						))}
						<a class="text-link" href={clearHref}>Clear filters</a>
					</p>
				)
			}
		</div>

		{
			entries.length === 0 ? (
				<div class="empty">
					{unknownCategory || unknownDepartment ? (
						<p>That filter does not match any category we carry.</p>
					) : active ? (
						<p>No products match these filters. Try a wider price range or another category.</p>
					) : (
						<slot name="empty">
							<p>Nothing to show here yet.</p>
						</slot>
					)}
					<p class="empty-actions">
						{active && <a class="btn btn-secondary" href={clearHref}>Clear filters</a>}
						<a class="text-link" href="/category">Browse all products</a>
					</p>
				</div>
			) : (
				<div class="grid">
					{entries.map((e, i) => (
						<ProductCard slug={e.id} product={e.data} priority={i < 4} />
					))}
				</div>
			)
		}

		{
			(nextHref || firstHref) && (
				<nav class="pager" aria-label="Pagination">
					{firstHref && <a class="text-link" href={firstHref}>First page</a>}
					{nextHref && <a class="btn btn-secondary" href={nextHref}>Next page</a>}
				</nav>
			)
		}
	</section>
</div>

<script>
	// On small screens start with the filter panel collapsed unless filters are applied.
	const mq = window.matchMedia("(max-width: 860px)");
	for (const el of document.querySelectorAll<HTMLDetailsElement>("details[data-filters]")) {
		if (mq.matches && !el.dataset.active) el.open = false;
	}
</script>

<style>
	.filters-summary {
		display: none;
	}
	.filters-wrap {
		position: sticky;
		top: 6rem;
	}
	.listing {
		display: grid;
		grid-template-columns: 15rem minmax(0, 1fr);
		gap: var(--space-7);
		align-items: start;
	}
	.filters {
		display: grid;
		gap: var(--space-5);
	}
	.filters-title {
		font-family: var(--font-body);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		margin: 0;
	}
	fieldset {
		border: 0;
		border-top: 1px solid var(--color-line);
		padding: var(--space-4) 0 0;
		margin: 0;
		display: grid;
		gap: 0.35rem;
	}
	legend {
		float: left;
		width: 100%;
		font-weight: 600;
		color: var(--color-ink);
		margin-bottom: 0.4rem;
	}
	.opt {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 2rem;
		cursor: pointer;
	}
	.opt input {
		width: 1.05rem;
		height: 1.05rem;
		accent-color: var(--color-accent);
		margin: 0;
	}
	.price-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-3);
	}
	.price-row label,
	.sort {
		display: grid;
		gap: 0.25rem;
		font-size: var(--step--1);
		color: var(--color-muted);
	}
	input[type="number"],
	select {
		width: 100%;
		min-height: 2.5rem;
		padding: 0.4rem 0.6rem;
		border: 1px solid #b9bcc4;
		border-radius: var(--radius);
		font: inherit;
		color: var(--color-ink);
		background: #fff;
	}
	.presets {
		list-style: none;
		padding: 0;
		margin: 0.4rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.presets a {
		display: inline-block;
		padding: 0.3rem 0.65rem;
		border: 1px solid var(--color-line);
		border-radius: 999px;
		color: var(--color-ink);
		text-decoration: none;
		font-size: var(--step--1);
	}
	.presets a:hover,
	.presets a[aria-current="true"] {
		border-color: var(--color-ink);
	}
	.presets a[aria-current="true"] {
		background: var(--color-ink);
		color: #fff;
	}
	.check {
		border-top: 1px solid var(--color-line);
		padding-top: var(--space-4);
	}
	.filter-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4);
	}
	.filter-actions .btn {
		min-height: 2.75rem;
		padding: 0.5rem 1.25rem;
		font-size: 0.95rem;
	}
	.results-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		margin-bottom: var(--space-5);
	}
	.results-count {
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 500;
		color: var(--color-muted);
		margin: 0;
	}
	.active-filters {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
	}
	.chip {
		background: var(--color-tile);
		color: var(--color-ink);
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		font-size: var(--step--1);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
		gap: var(--space-6) var(--space-5);
	}
	.empty {
		border: 1px dashed #c9cbd1;
		padding: var(--space-7) var(--space-5);
		text-align: center;
	}
	.empty p {
		margin-inline: auto;
		max-width: 32rem;
	}
	.empty-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: var(--space-5);
		margin: var(--space-5) 0 0;
	}
	.pager {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: var(--space-5);
		margin-top: var(--space-7);
	}
	@media (max-width: 860px) {
		.listing {
			grid-template-columns: 1fr;
			gap: var(--space-5);
		}
		.filters-wrap {
			position: static;
			border: 1px solid var(--color-line);
		}
		.filters-summary {
			display: block;
			padding: var(--space-3) var(--space-4);
			font-weight: 600;
			color: var(--color-ink);
			cursor: pointer;
		}
		.summary-count {
			font-weight: 400;
			color: var(--color-muted);
		}
		.filters {
			padding: 0 var(--space-4) var(--space-4);
		}
		.filters-title {
			display: none;
		}
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-5) var(--space-3);
		}
	}
</style>
