---
import { Image } from "emdash/ui";
import type { Campaign } from "../../emdash-env";
import Icon from "./Icon.astro";

interface Props {
	/** The campaign headline renders as the page's h1. */
	campaign: Campaign;
	ctaHref?: string | null;
	ctaLabel?: string;
	showValueProps?: boolean;
}

const { campaign, ctaHref, ctaLabel = "Shop the collection", showValueProps = false } = Astro.props;
const headline = campaign.headline || campaign.title;
const noteWords = (campaign.vertical_note ?? "").trim().split(/\s+/).filter(Boolean);
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="hero-copy">
		{campaign.eyebrow && <p class="eyebrow">{campaign.eyebrow}</p>}
		<h1 id="hero-heading">{headline}</h1>
		{campaign.intro && <p class="hero-intro">{campaign.intro}</p>}
		{
			ctaHref && (
				<a class="btn btn-primary" href={ctaHref}>
					{ctaLabel}
					<Icon name="arrow" size={20} />
				</a>
			)
		}
		{
			showValueProps && (
				<ul class="value-props">
					<li>
						<Icon name="leaf" size={30} />
						<span>Thoughtful materials</span>
					</li>
					<li>
						<Icon name="ruler" size={30} />
						<span>Size guide for every piece</span>
					</li>
					<li>
						<Icon name="chat" size={30} />
						<span>Questions answered by email</span>
					</li>
				</ul>
			)
		}
	</div>
	<div class="hero-media">
		{
			campaign.hero_image && (campaign.hero_image.src || campaign.hero_image.id) ? (
				<Image image={campaign.hero_image} priority />
			) : (
				<div class="hero-fallback" />
			)
		}
		{
			noteWords.length > 0 && (
				<p class="hero-note">
					{noteWords.map((w) => (
						<span>{w}</span>
					))}
				</p>
			)
		}
	</div>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
		background: var(--color-band);
		min-height: clamp(28rem, 40vw, 34rem);
	}
	.hero-copy {
		align-self: center;
		padding: var(--space-7) var(--space-6) var(--space-7) max(var(--gutter), calc((100vw - var(--max)) / 2));
	}
	.hero-copy h1 {
		max-width: 12ch;
		margin-bottom: var(--space-4);
	}
	.hero-intro {
		font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
		color: #4a5060;
		max-width: 30rem;
		margin-bottom: var(--space-6);
	}
	.value-props {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-5) var(--space-6);
		padding: 0;
		margin: var(--space-6) 0 0;
	}
	.value-props li {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		max-width: 11rem;
		font-size: 0.875rem;
		line-height: 1.35;
		color: #3c4252;
	}
	.value-props :global(svg) {
		flex: none;
		color: var(--color-ink);
	}
	.hero-media {
		position: relative;
		min-height: 18rem;
		overflow: hidden;
	}
	.hero-media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		object-position: 30% center;
	}
	.hero-fallback {
		position: absolute;
		inset: 0;
		background: linear-gradient(120deg, #e4e2dd, #f4f3f0);
	}
	.hero-note {
		position: absolute;
		top: 18%;
		right: 22%;
		display: grid;
		gap: 0.45rem;
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.42em;
		text-transform: uppercase;
		color: #3c4252;
		padding: 0.5rem 0.25rem 1.25rem;
	}
	.hero-note::after {
		content: "";
		width: 2.75rem;
		border-top: 1px solid currentColor;
		margin-top: 0.9rem;
	}
	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
		}
		.hero-copy {
			padding: var(--space-6) var(--gutter);
			order: 2;
		}
		.hero-media {
			aspect-ratio: 4 / 3;
			min-height: 0;
		}
		.hero-note {
			display: none;
		}
	}
</style>
