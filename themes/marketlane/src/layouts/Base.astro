---
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "../styles/theme.css";
import {
	getEmDashCollection,
	getMenuWithCacheHint,
	getSiteSettingsWithCacheHint,
} from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import Icon from "../components/Icon.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } = Astro.props;
const [settingsResult, menuResult, footerMenuResult, contactsResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getMenuWithCacheHint("footer"),
	getEmDashCollection("contacts", { limit: 1, orderBy: { created_at: "asc" } }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(footerMenuResult.cacheHint);
	Astro.cache.set(contactsResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menuItems = menuResult.data?.items ?? [];
const footerItems = footerMenuResult.data?.items ?? [];
const contact = contactsResult.entries[0]?.data ?? null;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentFull = currentPath + Astro.url.search;
function isCurrent(url: string): boolean {
	if (!url.startsWith("/")) return false;
	return url.includes("?") ? url === currentFull : url === currentPath;
}

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<div class="container header-inner">
				<a class="wordmark" href="/" aria-label={`${siteTitle} home`}>
					{
						siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="logo" />
						) : (
							<span>{siteTitle}</span>
						)
					}
				</a>

				<button
					class="icon-btn menu-toggle"
					type="button"
					aria-expanded="false"
					aria-controls="site-nav"
					data-menu-toggle
				>
					<Icon name="menu" size={24} class="when-closed" />
					<Icon name="close" size={24} class="when-open" />
					<span class="sr-only">Menu</span>
				</button>

				<nav id="site-nav" class="site-nav" aria-label="Primary">
					<ul>
						{
							menuItems.map((item) => (
								<li>
									<a
										href={item.url}
										target={item.target}
										rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
										aria-current={isCurrent(item.url) ? "page" : undefined}
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<div class="header-actions">
					<button
						class="icon-btn search-toggle"
						type="button"
						aria-expanded="false"
						aria-controls="site-search"
						data-search-toggle
					>
						<Icon name="search" size={24} />
						<span class="sr-only">Search</span>
					</button>
					<a class="icon-btn" href="/contact" aria-current={currentPath === "/contact" ? "page" : undefined}>
						<Icon name="chat" size={24} />
						<span class="sr-only">Contact us</span>
					</a>
				</div>
			</div>
			<div id="site-search" class="search-panel" hidden>
				<div class="container">
					<LiveSearch
						placeholder="Search products and collections"
						collections={["products", "campaigns", "pages"]}
					/>
				</div>
			</div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-grid">
				<div>
					<p class="wordmark footer-wordmark">{siteTitle}</p>
					<p class="footer-tagline">{siteTagline}</p>
				</div>
				{
					footerItems.length > 0 && (
						<nav aria-label="Footer">
							<h2 class="footer-heading">Explore</h2>
							<ul>
								{footerItems.map((item) => (
									<li>
										<a href={item.url}>{item.label}</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
				{
					contact && (
						<div>
							<h2 class="footer-heading">Get in touch</h2>
							<ul class="footer-contact">
								{contact.email && (
									<li>
										<a href={`mailto:${contact.email}`}>{contact.email}</a>
									</li>
								)}
								{contact.phone && (
									<li>
										<a href={`tel:${contact.phone.replace(/[^+\d]/g, "")}`}>{contact.phone}</a>
									</li>
								)}
							</ul>
						</div>
					)
				}
				<div>
					<h2 class="footer-heading">Ordering</h2>
					<p class="footer-note">
						Online purchase is coming soon. {siteTitle} does not take orders or payments on this site yet;{" "}
						<a href="/contact">ask us about any item</a>.
					</p>
				</div>
			</div>
			<div class="container footer-base">
				<p>© {year} {siteTitle}. Sample content for a theme preview.</p>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			const header = document.querySelector<HTMLElement>(".site-header");
			const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
			const searchBtn = document.querySelector<HTMLButtonElement>("[data-search-toggle]");
			const searchPanel = document.getElementById("site-search");

			function setMenu(open: boolean) {
				if (!menuBtn || !header) return;
				menuBtn.setAttribute("aria-expanded", String(open));
				header.classList.toggle("menu-open", open);
			}
			menuBtn?.addEventListener("click", () => {
				setMenu(menuBtn.getAttribute("aria-expanded") !== "true");
			});

			function setSearch(open: boolean) {
				if (!searchBtn || !searchPanel) return;
				searchBtn.setAttribute("aria-expanded", String(open));
				searchPanel.hidden = !open;
				if (open) searchPanel.querySelector<HTMLInputElement>("input")?.focus();
			}
			searchBtn?.addEventListener("click", () => {
				setSearch(searchBtn.getAttribute("aria-expanded") !== "true");
			});
			// The search input ships without a label; name it for assistive technology.
			searchPanel?.querySelector("input")?.setAttribute("aria-label", "Search products and collections");

			document.addEventListener("keydown", (event) => {
				if (event.key !== "Escape") return;
				if (searchBtn?.getAttribute("aria-expanded") === "true") {
					setSearch(false);
					searchBtn.focus();
				} else if (menuBtn?.getAttribute("aria-expanded") === "true") {
					setMenu(false);
					menuBtn.focus();
				}
			});
		</script>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		left: 1rem;
		top: -3rem;
		z-index: 100;
		background: var(--color-ink);
		color: #fff;
		padding: 0.6rem 1rem;
	}
	.skip-link:focus {
		top: 1rem;
	}
	main:focus {
		outline: none;
	}
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: #fff;
		border-bottom: 1px solid var(--color-line);
	}
	.header-inner {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		min-height: 4.75rem;
	}
	.wordmark {
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 1.3rem;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--color-ink);
		text-decoration: none;
		margin: 0;
		white-space: nowrap;
	}
	.logo {
		height: 40px;
		width: auto;
	}
	.site-nav {
		flex: 1;
		display: flex;
		justify-content: center;
	}
	.site-nav ul {
		list-style: none;
		display: flex;
		gap: clamp(1rem, 3vw, 2.75rem);
		margin: 0;
		padding: 0;
	}
	.site-nav a {
		color: var(--color-ink);
		text-decoration: none;
		font-size: 1rem;
		padding: 0.5rem 0;
		border-bottom: 1px solid transparent;
	}
	.site-nav a:hover,
	.site-nav a[aria-current="page"] {
		border-bottom-color: currentColor;
	}
	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.icon-btn {
		display: inline-grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		background: none;
		border: 0;
		color: var(--color-ink);
		cursor: pointer;
		border-radius: var(--radius);
	}
	.icon-btn:hover {
		background: var(--color-tile);
	}
	.menu-toggle {
		display: none;
	}
	.menu-toggle :global(.when-open) {
		display: none;
	}
	.menu-open .menu-toggle :global(.when-open) {
		display: block;
	}
	.menu-open .menu-toggle :global(.when-closed) {
		display: none;
	}
	.search-panel {
		border-top: 1px solid var(--color-line);
		padding-block: var(--space-4);
		background: #fff;
	}
	.search-panel :global(.emdash-live-search) {
		position: relative;
		max-width: 40rem;
	}
	.search-panel :global(.emdash-live-search-input) {
		width: 100%;
		min-height: 3rem;
		padding: 0.6rem 0.9rem;
		font: inherit;
		border: 1px solid #b9bcc4;
		border-radius: var(--radius);
	}
	.search-panel :global(.emdash-live-search-results) {
		position: absolute;
		inset: 100% 0 auto 0;
		background: #fff;
		border: 1px solid var(--color-line);
		box-shadow: 0 12px 30px rgba(15, 26, 43, 0.12);
		max-height: 60vh;
		overflow: auto;
		z-index: 5;
	}
	.search-panel :global(.emdash-live-search-result) {
		display: grid;
		gap: 0.15rem;
		padding: 0.75rem 1rem;
		color: var(--color-ink);
		text-decoration: none;
		border-bottom: 1px solid var(--color-line);
	}
	.search-panel :global(.emdash-live-search-result-collection) {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-muted);
	}
	.search-panel :global(.emdash-live-search-loading),
	.search-panel :global(.emdash-live-search-no-results) {
		padding: 0.75rem 1rem;
		color: var(--color-muted);
	}

	.site-footer {
		margin-top: var(--space-8);
		background: var(--color-ink);
		color: #d4d8e0;
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
		gap: var(--space-6);
		padding-block: var(--space-7);
	}
	.footer-wordmark {
		color: #fff;
		font-size: 1.1rem;
	}
	.footer-tagline {
		margin-top: var(--space-3);
		max-width: 18rem;
	}
	.footer-heading {
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #fff;
		margin-bottom: var(--space-3);
	}
	.site-footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.4rem;
	}
	.site-footer a {
		color: #fff;
	}
	.footer-note {
		margin: 0;
	}
	.footer-base {
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		padding-block: var(--space-4);
		font-size: var(--step--1);
	}
	.footer-base p {
		margin: 0;
	}
	.site-footer :focus-visible {
		outline-color: #fff;
	}

	@media (max-width: 960px) {
		.header-inner {
			flex-wrap: wrap;
			gap: 0 var(--space-2);
			min-height: 4rem;
		}
		.wordmark {
			font-size: 1.05rem;
			letter-spacing: 0.26em;
			flex: 1;
		}
		.menu-toggle {
			display: inline-grid;
			order: 3;
		}
		.header-actions {
			order: 2;
			gap: 0;
		}
		.site-nav {
			order: 4;
			flex-basis: 100%;
			justify-content: flex-start;
		}
		:global(.js) .site-nav {
			display: none;
		}
		:global(.js) .menu-open .site-nav {
			display: flex;
		}
		.site-nav ul {
			flex-direction: column;
			gap: 0;
			width: 100%;
			padding-bottom: var(--space-3);
		}
		.site-nav a {
			display: block;
			padding: 0.85rem 0;
			border-bottom: 1px solid var(--color-line);
			font-size: 1.05rem;
		}
		.site-nav a[aria-current="page"] {
			font-weight: 600;
		}
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 520px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
