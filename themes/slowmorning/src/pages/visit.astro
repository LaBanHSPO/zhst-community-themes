---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Icon from "../components/Icon.astro";
import { getVenue } from "../lib/cafe";

const [{ venue, cacheHint }, hoursResult, directionsResult] = await Promise.all([
	getVenue(),
	getEmDashCollection("hours", { orderBy: { position: "asc" }, limit: 14 }),
	getEmDashCollection("directions", { orderBy: { position: "asc" }, limit: 8 }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(hoursResult.cacheHint);
	Astro.cache.set(directionsResult.cacheHint);
}
const hours = hoursResult.entries;
const directions = directionsResult.entries;
const query = [venue.street, venue.locality, venue.country].filter(Boolean).join(", ");
const directionsUrl =
	venue.directions_url || `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(query)}`;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
---

<Base title="Visit" description="Opening hours, address and walking or cycling directions to the café." overlay>
	<section class="hero hero-visit" style="--hero-img:url('/images/hero-visit.webp')" aria-labelledby="visit-title">
		<div class="hero-copy">
			<h1 id="visit-title">Come say<br />hello.</h1>
			<p class="hero-lede">Great coffee, fresh bakes and a welcoming space, right in the heart of the neighbourhood.</p>
			<a class="btn" href="#map">Find us on the map <Arrow /></a>
		</div>
	</section>

	<section class="visit-info" aria-label="Visiting details">
		<div class="visit-grid">
			<section class="visit-col" aria-labelledby="hours-title">
				<span class="icon-disc icon-disc-pist"><Icon name="clock" /></span>
				<div>
					<h2 id="hours-title">Opening hours</h2>
					<table class="hours-table">
						<caption class="sr-only">Opening hours</caption>
						<tbody>
							{
								hours.map((h) => (
									<tr>
										<th scope="row">{h.data.title}</th>
										<td>{h.data.hours}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</section>
			<section class="visit-col" aria-labelledby="address-title">
				<span class="icon-disc icon-disc-pist"><Icon name="pin" /></span>
				<div>
					<h2 id="address-title">Our address</h2>
					<address>
						{venue.street && <>{venue.street}<br /></>}
						{venue.locality && <>{venue.locality}<br /></>}
						{venue.country}
					</address>
					<a class="btn btn-sm" href={directionsUrl} target="_blank" rel="noopener noreferrer">
						Get directions <Arrow /><span class="sr-only"> (opens Google Maps in a new tab)</span>
					</a>
				</div>
			</section>
			<section class="visit-col" aria-labelledby="route-title">
				<span class="icon-disc icon-disc-pist"><Icon name="bike" /></span>
				<div>
					<h2 id="route-title">How to get here</h2>
					<ul class="routes">
						{
							directions.map((r) => (
								<li>
									<Icon name={r.data.mode ?? "walk"} class="route-icon" />
									<div>
										<h3>{r.data.title}</h3>
										{r.data.text && <p>{r.data.text}</p>}
									</div>
								</li>
							))
						}
					</ul>
				</div>
			</section>
			<a class="map" id="map" href={mapUrl} target="_blank" rel="noopener noreferrer" aria-label={`Open ${venue.title} on Google Maps (new tab)`}>
				<svg viewBox="0 0 435 217" aria-hidden="true" focusable="false">
					<rect width="435" height="217" fill="#efeadf" />
					<path d="M300 0 L435 110 L435 70 L340 0Z M0 150 L120 217 L60 217 L0 185Z" fill="#a9c7d6" opacity=".8" />
					<path d="M250 0 C300 60 360 90 435 150 M210 0 C260 70 330 120 435 190 M160 0 C210 80 290 150 380 217" stroke="#b9d0dc" stroke-width="6" fill="none" />
					<path d="M330 160 l40 -20 l30 40 l-40 20Z M380 60 l25 -10 l15 25 l-25 10Z M60 30 l30 -10 l18 28 l-30 10Z" fill="#cfd8b8" />
					<g stroke="#fff" stroke-width="5" fill="none">
						<path d="M0 60 L435 20 M0 120 L435 90 M0 190 L435 160 M90 0 L60 217 M180 0 L170 217 M270 0 L290 217 M360 0 L400 217" />
					</g>
					<g stroke="#ddd5c6" stroke-width="1.4" fill="none">
						<path d="M0 90 L435 55 M0 155 L435 125 M45 0 L15 217 M135 0 L115 217 M225 0 L230 217 M315 0 L345 217" />
					</g>
					<text x="76" y="166" font-family="Newsreader, Georgia, serif" font-size="15" fill="#2c2b25">{venue.map_district ?? ""}</text>
					<text x="286" y="56" font-family="Newsreader, Georgia, serif" font-size="12" fill="#2c2b25">{venue.map_station ?? ""}</text>
					<g transform="translate(196 76)">
						<path d="M0 -26 C-11 -26 -16 -18 -16 -11 C-16 -1 0 14 0 14 C0 14 16 -1 16 -11 C16 -18 11 -26 0 -26Z" fill="#4b5039" />
						<circle cx="0" cy="-12" r="5" fill="#efeadf" />
					</g>
					<text x="198" y="122" font-family="Newsreader, Georgia, serif" font-size="17" fill="#1e2318">{venue.title}</text>
					<text x="217" y="135" font-family="Jost, sans-serif" font-size="6.5" letter-spacing="1.5" fill="#1e2318">CAFÉ &amp; BAKERY</text>
				</svg>
				<span class="sr-only">Map showing {venue.title} near {venue.map_station}</span>
			</a>
		</div>
	</section>

	<section class="split" aria-labelledby="slow-title">
		<img class="split-photo" src="/images/visit-interior.webp" alt="The long café room with wooden tables and green banquettes" width="975" height="222" loading="lazy" />
		<div class="split-copy">
			<span class="eyebrow">Our space</span>
			<h2 id="slow-title">A place to slow down.</h2>
			<p>Whether you're meeting a friend, catching up on work or just enjoying a quiet moment, you're always welcome at {venue.title}.</p>
			<a class="btn" href="/our-space">Explore our space <Arrow /></a>
		</div>
	</section>
</Base>
