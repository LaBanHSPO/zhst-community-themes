---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound container">
		<span class="eyebrow">404</span>
		<h1>This table is empty.</h1>
		<p>The page you're looking for doesn't exist or has moved. Take a breath — the coffee is still warm.</p>
		<div class="actions">
			<a class="btn" href="/menu">See our menu <Arrow /></a>
			<a class="btn btn-outline-dark" href="/">Back to the homepage</a>
		</div>
	</section>
</Base>
