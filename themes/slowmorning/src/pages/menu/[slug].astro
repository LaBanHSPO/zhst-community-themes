---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Icon from "../../components/Icon.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getVenue, photoSrc, sectionLabel } from "../../lib/cafe";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: item, cacheHint } = await getEmDashEntry("items", slug);
if (!item) return Astro.redirect("/404");
const [{ venue, cacheHint: venueHint }, settings] = await Promise.all([getVenue(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(venueHint);
}

const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(item, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const d = item.data;
const mainSrc = photoSrc(d.image, d.photo);
const mainAlt = d.image?.alt || d.title;
const gallery = (d.gallery ?? [])
	.map((g) => ({ src: photoSrc(g.image, g.photo), alt: g.alt || d.title }))
	.filter((g): g is { src: string; alt: string } => Boolean(g.src));
const slides = gallery.length > 0 ? gallery : mainSrc ? [{ src: mainSrc, alt: mainAlt }] : [];
const first = mainSrc ? { src: mainSrc, alt: mainAlt } : slides[0];
const sizes = (d.sizes ?? []).filter((s) => s.label);
const isCake = d.category === "cakes";
const eyebrow = d.eyebrow || sectionLabel(d.category);
// Earliest collection date: two days from today (Asia/Saigon), as preorders need baking time.
const minDate = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Saigon" }).format(
	new Date(Date.now() + 2 * 24 * 60 * 60 * 1000),
);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? d.summary ?? null}
	canonical={seo.canonical}
	image={seo.ogImage ?? mainSrc ?? null}
	content={{ collection: "items", id: d.id, slug }}
	current={isCake ? undefined : "/menu"}
	detailNav={isCake}
>
	<article class:list={["item-detail", { "is-compact": !isCake }]}>
		<div class="item-media" data-gallery>
			<div class="item-main">
				{first && <img data-main src={first.src} alt={first.alt} width="1010" height="608" />}
			</div>
			{
				slides.length > 1 && (
					<div class="thumb-row" role="group" aria-label="Photos">
						{slides.map((s, i) => (
							<button
								class="thumb"
								type="button"
								data-src={s.src}
								data-alt={s.alt}
								aria-pressed={i === 0 ? "true" : "false"}
								aria-label={`Show photo ${i + 1}: ${s.alt}`}
							>
								<img src={s.src} alt="" loading="lazy" />
							</button>
						))}
					</div>
				)
			}
		</div>

		<div class="item-info">
			<span class="eyebrow">{eyebrow}</span>
			<h1 {...item.edit.title}>{d.title}</h1>
			<p class="price-lg">{d.price}</p>
			{d.description && <p class="desc" {...item.edit.description}>{d.description}</p>}

			{
				(d.ingredients || d.allergens) && (
					<div class="facts">
						{d.ingredients && (
							<section aria-labelledby="ing-title">
								<h2 id="ing-title" class="eyebrow">Ingredients</h2>
								<p>{d.ingredients}</p>
							</section>
						)}
						{d.allergens && (
							<section aria-labelledby="alg-title">
								<h2 id="alg-title" class="eyebrow">Allergens</h2>
								<p class="pre">{d.allergens}</p>
							</section>
						)}
					</div>
				)
			}

			{
				sizes.length > 0 ? (
					<form
						class="preorder"
						data-preorder
						data-email={venue.email}
						data-item={d.title}
						data-price={d.price}
						action={`mailto:${venue.email}?subject=${encodeURIComponent(`Cake preorder: ${d.title}`)}`}
						method="post"
						enctype="text/plain"
					>
						<fieldset class="sizes">
							<legend class="eyebrow">Choose size</legend>
							<div class="size-grid">
								{sizes.map((s, i) => (
									<label class="size">
										<input type="radio" name="size" value={`${s.label}${s.serves ? ` (${s.serves})` : ""}`} checked={i === 0} required />
										<span class="size-text">
											<span>{s.label}</span>
											{s.serves && <span class="serves">{s.serves}</span>}
										</span>
									</label>
								))}
							</div>
						</fieldset>
						<label class="eyebrow" for="collect-date">Preferred collection date</label>
						<div class="date-field">
							<Icon name="calendar" class="cal" />
							<span class="ph-text" aria-hidden="true">Select date</span>
							<input id="collect-date" name="date" type="date" min={minDate} required aria-describedby="date-hint" />
							<Icon name="chevron" class="chev" />
						</div>
						<p id="date-hint" class="sr-only">Preorders need at least two days' notice.</p>
						<button class="btn btn-block btn-lg" type="submit">Request preorder <Arrow /></button>
						<p class="form-note">We'll confirm availability and get back to you shortly.</p>
						<p class="form-status" role="status" aria-live="polite" data-status>
							<noscript>
								To preorder, email <a href={`mailto:${venue.email}`}>{venue.email}</a> with the cake, size and collection date.
							</noscript>
						</p>
					</form>
				) : (
					<div class="counter-note">
						<p>Available daily at the counter while it lasts — no need to order ahead.</p>
						<a class="link-arrow" href="/menu">Back to the menu <Arrow /></a>
					</div>
				)
			}
		</div>
	</article>
</Base>

<script>
	// Thumbnail gallery: swap the main photo.
	document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
		const main = root.querySelector<HTMLImageElement>("[data-main]");
		const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>(".thumb"));
		if (!main) return;
		thumbs.forEach((b) =>
			b.addEventListener("click", () => {
				main.src = b.dataset.src ?? main.src;
				main.alt = b.dataset.alt ?? main.alt;
				thumbs.forEach((t) => t.setAttribute("aria-pressed", String(t === b)));
			}),
		);
	});

	// Preorder request: compose an email to the café. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-preorder]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Preorders are not available online right now. Please ask at the counter.";
				return;
			}
			const data = new FormData(form);
			const size = String(data.get("size") ?? "");
			const date = String(data.get("date") ?? "");
			const subject = `Cake preorder: ${form.dataset.item} — ${size}`;
			const body = `Hello,\n\nI would like to preorder:\n\nCake: ${form.dataset.item} (from ${form.dataset.price})\nSize: ${size}\nPreferred collection date: ${date}\n\nName:\nPhone:\nMessage on the cake (optional):\n`;
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			status.textContent =
				"Your email app should open with this preorder ready to send. It is only sent once you send that email. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
