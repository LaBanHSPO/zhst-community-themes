---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Icon from "../../components/Icon.astro";
import { SECTIONS, getItems, itemUrl, photoSrc } from "../../lib/cafe";

const { entries: items, cacheHint } = await getItems();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const groups = SECTIONS.map((s) => ({ ...s, items: items.filter((i) => i.data.category === s.slug) })).filter(
	(g) => g.items.length > 0,
);
// The design shows Coffee and Bakery, then the specials band; whole cakes follow below it.
const daily = groups.filter((g) => g.slug !== "cakes");
const cakes = groups.find((g) => g.slug === "cakes");
const tabs = daily.map((g) => ({ slug: g.slug, label: g.label }));
const specials = items.filter((i) => i.data.special);
---

<Base
	title="Our menu"
	description="Specialty coffee, handmade bakes and simple, seasonal food — plus whole cakes to preorder."
	overlay
>
	<section class="hero hero-menu" style="--hero-img:url('/images/hero-menu.webp')" aria-labelledby="menu-title">
		<div class="hero-copy">
			<h1 id="menu-title">Our menu</h1>
			<p class="hero-lede">Specialty coffee, handmade bakes <br />and simple, seasonal food.</p>
		</div>
	</section>

	<div class="menu-wrap">
		<div class="menu-bar">
			<nav class="menu-tabs" aria-label="Menu sections" data-tabs>
				{
					tabs.map((t, i) => (
						<a href={`#${t.slug}`} data-tab={t.slug} class:list={{ "is-active": i === 0 }}>
							{t.label}
						</a>
					))
				}
			</nav>
			{
				specials.length > 0 && (
					<details class="specials-menu" id="house-specials">
						<summary>
							<Icon name="leaf" class="leaf" />
							House specials
							<Icon name="chevron" class="chev" />
						</summary>
						<ul>
							{specials.map((s) => (
								<li>
									<a href={itemUrl(s.data)}>
										<span>{s.data.title}</span>
										<span class="price">{s.data.price}</span>
									</a>
								</li>
							))}
						</ul>
					</details>
				)
			}
		</div>

		{daily.length === 0 && <p class="empty">Add menu items in the admin to fill this page.</p>}
		{
			daily.map((g) => (
				<section class="menu-section" id={g.slug} aria-labelledby={`${g.slug}-title`} data-section={g.slug}>
					<div class="menu-head">
						<h2 id={`${g.slug}-title`}>{g.label}</h2>
						<span class="eyebrow">{g.note}</span>
					</div>
					<ul class:list={["card-row", `is-${g.slug}`]}>
						{g.items.map((item) => {
							const src = photoSrc(item.data.image, item.data.photo);
							return (
								<li>
									<a class="product" href={itemUrl(item.data)}>
										<div class="ph">{src && <img src={src} alt={item.data.image?.alt || item.data.title} loading="lazy" />}</div>
										<h3 {...item.edit.title}>{item.data.title}</h3>
										{item.data.summary && <p>{item.data.summary}</p>}
										<p class="price">{item.data.price}</p>
									</a>
								</li>
							);
						})}
					</ul>
				</section>
			))
		}
	</div>

	<section class="specials-band" aria-labelledby="specials-title">
		<div class="specials-copy">
			<span class="eyebrow">Our specials</span>
			<h2 id="specials-title">Seasonal flavours, made with care.</h2>
			<div class="specials-row">
				<p>A rotating selection of drinks and bakes inspired by the best ingredients of the season.</p>
				<a class="btn btn-outline" href={specials.length > 0 ? "#house-specials" : "#bakery"} data-open-specials>View house specials <Arrow /></a>
			</div>
		</div>
		<img src="/images/specials-cake.webp" alt="Lemon pistachio loaf slice on a speckled plate" loading="lazy" />
	</section>

	{
		cakes && (
			<section class="menu-wrap menu-section cakes-section" id="cakes" aria-labelledby="cakes-title">
				<div class="menu-head">
					<h2 id="cakes-title">{cakes.label}</h2>
					<span class="eyebrow">{cakes.note}</span>
				</div>
				<ul class="cake-row">
					{cakes.items.map((item) => {
						const src = photoSrc(item.data.image, item.data.photo);
						return (
							<li>
								<a class="cake-card" href={itemUrl(item.data)}>
									<div class="ph">{src && <img src={src} alt={item.data.image?.alt || item.data.title} loading="lazy" />}</div>
									<div>
										<h3>{item.data.title}</h3>
										{item.data.summary && <p>{item.data.summary}</p>}
										<p class="price">From {item.data.price}</p>
										<span class="link-arrow">Request preorder <Arrow /></span>
									</div>
								</a>
							</li>
						);
					})}
				</ul>
			</section>
		)
	}
</Base>

<script>
	// Section tabs are in-page anchors; underline the tab of the section being read.
	const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-tabs] [data-tab]"));
	const sections = tabs
		.map((t) => document.getElementById(t.dataset.tab ?? ""))
		.filter((s): s is HTMLElement => Boolean(s));
	const mark = (slug: string) => tabs.forEach((t) => t.classList.toggle("is-active", t.dataset.tab === slug));
	if (tabs.length && sections.length && "IntersectionObserver" in window) {
		const io = new IntersectionObserver(
			(entries) => {
				const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
				if (visible[0]) mark((visible[0].target as HTMLElement).id);
			},
			{ rootMargin: "-30% 0px -55% 0px" },
		);
		sections.forEach((s) => io.observe(s));
	}
	tabs.forEach((t) => t.addEventListener("click", () => mark(t.dataset.tab ?? "")));

	// "View house specials" scrolls to the specials dropdown and opens it.
	const specials = document.querySelector<HTMLDetailsElement>("#house-specials");
	document.querySelectorAll<HTMLAnchorElement>("[data-open-specials]").forEach((a) =>
		a.addEventListener("click", () => {
			if (specials) specials.open = true;
		}),
	);
</script>
