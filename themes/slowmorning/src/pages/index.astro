---
import { getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getFeatures, photoSrc } from "../lib/cafe";

const { entries: highlights, cacheHint } = await getFeatures("home");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
---

<Base title={siteTitle} description="Specialty coffee, homemade bakes and a calmer kind of day." overlay>
	<section class="hero hero-home" style="--hero-img:url('/images/hero-home.webp')" aria-labelledby="hero-title">
		<div class="hero-copy">
			<h1 id="hero-title">Your daily <br />pause.</h1>
			<p class="hero-lede">Specialty coffee, homemade bakes <br />and a calmer kind of day.</p>
			<a class="btn" href="/menu">See our menu <Arrow /></a>
		</div>
	</section>

	{
		highlights.length > 0 && (
			<section class="trio" aria-label="What we do">
				<ul class="container trio-list">
					{highlights.map((h) => {
						const src = photoSrc(h.data.image, h.data.photo);
						const inner = (
							<>
								{src && <img class="trio-photo" src={src} alt={h.data.image?.alt || ""} width="130" height="130" loading="lazy" />}
								<div class="trio-copy">
									<h2 {...h.edit.title}>{h.data.title}</h2>
									{h.data.text && <p>{h.data.text}</p>}
								</div>
							</>
						);
						return <li>{h.data.link ? <a class="trio-item" href={h.data.link}>{inner}</a> : <div class="trio-item">{inner}</div>}</li>;
					})}
				</ul>
			</section>
		)
	}

	<section class="split" aria-labelledby="space-title">
		<img class="split-photo" src="/images/interior-wide.webp" alt="Sunlit café interior with wooden tables, green banquettes and olive branches" width="985" height="294" loading="lazy" />
		<div class="split-copy">
			<span class="eyebrow">Our space</span>
			<h2 id="space-title">Good coffee <br />brings people together.</h2>
			<p>A warm, welcoming space in the heart of the neighbourhood — <br />for slow mornings, catch ups and everything in between.</p>
			<a class="btn" href="/our-space">Explore our space <Arrow /></a>
		</div>
	</section>
</Base>
