---
/** Line icons drawn inline (no icon font). Decorative unless a label is passed. */
interface Props {
	name: string;
	class?: string;
	label?: string;
}
const { name, class: className, label } = Astro.props;
const paths: Record<string, string> = {
	cup: '<path d="M9 13h18v6a9 9 0 0 1-9 9 9 9 0 0 1-9-9z"/><path d="M27 15h2.5a3 3 0 0 1 0 6H26.5"/><path d="M6 32h24"/><path d="M14 4c-1.5 1.6 1.5 3 0 5M18.5 3c-1.5 1.8 1.5 3.4 0 6M23 4c-1.5 1.6 1.5 3 0 5"/>',
	sprout: '<path d="M18 33V17"/><path d="M18 19c0-6-4-10-11-10 0 7 4 10 11 10z"/><path d="M18 16c0-6 4-10 11-10 0 7-4 10-11 10z"/>',
	people: '<circle cx="18" cy="9" r="3.5"/><circle cx="8.5" cy="13" r="3"/><circle cx="27.5" cy="13" r="3"/><path d="M11 30v-6a7 7 0 0 1 14 0v6"/><path d="M3 30v-4a5.5 5.5 0 0 1 8-5M33 30v-4a5.5 5.5 0 0 0-8-5"/>',
	chair: '<path d="M10 4h16v14H10z"/><path d="M7 18h22v4H7z"/><path d="M9 22v10M27 22v10"/>',
	clock: '<circle cx="18" cy="18" r="13"/><path d="M18 10v8l5 4"/>',
	sun: '<circle cx="18" cy="18" r="6"/><path d="M18 3v4M18 29v4M3 18h4M29 18h4M7.4 7.4l2.8 2.8M25.8 25.8l2.8 2.8M7.4 28.6l2.8-2.8M25.8 10.2l2.8-2.8"/>',
	pin: '<path d="M18 33s-10-9.5-10-17a10 10 0 0 1 20 0c0 7.5-10 17-10 17z"/><circle cx="18" cy="16" r="3.5"/>',
	bike: '<circle cx="8" cy="23" r="6"/><circle cx="28" cy="23" r="6"/><path d="M8 23l6-11h9l5 11M14 12l5 11h-2M12 8h5M21 8h3l2 4"/>',
	walk: '<circle cx="19" cy="5" r="2.5"/><path d="M17 11l-4 6 3 3M17 11l4 3 4 1M17 11l1 9-4 12M18 20l5 4 1 8"/>',
	transit: '<rect x="8" y="4" width="20" height="22" rx="4"/><path d="M8 16h20M12 30l2-4M24 30l-2-4"/><circle cx="13" cy="21" r="1"/><circle cx="23" cy="21" r="1"/>',
	search: '<circle cx="15" cy="15" r="9"/><path d="M22 22l9 9"/>',
	leaf: '<path d="M6 30C6 14 15 6 31 5c0 16-9 24-25 25z" fill="currentColor" stroke="none"/><path d="M6 30L22 14" stroke="#f4efe8"/>',
	calendar: '<rect x="5" y="7" width="26" height="24" rx="2"/><path d="M5 13h26M11 4v6M25 4v6M10 18h3M16.5 18h3M23 18h3M10 23h3M16.5 23h3M23 23h3"/>',
	chevron: '<path d="M8 13l10 10 10-10"/>',
};
const body = paths[name] ?? "";
---

<svg
	class:list={["icon", className]}
	viewBox="0 0 36 36"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
	focusable="false"
	set:html={body}
/>
