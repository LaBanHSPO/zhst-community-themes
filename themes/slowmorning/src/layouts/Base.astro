---
import { getEmDashCollection, getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Icon from "../components/Icon.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getVenue } from "../lib/cafe";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Header floats transparently over the page's first (photographic) section. */
	overlay?: boolean;
	/** Force which primary-menu URL is marked current (e.g. detail pages). */
	current?: string;
	/** Mark the menu item that links to a single menu entry ("Cake detail") as current. */
	detailNav?: boolean;
}

const { title, pageTitle, description, image, canonical, content, overlay = false, current, detailNav = false } = Astro.props;
const [settingsResult, menuResult, venueResult, hoursResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getVenue(),
	getEmDashCollection("hours", { orderBy: { position: "asc" }, limit: 14 }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(venueResult.cacheHint);
	Astro.cache.set(hoursResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const navItems = menuResult.data?.items ?? [];
const { venue } = venueResult;
const hours = hoursResult.entries;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const norm = (url: string) => url.replace(/\/$/, "") || "/";
const detailUrl = detailNav ? navItems.find((i) => /^\/menu\/.+/.test(i.url))?.url : undefined;
const currentUrl =
	current ??
	detailUrl ??
	navItems.find((i) => norm(i.url) === path)?.url ??
	navItems.find((i) => norm(i.url) !== "/" && path.startsWith(`${norm(i.url)}/`))?.url;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
const year = new Intl.DateTimeFormat("en-US", { year: "numeric", timeZone: "Asia/Saigon" }).format(new Date());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
			rel="stylesheet"
		/>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to content</a>

		<header class:list={["site-head", { "is-overlay": overlay }]}>
			<div class="head-inner">
				<a class="wordmark" href="/" aria-label={`${siteTitle} — homepage`}>
					{
						siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						) : (
							<>
								<span class="wordmark-name">{siteTitle}</span>
								<span class="wordmark-tag">{siteTagline}</span>
							</>
						)
					}
				</a>
				<nav class="nav" aria-label="Primary">
					{
						navItems.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={item.url === currentUrl ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<a class="head-search" href="/search" aria-label="Search the menu">
					<Icon name="search" />
				</a>
				<details class="mobile-nav">
					<summary>
						<svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" focusable="false">
							<path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.4" />
						</svg>
						<span>Menu</span>
					</summary>
					<nav class="mobile-panel" aria-label="Primary (mobile)">
						{
							navItems.map((item) => (
								<a href={item.url} aria-current={item.url === currentUrl ? "page" : undefined}>
									{item.label}
								</a>
							))
						}
						<a href="/search">Search</a>
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="container foot-inner">
				<div class="foot-brand">
					<a class="wordmark" href="/">
						<span class="wordmark-name">{siteTitle}</span>
						<span class="wordmark-tag">{siteTagline}</span>
					</a>
					<p>Specialty coffee, homemade bakes and a calmer kind of day.</p>
				</div>
				<div>
					<h2>Find us</h2>
					<address>
						{venue.street && <>{venue.street}<br /></>}
						{venue.locality && <>{venue.locality}<br /></>}
						{venue.country}
					</address>
					{venue.phone && <a href={`tel:${venue.phone.replace(/[^\d+]/g, "")}`}>{venue.phone}</a>}
					{venue.email && <a href={`mailto:${venue.email}`}>{venue.email}</a>}
				</div>
				<div>
					<h2>Opening hours</h2>
					<dl class="foot-hours">
						{
							hours.map((h) => (
								<div>
									<dt>{h.data.title}</dt>
									<dd>{h.data.hours}</dd>
								</div>
							))
						}
					</dl>
				</div>
				<div>
					<h2>Explore</h2>
					{navItems.map((item) => <a href={item.url}>{item.label}</a>)}
				</div>
			</div>
			<div class="container foot-bottom">
				<span>© {year} {siteTitle}. All rights reserved.</span>
				<span>Built with EmDash</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
