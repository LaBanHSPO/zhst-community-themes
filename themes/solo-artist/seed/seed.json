          "searchable": true
        }
      ]
    },
    {
      "slug": "releases",
      "label": "Music",
      "labelSingular": "Release",
      "urlPattern": "/music/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "search",
        "seo"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "kind",
          "label": "Type",
          "type": "select",
          "defaultValue": "Single",
          "validation": {
            "options": [
              "Single",
              "EP",
              "Album"
            ]
          }
        },
        {
          "slug": "year",
          "label": "Year",
          "type": "string"
        },
        {
          "slug": "tagline",
          "label": "One-line description (shown under the title)",
          "type": "text",
          "required": true,
          "searchable": true
        },
        {
          "slug": "summary",
          "label": "Short description (plain paragraph)",
          "type": "text",
          "searchable": true
        },
        {
          "slug": "featured",
          "label": "Latest release (shown on the homepage)",
          "type": "boolean",
          "indexed": true
        },
        {
          "slug": "position",
          "label": "Sort order (newest first)",
          "type": "integer"
        },
        {
          "slug": "cover",
          "label": "Cover (upload)",
