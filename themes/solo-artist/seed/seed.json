        },
        {
          "slug": "cover_photo",
          "label": "Bundled cover path",
          "type": "string"
        },
        {
          "slug": "tracks",
          "label": "Tracklist",
          "type": "repeater",
          "validation": {
            "maxItems": 40,
            "subFields": [
              {
                "slug": "title",
                "label": "Track title",
                "type": "string"
              },
              {
                "slug": "duration",
                "label": "Length (e.g. 3:24)",
                "type": "string"
              },
              {
                "slug": "audio",
                "label": "Audio file (optional; leave empty if there is no audio)",
                "type": "file"
              }
            ]
          }
        },
        {
          "slug": "credits",
          "label": "Credits (plain text)",
          "type": "text"
        },
        {
          "slug": "content",
          "label": "Liner notes",
          "type": "portableText",
          "searchable": true
        }
      ]
    },
    {
      "slug": "shows",
      "label": "Tour",
      "labelSingular": "Show",
      "urlPattern": "/tour",
      "supports": [
