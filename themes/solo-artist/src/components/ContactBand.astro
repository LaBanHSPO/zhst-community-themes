---
import Arrow from "./Arrow.astro";
import { telHref } from "../lib/artist";
import type { ArtistData } from "../lib/artist";

interface Props {
	artist: ArtistData;
}
const { artist } = Astro.props;
---

<section class="contact-band" aria-labelledby="contact-band-title">
	<div class="wrap contact-band-inner">
		<p class="eyebrow">Booking and press</p>
		<h2 id="contact-band-title" class="display">Bring the songs to your room.</h2>
		<p class="contact-band-copy">Venues, promoters and writers: choose a topic and tell us what you have in mind. Email and phone are always here too.</p>
		<div class="contact-band-actions">
			<a class="btn btn-solid" href="/contact?topic=booking"><span>Get in touch</span><Arrow /></a>
			<p class="contact-band-contact">
				{artist.email && <a href={`mailto:${artist.email}`}>{artist.email}</a>}
				{artist.phone && <a href={telHref(artist.phone)}>{artist.phone}</a>}
			</p>
		</div>
	</div>
</section>
