---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<img class="notfound-photo" src="/images/cover-moon-room.webp" alt="" width="670" height="670" />
		<div class="notfound-copy">
			<p class="eyebrow">Error 404</p>
			<h1 id="nf-title" class="display display-xl">This song has drifted off the record.</h1>
			<p class="lede">The page you are looking for has moved or never existed. These are good places to start again.</p>
			<div class="actions">
				<a class="btn btn-cream" href="/"><span>Back to home</span><Arrow /></a>
				<a class="pill" href="/music">Music</a>
				<a class="pill" href="/tour">Tour</a>
			</div>
		</div>
	</section>
</Base>
