---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import InquiryBand from "../../components/InquiryBand.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getStories, getStudio, photoAlt, photoSrc, storyHref } from "../../lib/studio";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: story, cacheHint } = await getEmDashEntry("stories", slug);
if (!story) return Astro.rewrite("/404");

const [allResult, studioResult, settings] = await Promise.all([getStories(), getStudio(), getSiteSettings()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(allResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = getSeoMeta(story, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const cover = photoSrc(story.data.image, story.data.photo);
const photos = (story.data.gallery ?? [])
	.map((g) => ({ src: photoSrc(g.image, g.photo), alt: photoAlt(g.image, g.photo, g.caption ?? ""), caption: g.caption }))
	.filter((g): g is { src: string; alt: string; caption: string | undefined } => Boolean(g.src));
const hasBody = Boolean(story.data.content && story.data.content.length > 0);
const others = allResult.entries.filter((s) => s.data.id !== story.data.id).slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? story.data.summary}
	canonical={seo.canonical}
	image={seo.ogImage ?? cover}
	content={{ collection: "stories", id: story.data.id, slug }}
	current="/stories"
>
	<header class="story-head">
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href="/stories">Stories</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">{story.data.title}</span>
		</nav>
		<div class="story-head-grid">
			<div class="story-head-copy">
				<p class="eyebrow">{[story.data.place, story.data.date_label].filter(Boolean).join(" · ")}</p>
				<h1 class="display display-xl" {...story.edit.title}>{story.data.title}</h1>
				<p class="lede">{story.data.summary}</p>
			</div>
			{cover && <img class="story-cover" src={cover} alt={photoAlt(story.data.image, story.data.photo, story.data.title)} width="900" height="800" fetchpriority="high" />}
		</div>
	</header>

	{
		hasBody && (
			<section class="story-body">
				<div class="prose">
					<PortableText value={story.data.content} />
				</div>
			</section>
		)
	}

	{
		photos.length > 0 && (
			<section class="story-photos" aria-label={`Photographs from ${story.data.title}`}>
				<ul class="photo-grid">
					{photos.map((p) => (
						<li>
							<figure>
								<img src={p.src} alt={p.alt} width="800" height="800" loading="lazy" />
								{p.caption && <figcaption>{p.caption}</figcaption>}
							</figure>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		others.length > 0 && (
			<section class="band" aria-labelledby="more-title">
				<div class="band-inner">
					<div class="band-head">
						<div>
							<p class="eyebrow">More stories</p>
							<h2 id="more-title" class="display">Keep reading.</h2>
						</div>
						<a class="text-link" href="/stories"><span>All stories</span><Arrow /></a>
					</div>
					<ul class="story-cards">
						{others.map((s) => {
							const src = photoSrc(s.data.image, s.data.photo);
							return (
								<li>
									<a class="story-card" href={storyHref(s.data)}>
										{src && <img src={src} alt={photoAlt(s.data.image, s.data.photo, s.data.title)} width="600" height="720" loading="lazy" />}
										<span class="story-card-meta">
											<span class="story-card-name">{s.data.title}</span>
											<span class="story-card-place">{[s.data.place, s.data.date_label].filter(Boolean).join(" · ")}</span>
										</span>
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	<InquiryBand studio={studioResult.studio} />
</Base>
