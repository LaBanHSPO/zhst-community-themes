---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import InquiryBand from "../components/InquiryBand.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getApproach, getStudio } from "../lib/studio";

const [{ entry: page, cacheHint }, approachResult, studioResult, settings] = await Promise.all([
	getEmDashEntry("pages", "about"),
	getApproach(),
	getStudio(),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	if (cacheHint) Astro.cache.set(cacheHint);
	Astro.cache.set(approachResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);
const seo = page ? getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: "/about" }) : null;
const approach = approachResult.entries;
const hasBody = Boolean(page?.data.content && page.data.content.length > 0);
const { studio } = studioResult;
---

<Base
	title={seo?.title ?? "About"}
	pageTitle={seo?.ogTitle}
	description={seo?.description ?? page?.data.intro ?? "About evermore, a small wedding photography studio."}
	canonical={seo?.canonical}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	<PageHead
		id="about-title"
		eyebrow={page?.data.eyebrow ?? "About"}
		title={page?.data.title ?? "A quiet photographer for loud, happy days."}
		intro={page?.data.intro}
		edit={page ? { ...page.edit.title } : {}}
	/>

	<section class="about-story">
		<figure class="about-photo">
			<img
				src="/images/camera.webp"
				alt="A black camera with a flower bouquet and leather strap on a sunlit stone wall"
				width="880"
				height="650"
				loading="lazy"
			/>
			{studio.photographer && <figcaption>{studio.photographer}{studio.base ? `, ${studio.base}` : ""}</figcaption>}
		</figure>
		<div class="prose">
			{hasBody ? <PortableText value={page!.data.content} /> : <p>Our story is coming soon.</p>}
		</div>
	</section>

	{
		approach.length > 0 && (
			<section class="approach" aria-labelledby="values-title">
				<div class="band-inner">
					<p class="eyebrow eyebrow-light">How we work</p>
					<h2 id="values-title" class="display display-light">What you can expect.</h2>
					<ul class="approach-list">
						{approach.map((a) => (
							<li>
								<h3 {...a.edit.title}>{a.data.title}</h3>
								{a.data.text && <p>{a.data.text}</p>}
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<InquiryBand studio={studio} />
</Base>
