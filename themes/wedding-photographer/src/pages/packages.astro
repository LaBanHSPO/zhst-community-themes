---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import PageHead from "../components/PageHead.astro";
import { formatPrice, getPackages, getStudio, lines } from "../lib/studio";

const [packagesResult, studioResult] = await Promise.all([getPackages(), getStudio()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(packagesResult.cacheHint);
	Astro.cache.set(studioResult.cacheHint);
}
const packages = packagesResult.entries;
const { studio } = studioResult;
---

<Base title="Packages" description="Wedding photography packages from evermore, with what is included and starting prices.">
	<PageHead
		id="packages-title"
		eyebrow="Packages"
		title="Simple ways to book."
		intro="Every package includes a pre-wedding call, a fully edited online gallery and a print release. Prices are starting prices in US dollars; travel is quoted with your proposal."
	/>

	<section class="packages" aria-labelledby="packages-title">
		{
			packages.length === 0 ? (
				<p class="empty-note">Our packages are being updated. Send us an inquiry and we will share current options.</p>
			) : (
				<ul class="package-grid">
					{packages.map((p) => (
						<li class:list={["package", { "is-featured": p.data.featured }]} id={p.data.slug ?? p.data.id}>
							{p.data.featured && <span class="package-flag">Most booked</span>}
							<h2 class="package-name" {...p.edit.title}>{p.data.title}</h2>
							<p class="package-summary">{p.data.summary}</p>
							<p class="package-price">
								<span>From</span> <strong>{formatPrice(p.data.price)}</strong>
								{p.data.coverage && <span class="package-coverage">{p.data.coverage}</span>}
							</p>
							<ul class="package-includes">
								{lines(p.data.includes).map((i) => <li>{i}</li>)}
							</ul>
							<a class="btn btn-olive" href={`/inquire?package=${encodeURIComponent(p.data.slug ?? p.data.id)}`}>
								<span>Inquire about this</span><Arrow />
							</a>
						</li>
					))}
				</ul>
			)
		}
		<p class="packages-note">
			Planning something different? Tell us what you have in mind{studio.email && <>, or write to <a href={`mailto:${studio.email}`}>{studio.email}</a></>}.
		</p>
	</section>
</Base>
