---
import Base from "../layouts/Base.astro";
import { formatPrice, getPackages, getStudio, telHref } from "../lib/studio";

const [{ studio, cacheHint }, packagesResult] = await Promise.all([getStudio(), getPackages()]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(packagesResult.cacheHint);
}
const packages = packagesResult.entries;

// ?package=<slug> pre-selects a package (links from the packages page).
const wanted = Astro.url.searchParams.get("package");
const selected = packages.find((p) => (p.data.slug ?? p.data.id) === wanted);

// Earliest selectable date is today in the site's timezone.
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Saigon" }).format(new Date());
---

<Base title="Inquire" description="Tell evermore about your wedding. We reply to every inquiry personally, usually within two working days.">
	<div class="inquire">
		<div class="inquire-photo">
			<img
				src="/images/camera-prints.webp"
				alt="A camera and printed photographs on a stone wall, with a couple embracing at golden hour by a lake behind"
				width="1448"
				height="1086"
			/>
		</div>
		<section class="inquire-panel" aria-labelledby="inquire-title">
			<p class="eyebrow">Inquire</p>
			<h1 id="inquire-title" class="display display-xl">Let us hear about your day.</h1>
			<p class="lede">
				Tell us who is getting married, when and where. An inquiry is not a booking until we have replied and agreed the details.
			</p>

			<form
				class="inquire-form"
				data-inquire-form
				data-email={studio.email}
				action={studio.email ? `mailto:${studio.email}` : undefined}
				method="post"
				enctype="text/plain"
				novalidate
			>
				<div class="form-grid">
					<div class="field full">
						<label for="q-names">Your names</label>
						<input id="q-names" name="names" type="text" autocomplete="name" placeholder="e.g. Mara and Elio" required />
						<span class="field-error" data-error-for="q-names"></span>
					</div>
					<div class="field">
						<label for="q-email">Email</label>
						<input id="q-email" name="email" type="email" autocomplete="email" required />
						<span class="field-error" data-error-for="q-email"></span>
					</div>
					<div class="field">
						<label for="q-phone">Phone <span class="optional">(optional)</span></label>
						<input id="q-phone" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="field">
						<label for="q-date">Wedding date</label>
						<input id="q-date" name="date" type="date" min={today} required />
						<span class="field-error" data-error-for="q-date"></span>
					</div>
					<div class="field">
						<label for="q-venue">Venue or location</label>
						<input id="q-venue" name="venue" type="text" placeholder="Venue, town or region" required />
						<span class="field-error" data-error-for="q-venue"></span>
					</div>
					<div class="field full">
						<label for="q-package">Package</label>
						<select id="q-package" name="package" required>
							<option value="" selected={!selected}>Choose a package</option>
							{
								packages.map((p) => {
									const label = [p.data.title, p.data.coverage, `from ${formatPrice(p.data.price)}`].filter(Boolean).join(" · ");
									return <option value={p.data.title} selected={selected?.data.id === p.data.id}>{label}</option>;
								})
							}
							<option value="Not sure yet">Not sure yet, please advise</option>
						</select>
						<span class="field-error" data-error-for="q-package"></span>
					</div>
					<div class="field full">
						<label for="q-notes">Tell us about your day <span class="optional">(optional)</span></label>
						<textarea id="q-notes" name="notes" rows="4" placeholder="Guest numbers, the feel you are after, anything that matters to you…"></textarea>
					</div>
				</div>
				<button class="btn btn-olive btn-block" type="submit"><span>Send inquiry</span></button>
				<p class="form-status" role="status" aria-live="polite" data-status>
					<noscript>
						This form needs JavaScript to prepare your email.
						{studio.email && <>Write to <a href={`mailto:${studio.email}`}>{studio.email}</a> with your names, date and venue.</>}
					</noscript>
				</p>
			</form>

			<div class="inquire-contact">
				<h2>Prefer to write or call?</h2>
				<p>
					{studio.email && <a href={`mailto:${studio.email}`}>{studio.email}</a>}
					{studio.phone && <a href={telHref(studio.phone)}>{studio.phone}</a>}
				</p>
				{studio.response && <p class="small">{studio.response}</p>}
				{studio.inquiry_note && <p class="small">{studio.inquiry_note}</p>}
			</div>
		</section>
	</div>
</Base>

<script>
	// Compose an inquiry email; the studio replies to it. Nothing is sent by the site itself.
	document.querySelectorAll<HTMLFormElement>("[data-inquire-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-status]");
		if (!status) return;

		const showErrors = (): boolean => {
			let firstInvalid: HTMLInputElement | HTMLSelectElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input[required], select[required]").forEach((input) => {
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${input.id}"]`);
				const message = input.validity.valid
					? ""
					: input.validity.valueMissing
						? input.tagName === "SELECT"
							? "Please choose an option."
							: "Please fill this in."
						: input.getAttribute("type") === "email"
							? "Please enter a valid email address."
							: input.getAttribute("type") === "date"
								? "Please choose today or a later date."
								: "Please check this field.";
				input.setAttribute("aria-invalid", message ? "true" : "false");
				if (slot) slot.textContent = message;
				if (message && !firstInvalid) firstInvalid = input;
			});
			if (firstInvalid) (firstInvalid as HTMLElement).focus();
			return !firstInvalid;
		};

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!showErrors()) return;
			const email = form.dataset.email ?? "";
			if (!email) {
				status.textContent = "Online inquiries are not available right now. Please call us.";
				return;
			}
			const f = new FormData(form);
			const get = (k: string) => String(f.get(k) ?? "").trim();
			const subject = `Wedding inquiry: ${get("names")} on ${get("date")}`;
			const lines = [
				"Hello,",
				"",
				"We would like to inquire about our wedding:",
				`Names: ${get("names")}`,
				`Wedding date: ${get("date")}`,
				`Venue or location: ${get("venue")}`,
				`Package: ${get("package")}`,
				`Email: ${get("email")}`,
				get("phone") ? `Phone: ${get("phone")}` : "",
				get("notes") ? `About our day: ${get("notes")}` : "",
				"",
				"We understand the date is only held once you have replied and we have agreed the details.",
			].filter((line, i, arr) => line !== "" || (arr[i - 1] !== "" && i > 0));
			window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
			status.textContent =
				"Your email app should open with this inquiry ready to send. It is only sent when you send that email, and we reply personally. If nothing opened, write to ";
			const a = document.createElement("a");
			a.href = `mailto:${email}`;
			a.textContent = email;
			status.append(a, ".");
		});
	});
</script>
