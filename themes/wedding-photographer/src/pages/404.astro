---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---

<Base title="Page not found">
	<section class="notfound" aria-labelledby="nf-title">
		<div class="notfound-copy">
			<p class="eyebrow">Error 404</p>
			<h1 id="nf-title" class="display display-xl">This page has wandered off.</h1>
			<p class="lede">The page you are looking for has moved or never existed. These are good places to start again.</p>
			<div class="actions">
				<a class="btn btn-olive" href="/"><span>Back to home</span><Arrow /></a>
				<a class="pill" href="/stories">Stories</a>
				<a class="pill" href="/inquire">Inquire</a>
			</div>
		</div>
		<img class="notfound-photo" src="/images/lake-couple.webp" alt="" width="588" height="600" />
	</section>
</Base>
